uint8_t matrix_sp_before;
uint8_t matrix_sp_after;

bank0 uint8_t matrix_probe0(void) { matrix_count := matrix_count + 1; return 0x80; }
bank1 uint8_t matrix_probe1(void) { matrix_count := matrix_count + 1; return 0x81; }

bank1 void matrix_source(void) {
   matrix_count := 0;
