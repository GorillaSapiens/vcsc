include "machine_6502.c26"

uint8_t selector;
void observe_value(uint8_t value);

zeropage uint8_t straight8(void) {
   zeropage uint8_t result8 := 0x5a;
   return result8;
}

zeropage uint16_t branched16(void) {
   zeropage uint16_t result16 := 0x1234;
   if (selector) {
      result16 := 0xabcd;
      return result16;
   }
   result16 += 1;
   return result16;
}

