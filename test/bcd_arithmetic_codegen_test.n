// expectasm: ldy #2
include "machine_6502.n"

bcd8_t a8;
bcd16_t a16;
bcd24_t a24;

void main(void) {
   a8 := a8 + 1;
   a16 -= 1;
   a24 += 1;
   a8++;
   --a16;
}
