// n65c -I .
// expectexit: 0
include "machine_6502.n"

int16_t pick(int16_t a, int16_t b) {
   return a + 10 * b;
}

int16_t pick(int8_t a, int8_t b) {
   return a + 10 * b;
}

void main(void) {
   int16_t i1;
   int16_t i2;
   int16_t ri;
   int8_t c1;
   int8_t c2;
   int16_t rc;

   i1 := 1;
   i2 := 2;
   c1 := 1;
   c2 := 2;

   ri := pick(1, 2);
   rc := pick(c1, c2);

   if (ri != 21) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }
   if (rc != 21) { asm lda #$ff; asm ldx #2; asm ldy #0; asm jsr $ffff; }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
