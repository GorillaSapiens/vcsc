// vcsc-cc1 -I .
// expectexit: 0

include "machine_6502.vcsc"

inline uint8_t update(ref uint8_t value, uint8_t delta) {
   uint8_t before := value;
   if (delta == 0`uint8_t) {
      return before;
   }
   value += delta;
   return value;
}

static inline uint8_t doubled(uint8_t value) {
   return value + value;
}

inline uint8_t quadrupled(uint8_t value) {
   return doubled(doubled(value));
}

uint8_t ordinary_ref_read(ref uint8_t value) {
   return value;
}

uint8_t call_order_counter;

uint8_t next_call_order_value(void) {
   call_order_counter++;
   return call_order_counter;
}

inline uint8_t decimal_pair(uint8_t left, uint8_t right) {
   return (left * 10`uint8_t) + right;
}

void main(void) {
   uint8_t value := 5`uint8_t;

   if (update(value, 0`uint8_t) != 5`uint8_t) {
      asm lda #$ff
      asm ldx #1
      asm ldy #0
      asm jsr $ffff
   }
   if (value != 5`uint8_t) {
      asm lda #$ff
      asm ldx #2
      asm ldy #0
      asm jsr $ffff
   }
   if (update(value, 3`uint8_t) != 8`uint8_t) {
      asm lda #$ff
      asm ldx #3
      asm ldy #0
      asm jsr $ffff
   }
   if (value != 8`uint8_t) {
      asm lda #$ff
      asm ldx #4
      asm ldy #0
      asm jsr $ffff
   }
   if (doubled(value) != 16`uint8_t) {
      asm lda #$ff
      asm ldx #5
      asm ldy #0
      asm jsr $ffff
   }
   if (quadrupled(value) != 32`uint8_t) {
      asm lda #$ff
      asm ldx #6
      asm ldy #0
      asm jsr $ffff
   }
   if (ordinary_ref_read(value) != 8`uint8_t) {
      asm lda #$ff
      asm ldx #7
      asm ldy #0
      asm jsr $ffff
   }

   call_order_counter := 0`uint8_t;
   if (decimal_pair(next_call_order_value(), next_call_order_value()) != 12`uint8_t) {
      asm lda #$ff
      asm ldx #8
      asm ldy #0
      asm jsr $ffff
   }

   asm lda #$ff
   asm ldx #0
   asm ldy #0
   asm jsr $ffff
}
