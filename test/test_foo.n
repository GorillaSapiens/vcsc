// n65c -X dumpast -X parseonly

type bool     { $size:1 $integer:unsigned };
type void     { $size:0 };
type * { $size:2 $integer:unsigned $endian:little};

type uint8_t  { $size:1 $integer:unsigned };
type  int8_t  { $size:1 $integer:signed };
type uint16_t { $size:2 $integer:unsigned $endian:little };
type  int16_t { $size:2 $integer:signed $endian:little };



uint16_t x := 5 / 5;
int16_t  n := -6;
uint16_t y;

static uint16_t sx := 5;
static int16_t  sn := -6;
static uint16_t sy;

const uint16_t cx := 5;
const int16_t  cn := -6;
const uint16_t cy := 0;

int16_t bar(int16_t alpha, static uint8_t beta, const uint16_t gamma);

void nop(void) {
}

int16_t foo(int16_t alpha, int16_t beta, int16_t gamma) {
   return arg;
}

void main(void) {
   int16_t val := 5;
   foo(val);
}
