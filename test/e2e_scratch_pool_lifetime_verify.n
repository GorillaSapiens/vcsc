// n65c -I .
// expectexit: 0
include "machine_6502.n"
struct Pair { uint16_t a; uint16_t b; };
Pair pairs[2];
uint8_t index;
uint16_t sum;
void pass(void) { asm lda #$ff; asm ldx #0; asm ldy #0; asm jsr $ffff; }
void main(void) {
   index := 1;
   pairs[index] := { 0x1234, 0x0102 };
   if (pairs[1].a != 0x1234 || pairs[1].b != 0x0102) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }
   sum := pairs[index].a + pairs[index].b;
   if (sum != 0x1336) { asm lda #$ff; asm ldx #5; asm ldy #0; asm jsr $ffff; }
   pairs[index].a := pairs[index].b + 2;
   if (pairs[1].a != 0x0104) { asm lda #$ff; asm ldx #2; asm ldy #0; asm jsr $ffff; }
   pairs[index].a += pairs[index].b;
   if (pairs[1].a != 0x0206) { asm lda #$ff; asm ldx #3; asm ldy #0; asm jsr $ffff; }
   pairs[index].b++;
   if (pairs[1].b != 0x0103) { asm lda #$ff; asm ldx #4; asm ldy #0; asm jsr $ffff; }
   pass();
}
