// n65c
// expectfail
// expecterr: cannot create a pointer to function 'pick' because it has symbol-backed parameters
type void { $size:0 };
type bool { $size:1 $integer:unsigned };
type *    { $size:2 $integer:unsigned $endian:little };
type s2   { $size:2 $integer:signed $endian:little };
type s4   { $size:4 $integer:signed $endian:little };

s2 pick(s2 x) {
   return x;
}

s2 pick(s4 x) {
   return 4;
}

s2 main(s2 x) {
   s2 (*fp)(s2);
   fp := pick;
   return fp(x);
}
