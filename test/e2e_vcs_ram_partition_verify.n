// n65c -I ../libraries/vcs
// linkcfg: ../libraries/vcs/vcs_4k.cfg
// expectmap: RAM        start=$0080 size=$0060 type=rw
// expectmap: __stack_top   $00DF
// expectexit: 0

include "vcs.n"

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   pass();
}
