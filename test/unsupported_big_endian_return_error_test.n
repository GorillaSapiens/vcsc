// n65c
// expectfail
// expecterr: function 'bad' has an unsupported return type
// expecterr: functions may return only void, an 8- or 16-bit little-endian integer, or a 16-bit pointer

type void { $size:0 };
type bool { $size:1 $integer:unsigned };
type be16 { $size:2 $integer:unsigned $endian:big };
type *    { $size:2 $integer:unsigned $endian:little };

be16 bad(void) {
   return 0;
}
