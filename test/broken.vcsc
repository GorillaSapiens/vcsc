// vcsc-cc1 -X dumpast -X parseonly

// contains all the "standards" used in the default generic 6502 case

mem zeropage { $start:0x0000 $size:0x0100 $rw };
mem cpustack { $start:0x0100 $size:0x0100 $rw };
mem ram      { $start:0x0200 $size:0x7e00 $rw $priority:2 };
mem rom      { $start:0x8000 $size:0x8000 $ro $priority:1 };

type void     { $size:0 };
type uint8_t     { $size:1 $integer:unsigned };
type int8_t { $size:1 $integer:signed};
type * { $size:2 $integer:unsigned $endian:little };
type int16_t { $size:2 $integer:signed $endian:little };
type long { $size:2 $integer:signed $endian:little };
type longlong { $size:2 $integer:signed $endian:little };

xform { // default xform has no name
   // canonical escapes
   '\a' 0x07,
   '\b' 0x08,
   '\e' 0x1B,
   '\f' 0x0C,
   '\n' 0x0A,
   '\r' 0x0D,
   '\t' 0x09,
   '\v' 0x0B,
   '\\' 0x5C,
   '\'' 0x27,
   '\"' 0x22,
   '\?' 0x3F,
   '\0' 0x00,
};

struct hoot {
   int16_t foo[2][3];
};

struct complex {
   int16_t real, imaginary;
   int16_t re, im;
   int16_t hook := 5;
};

struct linkedlistnode {
   int16_t data;
   linkedlistnode *next;
};

int16_t a := 3 * (2 + 2 - 2 * 2 / 2);
int16_t b := 4 + -5;
int16_t z := 0b000_111_000 + 3_141;

int16_t c;

void main(void) {
   int16_t foo[3][3] := { { 0, 0, 0 }, { 0, 0, 0 }, { 0, 0, 0 } };
   a := 1;
   { a := 1; b := 2; c := 3; }
}
