// n65c -I .
// expectfail
// expecterr: cannot create a pointer to function 'pstr' because it has symbol-backed parameters
include "machine_6502.n"

struct argbox {
   void *data;
   int (*func)(char *, void *);
};

int pstr(char *out, void *v) {
   return 0;
}

int main(void) {
   char *p;
   argbox a[1] := {
      { &3, pstr },
   };

   return a[0].func(p, a[0].data);
}
