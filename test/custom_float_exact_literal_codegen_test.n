include "machine_6502.n"

type f10le { $size:10 $float:simple $endian:little };

int main(void) {
   f10le exact_hex := 0x1.0000000000000001p+0;
   f10le rounded_hex := 0x1.00000000000000003p+0;
   f10le exact_dec := 18446744073709551617.0;
   return 0;
}
