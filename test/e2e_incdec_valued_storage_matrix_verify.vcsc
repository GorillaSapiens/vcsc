// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.vcsc"

struct Bits {
   uint8_t lo:4;
   uint8_t hi:4;
};

uint8_t g8;
uint8_t d8;
uint16_t g16;
uint16_t d16;
zeropage uint8_t z8;
zeropage uint8_t zd8;
uint8_t a8[4];
uint8_t ad8[4];
uint16_t a16[3];
uint16_t ad16[3];
uint8_t *p8;
uint8_t *q8;
uint16_t *p16;
uint16_t *q16;
Bits bits;
ref uint8_t absbyte@[0x0600/0x0600];

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

void capture(uint8_t value) {
   d8 := value;
}

uint8_t fetch_post(void) {
   return g8++;
}

void main(void) {
   uint8_t l8;
   uint8_t ld8;
   uint16_t l16;
   uint16_t ld16;
   static uint8_t s8;
   static uint8_t sd8;

   g8 := 9;
   d8 := g8++;
   if (d8 != 9 || g8 != 10) { fail(1); }
   d8 := --g8;
   if (d8 != 9 || g8 != 9) { fail(2); }
   d8 := g8--;
   if (d8 != 9 || g8 != 8) { fail(3); }
   d8 := ++g8;
   if (d8 != 9 || g8 != 9) { fail(4); }

   g16 := 0x12ff;
   d16 := g16++;
   if (d16 != 0x12ff || g16 != 0x1300) { fail(5); }
   d16 := --g16;
   if (d16 != 0x12ff || g16 != 0x12ff) { fail(6); }
   d16 := g16--;
   if (d16 != 0x12ff || g16 != 0x12fe) { fail(7); }
   d16 := ++g16;
   if (d16 != 0x12ff || g16 != 0x12ff) { fail(8); }

   z8 := 20;
   zd8 := z8++;
   if (zd8 != 20 || z8 != 21) { fail(9); }

   l8 := 30;
   ld8 := l8++;
   if (ld8 != 30 || l8 != 31) { fail(10); }
   ld8 := --l8;
   if (ld8 != 30 || l8 != 30) { fail(11); }

   l16 := 0x34ff;
   ld16 := l16++;
   if (ld16 != 0x34ff || l16 != 0x3500) { fail(12); }
   ld16 := --l16;
   if (ld16 != 0x34ff || l16 != 0x34ff) { fail(13); }

   s8 := 40;
   sd8 := s8++;
   if (sd8 != 40 || s8 != 41) { fail(14); }

   a8[1] := 50;
   ad8[2] := a8[1]++;
   if (ad8[2] != 50 || a8[1] != 51) { fail(15); }
   ad8[2] := --a8[1];
   if (ad8[2] != 50 || a8[1] != 50) { fail(16); }

   a16[1] := 0x45ff;
   ad16[2] := a16[1]++;
   if (ad16[2] != 0x45ff || a16[1] != 0x4600) { fail(17); }

   a8[0] := 60;
   p8 := &a8[0];
   q8 := &ad8[0];
   *q8 := (*p8)++;
   if (ad8[0] != 60 || a8[0] != 61) { fail(18); }
   *q8 := --(*p8);
   if (ad8[0] != 60 || a8[0] != 60) { fail(19); }

   bits.lo := 3;
   bits.hi := 10;
   d8 := bits.lo++;
   if (d8 != 3 || bits.lo != 4 || bits.hi != 10) { fail(20); }
   d8 := --bits.lo;
   if (d8 != 3 || bits.lo != 3 || bits.hi != 10) { fail(21); }

   absbyte := 70;
   d8 := absbyte++;
   if (d8 != 70 || absbyte != 71) { fail(22); }
   d8 := --absbyte;
   if (d8 != 70 || absbyte != 70) { fail(23); }

   g8 := 5;
   d8 := g8++ + 10;
   if (d8 != 15 || g8 != 6) { fail(24); }

   g8 := 7;
   capture(g8++);
   if (d8 != 7 || g8 != 8) { fail(25); }

   g8 := 9;
   d8 := fetch_post();
   if (d8 != 9 || g8 != 10) { fail(26); }

   g8 := 11;
   if (g8++ != 11) { fail(27); }
   if (g8 != 12) { fail(28); }

   p8 := &a8[0];
   q8 := p8++;
   if (q8 != &a8[0] || p8 != &a8[1]) { fail(29); }
   q8 := --p8;
   if (q8 != &a8[0] || p8 != &a8[0]) { fail(30); }

   p16 := &a16[0];
   q16 := p16++;
   if (q16 != &a16[0] || p16 != &a16[1]) { fail(31); }
   q16 := --p16;
   if (q16 != &a16[0] || p16 != &a16[0]) { fail(32); }

   g8 := 80;
   absbyte := g8++;
   if (absbyte != 80 || g8 != 81) { fail(33); }

   a8[0] := 90;
   a8[1] := 91;
   g8 := 1;
   d8 := a8[g8++];
   if (d8 != 91 || g8 != 2) { fail(34); }

   d8 := 11;
   g8 := 11;
   if (d8 != g8++) { fail(35); }
   if (g8 != 12) { fail(36); }

   g8 := 1;
   if (!g8++) { fail(37); }
   if (g8 != 2) { fail(38); }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
