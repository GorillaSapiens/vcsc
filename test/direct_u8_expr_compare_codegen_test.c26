// vcsc-cc1 -I .
// expectasmordered: lda input
// expectasmordered: and #$0f
// expectasmordered: cmp #$0f
// expectasmordered: bne @if_false_
// forbidasm: __vcsc_scratch_

include "machine_6502.c26"

uint8_t input;
uint8_t output;

void main(void) {
   if ((input & 0x0f) == 0x0f) {
      output := 1;
   }
}
