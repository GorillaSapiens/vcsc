include "machine_6502.vcsc"

struct Packet {
   int8_t tag;
   int16_t value;
};

union Bits {
   int16_t whole;
   int8_t bytes[2];
};

Packet g;

Packet *api(Packet *p, Bits *u) {
   return p;
}
