// vcsc-cc1 -I .
// expectasmordered: ldx #$00
// expectasmordered: @for_start_
// expectasmordered: lda pending,x
// expectasmordered: beq @if_false_
// expectasmordered: lda value,x
// expectasmordered: sta result
// expectasmordered: jmp @for_end_
// forbidasm: main$i
// forbidasm: txa
// forbidasm: tay

include "machine_6502.c26"

uint8_t pending[2];
uint8_t value[2];
uint8_t result;

void main(void) {
   for (uint8_t i := 0; i < 2; i += 1) {
      if (pending[i]) {
         result := value[i];
         break;
      }
   }
}
