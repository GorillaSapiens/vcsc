// vcsc-cc1 -I .
// expectasm: .export first_rows
// expectasm: .export second_rows
// expectasm: first_rows:
// expectasm: .res 7
// expectasm: second_rows:
// expectasm: .res 3
// expectasm: first_color_copy:
// expectasm: .byte $20
// expectasm: second_color_copy:
// expectasm: .byte $2e
// expectasm: first_flags_copy:
// expectasm: .byte $01
// expectasm: second_flags_copy:
// expectasm: .byte $05
// expectasm: ; begin inline expansion first_get_color
// expectasm: ; begin inline expansion second_get_color
// forbidasm: TEMPLATE_lines
// forbidasm: TEMPLATE_color
// forbidasm: TEMPLATE_flags

include "machine_6502.c26"
instantiate "fixtures/instantiation_parameters/component.c26" as first (lines:=7)
instantiate "fixtures/instantiation_parameters/component.c26" as second (lines:=3, color:=0x2e, flags:=0b1.X)

uint8_t result;
void main(void) {
   result := first_get_color() + second_get_color();
}
