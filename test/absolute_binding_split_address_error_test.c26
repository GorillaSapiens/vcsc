// vcsc-cc1 -I .
// expectfail
// expecterr: does not have one conventional read/write address for plain '&'
// expecterr: use '&<' for its read address or '&>' for its write address

include "machine_6502.c26"

type u8  { $size:1 $integer:unsigned };
type u16 { $size:2 $integer:unsigned $endian:little };

u16 banked@[0x100/0x180];

int16_t *p;

int16_t main(void) {
   p := &banked;
   return 0;
}
