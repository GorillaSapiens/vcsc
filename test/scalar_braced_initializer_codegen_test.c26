// vcsc-cc1
// expectasm: g_direct:
// expectasm: 	.byte $05, $00
// expectasm: g_nested:
// expectasm: 	.byte $07, $00
// expectasm: .export __init_
// expectasm: .proc __init_
// expectasm: jsr twice
// expectasm: sta  g_runtime
// expectasm: demo$s:
// expectasm: .res 2
// expectasm: sta  demo$s

type void { $size:0 };
type uint8_t { $size:1 $integer:unsigned };
type *    { $size:2 $integer:unsigned $endian:little };
type int16_t  { $size:2 $integer:signed $endian:little };

int16_t twice(int16_t x) {
   return x + x;
}

int16_t g_direct := { 5 };
int16_t g_nested := { { 7 } };
int16_t seed := 3;
int16_t g_runtime := { twice(seed) + 1 };

int16_t demo(void) {
   static int16_t s := { twice(3) + 1 };
   int16_t x := { 9 };
   return g_direct + g_nested + g_runtime + s + x;
}
