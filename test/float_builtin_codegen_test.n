// n65c -I .
// expectasm: jsr _f16_add
// expectasm: jsr _f16_sub
// expectasm: jsr _f16_mul
// expectasm: jsr _f16_div
// expectasm: jsr _f32_add
// expectasm: jsr _f32_sub
// expectasm: jsr _f32_mul
// expectasm: jsr _f32_div
// expectasm: jsr _f64_add
// expectasm: jsr _f64_sub
// expectasm: jsr _f64_mul
// expectasm: jsr _f64_div
// forbidasm: _faddN
// forbidasm: _fsubN
// forbidasm: _fmulN
// forbidasm: _fdivN

include "machine_6502.n"

half hresult;
float fresult;
double dresult;

void hmath(half a, half b) {
   hresult := ((a + b) - b) * b / a;
}

void fmath(float a, float b) {
   fresult := ((a + b) - b) * b / a;
}

void dmath(double a, double b) {
   dresult := ((a + b) - b) * b / a;
}
