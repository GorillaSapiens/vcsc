include "machine_6502.c26"
instantiate "fixtures/templates/component.c26" as first
instantiate "fixtures/templates/component.c26" as second
instantiate "fixtures/templates/component.c26" as λ

uint8_t MY_TEMPLATE_HELPER;
uint8_t result;

void main(void) {
   first_init();
   second_init();
   λ_init();
   first();
   second();
   λ();
   first_value := 2;
   second_value := 3;
   λ_value := 4;
   result := first_get() + second_get() + λ_get();
}
