// vcsc-cc1
// expectasm:     lda fp+1
// expectasm:     pha
// expectasm:     lda fp
// expectasm:     pha
// expectasm:     jsr id
// expectasm:     pla
// expectasm:     sta fp
// expectasm:     pla
// expectasm:     sta fp+1

type void { $size:0 };
type uint8_t { $size:1 $integer:unsigned };
type *    { $size:2 $integer:unsigned $endian:little };
type int16_t  { $size:2 $integer:signed $endian:little };

int16_t id(int16_t x) {
   return x;
}

int16_t main(void) {
   int16_t a := 7;
   int16_t b := id(a);
   return b;
}
