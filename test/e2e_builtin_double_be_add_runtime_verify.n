// n65c -I .
// expectexit: 0
include "machine_6502.n"
type dbe { $size:8 $endian:big $float:ieee754 };
union bits { dbe f; char b[8]; };
ref char gfailcode@[none/0x02f0];
void pass(void) { asm lda #$ff; asm ldx #0; asm ldy #0; asm jsr $ffff; }
void fail(int code) { gfailcode := code; asm lda #$ff; asm ldx $02f0; asm ldy #0; asm jsr $ffff; }
void expect8(bits got, bits want) {
   if (got.b[0] != want.b[0]) { fail(1); } if (got.b[1] != want.b[1]) { fail(2); }
   if (got.b[2] != want.b[2]) { fail(3); } if (got.b[3] != want.b[3]) { fail(4); }
   if (got.b[4] != want.b[4]) { fail(5); } if (got.b[5] != want.b[5]) { fail(6); }
   if (got.b[6] != want.b[6]) { fail(7); } if (got.b[7] != want.b[7]) { fail(8); }
}
void main(void) {
   bits g; bits w;
   g.f := 1.0`dbe + 0.5`dbe;
   w.b[0] := 0x3f; w.b[1] := 0xf8; w.b[2] := 0x00; w.b[3] := 0x00;
   w.b[4] := 0x00; w.b[5] := 0x00; w.b[6] := 0x00; w.b[7] := 0x00;
   expect8(g, w); pass();
}
