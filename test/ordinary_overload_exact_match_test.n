// n65c
// expectasm: jsr pick@s1_p0_a0
// expectasm: jsr pick@s2_p0_a0

type void { $size:0 };
type uint8_t { $size:1 $integer:unsigned };
type *    { $size:2 $integer:unsigned $endian:little };
type s1   { $size:1 $integer:signed };
type s2   { $size:2 $integer:signed $endian:little };

s2 pick(s1 x) {
   return x;
}

s2 pick(s2 x) {
   return 4;
}

s2 use_small(s1 x) {
   return pick(x);
}

s2 use_big(s2 x) {
   return pick(x);
}
