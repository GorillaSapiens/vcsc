// n65c -I .
// expectfail
// expecterr: cannot create a pointer to function 'inc' because it has symbol-backed parameters
include "machine_6502.n"

type uint16_t { $size:2 $integer:unsigned $endian:little };

uint16_t inc(uint16_t x) {
   return x + 1;
}

int main(void) {
   uint16_t (*fp)(uint16_t);
   fp := inc;
   return 0;
}
