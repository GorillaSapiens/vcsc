// vcsc-cc1 -I .
// expectexit: 0

include "machine_6502.c26"


static int16_t read_first(const int8_t* p) {
   return p[0];
}

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   int8_t a[1], b[1];
   const int8_t* p;

   a[0] := 1;
   b[0] := 2;

   p := a;
   p := b;

   if (read_first(p) != 2) {
      asm lda #$ff;
      asm ldx #1;
      asm ldy #0;
      asm jsr $ffff;
   }

   pass();
}
