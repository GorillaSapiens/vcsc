// n65c -I .
// expectasm: jsr _leNsle
// expectasm: jsr _add32le
// expectasm: jsr _mulNle
// expectasm: jsr _lslNle
// expectasm: jsr _fcmp
// expectasm: jsr _f32_add
// expectasm: jsr _f32_mul
// forbidasm: ?@op_add@s4_p0_a0@s4_p0_a0
// forbidasm: ?@op_mul@s4_p0_a0@s4_p0_a0
// forbidasm: ?@op_le@s4_p0_a0@s4_p0_a0
// forbidasm: ?@op_lsh@u4_p0_a0@u4_p0_a0
// forbidasm: ?@op_eq@float_p0_a0@float_p0_a0
// forbidasm: ?@op_add@float_p0_a0@float_p0_a0
// forbidasm: ?@op_mul@float_p0_a0@float_p0_a0

include "machine_6502.n"

type s4 { $size:4 $integer:signed $endian:little };
type u4 { $size:4 $integer:unsigned $endian:little };

s4 sresult;
u4 uresult;
float fresult;

void addmulcmp(s4 a, s4 b) {
   if (a <= b) {
      sresult := a + b;
      return;
   }
   sresult := a * b;
}

void shl(u4 a, u4 b) {
   uresult := a << b;
}

bool feq(float a, float b) {
   return a == b;
}

void fmath(float a, float b) {
   fresult := (a + b) * b;
}
