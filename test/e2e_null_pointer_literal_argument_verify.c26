// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.c26"

type BYTE { $size:1 $integer:unsigned };

int16_t check_null(BYTE *p) {
   return p == 0;
}

void main(void) {
   if (check_null(0) != 1) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
