// n65c -I .
// expectfail
// expecterr: call graph cycle reaches function 'recur' with static activation storage
include "machine_6502.n"

type uint16_t { $size:2 $integer:unsigned $endian:little };

uint16_t recur(uint16_t x) {
   if (x) {
      return recur(x - 1);
   }
   return 0;
}

int main(void) {
   return recur(3);
}
