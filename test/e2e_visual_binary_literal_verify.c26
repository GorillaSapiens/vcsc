// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.c26"

#if 0bX....... == 128
alias VISUAL_PP_OK 1
#else
alias VISUAL_PP_OK 0
#endif

const uint8_t rows[7] := {
   0b........,
   0b..XXX...,
   0b.X...X..,
   0bX......X,
   0bXXXXXXXX,
   0bxx..0011,
   0bXXXX_....,
};

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   if (!VISUAL_PP_OK) { fail(1); }
   if (rows[0] != 0x00) { fail(2); }
   if (rows[1] != 0x38) { fail(3); }
   if (rows[2] != 0x44) { fail(4); }
   if (rows[3] != 0x81) { fail(5); }
   if (rows[4] != 0xff) { fail(6); }
   if (rows[5] != 0xc3) { fail(7); }
   if (rows[6] != 0xf0) { fail(8); }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
