// vcsc-cc1 -I .
// expectsim: OK
// expectexit: 0

include "machine_6502.vcsc"

type u24 { $size:3 $integer:unsigned $endian:little };
type i24 { $size:3 $integer:signed $endian:little };
type u32 { $size:4 $integer:unsigned $endian:little };
type i32 { $size:4 $integer:signed $endian:little };

static int8_t ok[4] := { 'O', 'K', '\n', 0 };
static int8_t bad[5] := { 'B', 'A', 'D', '\n', 0 };

void print_ok(void) {
   asm lda #0;
   asm ldx #<ok;
   asm ldy #>ok;
   asm jsr $ffff;
}

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void print_bad(void) {
   asm lda #0;
   asm ldx #<bad;
   asm ldy #>bad;
   asm jsr $ffff;
}

u32 exercise(u24 a, u32 b) {
   u32 x := a;
   x += b;
   x ^= 0x01020304;
   x <<= 3;
   x >>= 2;
   x++;
   --x;
   return x;
}

void main(void) {
   u24 a := 0x123456;
   u32 b := 0x10203040;
   u32 x := exercise(a, b);
   if (x != 0x2260cf24) {
      print_bad();
      return;
   }

   i24 s := 0;
   s -= 2;
   s >>= 1;
   i24 negone := 0;
   negone--;
   if (s != negone) {
      print_bad();
      return;
   }

   u32 m := 0x1234 * 0x100;
   if (m != 0x123400) {
      print_bad();
      return;
   }

   u32 q := 0x12345678 / 0x1234;
   u32 r := 0x12345678 % 0x1234;
   if (q != 0x10004 || r != 0x0da8) {
      print_bad();
      return;
   }

   u32 folded := (0x12345678`u32 + 0x11111111`u32) ^ 0x01010101`u32;
   if (folded != 0x22446688) {
      print_bad();
      return;
   }

   u24 narrowed := 0xabcdef;
   u32 widened := narrowed;
   if (widened != 0x00abcdef) {
      print_bad();
      return;
   }

   print_ok();
   pass();
}
