include "machine_6502.vcsc"

int16_t main(void) {
   int16_t x;
   int16_t *p;
   int16_t **pp;
   int16_t ***ppp;
   p := &x;
   pp := &p;
   ppp := &pp;
   ***ppp := 7;
   return ***ppp;
}
