// n65c

type void { $size:0 };
type bool { $size:1 $integer:unsigned };
type *    { $size:2 $integer:unsigned $endian:little };
type u2le { $size:2 $integer:unsigned $endian:little };
type u2be { $size:2 $integer:unsigned $endian:big };

void sink(u2be v) {
}

void sink_le(u2le v) {
}

u2be result;

void return_add(u2be a, u2le b) {
   result := a + b;
}

void return_sub(u2be a, u2le b) {
   result := a - b;
}

void return_mul(u2be a, u2le b) {
   result := a * b;
}

void return_div(u2be a, u2le b) {
   result := a / b;
}

void return_mod(u2be a, u2le b) {
   result := a % b;
}

void return_and(u2be a, u2le b) {
   result := a & b;
}

void return_or(u2be a, u2le b) {
   result := a | b;
}

void return_xor(u2be a, u2le b) {
   result := a ^ b;
}

void return_shl(u2be a, u2le b) {
   result := a << b;
}

void return_shr(u2be a, u2le b) {
   result := a >> b;
}

void init_target(u2be a, u2le b) {
   u2be r := a * b;
   result := r;
}

void assign_target(u2be a, u2le b) {
   u2be r;
   r := a * b;
   result := r;
}

void braced_assign_target(u2be a, u2le b) {
   u2be r;
   r := { a * b };
   result := r;
}

void call_target(u2be a, u2le b) {
   sink(a * b);
}

void call_target_le(u2be a, u2le b) {
   sink_le(a * b);
}

void nested_target(u2be a, u2le b, u2le c) {
   result := (a * b) + c;
}

bool compare_return(u2be a, u2le b) {
   return a < b;
}

void compare_condition(u2be a, u2le b) {
   if (a == b) {
      sink(a);
   }
}
