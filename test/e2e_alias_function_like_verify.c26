// vcsc-cc1 -I .
// expectexit: 0

include "machine_6502.c26"

alias inc(x) (x + 1)
alias add(a,b) (a + b)

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   int16_t x := add(inc(5), add(2, 3));

   if (x != 11) {
      asm lda #$ff;
      asm ldx #1;
      asm ldy #0;
      asm jsr $ffff;
   }

   pass();
}
