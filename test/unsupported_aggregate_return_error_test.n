// n65c
// expectfail
// expecterr: function 'make_pair' has an unsupported return type
// expecterr: functions may return only void, an 8- or 16-bit little-endian integer, or a 16-bit pointer

type void { $size:0 };
type uint8_t { $size:1 $integer:unsigned };
type int16_t  { $size:2 $integer:signed $endian:little };
type *    { $size:2 $integer:unsigned $endian:little };

struct Pair { int16_t a; int16_t b; };

Pair make_pair(void) {
   Pair p;
   return p;
}
