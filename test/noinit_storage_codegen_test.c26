// vcsc-cc1 -I .
// expectasm: .segment "BSS.__vcsc_noinit$.__vcsc_object$riot_keep"
// expectasm: .segment "BSS.cartram.__vcsc_noinit$.__vcsc_object$cart_keep"
// expectasm: lda  cart_keep
// expectasm: sta riot_keep
// expectasm: sta  {cart_keep - 128}

include "machine_6502.c26"
mem cartram { $read_start:0xF080 $write_start:0xF000 $size:0x80 $rw };

noinit uint8_t riot_keep;
noinit cartram uint8_t cart_keep;

void main(void) {
   riot_keep := cart_keep;
   cart_keep := riot_keep;
}
