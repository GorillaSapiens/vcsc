// vcsc-cc1 -I .
// expectsim: OK
// expectexit: 0
include "machine_6502.c26"
static int8_t ok[4] := { 'O', 'K', '\n', 0 };
static int8_t bad[5] := { 'B', 'A', 'D', '\n', 0 };
void print_ok(void) { asm lda #0; asm ldx #<ok; asm ldy #>ok; asm jsr $ffff; }
void print_bad(void) { asm lda #0; asm ldx #<bad; asm ldy #>bad; asm jsr $ffff; }
void pass(void) { asm lda #$ff; asm ldx #0; asm ldy #0; asm jsr $ffff; }
void fail(void) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }
void main(void) {
   $A := 0;
   $C := 1;
   if (!$C) { asm jmp @bad_flags; }
   if (!$Z) { asm jmp @bad_flags; }
   if ($N) { asm jmp @bad_flags; }

   $A := 0x80;
   $C := 0;
   if ($C) { asm jmp @bad_flags; }
   if (!$N) { asm jmp @bad_flags; }
   if ($Z) { asm jmp @bad_flags; }

   asm lda #$40; asm clc; asm adc #$40;
   $C := 1;
   if (!$V) { asm jmp @bad_flags; }
   $A := 0x80;
   $V := 0;
   if ($V) { asm jmp @bad_flags; }
   if (!$C) { asm jmp @bad_flags; }
   if (!$N) { asm jmp @bad_flags; }
   if ($Z) { asm jmp @bad_flags; }

   $I := 1;
   asm php; asm pla; asm and #$04; asm beq @bad_flags;
   $I := 0;
   asm php; asm pla; asm and #$04; asm bne @bad_flags;
   $D := 1;
   asm php; asm pla; asm and #$08; asm beq @bad_flags;
   $D := 0;
   asm php; asm pla; asm and #$08; asm bne @bad_flags;

   print_ok(); pass(); return;
   asm @bad_flags:;
   print_bad(); fail();
}
