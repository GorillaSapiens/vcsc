// n65c -I .
// expectexit: 0

include "machine_6502.n"

union half_bits { half f; char b[2]; };
ref char gfailcode@[none/0x02f0];

void pass(void) { asm lda #$ff; asm ldx #0; asm ldy #0; asm jsr $ffff; }
void fail(int code) { gfailcode := code; asm lda #$ff; asm ldx $02f0; asm ldy #0; asm jsr $ffff; }

void expect2(half_bits got, half_bits want, int code) {
   if (got.b[0] != want.b[0]) { fail(code + 0); }
   if (got.b[1] != want.b[1]) { fail(code + 1); }
}

void main(void) {
   half_bits got;
   half_bits want;

   got.f := 1.0`half + 0.5`half;
   want.f := 1.5`half;
   expect2(got, want, 1);

   got.f := 1.5`half * 0.5`half;
   want.f := 0.75`half;
   expect2(got, want, 5);

   got.f := 1.5`half / 0.5`half;
   want.f := 3.0`half;
   expect2(got, want, 9);

   pass();
}
