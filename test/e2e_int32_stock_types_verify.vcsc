// vcsc-cc1 -I .
// expectsim: OK
// expectexit: 0
include "machine_6502.vcsc"

static int8_t ok[4] := { 'O', 'K', '\n', 0 };
static int8_t bad[5] := { 'B', 'A', 'D', '\n', 0 };

void print_ok(void) {
   asm lda #0;
   asm ldx #<ok;
   asm ldy #>ok;
   asm jsr $ffff;
}

void print_bad(void) {
   asm lda #0;
   asm ldx #<bad;
   asm ldy #>bad;
   asm jsr $ffff;
}

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

uint32_t add_wide32(uint32_t a, uint24_t b) {
   return a + b;
}

int32_t signed_step32(int32_t value) {
   return value - 1;
}

void main(void) {
   uint32_t u := add_wide32(0x12345678, 0x010203);
   if (u != 0x1235587b) {
      print_bad();
      return;
   }

   int32_t s := signed_step32(0);
   if (s != -1) {
      print_bad();
      return;
   }

   uint24_t narrow := 0xabcdef;
   uint32_t widened := narrow;
   if (widened != 0x00abcdef) {
      print_bad();
      return;
   }

   uint32_t bits := (uint32_t)-1;
   int32_t back := (int32_t)bits;
   if (bits != 0xffffffff || back != -1) {
      print_bad();
      return;
   }

   int32_t shifted := -2;
   shifted >>= 1;
   if (shifted != -1 || sizeof(int32_t) != 4 || sizeof(uint32_t) != 4) {
      print_bad();
      return;
   }

   uint32_t product := 0x1234 * 0x10000;
   uint32_t quotient := 0x12345678 / 0x1234;
   uint32_t remainder := 0x12345678 % 0x1234;
   if (product != 0x12340000 || quotient != 0x10004 || remainder != 0x0da8) {
      print_bad();
      return;
   }

   print_ok();
   pass();
}
