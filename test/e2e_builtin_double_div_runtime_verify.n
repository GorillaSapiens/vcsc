// n65c -I .
// expectexit: 0

include "machine_6502.n"

union double_bits { double f; char b[8]; };
ref char gfailcode@[none/0x02f0];

void pass(void) { asm lda #$ff; asm ldx #0; asm ldy #0; asm jsr $ffff; }
void fail(int code) { gfailcode := code; asm lda #$ff; asm ldx $02f0; asm ldy #0; asm jsr $ffff; }

void expect8(double_bits got, double_bits want, int code) {
   if (got.b[0] != want.b[0]) { fail(code + 0); }
   if (got.b[1] != want.b[1]) { fail(code + 1); }
   if (got.b[2] != want.b[2]) { fail(code + 2); }
   if (got.b[3] != want.b[3]) { fail(code + 3); }
   if (got.b[4] != want.b[4]) { fail(code + 4); }
   if (got.b[5] != want.b[5]) { fail(code + 5); }
   if (got.b[6] != want.b[6]) { fail(code + 6); }
   if (got.b[7] != want.b[7]) { fail(code + 7); }
}

void main(void) {
   double_bits got;
   double_bits want;
   got.f := 1.5`double / 0.5`double;
   want.f := 3.0`double;
   expect8(got, want, 1);
   pass();
}
