// n65c -I .
// expectasm: jsr _mulNbe
// expectasm: jsr _divNbe
// expectasm: jsr _lslNbe
// expectasm: jsr _lsrNbe
// expectasm: jsr _asrNbe
// expectasm: jsr _leNsbe

type void      { $size:0 };
type bool      { $size:1 $integer:unsigned };
type u2be      { $size:2 $integer:unsigned $endian:big };
type s2be      { $size:2 $integer:signed $endian:big };
type *         { $size:2 $integer:unsigned $endian:little };

u2be result_u;
s2be result_s;

void mulbe(u2be a, u2be b) {
   result_u := a * b;
}

void divbe(u2be a, u2be b) {
   result_u := a / b;
}

void shlbe(u2be a, u2be b) {
   result_u := a << b;
}

void shrbe(u2be a, u2be b) {
   result_u := a >> b;
}

void sarbe(s2be a, u2be b) {
   result_s := a >> b;
}

bool cmplebe(s2be a, s2be b) {
   return a <= b;
}
