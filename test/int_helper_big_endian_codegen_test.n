// n65c -I .
// expectasm: jsr _add24be
// expectasm: jsr _sub24be
// expectasm: jsr _addNbe
// expectasm: jsr _subNbe
// expectasm: .import _add24be
// expectasm: .import _sub24be
// expectasm: .import _addNbe
// expectasm: .import _subNbe

type void      { $size:0 };
type bool      { $size:1 $integer:unsigned };
type s3be      { $size:3 $integer:signed $endian:big };
type s5be      { $size:5 $integer:signed $endian:big };
type *         { $size:2 $integer:unsigned $endian:little };

s3be result3;
s5be result5;

void add3(s3be a, s3be b) {
   result3 := a + b;
}

void sub3(s3be a, s3be b) {
   result3 := a - b;
}

void add5(s5be a, s5be b) {
   result5 := a + b;
}

void sub5(s5be a, s5be b) {
   result5 := a - b;
}
