// vcsc-cc1 -I ../libraries/vcs
// expectmap: ram        start=$0080 size=$007E type=rw
// expectmap: __stack_top   $00FD
// expectmap: region=ram depth=1 bytes=$0002 physical=$00FE-$00FF
// expectmap: __call_stack_depth
// expectmap: __call_stack_size
// expectexit: 0

include "4K/mapper.c26"

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   pass();
}
