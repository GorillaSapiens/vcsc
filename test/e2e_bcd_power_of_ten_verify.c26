// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.c26"

bcd16_t static_mul := 12`bcd16_t * 10;
bcd16_t static_div := 1234`bcd16_t / 10;
bcd16_t static_mod := 1234`bcd16_t % 100;

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   bcd8_t a8;
   bcd16_t a16;
   bcd24_t a24;
   bcd32_t a32;

   if (static_mul != 120 || static_div != 123 || static_mod != 34) { fail(1); }

   a8 := 12;
   if (a8 * 10 != 20) { fail(2); }
   if (10 * a8 != 20) { fail(3); }
   if (a8 * 100 != 0) { fail(4); }
   a8 := 98;
   if (a8 / 10 != 9) { fail(5); }
   if (a8 % 10 != 8) { fail(6); }
   if (a8 / 100 != 0) { fail(7); }
   if (a8 % 100 != 98) { fail(8); }
   if (a8 * 1 != 98 || a8 / 1 != 98 || a8 % 1 != 0) { fail(9); }

   a16 := 1234;
   if (a16 * 10 != 2340) { fail(10); }
   if (a16 * 100 != 3400) { fail(11); }
   if (a16 / 10 != 123) { fail(12); }
   if (a16 / (10 * 10) != 12) { fail(13); }
   if (a16 % 10 != 4) { fail(14); }
   if (a16 % 100 != 34) { fail(15); }
   if (a16 % 1000 != 234) { fail(16); }
   if (a16 * 10000 != 0 || a16 / 10000 != 0 || a16 % 10000 != 1234) { fail(17); }

   a24 := 123456;
   if (a24 * 10 != 234560) { fail(18); }
   if (a24 * 1000 != 456000) { fail(19); }
   if (a24 / 10 != 12345) { fail(20); }
   if (a24 / 1000 != 123) { fail(21); }
   if (a24 % 10 != 6) { fail(22); }
   if (a24 % 1000 != 456) { fail(23); }
   if (a24 % 100000 != 23456) { fail(24); }
   if (a24 * 1000000 != 0 || a24 / 1000000 != 0 || a24 % 1000000 != 123456) { fail(25); }

   a32 := 12345678;
   if (a32 * 10 != 23456780) { fail(26); }
   if (a32 * 100 != 34567800) { fail(27); }
   if (a32 * 100000 != 67800000) { fail(28); }
   if (a32 / 10 != 1234567) { fail(29); }
   if (a32 / 1000 != 12345) { fail(30); }
   if (a32 / 1000000 != 12) { fail(31); }
   if (a32 % 10 != 8) { fail(32); }
   if (a32 % 1000 != 678) { fail(33); }
   if (a32 % 10000000 != 2345678) { fail(34); }
   if (a32 * 100000000 != 0 || a32 / 100000000 != 0 ||
       a32 % 100000000 != 12345678) { fail(35); }

   a8 := 47;
   a8 *= 10;
   if (a8 != 70) { fail(36); }
   a8 /= 10;
   if (a8 != 7) { fail(37); }
   a8 %= 10;
   if (a8 != 7) { fail(38); }

   a16 := 9876;
   a16 *= 100;
   if (a16 != 7600) { fail(39); }
   a16 /= 10;
   if (a16 != 760) { fail(40); }
   a16 %= 100;
   if (a16 != 60) { fail(41); }

   a24 := 654321;
   a24 *= 1000;
   if (a24 != 321000) { fail(42); }
   a24 /= 100;
   if (a24 != 3210) { fail(43); }
   a24 %= 1000;
   if (a24 != 210) { fail(44); }

   a32 := 87654321;
   a32 *= 10000;
   if (a32 != 43210000) { fail(45); }
   a32 /= 1000;
   if (a32 != 43210) { fail(46); }
   a32 %= 10000;
   if (a32 != 3210) { fail(47); }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
