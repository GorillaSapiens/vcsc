mem zeropage { $start:0x0000 $size:0x0100 $rw $priority:2 };
mem cpustack { $start:0x0100 $size:0x0100 $rw };
mem ram      { $start:0x0200 $size:0x1e00 $rw $priority:2 };
mem rom      { $start:0x2000 $size:0xe000 $ro $priority:1 };

type void     { $size:0 };
type int8_t     { $size:1 $integer:unsigned };
type uint8_t     { $size:1 $integer:unsigned };
type *        { $size:2 $integer:unsigned $endian:little };
type int16_t      { $size:2 $integer:signed $endian:little };

int8_t helper(int8_t x) {
   return x;
}
