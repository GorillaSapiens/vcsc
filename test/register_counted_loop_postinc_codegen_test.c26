// vcsc-cc1 -I .
// expectasmordered: ldx #$00
// expectasmordered: @for_start_
// expectasmordered: lda value,x
// expectasmordered: sta result,x
// expectasmordered: @for_step_
// expectasmordered: inx
// expectasmordered: cpx #$02
// expectasmordered: bcc @for_start_
// forbidasm: main$i
// forbidasm: inc main$i

include "machine_6502.c26"

uint8_t value[2];
uint8_t result[2];

void main(void) {
   for (uint8_t i := 0; i < 2; i++) {
      result[i] := value[i];
   }
}
