// vcsc-cc1
// expectasm: .import _sar16
// expectasm: jsr _sar16
// expectasm: and #$80
// expectasm: @cmp_same_sign_
// forbidasm: _copysxNle
// forbidasm: _asrNle
// forbidasm: _leNsle

include "machine_6502.c26"

int16_t widen_result;

void widen(int8_t c) {
   widen_result := c;
}

int16_t shr(int16_t value, int16_t bits) {
   return value >> bits;
}

uint8_t ge_zero(int16_t value) {
   return value >= 0;
}
