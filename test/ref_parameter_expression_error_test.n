// n65c
// expectfail
// expecterr: argument 1 passed to ref parameter of function 'foo' must be an lvalue

type void { $size:0 };
type uint8_t { $size:1 $integer:unsigned };
type *    { $size:2 $integer:unsigned $endian:little };
type int16_t  { $size:2 $integer:signed $endian:little };

void foo(ref int16_t x) {
}

void main(int16_t a, int16_t b) {
   foo(a * b);
}
