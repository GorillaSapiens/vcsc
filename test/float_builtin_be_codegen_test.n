// n65c -I .
// expectasm: jsr _f16be_add
// expectasm: jsr _f16be_sub
// expectasm: jsr _f16be_mul
// expectasm: jsr _f16be_div
// expectasm: jsr _f32be_add
// expectasm: jsr _f32be_sub
// expectasm: jsr _f32be_mul
// expectasm: jsr _f32be_div
// expectasm: jsr _f64be_add
// expectasm: jsr _f64be_sub
// expectasm: jsr _f64be_mul
// expectasm: jsr _f64be_div
// forbidasm: jsr _f16_add
// forbidasm: jsr _f32_add
// forbidasm: jsr _f64_add
// forbidasm: _faddN
// forbidasm: _fsubN
// forbidasm: _fmulN
// forbidasm: _fdivN

include "machine_6502.n"

type hbe { $size:2 $endian:big $float:ieee754 };
type fbe { $size:4 $endian:big $float:ieee754 };
type dbe { $size:8 $endian:big $float:ieee754 };

hbe hresult;
fbe fresult;
dbe dresult;

void hmath(hbe a, hbe b) {
   hresult := ((a + b) - b) * b / a;
}

void fmath(fbe a, fbe b) {
   fresult := ((a + b) - b) * b / a;
}

void dmath(dbe a, dbe b) {
   dresult := ((a + b) - b) * b / a;
}
