// n65c -I .
// forbidstderr: runtime division by constant power of two
// forbidstderr: runtime remainder by constant power of two

include "machine_6502.n"

uint8_t exercise(uint8_t x) {
   uint8_t y;
   y := x / 3;
   y := x % 5;
   y := x / 1;
   y := x % 1;
   y := 12 / 4;
   y := 13 % 4;
   return y;
}
