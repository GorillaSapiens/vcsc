// vcsc-cc1 -I .
// linkcfg: external_binding_holes.cfg
// expectexit: 0

include "machine_6502.c26"

int8_t gbytes[2];
int16_t gwords[2];
int8_t *gbytep;
int16_t *gwordp;
static int8_t *sgbytep;
static int16_t *sgwordp;
int8_t gfailcode;

void fail(int8_t code) {
   gfailcode := code;
   asm lda #$ff;
   asm ldx gfailcode;
   asm ldy #0;
   asm jsr $ffff;
}

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   int8_t lbytes[2];
   int16_t lwords[2];
   int8_t *lbytep;
   int16_t *lwordp;
   static int8_t *slbytep;
   static int16_t *slwordp;
   int8_t **indbytep := &gbytep;
   int16_t **indwordp := &gwordp;

   gbytes[0] := 11;
   gwords[0] := 0x1234;
   lbytes[0] := 22;
   lwords[0] := 0x2345;

   lbytep := lbytes;
   lwordp := lwords;
   if (lbytep[0] != 22) { fail(1); }
   if (lwordp[0] != 0x2345) { fail(2); }

   gbytep := gbytes;
   gwordp := gwords;
   if (gbytep[0] != 11) { fail(3); }
   if (gwordp[0] != 0x1234) { fail(4); }

   sgbytep := gbytes;
   sgwordp := gwords;
   if (sgbytep[0] != 11) { fail(5); }
   if (sgwordp[0] != 0x1234) { fail(6); }

   slbytep := lbytes;
   slwordp := lwords;
   if (slbytep[0] != 22) { fail(7); }
   if (slwordp[0] != 0x2345) { fail(8); }

   *indbytep := lbytes;
   *indwordp := lwords;
   if (gbytep[0] != 22) { fail(9); }
   if (gwordp[0] != 0x2345) { fail(10); }

   pass();
}
