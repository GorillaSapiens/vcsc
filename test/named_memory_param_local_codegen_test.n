// n65c -I .
// expectasm: .segment "BSS.banana"
// expectasm: bump$x:
// expectasm: bump$q:
// expectasm: .res 3
// expectasm: sta bump$q,y
// forbidasm: .segment "DATA.banana"

include "machine_6502.n"
mem banana { $start:0x0400 $size:0x0100 $rw };

void bump(banana int16_t x) {
   banana int8_t q[3] := { 1, 2, 3 };
   x++;
}
