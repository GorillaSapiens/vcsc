// vcsc-cc1 -I .
// expectasmordered: lda #$40
// expectasmordered: eor #$ff
// expectasmordered: and __vcsc_scratch_
// forbidasm: sta arg0
// forbidasm: jsr _bit_andN

include "machine_6502.c26"

type BYTE { $size:1 $integer:unsigned };

alias FA__WIP 0x40

BYTE clear(BYTE flag) {
   flag &= ~FA__WIP;
   return flag;
}
