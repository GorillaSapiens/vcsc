include "machine_6502.vcsc"

struct Pair {
   int16_t a;
   int16_t b;
};

int16_t twice(int16_t x) {
   return x + x;
}

int16_t seed := 3;
int16_t initialized := twice(seed);
Pair pairs[2];

void test(void) {
   int16_t index := 1;
   pairs[index] := { 7, 9 };
}
