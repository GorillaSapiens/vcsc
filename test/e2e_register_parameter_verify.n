// n65c -I .
// linkcfg: e2e_register_parameter_verify__register.cfg
// expectexit: 0
include "machine_6502.n"
mem register { $start:0x0080 $size:0x0010 $rw };

uint16_t observed;

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void capture(register uint16_t value) {
   observed := value;
}

void main(void) {
   observed := 0`uint16_t;
   capture(0x1234`uint16_t);
   if (observed != 0x1234`uint16_t) {
      asm lda #$ff;
      asm ldx #1;
      asm ldy #0;
      asm jsr $ffff;
   }
   pass();
}
