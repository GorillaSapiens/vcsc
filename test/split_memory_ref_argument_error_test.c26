// vcsc-cc1 -I .
// expectfail
// expecterr: ref argument 'foo' cannot bind to read/write ref parameter 'value' because its read address foo and write address {foo - 128} are different

include "machine_6502.c26"
mem superchip { $read_start:0xF080 $write_start:0xF000 $size:0x80 $rw };

superchip uint8_t foo;

void touch(ref uint8_t value) {
   value := 1;
}

void main(void) {
   touch(foo);
}
