// vcsc-cc1 -I .
// expectfail
// expecterr: absolute external binding 'foo' does not have a single address
// expecterr: address-taking, pointer decay, and ref passing are not supported for split-address objects

include "machine_6502.c26"
mem superchip { $read_start:0xF080 $write_start:0xF000 $size:0x80 $rw };

superchip uint8_t foo;

void touch(ref uint8_t value) {
   value := 1;
}

void main(void) {
   touch(foo);
}
