// n65c -I .
// expectexit: 0

include "machine_6502.n"

union float_bits { float f; char b[4]; };
ref char gfailcode@[none/0x02f0];

void pass(void) { asm lda #$ff; asm ldx #0; asm ldy #0; asm jsr $ffff; }
void fail(int code) { gfailcode := code; asm lda #$ff; asm ldx $02f0; asm ldy #0; asm jsr $ffff; }

void expect4(float_bits got, float_bits want, int code) {
   if (got.b[0] != want.b[0]) { fail(code + 0); }
   if (got.b[1] != want.b[1]) { fail(code + 1); }
   if (got.b[2] != want.b[2]) { fail(code + 2); }
   if (got.b[3] != want.b[3]) { fail(code + 3); }
}

void main(void) {
   float_bits got;
   float_bits want;

   got.f := 1.0 + 0.5;
   want.f := 1.5;
   expect4(got, want, 1);

   got.f := 1.5 - 0.5;
   want.f := 1.0;
   expect4(got, want, 5);

   got.f := 1.5 * 0.5;
   want.f := 0.75;
   expect4(got, want, 9);

   got.f := 1.5 / 0.5;
   want.f := 3.0;
   expect4(got, want, 13);

   pass();
}
