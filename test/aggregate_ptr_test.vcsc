// vcsc-cc1 -I .

include "machine_6502.vcsc"

struct Point {
   int16_t x;
   int16_t y;
};

union Value {
   int16_t i;
   int16_t l;
};

int16_t getx(Point *p) {
   return p->x;
}

int16_t main(void) {
   Point p;
   Point q;
   Value v;
   p.x := 3;
   p.y := 4;
   q := p;
   v.i := q.y;
   return getx(&q);
}
