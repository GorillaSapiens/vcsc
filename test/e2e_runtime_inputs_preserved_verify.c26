// vcsc-cc1 -I .
// expectexit: 0

include "machine_6502.c26"

ref int8_t mul_a0@0x0300;
ref int8_t mul_a1@0x0301;
ref int8_t mul_b0@0x0302;
ref int8_t mul_b1@0x0303;
ref int8_t mul_r0@0x0304;
ref int8_t mul_r1@0x0305;
ref int8_t mul_r2@0x0306;
ref int8_t mul_r3@0x0307;

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   asm .import _mulNle;
   asm .importzp _vcsc_ptr0;
   asm .importzp _vcsc_ptr1;
   asm .importzp _vcsc_ptr2;
   asm .importzp _vcsc_arg0;

   mul_a0 := 0x34; mul_a1 := 0x12;
   mul_b0 := 0x03; mul_b1 := 0x00;
   mul_r0 := 0xaa; mul_r1 := 0xbb; mul_r2 := 0xcc; mul_r3 := 0xdd;

   asm lda #<$0300;
   asm sta _vcsc_ptr0;
   asm lda #>$0300;
   asm sta _vcsc_ptr0+1;
   asm lda #<$0302;
   asm sta _vcsc_ptr1;
   asm lda #>$0302;
   asm sta _vcsc_ptr1+1;
   asm lda #<$0304;
   asm sta _vcsc_ptr2;
   asm lda #>$0304;
   asm sta _vcsc_ptr2+1;
   asm lda #2;
   asm sta _vcsc_arg0;
   asm jsr _mulNle;

   if (mul_a0 != 0x34) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }
   if (mul_a1 != 0x12) { asm lda #$ff; asm ldx #2; asm ldy #0; asm jsr $ffff; }
   if (mul_b0 != 0x03) { asm lda #$ff; asm ldx #3; asm ldy #0; asm jsr $ffff; }
   if (mul_b1 != 0x00) { asm lda #$ff; asm ldx #4; asm ldy #0; asm jsr $ffff; }
   if (mul_r0 != 0x9c) { asm lda #$ff; asm ldx #5; asm ldy #0; asm jsr $ffff; }
   if (mul_r1 != 0x36) { asm lda #$ff; asm ldx #6; asm ldy #0; asm jsr $ffff; }
   if (mul_r2 != 0x00) { asm lda #$ff; asm ldx #7; asm ldy #0; asm jsr $ffff; }
   if (mul_r3 != 0x00) { asm lda #$ff; asm ldx #8; asm ldy #0; asm jsr $ffff; }

   pass();
}
