// n65c -I .
// expectexit: 0
include "machine_6502.n"


uint8_t source;
uint16_t destination;

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   source := 0x7a`uint8_t;
   destination := source;
   if (destination != 0x007a`uint16_t) {
      fail(1);
   }
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
