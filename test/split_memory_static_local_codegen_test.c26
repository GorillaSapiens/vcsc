// vcsc-cc1 -I .
// expectasm: .segmentaddrsize "BSS.cartram", absolute
// expectasm: .segmentaddrsize "DATA.cartram", absolute
// expectasm: .segment "BSS.cartram"
// expectasm: hold$zero:
// expectasm: hold$runtime:
// expectasm: .segment "DATA.cartram"
// expectasm: hold$fixed:
// expectasm: hold$values:
// expectasm: lda  hold$zero
// expectasm: sta  {hold$runtime - 128}
// forbidasm: BSS.cartram.__vcsc_activation$hold

include "machine_6502.c26"
mem cartram { $read_start:0xF080 $write_start:0xF000 $size:0x80 $rw };

uint8_t runtime_seed(void) {
   return 0x20;
}

uint8_t hold(void) {
   static cartram uint8_t zero;
   static cartram uint8_t fixed := 4;
   static cartram uint8_t runtime := runtime_seed();
   static cartram uint8_t values[2] := { 9, 10 };

   zero++;
   fixed += zero;
   runtime++;
   values[0]++;
   return fixed + runtime + values[0] + values[1];
}
