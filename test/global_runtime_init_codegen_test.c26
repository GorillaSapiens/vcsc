// vcsc-cc1
// forbidasm: .zpimport _vcsc_ptr1
// forbidasm: .import _zeroN
// forbidasm: .import _zero_bytes
// expectasm: .export __init_
// expectasm: .proc __init_
// expectasmordered: .proc __init_
// expectasmordered: lda #$00
// expectasmordered: sta  __vcsc_scratch_
// expectasmordered: jsr twice
// expectasmordered: sta  g

type void { $size:0 };
type uint8_t { $size:1 $integer:unsigned };
type *    { $size:2 $integer:unsigned $endian:little };
type int16_t  { $size:2 $integer:signed $endian:little };

int16_t twice(int16_t x) {
   return x + x;
}

int16_t seed := 3;
int16_t g := twice(seed) + 1;

int16_t main(void) {
   return g;
}
