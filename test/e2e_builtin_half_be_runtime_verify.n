// n65c -I .
// expectexit: 0
include "machine_6502.n"
type hbe { $size:2 $endian:big $float:ieee754 };
union bits { hbe f; char b[2]; };
ref char gfailcode@[none/0x02f0];
void pass(void) { asm lda #$ff; asm ldx #0; asm ldy #0; asm jsr $ffff; }
void fail(int code) { gfailcode := code; asm lda #$ff; asm ldx $02f0; asm ldy #0; asm jsr $ffff; }
void expect2(bits got, bits want) {
   if (got.b[0] != want.b[0]) { fail(1); }
   if (got.b[1] != want.b[1]) { fail(2); }
}
void main(void) { bits g; bits w; g.f := 1.0`hbe + 1.0`hbe; w.b[0] := 0x40; w.b[1] := 0x00; expect2(g, w); pass(); }
