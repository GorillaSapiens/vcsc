// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.vcsc"


uint8_t return8(void) {
   return 0xa5`uint8_t;
}

uint16_t return16(void) {
   return 0x1234`uint16_t;
}

void main(void) {
   if (return8() != 0xa5`uint8_t) {
      asm lda #$ff;
      asm ldx #1;
      asm ldy #0;
      asm jsr $ffff;
   }

   if (return16() != 0x1234`uint16_t) {
      asm lda #$ff;
      asm ldx #2;
      asm ldy #0;
      asm jsr $ffff;
   }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
