// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.c26"

typedef int16_t int;
typedef uint8_t char;
typedef uint8_t bool;

uint8_t *string := "Hello, World!\n";

int add(int a, int b) {
   return a + b;
}

void fail(uint8_t code) {
   asm lda #$ff;
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm jsr $ffff;
}

void main(void) {
   bool ok := add(20, 22) == 42;
   char first := string[0];

   if (!ok) {
      fail(1);
   }
   if (first != 'H') {
      fail(2);
   }
   if (string[13] != '\n') {
      fail(3);
   }
   if (string[14] != 0) {
      fail(4);
   }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
