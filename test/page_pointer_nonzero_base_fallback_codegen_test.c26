// vcsc-cc1 -I .
// expectasm: lda #<{rows0 + 0}
// expectasm: lda #>{rows0 + 0}
// expectasm: lda #<{rows1 + 0}
// expectasm: lda #>{rows1 + 0}
// forbidasm: page_select_store
include "machine_6502.c26"

page const uint8_t rows0[224] := {0};
page const uint8_t rows1[224] := {0};
uint8_t *p;
uint8_t sprite;

void main(void) {
   if (sprite < 16) { p := rows0; }
   else { p := rows1; }
   p += (sprite & 0x0f) << 4;
}
