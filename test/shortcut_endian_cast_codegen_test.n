// n65c -I .
// expectasm: __n65_inittmp_
// forbidasm: jsr _pushN
// forbidasm: jsr _popN

include "machine_6502.n"

type u2be { $size:2 $integer:unsigned $endian:big };
type u2le { $size:2 $integer:unsigned $endian:little };

u2le result_le;
u2be result_be;

u2le addle(u2be a, u2le b) {
   return ($little)a + b;
}

void addbe(u2be a, u2le b) {
   result_be := a + ($big)b;
}

