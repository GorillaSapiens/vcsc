// vcsc-cc1 -I .
// simcfg: ../linker/cfg/sim.cfg
// expectsimerr: vcsc-sim: write to read-only memory at $2FFF
// expectexit: 1

include "machine_6502.c26"

void fail(void) {
   asm lda #$ff;
   asm ldx #$7f;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   asm lda #$41;
   asm sta $2fff;
   fail();
}
