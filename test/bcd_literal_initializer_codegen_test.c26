// expectasm: 	.byte $42
// expectasm: hex8:
// expectasm: 	.byte $42
// expectasm: oct8:
// expectasm: 	.byte $42
// expectasm: bin8:
// expectasm: 	.byte $42
// expectasm: dec16:
// expectasm: 	.byte $34, $12
// expectasm: hex16:
// expectasm: 	.byte $34, $12
// expectasm: dec24:
// expectasm: 	.byte $90, $78, $56
// expectasm: max8:
// expectasm: 	.byte $99
// expectasm: max16:
// expectasm: 	.byte $99, $99
// expectasm: max24:
// expectasm: 	.byte $99, $99, $99
// expectasm: dec32:
// expectasm: 	.byte $78, $56, $34, $12
// expectasm: max32:
// expectasm: 	.byte $99, $99, $99, $99
include "machine_6502.c26"

bcd8_t dec8 := 42;
bcd8_t hex8 := 0x2a;
bcd8_t oct8 := 052;
bcd8_t bin8 := 0b101010;
bcd16_t dec16 := 1234;
bcd16_t hex16 := 0x4d2;
bcd24_t dec24 := 567890;
bcd8_t max8 := 99;
bcd16_t max16 := 9999;
bcd24_t max24 := 999999;
bcd32_t dec32 := 12345678;
bcd32_t max32 := 99999999;

void main(void) {
   bcd8_t local8 := 42;
   bcd16_t local16 := 1234;
   bcd24_t local24 := 567890;
   bcd32_t local32 := 12345678;
   dec8 := 0x2a;
   dec16 := 0x4d2;
   dec24 := 0x8aa52;
   dec32 := 0xbc614e;
}
