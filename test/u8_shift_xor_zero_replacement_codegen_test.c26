// vcsc-cc1 -I .
// expectasmordered: lda  state
// expectasmordered: lsr
// expectasmordered: bcc @u8_shift_xor_skip_
// expectasmordered: eor #$b4
// expectasmordered: bne @u8_zero_keep_
// expectasmordered: lda #$5d
// expectasmordered: @u8_zero_keep_
// expectasmordered: sta  state
// forbidasm: lda state
// forbidasm: sta state
// forbidasm: __vcsc_scratch_
include "machine_6502.c26"

uint8_t state;

void main(void) {
   if (state & 1) {
      state := (state >> 1) ^ 0xb4;
   }
   else {
      state >>= 1;
   }

   if (!state) {
      state := 0x5d;
   }
}
