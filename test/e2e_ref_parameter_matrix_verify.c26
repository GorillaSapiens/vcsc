// vcsc-cc1 -I .
// expectexit: 0

include "machine_6502.c26"

struct Pair {
   uint16_t left;
   uint16_t right;
};

uint8_t fail_code;

void fail(uint8_t code) {
   fail_code := code;
   asm lda #$ff;
   asm ldx fail_code;
   asm ldy #0;
   asm jsr $ffff;
}

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

uint8_t read_u8(ref uint8_t value) {
   return value;
}

uint16_t read_u16(ref uint16_t value) {
   return value;
}

uint24_t read_u24(ref uint24_t value) {
   return value;
}

uint32_t read_u32(ref uint32_t value) {
   return value;
}

uint16_t read_static_u16(static ref uint16_t value) {
   return value;
}

uint16_t forward_u16(ref uint16_t value) {
   return read_u16(value);
}

uint32_t widen_u8(ref uint8_t value) {
   return value;
}

uint16_t narrow_u32(ref uint32_t value) {
   return value;
}

int16_t widen_s8(ref int8_t value) {
   return value;
}

uint16_t replace_and_read(ref uint16_t value, uint16_t replacement) {
   value := replacement;
   return value;
}

uint16_t add_and_read_static(static ref uint16_t value, uint16_t addend) {
   value += addend;
   return value;
}

void swap_u16(ref uint16_t a, ref uint16_t b) {
   uint16_t temporary := a;
   a := b;
   b := temporary;
}

void main(void) {
   uint8_t a8 := 0xa5`uint8_t;
   int8_t negative8 := -2`int8_t;
   uint16_t a16 := 0x1234`uint16_t;
   uint16_t b16 := 0xabcd`uint16_t;
   uint24_t a24 := 0x345678`uint24_t;
   uint32_t a32 := 0x89abcdef`uint32_t;
   uint8_t bytes[3] := { 0x11, 0x22, 0x33 };
   Pair pair := { 0x4567, 0x89ab };
   uint16_t *pointer := &pair.left;
   uint16_t static_result;

   if (read_u8(a8) != 0xa5`uint8_t) { fail(1`uint8_t); }
   if (read_u16(a16) != 0x1234`uint16_t) { fail(2`uint8_t); }
   if (read_u24(a24) != 0x345678`uint24_t) { fail(3`uint8_t); }
   if (read_u32(a32) != 0x89abcdef`uint32_t) { fail(4`uint8_t); }

   static_result := read_static_u16(a16);
   if (static_result != 0x1234`uint16_t) { fail(5`uint8_t); }
   if (forward_u16(a16) != 0x1234`uint16_t) { fail(6`uint8_t); }

   if (widen_u8(a8) != 0x000000a5`uint32_t) { fail(7`uint8_t); }
   if (narrow_u32(a32) != 0xcdef`uint16_t) { fail(8`uint8_t); }
   if (widen_s8(negative8) != -2`int16_t) { fail(9`uint8_t); }

   if (replace_and_read(a16, 0x2468`uint16_t) != 0x2468`uint16_t) { fail(10`uint8_t); }
   if (a16 != 0x2468`uint16_t) { fail(11`uint8_t); }

   swap_u16(a16, b16);
   if (a16 != 0xabcd`uint16_t || b16 != 0x2468`uint16_t) { fail(12`uint8_t); }

   swap_u16(a16, a16);
   if (a16 != 0xabcd`uint16_t) { fail(13`uint8_t); }

   if (add_and_read_static(a16, 0x0101`uint16_t) != 0xacce`uint16_t) { fail(14`uint8_t); }
   if (a16 != 0xacce`uint16_t) { fail(15`uint8_t); }

   if (read_u8(bytes[1]) != 0x22`uint8_t) { fail(16`uint8_t); }
   if (read_u16(pair.right) != 0x89ab`uint16_t) { fail(17`uint8_t); }
   if (read_u16(*pointer) != 0x4567`uint16_t) { fail(18`uint8_t); }

   replace_and_read(pair.right, 0x1357`uint16_t);
   if (pair.right != 0x1357`uint16_t) { fail(19`uint8_t); }

   pass();
}
