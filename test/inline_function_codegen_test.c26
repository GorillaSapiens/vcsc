// vcsc-cc1 -I .
// expectasm: __inline$0$adjust$value:
// expectasm: __inline$0$adjust$delta:
// expectasm: __inline$0$adjust$local:
// expectasm: __inline$1$adjust$value:
// expectasm: @inline_0_user_again:
// expectasm: @inline_1_user_again:
// expectasm: @inline_0_asm_fini:
// expectasm: @inline_1_asm_fini:
// expectasm: @inline_0_return:
// expectasm: @inline_1_return:
// expectasmordered: ; begin inline expansion adjust #0
// expectasmordered: ; end inline expansion adjust #0
// expectasmordered: ; begin inline expansion adjust #1
// expectasmordered: ; end inline expansion adjust #1
// forbidasm: .proc adjust
// forbidasm: jsr adjust
// forbidasm: .export adjust
// forbidasm: __abimeta$V1$function$definition$adjust

include "machine_6502.c26"

inline uint8_t adjust(ref uint8_t value, uint8_t delta);

inline uint8_t adjust(ref uint8_t value, uint8_t delta) {
   uint8_t local := value;
again:
   asm @fini:
   asm nop
   if (delta == 0`uint8_t) {
      return local;
   }
   local += delta;
   value := local;
   asm bne @fini
   return local;
}

uint8_t test_entry(void) {
   uint8_t value := 3`uint8_t;
   return adjust(value, 0`uint8_t) + adjust(value, 2`uint8_t);
}

void main(void) {
}
