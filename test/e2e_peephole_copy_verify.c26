// vcsc-cc1 -I . -X peephole -DMACHINE_6502_NO_DEFAULT_RAM -DMACHINE_6502_NO_DEFAULT_ROM
// linkcfg: external_binding_holes.cfg
// expecterr: 001 peephole
// expecterr: total_saved=17
// expecterr: dup_load=4
// expecterr: jump_next=1
// expectexit: 0
include "machine_6502.c26"

mem ram { $start:0x0800 $size:0x1800 $rw $priority:2 };
mem rom { $start:0x2000 $size:0xE000 $ro $priority:1 };

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void fail(int16_t code) {
   asm lda #$ff;
   asm ldx gfailcode;
   asm ldy #0;
   asm jsr $ffff;
}

int8_t gfailcode;

int16_t f(int16_t a) {
   int16_t x;
   x := a;
   return x;
}

void main(void) {
   if (f(0x1234) != 0x1234) {
      gfailcode := 1;
      fail(1);
   }
   if (f(0) != 0) {
      gfailcode := 2;
      fail(2);
   }
   pass();
}
