// vcsc-cc1 -I .
// expectexit: 0

include "machine_6502.c26"

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   uint8_t a8 := 23;
   uint8_t b8 := 17;
   uint8_t r8;
   uint16_t a16 := 0x1234;
   uint16_t b16 := 0x0103;
   uint16_t r16;
   uint24_t a24 := 0x123456;
   uint24_t b24 := 0x010203;
   uint24_t r24;
   uint32_t a32 := 0x12345678;
   uint32_t b32 := 0x00010203;
   uint32_t r32;

   r8 := a8 * b8;
   if (r8 != 0x87 || a8 != 23 || b8 != 17) { fail(1); }
   r16 := a16 * b16;
   if (r16 != 0x6a9c || a16 != 0x1234 || b16 != 0x0103) { fail(2); }
   r24 := a24 * b24;
   if (r24 != 0xf54902 || a24 != 0x123456 || b24 != 0x010203) { fail(3); }
   r32 := a32 * b32;
   if (r32 != 0xf5c1f368 || a32 != 0x12345678 || b32 != 0x00010203) { fail(4); }

   r8 := 250 / 13;
   if (r8 != 19) { fail(5); }
   r8 := 250 % 13;
   if (r8 != 3) { fail(6); }
   r16 := 1000 / 37;
   if (r16 != 27) { fail(7); }
   r16 := 1000 % 37;
   if (r16 != 1) { fail(8); }
   r24 := 0x123456 / 0x123;
   if (r24 != 4099) { fail(13); }
   r24 := 0x123456 % 0x123;
   if (r24 != 237) { fail(14); }
   r32 := 0x12345678 / 0x1234;
   if (r32 != 65540) { fail(15); }
   r32 := 0x12345678 % 0x1234;
   if (r32 != 3496) { fail(16); }

   r8 := 23;
   r8 *= 17;
   if (r8 != 0x87) { fail(9); }
   r16 := 1000;
   r16 /= 37;
   if (r16 != 27) { fail(10); }
   r24 := 0x123456;
   r24 %= 0x123;
   if (r24 != 237) { fail(11); }
   r32 := 0x12345678;
   r32 *= 0x00010203;
   if (r32 != 0xf5c1f368) { fail(12); }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
