// vcsc-cc1 -I .
// expectexit: 0

include "machine_6502.vcsc"

type u1 { $size:1 $integer:unsigned };

struct Pair {
   int16_t a;
   int16_t b;
};

struct Packed {
   u1 lo:4;
   u1 hi:4;
};

Pair gp;

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   int16_t x;
   int16_t slot;
   int16_t *p := &slot;
   int16_t a[3];
   Pair lp;
   Packed bits;

   x := { 1 };
   if (x != 1) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }

   a := { 2, 3 };
   if (a[0] != 2) { asm lda #$ff; asm ldx #2; asm ldy #0; asm jsr $ffff; }
   if (a[1] != 3) { asm lda #$ff; asm ldx #3; asm ldy #0; asm jsr $ffff; }
   if (a[2] != 0) { asm lda #$ff; asm ldx #4; asm ldy #0; asm jsr $ffff; }

   lp := { .b := 5, .a := 4 };
   if (lp.a != 4) { asm lda #$ff; asm ldx #5; asm ldy #0; asm jsr $ffff; }
   if (lp.b != 5) { asm lda #$ff; asm ldx #6; asm ldy #0; asm jsr $ffff; }

   gp := { 7, 8 };
   if (gp.a != 7) { asm lda #$ff; asm ldx #7; asm ldy #0; asm jsr $ffff; }
   if (gp.b != 8) { asm lda #$ff; asm ldx #8; asm ldy #0; asm jsr $ffff; }

   *p := { 9 };
   if (slot != 9) { asm lda #$ff; asm ldx #9; asm ldy #0; asm jsr $ffff; }

   bits.lo := { 0x0b };
   bits.hi := { 0x06 };
   if (bits.lo != 0x0b) { asm lda #$ff; asm ldx #10; asm ldy #0; asm jsr $ffff; }
   if (bits.hi != 0x06) { asm lda #$ff; asm ldx #11; asm ldy #0; asm jsr $ffff; }

   pass();
}
