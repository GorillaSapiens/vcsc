// n65c -I .
// expectasm: lda #$02
// expectasm: lda #$02

include "machine_6502.n"

struct PackedBits {
   char lo:4;
   char hi:4;
   char tag:1;
   char code:7;
};

struct WordBits {
   uint16_t payload:12;
   uint16_t tag:3;
   uint16_t sign:1;
};

union WordOverlay {
   uint16_t word;
   WordBits bits;
};

int main(void) {
   int a := sizeof(PackedBits);
   int b := sizeof(WordOverlay);
   return a + b;
}
