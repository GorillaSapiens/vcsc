// n65c -I .
// expectasm: lda #$02
// expectasm: lda #$02

include "machine_6502.n"

struct PackedBits {
   int8_t lo:4;
   int8_t hi:4;
   int8_t tag:1;
   int8_t code:7;
};

struct WordBits {
   uint16_t payload:12;
   uint16_t tag:3;
   uint16_t sign:1;
};

union WordOverlay {
   uint16_t word;
   WordBits bits;
};

int16_t main(void) {
   int16_t a := sizeof(PackedBits);
   int16_t b := sizeof(WordOverlay);
   return a + b;
}
