// vcsc-cc1 -I .

type void  { $size:0 };
type uint8_t  { $size:1 $integer:unsigned };
type *     { $size:2 $integer:unsigned $endian:little };
type int8_t  { $size:1 $integer:signed };
type BYTE  { $size:1 $integer:unsigned };
type int16_t   { $size:2 $integer:signed $endian:little };

static int16_t mem_cmp(const void* dst, const void* src, int16_t cnt) {
   return cnt;
}

int16_t main(void) {
   BYTE a[11], b[11];
   return mem_cmp(a, b, 11);
}
