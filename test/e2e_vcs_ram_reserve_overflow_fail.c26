// vcsc-cc1 -I ../libraries/vcs
// expectlinkfail
// expectlinkerr: ram overflow while placing BSS

include "4K/mapper.c26"

// The linker dynamically reserves the hardware stack from the top of the
// 128-byte RIOT RAM block. A 128-byte global must fail rather than overlap the
// call-graph-derived reserve or the runtime's own storage.
int8_t payload[128];

void store_payload(void) {
   payload[0] := 1;
}

void main(void) {
   store_payload();
}
