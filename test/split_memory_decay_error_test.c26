// vcsc-cc1 -I .
// expectfail
// expecterr: does not have one conventional read/write address for plain '&'
// expecterr: use '&<' for its read address or '&>' for its write address

include "machine_6502.c26"
mem cartram { $read_start:0xF080 $write_start:0xF000 $size:0x80 $rw };

cartram uint8_t buffer[8];
uint8_t *p;

void main(void) {
   p := buffer;
}
