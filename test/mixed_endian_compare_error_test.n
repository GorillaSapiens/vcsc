// n65c
// expectfail
// expecterr: mixed signed/unsigned ordinary integer operator '<' requires an explicit cast

type void { $size:0 };
type bool { $size:1 $integer:unsigned };
type *    { $size:2 $integer:unsigned $endian:little };
type u2le { $size:2 $integer:unsigned $endian:little };
type s2be { $size:2 $integer:signed $endian:big };

bool bad(s2be a, u2le b) {
   return a < b;
}
