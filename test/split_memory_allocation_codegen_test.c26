// vcsc-cc1 -I .
// expectasm: __memmeta$V2$superchip$RF080$WF000$Z0080$Trw = 0
// expectasm: .segmentaddrsize "BSS.superchip", absolute
// expectasm: .segmentaddrsize "DATA.superchip", absolute
// expectasm: .segment "BSS.superchip.__vcsc_object$foo"
// expectasm: .segment "BSS.superchip.__vcsc_object$buffer"
// expectasm: lda  foo
// expectasm: sta  {foo - 128}
// expectasm: sta  {buffer - 128} + 3
// expectasm: lda #<{{buffer - 128} + 0}
// expectasm: lda #<{buffer + 0}

include "machine_6502.c26"
mem superchip { $read_start:0xF080 $write_start:0xF000 $size:0x80 $rw };

uint8_t i;
superchip uint8_t foo;
superchip uint8_t buffer[8];

void main(void) {
   foo := 0x11;
   buffer[3] := foo;
   buffer[i] := foo;
   foo := buffer[i];
}
