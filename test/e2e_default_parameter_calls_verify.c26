// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.c26"


uint16_t level_c(uint8_t x, uint16_t y) {
   return x + y;
}

uint16_t level_b(uint8_t x, uint16_t y) {
   return level_c(x + 1`uint8_t, y + 2`uint16_t);
}

uint16_t level_a(uint8_t x, uint16_t y) {
   return level_b(x + 3`uint8_t, y + 4`uint16_t);
}

void main(void) {
   if (level_a(1`uint8_t, 10`uint16_t) != 21`uint16_t) {
      asm lda #$ff;
      asm ldx #1;
      asm ldy #0;
      asm jsr $ffff;
   }
   if (level_a(5`uint8_t, 20`uint16_t) != 35`uint16_t) {
      asm lda #$ff;
      asm ldx #2;
      asm ldy #0;
      asm jsr $ffff;
   }
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
