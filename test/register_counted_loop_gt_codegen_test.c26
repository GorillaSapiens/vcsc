// vcsc-cc1 -I .
// expectasmordered: ldx #$00
// expectasmordered: lda value,x
// expectasmordered: cmp #$95
// expectasmordered: bcc @if_false_
// expectasmordered: lda #$01
// expectasmordered: sta hit,x
// forbidasm: @u8_gt_true_
// forbidasm: @u8_gt_false_
// forbidasm: main$i

include "machine_6502.c26"

uint8_t value[2];
uint8_t hit[2];

void main(void) {
   for (uint8_t i := 0; i < 2; i++) {
      if (value[i] > 148) {
         hit[i] := 1;
      }
   }
}
