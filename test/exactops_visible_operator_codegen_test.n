// n65c -I .
// expectasm: jsr ?@op_add@s4x_p0_a0@s4x_p0_a0
// expectasm: jsr ?@op_eq@s4x_p0_a0@s4x_p0_a0
// expectasm: jsr ?@op_tst@s4x_p0_a0
// expectasm: jsr ?@op_inc@s4x_r1_p0_a0

include "machine_6502.n"

type s4x { $size:4 $integer:signed $endian:little $exactops };

s4x operator+(s4x, s4x);
bool operator==(s4x, s4x);
bool operator{}(s4x);
s4x operator++(ref s4x);

s4x add(s4x a, s4x b) {
   return a + b;
}

bool eq(s4x a, s4x b) {
   return a == b;
}

bool truthy(s4x a) {
   if (a) {
      return true;
   }
   return false;
}

s4x bump(ref s4x a) {
   return a++;
}
