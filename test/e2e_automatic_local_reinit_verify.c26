// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.c26"


uint8_t value(void) {
   uint8_t x := 5;
   x += 1;
   return x;
}

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   if (value() != 6) {
      fail(1);
   }
   if (value() != 6) {
      fail(2);
   }
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
