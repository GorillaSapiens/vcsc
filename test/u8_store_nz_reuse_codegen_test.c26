// vcsc-cc1 -I .
// expectasmordered: lda  state
// expectasmordered: lsr
// expectasmordered: bcc @u8_shift_xor_skip_
// expectasmordered: eor #$b4
// expectasmordered: sta  state
// expectasmordered: bne @stored_u8_if_false_
// expectasmordered: lda #$01
// expectasmordered: sta hit
// forbidasm: lda state
// forbidasm: __vcsc_scratch_
include "machine_6502.c26"

uint8_t state;
uint8_t hit;

void main(void) {
   if (state & 1) {
      state := (state >> 1) ^ 0xb4;
   }
   else {
      state >>= 1;
   }

   if (!state) {
      hit := 1;
   }
}
