// expectasmordered: lda palette,y
// expectasmordered: sta out,x
// expectasmordered: txa
// expectasmordered: lsr
// expectasmordered: tay
// expectasmordered: lda (p),y
// expectasmordered: lsr
// expectasmordered: lsr
// expectasmordered: lsr
// expectasmordered: lsr
// expectasmordered: tay
// expectasmordered: lda palette,y
