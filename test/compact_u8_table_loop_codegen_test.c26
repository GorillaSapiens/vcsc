// expectasmordered: jmp @if_end_
// expectasmordered: lda #<{rows1 + 0}
// expectasmordered: sta p + 0
// expectasmordered: lda #>{rows1 + 0}
// expectasmordered: sta p + 1
// expectasmordered: lda sprite
// expectasmordered: and #$0f
