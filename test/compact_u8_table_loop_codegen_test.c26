// expectasmordered: inx
// expectasmordered: jmp @for_start_
// forbidasm: __vcsc_scratch_
// forbidasm: main$i
// forbidasm: sta ptr0

include "machine_6502.c26"

const uint8_t rows0[256] := {0};
const uint8_t rows1[256] := {0};
const uint8_t transition[16] := {0};
const uint8_t palette[16] := {0};
uint8_t *p;
uint8_t sprite;
uint8_t out[8];

void main(void) {
   if (sprite < 16) { p := rows0; }
   else { p := rows1; }
   p += (sprite & 0x0f) << 4;
   sprite := transition[sprite];
   for (uint8_t i := 0; i < 8; i += 2) {
      out[i] := palette[p[i >> 1] & 0x0f];
      out[i + 1] := palette[p[i >> 1] >> 4];
   }
}
