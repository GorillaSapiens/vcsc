// vcsc-cc1 -I ../libraries/vcs
// linkcfg: ../libraries/vcs/vcs_4k.cfg
// expectmap: RAM        start=$0080 size=$0070 type=rw
// expectmap: __stack_top   $00EF
// expectmap: region=RAM depth=4 bytes=$0010 physical=$00F0-$00FF
// expectexit: 0

include "vcs.vcsc"

void level3(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void level2(void) {
   level3();
}

void level1(void) {
   level2();
}

void main(void) {
   level1();
}
