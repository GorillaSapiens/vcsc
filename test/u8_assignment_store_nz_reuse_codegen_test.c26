// vcsc-cc1 -I .
// expectasmordered: lda source,x
// expectasmordered: sta  main$value
// expectasmordered: beq @stored_u8_if_false_
// expectasmordered: lda #$01
// expectasmordered: sta hit
// forbidasm: lda  main$value
// forbidasm: __vcsc_scratch_
include "machine_6502.c26"

uint8_t source[2];
uint8_t index;
uint8_t hit;

void main(void) {
   uint8_t value;

   value := source[index];
   if (value) {
      hit := 1;
   }
}
