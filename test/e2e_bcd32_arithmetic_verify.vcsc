// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.vcsc"

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

bcd32_t add32(bcd32_t x, bcd32_t y) { return x + y; }

void check32(bcd32_t x) {
   if (x != 12345678) { fail(20); }
}

void main(void) {
   bcd8_t a8;
   bcd24_t a24;
   bcd32_t a32;
   bcd32_t old32;
   bcd32_t mixed32;
   uint8_t *p;
   uint8_t binary;

   a32 := 99999999;
   a32 += 1;
   if (a32 != 0) { fail(1); }

   a32 := 0;
   a32 -= 1;
   if (a32 != 99999999) { fail(2); }

   a32 := 999999;
   a32 += 1;
   p := (uint8_t *)&a32;
   if (a32 != 1000000 || p[0] != 0 || p[1] != 0 || p[2] != 0 || p[3] != 0x01) { fail(3); }

   if (add32(49999999, 50000002) != 1) { fail(4); }

   a24 := 999999;
   a32 := 1;
   mixed32 := a24 + a32;
   if (mixed32 != 1000000) { fail(5); }

   a8 := 99;
   a32 := a8;
   p := (uint8_t *)&a32;
   if (a32 != 99 || p[0] != 0x99 || p[1] != 0 || p[2] != 0 || p[3] != 0) { fail(6); }

   a32 := 12345678;
   a24 := a32;
   if (a24 != 345678) { fail(7); }

   a32 := 99999999;
   old32 := a32++;
   if (old32 != 99999999 || a32 != 0) { fail(8); }
   old32 := --a32;
   if (old32 != 99999999 || a32 != 99999999) { fail(9); }

   if (!(999999`bcd24_t < 1000000`bcd32_t)) { fail(10); }
   if (0`bcd32_t) { fail(11); }
   if (!12345678`bcd32_t) { fail(12); }

   a32 := 12345678;
   check32(a32);
   check32(12345678);

   a32 := 99999999;
   a32 += 1;
   binary := 9;
   binary += 1;
   if (a32 != 0 || binary != 10) { fail(13); }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
