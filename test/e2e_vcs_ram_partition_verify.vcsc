// vcsc-cc1 -I ../libraries/vcs
// linkcfg: ../libraries/vcs/vcs_4k.cfg
// expectmap: RAM        start=$0080 size=$0078 type=rw
// expectmap: __stack_top   $00F7
// expectmap: region=RAM depth=2 bytes=$0008 physical=$00F8-$00FF
// expectmap: __call_stack_depth
// expectmap: __call_stack_size
// expectexit: 0

include "vcs.vcsc"

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   pass();
}
