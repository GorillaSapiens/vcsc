type *        { $size:2 $integer:unsigned $endian:little };
type uint24_t { $size:3 $integer:unsigned $endian:little };

uint24_t sum := (2 + 3) * 4;
bool less := 2 + 1 < 5;
uint24_t pair[2] := { 1 + 2, 8 >> 1 };
uint24_t base;
uint24_t *ptr := &base + 1;

