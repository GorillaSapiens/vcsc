# runner: perl @FILE@ @REPO@
# phase: e2e

use strict;
use warnings;
use File::Spec;

my ($repo) = @ARGV;
die "missing repository path\n" if !defined $repo;

my $path = File::Spec->catfile($repo, 'libraries', 'vcs', 'vcs.c26');
open(my $fh, '<', $path) or die "could not open $path: $!\n";
local $/;
my $c26 = <$fh>;
close($fh);

$c26 !~ /\bmem\s+cpustack\b/i
   or die "vcs.c26 must not model mirrored RIOT stack RAM as a separate CPUSTACK region\n";
$c26 =~ /mem\s+ram\s*\{[^}]*\$start:0x0080[^}]*\$size:0x0080[^}]*\$rw[^}]*\$stack[^}]*\}/s
   or die "vcs.c26 must declare all RIOT RAM and mark it as the hardware-stack backing region\n";

exit 0;
