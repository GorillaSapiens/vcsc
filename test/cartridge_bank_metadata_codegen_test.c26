// vcsc-cc1 -I .
// expectasm: __cartmeta$V1$P01$FA5$T0000$Z0000$B0000$Y0000$V0000$W0000$Q
// expectasm: __bankmeta$V1$fresh$I1000$F0000$O0000$L3000$C3000$M1000$P0$S0000$U0$Q
// expectasm: __bankmeta$V1$rom$I1000$F0001$O0000$LF000$CF000$M1000$P0$S0000$U0$Q
include "machine_6502.c26"

cartridge { $fill:0xa5 };

bank fresh {
   $image_size:0x1000
   $file_index:0
   $image_offset:0
   $link_start:0x3000
   $cpu_start:0x3000
   $map_size:0x1000
};

// `rom` is already a mem name from machine_6502.c26.  The bank namespace is
// separate, so the same spelling remains legal and unambiguous.
bank rom {
   $image_size:0x1000
   $file_index:1
   $image_offset:0
   $link_start:0xf000
   $cpu_start:0xf000
   $map_size:0x1000
};

void main(void) {
}
