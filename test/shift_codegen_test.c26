// vcsc-cc1
// expectasm: .import _sar8
// expectasm: jsr _sar8
// expectasm: .import _shr16
// expectasm: jsr _shr16
// expectasm: sta arg1
// forbidasm: sta arg0
// forbidasm: _asrNle
// forbidasm: _lsrNle

type void      { $size:0 };
type uint8_t      { $size:1 $integer:unsigned };
type s1        { $size:1 $integer:signed $endian:little };
type u2        { $size:2 $integer:unsigned $endian:little };
type s2        { $size:2 $integer:signed $endian:little };
type *         { $size:2 $integer:unsigned $endian:little };

s1 shr_expr(s1 a, u2 b) {
   return a >> b;
}

u2 lshr_assign(u2 a, u2 b) {
   a >>= b;
   return a;
}
