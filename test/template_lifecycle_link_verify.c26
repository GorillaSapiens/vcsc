// vcsc-cc1 -I .
// expectexit: 0

include "machine_6502.c26"
instantiate "fixtures/templates/lifecycle_component.c26" as first
instantiate "fixtures/templates/lifecycle_component.c26" as second

void fail(void) {
   asm lda #$ff;
   asm ldx #1;
   asm ldy #0;
   asm jsr $ffff;
}

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   first_init();
   second_init();
   first_vblank();
   second_vblank();
   first_draw();
   second_draw();
   first_overscan();
   second_overscan();

   if (first_VISIBLE_SCANLINES != 12 ||
       second_VISIBLE_SCANLINES != 12 ||
       first_VBLANK_MAX_CYCLES != 300 ||
       second_VBLANK_MAX_CYCLES != 300 ||
       first_OVERSCAN_MAX_CYCLES != 200 ||
       second_OVERSCAN_MAX_CYCLES != 200 ||
       first_state != 15 || second_state != 15) {
      fail();
   }
   pass();
}
