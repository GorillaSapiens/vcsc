// n65c -I .
// expectfail
// expecterr: call graph cycle reaches function 'a' with symbol-backed parameters
include "machine_6502.n"

type uint16_t { $size:2 $integer:unsigned $endian:little };

uint16_t b(uint16_t x);

uint16_t a(uint16_t x) {
   return b(x);
}

uint16_t b(uint16_t x) {
   return a(x);
}

int main(void) {
   return 0;
}
