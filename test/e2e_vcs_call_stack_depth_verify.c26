// vcsc-cc1 -I ../libraries/vcs
// linkcfg: ../libraries/vcs/4K/mapper.cfg
// expectmap: ram        start=$0080 size=$007A type=rw
// expectmap: __stack_top   $00F9
// expectmap: region=ram depth=3 bytes=$0006 physical=$00FA-$00FF
// expectexit: 0

include "vcs.c26"

void level3(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void level2(void) {
   level3();
}

void level1(void) {
   level2();
}

void main(void) {
   level1();
}
