// vcsc-cc1 -I ../libraries/vcs
// linkcfg: ../libraries/vcs/vcs_4k.cfg
// expectmap: ram        start=$0080 size=$0078 type=rw
// expectmap: __stack_top   $00F7
// expectmap: region=ram depth=4 bytes=$0008 physical=$00F8-$00FF
// expectexit: 0

include "vcs.c26"

void level3(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void level2(void) {
   level3();
}

void level1(void) {
   level2();
}

void main(void) {
   level1();
}
