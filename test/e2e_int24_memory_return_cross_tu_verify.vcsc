// vcsc-cc1 -I .
// object: e2e_int24_memory_return_cross_tu_verify__def.vcsc
// expectexit: 0
include "machine_6502.vcsc"

uint24_t make_value(void);

void fail1(void) {
   asm lda #$ff;
   asm ldx #1;
   asm ldy #0;
   asm jsr $ffff;
}

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   uint24_t value := make_value();
   if (value != 0x654321) {
      fail1();
   }
   pass();
}
