// vcsc-cc1 -I ../libraries/vcs
// expectasm: lda #$2b
// expectasm: lda #$23
// expectasm: sta  $0296
// expectasm: lda  $0285
// expectasm: lda  $0284
// expectasm: lda #$80
// expectasm: sta  $02
// expectasm: sta  $01
// forbidasm: jsr vcs_ntsc_begin_vblank
// forbidasm: jsr vcs_ntsc_end_vblank
// forbidasm: jsr vcs_ntsc_begin_overscan
// forbidasm: jsr vcs_ntsc_end_overscan
// forbidasm: jsr vcs_ntsc_finish_deadline
include "vcs.c26"
include "frame_ntsc.c26"

uint8_t phase_result;

void main(void) {
   vcs_ntsc_begin_vblank();
   phase_result := vcs_ntsc_end_vblank();
   vcs_ntsc_begin_overscan();
   phase_result |= vcs_ntsc_end_overscan();
}
