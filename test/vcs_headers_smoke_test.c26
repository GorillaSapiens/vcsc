// vcsc-cc1 -I ../libraries/vcs
// expectasm: lda  $3C
// expectasm: sta  $01
// expectasm: lda #$2a
// expectasm: sta  $0296
// expectasm: sed
// expectasm: cld
// forbidasm: lda #<{$01 + 0}
// forbidasm: lda #<{$0296 + 0}
include "vcs.c26"
include "frame_ntsc.c26"

uint24_t frame_count := 0x123456;
int24_t frame_delta := -1;
uint32_t long_count := 0x12345678;
int32_t long_delta := -1;

int16_t main(void) {
   int8_t x := INPT4;
   bcd8_t score := 42;
   bcd32_t total := 12345678;
   score += 1;
   total += 1;
   frame_count += 1;
   frame_delta--;
   long_count += 1;
   long_delta--;
   vcs_ntsc_wait_scanlines(0);
   vcs_ntsc_begin_vblank();
   vcs_ntsc_end_vblank();
   vcs_ntsc_begin_overscan();
   vcs_ntsc_end_overscan();
   VBLANK := x;
   TIM64T := 42;
   return INTIM + SWCHB;
}
