// n65c -I .
// expectasmordered: jsr helper@int8_t_p1_a0@u1x_p0_a0
// expectasmordered: jsr helper@int8_t_p1_a0@u2x_p0_a0
// expectasmordered: jsr helper@int8_t_p1_a0@u1x_p0_a0
// expectasmordered: jsr helper@int8_t_p1_a0@u2x_p0_a0

include "machine_6502.n"

type u1x { $size:1 $integer:unsigned $endian:little };
type u2x { $size:2 $integer:unsigned $endian:little };

int16_t helper(int8_t *dst, u1x value) {
   dst[0] := 'a' + value;
   return 1;
}

int16_t helper(int8_t *dst, u2x value) {
   dst[0] := 'A' + (value & 15`u2x);
   return 1;
}

void main(void) {
   int8_t buf[8];
   int8_t *p := buf;
   u1x b := 1`u1x;
   u2x w := 2`u2x;

   helper(buf, b);
   helper(buf + 1, w);
   helper(p + 2, b);
   helper("xy" + 1, w);
}
