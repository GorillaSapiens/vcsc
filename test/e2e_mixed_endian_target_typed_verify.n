// n65c -I .
// expectexit: 0

include "machine_6502.n"

type u2be { $size:2 $integer:unsigned $endian:big };
type u2le { $size:2 $integer:unsigned $endian:little };

u2be id_be(u2be v) {
   return v;
}

u2be return_target(u2be a, u2le b) {
   return a * b;
}

u2be init_target(u2be a, u2le b) {
   u2be r := a * b;
   return r;
}

u2be assign_target(u2be a, u2le b) {
   u2be r;
   r := a * b;
   return r;
}

u2be call_target(u2be a, u2le b) {
   return id_be(a * b);
}

u2be nested_target(u2be a, u2le b, u2le c) {
   return (a * b) + c;
}

u2be shift_target(u2be a, u2le b) {
   return a << b;
}

bool compare_target(u2be a, u2le b) {
   return a < b;
}

void main(void) {
   if (return_target(0x0012`u2be, 0x0003`u2le) != 0x0036`u2be) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }
   if (init_target(0x0012`u2be, 0x0003`u2le) != 0x0036`u2be) { asm lda #$ff; asm ldx #2; asm ldy #0; asm jsr $ffff; }
   if (assign_target(0x0012`u2be, 0x0003`u2le) != 0x0036`u2be) { asm lda #$ff; asm ldx #3; asm ldy #0; asm jsr $ffff; }
   if (call_target(0x0012`u2be, 0x0003`u2le) != 0x0036`u2be) { asm lda #$ff; asm ldx #4; asm ldy #0; asm jsr $ffff; }
   if (nested_target(0x0012`u2be, 0x0003`u2le, 0x0004`u2le) != 0x003a`u2be) { asm lda #$ff; asm ldx #5; asm ldy #0; asm jsr $ffff; }
   if (shift_target(0x0002`u2be, 0x0008`u2le) != 0x0200`u2be) { asm lda #$ff; asm ldx #6; asm ldy #0; asm jsr $ffff; }
   if (!compare_target(0x0002`u2be, 0x0003`u2le)) { asm lda #$ff; asm ldx #7; asm ldy #0; asm jsr $ffff; }
   if (compare_target(0x0003`u2be, 0x0002`u2le)) { asm lda #$ff; asm ldx #8; asm ldy #0; asm jsr $ffff; }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
