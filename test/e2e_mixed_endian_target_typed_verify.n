// n65c -I .
// expectexit: 0

include "machine_6502.n"

type u2be { $size:2 $integer:unsigned $endian:big };
type u2le { $size:2 $integer:unsigned $endian:little };

u2be result;

void id_be(u2be v) {
   result := v;
}

void return_target(u2be a, u2le b) {
   result := a * b;
}

void init_target(u2be a, u2le b) {
   u2be r := a * b;
   result := r;
}

void assign_target(u2be a, u2le b) {
   u2be r;
   r := a * b;
   result := r;
}

void call_target(u2be a, u2le b) {
   id_be(a * b);
}

void nested_target(u2be a, u2le b, u2le c) {
   result := (a * b) + c;
}

void shift_target(u2be a, u2le b) {
   result := a << b;
}

bool compare_target(u2be a, u2le b) {
   return a < b;
}

void main(void) {
   return_target(0x0012`u2be, 0x0003`u2le);
   if (result != 0x0036`u2be) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }
   init_target(0x0012`u2be, 0x0003`u2le);
   if (result != 0x0036`u2be) { asm lda #$ff; asm ldx #2; asm ldy #0; asm jsr $ffff; }
   assign_target(0x0012`u2be, 0x0003`u2le);
   if (result != 0x0036`u2be) { asm lda #$ff; asm ldx #3; asm ldy #0; asm jsr $ffff; }
   call_target(0x0012`u2be, 0x0003`u2le);
   if (result != 0x0036`u2be) { asm lda #$ff; asm ldx #4; asm ldy #0; asm jsr $ffff; }
   nested_target(0x0012`u2be, 0x0003`u2le, 0x0004`u2le);
   if (result != 0x003a`u2be) { asm lda #$ff; asm ldx #5; asm ldy #0; asm jsr $ffff; }
   shift_target(0x0002`u2be, 0x0008`u2le);
   if (result != 0x0200`u2be) { asm lda #$ff; asm ldx #6; asm ldy #0; asm jsr $ffff; }
   if (!compare_target(0x0002`u2be, 0x0003`u2le)) { asm lda #$ff; asm ldx #7; asm ldy #0; asm jsr $ffff; }
   if (compare_target(0x0003`u2be, 0x0002`u2le)) { asm lda #$ff; asm ldx #8; asm ldy #0; asm jsr $ffff; }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
