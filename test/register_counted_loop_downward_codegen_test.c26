// vcsc-cc1 -I .
// expectasmordered: ldx #$c0
// expectasmordered: sta  $02
// expectasmordered: dex
// expectasmordered: bne @for_start_
// expectasmordered: ldx #$25
// expectasmordered: sta  $02
// expectasmordered: dex
// expectasmordered: bne @for_start_
// expectasmordered: ldx #$1e
// expectasmordered: sta  $02
// expectasmordered: dex
// expectasmordered: bne @for_start_
// forbidasm: main$i
// forbidasm: main$j
// forbidasm: main$k
// forbidasm: __vcsc_scratch_

include "machine_6502.c26"

uint8_t WSYNC@[none/0x02];
uint8_t sink_global;
zeropage uint8_t sink_zp;

void main(void) {
   uint8_t sink_local;
   // A nonzero constant countdown can live entirely in X.  The hardware
   // DRA store from $A is a direct STA and therefore cannot clobber that counter.
   for (uint8_t i := 192; i; i--) {
      WSYNC := $A;
   }
   for (uint8_t j := 37; j > 0; --j) {
      WSYNC := $A;
   }
   for (uint8_t k := 30; k != 0; k--) {
      WSYNC := $A;
      sink_global := $A;
      sink_zp := $A;
      sink_local := $A;
   }
}
