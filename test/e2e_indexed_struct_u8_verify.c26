// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.c26"

struct Cell {
   uint8_t a;
   uint8_t b;
   uint8_t c;
   uint8_t d;
};

Cell cells[65];
uint8_t index;
uint8_t observed;

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   index := 64;
   cells[index].a := 0x11;
   cells[index].b := 0x22;
   cells[index].c := 0x33;
   cells[index].d := 0x44;

   observed := cells[index].a;
   if (observed != 0x11) { fail(1); }
   observed := cells[index].b;
   if (observed != 0x22) { fail(2); }
   observed := cells[index].c;
   if (observed != 0x33) { fail(3); }
   observed := cells[index].d;
   if (observed != 0x44) { fail(4); }

   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
