// n65c
// expectfail
// expecterr: integer type 'wide24' has unsupported size 3; only 1-byte and 2-byte integers are supported

type void { $size:0 };
type uint8_t { $size:1 $integer:unsigned };
type * { $size:2 $integer:unsigned $endian:little };
type wide24 { $size:3 $integer:unsigned $endian:little };
