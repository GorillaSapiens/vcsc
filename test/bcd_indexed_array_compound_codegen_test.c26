// expectasmordered: sed
// expectasmordered: sbc weights,y
// expectasmordered: cld
// forbidasm: _mul8
// forbidasm: __vcsc_scratch_
include "machine_6502.c26"

page const bcd24_t weights[6] := { 1, 10, 100, 1000, 10000, 100000 };
bcd24_t score;
uint8_t digit;

void main(void) {
   score += weights[digit];
   score -= weights[digit];
}
