// vcsc-cc1 -I ../libraries/vcs
include "vcs.c26"

// Timing-sensitive immutable ROM playfield.
page const uint8_t vcs_standard_playfield[48] := {
   0xff, 0xff, 0xff, 0xff,
   0x81, 0x00, 0x00, 0x81,
   0xbd, 0xff, 0xff, 0xbd,
   0xa5, 0x81, 0x81, 0xa5,
   0xa5, 0xbd, 0xbd, 0xa5,
   0xa5, 0xa5, 0xa5, 0xa5,
   0xbd, 0xa5, 0xa5, 0xbd,
   0x81, 0xa5, 0xa5, 0x81,
   0xff, 0xbd, 0xbd, 0xff,
   0x00, 0x81, 0x81, 0x00,
   0xff, 0xff, 0xff, 0xff,
   0x00, 0x00, 0x00, 0x00
};

include "kernels/standard_4k_ntsc/standard_4k_ntsc.c26"

const uint8_t player_shape[8] := {
   0b...XX...,
   0b..XXXX..,
   0b.XXXXXX.,
   0bXX.XX.XX,
   0bXXXXXXXX,
   0b..X..X..,
   0b.X....X.,
   0bX......X
};

int16_t main(void) {
   VCS_STANDARD_PLAYER0_X := 40;
   VCS_STANDARD_PLAYER1_X := 96;
   vcs_standard_player0_graphics := player_shape;
   vcs_standard_player1_graphics := player_shape;
   vcs_standard_player0_height := 7;
   vcs_standard_player1_height := 7;
   vcs_standard_score := 123456;
   COLUBK := vcs_standard_playfield[0];
   vcs_standard_kernel_drawscreen();
   return 0;
}
