// vcsc-cc1 -I .
// expectexit: 0
include "machine_6502.vcsc"

type u8  { $size:1 $integer:unsigned $endian:little };
type u16 { $size:2 $integer:unsigned $endian:little };

struct Bits {
   u8 lo:4;
   u8 hi:4;
};

u8 gv;
u8 arr[2];
Bits bits;
ref u8 absbyte@[0x0600/0x0600];

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   u16 w;
   u8 old;
   u8 *p;

   absbyte := 0xfe;
   w := absbyte;
   if (w != 0x00fe) { asm lda #$ff; asm ldx #1; asm ldy #0; asm jsr $ffff; }

   w := 0x12fe;
   old := (u8) w;
   if (old != 0xfe) { asm lda #$ff; asm ldx #2; asm ldy #0; asm jsr $ffff; }

   gv := 7;
   gv++;
   if (gv != 8) { asm lda #$ff; asm ldx #3; asm ldy #0; asm jsr $ffff; }
   ++gv;
   if (gv != 9) { asm lda #$ff; asm ldx #4; asm ldy #0; asm jsr $ffff; }

   arr[0] := 20;
   p := &arr[0];
   (*p)--;
   if (arr[0] != 19) { asm lda #$ff; asm ldx #5; asm ldy #0; asm jsr $ffff; }
   --(*p);
   if (arr[0] != 18) { asm lda #$ff; asm ldx #6; asm ldy #0; asm jsr $ffff; }

   bits.lo := 3;
   bits.hi := 10;
   bits.lo++;
   if (bits.lo != 4 || bits.hi != 10) { asm lda #$ff; asm ldx #7; asm ldy #0; asm jsr $ffff; }
   --bits.lo;
   if (bits.lo != 3 || bits.hi != 10) { asm lda #$ff; asm ldx #8; asm ldy #0; asm jsr $ffff; }

   pass();
}
