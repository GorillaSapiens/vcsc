include "machine_6502.vcsc"

uint32_t uhex := 0x12345678;
uint32_t umax := 4294967295;
int32_t smax := 2147483647;
int32_t smin := -2147483648;
uint32_t uwrap := (uint32_t)-1;
int32_t swrap := (int32_t)2147483648;

int32_t identity32(int32_t value) {
   return value;
}
