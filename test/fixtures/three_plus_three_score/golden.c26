include "vcs.c26"
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"
instantiate "three_plus_three_score_component.c26" as score

void main(void) {
   PF0 := 0; PF1 := 0; PF2 := 0;
   ENAM0 := 0; ENAM1 := 0; ENABL := 0;
   COLUBK := 0;
   VBLANK := 2;
   score_left_score := 123;
   score_right_score := 456;
   score_left_color := 0x2e;
   score_right_color := 0x9e;
   score_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank(); score_vblank(); vcs_ntsc_end_vblank();
      vcs_ntsc_wait_component_scanlines(91);
      score_draw();
      vcs_ntsc_wait_visible_tail_scanlines(90);
      vcs_ntsc_begin_overscan(); score_overscan(); vcs_ntsc_end_overscan();
   }
}
