include "vcs.c26"
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"

instantiate "three_plus_three_score_component.c26" as score


void main(void) {
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := 0x84;
   VBLANK := 2;

   score_left_score := 94;
   score_right_score := 994;
   score_left_color := 0x3e;
   score_right_color := 0xae;
   score_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      score_vblank();

      // Enter from deliberately hostile player/motion state. The component
      // must fully own the two score players without disturbing PF/M/B state.
      GRP0 := 0xff;
      GRP1 := 0xff;
      VDELP0 := 1;
      VDELP1 := 1;
      REFP0 := 8;
      REFP1 := 8;
      NUSIZ0 := 7;
      NUSIZ1 := 7;
      COLUP0 := 0x02;
      COLUP1 := 0x02;
      HMP0 := 0x70;
      HMP1 := 0x80;
      HMM0 := 0x90;
      HMM1 := 0xa0;
      HMBL := 0xb0;

      vcs_ntsc_end_vblank();
      vcs_ntsc_wait_component_scanlines(91);
      score_draw();
      vcs_ntsc_wait_visible_tail_scanlines(90);

      vcs_ntsc_begin_overscan();
      score_overscan();

      // Exercise both fields simultaneously through 098 -> 099 -> 100 and
      // 998 -> 999 -> 000. The component intentionally displays the low three
      // digits of bcd16_t, so 1000 appears as 000.
      score_left_score++;
      score_right_score++;
      vcs_ntsc_end_overscan();
   }
}
