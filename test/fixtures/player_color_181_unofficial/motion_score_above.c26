// P0/P1/BL player-color gameplay with an independent score above gameplay.
include "vcs.c26"
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"

page const uint8_t game_playfield[44] := {
   0xff,0xff,0xff,0xff,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0xff,0xff,0xff,0xff
};
page const uint8_t game_player0_colors[8] := {
   0xae,0x9e,0x8e,0x7e,0x6e,0x5e,0x4e,0x3e
};
page const uint8_t game_player1_colors[8] := {
   0x5e,0x6e,0x7e,0x8e,0x9e,0xae,0xbe,0xce
};
template "kernels/player_color_181_unofficial/player_color_181_unofficial.c26" as game
template "six_glyph_component.c26" as score

page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(0x7e,0xc3,0xc3,0xc7,0xcb,0xd3,0xc3,0x7e)
};
page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(0xfe,0xc3,0xc3,0xc3,0xfe,0xc3,0xc3,0xfe)
};

void configure_game_frame(void) {
   COLUPF := 0x2e;
   CTRLPF := 0x21;
   NUSIZ0 := 0x20;
   NUSIZ1 := 0x20;
}

void initialize_scene(void) {
   VBLANK := 2;
   COLUBK := 0x84;
   game_PLAYER0_X := 0;
   game_PLAYER1_X := 159;
   game_BALL_X := 80;
   game_player0_y := 18;
   game_player1_y := 78;
   game_ball_y := 48;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;
   score_score := 123456;
   game_init();
   score_init();
}

alias DIRECTION_PLAYER0 0x01
alias DIRECTION_PLAYER1 0x02
alias DIRECTION_BALL 0x04
uint8_t motion_directions := 0x05;

inline void update_motion(void) {
   asm ldx #4;
   asm @motion_loop:;
   asm lda motion_directions;
   asm and.ax @motion_direction_bits,x;
   asm beq @motion_left;
   asm lda game_object_x,x;
   asm cmp.ax @motion_highs,x;
   asm bcc @motion_add;
   asm lda #159;
   asm jmp @motion_reverse;
   asm @motion_add:;
   asm clc;
   asm adc.ax @motion_speeds,x;
   asm jmp @motion_store;
   asm @motion_left:;
   asm lda game_object_x,x;
   asm cmp.ax @motion_speeds,x;
   asm bcc @motion_zero;
   asm beq @motion_zero;
   asm sec;
   asm sbc.ax @motion_speeds,x;
   asm jmp @motion_store;
   asm @motion_zero:;
   asm lda #0;
   asm @motion_reverse:;
   asm tay;
   asm lda motion_directions;
   asm eor.ax @motion_direction_bits,x;
   asm sta motion_directions;
   asm tya;
   asm @motion_store:;
   asm sta game_object_x,x;
   asm dex;
   asm bpl @motion_loop;
   asm jmp @motion_done;
   asm @motion_direction_bits:;
   asm .byte $01,$02,$00,$00,$04;
   asm @motion_speeds:;
   asm .byte $01,$05,$00,$00,$07;
   asm @motion_highs:;
   asm .byte $9e,$9a,$ff,$ff,$98;
   asm @motion_done:;
}

void main(void) {
   initialize_scene();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      score_vblank();
      vcs_ntsc_end_vblank();
      score_draw();
      configure_game_frame();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_motion();
      score_overscan();
      vcs_ntsc_end_overscan();
   }
}
