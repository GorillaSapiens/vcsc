#ifdef VCSC_PROFILE_F6
include "F6/mapper.c26"
#else
#ifdef VCSC_PROFILE_F4
include "F4/mapper.c26"
#else
include "F8/mapper.c26"
#endif
#endif

// Unmarked code is automatically placed; named modifiers are hard pins.

uint8_t result;

bank1 const uint8_t bank1_value := 0x42;

bank0 void home_leaf(void) {
   result := result + 1;
}

bank0 void home_tail(void) {
   result := result + 8;
}

bank1 void remote(void) {
   result := result + 2;
   home_leaf();
}

// Ordinary C26 cross-bank control flow is a call.  General mapper-changing
// JMPs are deliberately unsupported; reset/startup owns the only one-way
// mapper transition.
bank1 void remote_return(void) {
   home_tail();
}

// The object reference is a hard same-bank constraint, so this unpinned
// function is automatically placed with bank1_value in BANK1.
uint8_t automatic_reader(void) {
   return bank1_value;
}

void main(void) {
   result := 0;
   remote();
   result := result + automatic_reader();
   remote_return();
}
