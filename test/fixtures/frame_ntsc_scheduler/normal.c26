include "vcs.c26"
include "frame_ntsc.c26"

// Blanking callbacks may use WSYNC internally. The scheduler's already-running
// TIM64T deadline includes every stalled cycle and still owns the final phase
// transition.
inline void sample_component_vblank(void) {
   vcs_ntsc_wait_scanlines(5);
}

inline void sample_component_overscan(void) {
   vcs_ntsc_wait_scanlines(4);
}

void main(void) {
   while (1) {
      vcs_ntsc_vsync();

      vcs_ntsc_begin_vblank();
      sample_component_vblank();
      vcs_ntsc_end_vblank();

      vcs_ntsc_wait_scanlines(VCS_NTSC_VISIBLE_SCANLINES`uint8_t);

      vcs_ntsc_begin_overscan();
      sample_component_overscan();
      vcs_ntsc_end_overscan();
   }
}
