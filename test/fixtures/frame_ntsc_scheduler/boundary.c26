alias VCS_NTSC_DIAGNOSTICS 1
include "vcs.c26"
include "frame_ntsc.c26"

void main(void) {
   while (1) {
      vcs_ntsc_vsync();

      vcs_ntsc_begin_vblank();
      vcs_ntsc_wait_scanlines(35);
      vcs_ntsc_end_vblank();

      vcs_ntsc_wait_scanlines(VCS_NTSC_VISIBLE_SCANLINES`uint8_t);
      // The generic wait promises only WSYNC count, not return phase. Pin this
      // synthetic all-blank visible fixture to the scheduler's historical
      // overscan-entry phase explicitly.
      asm nop;

      vcs_ntsc_begin_overscan();
      vcs_ntsc_wait_scanlines(28);
      vcs_ntsc_end_overscan();
   }
}
