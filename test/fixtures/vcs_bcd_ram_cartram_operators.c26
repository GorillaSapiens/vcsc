bank7 void test_cart32(void) {
   cart32 := 99999995;
   cart32 += 7;
   if (cart32 != 2) { failure := 43; return; }
   cart32 := 3;
   cart32 -= 5;
   if (cart32 != 99999998) { failure := 44; return; }
   cart32 := 99999999;
   old32 := cart32++;
   if (old32 != 99999999 || cart32 != 0) { failure := 45; return; }
   cart32 := 99999998;
   old32 := ++cart32;
   if (old32 != 99999999 || cart32 != 99999999) { failure := 46; return; }
