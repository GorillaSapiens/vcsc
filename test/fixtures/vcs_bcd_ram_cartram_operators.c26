bank0 void main(void) {
   failure := 0;
   test_ram8();
   if (failure) { asm jmp simulator_done; }
   test_ram16();
   if (failure) { asm jmp simulator_done; }
   test_ram24();
   if (failure) { asm jmp simulator_done; }
   test_ram32();
   if (failure) { asm jmp simulator_done; }
   test_cart8();
   if (failure) { asm jmp simulator_done; }
   test_cart16();
   if (failure) { asm jmp simulator_done; }
   test_cart24();
   if (failure) { asm jmp simulator_done; }
   test_cart32();
   asm jmp simulator_done;
}
