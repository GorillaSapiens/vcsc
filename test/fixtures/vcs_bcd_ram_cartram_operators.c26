bank4 void test_cart8(void) {
   cart8 := 95;
   cart8 += 7;
   if (cart8 != 2) { failure := 25; return; }
   cart8 := 3;
   cart8 -= 5;
   if (cart8 != 98) { failure := 26; return; }
   cart8 := 99;
   old8 := cart8++;
   if (old8 != 99 || cart8 != 0) { failure := 27; return; }
   cart8 := 98;
   old8 := ++cart8;
   if (old8 != 99 || cart8 != 99) { failure := 28; return; }
   cart8 := 0;
   old8 := cart8--;
   if (old8 != 0 || cart8 != 99) { failure := 29; return; }
   cart8 := 1;
   old8 := --cart8;
