include "vcs.c26"
include "color_ntsc.c26"
include "playfield.c26"

template "renderers/faithful_legacy_playercolors/faithful_legacy_playercolors.c26" as legacy

uint8_t legacy_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0bX......X_...X...._......X._X......X),
   VCS_PLAYFIELD_ROW(0bX...X..X_.....X.._..X....._X..X...X),
   VCS_PLAYFIELD_ROW(0bX......X_..XX...._....XX.._X......X),
   VCS_PLAYFIELD_ROW(0bX.X....X_......X._.X......_X....X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bX..X...X_.X......_......X._X...X..X),
   VCS_PLAYFIELD_ROW(0bX......X_....X..._...X...._X......X),
   VCS_PLAYFIELD_ROW(0bX....X.X_.......X_X......._X.X....X),
   VCS_PLAYFIELD_ROW(0bX......X_.XX....._.....XX._X......X),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0b........_........_........_........)
};

page const uint8_t p0g[8] := {
   legacy_SPRITE_GLYPH(
      0b..XXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXXX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b..XXXX..
   )
};

page const uint8_t p1g[8] := {
   legacy_SPRITE_GLYPH(
      0b.XXXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXX..
   )
};

page const uint8_t p0c[8] := {
   legacy_SPRITE_ROWS(
      VCS_NTSC_SANDY_BROWN,
      VCS_NTSC_LIGHT_CORAL,
      VCS_NTSC_ORCHID,
      VCS_NTSC_VIOLET,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_SKY_BLUE
   )
};

page const uint8_t p1c[8] := {
   legacy_SPRITE_ROWS(
      VCS_NTSC_PALE_GREEN,
      VCS_NTSC_AQUAMARINE,
      VCS_NTSC_SKY_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_VIOLET,
      VCS_NTSC_ORCHID
   )
};

void main(void) {
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;

   legacy_PLAYER0_X := 44;
   legacy_PLAYER1_X := 108;
   legacy_BALL_X := 78;
   legacy_object_x[2] := 0;
   legacy_object_x[3] := 0;

   legacy_player0_y := 78;
   legacy_player1_y := 42;
   legacy_ball_y := 45;

   legacy_player0_graphics := p0g;
   legacy_player1_graphics := p1g;
   legacy_player0_height := 7;
   legacy_player1_height := 7;
   legacy_ball_height := 3;

   // These fields overlay the color pointers. Initialize them first.
   legacy_missile0_height := 0;
   legacy_missile1_height := 0;
   legacy_missile0_y := 0;
   legacy_missile1_y := 0;

   legacy_player0_colors := p0c;
   legacy_player1_colors := p1c;

   legacy_score[0] := 0x21;
   legacy_score[1] := 0x07;
   legacy_score[2] := 0x21;
   legacy_score_color := VCS_NTSC_GRAY_92;
   legacy_playfield_position := 8;

   VBLANK := 2;
   TIM64T := 0;

   while (1) {
      COLUPF := VCS_NTSC_GOLDENROD;
      CTRLPF := 0x21;
      NUSIZ0 := 0x20;
      NUSIZ1 := 0x20;
      legacy_drawscreen();
   }
}
