include "vcs.c26"
include "playfield.c26"

alias vcs_standard_OBJECT_PLAYER0 0
alias vcs_standard_OBJECT_PLAYER1 1
alias vcs_standard_OBJECT_BALL 4
alias vcs_standard_PLAYER0_X vcs_standard_object_x[0]
alias vcs_standard_PLAYER1_X vcs_standard_object_x[1]
alias vcs_standard_BALL_X vcs_standard_object_x[4]
alias vcs_standard_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
alias vcs_standard_SPRITE_ROWS(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
uint8_t vcs_standard_object_x[5];
uint8_t vcs_standard_player0_y;
uint8_t vcs_standard_player1_y;
uint8_t vcs_standard_missile1_height;
uint8_t vcs_standard_missile1_y;
uint8_t vcs_standard_ball_y;
uint8_t *vcs_standard_player0_graphics;
uint8_t *vcs_standard_player1_graphics;
uint8_t *vcs_standard_player0_colors;
uint8_t *vcs_standard_player1_colors;
uint8_t vcs_standard_player0_color_latch;
uint8_t vcs_standard_player0_height;
uint8_t vcs_standard_player1_height;
uint8_t vcs_standard_missile0_height;
uint8_t vcs_standard_missile0_y;
uint8_t vcs_standard_ball_height;
uint8_t vcs_standard_score[3];
uint8_t vcs_standard_score_color;
uint8_t vcs_standard_pointer_workspace[12];
uint8_t vcs_standard_playfield_position;
uint8_t vcs_standard_kernel_scratch[2];
extern void vcs_standard_kernel_drawscreen(void);
void vcs_standard_overscan_hook(void) {}

page const uint8_t vcs_standard_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0bX......X_...X...._......X._X......X),
   VCS_PLAYFIELD_ROW(0bX...X..X_.....X.._..X....._X..X...X),
   VCS_PLAYFIELD_ROW(0bX......X_..XX...._....XX.._X......X),
   VCS_PLAYFIELD_ROW(0bX.X....X_......X._.X......_X....X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bX..X...X_.X......_......X._X...X..X),
   VCS_PLAYFIELD_ROW(0bX......X_....X..._...X...._X......X),
   VCS_PLAYFIELD_ROW(0bX....X.X_.......X_X......._X.X....X),
   VCS_PLAYFIELD_ROW(0bX......X_.XX....._.....XX._X......X),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0b........_........_........_........)
};
page const uint8_t p0g[8] := { vcs_standard_SPRITE_GLYPH(0x3c,0x66,0x66,0x7e,0x66,0x66,0x66,0x3c) };
page const uint8_t p1g[8] := { vcs_standard_SPRITE_GLYPH(0x7c,0x66,0x66,0x7c,0x66,0x66,0x66,0x7c) };
page const uint8_t p0c[8] := { vcs_standard_SPRITE_ROWS(0x3e,0x4e,0x5e,0x6e,0x7e,0x8e,0x9e,0xae) };
page const uint8_t p1c[8] := { vcs_standard_SPRITE_ROWS(0xce,0xbe,0xae,0x9e,0x8e,0x7e,0x6e,0x5e) };

void main(void) {
   COLUBK:=0x82; COLUPF:=0x2e; CTRLPF:=0x21;
   vcs_standard_PLAYER0_X:=44; vcs_standard_PLAYER1_X:=108; vcs_standard_BALL_X:=78;
   vcs_standard_object_x[2]:=0; vcs_standard_object_x[3]:=0;
   vcs_standard_player0_y:=78; vcs_standard_player1_y:=42; vcs_standard_ball_y:=45;
   vcs_standard_player0_graphics:=p0g; vcs_standard_player1_graphics:=p1g;
   vcs_standard_player0_colors:=p0c; vcs_standard_player1_colors:=p1c;
   vcs_standard_player0_height:=7; vcs_standard_player1_height:=7; vcs_standard_ball_height:=3;
   vcs_standard_missile0_height:=0; vcs_standard_missile1_height:=0;
   vcs_standard_missile0_y:=0; vcs_standard_missile1_y:=0;
   vcs_standard_score[0]:=0x21; vcs_standard_score[1]:=0x07; vcs_standard_score[2]:=0x21;
   vcs_standard_score_color:=0x0e; vcs_standard_playfield_position:=8;
   VBLANK:=2; TIM64T:=0;
   while (1) {
      COLUPF:=0x2e; CTRLPF:=0x21; NUSIZ0:=0x20; NUSIZ1:=0x20;
      vcs_standard_kernel_drawscreen();
   }
}
