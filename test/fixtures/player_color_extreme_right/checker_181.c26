include "vcs.c26"
include "frame_ntsc.c26"

page const uint8_t game_playfield[44] := {
   0xff,0xff,0xff,0xff,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0xff,0xff,0xff,0xff
};
page const uint8_t game_player0_colors[8] := {
   0xae,0x9e,0x8e,0x7e,0x6e,0x5e,0x4e,0x3e
};
page const uint8_t game_player1_colors[8] := {
   0x5e,0x6e,0x7e,0x8e,0x9e,0xae,0xbe,0xce
};
instantiate "renderers/player_color_181/player_color_181.c26" as game

page const uint8_t p0_graphics[8] := {
   0xaa,0x55,0xaa,0x55,0xaa,0x55,0xaa,0x55
};
page const uint8_t p1_graphics[8] := {
   0xaa,0x55,0xaa,0x55,0xaa,0x55,0xaa,0x55
};

void main(void) {
   VBLANK := 2;
   COLUBK := 0x84;
   COLUPF := 0x2e;
   CTRLPF := 0x21;
   game_PLAYER0_X := 159;
   game_PLAYER1_X := 150;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_BALL_X := 78;
   game_player0_y := 70;
   game_player1_y := 42;
   game_ball_y := 45;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;
   game_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_wait_scanlines(11);
      // The generic wait has no return-cycle contract. Preserve this fixture's
      // historical overscan-entry phase explicitly.
      asm nop;
      vcs_ntsc_begin_overscan();
      game_overscan();
      vcs_ntsc_end_overscan();
   }
}
