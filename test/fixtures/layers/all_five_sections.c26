// Experimental genuinely cooperating all-five sections, not the old scheduler.
// This file is covered under CC0-1.0. See libraries/LICENSE.txt.
alias VCS_NTSC_EXTENDED_VBLANK
include "vcs.c26"
include "frame_ntsc.c26"
alias GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
page const uint8_t layers_player0_colors[8] := {14,46,78,110,142,174,206,238};
page const uint8_t layers_player1_colors[8] := {238,206,174,142,110,78,46,14};
page const uint8_t p0[32] := {
   GLYPH(0x3c,0x66,0x66,0x7e,0x66,0x66,0x66,0),
   GLYPH(0x18,0x3c,0x7e,0x18,0x18,0x18,0x18,0),
   GLYPH(0x66,0x66,0x66,0x7e,0x66,0x66,0x66,0),
   GLYPH(0x3c,0x66,0x66,0x66,0x66,0x66,0x3c,0)
};
page const uint8_t p1[32] := {
   GLYPH(0x7c,0x66,0x66,0x7c,0x66,0x66,0x7c,0),
   GLYPH(0x3c,0x66,0x60,0x60,0x60,0x66,0x3c,0),
   GLYPH(0x78,0x6c,0x66,0x66,0x66,0x6c,0x78,0),
   GLYPH(0x7e,0x60,0x60,0x7c,0x60,0x60,0x7e,0)
};
include "layers/all_five_dense_objects.c26"
instantiate "layers/all_five_intro.c26" as intro
instantiate "layers/all_five_section.c26" as sky (number_of_scanlines:=6, playfield_row:=0x81244596, pf_color:=0x46, bk_color:=0xc2)
instantiate "layers/all_five_section.c26" as ground (number_of_scanlines:=186, playfield_row:=0x3c96a569, pf_color:=0x8e, bk_color:=0x26)
#ifdef LAYERS_MOTION
uint8_t motion;
#endif

void prepare_objects(void) {
   layers_prepare_vertical(); intro_establish(); layers_prime();
}
void main(void) {
#ifdef LAYERS_MOTION
   motion:=0;
#endif
   VBLANK:=2; PF0:=0; CTRLPF:=0x21;
   layers_object_x[0]:=20; layers_object_x[1]:=130;
   layers_object_x[2]:=50; layers_object_x[3]:=110; layers_object_x[4]:=80;
   layers_player0_nusiz:=0x20; layers_player1_nusiz:=0x20;
   layers_player0_y:=9; layers_player1_y:=9;
   layers_missile0_y:=5; layers_missile1_y:=5; layers_ball_y:=4;
   layers_player0_height:=7; layers_player1_height:=7;
   layers_missile0_height:=5; layers_missile1_height:=7; layers_ball_height:=3;
   layers_player0_graphics:=p0; layers_player1_graphics:=p1;
   while(1) {
      vcs_ntsc_vsync(); vcs_ntsc_begin_vblank(); prepare_objects();
      vcs_ntsc_end_vblank(); sky_first(); ground_draw();
      // Finish the final line without a WSYNC or an extra visible line.
      layers_finish();
      vcs_ntsc_begin_overscan();
      PF1:=0;PF2:=0;GRP0:=0;GRP1:=0;ENAM0:=0;ENAM1:=0;ENABL:=0;
#ifdef LAYERS_MOTION
      // One byte of game state; all actual coordinates/pointers remain shared.
      // No copied glyph tables, cartridge RAM, or C activation temporaries.
      asm inc.z motion;
      asm lda.z motion;
      asm and #15;
      asm clc;
      asm adc #4;
      asm sta.z layers_player0_y;
      asm sta.z layers_player1_y;
      asm sec;
      asm sbc #4;
      asm sta.z layers_missile0_y;
      asm sta.z layers_missile1_y;
      asm sbc #1;
      asm sta.z layers_ball_y;
      asm lda.z motion;
      asm and #3;
      asm asl;
      asm asl;
      asm asl;
      asm clc;
      asm adc #<p0;
      asm sta.z layers_player0_graphics;
      asm lda #>p0;
      asm sta.z layers_player0_graphics + 1;
      asm lda.z motion;
      asm clc;
      asm adc #1;
      asm and #3;
      asm asl;
      asm asl;
      asm asl;
      asm clc;
      asm adc #<p1;
      asm sta.z layers_player1_graphics;
      asm lda #>p1;
      asm sta.z layers_player1_graphics + 1;
#ifdef LAYERS_CONTROLS
      // Exercise all eight copy/stretch modes and runtime X without adding
      // state. These bounded layouts avoid the still-open right-edge deadline.
      asm lda.z motion;
      asm and #7;
      asm ora #32;
      asm sta.z layers_player0_nusiz;
      asm sta.z layers_player1_nusiz;
      asm lda.z motion;
      asm and #1;
      asm clc;
      asm adc #10;
      asm sta.z layers_object_x;
      asm adc #30;
      asm sta.z layers_object_x + 1;
      asm adc #25;
      asm sta.z layers_object_x + 3;
      asm adc #55;
      asm sta.z layers_object_x + 4;
      asm lda.z motion;
      asm and #1;
      asm clc;
      asm adc #30;
      asm sta.z layers_object_x + 2;
#endif
#endif
      vcs_ntsc_end_overscan();
      // Calibrate the complete frame to264 raw harness lines (Stella262).
      // This is blanked frame-boundary work, never a section separator.
      asm sta WSYNC;
   }
}
