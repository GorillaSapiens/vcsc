// Human-facing preview, deliberately separate from the rapid seam stress test.
// This file is covered under CC0-1.0. See libraries/LICENSE.txt.
alias VCS_NTSC_EXTENDED_VBLANK
include "vcs.c26"
include "frame_ntsc.c26"
alias GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

// Quiet, independent row palettes; only the rocket exhaust is animated.
page const uint8_t layers_player0_colors[8] := {0x46,0x48,0x0a,0x0c,0x0c,0x0e,0x0e,0x0c};
page const uint8_t layers_player1_colors[8] := {0x26,0x28,0x2a,0x2c,0x2c,0x2e,0x2e,0x2c};
page const uint8_t preview_p0[32] := {
   GLYPH(0x18,0x3c,0x3c,0x7e,0x7e,0xdb,0x24,0),
   GLYPH(0x18,0x3c,0x3c,0x7e,0x7e,0xdb,0x18,0),
   GLYPH(0x18,0x3c,0x3c,0x7e,0x7e,0xdb,0x3c,0),
   GLYPH(0x18,0x3c,0x3c,0x7e,0x7e,0xdb,0x18,0)
};
page const uint8_t preview_p1[32] := {
   GLYPH(0x18,0x3c,0x7e,0x7e,0x3c,0x7e,0x24,0),
   GLYPH(0x18,0x3c,0x7e,0x7e,0x3c,0x7e,0x18,0),
   GLYPH(0x18,0x3c,0x7e,0x7e,0x3c,0x7e,0x3c,0),
   GLYPH(0x18,0x3c,0x7e,0x7e,0x3c,0x7e,0x18,0)
};
include "layers/all_five_dense_objects.c26"
instantiate "layers/all_five_intro.c26" as intro
instantiate "layers/all_five_section.c26" as sky (
   number_of_scanlines:=64, playfield_row:=0x80000001, pf_color:=0x84, bk_color:=0x80
)
instantiate "layers/all_five_section.c26" as middle (
   number_of_scanlines:=64, playfield_row:=0xc0000003, pf_color:=0xb4, bk_color:=0xb0
)
instantiate "layers/all_five_section.c26" as ground (
   number_of_scanlines:=64, playfield_row:=0xe0000007, pf_color:=0x24, bk_color:=0x20
)
uint8_t preview_clock;
uint8_t preview_y;
uint8_t preview_direction;

void preview_prepare(void) {
   layers_prepare_vertical(); intro_establish(); layers_prime();
}

void preview_update(void) {
   // Two hardware scanlines every four frames: about30 pixels/second.
   // Reverse at the screen ends, never reset the pose or teleport at a seam.
   asm inc.z preview_clock;
   asm lda.z preview_clock;
   asm and #3;
   asm bne.same @pose;
   asm lda.z preview_direction;
   asm bne.same @up;
   asm inc.z preview_y;
   asm lda.z preview_y;
   asm cmp #86;
   asm bcc.same @pose;
   asm lda #1;
   asm sta.z preview_direction;
   asm jmp @pose;
   asm @up:;
   asm dec.z preview_y;
   asm bne.same @pose;
   asm lda #0;
   asm sta.z preview_direction;
   asm @pose:;
   asm lda.z preview_y;
   asm clc;
   asm adc #8;
   asm sta.z layers_player0_y;
   asm sta.z layers_player1_y;
   asm sec;
   asm sbc #2;
   asm sta.z layers_missile0_y;
   asm sta.z layers_missile1_y;
   asm sbc #2;
   asm sta.z layers_ball_y;
   // Animate the exhaust at7.5 fps, not a new unrelated glyph every frame.
   asm lda.z preview_clock;
   asm lsr;
   asm lsr;
   asm lsr;
   asm and #3;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<preview_p0;
   asm sta.z layers_player0_graphics;
   asm lda #>preview_p0;
   asm sta.z layers_player0_graphics + 1;
   asm lda.z preview_clock;
   asm lsr;
   asm lsr;
   asm lsr;
   asm and #3;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<preview_p1;
   asm sta.z layers_player1_graphics;
   asm lda #>preview_p1;
   asm sta.z layers_player1_graphics + 1;
}

void main(void) {
   VBLANK:=2; PF0:=0; CTRLPF:=0x21;
   preview_clock:=0; preview_y:=10; preview_direction:=0;
   layers_object_x[0]:=20; layers_object_x[1]:=130;
   layers_object_x[2]:=50; layers_object_x[3]:=110; layers_object_x[4]:=80;
   layers_player0_nusiz:=0x20; layers_player1_nusiz:=0x20;
   layers_player0_y:=18; layers_player1_y:=18;
   layers_missile0_y:=16; layers_missile1_y:=16; layers_ball_y:=14;
   layers_player0_height:=7; layers_player1_height:=7;
   layers_missile0_height:=5; layers_missile1_height:=7; layers_ball_height:=3;
   layers_player0_graphics:=preview_p0; layers_player1_graphics:=preview_p1;
   while(1) {
      vcs_ntsc_vsync(); vcs_ntsc_begin_vblank(); preview_prepare();
      vcs_ntsc_end_vblank(); sky_first(); middle_draw(); ground_draw();
      layers_finish();
      vcs_ntsc_begin_overscan();
      PF1:=0;PF2:=0;GRP0:=0;GRP1:=0;ENAM0:=0;ENAM1:=0;ENABL:=0;
      preview_update();
      vcs_ntsc_end_overscan();
      asm sta WSYNC;
   }
}
