include "4K/mapper.c26"
include "frame_ntsc.c26"

instantiate "heart_score_component.c26" as health (line_markers:=1)

void main(void) {
   VBLANK := 2;
   COLUBK := 0x84;
   health_score := 5;
   health_half := 1;
   health_color := 0x46;
   health_lines := HEART_LINES;
   health_line_color := 0xc6;
   health_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      health_vblank();
      vcs_ntsc_end_vblank();
      vcs_ntsc_wait_component_scanlines(91);
      health_draw();
      vcs_ntsc_wait_visible_tail_scanlines(91);
      vcs_ntsc_begin_overscan();
      health_overscan();
      vcs_ntsc_end_overscan();
   }
}
