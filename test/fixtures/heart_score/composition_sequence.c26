// This file is covered under CC0-1.0. See examples/LICENSE.txt.
// Private raster fixture: six independent preset states, sixteen frames each.
// No joystick reads or host-time input injection. Build either visible order
// with HEART_COMPOSITION_BELOW=0/1. Artwork/layout freeze the reviewed scene;
// the public interactive examples have separate executable controller coverage.
include "4K/mapper.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"
instantiate "renderers/player_color/player_color.c26" as game (lines:=181)
instantiate "heart_score_component.c26" as score (line_markers:=1)

page const uint8_t game_playfield[44] := {
   VCS_PLAYFIELD_ROW(0bX.....X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.X.....X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0b..X....._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b...X...._.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b....X..._..X....._X.....X._....X...),
   VCS_PLAYFIELD_ROW(0b.....X.._...X...._.X.....X_.....X..),
   VCS_PLAYFIELD_ROW(0b......X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.......X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0bX......._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b.X......_.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b..X....._..X....._X.....X._....X...)
};
page const uint8_t game_player0_graphics_data[8] := {
   game_SPRITE_GLYPH(0b.X....X.,0bX.X..X.X,0bX.XXXX.X,0bXXXXXXXX,
      0bXX.XX.XX,0b.XXXXXX.,0b..XXXX..,0b.XX..XX.)
};
page const uint8_t game_player1_graphics_data[8] := {
   game_SPRITE_GLYPH(0bX.X..X.X,0b.X.XX.X.,0b..X..X..,0bXXXXXXXX,
      0bXX.XX.XX,0bXXXXXXXX,0b.XX..XX.,0b..XXXX..)
};
page const uint8_t game_player0_colors[8] := {
   game_SPRITE_GLYPH(VCS_NTSC_SKY_BLUE,VCS_NTSC_SKY_BLUE_2,VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_MEDIUM_PURPLE,VCS_NTSC_VIOLET,VCS_NTSC_ORCHID,VCS_NTSC_LIGHT_CORAL,VCS_NTSC_SANDY_BROWN)
};
page const uint8_t game_player1_colors[8] := {
   game_SPRITE_GLYPH(VCS_NTSC_ORCHID,VCS_NTSC_VIOLET,VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_ROYAL_BLUE,VCS_NTSC_SKY_BLUE_2,VCS_NTSC_SKY_BLUE,VCS_NTSC_AQUAMARINE,VCS_NTSC_PALE_GREEN)
};
uint8_t sequence_tick;

void apply_sequence_state(void) {
   game_PLAYER0_X:=44;
   score_score:=5; score_half:=1; score_lines:=8;
   switch (sequence_tick >> 4) {
      case 1: score_score:=6; score_half:=0; break;
      case 2: score_half:=0; break;
      case 3: score_lines:=7; break;
      case 4: score_lines:=9; break;
      case 5: game_PLAYER0_X:=159; break;
   }
}

inline void draw_visible_components(void) {
#if HEART_COMPOSITION_BELOW
   game_draw();
   WSYNC := $A;
   vcs_ntsc_component_handoff();
   score_draw();
#else
   score_draw();
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;
   WSYNC := $A;
   vcs_ntsc_component_handoff();
   game_draw();
#endif
}

void main(void) {
   VBLANK:=2;
   game_PLAYER1_X:=108; game_BALL_X:=78;
   game_PLAYER0_NUSIZ:=0x20; game_PLAYER1_NUSIZ:=0x20;
   game_player0_y:=70; game_player1_y:=42; game_ball_y:=45;
   game_player0_graphics:=game_player0_graphics_data;
   game_player1_graphics:=game_player1_graphics_data;
   game_player0_height:=7; game_player1_height:=7; game_ball_height:=3;
   game_playfield_position:=8;
   score_color:=VCS_NTSC_LIGHT_CORAL; score_line_color:=VCS_NTSC_PALE_GREEN;
   sequence_tick:=0; apply_sequence_state(); game_init(); score_init();
   while (1) {
      vcs_ntsc_vsync(); vcs_ntsc_begin_vblank(); game_vblank(); score_vblank();
      COLUBK:=VCS_NTSC_DARK_BLUE; COLUPF:=VCS_NTSC_GOLDENROD; CTRLPF:=0x21;
      vcs_ntsc_end_vblank(); draw_visible_components();
      vcs_ntsc_begin_overscan(); game_overscan(); score_overscan();
      sequence_tick++;
      if (sequence_tick == 96) { sequence_tick:=0; }
      apply_sequence_state();
      vcs_ntsc_end_overscan();
   }
}
