include "4K/mapper.c26"
include "frame_ntsc.c26"


instantiate "heart_score_component.c26" as health


void main(void) {
   VBLANK := 2;
   COLUBK := 0x84;
   health_score := HEART_SCORE;
   health_half := HEART_HALF;
#ifdef HEART_BOXES
   health_boxes := HEART_BOXES;
#else
   health_boxes := 11;
#endif
   health_color := 0x46;
#ifdef HEART_BOX_COLOR
   health_box_color := HEART_BOX_COLOR;
#else
   // Keep the legacy raster oracle focused on heart geometry. Visible box
   // coverage has its own Stella cases.
   health_box_color := 0x84;
#endif
   health_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      health_vblank();
      vcs_ntsc_end_vblank();
      vcs_ntsc_wait_component_scanlines(92);
      health_draw();
      vcs_ntsc_wait_visible_tail_scanlines(93);
      vcs_ntsc_begin_overscan();
      health_overscan();
      vcs_ntsc_end_overscan();
   }
}
