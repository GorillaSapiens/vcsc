include "vcs_2k.c26"
include "frame_ntsc.c26"
instantiate "driving_controller.c26" as drive (port:=1)

void main(void) {
   VBLANK := 2;
   SWACNT := 0xf0;
   SWCHA := 0x50;
   drive_init();

   while (1) {
      vcs_ntsc_vsync();
      drive_begin_frame();
      vcs_ntsc_begin_vblank();
      drive_sample();
      vcs_ntsc_wait_scanlines(6);
      drive_sample();
      vcs_ntsc_wait_scanlines(6);
      drive_sample();
      vcs_ntsc_end_vblank();
      vcs_ntsc_wait_visible_tail_scanlines(192);
      vcs_ntsc_begin_overscan();
      drive_sample();
      vcs_ntsc_wait_scanlines(6);
      drive_sample();
      vcs_ntsc_wait_scanlines(6);
      drive_sample();
      vcs_ntsc_end_overscan();
   }
}
