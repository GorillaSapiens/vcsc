// Minimal unbanked 4K Atari VCS cartridge.
//
// This deliberately keeps the visible renderer in inline 6502 assembly while
// exercising the static-frame source ABI during initialization.

include "vcs.c26"

typedef int16_t int;
typedef uint8_t char;
typedef uint8_t bool;

uint8_t choose_background(uint8_t seed) {
   uint8_t color := seed + 2;
   return color;
}

void main(void) {
   uint8_t color := choose_background(0x82);

   // Clear every object that could otherwise contain power-up garbage.
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := color;

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   asm @frame:;
   asm lda #2;
   asm sta VSYNC;
   asm ldx #3;
   asm @vsync:;
   asm sta WSYNC;
   asm dex;
   asm bne @vsync;

   asm lda #0;
   asm sta VSYNC;
   asm lda #2;
   asm sta VBLANK;
   asm lda #0;
   asm ldx #37;
   asm @vblank:;
   asm sta WSYNC;
   asm dex;
   asm bne @vblank;

   asm lda #0;
   asm sta VBLANK;
   asm ldx #192;
   asm @visible:;
   asm sta WSYNC;
   asm dex;
   asm bne @visible;

   asm lda #2;
   asm sta VBLANK;
   asm lda #0;
   asm ldx #30;
   asm @overscan:;
   asm sta WSYNC;
   asm dex;
   asm bne @overscan;
   asm jmp @frame;
}
