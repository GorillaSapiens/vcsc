// Motion diagnostic for the P0+P1+BL per-row player-color renderer variant.
// Both players retain a different color on every logical sprite row while all
// three supported objects move asynchronously across the full X=0..159 range.

include "vcs.c26"

page const uint8_t vcs_standard_color_playfield[48] := {
   0xff, 0xff, 0xff, 0xff,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0xff, 0xff, 0xff, 0xff,
   0x00, 0x00, 0x00, 0x00
};

include "renderers/standard_4k_ntsc_playercolors/standard_4k_ntsc_playercolors.c26"


page const uint8_t player0_graphics[8] := {
   VCS_STANDARD_COLOR_SPRITE_GLYPH(
      0b.XXXXXX.,
      0bXX....XX,
      0bXX...XXX,
      0bXX..X.XX,
      0bXX.X..XX,
      0bXXX...XX,
      0bXX....XX,
      0b.XXXXXX.
   )
};

page const uint8_t player1_graphics[8] := {
   VCS_STANDARD_COLOR_SPRITE_GLYPH(
      0b.XXXXXX.,
      0bXX....XX,
      0bXX....XX,
      0bXX.XX.XX,
      0bXX.XX.XX,
      0bXX....XX,
      0bXX....XX,
      0b.XXXXXX.
   )
};

page const uint8_t vcs_standard_color_player0_colors[8] := {
   VCS_STANDARD_COLOR_SPRITE_ROWS(
      0x3e, 0x4e, 0x5e, 0x6e, 0x7e, 0x8e, 0x9e, 0xae
   )
};
page const uint8_t vcs_standard_color_player1_colors[8] := {
   VCS_STANDARD_COLOR_SPRITE_ROWS(
      0xce, 0xbe, 0xae, 0x9e, 0x8e, 0x7e, 0x6e, 0x5e
   )
};

alias DIRECTION_PLAYER0 0x01
alias DIRECTION_PLAYER1 0x02
alias DIRECTION_BALL 0x04
alias MOTION_MIN_X 0
alias MOTION_MAX_X 159
alias SPEED_PLAYER0 1
alias SPEED_PLAYER1 5
alias SPEED_BALL 7

uint8_t motion_directions := 0x05;

void move_object(uint8_t object, uint8_t direction, uint8_t speed) {
   if (motion_directions & direction) {
      if (vcs_standard_color_object_x[object] >= MOTION_MAX_X - speed) {
         vcs_standard_color_object_x[object] := MOTION_MAX_X;
         motion_directions ^= direction;
      }
      else {
         vcs_standard_color_object_x[object] += speed;
      }
   }
   else {
      if (vcs_standard_color_object_x[object] <= MOTION_MIN_X + speed) {
         vcs_standard_color_object_x[object] := MOTION_MIN_X;
         motion_directions ^= direction;
      }
      else {
         vcs_standard_color_object_x[object] -= speed;
      }
   }
}

void vcs_standard_color_overscan_hook(void) {
   move_object(VCS_STANDARD_COLOR_OBJECT_PLAYER0, DIRECTION_PLAYER0, SPEED_PLAYER0);
   move_object(VCS_STANDARD_COLOR_OBJECT_PLAYER1, DIRECTION_PLAYER1, SPEED_PLAYER1);
   move_object(VCS_STANDARD_COLOR_OBJECT_BALL, DIRECTION_BALL, SPEED_BALL);
   vcs_standard_color_score++;
}

void initialize_scene(void) {
   COLUBK := 0x82;
   COLUPF := 0x2e;
   CTRLPF := 0x21;

   VCS_STANDARD_COLOR_PLAYER0_X := 0;
   VCS_STANDARD_COLOR_PLAYER1_X := 159;
   VCS_STANDARD_COLOR_BALL_X := 80;

   vcs_standard_color_player0_y := 18;
   vcs_standard_color_player1_y := 78;
   vcs_standard_color_ball_y := 48;

   vcs_standard_color_player0_graphics := player0_graphics;
   vcs_standard_color_player1_graphics := player1_graphics;
   vcs_standard_color_player0_height := 7;
   vcs_standard_color_player1_height := 7;
   vcs_standard_color_ball_height := 3;

   vcs_standard_color_score := 123456;
   vcs_standard_color_score_color := 0x0e;
   vcs_standard_color_playfield_position := 8;

   VBLANK := 2;
   TIM64T := 0;
}

void configure_frame(void) {
   COLUPF := 0x2e;
   CTRLPF := 0x21;
   NUSIZ0 := 0x20;
   NUSIZ1 := 0x20;
}

void main(void) {
   initialize_scene();
   while (1) {
      configure_frame();
      vcs_standard_color_renderer_drawscreen();
   }
}
