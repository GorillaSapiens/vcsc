// 6507 silicon fingerprint display.
//
// Four unstable ARR-immediate probes produce accumulator and masked NVZC
// results. VCSC feeds those eight bytes through CRC-24/OPENPGP and displays
// the resulting 24-bit fingerprint in Whimsey hexadecimal, between fixed VCSC
// logos at the upper-right and lower-left edges.

include "vcs.c26"
include "frame_ntsc.c26"
include "fonts/whimsey_hex.c26"
include "fonts/logo_font.c26"

alias BACKGROUND_COLOR 0x84

uint8_t probe_accumulator;
uint8_t probe_flags;
uint24_t fingerprint;

#ifndef FINGERPRINT_SELFTEST
instantiate "six_glyph_component.c26" as display
instantiate "six_glyph_right_component.c26" as upper_logo
instantiate "six_glyph_left_component.c26" as lower_logo
#endif

// ARR is an unstable unofficial NMOS 6502/6507 opcode. The example enables
// named unofficial mnemonics explicitly with -Wa,--illegals; each annotated
// line also records the exact opcode and operand bytes emitted. Each probe
// stores A' and then captures NVZC from P' before any flag-changing cleanup.
void probe1(void) {
   asm cld;
   asm sec;
   asm lda #$e5;
   asm ARR #$b8; // Unstable unofficial ARR; emits bytes $6B,$B8.
   asm sta probe_accumulator;
   asm php;
   asm pla;
   asm and #$c3;
   asm sta probe_flags;
   asm cld;
}

void probe2(void) {
   asm cld;
   asm sec;
   asm lda #$36;
   asm ARR #$6b; // Unstable unofficial ARR; emits bytes $6B,$6B.
   asm sta probe_accumulator;
   asm php;
   asm pla;
   asm and #$c3;
   asm sta probe_flags;
   asm cld;
}

void probe3(void) {
   asm sed;
   asm clc;
   asm lda #$f6;
   asm ARR #$6b; // Unstable unofficial ARR; emits bytes $6B,$6B.
   asm sta probe_accumulator;
   asm php;
   asm pla;
   asm and #$c3;
   asm sta probe_flags;
   asm cld;
}

void probe4(void) {
   asm cld;
   asm clc;
   asm lda #$06;
   asm ARR #$6b; // Unstable unofficial ARR; emits bytes $6B,$6B.
   asm sta probe_accumulator;
   asm php;
   asm pla;
   asm and #$c3;
   asm sta probe_flags;
   asm cld;
}

// CRC-24/OPENPGP: poly 0x864cfb, init 0xb704ce, no reflection, xorout 0.
void crc24_feed(uint8_t value) {
   uint8_t bits := 8;

   fingerprint ^= (uint24_t)value << 16;
   while (bits) {
      if (fingerprint & 0x800000) {
         fingerprint <<= 1;
         fingerprint ^= 0x864cfb;
      }
      else {
         fingerprint <<= 1;
      }
      bits--;
   }
}

void compute_fingerprint(void) {
   fingerprint := 0xb704ce;

   probe1();
   crc24_feed(probe_accumulator);
   crc24_feed(probe_flags);

   probe2();
   crc24_feed(probe_accumulator);
   crc24_feed(probe_flags);

   probe3();
   crc24_feed(probe_accumulator);
   crc24_feed(probe_flags);

   probe4();
   crc24_feed(probe_accumulator);
   crc24_feed(probe_flags);
}

#ifndef FINGERPRINT_SELFTEST
// The display component stores packed BCD for decimal-score users.  This
// hexadecimal application deliberately copies the fingerprint bytes verbatim:
// the component pointer builder interprets the same six nibbles as hex glyphs.
inline void load_display_fingerprint(void) {
   // Satisfy the component score contract before replacing its bytes raw.
   display_score := 0;
   asm lda fingerprint;
   asm sta display_score;
   asm lda fingerprint+1;
   asm sta display_score+1;
   asm lda fingerprint+2;
   asm sta display_score+2;
}
#endif

#ifndef FINGERPRINT_SELFTEST
// The reusable components normally derive pointers from score_font. Both logos
// use the fixed packed-BCD value 012345, then redirect their six glyph pointers
// to the corresponding slices in logo_font.
inline void load_logo_pointers(void) {
   // logo_font is page-contained, so all six pointers share one high byte.
   asm lda #<logo_font;
   asm sta upper_logo_pointers;
   asm sta lower_logo_pointers;
   asm clc;
   asm adc #$08;
   asm sta upper_logo_pointers+2;
   asm sta lower_logo_pointers+2;
   asm adc #$08;
   asm sta upper_logo_pointers+4;
   asm sta lower_logo_pointers+4;
   asm adc #$08;
   asm sta upper_logo_pointers+6;
   asm sta lower_logo_pointers+6;
   asm adc #$08;
   asm sta upper_logo_pointers+8;
   asm sta lower_logo_pointers+8;
   asm adc #$08;
   asm sta upper_logo_pointers+10;
   asm sta lower_logo_pointers+10;

   asm lda #>logo_font;
   asm sta upper_logo_pointers+1;
   asm sta lower_logo_pointers+1;
   asm sta upper_logo_pointers+3;
   asm sta lower_logo_pointers+3;
   asm sta upper_logo_pointers+5;
   asm sta lower_logo_pointers+5;
   asm sta upper_logo_pointers+7;
   asm sta lower_logo_pointers+7;
   asm sta upper_logo_pointers+9;
   asm sta lower_logo_pointers+9;
   asm sta upper_logo_pointers+11;
   asm sta lower_logo_pointers+11;
}
#endif

#ifdef FINGERPRINT_SELFTEST
void main(void) {
   // Standard CRC-24/OPENPGP check vector: ASCII "123456789" -> 0x21cf02.
   fingerprint := 0xb704ce;
   crc24_feed(0x31);
   crc24_feed(0x32);
   crc24_feed(0x33);
   crc24_feed(0x34);
   crc24_feed(0x35);
   crc24_feed(0x36);
   crc24_feed(0x37);
   crc24_feed(0x38);
   crc24_feed(0x39);
   if (fingerprint != 0x21cf02) {
      asm lda #$ff;
      asm ldx #1;
      asm ldy #0;
      asm jsr $ffff;
   }
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
#else
void main(void) {
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := BACKGROUND_COLOR;
   VBLANK := 2;

   compute_fingerprint();
   load_display_fingerprint();
   upper_logo_score := 12345; // Leading zero makes the fixed six-glyph value 012345.
   lower_logo_score := 12345;
   upper_logo_color := 0x0e;
   lower_logo_color := 0x0e;
   display_init();
   upper_logo_init();
   lower_logo_init();
   load_logo_pointers();

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   while (1) {
      vcs_ntsc_vsync();

      vcs_ntsc_begin_vblank();
      display_vblank();
      upper_logo_vblank();
      lower_logo_vblank();
      load_logo_pointers();
      vcs_ntsc_end_vblank();

      upper_logo_draw();
      vcs_ntsc_wait_component_scanlines(80);
      display_draw();
      vcs_ntsc_wait_component_scanlines(79);
      lower_logo_draw();

      vcs_ntsc_begin_overscan();
      display_overscan();
      upper_logo_overscan();
      lower_logo_overscan();
      vcs_ntsc_end_overscan();
   }
}
#endif
