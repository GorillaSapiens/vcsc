// Independent raw-byte reference for public example 05.
include "vcs.c26"
include "frame_ntsc.c26"

page const uint8_t game_playfield[48] := {
   0xff,0xff,0xff,0xff,
   0x88,0x00,0x00,0x88,
   0x80,0x00,0x00,0x80,
   0x80,0x01,0x01,0x80,
   0x80,0x00,0x00,0x80,
   0x80,0x00,0x00,0x80,
   0x80,0x00,0x00,0x80,
   0x80,0x10,0x10,0x80,
   0x80,0x00,0x00,0x80,
   0x88,0x00,0x00,0x88,
   0x80,0x00,0x00,0x80,
   0xff,0xff,0xff,0xff
};

page const uint8_t game_player0_colors[8] := {
   0xae,0x9e,0x8e,0x7e,0x6e,0x5e,0x4e,0x3e
};

page const uint8_t game_player1_colors[8] := {
   0x5e,0x6e,0x7e,0x8e,0x9e,0xae,0xbe,0xce
};

template "kernels/player_color_192/player_color_192.c26" as game

page const uint8_t p0_graphics[8] := {
   0x3c,0x66,0x66,0x66,0x7e,0x66,0x66,0x3c
};

page const uint8_t p1_graphics[8] := {
   0x7c,0x66,0x66,0x66,0x7c,0x66,0x66,0x7c
};

void configure_game_frame(void) {
   COLUBK := 0x84;
   COLUPF := 0x2e;
   CTRLPF := 0x21;
}

void initialize_scene(void) {
   VBLANK := 2;

   game_PLAYER0_X := 44;
   game_PLAYER1_X := 108;
   game_BALL_X := 78;

   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;

   game_player0_y := 48;
   game_player1_y := 48;
   game_ball_y := 50;

   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 3;

   game_playfield_position := 8;
   game_init();
}

void main(void) {
   initialize_scene();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      configure_game_frame();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      vcs_ntsc_end_overscan();
   }
}
