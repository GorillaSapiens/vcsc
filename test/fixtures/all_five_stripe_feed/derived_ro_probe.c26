// Probe for stripe_generic_feed_source_bound.pl.
//
// The generic stripe renderer needs its next-stripe bytes as pair-indexed ROM:
// three page-contained tables read with fixed absolute,Y loads at a frame-wide
// pair index, because every alternative source was searched and rejected
// (stripe32_record_common_index_bound.pl for the X-held offset form,
// stripe_feed_pointer_source_search.pl for the zero-page pointer form).
//
// Those three tables are the logical eight-byte stripe record transposed, so the
// question is where a table DERIVED from a `const` record is placed.  This probe is
// the smallest statement of that question: a source `const` table and a `const`
// table whose initializer is nothing but element reads of the source.
//
// It is deliberately not a renderer: the answer must not depend on stripes.
//
// The derived table is `page const`, which is the combination the renderer will
// actually declare, so the probe proves both at once: that a derived table is
// link-time ROM with no RAM and no startup copy, and that its page-containment
// constraint survives the derivation.  The 96-byte literal tables below only supply
// bytes to derive from at the feed's real table size.
include "vcs.c26"

const uint8_t src[8] := {
   0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88
};

// Reversed copy of src, written the way a pair-indexed feed is derived from a
// stripe record: element reads of another `const` object, composed with constant
// arithmetic as a real transposition would be.
const uint8_t derived[8] := {
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0]
};

// The shape the renderer declares: derived, and page-contained.  Its 96 bytes are
// the reversal of src repeated twelve times, which is what a feed table looks like
// once the record has been transposed into pair order.  Written out because the
// renderer has no loop at compile time, so the same limitation applies here.
page const uint8_t feed_page[96] := {
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0],
   src[7],src[6],src[5],src[4],src[3],src[2],src[1],src[0]
};

page const uint8_t page0[96] := {
   0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b,
   0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
   0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f, 0x20, 0x21, 0x22, 0x23,
   0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2a, 0x2b, 0x2c, 0x2d, 0x2e, 0x2f,
   0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x3a, 0x3b,
   0x3c, 0x3d, 0x3e, 0x3f, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47,
   0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f, 0x50, 0x51, 0x52, 0x53,
   0x54, 0x55, 0x56, 0x57, 0x58, 0x59, 0x5a, 0x5b, 0x5c, 0x5d, 0x5e, 0x5f
};

page const uint8_t page1[96] := {
   0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2a, 0x2b,
   0x2c, 0x2d, 0x2e, 0x2f, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
   0x38, 0x39, 0x3a, 0x3b, 0x3c, 0x3d, 0x3e, 0x3f, 0x40, 0x41, 0x42, 0x43,
   0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f,
   0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56, 0x57, 0x58, 0x59, 0x5a, 0x5b,
   0x5c, 0x5d, 0x5e, 0x5f, 0x60, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67,
   0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x6e, 0x6f, 0x70, 0x71, 0x72, 0x73,
   0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7a, 0x7b, 0x7c, 0x7d, 0x7e, 0x7f
};

page const uint8_t page2[96] := {
   0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0x4a, 0x4b,
   0x4c, 0x4d, 0x4e, 0x4f, 0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56, 0x57,
   0x58, 0x59, 0x5a, 0x5b, 0x5c, 0x5d, 0x5e, 0x5f, 0x60, 0x61, 0x62, 0x63,
   0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6a, 0x6b, 0x6c, 0x6d, 0x6e, 0x6f,
   0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7a, 0x7b,
   0x7c, 0x7d, 0x7e, 0x7f, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87,
   0x88, 0x89, 0x8a, 0x8b, 0x8c, 0x8d, 0x8e, 0x8f, 0x90, 0x91, 0x92, 0x93,
   0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9a, 0x9b, 0x9c, 0x9d, 0x9e, 0x9f
};

void main(void) {
   VBLANK := 2;
   while (1) {
   }
}
