// vcsc-cc1 -I .
// expectasm: __memmeta$V2$superchip$RF080$WF000$Z0080$Trw
// expectasm: .segment "BSS.superchip.__vcsc_activation$touch"
// expectasm: touch$value:
// expectasm: .export touch$value
// expectasm: symbol_split

include "machine_6502.c26"
mem superchip { $read_start:0xF080 $write_start:0xF000 $size:0x80 $rw };

void touch(superchip uint8_t value) {
   value += 1;
}

void main(void) {
   touch(3);
}
