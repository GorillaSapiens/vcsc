// vcsc-cc1 -I .
// object: e2e_bcd32_memory_return_cross_tu_verify__def.c26
// expectexit: 0
include "machine_6502.c26"

bcd32_t make_total(void);

void fail(uint8_t code) {
   asm ldy #0;
   asm lda fail$code,y;
   asm tax;
   asm lda #$ff;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   bcd32_t value := make_total();
   if (value != 87654321) { fail(1); }
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
