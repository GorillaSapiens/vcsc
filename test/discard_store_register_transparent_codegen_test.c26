// forbidasm: sec

include "machine_6502.c26"

uint8_t discard_global;
zeropage uint8_t discard_zp;
uint8_t discard_abs@[none/0xd012];

void discard_store_register_transparent_test(void) {
   uint8_t discard_local;
   discard_global := _;
   discard_zp := _;
   discard_abs := _;
   discard_local := _;
}
