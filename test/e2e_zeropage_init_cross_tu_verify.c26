// vcsc-cc1 -I .
// expectsim: OK
// expectexit: 0
// object: e2e_zeropage_init_cross_tu_verify__def.c26
include "machine_6502.c26"

static int8_t ok[4] := { 'O', 'K', '\n', 0 };
static int8_t bad[5] := { 'B', 'A', 'D', '\n', 0 };

extern zeropage int16_t shared;

void print_ok(void) {
   asm lda #0;
   asm ldx #<ok;
   asm ldy #>ok;
   asm jsr $ffff;
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void print_bad(void) {
   asm lda #0;
   asm ldx #<bad;
   asm ldy #>bad;
   asm jsr $ffff;
   asm lda #$ff;
   asm ldx #1;
   asm ldy #0;
   asm jsr $ffff;
}

void main(void) {
   if (shared == 7) {
      print_ok();
   }
   else {
      print_bad();
   }
}
