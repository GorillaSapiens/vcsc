// n65c -I .
// expectexit: 0

include "machine_6502.n"

union f32bits {
   float f;
   char b[4];
};

ref char gfailcode@[none/0x02f0];

void pass(void) {
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}

void fail(int code) {
   gfailcode := code;
   asm lda #$ff;
   asm ldx $02f0;
   asm ldy #0;
   asm jsr $ffff;
}

void expect4(f32bits got, f32bits want, int code) {
   if (got.b[0] != want.b[0]) { fail(code + 0); }
   if (got.b[1] != want.b[1]) { fail(code + 1); }
   if (got.b[2] != want.b[2]) { fail(code + 2); }
   if (got.b[3] != want.b[3]) { fail(code + 3); }
}

void main(void) {
   f32bits lhs;
   f32bits rhs;
   f32bits got;
   f32bits want;
   f32bits mul_assign;
   f32bits div_assign;
   f32bits box[2];

   lhs.f := 1.5`float;
   rhs.f := 0.5`float;

   got.f := lhs.f * rhs.f;
   want.f := 0.75`float;
   expect4(got, want, 1);

   got.f := lhs.f / rhs.f;
   want.f := 3.0`float;
   expect4(got, want, 5);

   mul_assign.f := lhs.f;
   mul_assign.f *= rhs.f;
   want.f := 0.75`float;
   expect4(mul_assign, want, 9);

   div_assign.f := lhs.f;
   div_assign.f /= rhs.f;
   want.f := 3.0`float;
   expect4(div_assign, want, 13);

   box[0].f := lhs.f;
   box[1].f := rhs.f;
   box[0].f *= box[1].f;
   want.f := 0.75`float;
   expect4(box[0], want, 17);

   box[0].f := 3.0`float;
   box[1].f := lhs.f;
   box[0].f /= box[1].f;
   want.f := 2.0`float;
   expect4(box[0], want, 21);

   pass();
}
