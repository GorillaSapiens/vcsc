include "machine_6502.c26"

uint24_t uhex := 0x123456;
uint24_t umax := 16777215;
int24_t smax := 8388607;
int24_t smin := -8388608;
uint24_t uwrap := (uint24_t)-1;
int24_t swrap := (int24_t)8388608;

int24_t identity(int24_t value) {
   return value;
}
