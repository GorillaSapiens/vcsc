// expectasm: umax:
// expectasm: 	.byte $ff, $ff, $ff
// expectasm: smax:
// expectasm: 	.byte $ff, $ff, $7f
// expectasm: smin:
// expectasm: 	.byte $00, $00, $80
// expectasm: uwrap:
// expectasm: 	.byte $ff, $ff, $ff
// expectasm: swrap:
