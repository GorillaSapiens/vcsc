// n65c

type void      { $size:0 };
type uint8_t     { $size:1 $integer:unsigned };
type int8_t      { $size:1    $integer:signed };
type uchar     { $size:1  $integer:unsigned };
type *         { $size:2  $integer:unsigned $endian:little };
type short     { $size:2    $integer:signed $endian:little };
type int16_t       { $size:2    $integer:signed $endian:little };
type uint      { $size:2  $integer:unsigned $endian:little };

int16_t g := 3;
int16_t h := 9;

short main(void) {
   int16_t x := g;
   g += 4;
   h := g + h;
   return h - x;
}
