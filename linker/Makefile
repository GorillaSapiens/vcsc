CC = gcc
CFLAGS = -std=c11 -Wall -Wextra -Werror -pedantic -O2
DEPFLAGS = -MMD -MP
LDFLAGS ?=
EXEEXT ?=
TARGET = vcsc-ld$(EXEEXT)

BINDIR ?= /opt/vcsc/bin
DESTDIR ?=
INSTALL ?= install
INSTALL_PROGRAM ?= $(INSTALL) -m 0755

OBJS = vcsc_ld.o vcsc_ld_input.o vcsc_ld_abi.o
DEPS = $(OBJS:.o=.d)
DOXYGEN ?= doxygen
PERL ?= perl
VCSC_AS ?= $(if $(ASM),$(ASM),../assembler/vcsc-as)
BANKCALL_TEMPLATE_SOURCE = ../libraries/vcs/F8/inline_bankcall.s26
BANKCALL_TEMPLATE_GENERATOR = gen_inline_bankcall_template.pl
BANKCALL_TEMPLATE_HEADER = generic_bankcall_template.h
FA2_BANKCALL_TEMPLATE_SOURCE = ../libraries/vcs/FA2/inline_bankcall.s26
FA2_BANKCALL_TEMPLATE_HEADER = fa2_bankcall_template.h
JANE_BANKCALL_TEMPLATE_SOURCE = ../libraries/vcs/JANE/inline_bankcall.s26
JANE_BANKCALL_TEMPLATE_HEADER = jane_bankcall_template.h
M0840_BANKCALL_TEMPLATE_SOURCE = ../libraries/vcs/0840/inline_bankcall.s26
M0840_BANKCALL_TEMPLATE_HEADER = m0840_bankcall_template.h
UA_BANKCALL_TEMPLATE_SOURCE = ../libraries/vcs/UA/inline_bankcall.s26
UA_BANKCALL_TEMPLATE_HEADER = ua_bankcall_template.h
UASW_BANKCALL_TEMPLATE_SOURCE = ../libraries/vcs/UASW/inline_bankcall.s26
UASW_BANKCALL_TEMPLATE_HEADER = uasw_bankcall_template.h
M0FA0_BANKCALL_TEMPLATE_SOURCE = ../libraries/vcs/0FA0/inline_bankcall.s26
M0FA0_BANKCALL_TEMPLATE_HEADER = m0fa0_bankcall_template.h

all: version.h $(TARGET)

.PHONY: version FORCE
version: version.h

version.h: FORCE
	perl ../gen_version_h.pl $@

$(TARGET): version.h $(OBJS)
	$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) -o $(TARGET)

../assembler/vcsc-as:
	$(MAKE) --no-print-directory -C ../assembler vcsc-as

$(BANKCALL_TEMPLATE_HEADER): $(BANKCALL_TEMPLATE_SOURCE) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS)
	$(PERL) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS) $(BANKCALL_TEMPLATE_SOURCE) $@ GENERIC

$(FA2_BANKCALL_TEMPLATE_HEADER): $(FA2_BANKCALL_TEMPLATE_SOURCE) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS)
	$(PERL) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS) $(FA2_BANKCALL_TEMPLATE_SOURCE) $@ FA2

$(JANE_BANKCALL_TEMPLATE_HEADER): $(JANE_BANKCALL_TEMPLATE_SOURCE) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS)
	$(PERL) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS) $(JANE_BANKCALL_TEMPLATE_SOURCE) $@ JANE

$(M0840_BANKCALL_TEMPLATE_HEADER): $(M0840_BANKCALL_TEMPLATE_SOURCE) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS)
	$(PERL) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS) $(M0840_BANKCALL_TEMPLATE_SOURCE) $@ M0840

$(UA_BANKCALL_TEMPLATE_HEADER): $(UA_BANKCALL_TEMPLATE_SOURCE) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS)
	$(PERL) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS) $(UA_BANKCALL_TEMPLATE_SOURCE) $@ UA

$(UASW_BANKCALL_TEMPLATE_HEADER): $(UASW_BANKCALL_TEMPLATE_SOURCE) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS)
	$(PERL) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS) $(UASW_BANKCALL_TEMPLATE_SOURCE) $@ UASW

$(M0FA0_BANKCALL_TEMPLATE_HEADER): $(M0FA0_BANKCALL_TEMPLATE_SOURCE) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS)
	$(PERL) $(BANKCALL_TEMPLATE_GENERATOR) $(VCSC_AS) $(M0FA0_BANKCALL_TEMPLATE_SOURCE) $@ M0FA0

vcsc_ld.o: version.h $(BANKCALL_TEMPLATE_HEADER) $(FA2_BANKCALL_TEMPLATE_HEADER) $(JANE_BANKCALL_TEMPLATE_HEADER) $(M0840_BANKCALL_TEMPLATE_HEADER) $(UA_BANKCALL_TEMPLATE_HEADER) $(UASW_BANKCALL_TEMPLATE_HEADER) $(M0FA0_BANKCALL_TEMPLATE_HEADER)

%.o: %.c
	$(CC) $(CFLAGS) $(DEPFLAGS) -c $< -o $@

docs:
	$(MAKE) --no-print-directory -C .. docs

install: $(TARGET)
	$(INSTALL) -d $(DESTDIR)$(BINDIR)
	$(INSTALL_PROGRAM) $(TARGET) $(DESTDIR)$(BINDIR)/$(TARGET)

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/$(TARGET)

clean:
	rm -f vcsc-ld vcsc-ld.exe $(OBJS) $(DEPS) version.h $(BANKCALL_TEMPLATE_HEADER) $(FA2_BANKCALL_TEMPLATE_HEADER) $(JANE_BANKCALL_TEMPLATE_HEADER) $(M0840_BANKCALL_TEMPLATE_HEADER) $(UA_BANKCALL_TEMPLATE_HEADER) $(UASW_BANKCALL_TEMPLATE_HEADER) $(M0FA0_BANKCALL_TEMPLATE_HEADER)

-include $(DEPS)

.PHONY: docs
