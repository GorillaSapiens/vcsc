      0b..XXXXX.,
      0b.....X..,
      0b.....X..,
      0b.....X..
   ),

   // 0x72 latin small letter r
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b.X.XXX..,
      0b.XXX.X..,
      0b.X......,
      0b.X......,
      0b.X......,
      0b.X......
   ),

   // 0x73 latin small letter s
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXXXX.,
      0b.X......,
      0b..XXXX..,
      0b.....X..,
      0b.....X..,
      0b.XXXXX..
   ),

   // 0x74 latin small letter t
   VCS_FONT_GLYPH(
      0b..X.....,
      0b..X.....,
      0b.XXXX...,
      0b..X.....,
      0b..X.....,
      0b..X..X..,
      0b..X..X..,
      0b...XXX..
   ),

   // 0x75 latin small letter u
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b.X...X..,
      0b.X...X..,
      0b.X...X..,
      0b.X..XXX.,
      0b.X...X..,
      0b..XXXX..
   ),

   // 0x76 latin small letter v
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b.X...X..,
      0b.X...X..,
      0b.X...X..,
      0b.XX.XX..,
      0b..X.X...,
      0b...X....
   ),

   // 0x77 latin small letter w
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b.X...X..,
      0b.X.X.X..,
      0b.X.X.X..,
      0b.X.X.X..,
      0b.X.X.X..,
      0b..X.X...
   ),

   // 0x78 latin small letter x
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b.X...X..,
      0b..X.X...,
      0b...X....,
      0b..XXX...,
      0b..X.X...,
      0b.X...X..
   ),

   // 0x79 latin small letter y
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b.X...X..,
      0b.X...X..,
      0b..XXXXX.,
      0b.....X..,
      0b.....X..,
      0b..XXXX..
   ),

   // 0x7A latin small letter z
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b.XXXXXX.,
      0b....X...,
      0b...X....,
      0b..XX....,
      0b..X.....,
      0b.XXXXXX.
   ),

   // 0x7B left curly bracket
   VCS_FONT_GLYPH(
      0b....X...,
      0b...X....,
      0b...X....,
      0b..X.....,
      0b...X....,
      0b...X....,
      0b...X....,
      0b....X...
   ),

   // 0x7C vertical line
   VCS_FONT_GLYPH(
      0b...X....,
      0b...X....,
      0b...X....,
      0b...X....,
      0b...X....,
      0b...X....,
      0b...X....,
      0b...X....
   ),

   // 0x7D right curly bracket
   VCS_FONT_GLYPH(
      0b..X.....,
      0b...X....,
      0b...X....,
      0b....X...,
      0b...X....,
      0b...X....,
      0b...X....,
      0b..X.....
   ),

   // 0x7E tilde
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..X..X..,
      0b.X.XXX..,
      0b........,
      0b........,
      0b........,
      0b........
   )

};
