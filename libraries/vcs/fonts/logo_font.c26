alias LOGO_FONT_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

page const uint8_t logo_font[48] := {
   // 0
   LOGO_FONT_GLYPH(
      0b......XX,
      0b......XX,
      0b......XX,
      0b.......X,
      0b.......X,
      0b........,
      0b........,
      0b........
   ),

   // 1
   LOGO_FONT_GLYPH(
      0bX..XXX..,
      0bX..XXX.X,
      0bX..XXX.X,
      0bXXXXX..X,
      0bXXXXX..X,
      0bXXXX...X,
      0b.XX.....,
      0b........
   ),

   // 2
   LOGO_FONT_GLYPH(
      0bXXXXXX..,
      0bXXXXXXX.,
      0bXX..XXX.,
      0bXX......,
      0bXX..XXX.,
      0bXXXXXXX.,
      0bXXXXXX..,
      0b........
   ),

   // 3
   LOGO_FONT_GLYPH(
      0b.XXXXXX.,
      0bXXXXXXXX,
      0bXXXX....,
      0b.XXXXXX.,
      0b....XXXX,
      0bXXXXXXXX,
      0b.XXXXXX.,
      0b........
   ),

   // 4
   LOGO_FONT_GLYPH(
      0b..XXXXXX,
      0b.XXXXXXX,
      0b.XXX..XX,
      0b.XXX....,
      0b.XXX..XX,
      0b.XXXXXXX,
      0b..XXXXXX,
      0b........
   ),

   // 5
   LOGO_FONT_GLYPH(
      0b........,
