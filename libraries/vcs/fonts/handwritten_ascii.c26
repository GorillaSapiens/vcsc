      0b..X.....,
      0b..X.....,
      0b.X...X..,
      0b.X...X..,
      0b..XXX...
   ),

   // 0x75 u
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..X...X.,
      0b..X..X..,
      0b..X..X..,
      0b.X..XX..,
      0b.X..XX..,
      0b..XX.X..
   ),

   // 0x76 v
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..X...X.,
      0b.X...X..,
      0b.X...X..,
      0b.X.X....,
      0b.X.X....,
      0b..XX....
   ),

   // 0x77 w
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..X...X.,
      0b..XXXX..,
      0b..XXXX..,
      0b.XXX.X..,
      0b.XXX....,
      0b..X.X...
   ),

   // 0x78 x
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..X...X.,
      0b..X..X..,
      0b...XX...,
      0b..X.X...,
      0b..X.X...,
      0b.X...X..
   ),

   // 0x79 y
   VCS_FONT_GLYPH(
      0b........,
      0b..X...X.,
      0b..X...X.,
      0b.X...X..,
      0b..XXXX..,
      0b....X...,
      0b....X...,
      0b.XXX....
   ),

   // 0x7A z
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b...XXXX.,
      0b.....X..,
      0b...XX...,
      0b..X.....,
      0b..X.....,
      0b.XXXXX..
   ),

   // 0x7B {
   VCS_FONT_GLYPH(
      0b......X.,
      0b...XX...,
      0b...XX...,
      0b.X......,
      0b..XX....,
      0b.XX.....,
      0b.XX.....,
      0b...XX...
   ),

   // 0x7C |
   VCS_FONT_GLYPH(
      0b.....XX.,
      0b....XX..,
      0b....XX..,
      0b...XX...,
      0b...XX...,
      0b..XX....,
      0b..XX....,
      0b..XX....
   ),

   // 0x7D }
   VCS_FONT_GLYPH(
      0b....XX..,
      0b.....XX.,
      0b.....XX.,
      0b......X.,
      0b....XX..,
      0b...XX...,
      0b...XX...,
      0b.XX.....
   ),

   // 0x7E ~
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b...XXX..,
      0b.X...XX.,
      0b...XXX..,
      0b........,
      0b........,
      0b........
   )

};
