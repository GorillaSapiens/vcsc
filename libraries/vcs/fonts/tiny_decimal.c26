// Tiny decimal font.
//
// The original legacy glyph data was released under CC0-1.0. See
// libraries/vcs/fonts/README.md and the retained upstream LICENSE.txt.
// Glyph rows are written top-to-bottom for visual readability; the
// VCS_FONT_GLYPH alias reverses each glyph for the score renderer.

alias VCS_FONT_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

page const uint8_t score_font[80] := {
   // 0
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXX...,
      0b..X.X...,
      0b..X.X...,
      0b..X.X...,
      0b..XXX...,
      0b........
   ),

   // 1
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b...X....,
      0b...X....,
      0b...X....,
      0b...X....,
      0b...X....,
      0b........
   ),

   // 2
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXX...,
      0b....X...,
      0b..XXX...,
      0b..X.....,
      0b..XXX...,
      0b........
   ),

   // 3
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXX...,
      0b....X...,
      0b..XXX...,
      0b....X...,
      0b..XXX...,
      0b........
   ),

   // 4
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..X.X...,
      0b..X.X...,
      0b..XXX...,
      0b....X...,
      0b....X...,
      0b........
   ),

   // 5
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXX...,
      0b..X.....,
      0b..XXX...,
      0b....X...,
      0b..XXX...,
      0b........
   ),

   // 6
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXX...,
      0b..X.....,
      0b..XXX...,
      0b..X.X...,
      0b..XXX...,
      0b........
   ),

   // 7
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXX...,
      0b....X...,
      0b....X...,
      0b....X...,
      0b....X...,
      0b........
   ),

   // 8
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXX...,
      0b..X.X...,
      0b..XXX...,
      0b..X.X...,
      0b..XXX...,
      0b........
   ),

   // 9
   VCS_FONT_GLYPH(
      0b........,
      0b........,
      0b..XXX...,
      0b..X.X...,
      0b..XXX...,
      0b....X...,
      0b....X...,
      0b........
   )

};
