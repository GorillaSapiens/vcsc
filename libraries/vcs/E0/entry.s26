;
; E0 keeps bank 7 permanently visible at $1C00-$1FFF, including RESET and
; this vector bridge.  Real hardware normally powers up as [4,5,6,7], but
; Stella developer mode can deliberately randomize the three switchable
; segments.  Normalize them before the ordinary runtime sees any banked ROM.
;
; op0C is the raw NMOS 6502/6507 absolute-NOP opcode.  Each addressed read
; selects one E0 segment without changing registers or flags.

.segmentdef "CODE", $6000, $0010
.segment "CODE"
.export __vcsc_mapper_entry_begin
.export __vcsc_mapper_entry_end

__vcsc_mapper_entry_begin:
    op0C $1FE4        ; segment 0 -> bank 4
    op0C $1FED        ; segment 1 -> bank 5
    op0C $1FF6        ; segment 2 -> bank 6
__vcsc_mapper_entry_end:
