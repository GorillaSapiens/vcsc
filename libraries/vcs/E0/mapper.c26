include "vcs.c26"

// Parker Brothers E0 physically contains eight 1K ROM banks.  The hardware can
// independently map banks 0..7 into each of three 1K windows, but VCSC does not
// expose that 9-bit/512-state flexibility to compiled code.  Absolute JSR/JMP
// and data operands require stable addresses, so the automatic-call ABI uses
// exactly three relocation-safe states:
//
//   state 0: [0,1,6,7]
//   state 1: [2,3,6,7]
//   state 2: [4,5,6,7]   (hardware power-on state)
//
// Banks 0/2/4 are always linked at $1000, banks 1/3/5 at $1400, bank 6 at
// $1800, and fixed bank 7 at $1C00.  A cross-state call switches the first two
// windows together.  Banks 6/7 use descriptor $FF, meaning "resident; preserve
// the current pair state".  One RIOT RAM byte tracks only this three-state ABI
// so nested calls made by resident code can restore the correct pair.  Manual
// E0 selector accesses are outside the automatic-call contract unless they also
// restore a canonical state and synchronize this internal byte.
cartridge {
   $bankcall
   $fill:0xff $signature:E0
   $vector_bridge_offset:0x0360 $vector_bridge_size:0x0009
   $trampoline_offset:0x0370 $trampoline_size:0x0070
   $vectors_offset:0x03fa $vectors_size:0x0006
};

bank bank0 { $image_size:0x0400 $file_index:0 $image_offset:0 $link_start:0x1000 $cpu_start:0x1000 $map_size:0x0400 $bankcall_descriptor:0x00 };
bank bank1 { $image_size:0x0400 $file_index:1 $image_offset:0 $link_start:0x1400 $cpu_start:0x1400 $map_size:0x0400 $bankcall_descriptor:0x00 };
bank bank2 { $image_size:0x0400 $file_index:2 $image_offset:0 $link_start:0x1000 $cpu_start:0x1000 $map_size:0x0400 $bankcall_descriptor:0x01 };
bank bank3 { $image_size:0x0400 $file_index:3 $image_offset:0 $link_start:0x1400 $cpu_start:0x1400 $map_size:0x0400 $bankcall_descriptor:0x01 };
bank bank4 { $image_size:0x0400 $file_index:4 $image_offset:0 $link_start:0x1000 $cpu_start:0x1000 $map_size:0x0400 $bankcall_descriptor:0x02 };
bank bank5 { $image_size:0x0400 $file_index:5 $image_offset:0 $link_start:0x1400 $cpu_start:0x1400 $map_size:0x0400 $bankcall_descriptor:0x02 };
bank bank6 { $image_size:0x0400 $file_index:6 $image_offset:0 $link_start:0x1800 $cpu_start:0x1800 $map_size:0x0400 $bankcall_descriptor:0xff };
bank bank7 { $image_size:0x0400 $file_index:7 $image_offset:0 $link_start:0x1c00 $cpu_start:0x1c00 $map_size:0x0400 $bankcall_descriptor:0xff $startup };

// Leave the replicated vector bridge and bankcall block out of ordinary ROM
// allocation.  The $1FE0-$1FF7 selectors, signature, and vectors naturally lie
// beyond bank7's allocatable prefix as well.
mem bank0 { $start:0x1000 $size:0x0360 $ro $bank:bank0 };
mem bank1 { $start:0x1400 $size:0x0360 $ro $bank:bank1 };
mem bank2 { $start:0x1000 $size:0x0360 $ro $bank:bank2 };
mem bank3 { $start:0x1400 $size:0x0360 $ro $bank:bank3 };
mem bank4 { $start:0x1000 $size:0x0360 $ro $bank:bank4 };
mem bank5 { $start:0x1400 $size:0x0360 $ro $bank:bank5 };
mem bank6 { $start:0x1800 $size:0x0360 $ro $bank:bank6 };
mem bank7 { $start:0x1c00 $size:0x0360 $ro $bank:bank7 $priority:2 };

// Dynamic pair-state shadow used only by E0's automatic-call trampoline.  It is
// initialized before C26 init functions run; hardware startup is state 2 too.
uint8_t _vcsc_e0_state := 2;
