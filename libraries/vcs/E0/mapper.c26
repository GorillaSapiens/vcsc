include "vcs.c26"

// Parker Brothers E0: eight physical 1K ROM chunks.  Hardware exposes three
// independently selectable 1K windows at $1000/$1400/$1800 and fixes physical
// bank 7 at $1C00-$1FFF.  Selectors $1FE0-$1FE7, $1FE8-$1FEF, and
// $1FF0-$1FF7 choose the physical bank for windows 0, 1, and 2 respectively.
// Power-on maps physical banks 4,5,6,7.
//
// C26 needs one canonical compile address per physical bank even though E0 can
// map a switchable bank into any of the first three windows.  Each synthetic
// link address below is a 6507 mirror alias of the CPU window used by source
// placed in that bank.  The fixed bank is the startup/home bank.
cartridge {
   $fill:0xff $signature:E0
};

bank bank0 { $image_size:0x0400 $file_index:0 $image_offset:0 $link_start:0x1000 $cpu_start:0x1000 $map_size:0x0400 };
bank bank1 { $image_size:0x0400 $file_index:1 $image_offset:0 $link_start:0x3400 $cpu_start:0x1400 $map_size:0x0400 };
bank bank2 { $image_size:0x0400 $file_index:2 $image_offset:0 $link_start:0x5800 $cpu_start:0x1800 $map_size:0x0400 };
bank bank3 { $image_size:0x0400 $file_index:3 $image_offset:0 $link_start:0x7000 $cpu_start:0x1000 $map_size:0x0400 };
bank bank4 { $image_size:0x0400 $file_index:4 $image_offset:0 $link_start:0x9000 $cpu_start:0x1000 $map_size:0x0400 };
bank bank5 { $image_size:0x0400 $file_index:5 $image_offset:0 $link_start:0xb400 $cpu_start:0x1400 $map_size:0x0400 };
bank bank6 { $image_size:0x0400 $file_index:6 $image_offset:0 $link_start:0xd800 $cpu_start:0x1800 $map_size:0x0400 };
bank bank7 { $image_size:0x0400 $file_index:7 $image_offset:0 $link_start:0xfc00 $cpu_start:0x1c00 $map_size:0x0400 $startup };

mem bank0 { $start:0x1000 $size:0x0400 $ro };
mem bank1 { $start:0x3400 $size:0x0400 $ro };
mem bank2 { $start:0x5800 $size:0x0400 $ro };
mem bank3 { $start:0x7000 $size:0x0400 $ro };
mem bank4 { $start:0x9000 $size:0x0400 $ro };
mem bank5 { $start:0xb400 $size:0x0400 $ro };
mem bank6 { $start:0xd800 $size:0x0400 $ro };
// $FFE0-$FFF7 are E0 selectors, $FFF8-$FFFB hold the profile signature, and
// RESET/IRQ vectors occupy $FFFC-$FFFF.  Keep that whole tail nonallocatable.
mem bank7 { $start:0xfc00 $size:0x03e0 $ro $priority:2 };
