include "vcs.c26"
include "dpc.c26"

// Atari DPC cartridge profile.  The first two 4K image chunks are the normal
// F8 program banks.  They expose only $1080-$1FFF because the DPC register
// window occupies $1000-$107F.  The final 2K and 255-byte chunks are data-only
// image regions: DPC display ROM and the conventional RNG/poly sequence tail.
cartridge {
#ifdef VCSC_INLINE_BANKCALL
   $inline_bankcall
#endif
   $fill:0xff $signature:DPC
   $trampoline_offset:0x0f00 $trampoline_size:0x00e0
   $vector_bridge_offset:0x0fe0 $vector_bridge_size:0x0012
   $vectors_offset:0x0ffa $vectors_size:0x0006
};

bank bank0 {
   $image_size:0x1000 $file_index:1 $image_offset:0x0080
   $link_start:0xf080 $cpu_start:0xf080 $map_size:0x0f80
   $select_access:0x1ff9 $startup
};

bank bank1 {
   $image_size:0x1000 $file_index:0 $image_offset:0x0080
   $link_start:0xd080 $cpu_start:0xf080 $map_size:0x0f80
   $select_access:0x1ff8
};

bank bank2 { $image_size:0x0800 $file_index:2 $data_only };
bank bank3 { $image_size:0x00ff $file_index:3 $data_only };

mem bank0 { $start:0xf080 $size:0x0e80 $ro $priority:2 };
mem bank1 { $start:0xd080 $size:0x0e80 $ro };
mem bank2 { $size:0x0800 $ro $data_bank:bank2 };
mem bank3 { $size:0x00ff $ro $data_bank:bank3 };
