;
; Descriptor-ABI cross-bank JSR/RTS trampoline for F8/F6/F4-style selectors.
;
; The caller emits JSR __bankcall followed by a three-byte .banktarget payload:
; 16-bit target address, then the destination bank-call descriptor.  For this
; family the descriptor is the low byte of the selector hotspot, so selecting a
; bank is simply an indexed read from $1F00.  Each replicated trampoline copy
; has its source-bank descriptor patched into the immediate operand below.

.ifndef VCSC_BANKCALL_PTR0
VCSC_BANKCALL_PTR0 = $0080
.endif
.ifndef VCSC_BANKCALL_SELECTOR_BASE
VCSC_BANKCALL_SELECTOR_BASE = $1F00
.endif
.ifndef VCSC_BANKCALL_SOURCE_DESCRIPTOR
VCSC_BANKCALL_SOURCE_DESCRIPTOR = $F9
.endif

; TEMPLATE ASSEMBLY ORIGIN ONLY.
; $6000 is never executed or presented to the 6507 bus. The template is
; assembled at this synthetic non-zero-page origin so internal absolute
; references cannot relax to zero-page encodings; the linker copies the bytes
; into the mapper's real replicated trampoline corridor and patches the
; relocatable absolute operand(s) to their runtime addresses.
.segmentdef "CODE", $6000, $0100
.segment "CODE"

.export __vcsc_generic_bankcall_begin
.export __vcsc_generic_bankreturn
.export __vcsc_generic_bankcall_switch_and_jump
.export __vcsc_generic_bankcall_end
.export __vcsc_generic_bankcall_reserved_end

__vcsc_generic_bankcall_begin:
    ; JSR stacked the address of its final operand byte.  Keep that logical PC
    ; in ptr0 while all three inline payload bytes are still visible.
    tsx
    lda $0101,x
    sta VCSC_BANKCALL_PTR0
    lda $0102,x
    sta VCSC_BANKCALL_PTR0 + 1

    ; Final RTS must skip target-low, target-high, and destination descriptor.
    lda $0101,x
    clc
    adc #3
    sta $0101,x
    bcc.same @return_adjusted
    inc $0102,x
@return_adjusted:

    ; Read the complete payload before leaving the source bank.  X is free once
    ; the real return PC has been adjusted, so keep target-low there and use
    ; only one temporary stack byte for target-high.  Y retains the destination
    ; descriptor through the bank switch.
    ldy #1
    lda (VCSC_BANKCALL_PTR0),y
    tax
    iny
    lda (VCSC_BANKCALL_PTR0),y
    pha
    iny
    lda (VCSC_BANKCALL_PTR0),y
    tay
    pla
    sta VCSC_BANKCALL_PTR0 + 1
    stx VCSC_BANKCALL_PTR0

    ; This byte is patched independently in each bank copy.  It is call-frame
    ; metadata, not something inferred from the caller PC.
    lda #VCSC_BANKCALL_SOURCE_DESCRIPTOR
    pha

    ; JSR creates the synthetic return consumed by the remote callee's RTS.
    jsr __vcsc_generic_bankcall_switch_and_jump

__vcsc_generic_bankreturn:
    ; The callee's A:X return value is live.  Save it in ptr0, consume the source
    ; descriptor directly from the stack, restore that bank, then restore A:X.
    sta VCSC_BANKCALL_PTR0
    stx VCSC_BANKCALL_PTR0 + 1
    pla
    tay
    lda VCSC_BANKCALL_SELECTOR_BASE,y
    lda VCSC_BANKCALL_PTR0
    ldx VCSC_BANKCALL_PTR0 + 1
    rts

__vcsc_generic_bankcall_switch_and_jump:
    lda VCSC_BANKCALL_SELECTOR_BASE,y
    jmp (VCSC_BANKCALL_PTR0)

__vcsc_generic_bankcall_end:
__vcsc_generic_bankcall_reserved_end = $6048
