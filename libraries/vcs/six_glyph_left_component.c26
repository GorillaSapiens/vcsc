// Reusable left-justified six-glyph TIA display component.
//
// Instantiate this source with:
//
//     instantiate "six_glyph_left_component.c26" as score1
//
// Include one fonts/*_decimal.c26 or fonts/*_hex.c26 module first; it
// must define the shared page-contained score_font table.  Each instance owns
// its score, color, five 16-bit glyph pointers, one page-contained-font glyph offset, and delayed glyph byte.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear. It consumes glyph_rows+3 scanlines and returns at cycle zero
// of the following line. Use vcs_ntsc_component_handoff() before an adjacent
// visible component. It owns P0/P1 graphics, colors, reflection, VDEL, NUSIZ,
// horizontal motion, and RESP0/RESP1 while drawing. It may leave all of that
// P0/P1 state clobbered.
// It preserves playfield, missile, and Ball state, flushes GRP0/GRP1, and
// disables player VDEL before returning. It never touches VSYNC, VBLANK, the RIOT timer, or collision
// latches.  A/X/Y and arithmetic flags are clobbered; hardware stack depth is
// unchanged at lifecycle boundaries.

// Normal score use keeps compact page-contained-font storage. Set this to
// zero only for applications that deliberately replace all six glyph pointers
// with another page-contained glyph table (the fingerprint logo does this).
parameter compact_font := 1;
// Number of stored and rendered rows per glyph. Default score fonts use eight;
// shorter fonts are tightly packed and automatically use the full-pointer path.
parameter glyph_rows := 8;

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
#if TEMPLATE_glyph_rows == 1
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 4
#elif TEMPLATE_glyph_rows == 2
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 5
#elif TEMPLATE_glyph_rows == 3
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 6
#elif TEMPLATE_glyph_rows == 4
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 7
#elif TEMPLATE_glyph_rows == 5
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 8
#elif TEMPLATE_glyph_rows == 6
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 9
#elif TEMPLATE_glyph_rows == 7
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 10
#elif TEMPLATE_glyph_rows == 8
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 11
#else
extern const uint8_t TEMPLATE_glyph_rows_must_be_1_through_8[TEMPLATE_glyph_rows];
#endif

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := TEMPLATE_VISIBLE_SCANLINES_VALUE,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := TEMPLATE_VISIBLE_SCANLINES_VALUE,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 260,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0
};

#if TEMPLATE_compact_font && TEMPLATE_glyph_rows == 8
recommend bcd24_t TEMPLATE_score := 0;
recommend uint8_t TEMPLATE_color := 0x0e;
// Digits 1..5 retain complete pointers because the left-edge prefetch reaches
// its first WSYNC with no spare cycles. Digit 6 is fetched after WSYNC and can
// use a one-byte page-contained font offset (digit*8).
uint16_t TEMPLATE_pointers[5];
uint8_t TEMPLATE_offset6;
uint8_t TEMPLATE_delayed;

#else
recommend bcd24_t TEMPLATE_score := 0;
recommend uint8_t TEMPLATE_color := 0x0e;
uint16_t TEMPLATE_pointers[6];
uint8_t TEMPLATE_delayed;

#endif

#if TEMPLATE_glyph_rows != 8
// Non-native-height score fonts are tightly packed: digit N starts at
// N*glyph_rows. Native-height instantiations omit this table and retain their
// established pointer-generation code byte-for-byte.
const uint8_t TEMPLATE_glyph_offsets[10] := {
   0,
   TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows
};
#endif

static inline void TEMPLATE_prepare_pointers(void) {
#if TEMPLATE_compact_font && TEMPLATE_glyph_rows == 8

   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;

   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+9;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm sta TEMPLATE_offset6;
#else

   // Build six complete 16-bit pointers in human digit order. Packed BCD is
   // little-endian, so score+2 supplies digits 1/2 and score supplies 5/6.
   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
#if TEMPLATE_glyph_rows == 8
   asm lsr;
#else
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
#if TEMPLATE_glyph_rows == 8
   asm lsr;
#else
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;

   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
#if TEMPLATE_glyph_rows == 8
   asm lsr;
#else
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+9;
   asm txa;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+11;
#endif
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_draw(void) {

   // Position P0 at x=0 and P1 at x=8. These calibrated fine-motion values
   // compensate for the early consecutive RESP strobes and HMOVE phase.
   asm lda #$03;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm nop;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
   asm lda.z TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta HMCLR;
   asm lda #$30;
   asm sta HMP0;
   asm lda #$b0;
   asm sta HMP1;
   asm sta WSYNC;

   // Apply motion, clear both player pipelines, enable VDEL, and use the rest
   // of the setup scanline to prepare the first five glyph bytes. The eight
   // visible rows below are deliberately unrolled: each row ends by preparing
   // the next one, which is what makes an x=0 six-glyph schedule fit.
   asm sta HMOVE;
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta GRP0;
   // Preserve the former eight-cycle color reload while clearing reflection.
   asm sta REFP0;
   asm sta REFP1;
   asm nop;
   asm lda #1;
   asm sta VDELP0;
   asm sta VDELP1;
#if TEMPLATE_glyph_rows == 1
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 2
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 3
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #4;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #5;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #6;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #7;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
   asm sta WSYNC;

#if TEMPLATE_compact_font && TEMPLATE_glyph_rows == 8

   // Glyph row 1: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm ldy TEMPLATE_offset6;
   asm lda score_font+7,y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Fill the rest of this scanline by preparing row 2.
   asm ldy #6;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;

   // Glyph row 2: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm ldy TEMPLATE_offset6;
   asm lda score_font+6,y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Fill the rest of this scanline by preparing row 3.
   asm ldy #5;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;

   // Glyph row 3: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm ldy TEMPLATE_offset6;
   asm lda score_font+5,y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Fill the rest of this scanline by preparing row 4.
   asm ldy #4;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;

   // Glyph row 4: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm ldy TEMPLATE_offset6;
   asm lda score_font+4,y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Fill the rest of this scanline by preparing row 5.
   asm ldy #3;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;

   // Glyph row 5: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm ldy TEMPLATE_offset6;
   asm lda score_font+3,y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Fill the rest of this scanline by preparing row 6.
   asm ldy #2;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;

   // Glyph row 6: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm ldy TEMPLATE_offset6;
   asm lda score_font+2,y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Fill the rest of this scanline by preparing row 7.
   asm ldy #1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;

   // Glyph row 7: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm ldy TEMPLATE_offset6;
   asm lda score_font+1,y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Fill the rest of this scanline by preparing row 8.
   asm ldy #0;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;

   // Glyph row 8: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm ldy TEMPLATE_offset6;
   asm lda score_font+0,y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   asm sta WSYNC;
#else

   // Glyph row 1: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#if TEMPLATE_glyph_rows > 1
   // Fill the rest of this scanline by preparing row 2.
#if TEMPLATE_glyph_rows == 2
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 3
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #4;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #5;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #6;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
#else
   asm sta WSYNC;
#endif

#if TEMPLATE_glyph_rows >= 2
// Glyph row 2: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#if TEMPLATE_glyph_rows > 2
   // Fill the rest of this scanline by preparing row 3.
#if TEMPLATE_glyph_rows == 3
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #4;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #5;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
#else
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 3
// Glyph row 3: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#if TEMPLATE_glyph_rows > 3
   // Fill the rest of this scanline by preparing row 4.
#if TEMPLATE_glyph_rows == 4
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #4;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
#else
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 4
// Glyph row 4: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#if TEMPLATE_glyph_rows > 4
   // Fill the rest of this scanline by preparing row 5.
#if TEMPLATE_glyph_rows == 5
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #3;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
#else
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 5
// Glyph row 5: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#if TEMPLATE_glyph_rows > 5
   // Fill the rest of this scanline by preparing row 6.
#if TEMPLATE_glyph_rows == 6
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #2;
#endif
   asm lda (TEMPLATE_pointers),y;
