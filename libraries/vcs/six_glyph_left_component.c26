   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
#else
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 6
// Glyph row 6: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#if TEMPLATE_glyph_rows > 6
   // Fill the rest of this scanline by preparing row 7.
#if TEMPLATE_glyph_rows == 7
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #1;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
#else
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 7
// Glyph row 7: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#if TEMPLATE_glyph_rows > 7
   // Fill the rest of this scanline by preparing row 8.
#if TEMPLATE_glyph_rows == 8
   asm ldy #0;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
#else
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 8
// Glyph row 8: TIA write events land at CPU cycles 18, 21, 24, and 27.
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   asm sta WSYNC;
