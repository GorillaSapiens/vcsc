include "vcs.c26"

// UASW is the UA Limited 8K hardware with the selector-to-bank association
// reversed for images whose two 4K banks were dumped in swapped order.  Physical
// bank 0 still powers up, but family $0240 selects bank 0 and family $0220
// selects bank 1.  The same UA alias mask applies: (A & $1260) is $0220 or
// $0240.  Generated selector stubs use read-only NMOS absolute NOP accesses.
cartridge {
   $fill:0xff $signature:UASW
   $trampoline_offset:0x0f00 $trampoline_size:0x00e0
   $vector_bridge_offset:0x0fe0 $vector_bridge_size:0x0012
   $vectors_offset:0x0ffa $vectors_size:0x0006
};

bank bank0 {
   $image_size:0x1000 $file_index:0 $image_offset:0x0000
   $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000
   $select_access:0x0240 $startup
};

bank bank1 {
   $image_size:0x1000 $file_index:1 $image_offset:0x0000
   $link_start:0xd000 $cpu_start:0xf000 $map_size:0x1000
   $select_access:0x0220
};

mem bank0 { $start:0xf000 $size:0x0f00 $ro $priority:2 };
mem bank1 { $start:0xd000 $size:0x0f00 $ro };
