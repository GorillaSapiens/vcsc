include "vcs.c26"

// UA Limited 8K bankswitching: two full-window 4K ROM banks.  Physical bank 0
// powers up.  Below-cartridge selector family $0220 chooses bank 0 and family
// $0240 chooses bank 1.  Hardware aliases ignore A11, A10, A8, A7 and A4-A0;
// equivalently, (A & $1260) is $0220 or $0240.  Because selector accesses
// overlay console devices, generated selector stubs use state-preserving NMOS
// absolute NOP reads rather than writes.
cartridge {
#ifdef VCSC_INLINE_BANKCALL
   $inline_bankcall
#endif
   $fill:0xff $signature:UA
   $trampoline_offset:0x0f00 $trampoline_size:0x00e0
   $vector_bridge_offset:0x0fe0 $vector_bridge_size:0x0012
   $vectors_offset:0x0ffa $vectors_size:0x0006
};

bank bank0 {
   $image_size:0x1000 $file_index:0 $image_offset:0x0000
   $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000
   $select_access:0x0220 $startup
};

bank bank1 {
   $image_size:0x1000 $file_index:1 $image_offset:0x0000
   $link_start:0xd000 $cpu_start:0xf000 $map_size:0x1000
   $select_access:0x0240
};

mem bank0 { $start:0xf000 $size:0x0f00 $ro $priority:2 };
mem bank1 { $start:0xd000 $size:0x0f00 $ro };
