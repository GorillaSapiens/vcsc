// Stella 7.0 3EX RAM is an independent 8-bit-selected 1K-page pool.  It is not part of
// the ROM bankcall descriptor state; compiler-managed accesses trampoline to
// fixed/startup ROM and use libraries/vcs/3EX/swapram.s26.
mem swapram { $size:0x40000 $bank_size:0x0400 $rw $swapram };
