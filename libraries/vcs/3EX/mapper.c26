// Stella 7.0 Tigervision 3EX.  VCS_3EX_BANKS is the number of physical 2K ROM
// chunks, 3..256.  Every chunk except the last is selectable in the lower
// $1000-$17FF window; the final chunk is permanently mapped at $1800-$1FFF
// and owns startup/vectors.  Physical-bank identity is separate from the
// 16-bit CPU/link address, so all selectable banks deliberately use the same
// canonical $1000 link address.
//
// This intentionally uses one large, explicit #if/#elif ladder.  For bank N,
// VCS_3EX_BANKS > N+1 makes it selectable; VCS_3EX_BANKS == N+1 makes that
// same bankN the fixed final/startup chunk.  Literal names and file indexes
// keep the topology easy to audit and avoid generated include-file confetti.

parameter VCS_3EX_BANKS;

// 3EX claims the low TIA page for mapper writes; use the equivalent
// $40-$7F TIA mirror for ordinary TIA register accesses.
alias VCS_TIA_USE_40_MIRROR 1
include "vcs.c26"

cartridge {
   $bankcall
   $fill:0xff $signature:3EX
   $trampoline_offset:0x0780 $trampoline_size:0x0058
   $vector_bridge_offset:0x07e0 $vector_bridge_size:0x0012
   $vectors_offset:0x07fa $vectors_size:0x0006
};

#if VCS_3EX_BANKS > 1
bank bank0 { $image_size:0x0800 $file_index:0 $image_offset:0 $link_start:0x1000 $cpu_start:0x1000 $map_size:0x0800 $bankcall_descriptor:0x00 };
mem bank0 { $start:0x1000 $size:0x0780 $ro $bank:bank0 };
#elif VCS_3EX_BANKS == 1
bank bank0 { $image_size:0x0800 $file_index:0 $image_offset:0 $link_start:0x1800 $cpu_start:0x1800 $map_size:0x0800 $startup $bankcall_descriptor:0xff };
mem bank0 { $start:0x1800 $size:0x0780 $ro $priority:2 $bank:bank0 };
#endif

#if VCS_3EX_BANKS > 2
bank bank1 { $image_size:0x0800 $file_index:1 $image_offset:0 $link_start:0x1000 $cpu_start:0x1000 $map_size:0x0800 $bankcall_descriptor:0x01 };
mem bank1 { $start:0x1000 $size:0x0780 $ro $bank:bank1 };
#elif VCS_3EX_BANKS == 2
bank bank1 { $image_size:0x0800 $file_index:1 $image_offset:0 $link_start:0x1800 $cpu_start:0x1800 $map_size:0x0800 $startup $bankcall_descriptor:0xff };
mem bank1 { $start:0x1800 $size:0x0780 $ro $priority:2 $bank:bank1 };
#endif

