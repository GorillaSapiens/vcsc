;
; Descriptor-ABI cross-bank JSR/RTS trampoline for Tigervision 3EX.
;
; Selectable lower-window banks use descriptors $00-$FE, equal to the value
; written to TIA $3F.  The permanently visible final 2K bank uses descriptor
; $FF as a sentinel meaning "do not change the lower window".  Every call that
; crosses between differently placed 3E code regions goes through this block:
;
;   lower A -> lower B : select B, call, restore A before returning
;   lower A -> fixed   : call fixed without switching, restore A on return
;   fixed   -> lower B : select B, call, return to fixed without restoration
;
; This is what makes nested lower->fixed->lower calls safe without a software
; shadow of the currently selected lower bank.

.ifndef VCSC_BANKCALL_PTR0
VCSC_BANKCALL_PTR0 = $0080
.endif
.ifndef VCSC_BANKCALL_SOURCE_DESCRIPTOR
VCSC_BANKCALL_SOURCE_DESCRIPTOR = $FF
.endif

; Kept for the common template generator interface.  3EX ROM selects by writing the
; descriptor VALUE to TIA $3F, so there is no address-plus-descriptor base.
.ifndef VCSC_BANKCALL_SELECTOR_BASE
VCSC_BANKCALL_SELECTOR_BASE = $0000
.endif

; TEMPLATE ASSEMBLY ORIGIN ONLY.
; $6000 is never executed or presented to the 6507 bus. The template is
; assembled at this synthetic non-zero-page origin so internal absolute
; references cannot relax to zero-page encodings; the linker copies the bytes
; into each physical bank's real trampoline corridor and patches the internal
; JSR to the permanently visible fixed-bank switch helper.
.segmentdef "CODE", $6000, $0100
.segment "CODE"

.export __vcsc_generic_bankcall_begin
.export __vcsc_generic_bankreturn
.export __vcsc_generic_bankcall_switch_and_jump
.export __vcsc_generic_bankcall_end
.export __vcsc_generic_bankcall_reserved_end

__vcsc_generic_bankcall_begin:
    ; JSR stacked the address of its final operand byte. Keep that logical PC
    ; in ptr0 while all three inline payload bytes are still visible.
    tsx
    lda $0101,x
    sta VCSC_BANKCALL_PTR0
    lda $0102,x
    sta VCSC_BANKCALL_PTR0 + 1

    ; Final RTS must skip target-low, target-high, and destination descriptor.
    lda $0101,x
    clc
    adc #3
    sta $0101,x
    bcc.same @return_adjusted
    inc $0102,x
@return_adjusted:

    ; Read the complete payload before any lower-window change.
    ldy #3
    lda (VCSC_BANKCALL_PTR0),y
    tax                         ; destination descriptor
    dey
    lda (VCSC_BANKCALL_PTR0),y
    pha
    dey
    lda (VCSC_BANKCALL_PTR0),y
    sta VCSC_BANKCALL_PTR0
    pla
    sta VCSC_BANKCALL_PTR0 + 1

    ; Source descriptor is baked independently in each physical bank copy.
    ; $FF denotes the fixed bank and therefore means no lower-bank restoration.
    lda #VCSC_BANKCALL_SOURCE_DESCRIPTOR
    pha

    ; The linker patches this JSR to the switch helper in the permanently
    ; visible fixed-bank copy.  For a lower caller the numeric return address
    ; lands in the identical bankreturn bytes of the selected destination bank.
    jsr __vcsc_generic_bankcall_switch_and_jump

__vcsc_generic_bankreturn:
    ; Preserve A:X return value around optional restoration of the source lower
    ; bank.  Returning to fixed code ($FF source) needs no lower-window change.
    sta VCSC_BANKCALL_PTR0
    stx VCSC_BANKCALL_PTR0 + 1
    pla
    tax
    cpx #$FF
    beq.same @source_fixed
    stx $3F
@source_fixed:
    lda VCSC_BANKCALL_PTR0
    ldx VCSC_BANKCALL_PTR0 + 1
    rts

__vcsc_generic_bankcall_switch_and_jump:
    ; This helper itself is always the fixed-bank copy.  The JSR that reached
    ; it was emitted by a replicated trampoline, so its stacked return points
    ; at that source copy's bankreturn: $17xx for a lower source or $1Fxx for
    ; the fixed source.  Force bit 3 of the stacked high byte so every callee
    ; returns through the permanently visible fixed-bank bankreturn.  This is
    ; essential when a fixed callee temporarily maps 3EX RAM over $1000-$17FF.
    ; X still carries the destination descriptor.  Preserve it in Y while
    ; TSX borrows X to index the hardware stack, then restore it before the
    ; mapper select.  Y is dead after the inline payload has been decoded.
    txa
    tay
    tsx
    lda $0102,x
    ora #$08
    sta $0102,x
    tya
    tax

    ; $FF destination means the callee is in the fixed upper 2K and no mapper
    ; operation is required.  Otherwise write the selected lower-bank number.
    cpx #$FF
    beq.same @destination_fixed
    stx $3F
@destination_fixed:
    jmp (VCSC_BANKCALL_PTR0)

; Stella 7.0 detects 3EX by finding at least two ASCII "3EX" strings
; anywhere in the ROM.  Keep both copies in unreachable trampoline data;
; do not entangle mapper detection with reset-entry executable code.
__vcsc_3ex_detector_markers:
    .byte $33, $45, $58, $33, $45, $58

__vcsc_generic_bankcall_end:
__vcsc_generic_bankcall_reserved_end = $6060
