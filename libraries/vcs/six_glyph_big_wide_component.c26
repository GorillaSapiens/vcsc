// Reusable widely spaced six-glyph TIA display component for 8x16 glyphs.
//
// Instantiate this source with:
//
//     instantiate "six_glyph_big_wide_component.c26" as score1
//
// Include fonts/big_decimal.c26 or fonts/big_hex.c26 first. The font must
// define the shared 256-aligned, page-contained score_font table with sixteen
// bytes per glyph. Each instance owns its packed score, six 16-bit glyph
// pointers, one row counter, one delayed glyph byte, and one mutable color.
//
// The 8-pixel glyph origins are X=36,52,68,84,100,116: 16-pixel pitch with
// one glyph-width of blank space between adjacent glyphs, spanning X=36..123.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear. It consumes exactly nineteen scanlines and returns at cycle
// zero of the following line. Use vcs_ntsc_component_handoff() before an
// adjacent visible component. It owns P0/P1 graphics, colors, reflection,
// VDEL, NUSIZ, horizontal motion, and RESP0/RESP1 while drawing. It preserves
// playfield, missile, and Ball state, flushes GRP0/GRP1, and disables player
// VDEL before returning. It never touches VSYNC, VBLANK, the RIOT timer, or
// collision latches. A/X/Y and arithmetic flags are clobbered; hardware stack
// depth is unchanged at lifecycle boundaries.

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 19,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 19,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 260,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0,
   TEMPLATE_GLYPH_ORIGIN_0 := 36,
   TEMPLATE_GLYPH_ORIGIN_1 := 52,
   TEMPLATE_GLYPH_ORIGIN_2 := 68,
   TEMPLATE_GLYPH_ORIGIN_3 := 84,
   TEMPLATE_GLYPH_ORIGIN_4 := 100,
   TEMPLATE_GLYPH_ORIGIN_5 := 116,
   TEMPLATE_GLYPH_WIDTH := 8,
   TEMPLATE_GLYPH_HEIGHT := 16,
   TEMPLATE_GLYPH_ORIGIN_PITCH := 16
};

recommend bcd24_t TEMPLATE_score := 0;
uint16_t TEMPLATE_pointers[6];
uint8_t TEMPLATE_row;
uint8_t TEMPLATE_delayed;
recommend uint8_t TEMPLATE_color := 0x0e;

static inline void TEMPLATE_prepare_pointers(void) {
   // Build six complete pointers in human digit order. A big glyph occupies
   // sixteen bytes, so the high packed-BCD nibble is already digit*16 and the
   // low nibble needs four shifts. big_decimal/big_hex begin on a page boundary.
   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;

   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+9;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+11;
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_draw(void) {
   // Horizontal setup is intentionally identical to the normal wide score.
   asm lda #$06;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
   asm lda TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta HMCLR;
   asm lda #$30;
   asm sta HMP0;
   asm lda #$c0;
   asm sta HMP1;
   asm sta WSYNC;

   // Apply motion, flush hostile player state, and enter the same delayed-player
   // six-glyph pipeline as the normal wide component, extended to sixteen rows.
   asm sta HMOVE;
   GRP0 := 0;
   GRP1 := 0;
   GRP0 := 0;
   asm sta REFP0;
   asm sta REFP1;
   asm nop;
   VDELP0 := 1;
   VDELP1 := 1;

   // Absolute store is intentional: this is inside cycle-counted setup.
   asm lda #15;
   asm sta.a TEMPLATE_row;

   asm @TEMPLATE_draw_loop:;
   asm ldy TEMPLATE_row;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   asm dec TEMPLATE_row;
   asm bpl.same @TEMPLATE_draw_loop;

   GRP0 := 0;
   GRP1 := 0;
   GRP0 := 0;
   VDELP0 := 0;
   VDELP1 := 0;
   WSYNC := 0;
}

require inline void TEMPLATE_overscan(void) {
}
