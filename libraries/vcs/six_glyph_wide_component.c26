// Reusable widely spaced six-glyph TIA display component.
//
// Instantiate this source with:
//
//     template "six_glyph_wide_component.c26" as score1
//
// Include one fonts/*_decimal.c26 or fonts/*_hex.c26 module first; it
// must define the shared page-contained score_font table. Each instance owns
// its score, six 16-bit glyph pointers, and prepared row caches for glyphs five
// and six.
//
// Glyph-origin contract: the six 8-pixel glyphs begin at visible X coordinates
// 36, 52, 68, 84, 100, and 116. The 16-pixel origin pitch leaves one
// glyph-width of blank space between adjacent glyphs and spans X=36..123.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear. It consumes exactly eleven scanlines and returns at cycle zero
// of the following line. Use vcs_ntsc_component_handoff() before an adjacent
// visible component. It owns P0/P1 graphics, colors, reflection, VDEL, NUSIZ,
// horizontal motion, and RESP0/RESP1 while drawing. It may leave all of that
// P0/P1 state clobbered.
// It preserves playfield, missile, and Ball state, flushes GRP0/GRP1, and
// disables player VDEL before returning. It never touches VSYNC, VBLANK, the
// RIOT timer, or collision latches. A/X/Y and arithmetic flags are clobbered;
// hardware stack depth is unchanged at lifecycle boundaries.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 11,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 11,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_GLYPH_ORIGIN_0 := 36,
   TEMPLATE_GLYPH_ORIGIN_1 := 52,
   TEMPLATE_GLYPH_ORIGIN_2 := 68,
   TEMPLATE_GLYPH_ORIGIN_3 := 84,
   TEMPLATE_GLYPH_ORIGIN_4 := 100,
   TEMPLATE_GLYPH_ORIGIN_5 := 116,
   TEMPLATE_GLYPH_WIDTH := 8,
   TEMPLATE_GLYPH_ORIGIN_PITCH := 16,
   TEMPLATE_VBLANK_MAX_CYCLES := 464,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0
};

recommend bcd24_t TEMPLATE_score := 0;
uint8_t TEMPLATE_pointers[12];
uint8_t TEMPLATE_fifth_rows[8];
uint8_t TEMPLATE_sixth_rows[8];

static inline void TEMPLATE_prepare_pointers(void) {
   // Build six complete 16-bit pointers in human digit order. Packed BCD is
   // little-endian, so score+2 supplies digits 1/2 and score supplies 5/6.
   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;

   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+9;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+11;

   // The final two glyphs must be available through three-cycle direct
   // loads inside the visible row. Glyphs one through four remain pointer-
   // driven, avoiding a needless 48-byte full-row cache.
   asm ldy #7;
   asm @TEMPLATE_cache_outer_loop:;
   asm lda (TEMPLATE_pointers+$8),y;
   asm sta.ay TEMPLATE_fifth_rows,y;
   asm lda (TEMPLATE_pointers+$a),y;
   asm sta.ay TEMPLATE_sixth_rows,y;
   asm dey;
   asm bpl.same @TEMPLATE_cache_outer_loop;
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_draw(void) {
   // Line one re-establishes an exact fixed geometry. Three medium-spaced
   // copies of each player are interleaved: P0 at 36/68/100 and P1 at
   // 52/84/116. The final glyph ends at X=123.
   asm lda #$06;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
   asm lda #$0e;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta HMCLR;
   asm lda #$30;
   asm sta HMP0;
   asm lda #$c0;
   asm sta HMP1;
   asm sta WSYNC;

   // Line two applies motion, clears player state, and disables VDEL.
   asm sta HMOVE;
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta REFP0;
   asm sta REFP1;
   asm sta VDELP0;
   asm sta VDELP1;
   asm ldy #7;
   asm sta WSYNC;

   // Glyph row 1: GRP0/GRP1 writes land at cycles 0, 8, 31, 36,
   // 42, and 48. Those windows fall between consecutive medium-spaced
   // copies of each player.
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm nop;
   asm nop;
   asm nop;
   asm stx GRP0;
   asm nop;
   asm sty GRP1;
   asm lda.z TEMPLATE_fifth_rows+7;
   asm sta GRP0;
   asm lda.z TEMPLATE_sixth_rows+7;
   asm sta GRP1;
   asm ldy #6;
   asm sta WSYNC;

   // Glyph row 2: GRP0/GRP1 writes land at cycles 0, 8, 31, 36,
   // 42, and 48. Those windows fall between consecutive medium-spaced
   // copies of each player.
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm nop;
   asm nop;
   asm nop;
   asm stx GRP0;
   asm nop;
   asm sty GRP1;
   asm lda.z TEMPLATE_fifth_rows+6;
   asm sta GRP0;
   asm lda.z TEMPLATE_sixth_rows+6;
   asm sta GRP1;
   asm ldy #5;
   asm sta WSYNC;

   // Glyph row 3: GRP0/GRP1 writes land at cycles 0, 8, 31, 36,
   // 42, and 48. Those windows fall between consecutive medium-spaced
   // copies of each player.
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm nop;
   asm nop;
   asm nop;
   asm stx GRP0;
   asm nop;
   asm sty GRP1;
   asm lda.z TEMPLATE_fifth_rows+5;
   asm sta GRP0;
   asm lda.z TEMPLATE_sixth_rows+5;
   asm sta GRP1;
   asm ldy #4;
   asm sta WSYNC;

   // Glyph row 4: GRP0/GRP1 writes land at cycles 0, 8, 31, 36,
   // 42, and 48. Those windows fall between consecutive medium-spaced
   // copies of each player.
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm nop;
   asm nop;
   asm nop;
   asm stx GRP0;
   asm nop;
   asm sty GRP1;
   asm lda.z TEMPLATE_fifth_rows+4;
   asm sta GRP0;
   asm lda.z TEMPLATE_sixth_rows+4;
   asm sta GRP1;
   asm ldy #3;
   asm sta WSYNC;

   // Glyph row 5: GRP0/GRP1 writes land at cycles 0, 8, 31, 36,
   // 42, and 48. Those windows fall between consecutive medium-spaced
   // copies of each player.
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm nop;
   asm nop;
   asm nop;
   asm stx GRP0;
   asm nop;
   asm sty GRP1;
   asm lda.z TEMPLATE_fifth_rows+3;
   asm sta GRP0;
   asm lda.z TEMPLATE_sixth_rows+3;
   asm sta GRP1;
   asm ldy #2;
   asm sta WSYNC;

   // Glyph row 6: GRP0/GRP1 writes land at cycles 0, 8, 31, 36,
   // 42, and 48. Those windows fall between consecutive medium-spaced
   // copies of each player.
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm nop;
   asm nop;
   asm nop;
   asm stx GRP0;
   asm nop;
   asm sty GRP1;
   asm lda.z TEMPLATE_fifth_rows+2;
   asm sta GRP0;
   asm lda.z TEMPLATE_sixth_rows+2;
   asm sta GRP1;
   asm ldy #1;
   asm sta WSYNC;

   // Glyph row 7: GRP0/GRP1 writes land at cycles 0, 8, 31, 36,
   // 42, and 48. Those windows fall between consecutive medium-spaced
   // copies of each player.
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm nop;
   asm nop;
   asm nop;
   asm stx GRP0;
   asm nop;
   asm sty GRP1;
   asm lda.z TEMPLATE_fifth_rows+1;
   asm sta GRP0;
   asm lda.z TEMPLATE_sixth_rows+1;
   asm sta GRP1;
   asm ldy #0;
   asm sta WSYNC;

   // Glyph row 8: GRP0/GRP1 writes land at cycles 0, 8, 31, 36,
   // 42, and 48. Those windows fall between consecutive medium-spaced
   // copies of each player.
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm nop;
   asm nop;
   asm nop;
   asm stx GRP0;
   asm nop;
   asm sty GRP1;
   asm lda.z TEMPLATE_fifth_rows+0;
   asm sta GRP0;
   asm lda.z TEMPLATE_sixth_rows+0;
   asm sta GRP1;
   asm ldy #0;
   asm sta WSYNC;

   // Line eleven removes both player graphics and leaves VDEL disabled.
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta GRP0;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
}
