// Reusable widely spaced six-glyph TIA display component with mutable color.
//
// Instantiate this source with:
//
//     instantiate "six_glyph_wide_component.c26" as score1
//
// Include one fonts/*_decimal.c26 or fonts/*_hex.c26 module first; it
// must define the shared page-contained score_font table.  Each instance owns
// its score, five 16-bit glyph pointers, one page-contained-font glyph offset, delayed glyph byte, and color in compact mode.
// Set compact_font:=0 only when all six glyph pointers are deliberately redirected to another glyph table.
// The 8-pixel glyph origins are X=36,52,68,84,100,116: 16-pixel pitch
// with one glyph-width of blank space between adjacent glyphs, spanning X=36..123.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear. It consumes exactly eleven scanlines and returns at cycle zero
// of the following line. Use vcs_ntsc_component_handoff() before an adjacent
// visible component. It owns P0/P1 graphics, colors, reflection, VDEL, NUSIZ,
// horizontal motion, and RESP0/RESP1 while drawing. It may leave all of that
// P0/P1 state clobbered.
// It preserves playfield, missile, and Ball state, flushes GRP0/GRP1, and
// disables player VDEL before returning. It never touches VSYNC, VBLANK,
// the RIOT timer, or collision latches.  A/X/Y and arithmetic flags are clobbered; hardware stack depth is
// unchanged at lifecycle boundaries.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 11,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 11,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 260,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0,
   TEMPLATE_GLYPH_ORIGIN_0 := 36,
   TEMPLATE_GLYPH_ORIGIN_1 := 52,
   TEMPLATE_GLYPH_ORIGIN_2 := 68,
   TEMPLATE_GLYPH_ORIGIN_3 := 84,
   TEMPLATE_GLYPH_ORIGIN_4 := 100,
   TEMPLATE_GLYPH_ORIGIN_5 := 116,
   TEMPLATE_GLYPH_WIDTH := 8,
   TEMPLATE_GLYPH_ORIGIN_PITCH := 16
};

// Normal wide-score use keeps compact page-contained-font storage. Set this to
// zero only for applications that deliberately replace all six glyph pointers
// with another glyph table (the bankswitching PASS/FAIL diagnostic does this).
parameter compact_font := 1;

#if TEMPLATE_compact_font
recommend bcd24_t TEMPLATE_score := 0;
// Digit 2 uses a biased page-contained font offset. The $80 bias makes
// score_font-$80+row,X cross a page deliberately, preserving the historical
// five-cycle indirect-load timing. Digits 1 and 3..6 retain full pointers.
uint16_t TEMPLATE_pointers[5];
uint8_t TEMPLATE_offset2;
uint8_t TEMPLATE_delayed;
recommend uint8_t TEMPLATE_color := 0x0e;
#else
recommend bcd24_t TEMPLATE_score := 0;
uint16_t TEMPLATE_pointers[6];
uint8_t TEMPLATE_row;
uint8_t TEMPLATE_delayed;
recommend uint8_t TEMPLATE_color := 0x0e;
#endif

static inline void TEMPLATE_prepare_pointers(void) {
#if TEMPLATE_compact_font
   asm lda TEMPLATE_score+2;
   asm tax;
   // Digit 1 retains a full pointer.
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   // Digit 2 is a biased offset (digit*8 + $80).
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm ora #$80;
   asm sta TEMPLATE_offset2;

   // Digits 3/4 retain complete pointers.
   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;

   // Digits 5/6 retain complete pointers.
   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+9;
#else
   // Build six complete 16-bit pointers in human digit order. Packed BCD is
   // little-endian, so score+2 supplies digits 1/2 and score supplies 5/6.
   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;

   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+9;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+11;
#endif
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_draw(void) {
   // Three medium-spaced copies of each player are interleaved at the wide
   // origins: P0 at 36/68/100 and P1 at 52/84/116. The delayed-player
   // pipeline is the same compact six-pointer schedule used by the centered
   // component; only the copy mode and fixed positioning differ.
   asm lda #$06;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
   asm lda TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta HMCLR;
   asm lda #$30;
   asm sta HMP0;
   asm lda #$c0;
   asm sta HMP1;
   asm sta WSYNC;

   // Line two applies motion, flushes both current/delayed player latches, and
   // enters the canonical eight-row delayed-latch glyph schedule.
   asm sta HMOVE;
   GRP0 := 0;
   GRP1 := 0;
   GRP0 := 0;
   // Preserve the exact eight-cycle pre-row phase while clearing reflection.
   // A is still zero after the latch flush.
   asm sta REFP0;
   asm sta REFP1;
   asm nop;
   VDELP0 := 1;
   VDELP1 := 1;
#if TEMPLATE_compact_font
   // Replace the old six-cycle row initialization plus three-cycle
   // zero-page row load with a cycle-identical preload of digit 2's offset,
   // padding, and immediate row value.
   asm ldx TEMPLATE_offset2;
   asm bit.a TEMPLATE_delayed;
   asm ldy #7;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   // Deliberate page cross keeps digit 2 at the old five-cycle load timing.
   asm lda score_font-$80+7,x;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Replace DEC/BPL-taken plus the old zero-page row load exactly:
   // 3-cycle offset preload + 6-cycle padding + 2-cycle immediate row.
   asm ldx TEMPLATE_offset2;
   asm bit.a TEMPLATE_delayed;
   asm nop;
   asm ldy #6;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   // Deliberate page cross keeps digit 2 at the old five-cycle load timing.
   asm lda score_font-$80+6,x;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Replace DEC/BPL-taken plus the old zero-page row load exactly:
   // 3-cycle offset preload + 6-cycle padding + 2-cycle immediate row.
   asm ldx TEMPLATE_offset2;
   asm bit.a TEMPLATE_delayed;
   asm nop;
   asm ldy #5;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   // Deliberate page cross keeps digit 2 at the old five-cycle load timing.
   asm lda score_font-$80+5,x;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Replace DEC/BPL-taken plus the old zero-page row load exactly:
   // 3-cycle offset preload + 6-cycle padding + 2-cycle immediate row.
   asm ldx TEMPLATE_offset2;
   asm bit.a TEMPLATE_delayed;
   asm nop;
   asm ldy #4;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   // Deliberate page cross keeps digit 2 at the old five-cycle load timing.
   asm lda score_font-$80+4,x;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Replace DEC/BPL-taken plus the old zero-page row load exactly:
   // 3-cycle offset preload + 6-cycle padding + 2-cycle immediate row.
   asm ldx TEMPLATE_offset2;
   asm bit.a TEMPLATE_delayed;
   asm nop;
   asm ldy #3;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   // Deliberate page cross keeps digit 2 at the old five-cycle load timing.
   asm lda score_font-$80+3,x;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Replace DEC/BPL-taken plus the old zero-page row load exactly:
   // 3-cycle offset preload + 6-cycle padding + 2-cycle immediate row.
   asm ldx TEMPLATE_offset2;
   asm bit.a TEMPLATE_delayed;
   asm nop;
   asm ldy #2;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   // Deliberate page cross keeps digit 2 at the old five-cycle load timing.
   asm lda score_font-$80+2,x;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Replace DEC/BPL-taken plus the old zero-page row load exactly:
   // 3-cycle offset preload + 6-cycle padding + 2-cycle immediate row.
   asm ldx TEMPLATE_offset2;
   asm bit.a TEMPLATE_delayed;
   asm nop;
   asm ldy #1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   // Deliberate page cross keeps digit 2 at the old five-cycle load timing.
   asm lda score_font-$80+1,x;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // Replace DEC/BPL-taken plus the old zero-page row load exactly:
   // 3-cycle offset preload + 6-cycle padding + 2-cycle immediate row.
   asm ldx TEMPLATE_offset2;
   asm bit.a TEMPLATE_delayed;
   asm nop;
   asm ldy #0;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   // Deliberate page cross keeps digit 2 at the old five-cycle load timing.
   asm lda score_font-$80+0,x;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   // The final DEC/BPL fall-through was seven cycles.
   asm bit.z TEMPLATE_delayed;
   asm bit.a TEMPLATE_delayed;


#else
   // This store sits inside the cycle-counted visible setup. Keep its
   // historical four-cycle absolute timing explicit in handwritten assembly;
   // compiler-lowered ordinary RAM references intentionally remain relaxable.
   asm lda #7;
   asm sta.a TEMPLATE_row;

   asm @TEMPLATE_draw_loop:;
   asm ldy TEMPLATE_row;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   asm dec TEMPLATE_row;
   asm bpl.same @TEMPLATE_draw_loop;


#endif

   GRP0 := 0;
   GRP1 := 0;
   GRP0 := 0;
   VDELP0 := 0;
   VDELP1 := 0;
   WSYNC := 0;
}

require inline void TEMPLATE_overscan(void) {
}
