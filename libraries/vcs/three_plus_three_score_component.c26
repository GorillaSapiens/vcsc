// Reusable fixed left/right three-plus-three score component.
//
// Include one fonts/*_decimal.c26 module first, then instantiate this source:
//
//     include "fonts/default_decimal.c26"
//     instantiate "three_plus_three_score_component.c26" as score
//
// P0 draws three 8-pixel glyphs centered in the left 80-pixel half of the
// screen at X=20,36,52. P1 independently draws three glyphs centered in the
// right half at X=100,116,132. Each field therefore spans 40 pixels including
// the two 8-pixel gaps. The two fields have independent packed-BCD values and
// colors. Values are intended to be kept in the range 000..999; the thousands
// digit of each bcd16_t value is deliberately ignored.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear. It consumes exactly eleven scanlines and returns at cycle zero
// of the following line. Use vcs_ntsc_component_handoff() before an adjacent
// visible component. It owns P0/P1 graphics, colors, reflection, VDEL, NUSIZ,
// horizontal motion, and RESP0/RESP1 while drawing. It preserves playfield and
// missile/Ball display state. Before HMOVE it clears HMM0/HMM1/HMBL so
// preserved missile/Ball geometry cannot be moved again. It flushes both
// current/delayed player graphics and disables player VDEL before returning.
// It never touches VSYNC, VBLANK, the RIOT timer, audio, or collision latches.
// A/X/Y and arithmetic flags are clobbered; hardware stack depth is unchanged
// at lifecycle boundaries.

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 11,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 11,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 300,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0,
   TEMPLATE_LEFT_GLYPH_ORIGIN_0 := 20,
   TEMPLATE_LEFT_GLYPH_ORIGIN_1 := 36,
   TEMPLATE_LEFT_GLYPH_ORIGIN_2 := 52,
   TEMPLATE_RIGHT_GLYPH_ORIGIN_0 := 100,
   TEMPLATE_RIGHT_GLYPH_ORIGIN_1 := 116,
   TEMPLATE_RIGHT_GLYPH_ORIGIN_2 := 132,
   TEMPLATE_GLYPH_WIDTH := 8,
   TEMPLATE_GLYPH_ORIGIN_PITCH := 16
};

recommend bcd16_t TEMPLATE_left_score := 0;
recommend bcd16_t TEMPLATE_right_score := 0;
recommend uint8_t TEMPLATE_left_color := 0x0e;
recommend uint8_t TEMPLATE_right_color := 0x0e;
uint16_t TEMPLATE_pointers[6];
uint8_t TEMPLATE_scratch[2];
uint8_t TEMPLATE_left_hundreds_rows[8];

static inline void TEMPLATE_prepare_left(void) {
   // Hundreds digit: low nibble of the high packed-BCD byte.
   asm lda.z TEMPLATE_left_score + 1;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 1;

   // Tens and ones digits come from the low packed-BCD byte.
   asm lda.z TEMPLATE_left_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 2;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 3;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 4;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 5;

   // Cache the eight left-hundreds rows in zero page. The visible kernel uses
   // these direct loads to make room for both late P1 copy updates.
   asm ldy #0; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 0;
   asm ldy #1; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 1;
   asm ldy #2; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 2;
   asm ldy #3; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 3;
   asm ldy #4; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 4;
   asm ldy #5; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 5;
   asm ldy #6; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 6;
   asm ldy #7; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 7;
}

static inline void TEMPLATE_prepare_right(void) {
   asm lda.z TEMPLATE_right_score + 1;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 6;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 7;

   asm lda.z TEMPLATE_right_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 8;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 9;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 10;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 11;
}

static inline void TEMPLATE_prepare(void) {
   TEMPLATE_prepare_left();
   TEMPLATE_prepare_right();
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_prepare();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare();
}

require inline void TEMPLATE_draw(void) {
   // Line 1: take ownership of player state and colors while guaranteeing that
   // hostile player graphics cannot leak into the visible setup lines.
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta GRP0;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta REFP0;
   asm sta REFP1;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;
   asm lda #3;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm lda.z TEMPLATE_left_color;
   asm sta COLUP0;
   asm lda.z TEMPLATE_right_color;
   asm sta COLUP1;
   asm sta WSYNC;

   // Line 2: fixed P0 base X=20. This is the same measured cycle-three
   // coarse/fine positioning phase used by the renderer position table.
   asm ldy #$b2;
   asm sty HMP0;
   asm tya;
   asm and #$0f;
   asm tax;
   asm bit.z CXM0P;
   asm @TEMPLATE_left_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_left_position_loop;
   asm sta RESP0;
   asm sta WSYNC;

   // Line 3: fixed P1 base X=100. Preload the first left hundreds row
   // only after P0's copies have passed, so the three visible setup lines stay
   // blank while the next scanline can begin with the first P0 glyph latched.
   asm ldy #$58;
   asm sty HMP1;
   asm tya;
   asm and #$0f;
   asm tax;
   asm bit.z CXM0P;
   asm @TEMPLATE_right_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_right_position_loop;
   asm sta RESP1;
   asm ldy #7;
   asm lda.z TEMPLATE_left_hundreds_rows + 7;
   asm sta GRP0;
   asm sta WSYNC;

   // Rows 1..7. P0 begins each row with the current hundreds glyph already
   // latched. The two P0 writes land after the first and second close-copy
   // starts, selecting tens and ones. The late P0 write preloads the next
   // row's hundreds glyph after the third copy has started. P1 can load all
   // three current-row glyphs on the same scanline because its field begins at
   // X=100. The rows are deliberately unrolled so each one has the identical
   // three-cycle entry phase without spending cycles on a loop branch.
   asm sta HMOVE;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
   // Keep the right ones byte in A.  A three-cycle BIT plus an indexed-free
   // Y load preserves the established cycle-50 P0 preload and cycle-53 P1
   // tens write without clobbering A.  The two-cycle NOP then puts the ones
   // write at cycle 58, before P1 copy 3 begins fetching pixels.
   asm bit.z CXM0P;
   asm ldy.z TEMPLATE_left_hundreds_rows + 6;
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm ldy #6;
   asm sta WSYNC;

   // Glyph row 2.
   asm bit.z CXM0P;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
   // Keep the right ones byte in A.  A three-cycle BIT plus an indexed-free
   // Y load preserves the established cycle-50 P0 preload and cycle-53 P1
   // tens write without clobbering A.  The two-cycle NOP then puts the ones
   // write at cycle 58, before P1 copy 3 begins fetching pixels.
   asm bit.z CXM0P;
   asm ldy.z TEMPLATE_left_hundreds_rows + 5;
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm ldy #5;
   asm sta WSYNC;

   // Glyph row 3.
   asm bit.z CXM0P;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
   // Keep the right ones byte in A.  A three-cycle BIT plus an indexed-free
   // Y load preserves the established cycle-50 P0 preload and cycle-53 P1
   // tens write without clobbering A.  The two-cycle NOP then puts the ones
   // write at cycle 58, before P1 copy 3 begins fetching pixels.
   asm bit.z CXM0P;
   asm ldy.z TEMPLATE_left_hundreds_rows + 4;
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm ldy #4;
   asm sta WSYNC;

   // Glyph row 4.
   asm bit.z CXM0P;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
   // Keep the right ones byte in A.  A three-cycle BIT plus an indexed-free
   // Y load preserves the established cycle-50 P0 preload and cycle-53 P1
   // tens write without clobbering A.  The two-cycle NOP then puts the ones
   // write at cycle 58, before P1 copy 3 begins fetching pixels.
   asm bit.z CXM0P;
   asm ldy.z TEMPLATE_left_hundreds_rows + 3;
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm ldy #3;
   asm sta WSYNC;

   // Glyph row 5.
   asm bit.z CXM0P;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
   // Keep the right ones byte in A.  A three-cycle BIT plus an indexed-free
   // Y load preserves the established cycle-50 P0 preload and cycle-53 P1
   // tens write without clobbering A.  The two-cycle NOP then puts the ones
   // write at cycle 58, before P1 copy 3 begins fetching pixels.
   asm bit.z CXM0P;
   asm ldy.z TEMPLATE_left_hundreds_rows + 2;
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm ldy #2;
   asm sta WSYNC;

   // Glyph row 6.
   asm bit.z CXM0P;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
   // Keep the right ones byte in A.  A three-cycle BIT plus an indexed-free
   // Y load preserves the established cycle-50 P0 preload and cycle-53 P1
   // tens write without clobbering A.  The two-cycle NOP then puts the ones
   // write at cycle 58, before P1 copy 3 begins fetching pixels.
   asm bit.z CXM0P;
   asm ldy.z TEMPLATE_left_hundreds_rows + 1;
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm ldy #1;
   asm sta WSYNC;

   // Glyph row 7.
   asm bit.z CXM0P;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
   // Keep the right ones byte in A.  A three-cycle BIT plus an indexed-free
   // Y load preserves the established cycle-50 P0 preload and cycle-53 P1
   // tens write without clobbering A.  The two-cycle NOP then puts the ones
   // write at cycle 58, before P1 copy 3 begins fetching pixels.
   asm bit.z CXM0P;
   asm ldy.z TEMPLATE_left_hundreds_rows + 0;
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm ldy #0;
   asm sta WSYNC;

   // Row 8. Y is zero on entry. There is no next-row preload; once both third
   // copies have started, clear both players and return through terminal WSYNC.
   asm bit.z CXM0P;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z CXM0P;
   asm sty GRP0;
   asm bit.z CXM0P;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;

}

require inline void TEMPLATE_overscan(void) {
}
