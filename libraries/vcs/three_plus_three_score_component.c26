// Reusable fixed left/right three-plus-three score component.
//
// Include one fonts/*_decimal.c26 module first, then instantiate this source:
//
//     include "fonts/default_decimal.c26"
//     instantiate "three_plus_three_score_component.c26" as score
//
// P0 draws three 8-pixel glyphs centered in the left 80-pixel half of the
// screen at X=20,36,52. P1 independently draws three glyphs centered in the
// right half at X=100,116,132. Each field therefore spans 40 pixels including
// the two 8-pixel gaps. The two fields have independent packed-BCD values and
// colors. Values are intended to be kept in the range 000..999; the thousands
// digit of each bcd16_t value is deliberately ignored.
//
// Number of stored and rendered rows per glyph. Default score fonts use eight;
// nondefault score_font tables are tightly packed at glyph_rows bytes per digit.
parameter glyph_rows := 8;

// Optional compile-time paddle sampling. 0 preserves the historical renderer
// byte-for-byte. 2 samples one two-paddle reader; 4 samples all channels of a
// four-paddle reader. Four-channel mode uses a fixed-cycle latch for channels
// 2/3 so paddle state can never move the calibrated RESP1 phase. The application
// supplies instance-prefixed hooks before instantiation; see libraries/vcs/README.md.
parameter paddle_samples := 0;

#if TEMPLATE_paddle_samples != 0 && TEMPLATE_paddle_samples != 2 && TEMPLATE_paddle_samples != 4
extern const uint8_t TEMPLATE_paddle_samples_must_be_0_2_or_4[0];
#endif

// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear. It consumes glyph_rows+3 scanlines and returns at cycle zero
// of the following line. Use vcs_ntsc_component_handoff() before an adjacent
// visible component. It owns P0/P1 graphics, colors, reflection, VDEL, NUSIZ,
// horizontal motion, and RESP0/RESP1 while drawing. It preserves playfield and
// missile/Ball display state. Before HMOVE it clears HMM0/HMM1/HMBL so
// preserved missile/Ball geometry cannot be moved again. It flushes both
// current/delayed player graphics and disables player VDEL before returning.
// It never touches VSYNC, VBLANK, the RIOT timer, audio, or collision latches.
// A/X/Y and arithmetic flags are clobbered; hardware stack depth is unchanged
// at lifecycle boundaries.

#if TEMPLATE_glyph_rows == 1
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 4
#elif TEMPLATE_glyph_rows == 2
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 5
#elif TEMPLATE_glyph_rows == 3
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 6
#elif TEMPLATE_glyph_rows == 4
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 7
#elif TEMPLATE_glyph_rows == 5
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 8
#elif TEMPLATE_glyph_rows == 6
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 9
#elif TEMPLATE_glyph_rows == 7
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 10
#elif TEMPLATE_glyph_rows == 8
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 11
#else
extern const uint8_t TEMPLATE_glyph_rows_must_be_1_through_8[TEMPLATE_glyph_rows];
#endif

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := TEMPLATE_VISIBLE_SCANLINES_VALUE,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := TEMPLATE_VISIBLE_SCANLINES_VALUE,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 300,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0,
   TEMPLATE_LEFT_GLYPH_ORIGIN_0 := 20,
   TEMPLATE_LEFT_GLYPH_ORIGIN_1 := 36,
   TEMPLATE_LEFT_GLYPH_ORIGIN_2 := 52,
   TEMPLATE_RIGHT_GLYPH_ORIGIN_0 := 100,
   TEMPLATE_RIGHT_GLYPH_ORIGIN_1 := 116,
   TEMPLATE_RIGHT_GLYPH_ORIGIN_2 := 132,
   TEMPLATE_GLYPH_WIDTH := 8,
   TEMPLATE_GLYPH_ORIGIN_PITCH := 16
};

recommend bcd16_t TEMPLATE_left_score := 0;
recommend bcd16_t TEMPLATE_right_score := 0;
recommend uint8_t TEMPLATE_left_color := 0x0e;
recommend uint8_t TEMPLATE_right_color := 0x0e;
uint16_t TEMPLATE_pointers[6];
uint8_t TEMPLATE_scratch[2];
uint8_t TEMPLATE_left_hundreds_rows[8];

#if TEMPLATE_glyph_rows != 8
// Non-native-height score fonts are tightly packed: digit N starts at
// N*glyph_rows. Native-height instantiations omit this table and retain their
// established pointer-generation code byte-for-byte.
const uint8_t TEMPLATE_glyph_offsets[10] := {
   0,
   TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows
};
#endif

static inline void TEMPLATE_prepare_left(void) {
   // Hundreds digit: low nibble of the high packed-BCD byte.
   asm lda.z TEMPLATE_left_score + 1;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 1;

   // Tens and ones digits come from the low packed-BCD byte.
   asm lda.z TEMPLATE_left_score;
   asm tax;
   asm and #$f0;
#if TEMPLATE_glyph_rows == 8
   asm lsr;
#else
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 2;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 3;
   asm txa;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 4;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 5;

   // Cache the eight left-hundreds rows in zero page. The visible renderer uses
   // these direct loads to make room for both late P1 copy updates.
   asm ldy #0; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 0;
   asm ldy #1; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 1;
   asm ldy #2; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 2;
   asm ldy #3; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 3;
   asm ldy #4; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 4;
#if TEMPLATE_glyph_rows >= 6
   asm ldy #5; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 5;
#endif
#if TEMPLATE_glyph_rows >= 7
   asm ldy #6; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 6;
#endif
#if TEMPLATE_glyph_rows >= 8
   asm ldy #7; asm lda.iy (TEMPLATE_pointers),y; asm sta.z TEMPLATE_left_hundreds_rows + 7;
#endif
}

static inline void TEMPLATE_prepare_right(void) {
   asm lda.z TEMPLATE_right_score + 1;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 6;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 7;

   asm lda.z TEMPLATE_right_score;
   asm tax;
   asm and #$f0;
#if TEMPLATE_glyph_rows == 8
   asm lsr;
#else
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 8;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 9;
   asm txa;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta.z TEMPLATE_pointers + 10;
   asm lda #>score_font;
   asm adc #0;
   asm sta.z TEMPLATE_pointers + 11;
}

static inline void TEMPLATE_prepare(void) {
   TEMPLATE_prepare_left();
   TEMPLATE_prepare_right();
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_prepare();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare();
}

require inline void TEMPLATE_draw(void) {
   // Line 1: take ownership of player state and colors while guaranteeing that
   // hostile player graphics cannot leak into the visible setup lines.
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta GRP0;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta REFP0;
   asm sta REFP1;
   asm sta HMM0;
   asm sta HMM1;
#if TEMPLATE_paddle_samples == 0
   // Keep the historical no-paddle path byte-for-byte unchanged. Paddle-enabled
   // builds defer HMBL until line 2 to leave the channel-0 completion path
   // safely before this line's WSYNC.
   asm sta HMBL;
#endif
   asm lda #3;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm lda.z TEMPLATE_left_color;
   asm sta COLUP0;
   asm lda.z TEMPLATE_right_color;
   asm sta COLUP1;
#if TEMPLATE_paddle_samples >= 2
   // The score-paddle hook contract reserves X=0 and budgets a 17-cycle
   // completed probe. HMBL is deliberately deferred to line 2: with it here
   // the completed channel-0 path would write WSYNC at cycle 77.
   asm ldx #0;
   TEMPLATE_paddle_sample0();
#endif
   asm sta WSYNC;

   // Line 2: fixed P0 base X=20. This is the same measured cycle-three
   // coarse/fine positioning phase used by the renderer position table.
   asm ldy #$b2;
   asm sty HMP0;
   asm tya;
   asm and #$0f;
   asm tax;
   asm bit.z $00;
   asm @TEMPLATE_left_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_left_position_loop;
   asm sta RESP0;
#if TEMPLATE_paddle_samples >= 2
   // Finish the motion-register cleanup that the paddle-enabled first line
   // deferred. This occurs after RESP0, so it cannot disturb P0 positioning;
   // line 2 has ample worst-case headroom for the five cycles.
   asm lda #0;
   asm sta HMBL;

   // X is zero when the fixed-position loop terminates. Sample the second
   // channel on the companion scanline, then advance the shared two-line RC
   // clock. Both hooks are compile-time bound and have fixed worst-case budgets.
   TEMPLATE_paddle_sample1();
   TEMPLATE_paddle_advance_pair();
#endif
   asm sta WSYNC;

   // Line 3: fixed P1 base X=100. Preload the first left hundreds row
   // only after P0's copies have passed, so the three visible setup lines stay
   // blank while the next scanline can begin with the first P0 glyph latched.
   asm ldy #$58;
   asm sty HMP1;
#if TEMPLATE_paddle_samples == 4
   // The historical X=8 divide-delay occupies exactly 48 cycles after HMP1.
   // A four-paddle reader supplies a fixed 24-cycle latch for channels 2/3;
   // eight harmless three-cycle BITs fill the other 24 cycles. RESP1 therefore
   // lands on the identical cycle regardless of paddle threshold state.
   TEMPLATE_paddle_latch23_fixed();
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
#else
   asm tya;
   asm and #$0f;
   asm tax;
   asm bit.z $00;
   asm @TEMPLATE_right_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_right_position_loop;
#endif
   asm sta RESP1;
#if TEMPLATE_glyph_rows == 1
   asm ldy #0;
   asm lda.z TEMPLATE_left_hundreds_rows + 0;
#elif TEMPLATE_glyph_rows == 2
   asm ldy #1;
   asm lda.z TEMPLATE_left_hundreds_rows + 1;
#elif TEMPLATE_glyph_rows == 3
   asm ldy #2;
   asm lda.z TEMPLATE_left_hundreds_rows + 2;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #3;
   asm lda.z TEMPLATE_left_hundreds_rows + 3;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #4;
   asm lda.z TEMPLATE_left_hundreds_rows + 4;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #5;
   asm lda.z TEMPLATE_left_hundreds_rows + 5;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #6;
   asm lda.z TEMPLATE_left_hundreds_rows + 6;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #7;
   asm lda.z TEMPLATE_left_hundreds_rows + 7;
#endif
   asm sta GRP0;
   asm sta WSYNC;

   // Render exactly glyph_rows rows. The native 8-row instantiation compiles
   // to the established unrolled schedule; shorter instantiations simply omit
   // leading row slots while keeping the final glyph row at Y=0.

#if TEMPLATE_glyph_rows >= 1
   asm sta HMOVE;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
#if TEMPLATE_glyph_rows == 1
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z $00;
   asm sty GRP0;
   asm bit.z $00;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;
#else
   // Keep the right ones byte in A. A three-cycle BIT plus an indexed-free
   // Y load preserves the established P0/P1 write phases.
   asm bit.z $00;
#if TEMPLATE_glyph_rows == 2
   asm ldy.z TEMPLATE_left_hundreds_rows + 0;
#elif TEMPLATE_glyph_rows == 3
   asm ldy.z TEMPLATE_left_hundreds_rows + 1;
#elif TEMPLATE_glyph_rows == 4
   asm ldy.z TEMPLATE_left_hundreds_rows + 2;
#elif TEMPLATE_glyph_rows == 5
   asm ldy.z TEMPLATE_left_hundreds_rows + 3;
#elif TEMPLATE_glyph_rows == 6
   asm ldy.z TEMPLATE_left_hundreds_rows + 4;
#elif TEMPLATE_glyph_rows == 7
   asm ldy.z TEMPLATE_left_hundreds_rows + 5;
#elif TEMPLATE_glyph_rows == 8
   asm ldy.z TEMPLATE_left_hundreds_rows + 6;
#endif
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
#if TEMPLATE_glyph_rows == 2
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 3
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #4;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #5;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #6;
#endif
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 2
   // Glyph row 2.
   asm bit.z $00;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
#if TEMPLATE_glyph_rows == 2
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z $00;
   asm sty GRP0;
   asm bit.z $00;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;
#else
   // Keep the right ones byte in A. A three-cycle BIT plus an indexed-free
   // Y load preserves the established P0/P1 write phases.
   asm bit.z $00;
#if TEMPLATE_glyph_rows == 3
   asm ldy.z TEMPLATE_left_hundreds_rows + 0;
#elif TEMPLATE_glyph_rows == 4
   asm ldy.z TEMPLATE_left_hundreds_rows + 1;
#elif TEMPLATE_glyph_rows == 5
   asm ldy.z TEMPLATE_left_hundreds_rows + 2;
#elif TEMPLATE_glyph_rows == 6
   asm ldy.z TEMPLATE_left_hundreds_rows + 3;
#elif TEMPLATE_glyph_rows == 7
   asm ldy.z TEMPLATE_left_hundreds_rows + 4;
#elif TEMPLATE_glyph_rows == 8
   asm ldy.z TEMPLATE_left_hundreds_rows + 5;
#endif
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
#if TEMPLATE_glyph_rows == 3
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #4;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #5;
#endif
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 3
   // Glyph row 3.
   asm bit.z $00;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
#if TEMPLATE_glyph_rows == 3
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z $00;
   asm sty GRP0;
   asm bit.z $00;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;
#else
   // Keep the right ones byte in A. A three-cycle BIT plus an indexed-free
   // Y load preserves the established P0/P1 write phases.
   asm bit.z $00;
#if TEMPLATE_glyph_rows == 4
   asm ldy.z TEMPLATE_left_hundreds_rows + 0;
#elif TEMPLATE_glyph_rows == 5
   asm ldy.z TEMPLATE_left_hundreds_rows + 1;
#elif TEMPLATE_glyph_rows == 6
   asm ldy.z TEMPLATE_left_hundreds_rows + 2;
#elif TEMPLATE_glyph_rows == 7
   asm ldy.z TEMPLATE_left_hundreds_rows + 3;
#elif TEMPLATE_glyph_rows == 8
   asm ldy.z TEMPLATE_left_hundreds_rows + 4;
#endif
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
#if TEMPLATE_glyph_rows == 4
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #4;
#endif
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 4
   // Glyph row 4.
   asm bit.z $00;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
#if TEMPLATE_glyph_rows == 4
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z $00;
   asm sty GRP0;
   asm bit.z $00;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;
#else
   // Keep the right ones byte in A. A three-cycle BIT plus an indexed-free
   // Y load preserves the established P0/P1 write phases.
   asm bit.z $00;
#if TEMPLATE_glyph_rows == 5
   asm ldy.z TEMPLATE_left_hundreds_rows + 0;
#elif TEMPLATE_glyph_rows == 6
   asm ldy.z TEMPLATE_left_hundreds_rows + 1;
#elif TEMPLATE_glyph_rows == 7
   asm ldy.z TEMPLATE_left_hundreds_rows + 2;
#elif TEMPLATE_glyph_rows == 8
   asm ldy.z TEMPLATE_left_hundreds_rows + 3;
#endif
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
#if TEMPLATE_glyph_rows == 5
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #3;
#endif
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 5
   // Glyph row 5.
   asm bit.z $00;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
#if TEMPLATE_glyph_rows == 5
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z $00;
   asm sty GRP0;
   asm bit.z $00;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;
#else
   // Keep the right ones byte in A. A three-cycle BIT plus an indexed-free
   // Y load preserves the established P0/P1 write phases.
   asm bit.z $00;
#if TEMPLATE_glyph_rows == 6
   asm ldy.z TEMPLATE_left_hundreds_rows + 0;
#elif TEMPLATE_glyph_rows == 7
   asm ldy.z TEMPLATE_left_hundreds_rows + 1;
#elif TEMPLATE_glyph_rows == 8
   asm ldy.z TEMPLATE_left_hundreds_rows + 2;
#endif
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
#if TEMPLATE_glyph_rows == 6
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #2;
#endif
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 6
   // Glyph row 6.
   asm bit.z $00;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
#if TEMPLATE_glyph_rows == 6
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z $00;
   asm sty GRP0;
   asm bit.z $00;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;
#else
   // Keep the right ones byte in A. A three-cycle BIT plus an indexed-free
   // Y load preserves the established P0/P1 write phases.
   asm bit.z $00;
#if TEMPLATE_glyph_rows == 7
   asm ldy.z TEMPLATE_left_hundreds_rows + 0;
#elif TEMPLATE_glyph_rows == 8
   asm ldy.z TEMPLATE_left_hundreds_rows + 1;
#endif
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
#if TEMPLATE_glyph_rows == 7
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #1;
#endif
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 7
   // Glyph row 7.
   asm bit.z $00;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
#if TEMPLATE_glyph_rows == 7
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z $00;
   asm sty GRP0;
   asm bit.z $00;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;
#else
   // Keep the right ones byte in A. A three-cycle BIT plus an indexed-free
   // Y load preserves the established P0/P1 write phases.
   asm bit.z $00;
#if TEMPLATE_glyph_rows == 8
   asm ldy.z TEMPLATE_left_hundreds_rows + 0;
#endif
   asm sty GRP0;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
#if TEMPLATE_glyph_rows == 8
   asm ldy #0;
#endif
   asm sta WSYNC;
#endif
#endif

#if TEMPLATE_glyph_rows >= 8
   // Glyph row 8.
   asm bit.z $00;
   asm lda.iy (TEMPLATE_pointers + 2),y;
   asm sta.z TEMPLATE_scratch;
   asm lda.iy (TEMPLATE_pointers + 4),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 6),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_scratch;
   asm sta GRP0;
   asm nop;
   asm stx GRP0;
   asm lda.iy (TEMPLATE_pointers + 8),y;
   asm tax;
   asm lda.iy (TEMPLATE_pointers + 10),y;
#if TEMPLATE_glyph_rows == 8
   // Final row: keep the ones byte in A, preserve the established cycle-47
   // P0 clear and cycle-53 P1 tens write, then update P1 at cycle 58 before
   // copy 3 starts.
   asm bit.z $00;
   asm sty GRP0;
   asm bit.z $00;
   asm stx GRP1;
   asm nop;
   asm sta GRP1;
   asm sty GRP1;
   asm sty WSYNC;
#endif
#endif

}

