// Reusable centered six-glyph TIA display component.
//
// Instantiate the compact fixed-color default with:
//
//     instantiate "six_glyph_component.c26" as score1
//
// Mutable color is available from the same component:
//
//     instantiate "six_glyph_component.c26" as score1 (mutable_color:=1)
//
// Set compact_font:=0 only when an application deliberately writes all six
// glyph pointers itself. Normal scores should keep the compact default.
//
// Include one fonts/*_decimal.c26 or fonts/*_hex.c26 module first; it must
// define the shared page-contained score_font table. Compact mode stores two
// one-byte glyph offsets plus four full pointers and needs no RAM row counter.
// Full-pointer compatibility mode stores six 16-bit pointers plus a row byte.
// mutable_color:=1 adds one application-visible TEMPLATE_color byte; otherwise
// the component draws with fixed bright-white color $0e and allocates no color
// byte.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear. It consumes exactly eleven scanlines and returns at cycle zero
// of the following line. Use vcs_ntsc_component_handoff() before an adjacent
// visible component. It owns P0/P1 graphics, colors, reflection, VDEL, NUSIZ,
// horizontal motion, and RESP0/RESP1 while drawing. It may leave all of that
// P0/P1 state clobbered. It preserves playfield, missile, and Ball state,
// flushes GRP0/GRP1, and disables player VDEL before returning. It never
// touches VSYNC, VBLANK, the RIOT timer, or collision latches. A/X/Y and
// arithmetic flags are clobbered; hardware stack depth is unchanged at
// lifecycle boundaries.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 11,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 11,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 260,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0
};

// Normal score use keeps compact page-contained-font storage.
parameter compact_font := 1;
// Fixed white is free; set this to one only when the application changes color.
parameter mutable_color := 0;

recommend bcd24_t TEMPLATE_score := 0;
#if TEMPLATE_compact_font
uint8_t TEMPLATE_offsets[2];
uint16_t TEMPLATE_pointers[4];
uint8_t TEMPLATE_delayed;
#else
uint16_t TEMPLATE_pointers[6];
uint8_t TEMPLATE_row;
uint8_t TEMPLATE_delayed;
#endif
#if TEMPLATE_mutable_color
recommend uint8_t TEMPLATE_color := 0x0e;
#endif

#if TEMPLATE_compact_font
static inline void TEMPLATE_prepare_pointers(void) {
   // Digits 1/2: only digit*8 is needed because score_font is page-contained.
   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm sta TEMPLATE_offsets;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm sta TEMPLATE_offsets+1;

   // Digits 3/4 retain complete pointers.
   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   // Digits 5/6 retain complete pointers.
   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;
}
#else
static inline void TEMPLATE_prepare_pointers(void) {
   // Build six complete 16-bit pointers in human digit order. Packed BCD is
   // little-endian, so score+2 supplies digits 1/2 and score supplies 5/6.
   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;

   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+9;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+11;
}
#endif

require inline void TEMPLATE_init(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare_pointers();
}

#if TEMPLATE_compact_font
require inline void TEMPLATE_draw(void) {
   // Line one re-establishes the score's fixed P0/P1 geometry. The historical
   // eight-cycle padding now preloads digit 2's row-7 offset; BIT/NOP preserve
   // A, so HMCLR/RESP0/RESP1 retain their original cycles.
   asm lda #$03;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
#if TEMPLATE_mutable_color
   // Mutable color uses the historical eight-cycle slot to preload digit 2.
   asm ldy TEMPLATE_offsets+1;
   asm bit.z TEMPLATE_offsets;
   asm nop;
#else
   // Fixed-color mode preserves the original centered component's exact
   // COLUP0/COLUP1 write cycles.
   asm lda #$0e;
   asm sta COLUP0;
   asm sta COLUP1;
#endif
   asm sta HMCLR;
   asm lda #$80;
   asm sta HMP0;
   asm lda #$90;
   asm sta HMP1;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
#if TEMPLATE_mutable_color
   asm lda TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
#else
   // Fixed-color mode used the eight-cycle pre-HMCLR slot for color, so
   // preload digit 2 here before WSYNC instead.
   asm ldy TEMPLATE_offsets+1;
#endif
   asm sta WSYNC;

   // Line two applies motion, flushes hostile player state, and preserves Y
   // from line one until digit 2 has been looked up.
   asm sta HMOVE;
   GRP0 := 0;
   GRP1 := 0;
   GRP0 := 0;
   asm sta REFP0;
   asm sta REFP1;
   asm nop;
   VDELP0 := 1;
   VDELP1 := 1;

   // Row 7. The absolute GRP0 store is deliberately one cycle longer than the
   // normal TIA store; together with the shorter first-row setup it lands
   // digit 1 at the exact historical cycle 39.
   asm lda score_font+7,y;
   asm tax;
   asm ldy TEMPLATE_offsets;
   asm lda score_font+7,y;
   asm sta.a GRP0;
   asm sta WSYNC;
   // Reuse the five cycles formerly occupied by digit 2's pointer fetch to
   // restore Y=row. STX then lands digit 2 on the original cycle.
   asm ldy #7;
   asm bit.z TEMPLATE_offsets;
   asm stx GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Row 6. The old DEC/BPL/LDY/load/store transition was 19 cycles from
   // the previous delayed flush to digit 1. Computing digit 2 into X and digit
   // 1 into A uses exactly those same 19 cycles, then WSYNC stays at cycle 67.
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+6,y;
   asm tax;
   asm ldy TEMPLATE_offsets;
   asm lda score_font+6,y;
   asm sta GRP0;
   asm sta WSYNC;
   asm ldy #6;
   asm bit.z TEMPLATE_offsets;
   asm stx GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Row 5. The old DEC/BPL/LDY/load/store transition was 19 cycles from
   // the previous delayed flush to digit 1. Computing digit 2 into X and digit
   // 1 into A uses exactly those same 19 cycles, then WSYNC stays at cycle 67.
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+5,y;
   asm tax;
   asm ldy TEMPLATE_offsets;
   asm lda score_font+5,y;
   asm sta GRP0;
   asm sta WSYNC;
   asm ldy #5;
   asm bit.z TEMPLATE_offsets;
   asm stx GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Row 4. The old DEC/BPL/LDY/load/store transition was 19 cycles from
   // the previous delayed flush to digit 1. Computing digit 2 into X and digit
   // 1 into A uses exactly those same 19 cycles, then WSYNC stays at cycle 67.
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+4,y;
   asm tax;
   asm ldy TEMPLATE_offsets;
   asm lda score_font+4,y;
   asm sta GRP0;
   asm sta WSYNC;
   asm ldy #4;
   asm bit.z TEMPLATE_offsets;
   asm stx GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Row 3. The old DEC/BPL/LDY/load/store transition was 19 cycles from
   // the previous delayed flush to digit 1. Computing digit 2 into X and digit
   // 1 into A uses exactly those same 19 cycles, then WSYNC stays at cycle 67.
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+3,y;
   asm tax;
   asm ldy TEMPLATE_offsets;
   asm lda score_font+3,y;
   asm sta GRP0;
   asm sta WSYNC;
   asm ldy #3;
   asm bit.z TEMPLATE_offsets;
   asm stx GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Row 2. The old DEC/BPL/LDY/load/store transition was 19 cycles from
   // the previous delayed flush to digit 1. Computing digit 2 into X and digit
   // 1 into A uses exactly those same 19 cycles, then WSYNC stays at cycle 67.
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+2,y;
   asm tax;
   asm ldy TEMPLATE_offsets;
   asm lda score_font+2,y;
   asm sta GRP0;
   asm sta WSYNC;
   asm ldy #2;
   asm bit.z TEMPLATE_offsets;
   asm stx GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Row 1. The old DEC/BPL/LDY/load/store transition was 19 cycles from
   // the previous delayed flush to digit 1. Computing digit 2 into X and digit
   // 1 into A uses exactly those same 19 cycles, then WSYNC stays at cycle 67.
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+1,y;
   asm tax;
   asm ldy TEMPLATE_offsets;
   asm lda score_font+1,y;
   asm sta GRP0;
   asm sta WSYNC;
   asm ldy #1;
   asm bit.z TEMPLATE_offsets;
   asm stx GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Row 0. The old DEC/BPL/LDY/load/store transition was 19 cycles from
   // the previous delayed flush to digit 1. Computing digit 2 into X and digit
   // 1 into A uses exactly those same 19 cycles, then WSYNC stays at cycle 67.
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+0,y;
   asm tax;
   asm ldy TEMPLATE_offsets;
   asm lda score_font+0,y;
   asm sta GRP0;
   asm sta WSYNC;
   asm ldy #0;
   asm bit.z TEMPLATE_offsets;
   asm stx GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Match the old final DEC plus not-taken BPL before cleanup without keeping
   // a RAM row counter.
   asm bit.z TEMPLATE_offsets;
   asm nop;
   asm nop;
   GRP0 := 0;
   GRP1 := 0;
   GRP0 := 0;
   VDELP0 := 0;
   VDELP1 := 0;
   WSYNC := 0;
}
#else
require inline void TEMPLATE_draw(void) {
   // Line one re-establishes the score's fixed P0/P1 geometry every time it is
   // invoked. This makes both score-above and score-below composition legal.
   asm lda #$03;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
#if TEMPLATE_mutable_color
   // Keep the fixed-color path's historical eight-cycle pre-HMCLR phase.
   asm nop;
   asm nop;
   asm nop;
   asm nop;
#else
   asm lda #$0e;
   asm sta COLUP0;
   asm sta COLUP1;
#endif
   asm sta HMCLR;
   asm lda #$80;
   asm sta HMP0;
   asm lda #$90;
   asm sta HMP1;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
#if TEMPLATE_mutable_color
   asm lda TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
#endif
   asm sta WSYNC;

   // Line two applies motion, flushes both current/delayed player latches, and
   // enters the canonical eight-row 48-pixel glyph schedule.
   asm sta HMOVE;
   GRP0 := 0;
   GRP1 := 0;
   GRP0 := 0;
   // Replace the former redundant eight-cycle color reload with an exact
   // eight-cycle reflection reset. A is still zero after the latch flush.
   asm sta REFP0;
   asm sta REFP1;
   asm nop;
   VDELP0 := 1;
   VDELP1 := 1;
   // This store sits inside the cycle-counted visible setup. Keep its
   // historical four-cycle absolute timing explicit in handwritten assembly;
   // compiler-lowered ordinary RAM references intentionally remain relaxable.
   asm lda #7;
   asm sta.a TEMPLATE_row;

   asm @TEMPLATE_draw_loop:;
   asm ldy TEMPLATE_row;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   asm dec TEMPLATE_row;
   asm bpl.same @TEMPLATE_draw_loop;

   GRP0 := 0;
   GRP1 := 0;
   GRP0 := 0;
   VDELP0 := 0;
   VDELP1 := 0;
   WSYNC := 0;
}
#endif

require inline void TEMPLATE_overscan(void) {
}
