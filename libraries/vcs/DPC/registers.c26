// Atari DPC cartridge register bindings. The DPC occupies $1000-$107F,
// overlaying the first 128 bytes of the ordinary 4K cartridge window.

uint8_t DPC_RANDOM0 @[0x1000/none];
uint8_t DPC_RANDOM1 @[0x1001/none];
