// Atari 2600 / VCS RIOT (6532) register bindings.
//
// This file assumes the target has already defined the core 6502-sized types.
// Canonical register addresses use the usual VCS RIOT locations. These are
// also mirrored by the hardware, but the canonical addresses are what source
// should normally use.

// RIOT RAM is declared once by vcs.vcsc. The page-1 stack window is only a
// mirror of the same physical bytes and must not be declared as extra memory.

// RIOT I/O and timer registers.
ref uint8_t SWCHA @[0x0280/0x0280];
ref uint8_t SWACNT@[0x0281/0x0281];
ref uint8_t SWCHB @[0x0282/0x0282];
ref uint8_t SWBCNT@[0x0283/0x0283];
ref uint8_t INTIM @[0x0284/none];
ref uint8_t TIMINT@[0x0285/none];
ref uint8_t TIM1T @[none/0x0294];
ref uint8_t TIM8T @[none/0x0295];
ref uint8_t TIM64T@[none/0x0296];
ref uint8_t T1024T@[none/0x0297];
