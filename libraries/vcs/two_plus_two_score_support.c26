// Shared immutable tables for two_plus_two_score_component.c26.
//
// Include this module once before instantiating one or more two-plus-two score
// components. Each component instance owns its mutable values, colors,
// positions, pointers, and precomputed positioning controls; these tables are
// deliberately shared so another instance costs RAM but not another 320 bytes
// of ROM.

// Glyph source rows are written top-to-bottom for readability. The component
// walks each glyph from index seven down to zero, so reverse every declaration
// into memory order. Each three-bit glyph is supplied in bits 7..5 or 3..1;
// ORing one row from each table creates a two-digit player byte with one blank
// source bit between the digits and one trailing blank bit.
alias VCS_TWO_PLUS_TWO_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

page const uint8_t vcs_two_plus_two_font_high[80] := {
   // Each 3-bit digit occupies bits 7..5; bit 4 is the inter-digit gap.
   // 0
   VCS_TWO_PLUS_TWO_GLYPH(0xe0,0xa0,0xa0,0xa0,0xa0,0xa0,0xa0,0xe0),
   // 1
   VCS_TWO_PLUS_TWO_GLYPH(0x40,0xc0,0x40,0x40,0x40,0x40,0x40,0xe0),
   // 2
   VCS_TWO_PLUS_TWO_GLYPH(0xe0,0x20,0x20,0xe0,0x80,0x80,0x80,0xe0),
   // 3
   VCS_TWO_PLUS_TWO_GLYPH(0xe0,0x20,0x20,0xe0,0x20,0x20,0x20,0xe0),
   // 4
   VCS_TWO_PLUS_TWO_GLYPH(0xa0,0xa0,0xa0,0xe0,0x20,0x20,0x20,0x20),
   // 5
   VCS_TWO_PLUS_TWO_GLYPH(0xe0,0x80,0x80,0xe0,0x20,0x20,0x20,0xe0),
   // 6
   VCS_TWO_PLUS_TWO_GLYPH(0xe0,0x80,0x80,0xe0,0xa0,0xa0,0xa0,0xe0),
   // 7
   VCS_TWO_PLUS_TWO_GLYPH(0xe0,0x20,0x20,0x40,0x40,0x80,0x80,0x80),
   // 8
   VCS_TWO_PLUS_TWO_GLYPH(0xe0,0xa0,0xa0,0xe0,0xa0,0xa0,0xa0,0xe0),
   // 9
   VCS_TWO_PLUS_TWO_GLYPH(0xe0,0xa0,0xa0,0xe0,0x20,0x20,0x20,0xe0)
};

page const uint8_t vcs_two_plus_two_font_low[80] := {
   // Each 3-bit digit occupies bits 3..1; bit 0 is trailing whitespace.
   // 0
   VCS_TWO_PLUS_TWO_GLYPH(0x0e,0x0a,0x0a,0x0a,0x0a,0x0a,0x0a,0x0e),
   // 1
   VCS_TWO_PLUS_TWO_GLYPH(0x04,0x0c,0x04,0x04,0x04,0x04,0x04,0x0e),
   // 2
   VCS_TWO_PLUS_TWO_GLYPH(0x0e,0x02,0x02,0x0e,0x08,0x08,0x08,0x0e),
   // 3
   VCS_TWO_PLUS_TWO_GLYPH(0x0e,0x02,0x02,0x0e,0x02,0x02,0x02,0x0e),
   // 4
   VCS_TWO_PLUS_TWO_GLYPH(0x0a,0x0a,0x0a,0x0e,0x02,0x02,0x02,0x02),
   // 5
   VCS_TWO_PLUS_TWO_GLYPH(0x0e,0x08,0x08,0x0e,0x02,0x02,0x02,0x0e),
   // 6
   VCS_TWO_PLUS_TWO_GLYPH(0x0e,0x08,0x08,0x0e,0x0a,0x0a,0x0a,0x0e),
   // 7
   VCS_TWO_PLUS_TWO_GLYPH(0x0e,0x02,0x02,0x04,0x04,0x08,0x08,0x08),
   // 8
   VCS_TWO_PLUS_TWO_GLYPH(0x0e,0x0a,0x0a,0x0e,0x0a,0x0a,0x0a,0x0e),
   // 9
   VCS_TWO_PLUS_TWO_GLYPH(0x0e,0x0a,0x0a,0x0e,0x02,0x02,0x02,0x0e)
};

// Packed visible-position control table. The high nibble is the HMxx value and
// the low nibble is the number of five-cycle coarse-loop steps. The component's
// two positioning lines deliberately use the same measured cycle-three RESP
// phase as the 181-line all-five renderer's visible player handoff.
page const uint8_t vcs_two_plus_two_position_table[160] := {
   0x41,0x31,0x21,0x11,0x01,0xf1,0xe1,0xd1,0xc1,0xb1,0xa1,0x91,0x81,0x62,0x52,0x42,
   0x32,0x22,0x12,0x02,0xf2,0xe2,0xd2,0xc2,0xb2,0xa2,0x92,0x82,0x63,0x53,0x43,0x33,
   0x23,0x13,0x03,0xf3,0xe3,0xd3,0xc3,0xb3,0xa3,0x93,0x83,0x64,0x54,0x44,0x34,0x24,
   0x14,0x04,0xf4,0xe4,0xd4,0xc4,0xb4,0xa4,0x94,0x84,0x65,0x55,0x45,0x35,0x25,0x15,
   0x05,0xf5,0xe5,0xd5,0xc5,0xb5,0xa5,0x95,0x85,0x66,0x56,0x46,0x36,0x26,0x16,0x06,
   0xf6,0xe6,0xd6,0xc6,0xb6,0xa6,0x96,0x86,0x67,0x57,0x47,0x37,0x27,0x17,0x07,0xf7,
   0xe7,0xd7,0xc7,0xb7,0xa7,0x97,0x87,0x68,0x58,0x48,0x38,0x28,0x18,0x08,0xf8,0xe8,
   0xd8,0xc8,0xb8,0xa8,0x98,0x88,0x69,0x59,0x49,0x39,0x29,0x19,0x09,0xf9,0xe9,0xd9,
   0xc9,0xb9,0xa9,0x99,0x89,0x6a,0x5a,0x4a,0x3a,0x2a,0x1a,0x0a,0xfa,0xea,0xda,0xca,
   0xba,0xaa,0x9a,0x8a,0x6b,0x5b,0x4b,0x3b,0x2b,0x1b,0x0b,0xfb,0xeb,0xdb,0xcb,0xbb
