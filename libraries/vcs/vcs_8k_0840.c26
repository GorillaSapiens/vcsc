include "vcs.c26"

// Atari 0840 / EconoBanking: two full-window 4K ROM banks.  Physical bank 0
// powers up and is selected by any decoded access in the $0800 family; physical
// bank 1 is selected by the corresponding $0840 family.  The canonical exact
// selector addresses used by VCSC are $0800 and $0840.  Because these live
// below the cartridge window, generated selector stubs use read-only NMOS
// absolute NOP accesses rather than stores into mirrored TIA space.
cartridge {
   $fill:0xff $signature:0840
   $trampoline_offset:0x0f00 $trampoline_size:0x00e0
   $vector_bridge_offset:0x0fe0 $vector_bridge_size:0x0012
   $vectors_offset:0x0ffa $vectors_size:0x0006
};

bank bank0 {
   $image_size:0x1000 $file_index:0 $image_offset:0x0000
   $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000
   $select_access:0x0800 $startup
};

bank bank1 {
   $image_size:0x1000 $file_index:1 $image_offset:0x0000
   $link_start:0xd000 $cpu_start:0xf000 $map_size:0x1000
   $select_access:0x0840
};

mem bank0 { $start:0xf000 $size:0x0f00 $ro $priority:2 };
mem bank1 { $start:0xd000 $size:0x0f00 $ro };
