// WD owns TIA reads at $30-$3F as arrangement selectors. Use the equivalent
// $40-$7F TIA mirror for ordinary TIA I/O so collision/input reads cannot
// change the ROM arrangement.
alias VCS_TIA_USE_40_MIRROR 1
include "vcs.c26"

// Wickstead Design / Pursuit of the Pink Panther physically contains eight
// 1K ROM chunks and can arrange four of them at a time in $1000-$1FFF. The
// hardware exposes these eight arrangements (left to right = the four 1K CPU
// windows at $1000, $1400, $1800, $1C00):
//
//      state 0:  0 0 1 3       power-on state
//      state 1:  0 1 2 3
//      state 2:  4 5 6 7
//      state 3:  7 4 2 3
//      state 4:  0 0 6 7
//      state 5:  0 1 7 6
//      state 6:  2 3 4 5
//      state 7:  6 0 5 1
//
// VCSC DELIBERATELY DOES NOT expose those eight hardware arrangements as eight
// compiler banks. Ordinary 6502 code is not position independent: a chunk
// linked for $1C00 contains absolute JSR/JMP/data operands for $1C00, and moving
// the same bytes to $1400 does not relocate those operands. Trying to model the
// hardware table literally therefore gives the compiler "banks" that are not
// generally executable in most of their hardware positions.
//
// Instead VCSC uses the two complementary, relocation-safe arrangements as its
// complete compiler ABI:
//
//      VCSC bank0 == WD state 1 == physical chunks 0,1,2,3
//      VCSC bank1 == WD state 2 == physical chunks 4,5,6,7
//
// Each physical chunk consequently has exactly one compiler/link address. The
// first 4K of the output image is bank0 and the second 4K is bank1. Reads of
// TIA $39 select WD state 1; reads of $3A select WD state 2. The descriptor ABI
// uses opaque descriptors 1 and 2, so the replicated bank-call corridor reads
// $0038,Y to select/restore the corresponding logical bank. WD's delayed latch
// is safe because every instruction that can execute across the transition is
// byte-identical at the same CPU address in both logical banks.
//
// The other six WD arrangements remain real hardware behavior and may still be
// exercised deliberately by handwritten assembly or diagnostics. Such code is
// outside the C26 cross-bank-call ABI and is responsible for restoring state 1
// or 2 before returning to ordinary compiler-generated banked code.
//
// Power-on WD state 0 already maps physical chunk 3 into $1C00-$1FFF, so the
// reset vector reaches bank0's replicated vector bridge. That bridge performs a
// non-destructive selector read of $39 and, after the hardware delay, jumps into
// the normal bank0 startup code with the complete state-1 mapping established.
//
// WD also owns 64 bytes of always-live split-address RAM: reads $1000-$103F,
// writes $1040-$107F. Those ports hide the first $80 bytes of whichever physical
// chunk occupies segment 0, so both compiler banks reserve offsets $000-$07F.
cartridge {
   $bankcall
   $fill:0xff $signature:WD
   $trampoline_offset:0x0f00 $trampoline_size:0x00e0
   $vector_bridge_offset:0x0fe0 $vector_bridge_size:0x0012
   $vectors_offset:0x0ffa $vectors_size:0x0006
};

bank bank0 {
   $image_size:0x1000 $file_index:0 $image_offset:0x0080
   $link_start:0xf080 $cpu_start:0xf080 $map_size:0x0f80
   $select_access:0x0039 $bankcall_descriptor:0x01 $startup
};

bank bank1 {
   $image_size:0x1000 $file_index:1 $image_offset:0x0080
   $link_start:0xd080 $cpu_start:0xf080 $map_size:0x0f80
   $select_access:0x003a $bankcall_descriptor:0x02
};

// $000-$07F of each logical 4K image is hidden whenever that bank is selected:
// the CPU sees the WD RAM read/write ports there instead of ROM.
mem bank0 { $start:0xf080 $size:0x0e80 $ro $priority:2 };
mem bank1 { $start:0xd080 $size:0x0e80 $ro };

mem cartram { $read_start:0xf000 $write_start:0xf040 $size:0x0040 $rw $read_hazard };
