// Repeatable official-opcode 192-scanline P0/P1/M0/M1/BL gameplay component.
//
// Instantiate with:
//
//     template "kernels/all_five_192/all_five_192.c26" as game
//
// Include vcs.c26 before this module. Each instance requires one page-contained
// immutable 48-byte playfield named INSTANCE_playfield.  The component draws
// an exact 192-line scoreless gameplay field. It uses the predecessor's
// twelfth-row path and extends its final gameplay state through the eleven
// scanlines that the score-composable profile reserves for a score.
// It cannot be composed with the separate eleven-line score inside the standard
// 192-line visible field.
//
// This component owns no score state, font, score pointers, VSYNC, VBLANK, or
// RIOT timer state. vblank() may use WSYNC while the scheduler deadline runs.
// draw() enters and leaves on scanline boundaries and owns exactly 192 visible
// scanlines. It clears all gameplay graphics/enables/playfield state on exit;
// overscan() restores application Y coordinates after main() has asserted VBLANK.
// A/X/Y and arithmetic flags are clobbered.

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 192,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0,
   TEMPLATE_OBJECT_COUNT := 5,
   TEMPLATE_PLAYFIELD_BYTES := 48,
   TEMPLATE_PLAYFIELD_ROWS := 12,
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 6,
   TEMPLATE_PRIVATE_RAM_BYTES := 51,
   TEMPLATE_PUBLIC_RAM_BYTES := 19,
   TEMPLATE_MODULE_RAM_BYTES := 70
};

alias TEMPLATE_OBJECT_PLAYER0 0
alias TEMPLATE_OBJECT_PLAYER1 1
alias TEMPLATE_OBJECT_MISSILE0 2
alias TEMPLATE_OBJECT_MISSILE1 3
alias TEMPLATE_OBJECT_BALL 4
alias TEMPLATE_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

alias TEMPLATE_PLAYER0_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER0]
alias TEMPLATE_PLAYER1_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER1]
alias TEMPLATE_MISSILE0_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE0]
alias TEMPLATE_MISSILE1_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE1]
alias TEMPLATE_BALL_X TEMPLATE_object_x[TEMPLATE_OBJECT_BALL]

extern const uint8_t TEMPLATE_playfield[48];

uint8_t TEMPLATE_object_x[5];
uint8_t TEMPLATE_player0_y;
uint8_t TEMPLATE_player1_y;
uint8_t TEMPLATE_missile1_height;
uint8_t TEMPLATE_missile1_y;
uint8_t TEMPLATE_ball_y;
uint8_t *TEMPLATE_player0_graphics;
uint8_t *TEMPLATE_player1_graphics;
uint8_t TEMPLATE_player0_height;
uint8_t TEMPLATE_player1_height;
uint8_t TEMPLATE_missile0_height;
uint8_t TEMPLATE_missile0_y;
uint8_t TEMPLATE_ball_height;

uint8_t TEMPLATE_workspace[6];
uint8_t TEMPLATE_playfield_position;
uint8_t TEMPLATE_object_masks[44];

require inline void TEMPLATE_init(void) {
}

require inline void TEMPLATE_vblank(void) {
   asm jsr @TEMPLATE_prepare_object_masks;
   asm jmp @TEMPLATE_prepare_object_masks_done;
   asm @TEMPLATE_prepare_object_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #44;
   asm bcc @clear;
   asm lda #87;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   asm lda #88;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_missile1_y;
   asm ldy.z TEMPLATE_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_missile0_y;
   asm ldy.z TEMPLATE_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_ball_y;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #87;
   asm sta.z TEMPLATE_ball_y;
   asm lda.z TEMPLATE_missile0_y;
   asm sta.z TEMPLATE_workspace + 4;
   asm sec;
   asm sbc #88;
   asm sta.z TEMPLATE_missile0_y;
   asm lda.z TEMPLATE_missile1_y;
   asm sta.z TEMPLATE_workspace + 5;
   asm sec;
   asm sbc #88;
   asm sta.z TEMPLATE_missile1_y;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;
   asm rts;
   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc @no_wrap;
   asm beq @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @wrapped_low_ready;
   asm beq @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @wrapped_high_ready;
   asm beq @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @no_wrap_last_ready;
   asm beq @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc @set_range;
   asm beq @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @TEMPLATE_prepare_object_masks_done:;

   // Position all five objects using the predecessor's exact divide-by-15
   // RESP/HMOVE schedule. Workspace bytes 0..4 hold the fine-motion remainders.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z CXM0P;
   asm @TEMPLATE_horpos_loop:;
      asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_divide_loop:;
   asm sbc #15;
   asm bcs @TEMPLATE_divide_loop;
      asm sta.zx TEMPLATE_workspace,x;
   asm sta RESP0,x;
   asm sta WSYNC;
   asm dex;
   asm bpl @TEMPLATE_horpos_loop;

   asm ldx #4;
      asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm dex;
      asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm dex;
      asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm dex;
      asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm dex;
      asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm sta HMOVE;
   asm jmp @TEMPLATE_horpos_done;
   asm .byte $80,$70,$60,$50,$40,$30,$20,$10,$00;
   asm .byte $f0,$e0,$d0,$c0,$b0,$a0,$90;
   asm @TEMPLATE_repostable:;
   asm @TEMPLATE_horpos_done:;
}

require inline void TEMPLATE_draw(void) {
   asm @kernel:;
   asm sta WSYNC;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
      asm ldx.z TEMPLATE_ball_height;
   asm inx;
   asm inx;
      asm stx.z TEMPLATE_workspace + 3;
      asm lda.z TEMPLATE_player1_y;
      asm sta.z TEMPLATE_workspace + 2;
      asm ldx.z TEMPLATE_missile0_height;
   asm inx;
   asm inx;
      asm stx.z TEMPLATE_object_masks + 3;
      asm lda.z TEMPLATE_player0_y;
   asm ldx #0;
   asm sta WSYNC;
   // Scheduler handoff alignment: preserve the predecessor's cycle-24 PF1 edge.
   asm bit.z CXM0P;
   asm nop;
   asm stx GRP0;
   asm stx GRP1;
   asm stx PF1;
   asm stx PF2;
   asm stx CXCLR;
   asm bit.z CXM0P;
      asm sta.z TEMPLATE_workspace + 1;
   asm ldx #0;
      asm dec.z TEMPLATE_player0_y;
      // The 181-line extraction omits the predecessor's separate final-row DEC,
   // so undo only the 88-line vblank bias before preserving application state.
   asm lda.z TEMPLATE_missile0_y;
   asm clc;
   asm adc #89;
      asm sta.z TEMPLATE_workspace + 4;
   asm nop;
      asm lda.z TEMPLATE_playfield_position;
      asm sta.z TEMPLATE_workspace;
   asm lda #10;
   asm clc;
      asm sbc.z TEMPLATE_playfield_position;
      asm sta.z TEMPLATE_playfield_position;
   asm jmp @startkernel;
   asm .align 256;
   asm @kerloop:;
   asm @continuekernel:;
   asm @continuekernel2:;
      asm lda.z TEMPLATE_object_masks + 23;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty PF2;
      asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm @goback:;
   asm sta ENABL;
   asm @startkernel:;
      asm ldy.z TEMPLATE_player1_y;
   asm dey;
      asm sty.z TEMPLATE_player1_y;
      asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc @drawP1;
      asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @continueP1;
   asm @drawP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @continueP1:;
   asm sta GRP1;
      asm lsr.zx TEMPLATE_object_masks + 1,x;
   asm lda #1;
   asm adc #0;
   asm nop;
   asm sta ENAM1;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
      asm ldy.z TEMPLATE_player0_y;
   asm dey;
      asm sty.z TEMPLATE_player0_y;
      asm cpy.z TEMPLATE_object_masks + 11;
   asm bcc @drawP0;
      asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @continueP0;
   asm @drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @continueP0:;
   asm sta.a GRP0;
      asm lsr.zx TEMPLATE_object_masks + 2,x;
   asm lda #1;
   asm adc #0;
   asm sta.a ENAM0;
      asm dec.z TEMPLATE_workspace;
   asm bne @continuekernel;
   asm @altkernel:;
   // Preserve the sixteenth scanline of the completed playfield row.  The
   // inherited kernel cleared PF1/PF2 here, producing one blank/malformed line
   // at every row boundary.  These eight non-TIA cycles retain the exact
   // schedule and carry state while leaving the row raster intact.
   asm lda #0;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm txa;
   asm adc #4;
   asm tax;
   asm cpx #44;
   asm bcs @lastkernelline;
   asm bit.z CXM0P;
   asm lda #8;
      asm sta.z TEMPLATE_workspace;
      asm lsr.zx TEMPLATE_object_masks - 4,x;
      asm lda.z TEMPLATE_object_masks + 23;
   asm adc #0;
   asm jmp @goback;

   // Enter the predecessor's genuine twelfth 16-line gameplay row.  This is
   // a distinct full-height profile, not the 181-line component plus padding.
   asm @lastkernelline:;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
      asm ldx.z TEMPLATE_playfield_position;
   asm nop;
   asm jmp @enterlastkernel;

   // Keep the final-row loop page-contained.  The unconditional alignment is
   // explicit ROM cost for this profile and is measured by the regression.
   asm .align 256;
   asm @endkerloop:;
   asm nop;
   asm @enterfromNBL:;
   asm ldy.a TEMPLATE_playfield+44;
   asm sty PF1;
   asm ldy.a TEMPLATE_playfield+45;
   asm sty PF2;
   asm ldy.a TEMPLATE_playfield+47;
   asm sty PF1;
   asm ldy.a TEMPLATE_playfield+46;
   asm sty PF2;

   asm @enterlastkernel:;
      asm lda.z TEMPLATE_object_masks + 27;
      asm bit.z TEMPLATE_object_masks + 19;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm sta ENABL;
      asm lda.z TEMPLATE_object_masks + 31;
      asm bit.z TEMPLATE_object_masks + 19;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm sta GRP1;
      asm lda.z TEMPLATE_object_masks + 35;
      asm bit.z TEMPLATE_object_masks + 19;
   asm nop;
   asm dex;
   asm beq @endkernel;

   asm ldy.a TEMPLATE_playfield+44;
   asm sty PF1;
   asm ldy.a TEMPLATE_playfield+45;
   asm sty PF2;
   asm ldy.a TEMPLATE_playfield+47;
   asm sty PF1;
   asm ldy.a TEMPLATE_playfield+46;
   asm sty PF2;
   asm nop;
   asm nop;
   asm sta ENAM1;
      asm lda.z TEMPLATE_object_masks + 39;
      asm bit.z TEMPLATE_object_masks + 19;
      asm bit.z TEMPLATE_object_masks + 19;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta GRP0;
      asm lda.z TEMPLATE_object_masks + 43;
      asm bit.z TEMPLATE_object_masks + 19;
      asm bit.z TEMPLATE_object_masks + 19;
   asm nop;
   asm sta ENAM0;
   asm jmp @endkerloop;

   asm @endkernel:;
   // The 181-line profile returns here and gives these eleven lines to the
   // score component.  The scoreless profile holds the final gameplay state
   // instead, making the gameplay component itself exactly 192 lines.
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm stx PF0;
   asm stx PF1;
   asm stx PF2;
   asm stx GRP0;
   asm stx GRP1;
   asm stx ENAM0;
   asm stx ENAM1;
   asm stx ENABL;
   asm stx VDELBL;
   asm stx VDELP0;
   asm stx VDELP1;
   asm stx HMCLR;
   asm lda #10;
   asm clc;
      asm sbc.z TEMPLATE_playfield_position;
      asm sta.z TEMPLATE_playfield_position;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
   // Restore application coordinates while VBLANK is asserted.  The twelfth
   // gameplay row performs the predecessor's final M0 decrement, hence +89.
      asm lda.z TEMPLATE_workspace + 1;
      asm sta.z TEMPLATE_player0_y;
      asm lda.z TEMPLATE_workspace + 2;
      asm sta.z TEMPLATE_player1_y;
      asm lda.z TEMPLATE_workspace + 5;
      asm sta.z TEMPLATE_missile1_y;
      asm lda.z TEMPLATE_workspace + 4;
      asm sta.z TEMPLATE_missile0_y;
      asm lda.z TEMPLATE_object_masks + 7;
      asm sta.z TEMPLATE_ball_y;
}
