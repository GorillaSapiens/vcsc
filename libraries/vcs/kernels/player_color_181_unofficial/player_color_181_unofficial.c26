// Repeatable unofficial-opcode 181-scanline P0/P1/BL gameplay component with
// page-contained per-row P0/P1 color tables.
//
// This is the measured experimental twin of player_color_181.c26. It uses only
// reviewed stable/common NMOS forms and must be assembled with --illegals.
// Its API, RAM, scanline count, TIA write schedule, row colors, and application
// behavior are intentionally identical to the official component.
//
// Instantiate with:
//
//     template "kernels/player_color_181_unofficial/player_color_181_unofficial.c26" as game
//
// Include vcs.c26 first. Each instance requires page-contained immutable
// INSTANCE_playfield[44], INSTANCE_player0_colors[], and
// INSTANCE_player1_colors[] objects. Graphics and colors share the same
// highest-index-to-zero row order. The component draws exactly 181 gameplay
// scanlines; main() supplies an independent 11-line score above or below it.
// It owns no score/font, VSYNC, VBLANK, or RIOT timer state.

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 181,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0,
   TEMPLATE_OBJECT_COUNT := 3,
   TEMPLATE_PLAYFIELD_BYTES := 44,
   TEMPLATE_PLAYFIELD_ROWS := 11,
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 5,
   TEMPLATE_PRIVATE_RAM_BYTES := 52,
   TEMPLATE_PUBLIC_RAM_BYTES := 13,
   TEMPLATE_MODULE_RAM_BYTES := 65
};

alias TEMPLATE_OBJECT_PLAYER0 0
alias TEMPLATE_OBJECT_PLAYER1 1
alias TEMPLATE_OBJECT_BALL 4
alias TEMPLATE_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
alias TEMPLATE_PLAYER0_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER0]
alias TEMPLATE_PLAYER1_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER1]
alias TEMPLATE_BALL_X TEMPLATE_object_x[TEMPLATE_OBJECT_BALL]

extern const uint8_t TEMPLATE_playfield[44];
extern const uint8_t TEMPLATE_player0_colors[8];
extern const uint8_t TEMPLATE_player1_colors[8];

// Entries 2 and 3 are private ghost coordinates retained by the exact
// five-strobe horizontal-position schedule and are forced to zero in vblank().
uint8_t TEMPLATE_object_x[5];
uint8_t TEMPLATE_player0_y;
uint8_t TEMPLATE_player1_y;
uint8_t TEMPLATE_ball_y;
uint8_t *TEMPLATE_player0_graphics;
uint8_t *TEMPLATE_player1_graphics;
uint8_t TEMPLATE_player0_height;
uint8_t TEMPLATE_player1_height;
uint8_t TEMPLATE_ball_height;

uint8_t TEMPLATE_workspace[5];
uint8_t TEMPLATE_playfield_position;
uint8_t TEMPLATE_object_masks[43];
uint8_t TEMPLATE_player0_latch;

require inline void TEMPLATE_init(void) {
}

require inline void TEMPLATE_vblank(void) {
   asm lda #0;
   asm sta.z TEMPLATE_object_x + 2;
   asm sta.z TEMPLATE_object_x + 3;

   asm jsr @TEMPLATE_prepare_object_masks;
   asm jmp @TEMPLATE_prepare_object_masks_done;
   asm @TEMPLATE_prepare_object_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #44;
   asm bcc @clear;
   asm lda #87;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_ball_y;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #87;
   asm sta.z TEMPLATE_ball_y;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;
   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc @no_wrap;
   asm beq @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @wrapped_low_ready;
   asm beq @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @wrapped_high_ready;
   asm beq @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @no_wrap_last_ready;
   asm beq @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc @set_range;
   asm beq @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs @range_last;
   asm axs #252;
   asm nop;
   asm nop;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm axs #252;
   asm nop;
   asm nop;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @TEMPLATE_prepare_object_masks_done:;

   // Exact retained five-strobe schedule; slots 2 and 3 are ghost missiles.
   asm sta WSYNC;
   asm ldx #4;
   asm nop.z $00;
   asm @TEMPLATE_horpos_loop:;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_divide_loop:;
   asm sbc #15;
   asm bcs @TEMPLATE_divide_loop;
   asm sta.zx TEMPLATE_workspace,x;
   asm sta RESP0,x;
   asm sta WSYNC;
   asm dex;
   asm bpl @TEMPLATE_horpos_loop;
   asm ldx #4;
   asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm dex;
   asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm dex;
   asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm dex;
   asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm dex;
   asm ldy.zx TEMPLATE_workspace,x;
   asm lda @TEMPLATE_repostable-256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #0;
   asm sta ENAM0;
   asm sta ENAM1;
   asm jmp @TEMPLATE_horpos_done;
   asm .byte $80,$70,$60,$50,$40,$30,$20,$10,$00;
   asm .byte $f0,$e0,$d0,$c0,$b0,$a0,$90;
   asm @TEMPLATE_repostable:;
   asm @TEMPLATE_horpos_done:;
}

require inline void TEMPLATE_draw(void) {
   asm @kernel:;
   asm sta WSYNC;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm lda.z TEMPLATE_player1_y;
   asm sta.z TEMPLATE_workspace + 2;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm nop;
   asm lda.z TEMPLATE_player0_y;
   asm ldx #0;
   asm sta WSYNC;
   asm nop.z $00;
   asm nop;
   asm stx GRP0;
   asm stx GRP1;
   asm stx PF1;
   asm stx PF2;
   asm stx CXCLR;
   asm nop.z $00;
   asm sta.z TEMPLATE_workspace + 1;
   asm ldx #0;
   asm dec.z TEMPLATE_player0_y;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm lda.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_workspace;
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_playfield_position;
   asm jmp @startkernel;

   asm .align 256;
   asm @kerloop:;
   asm @continuekernel:;
   asm @continuekernel2:;
   asm lda.z TEMPLATE_object_masks + 23;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty PF2;
   asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm @goback:;
   asm sta ENABL;
   asm @startkernel:;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs @skipP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @continueP1;
   asm @skipP1:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_object_masks + 19;
   asm @continueP1:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.z TEMPLATE_player0_latch;
   asm sta COLUP0;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs @skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @continueP0;
   asm @skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_object_masks + 19;
   asm @continueP0:;
   asm sta.a GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_player0_latch;
   asm clc;
   asm bit.z CXM0P;
   asm dec.z TEMPLATE_workspace;
   asm bne @continuekernel;
   asm @altkernel:;
   // Preserve the sixteenth scanline of the completed playfield row.  The
   // inherited kernel cleared PF1/PF2 here, producing one blank/malformed line
   // at every row boundary.  These eight non-TIA cycles retain the exact
   // schedule and carry state while leaving the row raster intact.
   asm lda #0;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm txa;
   asm adc #4;
   asm tax;
   asm cpx #44;
   asm bcs @lastkernelline;
   asm nop.z $00;
   asm lda #8;
   asm sta.z TEMPLATE_workspace;
   asm lsr.zx TEMPLATE_object_masks - 4,x;
   asm lda.z TEMPLATE_object_masks + 23;
   asm adc #0;
   asm jmp @goback;

   asm @lastkernelline:;
   // Preserve the final gameplay row through the end of its visible line.
   asm sta WSYNC;
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;
   asm lda.z TEMPLATE_workspace + 1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_workspace + 2;
   asm sta.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_ball_y;
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_playfield_position;
   // The boundary move changes the old pre-WSYNC phase by 30 cycles. Keep
   // those cycles on the now-blank cleanup line so the profile remains 181
   // scanlines and returns at the same scheduler boundary.
   asm ldx #5;
   asm @terminal_phase_delay:;
   asm dex;
   asm bne @terminal_phase_delay;
   asm nop;
   asm nop;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
}
