include "vcs.c26"

// OmniCart PHM direct-addressing profile: eight independent 4K logical islands.
// No real hardware currently supports this configuration; it describes the
// planned OMNI memory model and serves as a toolchain certification target.
//
// The $1000 island is ordinary writable cartridge RAM and uses the same public
// `cartram` source qualifier as Superchip and FA/RAM Plus. Its file chunk remains
// fill; initialized DATA uses VCSC's normal ROM load image plus startup copy and
// BSS uses normal startup zeroing.  The remaining seven islands are directly
// addressable ROM.  bank0/$F000 is the startup/home placement island. There are
// no selector hotspots, wrong-bank startup states, reset bridges, or trampolines.
cartridge {
   $fill:0xff $signature:OMNI
   $vectors_offset:0x0ffa $vectors_size:0x0006
};

bank bank7 {
   $image_size:0x1000 $file_index:0 $image_offset:0
   $link_start:0x1000 $cpu_start:0x1000 $map_size:0x1000
};
bank bank6 {
   $image_size:0x1000 $file_index:1 $image_offset:0
   $link_start:0x3000 $cpu_start:0x3000 $map_size:0x1000
};
bank bank5 {
   $image_size:0x1000 $file_index:2 $image_offset:0
   $link_start:0x5000 $cpu_start:0x5000 $map_size:0x1000
};
bank bank4 {
   $image_size:0x1000 $file_index:3 $image_offset:0
   $link_start:0x7000 $cpu_start:0x7000 $map_size:0x1000
};
bank bank3 {
   $image_size:0x1000 $file_index:4 $image_offset:0
   $link_start:0x9000 $cpu_start:0x9000 $map_size:0x1000
};
bank bank2 {
   $image_size:0x1000 $file_index:5 $image_offset:0
   $link_start:0xb000 $cpu_start:0xb000 $map_size:0x1000
};
bank bank1 {
   $image_size:0x1000 $file_index:6 $image_offset:0
   $link_start:0xd000 $cpu_start:0xd000 $map_size:0x1000
};
bank bank0 {
   $image_size:0x1000 $file_index:7 $image_offset:0
   $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $startup
};

mem cartram { $start:0x1000 $size:0x1000 $rw };
mem bank6 { $start:0x3000 $size:0x1000 $ro };
mem bank5 { $start:0x5000 $size:0x1000 $ro };
mem bank4 { $start:0x7000 $size:0x1000 $ro };
mem bank3 { $start:0x9000 $size:0x1000 $ro };
mem bank2 { $start:0xb000 $size:0x1000 $ro };
mem bank1 { $start:0xd000 $size:0x1000 $ro };
mem bank0 { $start:0xf000 $size:0x0ff8 $ro $priority:2 };
