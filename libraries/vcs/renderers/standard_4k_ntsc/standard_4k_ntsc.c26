// Standard NTSC all-five renderer source-integration contract.
//
// The original reference profile is unbanked 4K.  The same contract and
// renderer object may be composed with a generic banked C26 cartridge profile
// when the renderer and every beam-critical ROM object are owned by the startup
// bank.
//
// Include vcs.c26 before this module. The application must define exactly one
// contiguous 48-byte object named vcs_standard_playfield before including this
// file. This selected timing profile requires const uint8_t storage in
// cartridge ROM; its packed object masks leave insufficient RIOT RAM for a
// mutable 48-byte playfield. The renderer binds to the symbol directly, so there
// is no runtime playfield pointer or indirect-load timing penalty.
//
// The mechanically normalized assembly implementation is linked separately.
// Ordinary linker allocation is used except for the explicitly documented
// adjacency and linked-address constraints.

alias VCS_STANDARD_OBJECT_PLAYER0 0
alias VCS_STANDARD_OBJECT_PLAYER1 1
alias VCS_STANDARD_OBJECT_MISSILE0 2
alias VCS_STANDARD_OBJECT_MISSILE1 3
alias VCS_STANDARD_OBJECT_BALL 4

alias VCS_STANDARD_OBJECT_COUNT 5
alias VCS_STANDARD_PLAYFIELD_BYTES 48
alias VCS_STANDARD_PLAYFIELD_ROW_BYTES 4
alias VCS_STANDARD_PLAYFIELD_ROWS 12
alias VCS_STANDARD_PLAYFIELD_COLUMNS 32
alias VCS_STANDARD_DEFAULT_ROW_SCANLINES 16
alias VCS_STANDARD_POINTER_WORKSPACE_BYTES 12
alias VCS_STANDARD_APPLICATION_DISPLAY_RAM_BYTES 23
alias VCS_STANDARD_PRIVATE_RAM_BYTES 57
alias VCS_STANDARD_MODULE_RAM_BYTES 80
alias VCS_STANDARD_HIDDEN_STACK_BYTES 4
alias VCS_STANDARD_SCORE_FONT_BYTES 88

// The retained renderer reads active sprite rows from highest index to zero.
// Applications may write art top-to-bottom through this storage-order helper.
alias VCS_STANDARD_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

// The application-provided ROM storage symbol. It remains an alias rather than
// a declaration so the application supplies the exact 48-byte contents.
alias VCS_STANDARD_PLAYFIELD vcs_standard_playfield

alias VCS_STANDARD_PLAYER0_X vcs_standard_object_x[VCS_STANDARD_OBJECT_PLAYER0]
alias VCS_STANDARD_PLAYER1_X vcs_standard_object_x[VCS_STANDARD_OBJECT_PLAYER1]
alias VCS_STANDARD_MISSILE0_X vcs_standard_object_x[VCS_STANDARD_OBJECT_MISSILE0]
alias VCS_STANDARD_MISSILE1_X vcs_standard_object_x[VCS_STANDARD_OBJECT_MISSILE1]
alias VCS_STANDARD_BALL_X vcs_standard_object_x[VCS_STANDARD_OBJECT_BALL]

// Application-visible display state. The module declares the storage and the
// application owns the values between draw calls.
//
// Indexed together by the horizontal-position loop; keep all five bytes in one
// array so their adjacency is a source-level invariant rather than a linker
// accident.
uint8_t vcs_standard_object_x[VCS_STANDARD_OBJECT_COUNT];

uint8_t vcs_standard_player0_y;
uint8_t vcs_standard_player1_y;
uint8_t vcs_standard_missile1_height;
uint8_t vcs_standard_missile1_y;
uint8_t vcs_standard_ball_y;

// Each indirect player load requires the active sprite rows to remain within a
// single 256-byte page. The pointed graphics storage belongs to the application.
uint8_t *vcs_standard_player0_graphics;
uint8_t *vcs_standard_player1_graphics;

uint8_t vcs_standard_player0_height;
uint8_t vcs_standard_player1_height;
uint8_t vcs_standard_missile0_height;
uint8_t vcs_standard_missile0_y;
uint8_t vcs_standard_ball_height;

bcd24_t vcs_standard_score;
uint8_t vcs_standard_score_color;

// Renderer-private workspace.
//
// Bytes 0..5 are the six score-pointer low bytes. Bytes 6..11 are six transient
// renderer bytes. The retained score pipeline addresses the combined block through
// fixed offsets, so this exact 12-byte adjacency is required.
uint8_t vcs_standard_pointer_workspace[VCS_STANDARD_POINTER_WORKSPACE_BYTES];

uint8_t vcs_standard_playfield_position;

// Packed vertical enable masks for the legal ball/missile paths. Each four-byte
// record covers eight two-line renderer iterations at one playfield X value:
// ball, missile 1, missile 0, private scratch. The first five record-scratch
// bytes retain the converted stack1/stack2 roles, the two exclusive player
// heights, and the permanent player-zero byte. This interleaving reuses bytes
// that indexed mask updates never touch.
uint8_t vcs_standard_object_masks[44];

// Optional end-of-frame gameplay hook. The normalized renderer supplies a weak
// no-op fallback, so applications define this exact void(void) symbol only when
// they need it. It runs once after persistent display state has been restored
// and VBLANK has been asserted; changes therefore apply to the next frame.
// The draw call begins during application-owned overscan and returns after the
// hook, with VBLANK asserted and the overscan timer still running.
//
// The hook is intentionally not declared here.  A banked application may define
// it after this include with a named code-region modifier such as `bank1`; an
// unqualified declaration here would falsely require the definition to use the
// default code region.  The renderer object still supplies a weak no-op fallback.
extern void vcs_standard_renderer_drawscreen(void);
