         ldy.a vcs_standard_playfield-48+4*12+45-0
         sty PF2 ;3
         ldy.a vcs_standard_playfield-48+4*12+47
         sty PF1 ; possibly too early?
         ldy.a vcs_standard_playfield-48+4*12+46-0
         sty PF2 ;3

@enterlastrenderer:
     lda vcs_standard_object_masks + 27
     bit vcs_standard_object_masks + 19
     SLEEP 6
     sta ENABL

     lda vcs_standard_object_masks + 31
     bit vcs_standard_object_masks + 19
     SLEEP 12
     sta GRP1 ;3

         lda vcs_standard_object_masks + 35
         bit vcs_standard_object_masks + 19
