     dex
     ldy vcs_standard_pointer_workspace + 6,X
     lda @repostable-256,Y
     sta HMP0,X ;+14 32

     dex
     ldy vcs_standard_pointer_workspace + 6,X
     lda @repostable-256,Y
     sta HMP0,X ;+14 46

     dex
     ldy vcs_standard_pointer_workspace + 6,X
