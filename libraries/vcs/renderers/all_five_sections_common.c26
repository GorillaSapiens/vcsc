// Internal shared schedule; instantiate one of the public profile wrappers.
include "renderers/all_five_sections_192/palette.c26"
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := TEMPLATE_PROFILE_LINES,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := TEMPLATE_PROFILE_LINES,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := TEMPLATE_SCORE_PROFILE,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := TEMPLATE_SCORE_PROFILE,
   TEMPLATE_VBLANK_MAX_CYCLES := 1824,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 66,
   TEMPLATE_OBJECT_COUNT := 5,
   TEMPLATE_PLAYFIELD_BYTES := TEMPLATE_PF_BYTES,
   TEMPLATE_PLAYFIELD_ROWS := TEMPLATE_PF_ROWS,
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := TEMPLATE_CACHE_BYTES,
   TEMPLATE_PRIVATE_RAM_BYTES := TEMPLATE_PRIVATE_BYTES,
   TEMPLATE_PUBLIC_RAM_BYTES := 21,
   TEMPLATE_MODULE_RAM_BYTES := TEMPLATE_TOTAL_BYTES
};

alias TEMPLATE_OBJECT_PLAYER0 0
alias TEMPLATE_OBJECT_PLAYER1 1
alias TEMPLATE_OBJECT_MISSILE0 2
alias TEMPLATE_OBJECT_MISSILE1 3
alias TEMPLATE_OBJECT_BALL 4
alias TEMPLATE_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
alias TEMPLATE_PLAYER0_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER0]
alias TEMPLATE_PLAYER1_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER1]
alias TEMPLATE_MISSILE0_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE0]
alias TEMPLATE_MISSILE1_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE1]
alias TEMPLATE_BALL_X TEMPLATE_object_x[TEMPLATE_OBJECT_BALL]
alias TEMPLATE_PLAYER0_NUSIZ TEMPLATE_player0_nusiz
alias TEMPLATE_PLAYER1_NUSIZ TEMPLATE_player1_nusiz

extern const uint8_t TEMPLATE_playfield[TEMPLATE_PF_BYTES];



page const uint8_t TEMPLATE_reposition_table[16] := {
   0x80,0x70,0x60,0x50,0x40,0x30,0x20,0x10,
   0x00,0xf0,0xe0,0xd0,0xc0,0xb0,0xa0,0x90
};



uint8_t TEMPLATE_object_x[5];
uint8_t TEMPLATE_player0_y;
uint8_t TEMPLATE_player1_y;
uint8_t TEMPLATE_missile1_height;
uint8_t TEMPLATE_missile1_y;
uint8_t TEMPLATE_ball_y;
uint8_t *TEMPLATE_player0_graphics;
uint8_t *TEMPLATE_player1_graphics;
uint8_t TEMPLATE_player0_height;
uint8_t TEMPLATE_player1_height;
uint8_t TEMPLATE_missile0_height;
uint8_t TEMPLATE_missile0_y;
uint8_t TEMPLATE_ball_height;
uint8_t TEMPLATE_player0_nusiz;
uint8_t TEMPLATE_player1_nusiz;





uint8_t TEMPLATE_object_masks[48];
uint8_t TEMPLATE_row_cache[TEMPLATE_CACHE_BYTES];

require inline void TEMPLATE_init(void) {
   TEMPLATE_validate_profile();
   asm .if TEMPLATE_section1_lines + TEMPLATE_section2_lines + TEMPLATE_section3_lines + TEMPLATE_section4_lines + TEMPLATE_section5_lines + TEMPLATE_section6_lines + TEMPLATE_section7_lines + TEMPLATE_section8_lines != TEMPLATE_SECTION_LINES;
   asm .error "Section heights must total the profile's colourable scanlines";
   asm .endif;
   asm .if TEMPLATE_section1_lines <= 0 || TEMPLATE_section2_lines < 0 || TEMPLATE_section3_lines < 0 || TEMPLATE_section4_lines < 0 || TEMPLATE_section5_lines < 0 || TEMPLATE_section6_lines < 0 || TEMPLATE_section7_lines < 0 || TEMPLATE_section8_lines < 0;
   asm .error "Section heights must be nonnegative and section one nonempty";
   asm .endif;
   asm .if {TEMPLATE_section1_lines | TEMPLATE_section2_lines | TEMPLATE_section3_lines | TEMPLATE_section4_lines | TEMPLATE_section5_lines | TEMPLATE_section6_lines | TEMPLATE_section7_lines | TEMPLATE_section8_lines} & 1;
   asm .error "Section heights must be even";
   asm .endif;
}

require inline void TEMPLATE_vblank(void) {
#if TEMPLATE_SCORE_PROFILE
   COLUPF := TEMPLATE_section1_colupf;
   COLUBK := TEMPLATE_section1_colubk;
#else
   asm lda.a TEMPLATE_sections_pf0;
   asm sta COLUPF;
   asm lda.a TEMPLATE_sections_bk0;
   asm sta COLUBK;
#endif
#if TEMPLATE_SCORE_PROFILE
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 46;
   asm sta.z TEMPLATE_object_masks + 47;
#endif

   asm .callstackextra 4;



   asm jsr @TEMPLATE_prepare_object_masks;
   asm jmp @TEMPLATE_prepare_object_masks_done;
   asm @TEMPLATE_prepare_object_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #TEMPLATE_PF_BYTES;
   asm bcc.same @clear;


   asm lda #TEMPLATE_PAIR_LIMIT;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   asm adc #TEMPLATE_BALL_BIAS;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;

   asm lda #TEMPLATE_MISSILE_LIMIT;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_missile1_y;
#if !TEMPLATE_SCORE_PROFILE
   asm clc;
   asm adc #1;
#endif
   asm ldy.z TEMPLATE_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_missile0_y;
#if !TEMPLATE_SCORE_PROFILE
   asm clc;
   asm adc #1;
#endif
   asm ldy.z TEMPLATE_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;



   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @no_wrap;
   asm beq.same @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq.same @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_low_ready;
   asm beq.same @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_high_ready;
   asm beq.same @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne.same @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @no_wrap_last_ready;
   asm beq.same @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @set_range;
   asm beq.same @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne.same @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs.same @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @TEMPLATE_prepare_object_masks_done:;




   asm ldx #0;
   asm @TEMPLATE_encode_masks:;
   asm asl.zx TEMPLATE_object_masks + 2,x;
   asm lda #0;
   asm rol;
   asm asl.zx TEMPLATE_object_masks + 1,x;
   asm rol;
   asm asl.zx TEMPLATE_object_masks,x;
   asm rol;
   asm asl;
   asm sta.zx TEMPLATE_object_masks + 3,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #TEMPLATE_PF_BYTES;
   asm bcc.same @TEMPLATE_encode_masks;



#if TEMPLATE_SCORE_PROFILE && TEMPLATE_banked_vblank
   asm lda.a TEMPLATE_prepare_playfield;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE;
   asm lda.a TEMPLATE_prepare_playfield + 1;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE + 1;
   asm lda.a TEMPLATE_prepare_playfield + 2;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE + 2;
   asm lda.a TEMPLATE_prepare_playfield + 3;
#else
   asm lda.a TEMPLATE_playfield;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE;
   asm lda.a TEMPLATE_playfield + 1;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE + 1;
   asm lda.a TEMPLATE_playfield + 2;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE + 2;
   asm lda.a TEMPLATE_playfield + 3;
#endif
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE + 3;
   asm lda.z TEMPLATE_object_masks;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE + 4;
   asm lda.z TEMPLATE_object_masks + 1;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE + 5;
   asm lda.z TEMPLATE_object_masks + 2;
   asm sta.z TEMPLATE_row_cache + TEMPLATE_FIRST_CACHE + 6;

   asm lda.z TEMPLATE_player0_y;
#if TEMPLATE_SCORE_PROFILE
   asm sec;
   asm sbc #2;
#endif
   asm sta.z TEMPLATE_object_masks + 0;
   asm lda.z TEMPLATE_player1_y;
#if !TEMPLATE_SCORE_PROFILE
   asm clc;



   asm adc #1;
#endif
   asm sta.z TEMPLATE_object_masks + 1;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 2;



   asm inc.z TEMPLATE_player0_height;
   asm inc.z TEMPLATE_player1_height;



   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #3;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #2;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
#if TEMPLATE_SCORE_PROFILE
   asm lda #0;
   asm sta HMP0;
   asm sta HMP1;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #0;
   asm sta ENAM0;
   asm sta ENAM1;
   asm lda.z TEMPLATE_object_x;
   asm jsr @TEMPLATE_prepare_player_position;
   asm sta.z TEMPLATE_row_cache + 14;
   asm stx.z TEMPLATE_row_cache + 16;
   asm lda #0;
   asm ror;
   asm sta.z TEMPLATE_row_cache + 18;
   asm lda.z TEMPLATE_object_x + 1;
   asm jsr @TEMPLATE_prepare_player_position;
   asm sta.z TEMPLATE_row_cache + 15;
   asm stx.z TEMPLATE_row_cache + 17;
   asm lda #0;
   asm ror;
   asm sta.z TEMPLATE_row_cache + 19;
   asm jmp @TEMPLATE_prepare_player_position_done;
   asm @TEMPLATE_prepare_player_position:;
   asm ldx #0;
   asm sec;
   asm @TEMPLATE_player_position_divide_loop:;
   asm inx;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player_position_divide_loop;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm cpy #$fe;
   asm bcc.same @TEMPLATE_player_position_not_high_gap;
   asm inx;
   asm sec;
   asm sbc #$70;
   asm sec;
   asm rts;
   asm @TEMPLATE_player_position_not_high_gap:;
   asm cpy #$f1;
   asm beq.same @TEMPLATE_player_position_zero_gap;
   asm sec;
   asm sbc #$30;
   asm clc;
   asm rts;
   asm @TEMPLATE_player_position_zero_gap:;
   asm sec;
   asm sbc #$60;
   asm sec;
   asm rts;
   asm @TEMPLATE_prepare_player_position_done:;
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;
#else
   asm sta WSYNC;
   asm ldx #1;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #0;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm sta HMOVE;
   asm lda.z TEMPLATE_player0_nusiz;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_player1_nusiz;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;
   asm stx CXCLR;



   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm lsr.z TEMPLATE_row_cache + 4;

   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm bit.z $00;
   asm nop;
   asm nop;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;


   asm lda.z TEMPLATE_row_cache;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
#endif
}

require inline void TEMPLATE_draw(void) {
   // Normal GRP1/M1 phases: 3/6. Palette stores: 13/20.
   // Packed and row-handoff equivalents: 2/5, 12/19.
   // Right PF2 rewrites finish at cycle 48. Keep all page/.same contracts.



#if TEMPLATE_SCORE_PROFILE
   asm lda.z TEMPLATE_row_cache + 15;
   asm bit.z TEMPLATE_row_cache + 19;
   asm bpl.same @TEMPLATE_player1_position_entry;
   asm @TEMPLATE_player1_position_entry:;
   asm ldx.z TEMPLATE_row_cache + 17;
   asm @TEMPLATE_player1_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_player1_position_loop;
   asm sta RESP1;
   asm sta WSYNC;
   asm sta HMP1;
   asm ldy.z TEMPLATE_row_cache + 14;
   asm bit.z TEMPLATE_row_cache + 18;
   asm bpl.same @TEMPLATE_player0_position_entry;
   asm @TEMPLATE_player0_position_entry:;
   asm ldx.z TEMPLATE_row_cache + 16;
   asm @TEMPLATE_player0_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_player0_position_loop;
   asm sty RESP0;
   asm sty WSYNC;
   asm sty HMP0;
   asm nop;
   asm sty HMOVE;
   asm lda.a TEMPLATE_solid_player_colors;
   asm sta COLUP0;
   asm lda.z TEMPLATE_player0_nusiz;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_player1_nusiz;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx REFP0;
   asm stx REFP1;
   asm stx GRP0;
   asm stx GRP1;
   asm stx PF0;
   asm stx PF1;
   asm stx PF2;
   asm stx CXCLR;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm lda.a TEMPLATE_solid_player_colors + 1;
   asm sta COLUP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   // The score-composable entry's first pair has no M0 priming pixels.
   // Keep the three-cycle load budget; pair one consumes the cached stream.
   asm lda.z TEMPLATE_object_masks + 2;
   asm sta ENAM0;
   asm sta WSYNC;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm nop;
   asm lda.a TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.a TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks;
   asm dey;
