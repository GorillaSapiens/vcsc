require inline void TEMPLATE_overscan(void) {

   asm dec.z TEMPLATE_player0_height;
   asm dec.z TEMPLATE_player1_height;

   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;
}
