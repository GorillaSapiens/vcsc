// Deliberately hostile eleven-line score-profile component for composition tests.
//
// Instantiate with:
//
//     template "renderers/poison_debug_score/poison_debug_score.c26" as poison
//
// Include vcs.c26 first. This is not a user-facing score renderer. It obeys the
// visible/lifecycle ownership rules of a short score component while leaving
// deterministic hostile TIA state behind so the following component cannot
// accidentally rely on friendly register leftovers. Its red background and
// patterned objects make leaked state visually obvious.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 11,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 11,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 0,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0,
   TEMPLATE_PUBLIC_RAM_BYTES := 1,
   TEMPLATE_PRIVATE_RAM_BYTES := 0,
   TEMPLATE_MODULE_RAM_BYTES := 1
};

alias TEMPLATE_RED __builtin_ntsc_rgb(0xff, 0x00, 0x00)
alias TEMPLATE_YELLOW __builtin_ntsc_rgb(0xff, 0xff, 0x00)
alias TEMPLATE_CYAN __builtin_ntsc_rgb(0x00, 0xff, 0xff)

// The score may paint COLUBK while active but restores this value before its
// handoff. P0/P1 state remains deliberately poisoned.
uint8_t TEMPLATE_exit_background;

require inline void TEMPLATE_init(void) {
}

require inline void TEMPLATE_vblank(void) {
}

require inline void TEMPLATE_draw(void) {
   // A score component owns P0/P1 while drawing. Poison every part of that
   // ownership surface, but preserve playfield, missile, and Ball state.
   COLUBK := TEMPLATE_RED;
   COLUP0 := TEMPLATE_CYAN;
   COLUP1 := TEMPLATE_YELLOW;
   NUSIZ0 := 0x37;
   NUSIZ1 := 0x17;
   REFP0 := 0x08;
   REFP1 := 0x08;
   VDELP0 := 1;
   VDELP1 := 1;
   GRP0 := 0xaa;
   GRP1 := 0x55;
   WSYNC := 0;

   // Poison player fine motion and coarse positions. Clear the motion values
   // for objects outside the score contract before HMOVE so they do not move.
   asm lda #$70;
   asm sta HMP0;
   asm lda #$80;
   asm sta HMP1;
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;
   asm lda #$ff;
   asm sta RESP0;
   asm sta RESP1;
   asm sta HMOVE;
   asm sta WSYNC;

   // Hold the hostile score image through line ten.
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;

   // Line eleven flushes delayed player state but deliberately leaves colors,
   // NUSIZ, reflection, position, and motion poisoned for the next component.
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta GRP0;
   asm sta VDELP0;
   asm sta VDELP1;
   asm lda.z TEMPLATE_exit_background;
   asm sta COLUBK;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
}
