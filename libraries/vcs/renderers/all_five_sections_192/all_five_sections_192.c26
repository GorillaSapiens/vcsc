// NTSC 192-line continuous all-five colour sections. See README.md.
parameter section1_lines := 192;
parameter section1_colupf := 0x2e;
parameter section1_colubk := 0x84;
parameter section2_lines := 0;
parameter section2_colupf := 0x46;
parameter section2_colubk := 0xc2;
parameter section3_lines := 0;
parameter section3_colupf := 0x2e;
parameter section3_colubk := 0x84;
parameter section4_lines := 0;
parameter section4_colupf := 0x46;
parameter section4_colubk := 0xc2;
parameter section5_lines := 0;
parameter section5_colupf := 0x2e;
parameter section5_colubk := 0x84;
parameter section6_lines := 0;
parameter section6_colupf := 0x46;
parameter section6_colubk := 0xc2;
parameter section7_lines := 0;
parameter section7_colupf := 0x2e;
parameter section7_colubk := 0x84;
parameter section8_lines := 0;
parameter section8_colupf := 0x46;
parameter section8_colubk := 0xc2;
parameter SCORE_PROFILE := 0;
parameter PROFILE_LINES := 192;
parameter SECTION_LINES := 192;
parameter PF_BYTES := 48;
parameter PF_ROWS := 12;
parameter PRIVATE_BYTES := 62;
parameter TOTAL_BYTES := 83;
parameter CACHE_BYTES := 14;
parameter PAIR_LIMIT := 96;
parameter MISSILE_LIMIT := 95;
parameter BALL_BIAS := 2;
parameter FIRST_CACHE := 0;
parameter TERMINAL_BASE := 44;
include "renderers/all_five_sections_common.c26"

inline void TEMPLATE_validate_profile(void) {
   asm .if TEMPLATE_SCORE_PROFILE != 0 || TEMPLATE_PROFILE_LINES != 192 || TEMPLATE_SECTION_LINES != 192 || TEMPLATE_PF_BYTES != 48 || TEMPLATE_PF_ROWS != 12 || TEMPLATE_PRIVATE_BYTES != 62 || TEMPLATE_TOTAL_BYTES != 83 || TEMPLATE_CACHE_BYTES != 14 || TEMPLATE_PAIR_LIMIT != 96 || TEMPLATE_MISSILE_LIMIT != 95 || TEMPLATE_BALL_BIAS != 2 || TEMPLATE_FIRST_CACHE != 0 || TEMPLATE_TERMINAL_BASE != 44;
   asm .error "Internal profile constants must not be overridden";
   asm .endif;
}
