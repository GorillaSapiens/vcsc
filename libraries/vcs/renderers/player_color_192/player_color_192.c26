// Repeatable official-opcode 192-scanline P0/P1/BL gameplay component
// with page-contained per-row P0/P1 color tables.
//
// Instantiate with:
//
//     template "renderers/player_color_192/player_color_192.c26" as game
//
// Include vcs.c26 first. Each instance requires a page-contained immutable
// INSTANCE_playfield[48]. Player color tables are normally page-contained
// immutable INSTANCE_player0_colors[8] and INSTANCE_player1_colors[8] objects.
// Defining the object-like alias VCS_PLAYER_COLOR_192_MUTABLE_COLORS before
// instantiation instead declares both tables mutable, allowing animation code
// to update them in RAM outside the visible draw. Graphics and colors share the
// same highest-index-to-zero row order. The component draws an exact 192-line
// scoreless gameplay field as twelve uniform 16-line rows. It cannot be combined
// with the independent eleven-line score inside the standard visible field.
//
// It owns no score/font, VSYNC, VBLANK, or RIOT timer state. draw() returns on
// the boundary after the 192nd visible line; overscan() clears gameplay state
// and restores application Y values.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 192,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 192,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 0,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 0,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 66,
   TEMPLATE_OBJECT_COUNT := 3,
   TEMPLATE_PLAYFIELD_BYTES := 48,
   TEMPLATE_PLAYFIELD_ROWS := 12,
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 7,
   TEMPLATE_PRIVATE_RAM_BYTES := 10,
   TEMPLATE_PUBLIC_RAM_BYTES := 13,
   TEMPLATE_MODULE_RAM_BYTES := 23
};

alias TEMPLATE_OBJECT_PLAYER0 0
alias TEMPLATE_OBJECT_PLAYER1 1
alias TEMPLATE_OBJECT_BALL 4
alias TEMPLATE_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
alias TEMPLATE_PLAYER0_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER0]
alias TEMPLATE_PLAYER1_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER1]
alias TEMPLATE_BALL_X TEMPLATE_object_x[TEMPLATE_OBJECT_BALL]
alias TEMPLATE_PLAYER0_NUSIZ TEMPLATE_object_x[2]
alias TEMPLATE_PLAYER1_NUSIZ TEMPLATE_object_x[3]

extern const uint8_t TEMPLATE_playfield[48];
#ifdef VCS_PLAYER_COLOR_192_MUTABLE_COLORS
extern uint8_t TEMPLATE_player0_colors[8];
extern uint8_t TEMPLATE_player1_colors[8];
#else
extern const uint8_t TEMPLATE_player0_colors[8];
extern const uint8_t TEMPLATE_player1_colors[8];
#endif

// Shared fine-motion conversion table. Indexes 1..15 correspond to the
// negative remainder left by the 15-pixel coarse-position loop.
page const uint8_t TEMPLATE_reposition_table[16] := {
   0x80,0x70,0x60,0x50,0x40,0x30,0x20,0x10,
   0x00,0xf0,0xe0,0xd0,0xc0,0xb0,0xa0,0x90
};

// Entries 2 and 3 retain the per-player NUSIZ values that draw() must
// restore after an independent score component has owned P0/P1.
uint8_t TEMPLATE_object_x[5];
uint8_t TEMPLATE_player0_y;
uint8_t TEMPLATE_player1_y;
uint8_t TEMPLATE_ball_y;
uint8_t *TEMPLATE_player0_graphics;
uint8_t *TEMPLATE_player1_graphics;
uint8_t TEMPLATE_player0_height;
uint8_t TEMPLATE_player1_height;
uint8_t TEMPLATE_ball_height;

uint8_t TEMPLATE_workspace[7];
uint8_t TEMPLATE_playfield_position;

require inline void TEMPLATE_init(void) {
   // The private workspace is rebuilt from public state every VBLANK and is
   // dead after overscan restores the public Y coordinates.  Authorize the
   // linker to share it with compiler-owned storage from disjoint frame phases.
   asm .ifndef __phaseworkspace$V1$TEMPLATE_workspace;
   asm __phaseworkspace$V1$TEMPLATE_workspace = 0;
   asm .export __phaseworkspace$V1$TEMPLATE_workspace;
   asm .endif;
}

require inline void TEMPLATE_vblank(void) {
   // The visible loop uses no hidden assembly subroutines.
   asm .callstackextra 0;

   // Preserve application Y coordinates before the visible renderer mutates them.
   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_workspace + 1;
   asm lda.z TEMPLATE_player1_y;
   asm sta.z TEMPLATE_workspace + 2;
   asm lda.z TEMPLATE_ball_y;
   asm sta.z TEMPLATE_workspace + 3;

   // The old visible-entry RESP setup consumed two scanlines before the object
   // raster.  With positioning moved into VBLANK, bias the private working Y
   // coordinates by one so the public coordinate system remains unchanged.
   asm lda.z TEMPLATE_player0_y;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_player1_y;
   asm clc;
   // P1 is staged one two-scanline pair before draw() begins.
   asm adc #2;
   asm sta.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   // Ball is committed on the P1 half through VDELBL, one pair later than
   // the countdown decision that stages ENABL.
   asm adc #2;
   asm sta.z TEMPLATE_ball_y;

   // P0/P1 use the same direct countdown as the visible loop.  Store height+1
   // thresholds because CPY then gives an active result exactly when the
   // decremented row index is in 0..height, including the normal uint8_t wrap.
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_workspace + 5;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_workspace + 6;

   // Position Ball, P1, and P0 entirely during VBLANK using the retained
   // divide-by-fifteen schedule.  The older full-height conversion reused a
   // table calibrated for visible-boundary RESP strobes; moving those strobes
   // into VBLANK without changing the calibration displaced both players.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z CXM0P;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm ldx #1;
   asm bit.z CXM0P;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm ldx #0;
   asm bit.z CXM0P;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda.z TEMPLATE_object_x + 2;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_object_x + 3;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;
   asm stx CXCLR;
   asm dec.z TEMPLATE_player0_y;
   asm lda #8;
   asm sta.z TEMPLATE_workspace;
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_playfield_position;

   // Stage the first half of the ordinary two-line pipeline while VBLANK is
   // still asserted.  draw() can therefore begin with the P0 half at exactly
   // the same phase used after every later row transition; no visible setup
   // scanline is consumed.
   asm dec.z TEMPLATE_ball_y;
   asm lda.z TEMPLATE_ball_height;
   asm cmp.z TEMPLATE_ball_y;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;

   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   asm bcs @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;

   asm ldy #0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_workspace + 4;
   asm sta COLUP0;

   // Prime the left half of the first row while output is blanked.  The right
   // half is installed by the first timed raster line.
   asm lda.a TEMPLATE_playfield;
   asm sta PF1;
   asm lda.a TEMPLATE_playfield + 1;
   asm sta PF2;
}

require inline void TEMPLATE_draw(void) {
   // The first visible line is the P0 half of the normal two-line pipeline.
   // Do the non-display work before the playfield writes so the left and right
   // bytes reach the TIA at the same phases used by the steady-state loop.
   asm lda.z TEMPLATE_workspace + 4;
   asm sta COLUP0;
   asm nop;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   // Fund the ten-cycle HBLANK graphics/color commit without moving either
   // right-playfield write.
   asm nop;
   asm bcs @first_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @first_continueP0;
   asm @first_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @first_continueP0:;
   // Carry the selected P0 graphics byte in A and its color-table index in Y
   // across the pair boundary; DEC/branch do not disturb either register.
   asm dec.z TEMPLATE_workspace;
   asm jmp @continuerenderer;

   asm .align 256;
   asm @kerloop:;
   asm @continuerenderer:;
   // Commit P0 graphics and its matching row color during horizontal blank.
   // The matching two-cycle pad lives after the preceding right-playfield
   // writes, preserving both their phases and the exact 152-cycle pair.
   asm sta GRP0;
#ifdef VCS_PLAYER_COLOR_192_MUTABLE_COLORS
   // VDELP0 delays the graphics until the following GRP1 write. Mutable-color
   // users may change every row between frames, so hold the matching color for
   // that same transfer instead of exposing the next row one scanline early.
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_workspace + 4;
#else
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
#endif
   asm @continuerenderer2:;
   // Keep the historical two-cycle lead-in so the left playfield writes retain
   // their exact phases.  Y is free after PF2, letting LDY/CPY replace the old
   // six-cycle Ball-mask shift without disturbing A=#1 for the carry conversion.
   asm lda #1;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm ldy.z TEMPLATE_ball_height;
   asm cpy.z TEMPLATE_ball_y;
   asm adc #0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm @goback:;
   asm @startrenderer:;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
#ifdef VCS_PLAYER_COLOR_192_MUTABLE_COLORS
   // Keep the original 26-cycle tail, but install the delayed P0 color just
   // before GRP1 transfers the pending P0 graphics. Reloading P1 graphics after
   // its color lookup frees workspace+4 for that delayed P0 color.
   asm bcs @skipP1;
   asm lda.z TEMPLATE_workspace + 4;
   asm sta COLUP0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm jmp @continueP1;
   asm @skipP1:;
   asm ldy #0;
   asm lda.z TEMPLATE_workspace + 4;
   asm sta COLUP0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm sta GRP1;
   asm bit.z TEMPLATE_workspace + 5;
   asm @continueP1:;
#else
   asm bcs @skipP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @continueP1;
   asm @skipP1:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @continueP1:;
   // Stage P1 in otherwise-unused workspace and commit it only after both
   // player colors are installed.  The GRP1 write then lands in horizontal
   // blanking; because VDELP0 is active, this also transfers the pending P0
   // graphics without changing either player during the visible right edge.
   asm sta.z TEMPLATE_workspace + 4;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.z TEMPLATE_workspace + 4;
   asm sta GRP1;
#endif

   asm @p0renderer:;
   // P0 half. Move eleven cycles of P0 bookkeeping ahead of the playfield
   // writes. The five-cycle direct Ball decrement occupies the old BIT/NOP pad,
   // so the pair remains exactly 152 cycles without an object-mask shift.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm nop;
   asm bcs @skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @continueP0;
   asm @skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @continueP0:;
   // Carry the selected P0 graphics byte in A and its color-table index in Y
   // across the pair boundary; DEC/branch do not disturb either register.
   asm dec.z TEMPLATE_workspace;
   asm bne.same @continuerenderer;
   // The row-ending fallthrough uses the same ten-cycle commit.  Its matching
   // pad already ran after the right-playfield writes, so GRP0 reaches the next
   // horizontal blank without changing the row-transition phase.
   asm sta GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   // Keep the row-boundary entry at the same phase as the proven mask-based
   // renderer.  This store is redundant as color state, but its three cycles
   // are beam timing: without them the boundary playfield line is visibly torn.
   asm sta COLUP0;

   // The sixteenth line of a row is a P1 half.  Draw the old row one last time,
   // advance X in the gap between the left and right playfield writes, and then
   // prepare the first P0 half of the next row without consuming a scanline.
   asm @altrenderer:;
   // The preceding P0 half left its next delayed color in A.  Install it before
   // drawing the boundary line so a row transition cannot skip a color-table
   // entry.
   asm sta COLUP0;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm cpx #44;
   asm beq @terminalrenderer;
   // Keep both old-row right bytes in registers while X advances.  This is the
   // proven row-boundary playfield schedule: PF1/PF2 left at 18/25 and PF2/PF1
   // right at 48/55 in Stella's physical scanline phase.
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm inx;
   asm inx;
   asm inx;
   asm sty.a PF2;
   asm inx;
   asm nop;
   asm sta PF1;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   // The old sparse Ball mask spent six cycles producing carry here.  Direct
   // countdown can produce the identical carry in the same six cycles with
   // LDA/CMP, so the playfield schedule does not need to move.  The active P1
   // path commits GRP1 first to preserve its graphics byte in A; the compare
   // follows immediately and still precedes the next line's ENABL materialization.
   asm bcc @transition_activeP1;
   asm ldy #0;
   asm lda.z TEMPLATE_ball_height;
   asm cmp.z TEMPLATE_ball_y;
   asm sty.a GRP1;
   asm jmp @transition_continueP1;
   asm @transition_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_ball_height;
   asm cmp.z TEMPLATE_ball_y;
   asm @transition_continueP1:;
   // Preserve the P1 color in A before the next line reuses Y.  CMP leaves the
   // direct-count Ball decision in carry; the next P0 half materializes that
   // carry into ENABL in the original seven-cycle slot.  Keeping Ball work out
   // of the boundary PF window preserves the proven 18/25/48/55 physical
   // playfield phases.
   asm lda.ay TEMPLATE_player1_colors,y;

   // First P0 half after a row transition.  Its four playfield writes must land
   // at the same phases as every steady scanline.
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm sta COLUP1;
   // Materialize the direct-count Ball carry in the same seven-cycle slot used
   // by the original mask renderer.  LDA/ADC/STA preserve the proven PF phases.
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta.a PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   // Save the decremented P0 index only after the beam-critical writes.  The
   // absolute store also preserves the established row-transition phase.
   asm sty.a TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm bcs @transition_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @transition_continueP0;
   asm @transition_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @transition_continueP0:;
   asm sta.a GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;

   // Fall directly into the first P1 half.  The remaining-pair counter is set
   // after the four display writes so this line reaches the same safe phases as
   // the steady lines without changing the total pair length.
   asm @transition_firstP1:;
   asm lda.z TEMPLATE_ball_height;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm dec.z TEMPLATE_ball_y;
   asm cmp.z TEMPLATE_ball_y;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
   asm lda #7;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm sta.z TEMPLATE_workspace;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   asm bcc @transition_first_activeP1;
   asm lda #0;
   asm sta GRP1;
   asm bit.z TEMPLATE_workspace + 5;
   asm nop;
   asm bit.z TEMPLATE_workspace + 5;
   asm jmp @transition_first_doneP1;
   asm @transition_first_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm @transition_first_doneP1:;

   // Fall directly into a P0 half.  Duplicating this one body avoids the
   // three-cycle jump that would otherwise shift every later row.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm bcs @transition_follow_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @transition_follow_continueP0;
   asm @transition_follow_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @transition_follow_continueP0:;
   asm dec.z TEMPLATE_workspace;
   asm bne @continuerenderer;
   asm jmp @altrenderer;

   // The final row needs no object setup for a following line.  Finish its
   // reflected right half, then WSYNC through the remainder of visible line
   // 231.  draw() therefore returns at cycle zero of line 232 and the caller's
   // immediate VBLANK write cannot leave a partially drawn extra scanline.
   asm @terminalrenderer:;
   asm bit.z CXM0P;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm bit.z CXM0P;
   asm nop;
   asm sty PF2;
   asm bit.z CXM0P;
   asm sta.a PF1;
   asm sta WSYNC;

   asm @endrenderer:;
}

require inline void TEMPLATE_overscan(void) {
   // VBLANK is asserted before this callback, so display-state cleanup cannot
   // cut a visible scanline short.  Restore the caller's playfield position
   // here rather than at the end of draw(): those ten cycles previously delayed
   // the VBLANK assertion into the first visible pixels of line 232, producing a
   // partially drawn extra scanline in Stella.
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_playfield_position;

   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;

   asm lda.z TEMPLATE_workspace + 1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_workspace + 2;
   asm sta.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_workspace + 3;
   asm sta.z TEMPLATE_ball_y;
}
