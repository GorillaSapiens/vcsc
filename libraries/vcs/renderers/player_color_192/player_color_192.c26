// Repeatable official-opcode 192-scanline P0/P1/BL gameplay component
// with page-contained per-row P0/P1 color tables.
//
// Instantiate with:
//
//     template "renderers/player_color_192/player_color_192.c26" as game
//
// Include vcs.c26 first. Each instance requires page-contained immutable
// INSTANCE_playfield[48], INSTANCE_player0_colors[], and
// INSTANCE_player1_colors[] objects. Graphics and colors share the same
// highest-index-to-zero row order. The component draws an exact 192-line
// scoreless gameplay field as twelve uniform 16-line rows. It cannot be combined
// with the independent eleven-line score inside the standard visible field.
//
// It owns no score/font, VSYNC, VBLANK, or RIOT timer state. draw() returns on
// the boundary after the 192nd visible line; overscan() clears gameplay state
// and restores application Y values.

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 192,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 56,
   TEMPLATE_OBJECT_COUNT := 3,
   TEMPLATE_PLAYFIELD_BYTES := 48,
   TEMPLATE_PLAYFIELD_ROWS := 12,
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 5,
   TEMPLATE_PRIVATE_RAM_BYTES := 57,
   TEMPLATE_PUBLIC_RAM_BYTES := 13,
   TEMPLATE_MODULE_RAM_BYTES := 70
};

alias TEMPLATE_OBJECT_PLAYER0 0
alias TEMPLATE_OBJECT_PLAYER1 1
alias TEMPLATE_OBJECT_BALL 4
alias TEMPLATE_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
alias TEMPLATE_PLAYER0_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER0]
alias TEMPLATE_PLAYER1_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER1]
alias TEMPLATE_BALL_X TEMPLATE_object_x[TEMPLATE_OBJECT_BALL]
alias TEMPLATE_PLAYER0_NUSIZ TEMPLATE_object_x[2]
alias TEMPLATE_PLAYER1_NUSIZ TEMPLATE_object_x[3]

extern const uint8_t TEMPLATE_playfield[48];
extern const uint8_t TEMPLATE_player0_colors[8];
extern const uint8_t TEMPLATE_player1_colors[8];

// Shared fine-motion conversion table. Indexes 1..15 correspond to the
// negative remainder left by the 15-pixel coarse-position loop.
page const uint8_t TEMPLATE_reposition_table[16] := {
   0x80,0x70,0x60,0x50,0x40,0x30,0x20,0x10,
   0x00,0xf0,0xe0,0xd0,0xc0,0xb0,0xa0,0x90
};

// Entries 2 and 3 retain the per-player NUSIZ values that draw() must
// restore after an independent score component has owned P0/P1.
uint8_t TEMPLATE_object_x[5];
uint8_t TEMPLATE_player0_y;
uint8_t TEMPLATE_player1_y;
uint8_t TEMPLATE_ball_y;
uint8_t *TEMPLATE_player0_graphics;
uint8_t *TEMPLATE_player1_graphics;
uint8_t TEMPLATE_player0_height;
uint8_t TEMPLATE_player1_height;
uint8_t TEMPLATE_ball_height;

uint8_t TEMPLATE_workspace[5];
uint8_t TEMPLATE_playfield_position;
uint8_t TEMPLATE_object_masks[48];
uint8_t TEMPLATE_player0_latch;

require inline void TEMPLATE_init(void) {
}

require inline void TEMPLATE_vblank(void) {
   // Preserve application Y coordinates before the visible renderer mutates them.
   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_workspace + 1;
   asm lda.z TEMPLATE_player1_y;
   asm sta.z TEMPLATE_workspace + 2;
   asm lda.z TEMPLATE_ball_y;
   asm sta.z TEMPLATE_workspace + 3;

   // The old visible-entry RESP setup consumed two scanlines before the object
   // raster.  With positioning moved into VBLANK, bias the private working Y
   // coordinates by one so the public coordinate system remains unchanged.
   asm lda.z TEMPLATE_player0_y;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_player1_y;
   asm clc;
   // P1 is staged one two-scanline pair before draw() begins.
   asm adc #2;
   asm sta.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_ball_y;

   asm jsr @TEMPLATE_prepare_object_masks;
   asm jmp @TEMPLATE_prepare_object_masks_done;
   asm @TEMPLATE_prepare_object_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #48;
   asm bcc @clear;
   // The uniform 12-row loop addresses all 96 two-scanline pairs.
   asm lda #95;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;

   // No special terminal row is required: Ball, P0, and P1 all remain in
   // the ordinary raster pipeline through row twelve.
   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc @no_wrap;
   asm beq @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @wrapped_low_ready;
   asm beq @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @wrapped_high_ready;
   asm beq @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc @no_wrap_last_ready;
   asm beq @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc @set_range;
   asm beq @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @TEMPLATE_prepare_object_masks_done:;

   // Position Ball, P1, and P0 entirely during VBLANK using the retained
   // divide-by-fifteen schedule.  The older full-height conversion reused a
   // table calibrated for visible-boundary RESP strobes; moving those strobes
   // into VBLANK without changing the calibration displaced both players.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z CXM0P;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm ldx #1;
   asm bit.z CXM0P;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm ldx #0;
   asm bit.z CXM0P;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda.z TEMPLATE_object_x + 2;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_object_x + 3;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;
   asm stx CXCLR;
   asm dec.z TEMPLATE_player0_y;
   asm lda #8;
   asm sta.z TEMPLATE_workspace;
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_playfield_position;

   // Stage the first half of the ordinary two-line pipeline while VBLANK is
   // still asserted.  draw() can therefore begin with the P0 half at exactly
   // the same phase used after every later row transition; no visible setup
   // scanline is consumed.
   asm lda.z TEMPLATE_object_masks + 23;
   asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm sta ENABL;

   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;

   asm ldy #0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_player0_latch;
   asm sta COLUP0;

   // Prime the left half of the first row while output is blanked.  The right
   // half is installed by the first timed raster line.
   asm lda.a TEMPLATE_playfield;
   asm sta PF1;
   asm lda.a TEMPLATE_playfield + 1;
   asm sta PF2;
}

require inline void TEMPLATE_draw(void) {
   // The scheduler enters at cycle 3.  This harmless three-cycle read places
   // the first P0-half body at the exact phase used by every later row start.
   // VBLANK already staged P1, Ball, and the left playfield half.
   asm bit.z CXM0P;
   asm lda.z TEMPLATE_player0_latch;
   asm sta COLUP0;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs @first_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @first_continueP0;
   asm @first_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_object_masks + 19;
   asm @first_continueP0:;
   asm sta.a GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_player0_latch;
   asm clc;
   asm bit.z CXM0P;
   asm dec.z TEMPLATE_workspace;
   // VBLANK initializes this counter to eight, so the first half always
   // continues into the ordinary row body.  Use an absolute jump because a
   // relative branch across the page alignment is not range-stable.
   asm jmp @continuerenderer;

   asm .align 256;
   asm @kerloop:;
   asm @continuerenderer:;
   asm @continuerenderer2:;
   asm lda.z TEMPLATE_object_masks + 23;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty PF2;
   asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm @goback:;
   asm sta ENABL;
   asm @startrenderer:;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs @skipP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @continueP1;
   asm @skipP1:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_object_masks + 19;
   asm @continueP1:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.z TEMPLATE_player0_latch;
   asm sta COLUP0;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs @skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @continueP0;
   asm @skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_object_masks + 19;
   asm @continueP0:;
   asm sta.a GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_player0_latch;
   asm clc;
   asm bit.z CXM0P;
   asm dec.z TEMPLATE_workspace;
   asm bne @continuerenderer;

   asm @altrenderer:;
   // This line is the sixteenth scanline of the completed row.  Leave all TIA
   // display state untouched while selecting the next four-byte row.
   asm lda #0;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm txa;
   asm adc #4;
   asm tax;
   asm cpx #48;
   asm bcs @endrenderer;
   asm bit.z CXM0P;
   asm lda #8;
   asm sta.z TEMPLATE_workspace;
   asm lsr.zx TEMPLATE_object_masks - 4,x;
   asm lda.z TEMPLATE_object_masks + 23;
   asm adc #0;
   asm jmp @goback;

   asm @endrenderer:;
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_playfield_position;
   // Start the sixteenth scanline of row twelve, then account for the
   // generated return path so begin_overscan writes VBLANK at line 232 rather
   // than at the extreme right edge of visible line 231.
   asm sta WSYNC;
   asm bit.z CXM0P;
}

require inline void TEMPLATE_overscan(void) {
   // VBLANK is asserted before this callback, so display-state cleanup cannot
   // cut a visible scanline short.
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;

   asm lda.z TEMPLATE_workspace + 1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_workspace + 2;
   asm sta.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_workspace + 3;
   asm sta.z TEMPLATE_ball_y;
}
