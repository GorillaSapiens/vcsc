;*************************************************************************

;-------------------------------------------------------------------------
;----------------------Begin Subroutines----------------------------------
;-------------------------------------------------------------------------




RendererCleanupSubroutine:

	ldx #4
AdjustYValuesDownLoop:
	lda vcs_multisprite_state + 14,X
	sec
	sbc #2
	sta vcs_multisprite_state + 14,X
	dex
	bpl AdjustYValuesDownLoop


 RETURN
	;rts

SetupP1Subroutine:
; flickersort algorithm
; count 4-0
; table2=table1 (?)
; detect overlap of sprites in table 2
; if overlap, do regular sort in table2, then place one sprite at top of table 1, decrement # displayed
; if no overlap, do regular sort in table 2 and table 1
fsstart:
 ldx #255
copytable:
 inx
 lda vcs_multisprite_state + 113,x
 sta vcs_multisprite_state + 29,x
 cpx #4
 bne copytable

 stx vcs_multisprite_state + 77 ; highest displayed sprite
 dex
 stx vcs_multisprite_state + 76
sortloop:
 ldx vcs_multisprite_state + 76
 lda vcs_multisprite_state + 113,x
 tax
 lda vcs_multisprite_state + 14,x
 sta vcs_multisprite_state + 75

 ldx vcs_multisprite_state + 76
 lda vcs_multisprite_state + 113+1,x
 tax
 lda vcs_multisprite_state + 14,x
 sec
 clc
 sbc vcs_multisprite_state + 75
 bcc largerXislower

; larger x is higher (A>=temp1)
 cmp vcs_multisprite_state + 49,x
 bcs countdown
; overlap with x+1>x
; 
; stick x at end of gfxtable, dec counter
overlapping:
 dec vcs_multisprite_state + 77
 ldx vcs_multisprite_state + 76
; inx
 jsr shiftnumbers
 jmp skipswapGfxtable

largerXislower:; (temp1>A)
 tay
 ldx vcs_multisprite_state + 76
 lda vcs_multisprite_state + 113,x
 tax
 tya
 eor #$FF
 sbc #1
 bcc overlapping
 cmp vcs_multisprite_state + 49,x
 bcs notoverlapping

 dec vcs_multisprite_state + 77
 ldx vcs_multisprite_state + 76
; inx
 jsr shiftnumbers
 jmp skipswapGfxtable 
notoverlapping:
; ldx temp2 ; swap display table
; ldy SpriteGfxIndex+1,x
; lda SpriteGfxIndex,x
; sty SpriteGfxIndex,x
; sta SpriteGfxIndex+1,x 

skipswapGfxtable:
 ldx vcs_multisprite_state + 76 ; swap sort table
 ldy vcs_multisprite_state + 113+1,x
 lda vcs_multisprite_state + 113,x
 sty vcs_multisprite_state + 113,x
 sta vcs_multisprite_state + 113+1,x 

countdown:
 dec vcs_multisprite_state + 76
 bpl sortloop

checktoohigh:
 ldx vcs_multisprite_state + 77
 lda vcs_multisprite_state + 29,x
 tax
 lda vcs_multisprite_state + 14,x
 cmp #$55
 bcc nonetoohigh
 dec vcs_multisprite_state + 77
 bne checktoohigh

nonetoohigh:
 rts


shiftnumbers:
 ; stick current x at end, shift others down
 ; if x=4: don't do anything
 ; if x=3: swap 3 and 4
 ; if x=2: 2=3, 3=4, 4=2
 ; if x=1: 1=2, 2=3, 3=4, 4=1
 ; if x=0: 0=1, 1=2, 2=3, 3=4, 4=0
; ldy SpriteGfxIndex,x
swaploop:
 cpx #4
 beq shiftdone 
 lda vcs_multisprite_state + 29+1,x
 sta vcs_multisprite_state + 29,x
 inx
 jmp swaploop
shiftdone:
; sty SpriteGfxIndex,x
 rts


    ;echo "Multi-sprite renderer ends at ", *

    

