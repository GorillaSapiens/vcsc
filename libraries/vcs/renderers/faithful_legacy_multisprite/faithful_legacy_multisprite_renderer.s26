; Canonical TIA/RIOT addresses used by the selected source.
VSYNC    = $0000
VBLANK   = $0001
WSYNC    = $0002
NUSIZ0   = $0004
NUSIZ1   = $0005
COLUP0   = $0006
COLUP1   = $0007
COLUPF   = $0008
COLUBK   = $0009
PF0      = $000D
PF1      = $000E
PF2      = $000F
RESP0    = $0010
RESP1    = $0011
REFP0    = $000B
REFP1    = $000C
RESM0    = $0012
RESM1    = $0013
RESBL    = $0014
GRP0     = $001B
GRP1     = $001C
ENAM0    = $001D
ENAM1    = $001E
ENABL    = $001F
HMP0     = $0020
HMP1     = $0021
HMM0     = $0022
HMM1     = $0023
HMBL     = $0024
VDELP0   = $0025
VDELP1   = $0026
VDELBL   = $0027
HMOVE    = $002A
HMCLR    = $002B
CXCLR    = $002C
INTIM    = $0284
TIM64T   = $0296

