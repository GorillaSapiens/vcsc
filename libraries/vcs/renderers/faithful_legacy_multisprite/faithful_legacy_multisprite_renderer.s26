.segment "RENDERER_CODE"
; This file is covered under CC0-1.0. See libraries/LICENSE.txt.


    ;echo "Multi-sprite renderer starts at ", *

PFStart:
 .byte 87,43,0,21,0,0,0,10
blank_pf:
 .byte 0,0,0,0,0,0,0,5
; .byte 43,21,0,10,0,0,0,5
	;--set initial P1 positions
vcs_multisprite_setup:
 lda #15
 sta vcs_multisprite_state + 68

	ldx #4
; stx temp3
SetCopyHeight:
;	lda #76
;	sta NewSpriteX,X
;	lda CopyColorData,X
;	sta NewCOLUP1,X
 ;lda SpriteHeightTable,X
; sta spriteheight,x
	txa
	sta vcs_multisprite_state + 29,X
	sta vcs_multisprite_state + 113,X
	dex
	bpl SetCopyHeight



; since we can't turn off pf, point PF to zeros here
 lda #>blank_pf
 sta vcs_multisprite_state + 61+1
 sta vcs_multisprite_state + 59+1
 lda #<blank_pf
 sta vcs_multisprite_state + 61
 sta vcs_multisprite_state + 59
 rts

vcs_multisprite_drawscreen:

WaitForOverscanEnd:
	lda INTIM
	bmi WaitForOverscanEnd

	lda #2
	sta WSYNC
	sta VSYNC
	sta WSYNC
	sta WSYNC
	lsr
	sta VDELBL
	sta VDELP0
	sta WSYNC
	sta VSYNC	;turn off VSYNC
	lda #42+128
	sta TIM64T

; run possible vblank bB code

 	jsr setscorepointers
	jsr SetupP1Subroutine

	;-------------





	;--position P0, M0, M1, BL

	jsr PrePositionAllObjects

	;--set up player 0 pointer

 dec vcs_multisprite_state + 13
	lda vcs_multisprite_state + 34 ; player0: must be run every frame!
	sec
	sbc vcs_multisprite_state + 13
	clc
	adc vcs_multisprite_state + 48
	sta vcs_multisprite_state + 34

	lda vcs_multisprite_state + 13
	sta vcs_multisprite_state + 79
	sec
	sbc vcs_multisprite_state + 48
	clc
	adc #$80
	sta vcs_multisprite_state + 36
	

	;--some final setup

 ldx #4
 lda #$80
cycle74_HMCLR:
 sta HMP0,X
 dex
 bpl cycle74_HMCLR
;	sta HMCLR


	lda #0
	sta PF1
	sta PF2
	sta GRP0
	sta GRP1


	jsr RendererSetupSubroutine

WaitForVblankEnd:
	lda INTIM
	bmi WaitForVblankEnd
        lda #0
	sta WSYNC
	sta VBLANK	;turn off VBLANK - it was turned on by overscan
	sta CXCLR


	jmp RendererRoutine


PositionASpriteSubroutine:;call this function with A == horizontal position (0-159)
				;and X == the object to be positioned (0=P0, 1=P1, 2=M0, etc.)
				;if you do not wish to write to P1 during this function, make
				;sure Y==0 before you call it.  This function will change Y, and A
				;will be the value put into HMxx when returned.
				;Call this function with at least 11 cycles left in the scanline 
				;(jsr + sec + sta WSYNC = 11); it will return 9 cycles
				;into the second scanline
	sec
	sta WSYNC			;begin line 1
	sta.a HMCLR			;+4	 4
DivideBy15Loop:
	sbc #15
	bcs DivideBy15Loop			;+4/5	8/13.../58

	tay				;+2	10/15/...60
	lda FineAdjustTableEnd,Y	;+5	15/20/...65

			;	15
	sta HMP0,X	;+4	19/24/...69
	sta RESP0,X	;+4	23/28/33/38/43/48/53/58/63/68/73
	sta WSYNC	;+3	 0	begin line 2
	sta HMOVE	;+3
	rts		;+6	 9

;-------------------------------------------------------------------------

PrePositionAllObjects:

	ldx #4
	lda vcs_multisprite_state + 2
	jsr PositionASpriteSubroutine
	
	dex
	lda vcs_multisprite_state + 1
	jsr PositionASpriteSubroutine
	
	dex
	lda vcs_multisprite_state + 0
	jsr PositionASpriteSubroutine

	dex
	dex
	lda vcs_multisprite_state + 4
	jsr PositionASpriteSubroutine

	rts



;-------------------------------------------------------------------------


RendererSetupSubroutine:

	ldx #4
AdjustYValuesUpLoop:
	lda vcs_multisprite_state + 14,X
	clc
	adc #2
	sta vcs_multisprite_state + 14,X
	dex
	bpl AdjustYValuesUpLoop


	ldx vcs_multisprite_state + 77 ; first sprite displayed

	lda vcs_multisprite_state + 29,x
	tay
	lda vcs_multisprite_state + 14,y
	sta vcs_multisprite_state + 78

	lda vcs_multisprite_state + 29-1,x
	tay
	lda vcs_multisprite_state + 14,y
	sta vcs_multisprite_state + 80

	stx vcs_multisprite_state + 3



	lda #255
	sta vcs_multisprite_state + 37

	lda vcs_multisprite_state + 13
	cmp #$59
	bcc nottoohigh
	lda vcs_multisprite_state + 36
	sta vcs_multisprite_state + 79		

       

nottoohigh:
	rts

;-------------------------------------------------------------------------





;*************************************************************************

;-------------------------------------------------------------------------
;-------------------------Data Below--------------------------------------
;-------------------------------------------------------------------------

MaskTable:
	.byte 1,3,7,15,31

 ; shove 6-digit score routine here

sixdigscore:
	lda #0
;	sta COLUBK
	sta PF0
	sta PF1
	sta PF2
	sta ENABL
	sta ENAM0
	sta ENAM1
	;end of renderer here


 ; 6 digit score routine
; lda #0
; sta PF1
; sta PF2
; tax

   sta WSYNC;,x

;                STA WSYNC ;first one, need one more
 sta REFP0
 sta REFP1
                STA GRP0
                STA GRP1
 sta HMCLR

 ; restore P0pointer

	lda vcs_multisprite_state + 34
	clc
	adc vcs_multisprite_state + 13
	sec
	sbc vcs_multisprite_state + 48
	sta vcs_multisprite_state + 34
 inc vcs_multisprite_state + 13

	lda  #52+128

	sta  TIM64T

; score pointers contain:
; score1-5: lo1,lo2,lo3,lo4,lo5,lo6
; swap lo2->temp1
; swap lo4->temp3
; swap lo6->temp5

 lda vcs_multisprite_state + 69+5
 sta vcs_multisprite_state + 79
 lda vcs_multisprite_state + 69+1
 sta vcs_multisprite_state + 75
 lda vcs_multisprite_state + 69+3
 sta vcs_multisprite_state + 77

 lda #>scoretable
 sta vcs_multisprite_state + 69+1
 sta vcs_multisprite_state + 69+3
 sta vcs_multisprite_state + 69+5
 sta vcs_multisprite_state + 76
 sta vcs_multisprite_state + 78
 sta vcs_multisprite_state + 80

 rts

;------------------------------------------------------------------------
;-- FineAdjustTable - HMove table
;--
;-- NOTE:  This table needs to be here to prevent interference with
;--        the superchip due to the forced page-crossing used when
;--        accessing this table.

FineAdjustTableBegin:
	.byte %01100000		;left 6
	.byte %01010000
	.byte %01000000
	.byte %00110000
	.byte %00100000
	.byte %00010000
	.byte %00000000		;left 0
	.byte %11110000
	.byte %11100000
	.byte %11010000
	.byte %11000000
	.byte %10110000
	.byte %10100000
	.byte %10010000
	.byte %10000000		;right 8
FineAdjustTableEnd	=	FineAdjustTableBegin - 241

    ;--- DEBUG: use the following echo statements to make sure page-crossing occurs
    ;echo "FineAdjustTable at      ", FineAdjustTableBegin
    ;echo " but is referenced from ", FineAdjustTableEnd

;-------------------------------------------------------------------------
;----------------------Renderer Routine-------------------------------------
;-------------------------------------------------------------------------


;-------------------------------------------------------------------------
; repeat $f147-*
; brk
; repend
;	org $F240

SwitchDrawP0K1:;	72
	lda vcs_multisprite_state + 36
	sta vcs_multisprite_state + 79			;+6	 2
	jmp BackFromSwitchDrawP0K1	;+3	 5

WaitDrawP0K1:;	74
	SLEEP 4				;+4	 2
	jmp BackFromSwitchDrawP0K1	;+3	 5

SkipDrawP1K1:;	11
	lda #0
	sta GRP1			;+5	16	so Ball gets drawn
	jmp BackFromSkipDrawP1		;+3	19

;-------------------------------------------------------------------------

RendererRoutine:
 SLEEP 12
 ; jsr wastetime ; waste 12 cycles
	tsx
	stx vcs_multisprite_state + 118
	ldx #ENABL
	txs			;+9	 9

 ldx #0
 lda vcs_multisprite_state + 68
 bpl asdhj
 .byte $24
asdhj:
 tax

; ldx pfheight
 lda PFStart,x ; get pf pixel resolution for heights 15,7,3,1,0

 
 sta vcs_multisprite_state + 58

	ldy #88
 
;	lda #$02
;	sta COLUBK		;+5	18

; sleep 25
 SLEEP 2
RendererLoopa:;	50
	SLEEP 7			;+4	54
RendererLoopb:;	54
	SLEEP 2		;+12	66
	cpy vcs_multisprite_state + 79		;+3	69
	beq SwitchDrawP0K1	;+2	71
	bpl WaitDrawP0K1	;+2	73
	lda (vcs_multisprite_state + 34),Y	;+5	 2
	sta GRP0		;+3	 5	VDEL because of reporenderer
BackFromSwitchDrawP0K1:

	cpy vcs_multisprite_state + 37		;+3	 8	unless we mean to draw immediately, this should be set
				;		to a value greater than maximum Y value initially
	bcc SkipDrawP1K1	;+2	10
	lda (vcs_multisprite_state + 76),Y	;+5	15
	sta.a GRP1		;+4	19
BackFromSkipDrawP1:

 sty vcs_multisprite_state + 75
 ldy vcs_multisprite_state + 58
	lax (vcs_multisprite_state + 59),y
	stx PF1			;+7	26
	lda (vcs_multisprite_state + 61),y
	sta PF2			;+7	33
 ;sleep 6
	stx vcs_multisprite_state + 55
	sta vcs_multisprite_state + 57
	dey
 bmi pagewraphandler
	lda (vcs_multisprite_state + 59),y
cyclebalance:
	sta vcs_multisprite_state + 54
	lda (vcs_multisprite_state + 61),y
	sta vcs_multisprite_state + 56
 ldy vcs_multisprite_state + 75

 ldx #ENABL
 txs
	cpy vcs_multisprite_state + 12
	php			;+6	39	VDEL ball


	cpy vcs_multisprite_state + 11
	php			;+6	71

	cpy vcs_multisprite_state + 10
	php			;+6	 1
	

	dey			;+2	15

	cpy vcs_multisprite_state + 78		;+3	18
	beq RepoRenderer		;+2	20
;	SLEEP 20		;+23	43
 SLEEP 6

newrepo:; since we have time here, store next repoline
 ldx vcs_multisprite_state + 3
 lda vcs_multisprite_state + 29-1,x
 tax
 lda vcs_multisprite_state + 14,x
 sta vcs_multisprite_state + 80
 SLEEP 4 

BackFromRepoRenderer:
	tya			;+2	45
	and vcs_multisprite_state + 68			;+2	47
	bne RendererLoopa		;+2	49
	dec vcs_multisprite_state + 58
	bpl RendererLoopb		;+3	54
;	bmi donewrenderer		;+3	54
;	bne RendererLoopb+1		;+3	54

donewrenderer:
	jmp DoneWithRenderer	;+3	56

pagewraphandler:
 jmp cyclebalance

;-------------------------------------------------------------------------
 
 ; room here for score?

setscorepointers:
 lax vcs_multisprite_state + 82+2
 jsr scorepointerset
 sty vcs_multisprite_state + 69+5
 stx vcs_multisprite_state + 69+2
 lax vcs_multisprite_state + 82+1
 jsr scorepointerset
 sty vcs_multisprite_state + 69+4
 stx vcs_multisprite_state + 69+1
 lax vcs_multisprite_state + 82
 jsr scorepointerset
 sty vcs_multisprite_state + 69+3
 stx vcs_multisprite_state + 69
wastetime:
 rts

scorepointerset:
 and #$0F
 asl
 asl
 asl
 adc #<scoretable
 tay
 txa
 and #$F0
 lsr
 adc #<scoretable
 tax
 rts
;	align 256

SwitchDrawP0KR:;	45
	lda vcs_multisprite_state + 36
	sta vcs_multisprite_state + 79			;+6	51
	jmp BackFromSwitchDrawP0KR	;+3	54

WaitDrawP0KR:;	47
	SLEEP 4				;+4	51
	jmp BackFromSwitchDrawP0KR	;+3	54

;-----------------------------------------------------------

noUpdateXKR:
 ldx #1
 cpy.a vcs_multisprite_state + 79
 JMP retXKR

skipthis:
 ldx #1
 jmp goback

RepoRenderer:;	22	crosses page boundary
	tya
	and vcs_multisprite_state + 68			;+2	26
	bne noUpdateXKR		;+2	28
        tax
;	dex			;+2	30
	dec vcs_multisprite_state + 58
;	stx Temp		;+3	35
;	SLEEP 3

	cpy vcs_multisprite_state + 79		;+3	42
retXKR:
	beq SwitchDrawP0KR	;+2	44
	bpl WaitDrawP0KR	;+2	46
	lda (vcs_multisprite_state + 34),Y	;+5	51
	sta GRP0		;+3	54	VDEL
BackFromSwitchDrawP0KR:
	sec			;+2	56
 


	lda vcs_multisprite_state + 56,X
	ldy vcs_multisprite_state + 54,X

	ldx vcs_multisprite_state + 3	;+3	 2

	sta PF2			;+7	63

	lda vcs_multisprite_state + 29,x
	sty PF1			;+7	70	too early?
	tax
	lda #0
	sta GRP1		;+5	75	to display player 0
	lda vcs_multisprite_state + 5,X	;+4	 6
 
DivideBy15LoopK:;	 6	(carry set above)
	sbc #15
	bcs DivideBy15LoopK		;+4/5	10/15.../60

	tax				;+2	12/17/...62
	lda FineAdjustTableEnd,X	;+5	17/22/...67

	sta HMP1			;+3	20/25/...70
	sta RESP1			;+3	23/28/33/38/43/48/53/58/63/68/73
	sta WSYNC			;+3	 0	begin line 2
	;sta HMOVE			;+3	 3

	ldx #ENABL
	txs			;+4	25
	ldy vcs_multisprite_state + 78 ; restore y
	cpy vcs_multisprite_state + 12
	php			;+6	 9	VDEL ball

	cpy vcs_multisprite_state + 11
	php			;+6	15

	cpy vcs_multisprite_state + 10
	php			;+6	21
	

 


;15 cycles
	tya
	and vcs_multisprite_state + 68
 ;eor #1
	and #$FE
	bne skipthis
 tax
 SLEEP 4
;	sleep 2
goback:

	dey
	cpy vcs_multisprite_state + 79			;+3	52
	beq SwitchDrawP0KV	;+2	54
	bpl WaitDrawP0KV		;+2	56
	lda (vcs_multisprite_state + 34),Y		;+5	61
	sta GRP0			;+3	64	VDEL
BackFromSwitchDrawP0KV:

; sleep 3

	lda vcs_multisprite_state + 56,X
	sta PF2			;+7	 5
	lda vcs_multisprite_state + 54,X
	sta PF1			;+7	74 
 sta HMOVE

	lda #0
	sta GRP1			;+5	10	to display GRP0

	ldx #ENABL
	txs			;+4	 8

	ldx vcs_multisprite_state + 3	;+3	13	restore index into new sprite vars
	;--now, set all new variables and return to main renderer loop


;
	lda vcs_multisprite_state + 29,X	;+4	31
	tax				;+2	33
;



	lda vcs_multisprite_state + 19,X
	sta NUSIZ1			;+7	20
 sta REFP1
	lda vcs_multisprite_state + 24,X
	sta COLUP1			;+7	27

;	lda SpriteGfxIndex,X	;+4	31
;	tax				;+2	33
	lda vcs_multisprite_state + 14,X		;+4	46
	sec				;+2	38
	sbc vcs_multisprite_state + 49,X	;+4	42
	sta vcs_multisprite_state + 37		;+3	45

 SLEEP 6
	lda vcs_multisprite_state + 38,X	;+4	49
	sbc vcs_multisprite_state + 37		;+3	52	carry should still be set
	sta vcs_multisprite_state + 76		;+3	55
	lda vcs_multisprite_state + 43,X
	sta vcs_multisprite_state + 76+1		;+7	62


	cpy vcs_multisprite_state + 12
	php			;+6	68	VDELed

	cpy vcs_multisprite_state + 11
	php			;+6	74

	cpy vcs_multisprite_state + 10
	php			;+6	 4



; lda SpriteGfxIndex-1,x
; sleep 3
	dec vcs_multisprite_state + 3	;+5	13
; tax
; lda NewSpriteY,x
; sta RepoLine

; 10 cycles below...
	bpl SetNextLine
	lda #255
	jmp SetLastLine
SetNextLine:
;	lda NewSpriteY-1,x
	lda.a vcs_multisprite_state + 80
SetLastLine:
	sta vcs_multisprite_state + 78	

 tya
 and vcs_multisprite_state + 68
 bne nodec
 dec vcs_multisprite_state + 58
	dey			;+2	30

; 10 cycles 
 

	jmp BackFromRepoRenderer	;+3	43

nodec:
 SLEEP 4
 dey
 jmp BackFromRepoRenderer

;-------------------------------------------------------------------------


SwitchDrawP0KV:;	69
	lda vcs_multisprite_state + 36
	sta vcs_multisprite_state + 79			;+6	75
	jmp BackFromSwitchDrawP0KV	;+3	 2

WaitDrawP0KV:;	71
	SLEEP 4				;+4	75
	jmp BackFromSwitchDrawP0KV	;+3	 2

;-------------------------------------------------------------------------

DoneWithRenderer:

BottomOfRendererLoop:

	sta WSYNC
 ldx vcs_multisprite_state + 118
 txs
 jsr sixdigscore ; set up score


 sta WSYNC
 ldx #0
 sta HMCLR
                STx GRP0
                STx GRP1 ; seems to be needed because of vdel

                LDY #7
        STy VDELP0
        STy VDELP1
        LDA #$10
        STA HMP1
               LDA vcs_multisprite_state + 85 
                STA COLUP0
                STA COLUP1
 
        LDA #$03
        STA NUSIZ0
        STA NUSIZ1

                STA RESP0
                STA RESP1

 SLEEP 9
 lda  (vcs_multisprite_state + 69),y
 sta  GRP0
 SLEEP 6

                STA HMOVE
 lda  (vcs_multisprite_state + 69+8),y
; sta WSYNC
 ;sleep 2
 jmp beginscore


loop2:
 lda  (vcs_multisprite_state + 69),y     ;+5  68  204
 sta  GRP0            ;+3  71  213      D1     --      --     --
 SLEEP 7
 ; cycle 0
 lda  (vcs_multisprite_state + 69+$8),y  ;+5   5   15
beginscore:
 sta  GRP1            ;+3   8   24      D1     D1      D2     --
 lda  (vcs_multisprite_state + 69+$6),y  ;+5  13   39
 sta  GRP0            ;+3  16   48      D3     D1      D2     D2
 lax  (vcs_multisprite_state + 69+$2),y  ;+5  29   87
 txs
 lax  (vcs_multisprite_state + 69+$4),y  ;+5  36  108
 SLEEP 3
 SLEEP 6
 lda  (vcs_multisprite_state + 69+$A),y  ;+5  21   63
 stx  GRP1            ;+3  44  132      D3     D3      D4     D2!
 tsx
 stx  GRP0            ;+3  47  141      D5     D3!     D4     D4
 sta  GRP1            ;+3  50  150      D5     D5      D6     D4!
 sty  GRP0            ;+3  53  159      D4*    D5!     D6     D6
 dey
 bpl  loop2           ;+2  60  180
 	ldx vcs_multisprite_state + 118
	txs


; lda scorepointers+1
 ldy vcs_multisprite_state + 75
; sta temp1
 sty vcs_multisprite_state + 69+1

                LDA #0   
               STA GRP0
                STA GRP1
 sta PF1 
       STA VDELP0
        STA VDELP1;do we need these
        STA NUSIZ0
        STA NUSIZ1

; lda scorepointers+3
 ldy vcs_multisprite_state + 77
; sta temp3
 sty vcs_multisprite_state + 69+3

; lda scorepointers+5
 ldy vcs_multisprite_state + 79
; sta temp5
 sty vcs_multisprite_state + 69+5


