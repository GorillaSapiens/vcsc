   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs @TEMPLATE_B_u2_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u2_p0_ready;
   asm @TEMPLATE_B_u2_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z CXM0P;
   asm @TEMPLATE_B_u2_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   // B pair 3: fixed 152-cycle cached pair.
   asm @TEMPLATE_B_u3:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.ax TEMPLATE_playfield + 6,x;
   asm sta.z TEMPLATE_row_cache + 2;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_u3_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_u3_p1_ready;
   asm @TEMPLATE_B_u3_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_u3_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs @TEMPLATE_B_u3_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u3_p0_ready;
   asm @TEMPLATE_B_u3_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z CXM0P;
   asm @TEMPLATE_B_u3_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   // B pair 4: fixed 152-cycle cached pair.
   asm @TEMPLATE_B_u4:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.ax TEMPLATE_playfield + 7,x;
   asm sta.z TEMPLATE_row_cache + 3;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_u4_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_u4_p1_ready;
   asm @TEMPLATE_B_u4_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_u4_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs @TEMPLATE_B_u4_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u4_p0_ready;
   asm @TEMPLATE_B_u4_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z CXM0P;
   asm @TEMPLATE_B_u4_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   // B pair 5: fixed 152-cycle cached pair.
   asm @TEMPLATE_B_u5:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.zx TEMPLATE_object_masks + 4,x;
   asm sta.z TEMPLATE_row_cache + 4;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_u5_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_u5_p1_ready;
   asm @TEMPLATE_B_u5_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_u5_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs @TEMPLATE_B_u5_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u5_p0_ready;
   asm @TEMPLATE_B_u5_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z CXM0P;
   asm @TEMPLATE_B_u5_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   // B pair 6: fixed 152-cycle cached pair.
   asm @TEMPLATE_B_u6:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_u6_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_u6_p1_ready;
   asm @TEMPLATE_B_u6_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_u6_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs @TEMPLATE_B_u6_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u6_p0_ready;
   asm @TEMPLATE_B_u6_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z CXM0P;
   asm @TEMPLATE_B_u6_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   // B pair 7 consumes the packed eighth BL/M1/M0 bits.  The packed
   // byte is copied to the now-dead cached M1 lane before X becomes P1 color.
   asm @TEMPLATE_B_u7:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lda.zx TEMPLATE_object_masks + 3,x;
   asm sta ENABL;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 13;
   asm ldy.zx TEMPLATE_object_masks + 6,x;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.z TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sty.z TEMPLATE_row_cache + 6;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs @TEMPLATE_B_u7_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_B_u7_p1_ready;
   asm @TEMPLATE_B_u7_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z CXM0P;
   asm @TEMPLATE_B_u7_p1_ready:;
   asm sta GRP1;
   asm lda.zx TEMPLATE_object_masks + 3,x;
   asm lsr;
   asm sta ENAM1;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.a TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sty.z TEMPLATE_object_masks + 0;
   // As on the A boundary, absorb the otherwise-skipped next P0 color write
   // into a cycle-balanced 15-cycle selector.  The extra five cycles place the
   // GRP0 commit exactly on the scanline boundary, so no explicit WSYNC is needed.
   asm bcc.same @TEMPLATE_B_u7_p0_active;
   asm lda #0;
   asm tay;
   asm bit.a CXM0P;
   asm nop;
   asm bcs.same @TEMPLATE_B_u7_p0_ready;
   asm @TEMPLATE_B_u7_p0_active:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @TEMPLATE_B_u7_p0_ready:;
   asm sta GRP0;
   // Final line of a B row. Row 10 is terminal; earlier B rows switch
   // back to cache A.  CMP leaves C clear on every nonterminal row, so ADC #4
   // doubles as the row-offset increment without a separate CLC.
   asm @TEMPLATE_B_boundary:;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm cpx #40;
   asm beq @TEMPLATE_terminal_boundary;
   // B boundaries spend the four-cycle terminal check in place of A's Ball
   // second three-cycle pad.
   asm lsr.a TEMPLATE_row_cache + 4;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs @TEMPLATE_B_boundary_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_B_boundary_p1_ready;
   asm @TEMPLATE_B_boundary_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z CXM0P;
   asm @TEMPLATE_B_boundary_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm inx;
   asm inx;
   asm inx;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs @TEMPLATE_B_firstA_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_firstA_p0_ready;
   asm @TEMPLATE_B_firstA_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z CXM0P;
   asm @TEMPLATE_B_firstA_p0_ready:;
   asm sta GRP0;
   asm inx;
   asm nop;
   asm jmp @TEMPLATE_A_u1;

   // Row 10 is terminal. Its packed M0 bit7 is already active; keep the old
   // row's reflected PF through the final line and close it with WSYNC.
   asm @TEMPLATE_terminal_boundary:;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm bit.z CXM0P;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.z TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sta WSYNC;

   // One blank tail line completes the 181-line score-composable profile.
   // Clear every gameplay output before waiting so a following score starts
   // from a clean TIA state at the canonical component handoff phase.
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   // VDELBL delays ENABL until GRP1 is written; flush the staged zero so the
   // padding line is genuinely blank rather than retaining the final Ball bit.
   asm sta GRP1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
   // Restore the two public heights temporarily biased for direct CPY tests.
   asm dec.z TEMPLATE_player0_height;
   asm dec.z TEMPLATE_player1_height;

   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;
}
