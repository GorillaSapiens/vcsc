   //   DEX + BEQ(taken) + TSX = 7
   asm dex;
   asm beq.same @TEMPLATE_B_c_pair5_restore;
   asm jmp @TEMPLATE_B_c_loop;
   asm @TEMPLATE_B_c_pair5_restore:;
   asm tsx;

   // B pair 4: prefetch next-row PF0 in the ordinary seven-cycle slot.
   asm @TEMPLATE_B_c_u4:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.ax TEMPLATE_playfield + 4,x;
   asm sta.z TEMPLATE_row_cache + 0;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_c_u4_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_c_u4_p1_ready;
   asm @TEMPLATE_B_c_u4_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_c_u4_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_c_u4_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_c_u4_p0_ready;
   asm @TEMPLATE_B_c_u4_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_c_u4_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;

   // B pair 5: row base is back in X; prefetch next-row Ball.
   asm @TEMPLATE_B_c_u5:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.zx TEMPLATE_object_masks + 4,x;
   asm sta.z TEMPLATE_row_cache + 4;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_c_u5_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_c_u5_p1_ready;
   asm @TEMPLATE_B_c_u5_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_c_u5_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_c_u5_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_c_u5_p0_ready;
   asm @TEMPLATE_B_c_u5_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_c_u5_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
