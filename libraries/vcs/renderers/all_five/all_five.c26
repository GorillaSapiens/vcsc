   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
   asm bcc.same @stripe2_pointer_pair1_activeP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm bcs.same @stripe2_pointer_pair1_readyP0;
   asm @stripe2_pointer_pair1_activeP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
