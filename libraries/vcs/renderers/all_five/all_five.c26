   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
   asm bcc.same @stripe_pair6_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @stripe_pair6_continueP0;
   asm @stripe_pair6_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe_pair6_continueP0:;
   asm lsr.zx TEMPLATE_object_masks + 24,x;
   asm inx;

