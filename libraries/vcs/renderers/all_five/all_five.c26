   asm sta.z TEMPLATE_row_cache + 2;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_u3_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_u3_p1_ready;
   asm @TEMPLATE_B_u3_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_u3_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_u3_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u3_p0_ready;
   asm @TEMPLATE_B_u3_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_u3_p0_ready:;
