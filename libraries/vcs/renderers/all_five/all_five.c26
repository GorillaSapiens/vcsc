   asm @TEMPLATE_B_u4_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_u4_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u4_p0_ready;
   asm @TEMPLATE_B_u4_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_u4_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   // B pair 5: fixed 152-cycle cached pair.
   asm @TEMPLATE_B_u5:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.zx TEMPLATE_object_masks + 4,x;
   asm sta.z TEMPLATE_row_cache + 4;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_u5_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_u5_p1_ready;
   asm @TEMPLATE_B_u5_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_u5_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_u5_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u5_p0_ready;
   asm @TEMPLATE_B_u5_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_u5_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   // B pair 6: fixed 152-cycle cached pair.
   asm @TEMPLATE_B_u6:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_u6_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_u6_p1_ready;
   asm @TEMPLATE_B_u6_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_u6_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_u6_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_u6_p0_ready;
   asm @TEMPLATE_B_u6_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_u6_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   // B pair 7 consumes the packed eighth BL/M1/M0 bits.  The packed
   // byte is copied to the now-dead cached M1 lane before X becomes P1 color.
   asm @TEMPLATE_B_u7:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lda.zx TEMPLATE_object_masks + 3,x;
   asm sta ENABL;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 13;
   asm ldy.zx TEMPLATE_object_masks + 6,x;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.z TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sty.z TEMPLATE_row_cache + 6;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_B_u7_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_B_u7_p1_ready;
   asm @TEMPLATE_B_u7_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm @TEMPLATE_B_u7_p1_ready:;
   asm sta GRP1;
   asm lda.zx TEMPLATE_object_masks + 3,x;
   asm lsr;
   asm sta ENAM1;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.a TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sty.z TEMPLATE_object_masks + 0;
   // As on the A boundary, absorb the otherwise-skipped next P0 color write
   // into a cycle-balanced 15-cycle selector.  The extra five cycles place the
   // GRP0 commit exactly on the scanline boundary, so no explicit WSYNC is needed.
   asm bcc.same @TEMPLATE_B_u7_p0_active;
   asm lda #0;
   asm tay;
   asm bit.a CXM0P;
   asm nop;
   asm bcs.same @TEMPLATE_B_u7_p0_ready;
   asm @TEMPLATE_B_u7_p0_active:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @TEMPLATE_B_u7_p0_ready:;
   asm sta GRP0;
   // Final line of a B row.  Row 11 is terminal; earlier B rows switch
   // back to cache A.  CMP leaves C clear on every nonterminal row, so ADC #4
   // doubles as the row-offset increment without a separate CLC.
   asm @TEMPLATE_B_boundary:;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm cpx #44;
   asm beq.same @TEMPLATE_terminal_boundary;
   // B boundaries spend the four-cycle terminal check in place of A's Ball
   // second three-cycle pad.
   asm lsr.a TEMPLATE_row_cache + 4;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_B_boundary_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_B_boundary_p1_ready;
   asm @TEMPLATE_B_boundary_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm @TEMPLATE_B_boundary_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm inx;
   asm inx;
   asm inx;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_firstA_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_firstA_p0_ready;
   asm @TEMPLATE_B_firstA_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_firstA_p0_ready:;
   asm sta GRP0;
   asm inx;
   asm nop;
   asm jmp @TEMPLATE_A_u1;

   // Row 11 is terminal.  Its packed M0 bit7 is already active; keep the old
   // row's reflected PF through the final line and close it with WSYNC.
   asm @TEMPLATE_terminal_boundary:;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.z TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
   // Restore the two public heights temporarily biased for direct CPY tests.
   asm dec.z TEMPLATE_player0_height;
   asm dec.z TEMPLATE_player1_height;

   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;
}

#elif TEMPLATE_lines == 181
// Official-opcode score-composable P0/P1/M0/M1/BL gameplay specialization
// with independent eight-entry P0/P1 color tables. This is the combined
// 181-line schedule selected by missiles:=1, player_colors:=1.
//
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=181, missiles:=1, player_colors:=1)
//
// It preserves the measured one-HMOVE score handoff and successor-line
// contract of the former all_five_player_color_181 renderer.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 181,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 181,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 58,
   TEMPLATE_OBJECT_COUNT := 5,
   TEMPLATE_PLAYFIELD_BYTES := 44,
   TEMPLATE_PLAYFIELD_ROWS := 11,
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 21,
   TEMPLATE_PRIVATE_RAM_BYTES := 67,
   TEMPLATE_PUBLIC_RAM_BYTES := 21,
   TEMPLATE_MODULE_RAM_BYTES := 88
};

// Three compact vertical masks are built for each 16-line playfield row. Bits
// 0..6 are shifted into TIA D1; the eighth BL/M1/M0 bits are packed into the
// fourth byte as D1/D2/D3. Bytes 44..45 are harmless lookahead padding: terminal
// row pair 1 prefetches the nonexistent next-row M1 with the same fixed timing,
// but that value is never consumed. The first fourteen row-cache bytes are two
// seven-byte raster banks. The final seven bytes hold score-safe P0/P1 handoff
// controls plus the caller's hardware stack pointer while S is borrowed as a
// row base.
uint8_t TEMPLATE_object_masks[46];
uint8_t TEMPLATE_row_cache[21];

require inline void TEMPLATE_init(void) {
}

require inline void TEMPLATE_vblank(void) {
   // Internal assembly helpers add one hidden JSR level.
   asm .callstackextra 4;
   // Build the three non-player schedules directly from public coordinates.
   // P0/P1 are biased only after preparation; BL/M0/M1 never need to mutate
   // their public Y values at all.
   asm jsr @TEMPLATE_prepare_object_masks;
   asm jmp @TEMPLATE_prepare_object_masks_done;
   asm @TEMPLATE_prepare_object_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #44;
   asm bcc.same @clear;
   // VDELBL stages Ball one pair ahead in the score-composable profile.
   // Gameplay pair coordinates run through 87, with the biased terminal
   // endpoint admitted through 88.
   asm lda #88;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   asm adc #1;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   // Missiles use the maintained 181-line direct coordinate convention.
   asm lda #88;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_missile1_y;
   asm ldy.z TEMPLATE_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_missile0_y;
   asm ldy.z TEMPLATE_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;

   // No special mask encoding is required for the last row: Ball, P0, and P1
   // remain in the ordinary raster pipeline through the terminal row.
   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @no_wrap;
   asm beq.same @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq.same @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_low_ready;
   asm beq.same @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_high_ready;
   asm beq.same @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne.same @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @no_wrap_last_ready;
   asm beq.same @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @set_range;
   asm beq.same @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne.same @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs.same @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @TEMPLATE_prepare_object_masks_done:;

   // Convert each three-byte row mask from D0..D7 into a D1-ready seven-bit
   // stream. The old D7 bits are packed in the fourth lane as BL/M1/M0 in
   // D1/D2/D3. That lane is consumed only by the final pair of each row.
   asm ldx #0;
   asm @TEMPLATE_encode_masks:;
   asm asl.zx TEMPLATE_object_masks + 2,x;
   asm lda #0;
   asm rol;
   asm asl.zx TEMPLATE_object_masks + 1,x;
   asm rol;
   asm asl.zx TEMPLATE_object_masks,x;
   asm rol;
   asm asl;
   asm sta.zx TEMPLATE_object_masks + 3,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #44;
   asm bcc.same @TEMPLATE_encode_masks;

   // Prime cache B with row zero. Starting on B makes the odd eleven-row
   // profile terminate on the same fixed B-boundary path used by the proven
   // 192-line twelve-row kernel, while A is filled with row one during row zero.
   asm lda.a TEMPLATE_playfield;
   asm sta.z TEMPLATE_row_cache + 7;
   asm lda.a TEMPLATE_playfield + 1;
   asm sta.z TEMPLATE_row_cache + 8;
   asm lda.a TEMPLATE_playfield + 2;
   asm sta.z TEMPLATE_row_cache + 9;
   asm lda.a TEMPLATE_playfield + 3;
   asm sta.z TEMPLATE_row_cache + 10;
   asm lda.z TEMPLATE_object_masks;
   asm sta.z TEMPLATE_row_cache + 11;
   asm lda.z TEMPLATE_object_masks + 1;
   asm sta.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_object_masks + 2;
   asm sta.z TEMPLATE_row_cache + 13;

   // Match the maintained 181-line score-handoff Y choreography. P0 begins
   // two pairs early because its first visible selection occurs after the
   // setup handoff; P1 begins un-biased and is decremented in that setup.
   asm lda.z TEMPLATE_player0_y;
   asm sec;
   asm sbc #2;
   asm sta.z TEMPLATE_object_masks + 0;
   asm lda.z TEMPLATE_player1_y;
   asm sta.z TEMPLATE_object_masks + 1;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 2;

   // Height+1 is the direct-count threshold used by the player paths. Restore
   // the public values in overscan after the visible phase is complete.
   asm inc.z TEMPLATE_player0_height;
   asm inc.z TEMPLATE_player1_height;

   // Position Ball, M1, and M0 during VBLANK. P0/P1 remain for the
   // visible component handoff because an optional score owns those registers.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #3;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #2;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   // Apply only the non-player fine motion now. P0/P1 receive their motion at
   // the visible handoff after a possible score component has finished.
   asm lda #0;
   asm sta HMP0;
   asm sta HMP1;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #0;
   asm sta ENAM0;
   asm sta ENAM1;

   // Precompute score-safe player handoff controls in VBLANK. Normal residues
   // retain the historical RESP phase. Remainders 13, 14, and 0 use the next
   // coarse position and an RESP one CPU cycle earlier, filling the three X
   // coordinates the old packed handoff skipped every 15 pixels.
   asm lda.z TEMPLATE_object_x;
   asm jsr @TEMPLATE_prepare_player_position;
   asm sta.z TEMPLATE_row_cache + 14;
   asm stx.z TEMPLATE_row_cache + 16;
   asm lda #0;
   asm ror;
   asm sta.z TEMPLATE_row_cache + 18;
   asm lda.z TEMPLATE_object_x + 1;
   asm jsr @TEMPLATE_prepare_player_position;
   asm sta.z TEMPLATE_row_cache + 15;
   asm stx.z TEMPLATE_row_cache + 17;
   asm lda #0;
   asm ror;
   asm sta.z TEMPLATE_row_cache + 19;
   asm jmp @TEMPLATE_prepare_player_position_done;

   // Return A=HMP byte, X=coarse count, C=1 when RESP must be one cycle early.
   asm @TEMPLATE_prepare_player_position:;
   asm ldx #0;
   asm sec;
   asm @TEMPLATE_player_position_divide_loop:;
   asm inx;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player_position_divide_loop;
   asm tay;
   // Reuse the ordinary fine-motion table. The score-safe handoff uses the
   // same 15 residues with a fixed phase-dependent offset, so a second table
   // would only waste ROM. Remainders -2/-1 are source residues 13/14:
   // advance to the next coarse position. Remainder -15 is source residue 0
   // and already has that count.
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm cpy #$fe;
   asm bcc.same @TEMPLATE_player_position_not_high_gap;
   asm inx;
   asm sec;
   asm sbc #$70;
   asm sec;
   asm rts;
   asm @TEMPLATE_player_position_not_high_gap:;
   asm cpy #$f1;
   asm beq.same @TEMPLATE_player_position_zero_gap;
   asm sec;
   asm sbc #$30;
   asm clc;
   asm rts;
   asm @TEMPLATE_player_position_zero_gap:;
   asm sec;
   asm sbc #$60;
   asm sec;
   asm rts;
   asm @TEMPLATE_prepare_player_position_done:;

   // The visible kernel borrows S as its row-base register. Every component
   // lifecycle call is stack-balanced, so the caller's S here is also the S
   // that must be restored when draw() returns after an optional score-above.
   asm tsx;
   asm stx.z TEMPLATE_row_cache + 20;

   // Do not let the later player-only HMOVE move M0/M1/Ball a second time.
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;

}

require inline void TEMPLATE_draw(void) {
   // P1: normal positions exactly match the historical handoff phase. A phase
   // byte of $80 makes BPL fall through instead of taking the branch-to-next,
   // advancing only the three gap residues by exactly one CPU cycle.
   asm lda.z TEMPLATE_row_cache + 15;
   asm bit.z TEMPLATE_row_cache + 19;
   asm bpl.same @TEMPLATE_player1_position_entry;
   asm @TEMPLATE_player1_position_entry:;
   asm ldx.z TEMPLATE_row_cache + 17;
   asm @TEMPLATE_player1_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_player1_position_loop;
   asm sta RESP1;
   asm sta WSYNC;

   // P0 uses the old three-cycle P0-only padding to write P1's fine motion.
   // The remaining phase/count sequence is therefore cycle-identical to P1.
   asm sta HMP1;
   asm ldy.z TEMPLATE_row_cache + 14;
   asm bit.z TEMPLATE_row_cache + 18;
   asm bpl.same @TEMPLATE_player0_position_entry;
   asm @TEMPLATE_player0_position_entry:;
   asm ldx.z TEMPLATE_row_cache + 16;
   asm @TEMPLATE_player0_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_player0_position_loop;
   asm sty RESP0;
   asm sty WSYNC;

   // Write P0 fine motion, spend the old two-cycle setup slot, then strobe
   // HMOVE at the historical cycle-8 phase. The gameplay raster after HMOVE
   // is therefore unchanged.
   asm sty HMP0;
   asm nop;
   asm sty HMOVE;

   // Restore player state and stage row zero. A predecessor score may have
   // clobbered every player TIA register, so re-establish orientation, NUSIZ,
   // VDEL, graphics, and colors here. M0/M1/Ball positioning remains intact.
   asm lda.z TEMPLATE_player0_nusiz;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_player1_nusiz;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx REFP0;
   asm stx REFP1;
   asm stx GRP0;
   asm stx GRP1;
   asm stx PF0;
   asm stx PF1;
   asm stx PF2;
   asm stx CXCLR;

   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   // Keep the setup tail blank; the first cached gameplay line installs the
   // playfield before the visible beam reaches it.
   asm sta WSYNC;
   asm bit.z $00;

   // Row zero enters in cache B at the scheduler's cycle-3 handoff.  The first visible
   // P0 half is timed to place the first cached pair at cycle 75; every normal
   // pair thereafter is exactly 152 cycles.
   asm bit.z $00;
   asm bit.z $00;
   asm nop;
   asm lda.a TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.a TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm bit.z $00;
   asm nop;
   asm lda.a TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_first_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_first_p0_ready;
   asm @TEMPLATE_first_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_first_p0_ready:;
   asm sta GRP0;
   asm ldx #0;
   asm txs;
   asm jmp @TEMPLATE_B_c_u1;

   // No page alignment is required: all timing-critical branches below carry
   // explicit same-page contracts, and removing the old alignment padding
   // recovers ROM without changing a raster cycle.

   // Compact two-bank 181-line scheduler.  Each parity keeps the proven fast
   // zero-page PF/object cache accesses, but only one body is shared for pairs
   // 2..4.  Late-row dead object-shift slots prefetch the opposite cache bank.
   // S carries the four-byte row base while X is temporarily a loop counter.

   // A pair 1: current PF2 was prefetched by the preceding B pair 6. Use
   // the old seven-cycle refresh slot to prefetch next-row B M1 instead, then
   // enter the shared pairs 2..3 loop.
   asm @TEMPLATE_A_c_u1:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_A_c_u1_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_A_c_u1_p1_ready;
   asm @TEMPLATE_A_c_u1_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_A_c_u1_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 6;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same @TEMPLATE_A_c_u1_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_A_c_u1_p0_ready;
   asm @TEMPLATE_A_c_u1_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_A_c_u1_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 4;
   asm ldx #2;

   // A pairs 2..3: one exact 152-cycle body.  X is only the two-pair
   // loop counter; S holds the row base and TSX restores it on the final tail.
   asm @TEMPLATE_A_c_loop:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   // The old seven-cycle refill slot advances M0 without disturbing CPY carry.
   asm lsr.z TEMPLATE_row_cache + 6;
   asm nop;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_A_c_loop_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_A_c_loop_p1_ready;
   asm @TEMPLATE_A_c_loop_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_A_c_loop_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 4;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same @TEMPLATE_A_c_loop_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_A_c_loop_p0_ready;
   asm @TEMPLATE_A_c_loop_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_A_c_loop_p0_ready:;
   asm sta GRP0;
   // Taken and final tails are both seven cycles:
   //   DEX + BEQ(not) + JMP = 7
   //   DEX + BEQ(taken) + TSX = 7
   asm dex;
   asm beq.same @TEMPLATE_A_c_pair5_restore;
   asm jmp @TEMPLATE_A_c_loop;
   asm @TEMPLATE_A_c_pair5_restore:;
   asm tsx;

   // A pair 4: prefetch next-row PF0 in the ordinary seven-cycle slot.
   asm @TEMPLATE_A_c_u4:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.ax TEMPLATE_playfield + 4,x;
   asm sta.z TEMPLATE_row_cache + 7;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_A_c_u4_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_A_c_u4_p1_ready;
   asm @TEMPLATE_A_c_u4_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_A_c_u4_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 6;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same @TEMPLATE_A_c_u4_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_A_c_u4_p0_ready;
   asm @TEMPLATE_A_c_u4_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_A_c_u4_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 4;
   asm nop;

   // A pair 5: row base is back in X; prefetch next-row Ball.
   asm @TEMPLATE_A_c_u5:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.zx TEMPLATE_object_masks + 4,x;
   asm sta.z TEMPLATE_row_cache + 11;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_A_c_u5_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_A_c_u5_p1_ready;
   asm @TEMPLATE_A_c_u5_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_A_c_u5_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 6;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same @TEMPLATE_A_c_u5_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_A_c_u5_p0_ready;
   asm @TEMPLATE_A_c_u5_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_A_c_u5_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 4;
   asm nop;

   // A pair 6: its post-output object shifts are dead because pair 7 uses
   // packed final bits. Reuse those slots to prefetch PF1, PF2, and PF3. M1 for
   // the next row was already prefetched during pair 1.
   asm @TEMPLATE_A_c_u6:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.ax TEMPLATE_playfield + 5,x;
   asm sta.z TEMPLATE_row_cache + 8;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_A_c_u6_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_A_c_u6_p1_ready;
   asm @TEMPLATE_A_c_u6_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_A_c_u6_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   // Four-cycle PF2 prefetch replaces the dead five-cycle M1 shift. Force the
   // following PF0 load absolute (+1) so the PF1 write remains phase-identical.
   asm ldy.ax TEMPLATE_playfield + 6,x;
   asm lda.a TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   // Complete the PF2 prefetch in the dead M0-shift slot.
   asm sty.z TEMPLATE_row_cache + 9;
   asm nop;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same @TEMPLATE_A_c_u6_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_A_c_u6_p0_ready;
   asm @TEMPLATE_A_c_u6_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_A_c_u6_p0_ready:;
   asm sta GRP0;
   // The dead Ball-shift tail is exactly one seven-cycle PF3 prefetch.
   asm lda.ax TEMPLATE_playfield + 7,x;
   asm sta.z TEMPLATE_row_cache + 10;

   // A pair 7: packed final BL/M1/M0 bits plus next-row M0 prefetch.
   asm @TEMPLATE_A_c_u7:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm lda.zx TEMPLATE_object_masks + 3,x;
   asm sta ENABL;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 6;
   asm ldy.zx TEMPLATE_object_masks + 6,x;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.z TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm sty.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_A_c_u7_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_A_c_u7_p1_ready;
   asm @TEMPLATE_A_c_u7_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm @TEMPLATE_A_c_u7_p1_ready:;
   asm sta GRP1;
   asm lda.zx TEMPLATE_object_masks + 3,x;
   asm lsr;
   asm sta ENAM1;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.a TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm sty.z TEMPLATE_object_masks + 0;
   asm bcc.same @TEMPLATE_A_c_u7_p0_active;
   asm lda #0;
   asm tay;
   asm bit.a CXM0P;
   asm nop;
   asm bcs.same @TEMPLATE_A_c_u7_p0_ready;
   asm @TEMPLATE_A_c_u7_p0_active:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @TEMPLATE_A_c_u7_p0_ready:;
   asm sta GRP0;

   asm @TEMPLATE_A_c_boundary:;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm nop;
   asm bit.z $00;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_A_c_boundary_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_A_c_boundary_p1_ready;
   asm @TEMPLATE_A_c_boundary_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm @TEMPLATE_A_c_boundary_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm inx;
   asm inx;
   asm inx;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_A_c_boundary_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_A_c_boundary_p0_ready;
   asm @TEMPLATE_A_c_boundary_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_A_c_boundary_p0_ready:;
   asm sta GRP0;
   asm inx;
   asm txs;
   asm bit.z $00;
   // Fall through into B pair 1.

   // B pair 1: current PF2 was prefetched by the preceding A pair 6. Use
   // the old seven-cycle refresh slot to prefetch next-row A M1 instead, then
   // enter the shared pairs 2..3 loop.
   asm @TEMPLATE_B_c_u1:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_c_u1_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_c_u1_p1_ready;
   asm @TEMPLATE_B_c_u1_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_c_u1_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 13;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_c_u1_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_c_u1_p0_ready;
   asm @TEMPLATE_B_c_u1_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_c_u1_p0_ready:;
   asm sta GRP0;
   asm lsr.z TEMPLATE_row_cache + 11;
   asm ldx #2;

   // B pairs 2..3: one exact 152-cycle body.  X is only the two-pair
   // loop counter; S holds the row base and TSX restores it on the final tail.
   asm @TEMPLATE_B_c_loop:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
