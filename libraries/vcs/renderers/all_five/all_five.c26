   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   // Shift Ball before the P1 decrement and commit ENABL immediately; A keeps
   // the encoded right PF0 byte across DEC so the pair length is unchanged.
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 18,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 22,x;
   #endif
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta ENABL;
   asm dec.z TEMPLATE_player1_y;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
   asm ldy.z TEMPLATE_player1_y;
