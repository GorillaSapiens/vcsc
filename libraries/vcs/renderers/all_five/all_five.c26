   asm bcc.same @stripe2_transition_activeP1;
   asm ldy #0;
   asm sty.a GRP1;
   asm jmp @stripe2_transition_continueP1;
   asm @stripe2_transition_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm @stripe2_transition_continueP1:;
   asm lsr.zx TEMPLATE_object_masks + 49,x;

   asm @stripe2_firstP0:;
