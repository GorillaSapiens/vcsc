   // recovered cycles, refresh the fixed P0 byte for the *following* row.
   // 4+4+4+2+6+3 = 23 cycles, exactly the ordinary P1 feed slot.
   asm ldy.zx TEMPLATE_stripe_row_entry_cache + 21,x;
   asm lda.zx TEMPLATE_stripe_row_entry_cache + 20,x;
   asm sta.a TEMPLATE_stripe_service_p0_ptr;
   asm tya;
   asm lsr.zx TEMPLATE_object_masks + 49,x;
   asm sta GRP1;

   asm lda.z TEMPLATE_stripe_buffer_b + 0;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_buffer_b + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_buffer_b + 2;
   asm sta PF2;
