   // therefore resumes the ordinary phase with no rolling-row drift.
   asm dec.z TEMPLATE_player1_y;
   asm lda.a TEMPLATE_playfield_colors + 2;
   asm sta.z TEMPLATE_stripe_next_color;
   asm lda.z TEMPLATE_stripe_service_p1_ptr;
   asm sta GRP1;
   asm lsr.zx TEMPLATE_object_masks + 21,x;

