   asm lda.z TEMPLATE_stripe_buffer_b + 0;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_buffer_b + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_buffer_b + 2;
   asm sty PF2;
   asm lda.z TEMPLATE_stripe_buffer_b + 3;
   asm sta PF0;
