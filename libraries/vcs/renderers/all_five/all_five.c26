   // and overwrite the pointer high byte with the odd PF payload.
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
