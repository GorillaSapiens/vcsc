   asm @stripe2_rowedge_pair0_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe2_rowedge_pair0_continueP0:;
   asm lsr.zx TEMPLATE_object_masks + 50,x;
   asm nop;
#else
   // Sixteenth line of each packed mask row. Finish the old row, stage the
   // first Ball bit of the next row, then advance X once. The playfield itself
   // does not change for stripes=1.
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_buffer_b + 0;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_buffer_b + 1;
