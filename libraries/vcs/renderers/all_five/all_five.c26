   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
   asm dec.z TEMPLATE_player0_y;
   asm lda.a TEMPLATE_playfield_colors + 3;
   asm sta.z TEMPLATE_stripe_next_color + 1;
