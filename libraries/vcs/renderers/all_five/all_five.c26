   // the halves shifts the right PF family by five cycles.  The precomputed
   // byte can commit before dispatch because neither memory LSR nor JMP (zp)
   // changes A.
   asm dec.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_stripe_wrap_grp0;
   asm lsr.z TEMPLATE_object_masks + 26;
   asm jmp (TEMPLATE_stripe_tail_a_ptr);

   asm @stripe2_all8_a1:;
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   asm lsr.zx TEMPLATE_object_masks + 50,x;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta ENABL;
   asm dec.z TEMPLATE_player1_y;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
#ifdef VCS_STRIPES2_REFILL_ZERO_PROBE
   asm lda.a TEMPLATE_playfield_data + 6;
   asm and #$f0;
   asm sta.z TEMPLATE_stripe_buffer_b + 0;
   asm lda #0;
   asm bit.z $00;
#elif defined(VCS_STRIPES2_REFILL_PROBE)
   asm ldy.z TEMPLATE_stripe_buffer_b + 0;
