   asm bcs.same @stripe2_pair7_continueP1;
   asm @stripe2_pair7_drawP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @stripe2_pair7_continueP1:;
   asm sta GRP1;
   asm lsr.zx TEMPLATE_object_masks + 46,x;
   asm lda.z TEMPLATE_stripe_buffer_b + 0;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;

   asm lda.z TEMPLATE_stripe_buffer_b + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_buffer_b + 2;
   asm sta PF2;
#ifdef VCS_STRIPES2_COMPACT_ROWEDGE_PROBE
   // Exact next-row P0 replaces CPY in the fixed 18-cycle middle.  Y carries
   // that byte across the reflected PF writes; the zero-page PF0 store pays
   // the indexed cache load without moving the PF0R appointment.
   // 3+2+3+4+3+3 = 18 cycles.
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm ldy.zx TEMPLATE_object_masks + 44,x;
   asm lda.z TEMPLATE_stripe_buffer_b + 3;
   asm sta.z PF0;
#else
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm sty.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_stripe_buffer_b + 3;
   asm sta.a PF0;
#endif
   asm lda.z TEMPLATE_stripe_buffer_b + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_buffer_b + 5;
   asm sta PF2;
#if !defined(VCS_STRIPES2_UNIFORM_ROWEDGE_PROBE) && !defined(VCS_STRIPES2_COMPACT_ROWEDGE_PROBE)
   asm bcc.same @stripe2_pair7_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @stripe2_pair7_continueP0;
   asm @stripe2_pair7_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe2_pair7_continueP0:;
#endif
#ifdef VCS_STRIPES2_COMPACT_ROWEDGE_PROBE
   // Y holds the exact next-row P0 byte.  TYA plus the final M0 shift is the
   // same eight-cycle budget as the old balanced P0 select.  LSR is last among
   // flag-changing data work, so its carry reaches the next ENAM0 unchanged.
   // Nonterminal: 2+6+2+3+3 = 16 cycles.  Terminal: 2+6+2+2+4+3 = 19.
   asm tya;
   asm lsr.zx TEMPLATE_object_masks + 47,x;
   asm inx;
   asm bne.same @stripe2_pair7_compact_continue;
   asm bit.a $00;
   asm jmp @stripe2_terminal;
   asm @stripe2_pair7_compact_continue:;
   asm jmp @stripe2_transition;
#elif defined(VCS_STRIPES2_UNIFORM_ROWEDGE_PROBE)
   // Cached next-row P0 buys exactly the five cycles consumed by INX plus the
   // ordinary BEQ/JMP row control: 3+6+2+2+3 = 16 cycles.  The terminal path
   // deliberately restores the legacy 19-cycle exit so the final-line epilogue
   // retains its established entry phase.
   asm lda.z TEMPLATE_stripe_service_p0_ptr;
   asm lsr.zx TEMPLATE_object_masks + 47,x;
   asm inx;
   asm beq.same @stripe2_rowedge_terminal;
   asm jmp @stripe2_transition;
   asm @stripe2_rowedge_terminal:;
   asm nop;
   asm jmp @stripe2_terminal;
#else
   asm lsr.zx TEMPLATE_object_masks + 47,x;
   asm inx;
   asm beq.same @stripe2_terminal;
   asm jmp @stripe2_transition;
#endif



   // The last visible line needs no following object setup. Complete its right
   // playfield half and WSYNC so draw() returns at cycle zero of line 193.
   asm @stripe2_terminal:;
   asm lda.z TEMPLATE_stripe_buffer_b + 3;
   asm sta.a PF0;
   asm ldy.z TEMPLATE_stripe_buffer_b + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_buffer_b + 5;
   asm sty PF2;
#if defined(VCS_STRIPES2_RUNTIME_ALL8) || (!defined(VCS_STRIPES2_CERT_TAIL0) && !defined(VCS_STRIPES2_CERT_TAIL1) && !defined(VCS_STRIPES2_CERT_TAIL2) && !defined(VCS_STRIPES2_CERT_TAIL3) && !defined(VCS_STRIPES2_CERT_TAIL4) && !defined(VCS_STRIPES2_CERT_TAIL5) && !defined(VCS_STRIPES2_CERT_TAIL6) && !defined(VCS_STRIPES2_CERT_TAIL7))
   // Keep the dispatch table out of the hot kernel so its size cannot disturb
   // any .same/.cross branch placement.  The terminal jump is absorbed by the
   // final WSYNC; mid-frame indirect dispatch jumps here and back to handlers.
   asm jmp @stripe2_all8_after_dispatch_page;
   asm .align 256;
   asm @stripe2_all8_dispatch_page:;
   asm ldx #$e8;
   asm sta GRP0;
   asm jmp @stripe2_all8_tail0;
   asm ldx #$ec;
   asm sta GRP0;
   asm jmp @stripe2_all8_final_a_p1;
   asm ldx #$eb;
   asm sta GRP0;
   asm jmp @stripe2_all8_a6;
   asm ldx #$ea;
   asm sta GRP0;
   asm jmp @stripe2_all8_a5;
   asm ldx #$e9;
   asm sta GRP0;
   asm jmp @stripe2_all8_a4;
   asm ldx #$e8;
   asm sta GRP0;
   asm jmp @stripe2_all8_a3;
   asm ldx #$e7;
   asm sta GRP0;
   asm jmp @stripe2_all8_a2;
   asm ldx #$e6;
   asm sta GRP0;
   asm jmp @stripe2_all8_a1;
   asm ldx #$e8;
   asm sta GRP0;
   asm jmp @stripe2_pair1;
   asm ldx #$e8;
   asm sta GRP0;
   asm jmp @stripe2_pair2;
   asm ldx #$e8;
   asm sta GRP0;
   asm jmp @stripe2_pair3;
   asm ldx #$e8;
   asm sta GRP0;
   asm jmp @stripe2_pair4;
   asm ldx #$e9;
   asm sta GRP0;
   asm jmp @stripe2_pair5;
   asm ldx #$ea;
   asm sta GRP0;
   asm jmp @stripe2_pair6;
   asm ldx #$eb;
   asm sta GRP0;
   asm jmp @stripe2_pair7;
   asm ldx #$ec;
   asm sta GRP0;
   asm jmp @stripe2_transition;
   asm @stripe2_all8_after_dispatch_page:;
#endif
#else
   // The first visible line is the P0 half of the normal two-line pipeline.
   // Do the non-display work before the playfield writes so the left and right
   // bytes reach the TIA at the same phases used by the steady-state loop.
#if TEMPLATE_stripes == 0
   asm bit.z $00;
   asm bit.z $00;
   asm nop;
#endif
#if TEMPLATE_stripes == 1
   asm lda.z TEMPLATE_stripe_cache;
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
#else
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
#endif
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
#if TEMPLATE_stripes == 0
   asm bit.z $00;
   asm nop;
#endif
#if TEMPLATE_stripes == 1
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
#else
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
#endif
   asm bcc.same @first_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @first_continueP0;
   asm @first_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @first_continueP0:;
   // Preserve the selected P0 byte in A and the M0 bit in carry until the
   // common horizontal-blank entry.  Seven pad cycles replace the redundant
   // early ENAM0 materialization without changing the raster phase.
#if TEMPLATE_stripes == 1
   asm lsr.z TEMPLATE_stripe_cache + 8;
   // frame_ntsc_finish_deadline() is allowed to clobber X between vblank() and
   // draw(). Seed the positive-stripe pair counter here, after the first P0
   // graphics/mask result is already in A/C.
   asm ldx #7;
#else
   asm lsr.zx TEMPLATE_object_masks + 2,x;
   asm bit.z $00;
   asm nop;
   asm dec.z TEMPLATE_object_masks + 43;
#endif
   asm jmp @continuerenderer;

   asm .align 256;
   asm @kerloop:;
   asm @continuerenderer:;
   // P0 remains in A across the M0-mask shift and pair counter.  Commit it in
   // horizontal blank before an extreme-right player can fetch the next row.
   asm sta GRP0;
   // M0 was shifted at the end of the preceding P0 half.  Stripe mode folds
   // this carry into the normalized left PF0 byte below.
#if TEMPLATE_stripes == 0
   asm lda #1;
   asm adc #0;
   asm sta ENAM0;
#endif
   asm @continuerenderer2:;
   // P1 half.  Update Ball before the display writes, then leave a three-cycle
   // gap between the left and right halves of the asymmetric playfield.
#if TEMPLATE_stripes == 1
   // PF0's low nibble is invisible.  VBLANK normalized it to $x1, so ADC can
   // materialize an object-enable carry in bit 1 while the same byte remains
   // valid PF0 data.  This folds the old LDA #1 enable setup into the new PF0
   // writes and pays for the asymmetric sixth playfield byte.
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   // Spend the P1 decrement in the safe left/right gap. This moves the right
   // half onto the proven asymmetric phase window without changing pair length.
   asm dec.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm lsr.z TEMPLATE_stripe_cache + 6;
   asm adc #0;
   asm sta PF0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
#else
   asm lda #1;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty.a PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm sta ENABL;
#endif
   asm ldy.z TEMPLATE_player1_y;
   asm @goback:;
   asm @startrenderer:;
#if TEMPLATE_stripes == 0
   asm dey;
   asm sty.z TEMPLATE_player1_y;
#endif
   asm cpy.z TEMPLATE_object_masks + 15;
#if TEMPLATE_stripes == 1
   // Eight cycles on either path: active takes the branch plus indexed fetch;
   // blank falls through to an absolute load of the permanent zero byte.
   asm bcc.same @stripe_drawP1;
   asm lda.z TEMPLATE_object_masks + 19;
   asm bcs.same @stripe_continueP1;
   asm @stripe_drawP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @stripe_continueP1:;
#else
   asm bcs.same @skipP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @continueP1;
   asm @skipP1:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_object_masks + 19;
   asm @continueP1:;
#endif
   // Shift M1 first, then carry the selected P1 byte and M1 carry through the
   // scanline boundary.  Both visible objects are committed in the following
   // horizontal blank without changing the pair's cycle count.
#if TEMPLATE_stripes == 1
   asm lsr.z TEMPLATE_stripe_cache + 7;
   asm sta GRP1;
   // Fold M1 carry into the next line's left PF0 ($x1/$x2 differ only in the
   // invisible low nibble), eliminating the old LDA #1.
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;
#else
   asm lsr.zx TEMPLATE_object_masks + 1,x;
   asm sta GRP1;
   asm lda #1;
   asm adc #0;
   asm sta ENAM1;
#endif

   asm @p0renderer:;
   // P0 half.  Move eleven cycles of P0 bookkeeping ahead of the playfield
   // writes and remove the old carry clear; every Ball ADC gets its carry from
   // the immediately preceding LSR.  The pair remains exactly 152 cycles.
#if TEMPLATE_stripes == 1
   // P1 already installed this scanline's left PF0 while materializing M1.
   // Start with PF1/PF2 here; the absolute right-PF0 store below restores the
   // single cycle needed to keep each steady P1/P0 pair at exactly 152 cycles.
   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
#else
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
#endif
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
#if TEMPLATE_stripes == 1
   // Y is not used by the cached right-half writes, so commit it here. The
   // same three cycles used to follow PF2; moving them delays the reflected
   // half while preserving the 152-cycle P1/P0 pair.
   asm sty.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta.a PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
#else
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
#endif
#if TEMPLATE_stripes == 0
   asm sty.z TEMPLATE_player0_y;
   asm nop;
#endif
   asm bcc.same @drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @continueP0;
   asm @drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @continueP0:;
   // Carry both the P0 graphics byte in A and the M0 enable bit in C across
   // DEC/BNE; neither instruction changes A or C.
   // The next P1 half materializes ENAM0 during horizontal blanking.
#if TEMPLATE_stripes == 1
   asm lsr.z TEMPLATE_stripe_cache + 8;
   asm dex;
#else
   asm lsr.zx TEMPLATE_object_masks + 2,x;
   asm dec.z TEMPLATE_object_masks + 43;
#endif
   asm bne.same @continuerenderer;
#if TEMPLATE_stripes == 1
   // The last steady P0 leaves its graphics byte in A and M0 bit in carry.
   // Commit both while installing the boundary line's left PF0.
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   // X is the pair counter in the stripe steady loop. Restore the packed-mask
   // row offset only for the row-transition path.
   asm ldx.z TEMPLATE_stripe_cache + 9;
#else
   asm sta GRP0;
   asm lda #1;
   asm adc #0;
   asm sta ENAM0;
#endif

   // The sixteenth line of a row is a P1 half.  Draw the old row one last time,
   // advance X in the gap between the left and right playfield writes, and then
   // prepare the first P0 half of the next row without consuming a scanline.
   asm @altrenderer:;
   // Draw the completed row's boundary line while advancing to the next row.
#if TEMPLATE_stripes == 1
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
#else
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
#endif
#if TEMPLATE_lines == 228
   asm cpx #56;
#else
   asm cpx #44;
#endif
   asm bne.same @terminalrenderer_not_equal;
   asm jmp @terminalrenderer;
   asm @terminalrenderer_not_equal:;
#if TEMPLATE_stripes == 1
   // Stage the next row's first Ball bit while installing the old row's right
   // stripe half. The normalized PF0 byte carries the Ball bit in invisible D1.
   asm lda.zx TEMPLATE_object_masks + 4,x;
   asm lsr;
   asm sta.z TEMPLATE_stripe_cache + 6;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta PF0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
#else
   // Keep both old-row right bytes in registers while X advances.  PF2 is
   // written first because it is the first register consumed on the reflected
   // right half.
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   // PF1's broad update window opens before PF2's narrow reflected handoff.
   // Commit PF1 first at cycle 45, then PF2 at cycle 48.  The two zero-page
   // stores save one cycle, which the following transition PF2 store restores.
   asm sta PF1;
   asm sty PF2;
   // Stage the first Ball bit of the next row while the old row is still
   // displayed. VDELBL defers the visible change until the following GRP1
   // transfer, avoiding the old boundary carry/drop defect.
   asm lsr.zx TEMPLATE_object_masks + 4,x;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
#endif
   asm txa;
   asm adc #4;
   asm tax;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @transition_activeP1;
   // Commit P1 first. The M1 shift follows GRP1 so the Ball latch can be
   // transferred on time without delaying the next row's left playfield writes.
   asm ldy #0;
   asm sty.a GRP1;
   asm jmp @transition_continueP1;
   asm @transition_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm @transition_continueP1:;
   // Shift M1 after GRP1. Its carry survives the next row's left playfield
   // writes and is materialized in the old seven-cycle Ball-enable slot.
#if TEMPLATE_stripes == 1
   asm lda.zx TEMPLATE_object_masks + 1,x;
   asm lsr;
   asm sta.z TEMPLATE_stripe_cache + 7;
#else
   asm lsr.zx TEMPLATE_object_masks + 1,x;
#endif

   // First P0 half after a row transition.
#if TEMPLATE_stripes == 1
   // M1's carry also installs this line's left PF0; the right PF0 uses an
   // absolute store to keep the same one-cycle phase pad as the steady P0 half.
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta.a PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
#else
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   // Materialize the M1 carry after the left half. ENABL was already staged
   // and transferred at the row boundary.
   asm lda #1;
   asm adc #0;
   asm sta ENAM1;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta.a PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
#endif
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   // Save the decremented P0 index only after the beam-critical writes.  The
   // absolute store also restores the one cycle saved by the balanced P1 path,
   // keeping the following scanlines on the same phase.
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcc.same @transition_activeP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @transition_continueP0;
   asm @transition_activeP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @transition_continueP0:;
   asm sta GRP0;
#if TEMPLATE_stripes == 1
   asm lda.zx TEMPLATE_object_masks + 2,x;
   asm lsr;
   asm sta.z TEMPLATE_stripe_cache + 8;
#else
   asm lsr.zx TEMPLATE_object_masks + 2,x;
#endif

   // Fall directly into the first P1 half.  The remaining-pair counter is set
   // after the four display writes so this line reaches the same safe phases as
   // the steady lines without changing the total pair length.
   asm @transition_firstP1:;
   // Commit the M0 carry left by the transition P0 half.
#if TEMPLATE_stripes == 1
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm lsr.z TEMPLATE_stripe_cache + 6;
   asm adc #0;
   asm sta PF0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
#else
   asm lda #1;
   asm adc #0;
   asm sta ENAM0;
   asm lda #1;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm sta ENABL;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm lda #7;
   asm sta.z TEMPLATE_object_masks + 43;
#endif
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @transition_first_activeP1;
   asm ldy #0;
   asm sty.a GRP1;
   asm bcs.same @transition_first_doneP1;
   asm @transition_first_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm @transition_first_doneP1:;
#if TEMPLATE_stripes == 1
   asm lsr.z TEMPLATE_stripe_cache + 7;
#else
   asm lsr.zx TEMPLATE_object_masks + 1,x;
#endif
   asm lda #1;
   asm adc #0;
   asm sta ENAM1;

   // Fall directly into a P0 half.  Duplicating this one body avoids the
   // three-cycle jump that would otherwise shift every later row.
#if TEMPLATE_stripes == 1
   // Left PF0 was pre-staged with M1 above.
   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta.a PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
#else
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
#endif
   asm sty.z TEMPLATE_player0_y;
   asm bcc.same @transition_follow_activeP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @transition_follow_continueP0;
   asm @transition_follow_activeP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @transition_follow_continueP0:;
#if TEMPLATE_stripes == 1
   asm lsr.z TEMPLATE_stripe_cache + 8;
#else
   asm lsr.zx TEMPLATE_object_masks + 2,x;
#endif
#if TEMPLATE_stripes == 1
   // The first two bits of the new row were shifted directly into the scalar
   // mask cache above. Preserve the new row offset for the next boundary and
   // resume with six ordinary P1/P0 pairs. A and carry still hold P0/M0.
   asm stx.z TEMPLATE_stripe_cache + 9;
   asm ldx #6;
   asm jmp @continuerenderer;
#else
   asm dec.z TEMPLATE_object_masks + 43;
   asm beq.same @continuerenderer_not_equal;
   asm jmp @continuerenderer;
#endif
   asm @continuerenderer_not_equal:;
   asm sta GRP0;
   asm lda #1;
   asm adc #0;
   asm sta ENAM0;
   asm jmp @altrenderer;

   // The final row needs no object setup for a following line.  Finish its
   // reflected right half, then WSYNC through the remainder of the final visible
   // line. draw() returns at cycle zero of the following line so the caller's
   // immediate VBLANK write cannot leave a partially drawn extra scanline.
   asm @terminalrenderer:;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   // The final reflected pair uses the same 48/55 physical phases as the
   // body.  WSYNC absorbs the four cycles removed from the old late schedule.
   asm sty.a PF2;
   asm bit.z $00;
   asm sta.a PF1;

   asm @endrenderer:;
#endif
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
   // VBLANK is asserted before this callback, so display-state cleanup cannot
   // cut a visible scanline short.  Restore the caller's playfield position
   // here rather than at the end of draw(): those ten cycles previously delayed
   // the VBLANK assertion into the first visible pixels of line 232, producing a
   // partially drawn extra scanline in Stella.
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_object_masks + 47;
   asm sta.z TEMPLATE_object_masks + 47;

   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;

#ifdef VCS_STRIPES2_COMPACT_ROWEDGE_PROBE
   // VBLANK seeds each mutable Y as public_y+1.  The staged first P0 half plus
   // 96 visible P0 updates consume 97 decrements, while P1 consumes 96 total;
   // add 96/95 respectively to recover the caller's public values without
   // pinning two service bytes for the entire visible frame.
   asm lda.z TEMPLATE_player0_y;
   asm clc;
   asm adc #96;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_player1_y;
   asm clc;
   asm adc #95;
   asm sta.z TEMPLATE_player1_y;
#else
   asm lda.z TEMPLATE_object_masks + 27;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_player1_y;
#endif

}
#elif TEMPLATE_lines == 181 || TEMPLATE_lines == 170
// Repeatable official-opcode TEMPLATE_lines-scanline P0/P1/M0/M1/BL gameplay component
// derived from the proven player-color raster. Player colors are solid for the
// complete frame because the two timed per-row color slots now update M1 and M0.
//
// Instantiate with:
//
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=181)
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=170)
//
// Include vcs.c26 first. The 181-line profile uses INSTANCE_playfield[44]
// around one independent 11-line score; the 170-line profile uses
// INSTANCE_playfield[40] between two independent 11-line scores.
// It owns no score/font, VSYNC, VBLANK, or RIOT timer state.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := TEMPLATE_lines,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := TEMPLATE_lines,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 58,
   TEMPLATE_OBJECT_COUNT := 5,
#if TEMPLATE_lines == 181
   TEMPLATE_PLAYFIELD_BYTES := 44,
   TEMPLATE_PLAYFIELD_ROWS := 11,
#else
   TEMPLATE_PLAYFIELD_BYTES := 40,
   TEMPLATE_PLAYFIELD_ROWS := 10,
#endif
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 0,
   TEMPLATE_PRIVATE_RAM_BYTES := 44,
   TEMPLATE_PUBLIC_RAM_BYTES := 23,
   TEMPLATE_MODULE_RAM_BYTES := 67
};

// BL/M1/M0 use the first three bytes of each stride-four row. The fourth lane
// is beam-dead and carries all renderer-private state after VBLANK preparation.
// A 44th byte supplies the final lane slot and backs playfield_position.
uint8_t TEMPLATE_object_masks[44];
alias TEMPLATE_playfield_position TEMPLATE_object_masks[43]

require inline void TEMPLATE_init(void) {
}

require inline void TEMPLATE_vblank(void) {
   asm .callstackextra 4;
   // Build BL/M1/M0 schedules first. Their public Y values are never mutated;
   // the dead fourth mask lane becomes private state only after preparation.
   asm jsr @TEMPLATE_prepare_object_masks;
   asm jmp @TEMPLATE_prepare_object_masks_done;
   asm @TEMPLATE_prepare_object_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #44;
   asm bcc.same @clear;
   // VDELBL staging consumes the next-row Ball bit at the boundary, so prepare
   // Ball one pair ahead and allow the biased terminal endpoint through 88.
#if TEMPLATE_lines == 181
   asm lda #88;
#else
   asm lda #80;
#endif
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   asm adc #1;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
#if TEMPLATE_lines == 181
   asm lda #88;
#else
   asm lda #80;
#endif
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_missile1_y;
   asm ldy.z TEMPLATE_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_missile0_y;
   asm ldy.z TEMPLATE_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;
   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @no_wrap;
   asm beq.same @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq.same @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_low_ready;
   asm beq.same @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_high_ready;
   asm beq.same @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne.same @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @no_wrap_last_ready;
   asm beq.same @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @set_range;
   asm beq.same @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne.same @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs.same @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @TEMPLATE_prepare_object_masks_done:;

   // Preparation is finished with the fourth lane. Preserve only P0/P1, the
   // two Y values the visible loop mutates; BL/M0/M1 remain public and stable.
   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_object_masks + 3;
   asm lda.z TEMPLATE_player1_y;
   asm sta.z TEMPLATE_object_masks + 7;

   // Position Ball, M1, and M0 during VBLANK. P0/P1 remain in the
   // visible-boundary handoff because an optional score component owns them.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #3;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #2;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   // The score handoff will install P0/P1 motion. Apply the M0/M1/Ball fine
   // motion together here, then clear those registers later after HMOVE has
   // completed. Start with both missiles disabled.
   asm lda #0;
   asm sta HMP0;
   asm sta HMP1;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #0;
   asm sta ENAM0;
   asm sta ENAM1;

   // Precompute packed P0/P1 position controls in constant time. Repeated
   // subtraction here made VBLANK coordinate-dependent and overran at the
   // right endpoint; the visible entry loops consume the packed step counts.
   asm ldx.z TEMPLATE_object_x;
   asm lda.ax TEMPLATE_player_position_table,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm ldx.z TEMPLATE_object_x + 1;
   asm lda.ax TEMPLATE_player_position_table,x;
   asm sta.z TEMPLATE_object_masks + 31;

   // The M0/M1/Ball HMOVE above has long since completed. Clear those three
   // motion registers individually now, rather than strobing HMCLR immediately
   // after HMOVE, so the later P0/P1 visible-entry HMOVE cannot move them again.
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;

   // Prepare the row counter and private Y state while output is blanked.
   // Ball setup remains on the third visible handoff line so this callback
   // stays within the shared VBLANK deadline.
   asm lda #8;
   asm sta.z TEMPLATE_object_masks + 35;
   asm dec.z TEMPLATE_player0_y;
   asm dec.z TEMPLATE_player0_y;
}

require inline void TEMPLATE_draw(void) {
   // Visible handoff line 1 restores P1 after an optional score component.
   asm ldy.z TEMPLATE_object_masks + 31;
   asm sty HMP1;
   asm tya;
   asm and #$0f;
   asm tax;
   asm @TEMPLATE_player1_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_player1_position_loop;
   asm sta RESP1;
   asm sta WSYNC;

   // Visible handoff line 2 restores P0 at the matching phase.
   asm ldy.z TEMPLATE_object_masks + 27;
   asm sty HMP0;
   asm tya;
   asm and #$0f;
   asm tax;
   asm bit.z $00;
   asm @TEMPLATE_player0_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_player0_position_loop;
   asm sta RESP0;
   asm sta WSYNC;

   // Restore gameplay state and stage the first half of the proven 192-line
   // pipeline. The final WSYNC establishes the same cycle-zero entry phase.
   asm sta HMOVE;
   asm lda.z TEMPLATE_player0_nusiz;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_player1_nusiz;
   asm sta NUSIZ1;
   asm lda.z TEMPLATE_player0_color;
   asm sta COLUP0;
   asm lda.z TEMPLATE_player1_color;
   asm sta COLUP1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   // A predecessor owns player reflection while it draws. Re-establish normal
   // gameplay orientation before any gameplay graphics can become visible.
   asm stx REFP0;
   asm stx REFP1;
   asm stx GRP0;
   asm stx GRP1;
   asm stx PF0;
   asm stx PF1;
   asm stx PF2;
   asm stx CXCLR;
   asm lda.z TEMPLATE_object_masks + 23;
   asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm lsr.zx TEMPLATE_object_masks + 1,x;
   asm lda #1;
   asm adc #0;
   asm sta ENAM1;
   // End the visible setup line with the playfield still cleared. Priming
   // only PF1/PF2 here would expose a malformed half-initialized row.
   asm sta WSYNC;
   asm bit.z $00;

   // The first visible line is the P0 half of the normal two-line pipeline.
   // Do the non-display work before the playfield writes so the left and right
   // bytes reach the TIA at the same phases used by the steady-state loop.
   asm bit.z $00;
   asm bit.z $00;
   asm nop;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bit.z $00;
   asm nop;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm bcc.same @first_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @first_continueP0;
   asm @first_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @first_continueP0:;
   // Preserve the selected P0 byte in A and the M0 bit in carry until the
   // common horizontal-blank entry.  Seven pad cycles replace the redundant
   // early ENAM0 materialization without changing the raster phase.
   asm lsr.zx TEMPLATE_object_masks + 2,x;
   asm bit.z $00;
   asm nop;
   asm dec.z TEMPLATE_object_masks + 35;
   asm jmp @continuerenderer;

   asm .align 256;
   asm @kerloop:;
   asm @continuerenderer:;
   // P0 remains in A across the M0-mask shift and pair counter.  Commit it in
   // horizontal blank before an extreme-right player can fetch the next row.
   asm sta GRP0;
   // M0 was shifted at the end of the preceding P0 half.  Commit it before
   // the beam enters the visible region.
   asm lda #1;
   asm adc #0;
   asm sta ENAM0;
   asm @continuerenderer2:;
   // P1 half.  Update Ball before the display writes, then leave a three-cycle
   // gap between the left and right halves of the asymmetric playfield.
   asm lda #1;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty.a PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm sta ENABL;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm @goback:;
   asm @startrenderer:;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @skipP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @continueP1;
   asm @skipP1:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_object_masks + 19;
   asm @continueP1:;
   // Shift M1 first, then carry the selected P1 byte and M1 carry through the
   // scanline boundary.  Both visible objects are committed in the following
   // horizontal blank without changing the pair's cycle count.
   asm lsr.zx TEMPLATE_object_masks + 1,x;
   asm sta GRP1;
   asm lda #1;
   asm adc #0;
   asm sta ENAM1;

   asm @p0renderer:;
   // P0 half.  Move eleven cycles of P0 bookkeeping ahead of the playfield
   // writes and remove the old carry clear; every Ball ADC gets its carry from
   // the immediately preceding LSR.  The pair remains exactly 152 cycles.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm sty.z TEMPLATE_player0_y;
   asm nop;
   asm bcc.same @drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @continueP0;
   asm @drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @continueP0:;
   // Carry both the P0 graphics byte in A and the M0 enable bit in C across
   // DEC/BNE; neither instruction changes A or C.
   // The next P1 half materializes ENAM0 during horizontal blanking.
   asm lsr.zx TEMPLATE_object_masks + 2,x;
   asm dec.z TEMPLATE_object_masks + 35;
   asm bne.same @continuerenderer;
   asm sta GRP0;
   asm lda #1;
   asm adc #0;
   asm sta ENAM0;

   // The sixteenth line of a row is a P1 half.  Draw the old row one last time,
   // advance X in the gap between the left and right playfield writes, and then
   // prepare the first P0 half of the next row without consuming a scanline.
   asm @altrenderer:;
   // Draw the completed row's boundary line while advancing to the next row.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
#if TEMPLATE_lines == 181
   asm cpx #40;
#else
   asm cpx #36;
#endif
   asm bne.same @terminalrenderer_not_equal;
   asm jmp @terminalrenderer;
   asm @terminalrenderer_not_equal:;
   // Keep both old-row right bytes in registers while X advances.  PF2 is
   // written first because it is the first register consumed on the reflected
   // right half.
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   // PF1's broad update window opens before PF2's narrow reflected handoff.
   // Commit PF1 first at cycle 45, then PF2 at cycle 48. The two zero-page
   // stores save one cycle, which the following transition PF2 store restores.
   asm sta PF1;
   asm sty PF2;
   // Stage the first Ball bit of the next row while the old row is still
   // displayed. VDELBL defers the visible change until the following GRP1.
   asm lsr.zx TEMPLATE_object_masks + 4,x;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
   asm txa;
   asm adc #4;
   asm tax;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @transition_activeP1;
   // Commit P1 first. The M1 shift follows GRP1 so the Ball latch transfers
   // on time without delaying the next row's left playfield writes.
   asm ldy #0;
   asm sty.a GRP1;
   asm jmp @transition_continueP1;
   asm @transition_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm @transition_continueP1:;
   // Shift M1 after GRP1. Its carry survives the next row's left playfield
   // writes and is materialized in the old seven-cycle Ball-enable slot.
   asm lsr.zx TEMPLATE_object_masks + 1,x;

   // First P0 half after a row transition.  Its four playfield writes must land
   // at the same phases as every steady scanline.
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   // Materialize the M1 carry after the left half. ENABL was already staged
   // and transferred at the row boundary.
   asm lda #1;
   asm adc #0;
   asm sta ENAM1;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta.a PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   // Save the decremented P0 index only after the beam-critical writes.  The
   // absolute store also restores the one cycle saved by the balanced P1 path,
   // keeping the following scanlines on the same phase.
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcc.same @transition_activeP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @transition_continueP0;
   asm @transition_activeP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @transition_continueP0:;
   asm sta GRP0;
   asm lsr.zx TEMPLATE_object_masks + 2,x;

   // Fall directly into the first P1 half.  The remaining-pair counter is set
   // after the four display writes so this line reaches the same safe phases as
   // the steady lines without changing the total pair length.
   asm @transition_firstP1:;
   // Commit the M0 carry left by the transition P0 half.
   asm lda #1;
   asm adc #0;
   asm sta ENAM0;
   asm lda #1;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm lsr.zx TEMPLATE_object_masks,x;
   asm adc #0;
   asm sta ENABL;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm lda #7;
   asm sta.z TEMPLATE_object_masks + 35;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @transition_first_activeP1;
   asm ldy #0;
   asm sty.a GRP1;
   asm bcs.same @transition_first_doneP1;
   asm @transition_first_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm @transition_first_doneP1:;
   asm lsr.zx TEMPLATE_object_masks + 1,x;
   asm lda #1;
   asm adc #0;
   asm sta ENAM1;

   // Fall directly into a P0 half.  Duplicating this one body avoids the
   // three-cycle jump that would otherwise shift every later row.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm sty.z TEMPLATE_player0_y;
   asm bcc.same @transition_follow_activeP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @transition_follow_continueP0;
   asm @transition_follow_activeP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @transition_follow_continueP0:;
   asm lsr.zx TEMPLATE_object_masks + 2,x;
   asm dec.z TEMPLATE_object_masks + 35;
   asm beq.same @continuerenderer_not_equal;
   asm jmp @continuerenderer;
   asm @continuerenderer_not_equal:;
   asm sta GRP0;
   asm lda #1;
   asm adc #0;
   asm sta ENAM0;
   asm jmp @altrenderer;

   // The final row needs no object setup for a following line.  Finish its
   // reflected right half, then WSYNC through the remainder of visible line
   // 231.  draw() therefore returns at cycle zero of the following line and the caller's
   // immediate VBLANK write cannot leave a partially drawn extra scanline.
   asm @terminalrenderer:;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   // The final reflected pair uses the same 48/55 physical phases as the
   // body. WSYNC absorbs the four cycles removed from the old late schedule.
   asm sty.a PF2;
   asm bit.z $00;
   asm sta.a PF1;
   asm sta WSYNC;

   asm @endrenderer:;

#if TEMPLATE_lines == 170
   // Ten full 16-line playfield rows plus the five-line score handoff consume
   // 165 lines. Pad five blank lines so this profile returns after exactly 170.
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
#endif

   // Clear display state while the component completes its visible handoff.
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
   asm lda.z TEMPLATE_object_masks + 3;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_player1_y;
}
#else
// Deliberately fail at file scope with a descriptive unresolved size token.
extern const uint8_t TEMPLATE_playfield[TEMPLATE_lines_must_be_170_181_192_or_228];
#endif

#elif TEMPLATE_missiles == 0 && TEMPLATE_player_colors == 1

// Official P0/P1/Ball per-row-color specialization.
#if TEMPLATE_lines == 192 || TEMPLATE_lines == 228
// Full-height scoreless profile. Each instance requires a page-contained
// immutable TEMPLATE_playfield[48] for 192 lines or TEMPLATE_playfield[60] for
// 228 lines. Player colors may be mutable when
// VCS_PLAYER_COLOR_MUTABLE_COLORS is defined before instantiation.
// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := TEMPLATE_lines,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := TEMPLATE_lines,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 0,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 0,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 66,
   TEMPLATE_OBJECT_COUNT := 3,
#if TEMPLATE_lines == 228
   TEMPLATE_PLAYFIELD_BYTES := 60,
   TEMPLATE_PLAYFIELD_ROWS := 15,
#else
   TEMPLATE_PLAYFIELD_BYTES := 48,
   TEMPLATE_PLAYFIELD_ROWS := 12,
#endif
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 7,
   TEMPLATE_PRIVATE_RAM_BYTES := 10,
   TEMPLATE_PUBLIC_RAM_BYTES := 13,
   TEMPLATE_MODULE_RAM_BYTES := 23
};

uint8_t TEMPLATE_workspace[7];
uint8_t TEMPLATE_playfield_position;

require inline void TEMPLATE_init(void) {
   // The private workspace is rebuilt from public state every VBLANK and is
   // dead after overscan restores the public Y coordinates.  Authorize the
   // linker to share it with compiler-owned storage from disjoint frame phases.
   asm .ifndef __phaseworkspace$V1$TEMPLATE_workspace;
   asm __phaseworkspace$V1$TEMPLATE_workspace = 0;
   asm .export __phaseworkspace$V1$TEMPLATE_workspace;
   asm .endif;
}

require inline void TEMPLATE_vblank(void) {
   // The visible loop uses no hidden assembly subroutines.
   asm .callstackextra 0;

   // Preserve application Y coordinates before the visible renderer mutates them.
   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_workspace + 1;
   asm lda.z TEMPLATE_player1_y;
   asm sta.z TEMPLATE_workspace + 2;
   asm lda.z TEMPLATE_ball_y;
   asm sta.z TEMPLATE_workspace + 3;

   // The old visible-entry RESP setup consumed two scanlines before the object
   // raster.  With positioning moved into VBLANK, bias the private working Y
   // coordinates by one so the public coordinate system remains unchanged.
   asm lda.z TEMPLATE_player0_y;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_player1_y;
   asm clc;
   // Match P0's public Y origin. P1 is primed during VBLANK, but that priming
   // already consumes its extra pipeline decrement; an additional +1 here
   // displaced P1 two visible scanlines below the same public Y coordinate.
   asm adc #1;
   asm sta.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   // Ball is committed on the P1 half through VDELBL, one pair later than
   // the countdown decision that stages ENABL.
   asm adc #2;
   asm sta.z TEMPLATE_ball_y;

   // P0/P1 use the same direct countdown as the visible loop.  Store height+1
   // thresholds because CPY then gives an active result exactly when the
   // decremented row index is in 0..height, including the normal uint8_t wrap.
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_workspace + 5;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_workspace + 6;

   // Position Ball, P1, and P0 entirely during VBLANK using the retained
   // divide-by-fifteen schedule.  The older full-height conversion reused a
   // table calibrated for visible-boundary RESP strobes; moving those strobes
   // into VBLANK without changing the calibration displaced both players.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm ldx #1;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm ldx #0;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda.z TEMPLATE_object_x + 2;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_object_x + 3;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;
   asm stx CXCLR;
   asm dec.z TEMPLATE_player0_y;
#if TEMPLATE_lines == 228
   asm lda #2;
#else
   asm lda #8;
#endif
   asm sta.z TEMPLATE_workspace;
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_playfield_position;

   // Stage the first half of the ordinary two-line pipeline while VBLANK is
   // still asserted.  draw() can therefore begin with the P0 half at exactly
   // the same phase used after every later row transition; no visible setup
   // scanline is consumed.
   asm dec.z TEMPLATE_ball_y;
   asm lda.z TEMPLATE_ball_height;
   asm cmp.z TEMPLATE_ball_y;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;

   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   asm bcs.same @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;

   asm ldy #0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_workspace + 4;
   asm sta COLUP0;

   // Prime the left half of the first row while output is blanked.  The right
   // half is installed by the first timed raster line.
   asm lda.a TEMPLATE_playfield;
   asm sta PF1;
   asm lda.a TEMPLATE_playfield + 1;
   asm sta PF2;
}

require inline void TEMPLATE_draw(void) {
   // The first visible line is the P0 half of the normal two-line pipeline.
   // Do the non-display work before the playfield writes so the left and right
   // bytes reach the TIA at the same phases used by the steady-state loop.
   asm lda.z TEMPLATE_workspace + 4;
   asm sta COLUP0;
   asm nop;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   // Fund the ten-cycle HBLANK graphics/color commit without moving either
   // right-playfield write.
   asm nop;
   asm bcs.same @first_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @first_continueP0;
   asm @first_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @first_continueP0:;
   // Carry the selected P0 graphics byte in A and its color-table index in Y
   // across the pair boundary; DEC/branch do not disturb either register.
   asm dec.z TEMPLATE_workspace;
   asm jmp @continuerenderer;

   asm .align 256;
   asm @kerloop:;
   asm @continuerenderer:;
   // Commit P0 graphics and its matching row color during horizontal blank.
   // The matching two-cycle pad lives after the preceding right-playfield
   // writes, preserving both their phases and the exact 152-cycle pair.
   asm sta GRP0;
#ifdef VCS_PLAYER_COLOR_MUTABLE_COLORS
   // VDELP0 delays the graphics until the following GRP1 write. Mutable-color
   // users may change every row between frames, so hold the matching color for
   // that same transfer instead of exposing the next row one scanline early.
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_workspace + 4;
#else
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
#endif
   asm @continuerenderer2:;
   // Keep the historical two-cycle lead-in so the left playfield writes retain
   // their exact phases.  Y is free after PF2, letting LDY/CPY replace the old
   // six-cycle Ball-mask shift without disturbing A=#1 for the carry conversion.
   asm lda #1;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm ldy.z TEMPLATE_ball_height;
   asm cpy.z TEMPLATE_ball_y;
   asm adc #0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm @goback:;
   asm @startrenderer:;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
#ifdef VCS_PLAYER_COLOR_MUTABLE_COLORS
   // Keep the original 26-cycle tail, but install the delayed P0 color just
   // before GRP1 transfers the pending P0 graphics. Reloading P1 graphics after
   // its color lookup frees workspace+4 for that delayed P0 color.
   asm bcs.same @skipP1;
   asm lda.z TEMPLATE_workspace + 4;
   asm sta COLUP0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm jmp @continueP1;
   asm @skipP1:;
   asm ldy #0;
   asm lda.z TEMPLATE_workspace + 4;
   asm sta COLUP0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm sta GRP1;
   asm bit.z TEMPLATE_workspace + 5;
   asm @continueP1:;
#else
   asm bcs.same @skipP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @continueP1;
   asm @skipP1:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @continueP1:;
   // Stage P1 in otherwise-unused workspace and commit it only after both
   // player colors are installed.  The GRP1 write then lands in horizontal
   // blanking; because VDELP0 is active, this also transfers the pending P0
   // graphics without changing either player during the visible right edge.
   asm sta.z TEMPLATE_workspace + 4;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.z TEMPLATE_workspace + 4;
   asm sta GRP1;
#endif

   asm @p0renderer:;
   // P0 half. Move eleven cycles of P0 bookkeeping ahead of the playfield
   // writes. The five-cycle direct Ball decrement occupies the old BIT/NOP pad,
   // so the pair remains exactly 152 cycles without an object-mask shift.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm nop;
   asm bcs.same @skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @continueP0;
   asm @skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @continueP0:;
   // Carry the selected P0 graphics byte in A and its color-table index in Y
   // across the pair boundary; DEC/branch do not disturb either register.
   asm dec.z TEMPLATE_workspace;
   asm bne.same @continuerenderer;
   // The row-ending fallthrough uses the same ten-cycle commit.  Its matching
   // pad already ran after the right-playfield writes, so GRP0 reaches the next
   // horizontal blank without changing the row-transition phase.
   asm sta GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   // Keep the row-boundary entry at the same phase as the proven mask-based
   // renderer.  This store is redundant as color state, but its three cycles
   // are beam timing: without them the boundary playfield line is visibly torn.
   asm sta COLUP0;

   // The sixteenth line of a row is a P1 half.  Draw the old row one last time,
   // advance X in the gap between the left and right playfield writes, and then
   // prepare the first P0 half of the next row without consuming a scanline.
   asm @altrenderer:;
   // The preceding P0 half left its next delayed color in A.  Install it before
   // drawing the boundary line so a row transition cannot skip a color-table
   // entry.
   asm sta COLUP0;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
#if TEMPLATE_lines == 228
   asm cpx #56;
#else
   asm cpx #44;
#endif
   asm bne.same @terminalrenderer_not_equal;
   asm jmp @terminalrenderer;
   asm @terminalrenderer_not_equal:;
   // Keep both old-row right bytes in registers while X advances.  This is the
   // proven row-boundary playfield schedule: PF1/PF2 left at 18/25 and PF2/PF1
   // right at 48/55 in Stella's physical scanline phase.
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm inx;
   asm inx;
   asm inx;
   asm sty.a PF2;
   asm inx;
   asm nop;
   asm sta PF1;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   // The old sparse Ball mask spent six cycles producing carry here.  Direct
   // countdown can produce the identical carry in the same six cycles with
   // LDA/CMP, so the playfield schedule does not need to move.  The active P1
   // path commits GRP1 first to preserve its graphics byte in A; the compare
   // follows immediately and still precedes the next line's ENABL materialization.
   asm bcc.same @transition_activeP1;
   asm ldy #0;
   asm lda.z TEMPLATE_ball_height;
   asm cmp.z TEMPLATE_ball_y;
   asm sty.a GRP1;
   asm jmp @transition_continueP1;
   asm @transition_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm lda.z TEMPLATE_ball_height;
   asm cmp.z TEMPLATE_ball_y;
   asm @transition_continueP1:;
   // Preserve the P1 color in A before the next line reuses Y.  CMP leaves the
   // direct-count Ball decision in carry; the next P0 half materializes that
   // carry into ENABL in the original seven-cycle slot.  Keeping Ball work out
   // of the boundary PF window preserves the proven 18/25/48/55 physical
   // playfield phases.
   asm lda.ay TEMPLATE_player1_colors,y;

   // First P0 half after a row transition.  Its four playfield writes must land
   // at the same phases as every steady scanline.
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm sta COLUP1;
   // Materialize the direct-count Ball carry in the same seven-cycle slot used
   // by the original mask renderer.  LDA/ADC/STA preserve the proven PF phases.
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta.a PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   // Save the decremented P0 index only after the beam-critical writes.  The
   // absolute store also preserves the established row-transition phase.
   asm sty.a TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm bcs.same @transition_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @transition_continueP0;
   asm @transition_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @transition_continueP0:;
   asm sta.a GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;

   // Fall directly into the first P1 half.  The remaining-pair counter is set
   // after the four display writes so this line reaches the same safe phases as
   // the steady lines without changing the total pair length.
   asm @transition_firstP1:;
   asm lda.z TEMPLATE_ball_height;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm dec.z TEMPLATE_ball_y;
   asm cmp.z TEMPLATE_ball_y;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
   asm lda #7;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm sta.z TEMPLATE_workspace;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   asm bcc.same @transition_first_activeP1;
   asm lda #0;
   asm sta GRP1;
   asm bit.z TEMPLATE_workspace + 5;
   asm nop;
   asm bit.z TEMPLATE_workspace + 5;
   asm jmp @transition_first_doneP1;
   asm @transition_first_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm @transition_first_doneP1:;

   // Fall directly into a P0 half.  Duplicating this one body avoids the
   // three-cycle jump that would otherwise shift every later row.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm bcs.same @transition_follow_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @transition_follow_continueP0;
   asm @transition_follow_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @transition_follow_continueP0:;
   asm dec.z TEMPLATE_workspace;
   asm beq.same @continuerenderer_not_equal;
   asm jmp @continuerenderer;
   asm @continuerenderer_not_equal:;
   asm jmp @altrenderer;

   // The final row needs no object setup for a following line.  Finish its
   // reflected right half, then WSYNC through the remainder of visible line
   // 231.  draw() therefore returns at cycle zero of line 232 and the caller's
   // immediate VBLANK write cannot leave a partially drawn extra scanline.
   asm @terminalrenderer:;
   asm bit.z $00;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm bit.z $00;
   asm nop;
   asm sty PF2;
   asm bit.z $00;
   asm sta.a PF1;
   asm sta WSYNC;

   asm @endrenderer:;
}

require inline void TEMPLATE_overscan(void) {
   // VBLANK is asserted before this callback, so display-state cleanup cannot
   // cut a visible scanline short.  Restore the caller's playfield position
   // here rather than at the end of draw(): those ten cycles previously delayed
   // the VBLANK assertion into the first visible pixels of line 232, producing a
   // partially drawn extra scanline in Stella.
   asm lda #10;
   asm clc;
   asm sbc.z TEMPLATE_playfield_position;
   asm sta.z TEMPLATE_playfield_position;

   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;

   asm lda.z TEMPLATE_workspace + 1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_workspace + 2;
   asm sta.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_workspace + 3;
   asm sta.z TEMPLATE_ball_y;
}

#elif TEMPLATE_lines == 181 || TEMPLATE_lines == 170
// Score-composable 181/170-line profile. The line parameter selects an
// 11-row/44-byte or 10-row/40-byte playfield with immutable player colors.
// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := TEMPLATE_lines,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := TEMPLATE_lines,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 40,
   TEMPLATE_OBJECT_COUNT := 3,
#if TEMPLATE_lines == 181
   TEMPLATE_PLAYFIELD_BYTES := 44,
   TEMPLATE_PLAYFIELD_ROWS := 11,
#else
   TEMPLATE_PLAYFIELD_BYTES := 40,
   TEMPLATE_PLAYFIELD_ROWS := 10,
#endif
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 8,
   TEMPLATE_PRIVATE_RAM_BYTES := 11,
   TEMPLATE_PUBLIC_RAM_BYTES := 13,
   TEMPLATE_MODULE_RAM_BYTES := 24
};

uint8_t TEMPLATE_workspace[8];
uint8_t TEMPLATE_playfield_position;

require inline void TEMPLATE_init(void) {
   // The private workspace is rebuilt from public state every VBLANK and is
   // dead after overscan restores the public Y coordinates. Authorize the
   // linker to share it with compiler-owned storage from disjoint frame phases.
   asm .ifndef __phaseworkspace$V1$TEMPLATE_workspace;
   asm __phaseworkspace$V1$TEMPLATE_workspace = 0;
   asm .export __phaseworkspace$V1$TEMPLATE_workspace;
   asm .endif;
}

require inline void TEMPLATE_vblank(void) {
   // The visible loop uses no hidden assembly subroutines.
   asm .callstackextra 0;

   // Preserve application Y coordinates before the visible renderer mutates them.
   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_workspace + 1;
   asm lda.z TEMPLATE_player1_y;
   asm sta.z TEMPLATE_workspace + 2;
   asm lda.z TEMPLATE_ball_y;
   asm sta.z TEMPLATE_workspace + 7;

   // Ball is committed through VDELBL one pair after the countdown decision.
   // Match the corrected 192-line direct-countdown coordinate convention.
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_ball_y;

   // P0/P1 retain the existing score-handoff Y choreography. Height+1 thresholds
   // let CPY select rows 0..height while preserving the old balanced branches.
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_workspace + 5;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_workspace + 6;

   // Ball positioning is a VBLANK responsibility. Apply its fine motion here;
   // after that HMOVE has completed, HMBL is cleared later in this callback so
   // only P0/P1 move at the visible-boundary HMOVE.
   // Keep the Ball strobe at the same cycle used by the retained five-object
   // schedule so its public X coordinate remains bit-for-bit compatible.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm sta.zx TEMPLATE_workspace,x;
   asm sta RESP0,x;
   asm ldy.zx TEMPLATE_workspace,x;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm lda #0;
   asm sta HMP0;
   asm sta HMP1;
   asm sta HMM0;
   asm sta HMM1;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #0;
   asm sta ENAM0;
   asm sta ENAM1;

   // Precompute packed P0/P1 position controls in constant time. Repeated
   // subtraction here made VBLANK coordinate-dependent and overran at the
   // right endpoint; the visible entry loops consume the packed step counts.
   asm ldx.z TEMPLATE_object_x;
   asm lda.ax TEMPLATE_player_position_table,x;
   asm sta.z TEMPLATE_workspace + 3;
   asm ldx.z TEMPLATE_object_x + 1;
   asm lda.ax TEMPLATE_player_position_table,x;
   asm sta.z TEMPLATE_workspace + 4;

   // The Ball HMOVE above has long since completed. Clear only HMBL now,
   // rather than strobing HMCLR immediately after HMOVE, so the later P0/P1
   // visible-entry HMOVE cannot move the Ball a second time.
   asm lda #0;
   asm sta HMBL;

   // Prepare the row counter and private Y state while output is blanked.
   // Ball and initial player color installation remain on the third visible
   // setup line so this callback stays within the existing VBLANK deadline.
   asm lda #8;
   asm sta.z TEMPLATE_workspace;
   asm dec.z TEMPLATE_player0_y;
   asm dec.z TEMPLATE_player0_y;
}

require inline void TEMPLATE_draw(void) {
   // Visible handoff line 1 restores P1 after an optional score component.
   asm ldy.z TEMPLATE_workspace + 4;
   asm sty HMP1;
   asm tya;
   asm and #$0f;
   asm tax;
   asm @TEMPLATE_player1_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_player1_position_loop;
   asm sta RESP1;
   asm sta WSYNC;

   // Visible handoff line 2 restores P0 at the matching phase.
   asm ldy.z TEMPLATE_workspace + 3;
   asm sty HMP0;
   asm tya;
   asm and #$0f;
   asm tax;
   asm bit.z $00;
   asm @TEMPLATE_player0_position_loop:;
   asm dex;
   asm bne.same @TEMPLATE_player0_position_loop;
   asm sta RESP0;
   asm sta WSYNC;

   // Restore gameplay state and stage the first half of the proven 192-line
   // pipeline. The final WSYNC establishes the same cycle-zero entry phase.
   asm sta HMOVE;
   asm lda.z TEMPLATE_object_x + 2;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_object_x + 3;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   // A predecessor owns player reflection while it draws. Re-establish normal
   // gameplay orientation before any gameplay graphics can become visible.
   asm stx REFP0;
   asm stx REFP1;
   asm stx GRP0;
   asm stx GRP1;
   asm stx PF0;
   asm stx PF1;
   asm stx PF2;
   asm stx CXCLR;
   asm dec.z TEMPLATE_ball_y;
   asm lda.z TEMPLATE_ball_height;
   asm cmp.z TEMPLATE_ball_y;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   asm bcs.same @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm ldy #0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta.z TEMPLATE_workspace + 3;
   asm sta COLUP0;
   // End the visible setup line with the playfield still cleared.  Priming
   // only PF1/PF2 here exposed a malformed half-initialized row before the
   // first complete timed scanline.
   asm sta WSYNC;
   asm bit.z $00;

   // The first visible line is the P0 half of the normal two-line pipeline.
   // Do the non-display work before the playfield writes so the left and right
   // bytes reach the TIA at the same phases used by the steady-state loop.
   asm lda.z TEMPLATE_workspace + 3;
   asm sta COLUP0;
   asm nop;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   // Fund the ten-cycle HBLANK graphics/color commit without moving either
   // right-playfield write.
   asm nop;
   asm bcs.same @first_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @first_continueP0;
   asm @first_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @first_continueP0:;
   // Carry the selected P0 graphics byte in A and its color-table index in Y
   // across the pair boundary; DEC/branch do not disturb either register.
   asm dec.z TEMPLATE_workspace;
   asm jmp @continuerenderer;

   asm @kerloop:;
   asm @continuerenderer:;
   // Commit P0 graphics and its matching row color during horizontal blank.
   // The matching two-cycle pad lives after the preceding right-playfield
   // writes, preserving both their phases and the exact 152-cycle pair.
   asm sta GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm @continuerenderer2:;
   asm lda #1;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm ldy.z TEMPLATE_ball_height;
   asm cpy.z TEMPLATE_ball_y;
   asm adc #0;
   asm sta ENABL;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm @goback:;
   asm @startrenderer:;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   asm bcs.same @skipP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @continueP1;
   asm @skipP1:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @continueP1:;
   // Stage P1 until the next horizontal blank.  Writing GRP1 then updates the
   // immediate P1 graphics and transfers the delayed P0/Ball graphics before
   // the beam reaches the visible right edge.
   asm sta.z TEMPLATE_workspace + 3;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.z TEMPLATE_workspace + 3;
   asm sta GRP1;

   asm @p0renderer:;
   // P0 half.  Move eleven cycles of P0 bookkeeping ahead of the playfield
   // writes and remove the old carry clear; every Ball ADC gets its carry from
   // the preceding direct Ball comparison.  The pair remains exactly 152 cycles.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm nop;
   asm bcs.same @skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @continueP0;
   asm @skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @continueP0:;
   // Carry the selected P0 graphics byte in A and its color-table index in Y
   // across the pair boundary; DEC/branch do not disturb either register.
   asm dec.z TEMPLATE_workspace;
   asm bne.same @continuerenderer;
   // The row-ending fallthrough uses the same ten-cycle commit.  Its matching
   // pad already ran after the right-playfield writes, so GRP0 reaches the next
   // horizontal blank without changing the row-transition phase.
   asm sta GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;

   // The sixteenth line of a row is a P1 half.  Draw the old row one last time,
   // advance X in the gap between the left and right playfield writes, and then
   // prepare the first P0 half of the next row without consuming a scanline.
   asm @altrenderer:;
   // The preceding P0 half left its next delayed color in A.  Install it before
   // drawing the boundary line so a row transition cannot skip a color-table
   // entry.  Load the Ball threshold in the old three-cycle transition slot;
   // CPY can then stage ENABL without stealing cycles from the reflected PF.
   asm sta COLUP0;
   asm ldy.z TEMPLATE_ball_height;
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
#if TEMPLATE_lines == 181
   asm cpx #40;
#else
   asm cpx #36;
#endif
   asm bne.same @terminalrenderer_not_equal;
   asm jmp @terminalrenderer;
   asm @terminalrenderer_not_equal:;
   // Compare Ball before loading the reflected bytes.  Loads and stores do
   // not disturb carry, so the seven-cycle ENABL materialization can happen
   // immediately after the PF writes.  PF1/PF2 therefore land at the proven
   // cycles 45/48 instead of the corrupting early 38/41 schedule.
   asm cpy.z TEMPLATE_ball_y;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta.a PF1;
   asm sty PF2;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
   // ADC above cannot carry out from 1+carry, so the four-byte row advance may
   // keep using the compact carry-clear ADC/TAX sequence.
   asm txa;
   asm adc #4;
   asm tax;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   // GRP1 transfers delayed P0 as well as changing P1.  ENABL is already
   // staged, so these balanced branches only select the P1 graphics byte.
   asm bcc.same @transition_activeP1;
   // The inactive and active paths are both eleven cycles.  The absolute STY
   // supplies the otherwise impossible one-cycle pad while also leaving Y=0
   // for the color lookup below.
   asm ldy #0;
   asm sty.a GRP1;
   asm jmp @transition_continueP1;
   asm @transition_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm @transition_continueP1:;
   // Preserve the P1 color in A before the playfield loads reuse Y.  The Ball
   // value is already staged.  This keeps the
   // four playfield writes at cycles 10, 17, 40, and 47, installs the correct
   // P1 color, and still enables the Ball well before its horizontal position.
   asm lda.ay TEMPLATE_player1_colors,y;

   // First P0 half after a row transition.  Its four playfield writes must land
   // at the same phases as every steady scanline.
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm sta COLUP1;
   // ENABL was staged before the row-boundary GRP1. Preserve the old seven-cycle
   // slot so every beam-critical write remains at its proven phase.
   asm bit.z $00;
   asm nop;
   asm nop;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta.a PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   // Save the decremented P0 index only after the beam-critical writes.  The
   // absolute store also preserves the established row-transition phase.
   asm sty.a TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm bcs.same @transition_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @transition_continueP0;
   asm @transition_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @transition_continueP0:;
   asm sta.a GRP0;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;

   // Fall directly into the first P1 half.  The remaining-pair counter is set
   // after the four display writes so this line reaches the same safe phases as
   // the steady lines without changing the total pair length.
   asm @transition_firstP1:;
   asm lda.z TEMPLATE_ball_height;
   asm ldy.ax TEMPLATE_playfield,x;
   asm sty PF1;
   asm ldy.ax TEMPLATE_playfield+1,x;
   asm sty PF2;
   asm dec.z TEMPLATE_ball_y;
   asm cmp.z TEMPLATE_ball_y;
   asm lda #1;
   asm adc #0;
   asm sta ENABL;
   asm lda #7;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm sty PF2;
   asm ldy.ax TEMPLATE_playfield+3,x;
   asm sty PF1;
   asm sta.z TEMPLATE_workspace;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_workspace + 6;
   asm bcc.same @transition_first_activeP1;
   asm lda #0;
   asm sta GRP1;
   asm bit.z TEMPLATE_workspace + 5;
   asm nop;
   asm bit.z TEMPLATE_workspace + 5;
   asm jmp @transition_first_doneP1;
   asm @transition_first_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm @transition_first_doneP1:;

   // Fall directly into a P0 half.  Duplicating this one body avoids the
   // three-cycle jump that would otherwise shift every later row.
   asm lda.ax TEMPLATE_playfield,x;
   asm sta PF1;
   asm lda.ax TEMPLATE_playfield+1,x;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_workspace + 5;
   asm dec.z TEMPLATE_ball_y;
   asm lda.ax TEMPLATE_playfield+2,x;
   asm sta PF2;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm sta PF1;
   asm bcs.same @transition_follow_skipP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @transition_follow_continueP0;
   asm @transition_follow_skipP0:;
   asm lda #0;
   asm tay;
   asm bit.z TEMPLATE_workspace + 5;
   asm @transition_follow_continueP0:;
   asm dec.z TEMPLATE_workspace;
   asm beq.same @continuerenderer_not_equal;
   asm jmp @continuerenderer;
   asm @continuerenderer_not_equal:;
   asm jmp @altrenderer;

   // The final row needs no object setup for a following line.  Finish its
   // reflected right half, then WSYNC through the remainder of visible line
   // 231.  draw() therefore returns at cycle zero of the following line and the caller's
   // immediate VBLANK write cannot leave a partially drawn extra scanline.
   asm @terminalrenderer:;
   asm ldy.ax TEMPLATE_playfield+2,x;
   asm lda.ax TEMPLATE_playfield+3,x;
   asm bit.z $00;
   asm nop;
   asm sty PF2;
   asm bit.z $00;
   asm sta.a PF1;
   asm sta WSYNC;

   asm @endrenderer:;

#if TEMPLATE_lines == 170
   // Ten full 16-line playfield rows plus the five-line score handoff consume
   // 165 lines. Pad five blank lines so this profile returns after exactly 170.
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
#endif

   // Clear display state while the component completes its visible handoff.
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
   asm lda.z TEMPLATE_workspace + 1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_workspace + 2;
   asm sta.z TEMPLATE_player1_y;
   asm lda.z TEMPLATE_workspace + 7;
   asm sta.z TEMPLATE_ball_y;
}

#else
// Deliberately fail at file scope with a descriptive unresolved size token.
extern const uint8_t TEMPLATE_playfield[TEMPLATE_lines_must_be_170_181_192_or_228];
#endif

#elif TEMPLATE_missiles == 1 && TEMPLATE_player_colors == 1
#if TEMPLATE_lines == 192
// Official-opcode full-height P0/P1/M0/M1/BL gameplay specialization with
// independent eight-entry P0/P1 color tables. This is the combined 192-line
// cycle schedule selected by missiles:=1, player_colors:=1.
//
// Instantiate with:
//
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=192, missiles:=1, player_colors:=1)
//
// Include vcs.c26 first.  Each instance requires page-contained immutable
// INSTANCE_playfield[48], INSTANCE_player0_colors[8], and
// INSTANCE_player1_colors[8] objects.  The component draws twelve uniform
// 16-line playfield rows for exactly 192 visible scanlines.
//
// It owns no score/font, VSYNC, VBLANK, or RIOT timer state. draw() returns on
// the boundary after the 192nd visible line; overscan() clears gameplay state
// and restores application player heights.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 192,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 192,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 0,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 0,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 66,
   TEMPLATE_OBJECT_COUNT := 5,
   TEMPLATE_PLAYFIELD_BYTES := 48,
   TEMPLATE_PLAYFIELD_ROWS := 12,
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 14,
   TEMPLATE_PRIVATE_RAM_BYTES := 62,
   TEMPLATE_PUBLIC_RAM_BYTES := 21,
   TEMPLATE_MODULE_RAM_BYTES := 83
};

// Three compact vertical masks are built for each 16-line playfield row. Bits
// 0..6 are shifted into TIA D1; the eighth BL/M1/M0 bits are packed into the
// fourth byte as D1/D2/D3. Two seven-byte row caches hold the current and next
// row's four playfield bytes plus three D1-ready object masks.
uint8_t TEMPLATE_object_masks[48];
uint8_t TEMPLATE_row_cache[14];

require inline void TEMPLATE_init(void) {
}

require inline void TEMPLATE_vblank(void) {
   // Internal assembly helpers add one hidden JSR level.
   asm .callstackextra 4;
   // Build the three non-player schedules directly from public coordinates.
   // P0/P1 are biased only after preparation; BL/M0/M1 never need to mutate
   // their public Y values at all.
   asm jsr @TEMPLATE_prepare_object_masks;
   asm jmp @TEMPLATE_prepare_object_masks_done;
   asm @TEMPLATE_prepare_object_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #48;
   asm bcc.same @clear;
   // The Ball is biased one pair ahead for VDELBL staging, so the inclusive
   // preparation limit is 96 even though visible pair indices end at 95.
   asm lda #96;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   asm adc #2;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   // Missiles use the original one-pair bias and 0..95 preparation limit.
   asm lda #95;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_missile1_y;
   asm clc;
   asm adc #1;
   asm ldy.z TEMPLATE_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_missile0_y;
   asm clc;
   asm adc #1;
   asm ldy.z TEMPLATE_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;

   // No special terminal row is required: Ball, P0, and P1 all remain in
   // the ordinary raster pipeline through row twelve.
   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @no_wrap;
   asm beq.same @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq.same @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_low_ready;
   asm beq.same @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_high_ready;
   asm beq.same @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne.same @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @no_wrap_last_ready;
   asm beq.same @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @set_range;
   asm beq.same @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne.same @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs.same @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @TEMPLATE_prepare_object_masks_done:;

   // Convert each three-byte row mask from D0..D7 into a D1-ready seven-bit
   // stream. The old D7 bits are packed in the fourth lane as BL/M1/M0 in
   // D1/D2/D3. That lane is consumed only by the final pair of each row.
   asm ldx #0;
   asm @TEMPLATE_encode_masks:;
   asm asl.zx TEMPLATE_object_masks + 2,x;
   asm lda #0;
   asm rol;
   asm asl.zx TEMPLATE_object_masks + 1,x;
   asm rol;
   asm asl.zx TEMPLATE_object_masks,x;
   asm rol;
   asm asl;
   asm sta.zx TEMPLATE_object_masks + 3,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #48;
   asm bcc.same @TEMPLATE_encode_masks;

   // Prime cache A with row zero before reclaiming its compact source bytes as
   // visible-phase working Y coordinates and the current source-row offset.
   asm lda.a TEMPLATE_playfield;
   asm sta.z TEMPLATE_row_cache;
   asm lda.a TEMPLATE_playfield + 1;
   asm sta.z TEMPLATE_row_cache + 1;
   asm lda.a TEMPLATE_playfield + 2;
   asm sta.z TEMPLATE_row_cache + 2;
   asm lda.a TEMPLATE_playfield + 3;
   asm sta.z TEMPLATE_row_cache + 3;
   asm lda.z TEMPLATE_object_masks;
   asm sta.z TEMPLATE_row_cache + 4;
   asm lda.z TEMPLATE_object_masks + 1;
   asm sta.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_object_masks + 2;
   asm sta.z TEMPLATE_row_cache + 6;

   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_object_masks + 0;
   asm lda.z TEMPLATE_player1_y;
   asm clc;
   // Match P0's public Y origin.  The P1 half already pays its pipeline
   // decrement; the old +2 bias displaced equal public Y coordinates one
   // two-scanline pair below P0.
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 1;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 2;

   // Height+1 is the direct-count threshold used by the player paths. Restore
   // the public values in overscan after the visible phase is complete.
   asm inc.z TEMPLATE_player0_height;
   asm inc.z TEMPLATE_player1_height;

   // Position all five objects during VBLANK with the same calibrated
   // divide-by-fifteen RESP/HMxx sequence proven by player_color_192.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #3;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #2;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #1;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #0;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm sta HMOVE;
   asm lda.z TEMPLATE_player0_nusiz;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_player1_nusiz;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;
   asm stx CXCLR;

   // Stage row-zero BL/M1 from cache A. Their D1-ready bytes can be written
   // directly to the TIA before being shifted for the next pair.
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm lsr.z TEMPLATE_row_cache + 4;

   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;

   // Prime the left half of row zero from cache A while output is blanked.
   asm lda.z TEMPLATE_row_cache;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
}

require inline void TEMPLATE_draw(void) {
   // Row zero enters at the scheduler's cycle-3 handoff.  The first visible
   // P0 half is timed to place the first cached pair at cycle 75; every normal
   // pair thereafter is exactly 152 cycles.
   asm bit.z $00;
   asm bit.z $00;
   asm nop;
   asm lda.a TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.a TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm bit.z $00;
   asm nop;
   asm lda.a TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same @TEMPLATE_first_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_first_p0_ready;
   asm @TEMPLATE_first_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_first_p0_ready:;
   asm sta GRP0;
   asm nop;
   asm nop;
   asm jmp @TEMPLATE_A_u1;

   asm .align 256, $90;
   // A pair 1: fixed 152-cycle cached pair.
   asm @TEMPLATE_A_u1:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.ax TEMPLATE_playfield + 4,x;
   asm sta.z TEMPLATE_row_cache + 7;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_A_u1_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_A_u1_p1_ready;
   asm @TEMPLATE_A_u1_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_A_u1_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm lsr.z TEMPLATE_row_cache + 6;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
