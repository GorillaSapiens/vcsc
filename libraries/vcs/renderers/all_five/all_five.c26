#if defined(VCS_STRIPES2_RUNTIME_ALL8) || (!defined(VCS_STRIPES2_CERT_TAIL0) && !defined(VCS_STRIPES2_CERT_TAIL1) && !defined(VCS_STRIPES2_CERT_TAIL2) && !defined(VCS_STRIPES2_CERT_TAIL3) && !defined(VCS_STRIPES2_CERT_TAIL4) && !defined(VCS_STRIPES2_CERT_TAIL5) && !defined(VCS_STRIPES2_CERT_TAIL6) && !defined(VCS_STRIPES2_CERT_TAIL7))
