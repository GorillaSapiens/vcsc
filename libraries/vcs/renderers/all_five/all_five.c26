   asm @TEMPLATE_stripe_rowedge_seed_p0_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe_rowedge_seed_p0_ready:;
   asm sta.z TEMPLATE_stripe_service_p0_ptr;

   // Build five four-byte row records for X=$ec,$f0,$f4,$f8,$fc.  Record r
   // contains P0 for the *following* row (64+8r) and P1 for the current row
   // (56+8r).  The other two bytes are deliberately unused.  Visible pair0
   // loads both values in eight cycles, stores next P0 with a forced-absolute
   // four-cycle STA, and still closes the ordinary 23-cycle P1 slot exactly.
   asm lda #64;
   asm sta.z TEMPLATE_stripe_row_entry_cache + 18;
   asm lda #56;
   asm sta.z TEMPLATE_stripe_row_entry_cache + 19;
   asm ldx #0;
   asm @TEMPLATE_stripe_rowedge_cache_loop:;

   asm lda.z TEMPLATE_object_masks + 27;
   asm sec;
   asm sbc.z TEMPLATE_stripe_row_entry_cache + 18;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs.same @TEMPLATE_stripe_rowedge_cache_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_stripe_rowedge_cache_p0_store;
   asm @TEMPLATE_stripe_rowedge_cache_p0_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe_rowedge_cache_p0_store:;
   asm sta.zx TEMPLATE_stripe_row_entry_cache,x;

   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc.z TEMPLATE_stripe_row_entry_cache + 19;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_stripe_rowedge_cache_p1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_stripe_rowedge_cache_p1_store;
   asm @TEMPLATE_stripe_rowedge_cache_p1_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe_rowedge_cache_p1_store:;
   asm sta.zx TEMPLATE_stripe_row_entry_cache + 1,x;

   asm lda.z TEMPLATE_stripe_row_entry_cache + 18;
   asm clc;
   asm adc #8;
   asm sta.z TEMPLATE_stripe_row_entry_cache + 18;
   asm lda.z TEMPLATE_stripe_row_entry_cache + 19;
   asm clc;
   asm adc #8;
   asm sta.z TEMPLATE_stripe_row_entry_cache + 19;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #20;
   asm bcc.same @TEMPLATE_stripe_rowedge_cache_loop;
#endif
   // Stage the first half of the ordinary two-line pipeline while VBLANK is
   // still asserted.  draw() can therefore begin with the P0 half at exactly
   // the same phase used after every later row transition; no visible setup
   // scanline is consumed.
   asm lda.z TEMPLATE_object_masks + 23;
#if TEMPLATE_stripes > 0
   asm lsr.z TEMPLATE_object_masks;
#else
   asm lsr.zx TEMPLATE_object_masks,x;
#endif
   asm adc #0;
   asm sta ENABL;

   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_first_player1_ready;
   asm @TEMPLATE_first_player1_zero:;
   asm lda #0;
   asm tay;
   asm @TEMPLATE_first_player1_ready:;
   asm sta GRP1;
#if TEMPLATE_stripes > 0
   asm lsr.z TEMPLATE_object_masks + 1;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;
#else
   asm lsr.zx TEMPLATE_object_masks + 1,x;
   asm lda #1;
   asm adc #0;
   asm sta ENAM1;
#endif
   // Prime the left half of the first row while output is blanked.  The right
   // half is installed by the first timed raster line.
#if TEMPLATE_stripes > 0
   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
#else
   asm lda.a TEMPLATE_playfield;
   asm sta PF1;
   asm lda.a TEMPLATE_playfield + 1;
   asm sta PF2;
#endif
#ifdef VCS_STRIPES2_COMPACT_ROWEDGE_PROBE
   // Cache the exact P0 byte needed immediately after each later packed-row
   // edge (pairs 55,63,71,79,87,95).  The six bytes fit in the already-dead
   // stride-four scratch lane at object_masks+23,+27,+31,+35,+39,+43.  Pair7
   // can then carry that byte in Y across PF1R/PF2R, leaving A free for PF and
   // reserving the final 16-cycle tail for TYA + M0 shift + row control.
   // player0_y is still original_y+1 here.  Seed Y directly to the byte
   // for pair 56, then subtract eight after each cache entry.  Keeping this
   // builder index in Y avoids consuming any reclaimed service byte as a q
   // counter, so exact refill and row-edge preparation coexist at 98 RAM bytes.
   asm ldy.z TEMPLATE_player0_y;
   asm tya;
   asm sec;
   asm sbc #57;
   asm tay;
   asm ldx #0;
   asm @TEMPLATE_compact_rowedge_p0_loop:;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs.same @TEMPLATE_compact_rowedge_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_compact_rowedge_p0_store;
   asm @TEMPLATE_compact_rowedge_p0_zero:;
   asm lda #0;
   asm @TEMPLATE_compact_rowedge_p0_store:;
   asm sta.zx TEMPLATE_object_masks + 23,x;
   asm tya;
   asm sec;
   asm sbc #8;
   asm tay;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #24;
   asm bcc.same @TEMPLATE_compact_rowedge_p0_loop;
#endif
}

require inline void TEMPLATE_draw(void) {
#if TEMPLATE_stripes == 1
   // Positive stripes use a row-offset X throughout visible drawing. The seven
   // ordinary P1/P0 pairs are intentionally unrolled: this removes the per-pair
   // counter without paying a RAM decrement, so indexed BL/M1/M0 shifts fit the
   // same 152-cycle cadence. The first P0 half is staged by vblank().
   asm lda.z TEMPLATE_stripe_cache;
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
   asm bcc.same @stripe_first_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @stripe_first_continueP0;
   asm @stripe_first_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe_first_continueP0:;
   asm lsr.z TEMPLATE_object_masks + 2;
   // Fill the tail of the staged first P0 scanline so pair 1 begins at
   // cycle zero of the following line rather than eleven cycles early.
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm nop;
   asm ldx #$d0;
   asm jmp @stripe_pair1;

   asm @stripe_transition:;
   // Sixteenth line of each packed mask row. Finish the old row, stage the
   // first Ball bit of the next row, then advance X once. The playfield itself
   // does not change for stripes=1.
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
#ifdef VCS_STRIPES2_P1_CACHE_DISPATCH_PROBE
   asm lsr.z TEMPLATE_object_masks + 24;
#else
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 44,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 48,x;
   #endif
#endif
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta ENABL;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
   asm ldy.z TEMPLATE_player1_y;
   asm dey;
   asm sty.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @stripe_transition_activeP1;
   asm ldy #0;
   asm sty.a GRP1;
   asm jmp @stripe_transition_continueP1;
   asm @stripe_transition_activeP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm sta GRP1;
   asm @stripe_transition_continueP1:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 45,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 49,x;
   #endif

   // First P0 line of the new mask row.
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm sty.z TEMPLATE_player0_y;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcc.same @stripe_transition_activeP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @stripe_transition_continueP0;
   asm @stripe_transition_activeP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe_transition_continueP0:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 46,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 50,x;
   #endif

   // Pair 1 is deliberately 150 cycles.  The two cycles reclaimed here pay
   // the long row-backedge once per 16-line mask row, so every later row starts
   // at the same beam phase instead of drifting by two cycles.
   asm @stripe_pair1:;
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   // Shift Ball before the P1 decrement and commit ENABL immediately; A keeps
   // the encoded right PF0 byte across DEC so the pair length is unchanged.
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 44,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 48,x;
   #endif
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta ENABL;
   asm dec.z TEMPLATE_player1_y;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
   asm ldy.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @stripe_pair1_drawP1;
   asm lda.z TEMPLATE_object_masks + 19;
   asm bcs.same @stripe_pair1_continueP1;
   asm @stripe_pair1_drawP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @stripe_pair1_continueP1:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 45,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 49,x;
   #endif
   asm sta GRP1;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;

   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm sty.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta.a PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
   asm bcc.same @stripe_pair1_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @stripe_pair1_continueP0;
   asm @stripe_pair1_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe_pair1_continueP0:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 46,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 50,x;
   #endif

   // Unrolled positive-stripe pair 2/7. X remains the packed-mask row
   // offset. Indexed mask shifts cost one extra cycle each; deleting the old
   // DEX/taken-BNE pair saves five, and the final NOP restores the exact
   // 152-cycle two-scanline cadence.
   asm @stripe_pair2:;
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   // Shift Ball before the P1 decrement and commit ENABL immediately; A keeps
   // the encoded right PF0 byte across DEC so the pair length is unchanged.
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 44,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 48,x;
   #endif
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta ENABL;
   asm dec.z TEMPLATE_player1_y;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
   asm ldy.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @stripe_pair2_drawP1;
   asm lda.z TEMPLATE_object_masks + 19;
   asm bcs.same @stripe_pair2_continueP1;
   asm @stripe_pair2_drawP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @stripe_pair2_continueP1:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 45,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 49,x;
   #endif
   asm sta GRP1;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;

   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm sty.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta.a PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
   asm bcc.same @stripe_pair2_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @stripe_pair2_continueP0;
   asm @stripe_pair2_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe_pair2_continueP0:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 46,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 50,x;
   #endif
   asm nop;

   // Unrolled positive-stripe pair 3/7. X remains the packed-mask row
   // offset. Indexed mask shifts cost one extra cycle each; deleting the old
   // DEX/taken-BNE pair saves five, and the final NOP restores the exact
   // 152-cycle two-scanline cadence.
   asm @stripe_pair3:;
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   // Shift Ball before the P1 decrement and commit ENABL immediately; A keeps
   // the encoded right PF0 byte across DEC so the pair length is unchanged.
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 44,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 48,x;
   #endif
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta ENABL;
   asm dec.z TEMPLATE_player1_y;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
   asm ldy.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @stripe_pair3_drawP1;
   asm lda.z TEMPLATE_object_masks + 19;
   asm bcs.same @stripe_pair3_continueP1;
   asm @stripe_pair3_drawP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @stripe_pair3_continueP1:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 45,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 49,x;
   #endif
   asm sta GRP1;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;

   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm sty.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta.a PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
   asm bcc.same @stripe_pair3_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @stripe_pair3_continueP0;
   asm @stripe_pair3_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe_pair3_continueP0:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 46,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 50,x;
   #endif
   asm nop;

   // Unrolled positive-stripe pair 4/7. X remains the packed-mask row
   // offset. Indexed mask shifts cost one extra cycle each; deleting the old
   // DEX/taken-BNE pair saves five, and the final NOP restores the exact
   // 152-cycle two-scanline cadence.
   asm @stripe_pair4:;
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   // Shift Ball before the P1 decrement and commit ENABL immediately; A keeps
   // the encoded right PF0 byte across DEC so the pair length is unchanged.
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 44,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 48,x;
   #endif
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta ENABL;
   asm dec.z TEMPLATE_player1_y;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
   asm ldy.z TEMPLATE_player1_y;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcc.same @stripe_pair4_drawP1;
   asm lda.z TEMPLATE_object_masks + 19;
   asm bcs.same @stripe_pair4_continueP1;
   asm @stripe_pair4_drawP1:;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @stripe_pair4_continueP1:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 45,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 49,x;
   #endif
   asm sta GRP1;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;

   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 2;
   asm sta PF2;
   asm ldy.z TEMPLATE_player0_y;
   asm dey;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm sty.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta.a PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
   asm bcc.same @stripe_pair4_drawP0;
   asm lda.z TEMPLATE_object_masks + 19;
   asm jmp @stripe_pair4_continueP0;
   asm @stripe_pair4_drawP0:;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @stripe_pair4_continueP0:;
   #ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   asm lsr.zx TEMPLATE_object_masks + 46,x;
   #else
   asm lsr.zx TEMPLATE_object_masks + 50,x;
   #endif
   asm inx;

   // Unrolled positive-stripe pair 5/7. X remains the packed-mask row
   // offset. Indexed mask shifts cost one extra cycle each; deleting the old
   // DEX/taken-BNE pair saves five, and the final NOP restores the exact
   // 152-cycle two-scanline cadence.
   asm @stripe_pair5:;
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
