// Compile-time selected gameplay renderer rooted in the all-five implementation.
// `lines` selects the visible schedule. `missiles` and `player_colors` select
// the maintained object/color specialization. The compatibility defaults are
// the historical all_five renderer: five objects with solid P0/P1 colors.
//
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=192)
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=192, missiles:=1, player_colors:=0)
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=192, missiles:=0, player_colors:=1)
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=192, missiles:=1, player_colors:=1)
//
// All maintained official gameplay specializations live in this selector.
// Player-color callers select missiles:=0, player_colors:=1 explicitly; the
// Combined all-five + row-color profiles at 192 and 181 lines select missiles:=1, player_colors:=1.

parameter lines;
parameter missiles := 1;
parameter player_colors := 0;
parameter stripes := 0;


#if TEMPLATE_stripes > 0 && (TEMPLATE_lines != 192 || TEMPLATE_missiles != 1 || TEMPLATE_player_colors != 0)
extern const uint8_t TEMPLATE_stripes_currently_require_192_solid_all_five[0];
#endif
#if TEMPLATE_stripes > 2
extern const uint8_t TEMPLATE_stripes_s13_prototype_currently_supports_two_stripes[0];
#endif
#if TEMPLATE_stripes == 1
extern const uint8_t TEMPLATE_playfield_colors[2];
extern const uint8_t TEMPLATE_playfield_data[6];
#elif TEMPLATE_stripes == 2
extern const uint8_t TEMPLATE_playfield_colors[4];
extern const uint8_t TEMPLATE_playfield_data[12];
// Pair-height descriptors split each stripe into coarse eight-pair rows plus
// a 0..7-pair tail.  The public two-stripe default is the equal 48/48-pair
// split.  Certification defines retain every neighboring tail value so the
// one runtime scheduler is exercised across all eight legal tail landings.
#ifdef VCS_STRIPES2_CERT_TAIL0
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 48,48 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,0,6,0 };
#elif defined(VCS_STRIPES2_CERT_TAIL7)
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 55,41 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,7,5,1 };
#elif defined(VCS_STRIPES2_CERT_TAIL6)
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 54,42 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,6,5,2 };
#elif defined(VCS_STRIPES2_CERT_TAIL5)
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 53,43 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,5,5,3 };
#elif defined(VCS_STRIPES2_CERT_TAIL4)
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 52,44 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,4,5,4 };
#elif defined(VCS_STRIPES2_CERT_TAIL3)
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 51,45 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,3,5,5 };
#elif defined(VCS_STRIPES2_CERT_TAIL2)
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 50,46 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,2,5,6 };
#elif defined(VCS_STRIPES2_CERT_TAIL1)
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 49,47 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,1,5,7 };
#else
const uint8_t TEMPLATE_stripe_pair_heights[2] := { 48,48 };
const uint8_t TEMPLATE_stripe_schedule[4] := { 6,0,6,0 };
#endif
#ifdef VCS_STRIPES2_ROLLING_PLANNER_PROBE
// Pair-32 rolling planner tables. The 16-byte transition table aliases each
// uint8 transition by low nibble onto candidate starts 1,3,5,9,11; aliases can
// reject a usable start but cannot accept a mixed three-pair window.
const uint8_t TEMPLATE_stripe_transition_alias[16] := {
   0,1,1,2,2,4,4,0,0,8,8,16,16,0,0,0
};
const uint8_t TEMPLATE_stripe_first_free_start[32] := {
   1,3,1,5,1,3,1,9,1,3,1,5,1,3,1,11,
   1,3,1,5,1,3,1,9,1,3,1,5,1,3,1,0
};
#endif
#if defined(VCS_STRIPES2_P1_CACHE_PLANNER_PROBE) || defined(VCS_STRIPES2_P1_CACHE_DISPATCH_PROBE)
// A single-player uniform window needs only starts 0,2,4 in one packed row.
// The even starts fit wholly before the tail-7 A/B boundary; low-three-bit
// transition aliases are conservative and each P1 transition blocks one start.
const uint8_t TEMPLATE_stripe_p1cache_transition_alias[8] := {
   1,1,2,2,4,4,0,0
};
const uint8_t TEMPLATE_stripe_p1cache_first_free_start[8] := {
   0,2,0,4,0,2,0,0
};
#endif
#ifdef VCS_STRIPES2_REFILL_4LINE_P1_CACHE_PLANNER_PROBE
// The four-line PF-only service needs only two adjacent uniform P1 pairs.
// Starts 4,5,6 are deliberately late in the row. Each uint8 activity
// transition blocks at most one start, so two transition aliases cannot
// eliminate all three candidates.
const uint8_t TEMPLATE_stripe_p1cache4_transition_alias[8] := {
   0,0,0,0,1,2,4,0
};
const uint8_t TEMPLATE_stripe_p1cache4_first_free_start[8] := {
   4,5,4,6,4,5,4,4
};
#endif
#if defined(VCS_STRIPES2_ROLLING_PLANNER_PROBE) || defined(VCS_STRIPES2_P1_CACHE_PLANNER_PROBE) || defined(VCS_STRIPES2_P1_CACHE_DISPATCH_PROBE) || defined(VCS_STRIPES2_REFILL_4LINE_P1_CACHE_PLANNER_PROBE)
// The rolling service corridor cannot borrow an already-consumed mask row as
// its inactive P1 source. Keep one immutable three-byte zero run.
const uint8_t TEMPLATE_stripe_service_zero[3] := { 0,0,0 };
#endif
#endif

// Common selector ABI and immutable positioning data. Schedule branches below
// own only their measured private storage and frame-phase implementation.
alias TEMPLATE_OBJECT_PLAYER0 0
alias TEMPLATE_OBJECT_PLAYER1 1
alias TEMPLATE_OBJECT_BALL 4
alias TEMPLATE_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
alias TEMPLATE_PLAYER0_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER0]
alias TEMPLATE_PLAYER1_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER1]
alias TEMPLATE_BALL_X TEMPLATE_object_x[TEMPLATE_OBJECT_BALL]
#if TEMPLATE_missiles == 1
alias TEMPLATE_OBJECT_MISSILE0 2
alias TEMPLATE_OBJECT_MISSILE1 3
alias TEMPLATE_MISSILE0_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE0]
alias TEMPLATE_MISSILE1_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE1]
alias TEMPLATE_PLAYER0_NUSIZ TEMPLATE_player0_nusiz
alias TEMPLATE_PLAYER1_NUSIZ TEMPLATE_player1_nusiz
#else
// Missile-free profiles retain NUSIZ in otherwise-unused object_x slots.
alias TEMPLATE_PLAYER0_NUSIZ TEMPLATE_object_x[2]
alias TEMPLATE_PLAYER1_NUSIZ TEMPLATE_object_x[3]
#endif

#if TEMPLATE_lines == 228
extern const uint8_t TEMPLATE_playfield[60];
#elif TEMPLATE_lines == 192
extern const uint8_t TEMPLATE_playfield[48];
#elif TEMPLATE_lines == 181
extern const uint8_t TEMPLATE_playfield[44];
#elif TEMPLATE_lines == 170
extern const uint8_t TEMPLATE_playfield[40];
#endif

#if TEMPLATE_player_colors == 1
#if TEMPLATE_missiles == 0 && (TEMPLATE_lines == 192 || TEMPLATE_lines == 228)
#ifdef VCS_PLAYER_COLOR_MUTABLE_COLORS
extern uint8_t TEMPLATE_player0_colors[8];
extern uint8_t TEMPLATE_player1_colors[8];
#else
extern const uint8_t TEMPLATE_player0_colors[8];
extern const uint8_t TEMPLATE_player1_colors[8];
#endif
#else
extern const uint8_t TEMPLATE_player0_colors[8];
extern const uint8_t TEMPLATE_player1_colors[8];
#endif
#endif

// Shared fine-motion conversion table. Indexes 1..15 correspond to the
// negative remainder left by the 15-pixel coarse-position loop.
page const uint8_t TEMPLATE_reposition_table[16] := {
   0x80,0x70,0x60,0x50,0x40,0x30,0x20,0x10,
   0x00,0xf0,0xe0,0xd0,0xc0,0xb0,0xa0,0x90
};

#if (TEMPLATE_lines == 181 || TEMPLATE_lines == 170) && ((TEMPLATE_missiles == 1 && TEMPLATE_player_colors == 0) || (TEMPLATE_missiles == 0 && TEMPLATE_player_colors == 1))
// Packed visible-handoff positioning table. The high nibble is the HMxx
// value and the low nibble is the number of five-cycle coarse-loop steps.
// Both player entry lines use a RESP phase one CPU cycle earlier than the
// retained VBLANK schedule; the table compensates by fine motion and, for
// remainders 13..14, one additional coarse step.
page const uint8_t TEMPLATE_player_position_table[160] := {
   0x41,0x31,0x21,0x11,0x01,0xf1,0xe1,0xd1,0xc1,0xb1,0xa1,0x91,0x81,0x62,0x52,0x42,
   0x32,0x22,0x12,0x02,0xf2,0xe2,0xd2,0xc2,0xb2,0xa2,0x92,0x82,0x63,0x53,0x43,0x33,
   0x23,0x13,0x03,0xf3,0xe3,0xd3,0xc3,0xb3,0xa3,0x93,0x83,0x64,0x54,0x44,0x34,0x24,
   0x14,0x04,0xf4,0xe4,0xd4,0xc4,0xb4,0xa4,0x94,0x84,0x65,0x55,0x45,0x35,0x25,0x15,
   0x05,0xf5,0xe5,0xd5,0xc5,0xb5,0xa5,0x95,0x85,0x66,0x56,0x46,0x36,0x26,0x16,0x06,
   0xf6,0xe6,0xd6,0xc6,0xb6,0xa6,0x96,0x86,0x67,0x57,0x47,0x37,0x27,0x17,0x07,0xf7,
   0xe7,0xd7,0xc7,0xb7,0xa7,0x97,0x87,0x68,0x58,0x48,0x38,0x28,0x18,0x08,0xf8,0xe8,
   0xd8,0xc8,0xb8,0xa8,0x98,0x88,0x69,0x59,0x49,0x39,0x29,0x19,0x09,0xf9,0xe9,0xd9,
   0xc9,0xb9,0xa9,0x99,0x89,0x6a,0x5a,0x4a,0x3a,0x2a,0x1a,0x0a,0xfa,0xea,0xda,0xca,
   0xba,0xaa,0x9a,0x8a,0x6b,0x5b,0x4b,0x3b,0x2b,0x1b,0x0b,0xfb,0xeb,0xdb,0xcb,0xbb
};
#endif

// Public ABI shared by every selector schedule. Conditional fields preserve
// the historical per-specialization layout and RAM totals.
uint8_t TEMPLATE_object_x[5];
uint8_t TEMPLATE_player0_y;
uint8_t TEMPLATE_player1_y;
#if TEMPLATE_missiles == 1
uint8_t TEMPLATE_missile1_height;
uint8_t TEMPLATE_missile1_y;
#endif
uint8_t TEMPLATE_ball_y;
uint8_t *TEMPLATE_player0_graphics;
uint8_t *TEMPLATE_player1_graphics;
uint8_t TEMPLATE_player0_height;
uint8_t TEMPLATE_player1_height;
#if TEMPLATE_missiles == 1
uint8_t TEMPLATE_missile0_height;
uint8_t TEMPLATE_missile0_y;
#endif
uint8_t TEMPLATE_ball_height;
#if TEMPLATE_missiles == 1
uint8_t TEMPLATE_player0_nusiz;
uint8_t TEMPLATE_player1_nusiz;
#endif
#if TEMPLATE_missiles == 1 && TEMPLATE_player_colors == 0
uint8_t TEMPLATE_player0_color;
uint8_t TEMPLATE_player1_color;
#endif

#if TEMPLATE_missiles == 1 && TEMPLATE_player_colors == 0
#if TEMPLATE_lines == 192 || TEMPLATE_lines == 228
// Repeatable official-opcode TEMPLATE_lines-scanline P0/P1/M0/M1/BL gameplay component
// derived from the proven player-color raster. Player colors are solid for the
// complete frame; the two per-row color-table slots are used to update M1 and
// M0 without changing the measured two-scanline pipeline.
//
// Instantiate with:
//
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=228)
//     instantiate "renderers/all_five/all_five.c26" as game (lines:=192)
//
// Include vcs.c26 first. The 192-line profile requires a page-contained
// immutable INSTANCE_playfield[48]; the 228-line profile requires
// INSTANCE_playfield[60]. 192 draws twelve 16-line packed rows. 228 draws a
// four-line first packed row followed by fourteen 16-line rows, for exactly
// 228 visible scanlines.
//
// It owns no score/font, VSYNC, VBLANK, or RIOT timer state. draw() returns on
// the boundary after TEMPLATE_lines visible scanlines; overscan() clears
// gameplay state and restores application Y values.

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := TEMPLATE_lines,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := TEMPLATE_lines,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 0,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 0,
   TEMPLATE_VBLANK_MAX_CYCLES := 1800,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 66,
   TEMPLATE_OBJECT_COUNT := 5,
#if TEMPLATE_lines == 228
   TEMPLATE_PLAYFIELD_BYTES := 60,
   TEMPLATE_PLAYFIELD_ROWS := 15,
#else
   TEMPLATE_PLAYFIELD_BYTES := 48,
   TEMPLATE_PLAYFIELD_ROWS := 12,
#endif
   TEMPLATE_PLAYFIELD_ROW_BYTES := 4,
   TEMPLATE_WORKSPACE_BYTES := 0,
#if TEMPLATE_lines == 228
   TEMPLATE_PRIVATE_RAM_BYTES := 60,
   TEMPLATE_PUBLIC_RAM_BYTES := 23,
   TEMPLATE_MODULE_RAM_BYTES := 83
#else
   TEMPLATE_PRIVATE_RAM_BYTES := 48,
   TEMPLATE_PUBLIC_RAM_BYTES := 23,
   TEMPLATE_MODULE_RAM_BYTES := 71
#endif
};

// The stride-four mask array uses three bytes per row for BL/M1/M0. Its fourth
// lane is beam-dead and doubles as the renderer's private scratch/state, so no
// separate workspace is consumed. The final lane byte backs the public
// playfield-position control without increasing RAM.
#if TEMPLATE_lines == 228
uint8_t TEMPLATE_object_masks[60];
#else
uint8_t TEMPLATE_object_masks[48];
#endif
alias TEMPLATE_playfield_position TEMPLATE_object_masks[47]
#if TEMPLATE_stripes == 1
uint8_t TEMPLATE_stripe_cache[6];
#elif TEMPLATE_stripes == 2
uint8_t TEMPLATE_stripe_cache[6];
uint8_t TEMPLATE_stripe_buffer_b[6];
uint8_t TEMPLATE_stripe_next_color[2];
uint8_t TEMPLATE_stripe_boundary_grp1;
uint8_t TEMPLATE_stripe_boundary_grp0;
uint8_t TEMPLATE_stripe_wrap_grp1;
#if defined(VCS_STRIPES2_RUNTIME_ALL8) || (!defined(VCS_STRIPES2_CERT_TAIL0) && !defined(VCS_STRIPES2_CERT_TAIL1) && !defined(VCS_STRIPES2_CERT_TAIL2) && !defined(VCS_STRIPES2_CERT_TAIL3) && !defined(VCS_STRIPES2_CERT_TAIL4) && !defined(VCS_STRIPES2_CERT_TAIL5) && !defined(VCS_STRIPES2_CERT_TAIL6) && !defined(VCS_STRIPES2_CERT_TAIL7))
uint8_t TEMPLATE_stripe_wrap_grp0;
uint8_t TEMPLATE_stripe_tail_a_ptr[2];
uint8_t TEMPLATE_stripe_tail_b_ptr[2];
#endif
// Constant-size rolling service state.  These two pointers replace four
// redundant scheduler bytes: the first stripe X seed is always $e8, the
// following X/tail values were never consumed, and runtime tail zero is
// already encoded by stripe_tail_a_ptr low == 0.
uint8_t TEMPLATE_stripe_service_p1_ptr[2];
uint8_t TEMPLATE_stripe_service_p0_ptr[2];
#ifdef VCS_STRIPES2_UNIFORM_ROWEDGE_PROBE
// Five sparse four-byte records, indexed by packed-row X after INX.  Each
// record stores [following-row P0, current-row P1, -, -].  +20/+21 operands
// intentionally wrap zero-page X=$ec,$f0,$f4,$f8,$fc back onto offsets
// 0/1,4/5,8/9,12/13,16/17.  This is a probe layout; the final integration
// can reclaim the beam-dead mask lane once the cadence is proven in silicon.
uint8_t TEMPLATE_stripe_row_entry_cache[20];
#endif
#endif

require inline void TEMPLATE_init(void) {
}


require inline void TEMPLATE_vblank(void) {
   // Internal assembly helpers add one hidden JSR level.
   asm .callstackextra 4;
   // Build the three non-player schedules directly from public coordinates.
   // P0/P1 are biased only after preparation; BL/M0/M1 never need to mutate
   // their public Y values at all.
   asm jsr @TEMPLATE_prepare_object_masks;
   asm jmp @TEMPLATE_prepare_object_masks_done;
   asm @TEMPLATE_prepare_object_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
#if TEMPLATE_lines == 228
   asm cpx #60;
#else
   asm cpx #48;
#endif
   asm bcc.same @clear;
   // The Ball is biased one pair ahead for VDELBL staging, so the inclusive
   // preparation limit is 96 even though visible pair indices end at 95.
#if TEMPLATE_lines == 228
   asm lda #120;
#else
   asm lda #96;
#endif
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
#if TEMPLATE_lines == 228
   asm adc #8;
#else
   asm adc #2;
#endif
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   // Missiles use the original one-pair bias and 0..95 preparation limit.
#if TEMPLATE_lines == 228
   asm lda #119;
#else
   asm lda #95;
#endif
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_missile1_y;
   asm clc;
#if TEMPLATE_lines == 228
   asm adc #7;
#else
   asm adc #1;
#endif
   asm ldy.z TEMPLATE_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_missile0_y;
   asm clc;
#if TEMPLATE_lines == 228
   asm adc #7;
#else
   asm adc #1;
#endif
   asm ldy.z TEMPLATE_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;

   // No special terminal row is required: Ball, P0, and P1 all remain in
   // the ordinary raster pipeline through the final packed row.
   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @no_wrap;
   asm beq.same @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq.same @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_low_ready;
   asm beq.same @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_high_ready;
   asm beq.same @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne.same @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @no_wrap_last_ready;
   asm beq.same @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @set_range;
   asm beq.same @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne.same @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs.same @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @TEMPLATE_prepare_object_masks_done:;

#if TEMPLATE_lines == 228
   // 228 lines are 114 two-scanline object positions: two positions in the
   // first playfield row followed by fourteen ordinary eight-position rows.
   // The builder keeps its simple eight-bit range arithmetic by biasing the
   // non-player coordinates six positions upward.  Discard those six unused
   // leading bits before the visible loop so physical Y=0 is still the first
   // visible pair.
   asm ldx #6;
   asm @TEMPLATE_shift_first_mask_row:;
   asm lsr.z TEMPLATE_object_masks;
   asm lsr.z TEMPLATE_object_masks + 1;
   asm lsr.z TEMPLATE_object_masks + 2;
   asm dex;
   asm bne.same @TEMPLATE_shift_first_mask_row;
#endif

   // The builder is finished with its scratch lane. Reuse two dead lane bytes
   // for the only public Y values the visible loop actually mutates.
   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_object_masks + 27;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_player0_y;
   asm lda.z TEMPLATE_player1_y;
   asm sta.z TEMPLATE_object_masks + 31;
   asm clc;
   // P1 uses the same public Y origin as P0.  The P1 half already incurs its
   // pipeline decrement, so the old +2 bias placed equal public coordinates
   // one two-scanline pair below P0.
   asm adc #1;
   asm sta.z TEMPLATE_player1_y;

   // Position all five objects during VBLANK with the same calibrated
   // divide-by-fifteen RESP/HMxx sequence proven by player_color_192.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_ball_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #3;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #2;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_missile0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_missile0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #1;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player1_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #0;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm @TEMPLATE_player0_divide_loop:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_player0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm sta HMOVE;
   asm lda.z TEMPLATE_player0_nusiz;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_player1_nusiz;
   asm sta NUSIZ1;
   asm lda.z TEMPLATE_player0_color;
   asm sta COLUP0;
   asm lda.z TEMPLATE_player1_color;
   asm sta COLUP1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;
   asm stx CXCLR;
#if TEMPLATE_stripes > 0
   asm lda.a TEMPLATE_playfield_data;
   asm and #$f0;
   asm sta.z TEMPLATE_stripe_cache;
   asm lda.a TEMPLATE_playfield_data + 1;
   asm sta.z TEMPLATE_stripe_cache + 1;
   asm lda.a TEMPLATE_playfield_data + 2;
   asm sta.z TEMPLATE_stripe_cache + 2;
   asm lda.a TEMPLATE_playfield_data + 3;
   asm and #$f0;
   asm sta.z TEMPLATE_stripe_cache + 3;
   asm lda.a TEMPLATE_playfield_data + 4;
   asm sta.z TEMPLATE_stripe_cache + 4;
   asm lda.a TEMPLATE_playfield_data + 5;
   asm sta.z TEMPLATE_stripe_cache + 5;
#if TEMPLATE_stripes == 2
   asm lda.a TEMPLATE_playfield_data + 6;
   asm and #$f0;
   asm sta.z TEMPLATE_stripe_buffer_b + 0;
   asm lda.a TEMPLATE_playfield_data + 7;
   asm sta.z TEMPLATE_stripe_buffer_b + 1;
   asm lda.a TEMPLATE_playfield_data + 8;
   asm sta.z TEMPLATE_stripe_buffer_b + 2;
   asm lda.a TEMPLATE_playfield_data + 9;
   asm and #$f0;
   asm sta.z TEMPLATE_stripe_buffer_b + 3;
   asm lda.a TEMPLATE_playfield_data + 10;
   asm sta.z TEMPLATE_stripe_buffer_b + 4;
   asm lda.a TEMPLATE_playfield_data + 11;
   asm sta.z TEMPLATE_stripe_buffer_b + 5;
#ifdef VCS_STRIPES2_REFILL_ZERO_PROBE
   // Cache-free refill certification starts with an empty inactive buffer.
   // The selected service window has P1 inactive, so six visible pairs can
   // reconstruct B using literal zero GRP1 values.
   asm lda #0;
   asm sta.z TEMPLATE_stripe_buffer_b + 0;
   asm sta.z TEMPLATE_stripe_buffer_b + 1;
   asm sta.z TEMPLATE_stripe_buffer_b + 2;
   asm sta.z TEMPLATE_stripe_buffer_b + 3;
   asm sta.z TEMPLATE_stripe_buffer_b + 4;
   asm sta.z TEMPLATE_stripe_buffer_b + 5;
#elif defined(VCS_STRIPES2_REFILL_PROBE)
   // The refill probe deliberately does not leave B holding playfield data.
   // B temporarily becomes the six-byte P1 service cache instead; each
   // visible service pair consumes B[i] as GRP1 and overwrites that same byte
   // with the next stripe's PF data.  This proves the A/B buffers are enough
   // for the primitive and avoids a hidden third six-byte cache.
#endif
#endif
   asm lda.a TEMPLATE_playfield_colors;
   asm sta COLUPF;
   asm lda.a TEMPLATE_playfield_colors + 1;
   asm sta COLUBK;
#if TEMPLATE_stripes == 2
   asm lda.a TEMPLATE_playfield_colors + 2;
   asm sta.z TEMPLATE_stripe_next_color;
   asm lda.a TEMPLATE_playfield_colors + 3;
   asm sta.z TEMPLATE_stripe_next_color + 1;
#ifdef VCS_STRIPES2_ROW_ENTRY_COLOR_PROBE
   // Cache the exact player bytes used by the transition into the row beginning
   // at pair 40.  +3/+43 are stride-four scratch lanes after mask construction.
   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc #40;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_row_entry_probe_p1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_row_entry_probe_p1_ready;
   asm @TEMPLATE_row_entry_probe_p1_zero:;
   asm lda #0;
   asm @TEMPLATE_row_entry_probe_p1_ready:;
   asm sta.z TEMPLATE_stripe_service_p1_ptr;
   asm lda.z TEMPLATE_object_masks + 27;
   asm sec;
   asm sbc #41;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs.same @TEMPLATE_row_entry_probe_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_row_entry_probe_p0_ready;
   asm @TEMPLATE_row_entry_probe_p0_zero:;
   asm lda #0;
   asm @TEMPLATE_row_entry_probe_p0_ready:;
   asm sta.z TEMPLATE_stripe_service_p0_ptr;
   // Certification requires the visible service-row transition to regenerate
   // both next colors; do not let the ordinary initial preload mask a miss.
   asm lda #0;
   asm sta.z TEMPLATE_stripe_next_color;
   asm sta.z TEMPLATE_stripe_next_color + 1;
#endif
#if defined(VCS_STRIPES2_RUNTIME_ALL8) || (!defined(VCS_STRIPES2_CERT_TAIL0) && !defined(VCS_STRIPES2_CERT_TAIL1) && !defined(VCS_STRIPES2_CERT_TAIL2) && !defined(VCS_STRIPES2_CERT_TAIL3) && !defined(VCS_STRIPES2_CERT_TAIL4) && !defined(VCS_STRIPES2_CERT_TAIL5) && !defined(VCS_STRIPES2_CERT_TAIL6) && !defined(VCS_STRIPES2_CERT_TAIL7))
   // The first two-stripe coarse schedule is always six rows, so visible X
   // starts at compile-time $e8.  Tail*7 already lives in the A-dispatch
   // pointer low byte; no duplicate tail or unused next-stripe seed is kept.
   asm lda.a TEMPLATE_stripe_schedule + 1;
   asm sta.z TEMPLATE_stripe_tail_a_ptr; // tail
   asm asl;
   asm asl;
   asm asl;                              // tail*8
   asm sec;
   asm sbc.z TEMPLATE_stripe_tail_a_ptr; // tail*7
   asm sta.z TEMPLATE_stripe_tail_a_ptr;
   asm clc;
   asm adc #56;
   asm sta.z TEMPLATE_stripe_tail_b_ptr;
#endif

   // Precompute the P1 byte needed exactly at the 96-line boundary.
   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc.a TEMPLATE_stripe_pair_heights;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_stripe2_boundary_grp1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_stripe2_boundary_grp1_ready;
   asm @TEMPLATE_stripe2_boundary_grp1_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe2_boundary_grp1_ready:;
   asm sta.z TEMPLATE_stripe_boundary_grp1;

   // Precompute the P0 byte for the first stripe boundary.  The public P0 Y
   // saved in object_masks+27 is the pair-zero source row, so subtracting the
   // generated pair height yields the boundary P0 source row directly.
   asm lda.z TEMPLATE_object_masks + 27;
   asm sec;
   asm sbc.a TEMPLATE_stripe_pair_heights;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs.same @TEMPLATE_stripe2_boundary_grp0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_stripe2_boundary_grp0_ready;
   asm @TEMPLATE_stripe2_boundary_grp0_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe2_boundary_grp0_ready:;
   asm sta.z TEMPLATE_stripe_boundary_grp0;

   // Precompute the coarse-wrap P1 byte (pair 48 / line 95).  Replacing the
   // dynamic lookup on that line recovers exactly the cycles spent by the
   // once-per-stripe runtime tail selector.
   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc #48;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_stripe2_wrap_grp1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_stripe2_wrap_grp1_ready;
   asm @TEMPLATE_stripe2_wrap_grp1_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe2_wrap_grp1_ready:;
   asm sta.z TEMPLATE_stripe_wrap_grp1;
#ifdef VCS_STRIPES2_REFILL_6LINE_DUAL_PTR_PROBE
   // Dual-uniform-pointer certification reuses four scheduler bytes as two
   // temporary zero-page service pointers. The fixed probe starts at pair 49;
   // its fixture makes each player uniform for pairs 49..51. Active pointers
   // are biased by -2 for local Y=2/1/0. Inactive pointers use the already-
   // consumed row-5 BL/M1/M0 mask bytes, a three-byte zero run by pair 49.
   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc #49;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_stripe_refill6_dual_p1_zero;
   asm tya;
   asm clc;
   asm adc.z TEMPLATE_player1_graphics;
   asm sta.z TEMPLATE_stripe_service_p1_ptr;
   asm lda.z TEMPLATE_player1_graphics + 1;
   asm adc #0;
   asm sta.z TEMPLATE_stripe_service_p1_ptr + 1;
   asm lda.z TEMPLATE_stripe_service_p1_ptr;
   asm sec;
   asm sbc #2;
   asm sta.z TEMPLATE_stripe_service_p1_ptr;
   asm lda.z TEMPLATE_stripe_service_p1_ptr + 1;
   asm sbc #0;
   asm sta.z TEMPLATE_stripe_service_p1_ptr + 1;
   asm jmp @TEMPLATE_stripe_refill6_dual_p1_ready;
   asm @TEMPLATE_stripe_refill6_dual_p1_zero:;
   asm lda #<{TEMPLATE_object_masks + 20};
   asm sta.z TEMPLATE_stripe_service_p1_ptr;
   asm lda #>{TEMPLATE_object_masks + 20};
   asm sta.z TEMPLATE_stripe_service_p1_ptr + 1;
   asm @TEMPLATE_stripe_refill6_dual_p1_ready:;

   // P0 is one pipeline decrement ahead of P1 at this handoff: the three
   // P0 service bytes correspond to absolute source pairs 50..52.
   asm lda.z TEMPLATE_object_masks + 27;
   asm sec;
   asm sbc #50;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs.same @TEMPLATE_stripe_refill6_dual_p0_zero;
   asm tya;
   asm clc;
   asm adc.z TEMPLATE_player0_graphics;
   asm sta.z TEMPLATE_stripe_service_p0_ptr;
   asm lda.z TEMPLATE_player0_graphics + 1;
   asm adc #0;
   asm sta.z TEMPLATE_stripe_service_p0_ptr + 1;
   asm lda.z TEMPLATE_stripe_service_p0_ptr;
   asm sec;
   asm sbc #2;
   asm sta.z TEMPLATE_stripe_service_p0_ptr;
   asm lda.z TEMPLATE_stripe_service_p0_ptr + 1;
   asm sbc #0;
   asm sta.z TEMPLATE_stripe_service_p0_ptr + 1;
   asm jmp @TEMPLATE_stripe_refill6_dual_p0_ready;
   asm @TEMPLATE_stripe_refill6_dual_p0_zero:;
   asm lda #<{TEMPLATE_object_masks + 20};
   asm sta.z TEMPLATE_stripe_service_p0_ptr;
   asm lda #>{TEMPLATE_object_masks + 20};
   asm sta.z TEMPLATE_stripe_service_p0_ptr + 1;
   asm @TEMPLATE_stripe_refill6_dual_p0_ready:;
   // Cross-inline reference to the linker-visible alias exported from draw().
   // +35/+39 are dead scratch lanes after mask construction.
   asm lda #<?@TEMPLATE_stripe_dual_resume_after_pair3;
   asm sta.z TEMPLATE_object_masks + 35;
   asm lda #>?@TEMPLATE_stripe_dual_resume_after_pair3;
   asm sta.z TEMPLATE_object_masks + 39;
#endif
#ifdef VCS_STRIPES2_REFILL_6LINE_POINTER_PROBE
   // Seed the inactive six-byte PF buffer as three exact P1 sprite pointers.
   // Active slots point at the future graphics byte and inactive slots point
   // at the permanent zero byte. The visible six-line service consumes one
   // pointer pair at a time and overwrites it with the next stripe's PF bytes.
   asm lda #49;
   asm sta.z TEMPLATE_object_masks + 43;
   asm ldx #0;
   asm @TEMPLATE_stripe_refill6_pointer_seed_loop:;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 43;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_stripe_refill6_pointer_p1_zero;
   asm tya;
   asm clc;
   asm adc.z TEMPLATE_player1_graphics;
   asm sta.zx TEMPLATE_stripe_buffer_b,x;
   asm lda.z TEMPLATE_player1_graphics + 1;
   asm adc #0;
   asm jmp @TEMPLATE_stripe_refill6_pointer_p1_high;
   asm @TEMPLATE_stripe_refill6_pointer_p1_zero:;
   asm lda #<{TEMPLATE_object_masks + 19};
   asm sta.zx TEMPLATE_stripe_buffer_b,x;
   asm lda #>{TEMPLATE_object_masks + 19};
   asm @TEMPLATE_stripe_refill6_pointer_p1_high:;
   asm inx;
   asm sta.zx TEMPLATE_stripe_buffer_b,x;
   asm inx;
   asm inc.z TEMPLATE_object_masks + 43;
   asm cpx #6;
   asm bcc.same @TEMPLATE_stripe_refill6_pointer_seed_loop;
#endif
#if defined(VCS_STRIPES2_REFILL_6LINE_PROBE) || defined(VCS_STRIPES2_REFILL_8LINE_PROBE) || defined(VCS_STRIPES2_REFILL_6LINE_ROLL_P0_PROBE)
   // Six/eight-line refill certification seeds B with alternating P1/P0
   // sprite bytes for absolute pairs 49..51.  The eight-line probe also
   // borrows next_color[] for pair 52, then overwrites those two bytes with
   // the real next-stripe colors during pair 4.  Scratch-lane byte +43 holds
   // only the pair index; +27/+31 retain the original public P0/P1 Y values.
   asm lda #49;
   asm sta.z TEMPLATE_object_masks + 43;
   asm ldx #0;
   asm @TEMPLATE_stripe_refill6_seed_loop:;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 43;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_stripe_refill6_p1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_stripe_refill6_p1_store;
   asm @TEMPLATE_stripe_refill6_p1_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe_refill6_p1_store:;
   asm sta.zx TEMPLATE_stripe_buffer_b,x;
   asm inx;
   asm lda.z TEMPLATE_object_masks + 27;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 43;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs.same @TEMPLATE_stripe_refill6_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_stripe_refill6_p0_store;
   asm @TEMPLATE_stripe_refill6_p0_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe_refill6_p0_store:;
   asm sta.zx TEMPLATE_stripe_buffer_b,x;
   asm inx;
   asm inc.z TEMPLATE_object_masks + 43;
   asm cpx #6;
   asm bcc.same @TEMPLATE_stripe_refill6_seed_loop;
#ifdef VCS_STRIPES2_REFILL_8LINE_PROBE
   // Pair 52 service sprites live temporarily in next_color[].  They are
   // consumed in the fourth service pair and replaced there by COLUPF/COLUBK.
   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc #52;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_stripe_refill8_p1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_stripe_refill8_p1_store;
   asm @TEMPLATE_stripe_refill8_p1_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe_refill8_p1_store:;
   asm sta.z TEMPLATE_stripe_next_color;
   asm lda.z TEMPLATE_object_masks + 27;
   asm sec;
   asm sbc #52;
   asm tay;
   asm cpy.z TEMPLATE_object_masks + 11;
   asm bcs.same @TEMPLATE_stripe_refill8_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_stripe_refill8_p0_store;
   asm @TEMPLATE_stripe_refill8_p0_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe_refill8_p0_store:;
   asm sta.z TEMPLATE_stripe_next_color + 1;
#endif
#endif
#ifdef VCS_STRIPES2_REFILL_PROBE
   // Seed B with the exact P1 bytes for the six tail-7 service pairs
   // (absolute visible pair indices 49..54).  The visible refill consumes
   // each byte once and replaces it in place with PF data.
   asm lda.z TEMPLATE_object_masks + 31;
   asm sec;
   asm sbc #49;
   asm sta.z TEMPLATE_object_masks + 43;
   asm ldx #0;
   asm @TEMPLATE_stripe_refill_grp1_loop:;
   asm ldy.z TEMPLATE_object_masks + 43;
   asm cpy.z TEMPLATE_object_masks + 15;
   asm bcs.same @TEMPLATE_stripe_refill_grp1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_stripe_refill_grp1_store;
   asm @TEMPLATE_stripe_refill_grp1_zero:;
   asm lda #0;
   asm @TEMPLATE_stripe_refill_grp1_store:;
   asm sta.zx TEMPLATE_stripe_buffer_b,x;
   asm dec.z TEMPLATE_object_masks + 43;
   asm inx;
   asm cpx #6;
