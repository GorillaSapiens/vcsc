   asm lda.z TEMPLATE_stripe_cache + 3;
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_cache + 4;
   asm sta PF1;
   asm lda.z TEMPLATE_stripe_cache + 5;
   asm sta PF2;
   asm stx.z TEMPLATE_stripe_buffer_b + 0;
   asm lda.z TEMPLATE_object_masks + 35;
#ifdef VCS_STRIPES2_REFILL_6LINE_EXACT_CACHE_PROBE
   asm nop;
#else
   asm dey;
#endif
   asm lsr.z TEMPLATE_object_masks + 26;
#ifdef VCS_STRIPES2_REFILL_4LINE_P1_CACHE_PROBE
