   // dereferences B+0 through the compile-time +$18 operand.
   // The exact pointer removes P1 activity selection from the hot window.
   // P0 remains live-classified below; no pattern/control byte is required.
   asm sta GRP0;
   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM0;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 1;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 2;
   asm sty PF2;
   asm lsr.z TEMPLATE_object_masks + 24;
   asm lda.z TEMPLATE_stripe_cache + 3;
   asm adc #1;
   asm sta ENABL;
   asm dec.z TEMPLATE_player1_y;
   asm sta PF0;
   asm ldy.z TEMPLATE_stripe_cache + 4;
   asm sty PF1;
   asm ldy.z TEMPLATE_stripe_cache + 5;
   asm sty PF2;
