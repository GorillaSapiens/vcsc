#endif
   asm lda.iy (TEMPLATE_stripe_service_p1_ptr),y;
   asm ldx.a TEMPLATE_playfield_data + 6;
   asm lsr.z TEMPLATE_object_masks + 25;
   asm sta GRP1;

   asm lda.z TEMPLATE_stripe_cache;
   asm adc #1;
   asm sta ENAM1;
   asm sta PF0;
   asm lda.z TEMPLATE_stripe_cache + 1;
   asm sta PF1;
