   asm sta PF2;
   asm stx.z TEMPLATE_stripe_buffer_b + 0;
   asm lda.iy (TEMPLATE_stripe_service_p0_ptr),y;
   asm lsr.z TEMPLATE_object_masks + 26;
   asm ldx.a TEMPLATE_playfield_colors + 2;
   asm stx.a TEMPLATE_stripe_next_color;
#elif defined(VCS_STRIPES2_REFILL_6LINE_P1_CACHE_PROBE) || defined(VCS_STRIPES2_REFILL_4LINE_P1_CACHE_PROBE) || defined(VCS_STRIPES2_REFILL_6LINE_EXACT_CACHE_PROBE)
   // P1-uniform/P0-cache service pair 1.  Preserve local Y=2 across the P0
   // line; the three-cycle exact P0 load plus DEY exactly replaces the old
   // five-cycle P0 indirect load, so every emitted phase matches dual-pointer.
