   // B pair 6: its post-output object shifts are dead because pair 7 uses
   // packed final bits. Reuse those slots to prefetch PF1, PF2, and PF3. M1 for
   // the next row was already prefetched during pair 1.
   asm @TEMPLATE_B_c_u6:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm lda.ax TEMPLATE_playfield + 5,x;
   asm sta.z TEMPLATE_row_cache + 1;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 11;
   asm sta ENABL;
   asm bcc.same @TEMPLATE_B_c_u6_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @TEMPLATE_B_c_u6_p1_ready;
   asm @TEMPLATE_B_c_u6_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @TEMPLATE_B_c_u6_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 12;
   asm sta ENAM1;
   // Four-cycle PF2 prefetch replaces the dead five-cycle M1 shift. Force the
   // following PF0 load absolute (+1) so the PF1 write remains phase-identical.
   asm ldy.ax TEMPLATE_playfield + 6,x;
   asm lda.a TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   // Complete the PF2 prefetch in the dead M0-shift slot.
   asm sty.z TEMPLATE_row_cache + 2;
   asm nop;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_c_u6_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_c_u6_p0_ready;
   asm @TEMPLATE_B_c_u6_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_c_u6_p0_ready:;
   asm sta GRP0;
   // The dead Ball-shift tail is exactly one seven-cycle PF3 prefetch.
   asm lda.ax TEMPLATE_playfield + 7,x;
   asm sta.z TEMPLATE_row_cache + 3;

   // B pair 7: packed final BL/M1/M0 bits plus next-row M0 prefetch.
   asm @TEMPLATE_B_c_u7:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm lda.zx TEMPLATE_object_masks + 3,x;
   asm sta ENABL;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 13;
   asm ldy.zx TEMPLATE_object_masks + 6,x;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.z TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sty.z TEMPLATE_row_cache + 6;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_B_c_u7_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_B_c_u7_p1_ready;
   asm @TEMPLATE_B_c_u7_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm @TEMPLATE_B_c_u7_p1_ready:;
   asm sta GRP1;
   asm lda.zx TEMPLATE_object_masks + 3,x;
   asm lsr;
   asm sta ENAM1;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.a TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sty.z TEMPLATE_object_masks + 0;
   asm bcc.same @TEMPLATE_B_c_u7_p0_active;
   asm lda #0;
   asm tay;
   asm bit.a CXM0P;
   asm nop;
   asm bcs.same @TEMPLATE_B_c_u7_p0_ready;
   asm @TEMPLATE_B_c_u7_p0_active:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm @TEMPLATE_B_c_u7_p0_ready:;
   asm sta GRP0;

   asm @TEMPLATE_B_c_boundary:;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm cpx #40;
   asm beq.cross @TEMPLATE_terminal_boundary;
   asm lsr.a TEMPLATE_row_cache + 4;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @TEMPLATE_B_c_boundary_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @TEMPLATE_B_c_boundary_p1_ready;
   asm @TEMPLATE_B_c_boundary_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm @TEMPLATE_B_c_boundary_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm inx;
   asm inx;
   asm inx;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same @TEMPLATE_B_c_boundary_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @TEMPLATE_B_c_boundary_p0_ready;
   asm @TEMPLATE_B_c_boundary_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @TEMPLATE_B_c_boundary_p0_ready:;
   asm sta GRP0;
   asm inx;
   asm txs;
   asm jmp @TEMPLATE_A_c_u1;

   // Row 10 is terminal. Its packed M0 bit7 is already active; keep the old
   // row's reflected PF through the final line and close it with WSYNC.
   asm @TEMPLATE_terminal_boundary:;
   // The old PF2@40 / PF1@47 terminal CPU-trace schedule was one cycle late
   // at the center seam in Stella. Four three-cycle BITs keep the same eight-byte
   // footprint while matching all_five(lines:=181) pixel-for-pixel on the final row.
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm sta WSYNC;

   // One blank tail line completes the 181-line score-composable profile.
   // Clear and transfer the delayed Ball latch immediately at line entry: if
   // this is postponed until after the PF/player cleanup, a Ball positioned in
   // the left quarter of the screen is drawn before ENABL=0 reaches the
   // display latch. No stack access occurs until S is restored below.
   asm lda #0;
   asm sta ENABL;
   asm sta GRP1;
   // Restore the caller's hardware stack pointer before the inline draw returns.
   asm ldx.z TEMPLATE_row_cache + 20;
   asm txs;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
   // Restore the two public heights temporarily biased for direct CPY tests.
   asm dec.z TEMPLATE_player0_height;
   asm dec.z TEMPLATE_player1_height;

   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta VDELBL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMCLR;
}

#else
extern const uint8_t TEMPLATE_combined_player_color_lines_must_be_181_or_192[-1];
#endif

#else
// Unsupported feature combinations are rejected at compile time.
extern const uint8_t TEMPLATE_missiles_or_player_colors_configuration_is_not_supported[-1];
#endif
