   asm .byte $85,$2d;
   asm .byte $85,$1b;
   asm .byte $85,$1c;
   asm ldx #$db;
   asm stx PF1;
   asm ldx #$b6;
   asm stx PF2;
   asm ldx #$f0;
   asm sta.a RESP1;
