page static void TEMPLATE_half_renderer_7(void) {
   asm @TEMPLATE_half_renderer_7_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $85,$10;
   asm .byte $85,$2d;
   asm .byte $85,$1b;
   asm .byte $85,$1c;
