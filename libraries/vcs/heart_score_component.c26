   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm dey;
   asm bne.same @TEMPLATE_renderer_1_loop;
