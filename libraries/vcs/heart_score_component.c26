// Half-heart ROM renderers. State 0 is deliberately trivial: one P0 left-half
// sprite at slot zero. States 1..9 preserve the full-heart prefix and use the
// stable SAX opcode to write A&$F0 into the next P0/P1 copy on each row. State
// 10 is unrolled because its Jentzsch row has no four-cycle slot left for SAX.
// State 11 deliberately draws the ordinary 11-heart maximum: there is no 11.5.

page static void TEMPLATE_half_renderer_0(void) {
   asm @TEMPLATE_half_renderer_0_loop:;
   asm lda.ay TEMPLATE_half_heart,y;
   asm .byte $85,$2a;
   asm .byte $24,$10;
   asm .byte $24,$2d;
   asm .byte $85,$1b;
   asm .byte $24,$1c;
   asm lda.z TEMPLATE_box_left_pf1;
   asm sta PF1;
   asm lda.z TEMPLATE_box_left_pf2;
   asm sta PF2;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm lda.a TEMPLATE_box_right_pf2;
   asm sta.a PF2;
   asm lda.a TEMPLATE_box_right_pf1;
   asm sta.a PF1;
   asm .byte $2c,$10,$00;
   asm dey;
   asm bne.same @TEMPLATE_half_renderer_0_loop;
}

page static void TEMPLATE_half_renderer_1(void) {
   asm @TEMPLATE_half_renderer_1_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $24,$10;
   asm .byte $24,$2d;
   asm .byte $85,$1b;
   asm .byte $87,$1c;
   asm lda.z TEMPLATE_box_left_pf1;
   asm sta PF1;
   asm lda.z TEMPLATE_box_left_pf2;
   asm sta PF2;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm lda.a TEMPLATE_box_right_pf2;
   asm sta.a PF2;
   asm lda.a TEMPLATE_box_right_pf1;
   asm sta.a PF1;
   asm .byte $2c,$10,$00;
   asm dey;
   asm bne.same @TEMPLATE_half_renderer_1_loop;
}

page static void TEMPLATE_half_renderer_2(void) {
   asm @TEMPLATE_half_renderer_2_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $85,$10;
   asm .byte $24,$2d;
   asm .byte $85,$1b;
   asm .byte $85,$1c;
   asm ldx #$db;
   asm stx PF1;
   asm ldx.z TEMPLATE_box_left_pf2;
   asm stx PF2;
   asm ldx #$f0;
   asm bit.z $00;
   asm sta.a RESP0;
   asm .byte $8f,$1b,$00;
   asm ldx.a TEMPLATE_box_right_pf2;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm stx.a PF2;
   asm lda.a TEMPLATE_box_right_pf1;
   asm sta.a PF1;
   asm .byte $2c,$10,$00;
   asm dey;
   asm bne.same @TEMPLATE_half_renderer_2_loop;
}

