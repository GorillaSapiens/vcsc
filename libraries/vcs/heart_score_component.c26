   asm nop;
   asm .byte $24,$2d;
   asm .byte $2c,$11,$00;
   asm .byte $8d,$10,$00;
   asm .byte $8f,$1b,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
