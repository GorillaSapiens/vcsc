   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm dey;
   asm bne.same @TEMPLATE_half_renderer_9_loop;
}

page static void TEMPLATE_half_renderer_10(void) {
   asm @TEMPLATE_half_renderer_10_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $85,$10;
   asm sta ENAM0;
   asm .byte $85,$1b;
   asm .byte $85,$1c;
   asm lda.ay TEMPLATE_half_ball,y;
   asm sta ENABL;
   asm and #$30;
   asm sta CTRLPF;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $b5,$10;
   asm dey;
   asm bne.same @TEMPLATE_half_renderer_10_loop;
}

page static void TEMPLATE_half_renderer_11(void) {
   asm @TEMPLATE_half_renderer_11_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $85,$10;
   asm sta ENAM0;
   asm .byte $85,$1b;
   asm .byte $85,$1c;
   asm lda.ay TEMPLATE_half_ball,y;
   asm sta ENABL;
   asm and #$30;
   asm sta CTRLPF;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm .byte $95,$11;
   asm .byte $95,$10;
   asm dey;
   asm bne.same @TEMPLATE_half_renderer_11_loop;
}

static void TEMPLATE_select_kernel(void) {
   // Cache the score-dependent TIA setup during init/VBLANK so TEMPLATE_draw
   // stays on the same pre-WSYNC schedule as the certified RAM version.
   TEMPLATE_nusiz0 := 0x81;
   TEMPLATE_nusiz1 := 0x01;
   TEMPLATE_final_hmp0 := 0xb0;
   if (TEMPLATE_score == 1 || TEMPLATE_score == 2 || (TEMPLATE_half && TEMPLATE_score == 0)) {
      TEMPLATE_nusiz0 := 0;
      TEMPLATE_final_hmp0 := 0x80;
   }
   if (TEMPLATE_score == 2 || TEMPLATE_score == 3) {
      TEMPLATE_nusiz1 := 0;
   }
   // Half states above zero use a two-clock M0.  Bit 7 is ignored by NUSIZ1
   // and doubles as the $80 visible-phase hold value for M0 and Ball.
   if (TEMPLATE_half && TEMPLATE_score > 0) {
      TEMPLATE_nusiz0 |= 0x10;
      TEMPLATE_nusiz1 |= 0x80;
   }

   // Half values select the corresponding ROM renderer.  Values above 11 clamp
   // to 11.5 just as full values clamp to 11.
   if (TEMPLATE_half) {
      if (TEMPLATE_score == 0) {
         asm lda #<TEMPLATE_half_renderer_0;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_0;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 1) {
         asm lda #<TEMPLATE_half_renderer_1;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_1;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 2) {
         asm lda #<TEMPLATE_half_renderer_2;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_2;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 3) {
         asm lda #<TEMPLATE_half_renderer_3;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_3;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 4) {
         asm lda #<TEMPLATE_half_renderer_4;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_4;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 5) {
         asm lda #<TEMPLATE_half_renderer_5;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_5;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 6) {
         asm lda #<TEMPLATE_half_renderer_6;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_6;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 7) {
         asm lda #<TEMPLATE_half_renderer_7;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_7;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 8) {
         asm lda #<TEMPLATE_half_renderer_8;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_8;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 9) {
         asm lda #<TEMPLATE_half_renderer_9;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_9;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 10) {
         asm lda #<TEMPLATE_half_renderer_10;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_10;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      asm lda #<TEMPLATE_half_renderer_11;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_half_renderer_11;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }

   // Clamp values above 11 by selecting the eleven-heart variant. This runs
   // in init/VBLANK, not in the visible renderer.
   if (TEMPLATE_score == 0) {
      asm lda #<TEMPLATE_renderer_0;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_0;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 1) {
      asm lda #<TEMPLATE_renderer_1;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_1;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 2) {
      asm lda #<TEMPLATE_renderer_2;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_2;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 3) {
      asm lda #<TEMPLATE_renderer_3;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_3;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 4) {
      asm lda #<TEMPLATE_renderer_4;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_4;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 5) {
      asm lda #<TEMPLATE_renderer_5;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_5;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 6) {
      asm lda #<TEMPLATE_renderer_6;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_6;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 7) {
      asm lda #<TEMPLATE_renderer_7;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_7;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 8) {
      asm lda #<TEMPLATE_renderer_8;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_8;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 9) {
      asm lda #<TEMPLATE_renderer_9;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_9;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 10) {
      asm lda #<TEMPLATE_renderer_10;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_10;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   asm lda #<TEMPLATE_renderer_11;
   asm sta.z TEMPLATE_renderer_ptr;
   asm lda #>TEMPLATE_renderer_11;
   asm sta.z TEMPLATE_renderer_ptr + 1;
}

// Fixed 22-cycle dispatcher body. Together with the 6-cycle JSR and the
// draw prelude's 38 cycles, the selected ROM renderer begins at cycle 66 -- the
// same centered phase as the certified RAM implementation.
static void TEMPLATE_dispatch(void) {
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm bit.z TEMPLATE_score;
   asm nop;
   asm ldx #0;
   asm ldy #6;
   asm jmp.i (TEMPLATE_renderer_ptr);
}

// Jentzsch singleton coarse/fine positioning. Single-copy players are
// positioned once during VBLANK; the visible renderer then uses the oracle
// motion-register values without changing the established fixed footprint.
static inline void TEMPLATE_position_single_p0(void) {
   asm lda #16;
   asm sta WSYNC;
   asm sec;
   asm @TEMPLATE_p0_pos_loop:;
   asm sbc #$0f;
   asm bcs.same @TEMPLATE_p0_pos_loop;
   asm eor #$07;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta HMP0;
   asm sta.a RESP0;
   asm sta WSYNC;
   asm sta HMOVE;

   // Single-copy NUSIZ places P0 two TIA pixels left of the repeated-copy
   // footprint. One additional setup HMOVE supplies that fixed correction.
   asm lda #$a0;
   asm sta HMP0;
   asm lda #0;
   asm sta HMP1;
   asm sta WSYNC;
   asm sta HMOVE;

   // Keep P0 neutral across a following P1 singleton setup HMOVE.
   asm lda #0;
   asm sta HMP0;
}

static inline void TEMPLATE_position_single_p1(void) {
   asm lda #28;
   asm sta WSYNC;
   asm sec;
   asm @TEMPLATE_p1_pos_loop:;
   asm sbc #$0f;
   asm bcs.same @TEMPLATE_p1_pos_loop;
   asm eor #$07;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta HMP1;
   asm sta.a RESP1;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #$80;
   asm sta HMP1;
}

static inline void TEMPLATE_position_half_overlay(void) {
   // Match the maintained divide-by-15 positioner exactly: resolve the public
   // coordinate before WSYNC, then keep the post-WSYNC RESP/HMxx phase equal
   // to paddleball_position_all().  Moving the table lookup after WSYNC makes
   // some horizontal positions unreachable at coarse-position boundaries.
   asm lda #0;
   asm sta HMP0;
   asm sta HMP1;
   asm sta HMM1;

   asm ldy.z TEMPLATE_score;
   asm cpy #12;
   asm bcc.flex @TEMPLATE_m0_index_ok;
   asm ldy #11;
   asm @TEMPLATE_m0_index_ok:;
   asm lda.ay TEMPLATE_half_m0_x,y;
   asm sta WSYNC;
   asm ldx #2;
   asm bit.z CXM0P;
   asm nop;
   asm sec;
   asm @TEMPLATE_m0_divide:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_m0_divide;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda.ay TEMPLATE_reposition + 16 - 256,y;
   asm sta HMP0,x;

   asm ldy.z TEMPLATE_score;
   asm cpy #12;
   asm bcc.flex @TEMPLATE_ball_index_ok;
   asm ldy #11;
   asm @TEMPLATE_ball_index_ok:;
   asm lda.ay TEMPLATE_half_ball_x,y;
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z CXM0P;
   asm nop;
   asm sec;
   asm @TEMPLATE_ball_divide:;
   asm sbc #15;
   asm bcs.same @TEMPLATE_ball_divide;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda.ay TEMPLATE_reposition + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm sta HMOVE;
}

static inline void TEMPLATE_prepare_positions(void) {
   // Original centered row/setup-5 initial state.
   asm lda #$b0;
   asm sta HMP0;
   asm lda #$80;
   asm sta HMP1;

   // Make setup HMOVEs harmless to missiles/Ball owned by surrounding code.
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;

   // P0 has exactly one logical copy at scores 1 and 2; 0.5 also uses one P0
   // sprite. P1 has one logical copy at scores 2 and 3.
   if (TEMPLATE_score == 1 || TEMPLATE_score == 2 || (TEMPLATE_half && TEMPLATE_score == 0)) {
      TEMPLATE_position_single_p0();
   }
   if (TEMPLATE_score == 2 || TEMPLATE_score == 3) {
      TEMPLATE_position_single_p1();
   }
   if (TEMPLATE_half && TEMPLATE_score > 0) {
      TEMPLATE_position_half_overlay();
   }
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_select_kernel();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_select_kernel();
   TEMPLATE_prepare_positions();
   if (TEMPLATE_half && TEMPLATE_score > 0) {
      COLUPF := TEMPLATE_color;
   }
}

static inline void TEMPLATE_configure_tia(void) {
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENABL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta REFP0;
   asm sta REFP1;
   asm sta HMM1;
   asm lda.z TEMPLATE_nusiz1;
   asm sta NUSIZ1;
   asm sta HMM0;
   asm sta HMBL;
   asm lda.z TEMPLATE_nusiz0;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_final_hmp0;
   asm sta HMP0;
   asm lda #$80;
   asm sta HMP1;
   asm lda.z TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
}

require inline void TEMPLATE_draw(void) {
   TEMPLATE_configure_tia();
   asm sta WSYNC;

   // 38 cycles before JSR. JSR (6) plus the dispatcher's fixed 22 cycles put
   // the first ROM LDA at cycle 66, exactly matching the centered oracle row.
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm bit.a TEMPLATE_score;
   asm nop;
   TEMPLATE_dispatch();

   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENABL;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {}
