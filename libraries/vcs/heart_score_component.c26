// Half-heart ROM renderers.  State 0 is deliberately trivial: one P0 half
// sprite at slot zero.  States 1..11 retain the full-heart prefix and synthesize
// the next right half with Ball + M0 without changing the 76-cycle row schedule.

page static void TEMPLATE_half_renderer_0(void) {
   asm @TEMPLATE_half_renderer_0_loop:;
   asm lda.ay TEMPLATE_half_heart,y;
   asm .byte $85,$2a;
   asm .byte $24,$10;
   asm .byte $24,$2d;
   asm .byte $85,$1b;
   asm .byte $24,$1c;
   asm lda.ay TEMPLATE_blank,y;
   asm .byte $85,$1f;
   asm txa;
   asm .byte $24,$2d;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm dey;
   asm bne.same @TEMPLATE_half_renderer_0_loop;
}

page static void TEMPLATE_half_renderer_1(void) {
   asm @TEMPLATE_half_renderer_1_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $24,$10;
   asm sta ENAM0;
   asm .byte $85,$1b;
   asm .byte $24,$1c;
   asm lda.ay TEMPLATE_half_ball,y;
   asm sta ENABL;
   asm and #$30;
   asm sta CTRLPF;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm dey;
   asm bne.same @TEMPLATE_half_renderer_1_loop;
}

