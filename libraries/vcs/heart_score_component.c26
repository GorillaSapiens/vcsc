// Reusable fixed-footprint 0..11 heart score component with half-heart steps.
//
// Thomas Jentzsch's 11-Invaders renderer is used as the hardware oracle.  The
// twelve score-specific renderer variants live entirely in cartridge ROM.
// They preserve the original instruction schedule while replacing the old
// self-modifying 45-byte RIOT-RAM copy with prepatched ROM instructions.
// Eleven hearts define one centered footprint; smaller scores are exact
// left-justified prefixes of that same footprint. TEMPLATE_half adds the left
// half of the next heart through 10.5; at the 11-heart maximum it is ignored.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear.  It consumes seven scanlines and returns at cycle zero after
// its terminal WSYNC.  It owns P0/P1 graphics, color, reflection, VDEL, NUSIZ,
// horizontal motion, RESP0/RESP1, and HMOVE while drawing. Half-heart pixels
// use the same two players only; they do not consume M0/Ball. The visible setup
// line neutralizes missile/Ball motion before its positioning HMOVE, and
// terminal cleanup leaves M0 and Ball disabled. The default profile does not
// touch playfield graphics, CTRLPF, or COLUPF.
//
// Optional compile-time line markers use the playfield on two dedicated
// scanlines, one above and one below the hearts, with blank separation from the
// six heart rows. Instantiate with line_markers:=1 to enable TEMPLATE_lines
// (0..11) and TEMPLATE_line_color. The enabled profile owns/clobbers
// PF0/PF1/PF2, CTRLPF, and COLUPF while drawing; it leaves PF graphics clear on
// return but does not restore the predecessor's color/control values. The
// disabled profile keeps the historical seven-line renderer and allocates no
// marker state; the enabled profile is ten visible scanlines and 12 RAM bytes.
//
// Neither profile touches VSYNC, VBLANK, the RIOT timer, audio, or collision
// latches. A/X/Y and arithmetic flags are clobbered; hardware stack depth is
// unchanged at lifecycle boundaries.

parameter line_markers := 0;

#if TEMPLATE_line_markers != 0 && TEMPLATE_line_markers != 1
extern const uint8_t TEMPLATE_line_markers_must_be_0_or_1[0];
#endif

#if TEMPLATE_line_markers
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 10
#else
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 7
#endif

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES :=TEMPLATE_VISIBLE_SCANLINES_VALUE,
   TEMPLATE_DRAW_ENTRY_CYCLE :=3,
   TEMPLATE_DRAW_RETURN_CYCLE :=0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES :=TEMPLATE_VISIBLE_SCANLINES_VALUE,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES :=0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES :=0,
   TEMPLATE_DRAW_TERMINAL_WSYNC :=1,
   TEMPLATE_DRAW_HMOVE_COUNT :=7,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE :=1,
   TEMPLATE_VBLANK_MAX_CYCLES :=900,
   TEMPLATE_OVERSCAN_MAX_CYCLES :=0,
   TEMPLATE_MAX_HEARTS :=11,
   TEMPLATE_HEART_WIDTH :=8,
   TEMPLATE_HEART_PITCH :=12,
   TEMPLATE_HALF_STATES :=2
};

recommend uint8_t TEMPLATE_score :=0;
recommend uint8_t TEMPLATE_color :=0x46;
recommend uint8_t TEMPLATE_half :=0;

#if TEMPLATE_line_markers
// Runtime marker state exists only in the enabled template profile.  `lines`
// selects a left-justified prefix of the same eleven fixed heart slots.
recommend uint8_t TEMPLATE_lines :=0;
recommend uint8_t TEMPLATE_line_color :=0;
uint8_t TEMPLATE_line_pf1_left;
uint8_t TEMPLATE_line_pf2_left;

// The marker occupies exactly the central 128 pixels (TIA X=16..143).  Each
// slot is eight pixels on a twelve-pixel pitch: two playfield bits on, then a
// four-pixel gap.  The four tables are the asymmetric PF1/PF2 bytes for the
// left and right 64-pixel halves.
page const uint8_t TEMPLATE_line_pf1_left_table[12] := {
   0x00,0xc0,0xd8,0xdb,0xdb,0xdb,0xdb,0xdb,0xdb,0xdb,0xdb,0xdb
};
page const uint8_t TEMPLATE_line_pf2_left_table[12] := {
   0x00,0x00,0x00,0x00,0x06,0x36,0xb6,0xb6,0xb6,0xb6,0xb6,0xb6
};
page const uint8_t TEMPLATE_line_pf2_right_table[12] := {
   0x00,0x00,0x00,0x00,0x00,0x00,0x80,0xb0,0xb6,0xb6,0xb6,0xb6
};
page const uint8_t TEMPLATE_line_pf1_right_table[12] := {
   0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x03,0x1b,0xdb
};
#endif

// Private RIOT-RAM state: selected ROM renderer plus the three score-dependent
// TIA values needed by the fixed-cycle draw setup. HMP1 is always $80.
uint16_t TEMPLATE_renderer_ptr;
uint8_t TEMPLATE_nusiz0;
uint8_t TEMPLATE_nusiz1;
uint8_t TEMPLATE_final_hmp0;

// Y runs 6..1. Index zero is deliberately unused.  Hard page containment
// guarantees absolute,Y loads stay four cycles for every glyph row.
page const uint8_t TEMPLATE_heart[7] := {0,0x18,0x3c,0x7e,0xff,0xff,0x66};
page const uint8_t TEMPLATE_blank[7] := {0,0,0,0,0,0,0};
// High nibble of the normal heart glyph. The TIA shifts player graphics from
// bit 7 toward bit 0, so this is the visible left half of the next heart.
page const uint8_t TEMPLATE_half_heart[7] := {0,0x10,0x30,0x70,0xf0,0xf0,0x60};

// These are byte-for-byte instruction-schedule equivalents of the patched
// RAM renderer for scores 0..11.  Enabled logical RESP slots are stores;
// disabled slots are equal-cycle BIT/LDA reads.  Each function is page-bound
// so the taken BNE never gains a page-crossing cycle.
page static void TEMPLATE_renderer_0(void) {
   asm @TEMPLATE_renderer_0_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $24,$10;
   asm .byte $24,$2d;
   asm .byte $24,$1b;
   asm .byte $24,$1c;
   asm lda.ay TEMPLATE_blank,y;
   asm .byte $85,$1f;
   asm txa;
   asm .byte $85,$2d;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm dey;
   asm bne.same @TEMPLATE_renderer_0_loop;
}

