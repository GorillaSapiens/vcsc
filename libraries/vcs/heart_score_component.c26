   asm .byte $24,$2d;
   asm .byte $85,$1b;
   asm .byte $24,$1c;
   asm lda.ay TEMPLATE_blank,y;
   asm .byte $85,$1f;
   asm txa;
   asm .byte $24,$2d;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm .byte $b5,$11;
   asm .byte $b5,$10;
   asm dey;
   asm bne.same @TEMPLATE_renderer_1_loop;
}

