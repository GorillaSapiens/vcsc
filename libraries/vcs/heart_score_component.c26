// Reusable fixed-footprint 0..11 heart score component with half-heart steps.
// Optional playfield boxes form a separately colored capacity meter.
// banked:=1 pins the indirect dispatcher to bank1 so F8 applications may keep
// the renderer-pointer targets and dispatcher under the same active mapping.

parameter banked := 0;
//
// Thomas Jentzsch's 11-Invaders renderer is used as the hardware oracle.  The
// twelve score-specific renderer variants live entirely in cartridge ROM.
// They preserve the original heart timing while using otherwise-dead row slots
// for the asymmetric PF1/PF2 capacity-box stream.
// Eleven hearts define one centered footprint; smaller scores are exact
// left-justified prefixes of that same footprint. TEMPLATE_half adds the left
// half of the next heart through 10.5; at the 11-heart maximum it is ignored.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear.  It consumes seven scanlines and returns at cycle zero after
// its terminal WSYNC.  It owns P0/P1 graphics, color, reflection, VDEL, NUSIZ,
// horizontal motion, RESP0/RESP1, and HMOVE while drawing. Half-heart pixels
// use the same two players only; M0/Ball remain disabled. Boxes use PF1/PF2,
// COLUPF, and reflected CTRLPF. The terminal cleanup clears PF0/PF1/PF2 but
// does not restore the caller's COLUPF/CTRLPF values, so a following visible
// component must establish its own playfield state. The visible setup line
// neutralizes missile/Ball motion before its positioning HMOVE. It does not
// touch VSYNC, VBLANK, RIOT timer, audio, or collision latches. A/X/Y and
// arithmetic flags are clobbered; hardware stack depth is unchanged at
// lifecycle boundaries.

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES :=7,
   TEMPLATE_DRAW_ENTRY_CYCLE :=3,
   TEMPLATE_DRAW_RETURN_CYCLE :=0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES :=7,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES :=0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES :=0,
   TEMPLATE_DRAW_TERMINAL_WSYNC :=1,
   TEMPLATE_DRAW_HMOVE_COUNT :=7,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE :=1,
   TEMPLATE_VBLANK_MAX_CYCLES :=900,
   TEMPLATE_OVERSCAN_MAX_CYCLES :=0,
   TEMPLATE_MAX_HEARTS :=11,
   TEMPLATE_HEART_WIDTH :=8,
   TEMPLATE_HEART_PITCH :=12,
   TEMPLATE_HALF_STATES :=2,
   TEMPLATE_MAX_BOXES :=11
};

recommend uint8_t TEMPLATE_score :=0;
recommend uint8_t TEMPLATE_color :=0x46;
recommend uint8_t TEMPLATE_half :=0;
recommend uint8_t TEMPLATE_boxes :=11;
recommend uint8_t TEMPLATE_box_color :=0x2e;

// Private RIOT-RAM state: selected ROM renderer, score-dependent TIA setup,
// and the asymmetric playfield bytes for the requested 0..11 box capacity.
// HMP1 is always $80.  The box count is a capacity: VBLANK clamps health to it.
uint16_t TEMPLATE_renderer_ptr;
uint8_t TEMPLATE_nusiz0;
uint8_t TEMPLATE_nusiz1;
uint8_t TEMPLATE_final_hmp0;
uint8_t TEMPLATE_box_left_pf1;
uint8_t TEMPLATE_box_left_pf2;
uint8_t TEMPLATE_box_right_pf1;
uint8_t TEMPLATE_box_right_pf2;
uint8_t TEMPLATE_pf_prefetch;
uint8_t TEMPLATE_y_prefetch;

// Y runs 6..1. Index zero is deliberately unused.  Hard page containment
// guarantees absolute,Y loads stay four cycles for every glyph row.
page const uint8_t TEMPLATE_heart[7] := {0,0x18,0x3c,0x7e,0xff,0xff,0x66};
page const uint8_t TEMPLATE_blank[7] := {0,0,0,0,0,0,0};
// High nibble of the normal heart glyph. The TIA shifts player graphics from
// bit 7 toward bit 0, so this is the visible left half of the next heart.
page const uint8_t TEMPLATE_half_heart[7] := {0,0x10,0x30,0x70,0xf0,0xf0,0x60};

// Two playfield bits form each 8-pixel box and the following bit is the
// 4-pixel gap.  The meter straddles the playfield midpoint, so the left and
// right serialized halves need different bytes.  Renderer timing switches PF2
// and PF1 at fixed horizontal phases; only these byte values depend on capacity.
page const uint8_t TEMPLATE_box_left_pf1_table[12] :=
   {0x00,0xc0,0xd8,0xdb,0xdb,0xdb,0xdb,0xdb,0xdb,0xdb,0xdb,0xdb};
page const uint8_t TEMPLATE_box_left_pf2_table[12] :=
   {0x00,0x00,0x00,0x00,0x06,0x36,0xb6,0xb6,0xb6,0xb6,0xb6,0xb6};
page const uint8_t TEMPLATE_box_right_pf1_table[12] :=
   {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x03,0x1b,0xdb};
page const uint8_t TEMPLATE_box_right_pf2_table[12] :=
   {0x00,0x00,0x00,0x00,0x00,0x00,0x80,0xb0,0xb6,0xb6,0xb6,0xb6};

// These are byte-for-byte instruction-schedule equivalents of the patched
// RAM renderer for scores 0..11.  Enabled logical RESP slots are stores;
// disabled slots are equal-cycle BIT/LDA reads.  Each function is page-bound
// so the taken BNE never gains a page-crossing cycle.
page static void TEMPLATE_renderer_0(void) {
   asm @TEMPLATE_renderer_0_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $24,$10;
   asm .byte $24,$2d;
   asm .byte $24,$1b;
   asm .byte $24,$1c;
   asm lda.z TEMPLATE_box_left_pf1;
   asm sta PF1;
   asm lda.z TEMPLATE_box_left_pf2;
   asm sta PF2;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm stx.a PF2;
   asm lda.a TEMPLATE_box_right_pf1;
   asm sta.a PF1;
   asm .byte $2c,$10,$00;
   asm dey;
   asm bne.same @TEMPLATE_renderer_0_loop;
}

page static void TEMPLATE_renderer_1(void) {
   asm @TEMPLATE_renderer_1_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm .byte $85,$2a;
   asm .byte $24,$10;
   asm .byte $24,$2d;
   asm .byte $85,$1b;
   asm .byte $24,$1c;
   asm lda.z TEMPLATE_box_left_pf1;
   asm sta PF1;
   asm lda.z TEMPLATE_box_left_pf2;
   asm sta PF2;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm .byte $2c,$11,$00;
   asm .byte $2c,$10,$00;
   asm stx.a PF2;
   asm lda.a TEMPLATE_box_right_pf1;
   asm sta.a PF1;
   asm .byte $2c,$10,$00;
   asm dey;
   asm bne.same @TEMPLATE_renderer_1_loop;
}

