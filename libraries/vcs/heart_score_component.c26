// Reusable 0..11 heart score component.
//
// The visible renderer is a ROM-specialized port of Thomas Jentzsch's
// 11-Invaders display technique.  Each score value owns one fixed-cycle form
// of the original 47-byte self-modifying RAM renderer: enabled RESP slots are
// stores, disabled slots are equal-cycle harmless reads.  No executable code
// or patch buffer is kept in RIOT RAM.
//
// Eleven hearts define the fixed display footprint.  Smaller values retain the
// same left edge and suppress hearts only from the right.  Score values above
// 11 clamp to 11.  The optional half-heart flag is reserved for the separate
// enhancement path and does not alter the full-heart renderer.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear.  It consumes eight scanlines and returns at cycle zero of the
// following line.  The renderer owns P0/P1 graphics, colors, reflection, VDEL,
// NUSIZ, horizontal motion, RESP0/RESP1, and HMOVE while drawing.  It does not
// touch playfield graphics, missiles, Ball, VSYNC, VBLANK, RIOT timer, audio,
// or collision latches.  A/X/Y and arithmetic flags are clobbered.

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := 8,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := 8,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 6,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 120,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0,
   TEMPLATE_MAX_HEARTS := 11,
   TEMPLATE_HEART_WIDTH := 8,
   TEMPLATE_HEART_PITCH := 12
};

recommend uint8_t TEMPLATE_score := 0;
recommend uint8_t TEMPLATE_half := 0;
recommend uint8_t TEMPLATE_color := 0x46;
uint8_t TEMPLATE_count;
uint16_t TEMPLATE_renderer;

// Six scanline, eight-pixel heart.  Rows are consumed Y=5 down through Y=0.
const uint8_t TEMPLATE_full_heart[6] := {0x18,0x3c,0x7e,0xff,0xff,0x66};
const uint8_t TEMPLATE_no_ball[6] := {0,0,0,0,0,0};

static void TEMPLATE_render_0(void) {
   asm @TEMPLATE_render_0_loop:;
   asm lda.ay TEMPLATE_full_heart,y;
   asm sta.z HMOVE;
   asm sta.z RESP0;
   asm sta.z RESP1;
   asm stx.z GRP0;
   asm stx.z GRP1;
   asm lda.ay TEMPLATE_no_ball,y;
   asm sta.z ENABL;
   asm txa;
   asm bit.z TEMPLATE_count;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm lda.zx TEMPLATE_count,x;
   asm dey;
   asm bpl.same @TEMPLATE_render_0_loop;
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENABL;
   asm rts;
}
