static void TEMPLATE_select_renderer(void) {
   // Boxes are the health capacity. Keep both public controls in-range during
   // blanking so every visible renderer can rely on boxes >= displayed health.
   if (TEMPLATE_boxes > TEMPLATE_MAX_HEARTS) {
      TEMPLATE_boxes := TEMPLATE_MAX_HEARTS;
   }
   if (TEMPLATE_score > TEMPLATE_boxes) {
      TEMPLATE_score := TEMPLATE_boxes;
      TEMPLATE_half := 0;
   }
   if (TEMPLATE_half && TEMPLATE_score >= TEMPLATE_boxes) {
      TEMPLATE_half := 0;
   }

   TEMPLATE_box_left_pf1 := TEMPLATE_box_left_pf1_table[TEMPLATE_boxes];
   TEMPLATE_box_left_pf2 := TEMPLATE_box_left_pf2_table[TEMPLATE_boxes];
   TEMPLATE_box_right_pf1 := TEMPLATE_box_right_pf1_table[TEMPLATE_boxes];
   TEMPLATE_box_right_pf2 := TEMPLATE_box_right_pf2_table[TEMPLATE_boxes];

   // Full-heart renderers use X as a preloaded right-half playfield byte.
   // Scores through eight need PF2 first; the dense 9/10 streams instead need
   // PF1 preloaded because their earlier logical slots are occupied by RESP.
   TEMPLATE_pf_prefetch := TEMPLATE_box_right_pf2;
   if (TEMPLATE_half) {
      TEMPLATE_pf_prefetch := 0xf0;
      if (TEMPLATE_score >= 8) {
         TEMPLATE_pf_prefetch := 0xdb;
      }
   }
   else {
      if (TEMPLATE_score >= 9) {
         TEMPLATE_pf_prefetch := TEMPLATE_box_right_pf1;
      }
   }
   TEMPLATE_y_prefetch := 6;
   if (TEMPLATE_half && TEMPLATE_score >= 8) {
      TEMPLATE_y_prefetch := TEMPLATE_box_right_pf1;
   }

   // Cache the score-dependent TIA setup during init/VBLANK so TEMPLATE_draw
   // stays on the same pre-WSYNC schedule as the certified RAM version.
   TEMPLATE_nusiz0 := 0x81;
   TEMPLATE_nusiz1 := 0x01;
   TEMPLATE_final_hmp0 := 0xb0;
   if ((!TEMPLATE_half && (TEMPLATE_score == 1 || TEMPLATE_score == 2)) ||
       (TEMPLATE_half && (TEMPLATE_score == 0 || TEMPLATE_score == 1))) {
      TEMPLATE_nusiz0 := 0;
      TEMPLATE_final_hmp0 := 0x80;
   }
   if ((!TEMPLATE_half && (TEMPLATE_score == 2 || TEMPLATE_score == 3)) ||
       (TEMPLATE_half && (TEMPLATE_score == 1 || TEMPLATE_score == 2))) {
      TEMPLATE_nusiz1 := 0;
   }

   // Half values through 10 select the corresponding left-half renderer.
   // Score 11 (and values above it) is already the maximum, so half is ignored
   // visually by selecting the X-independent 11-heart half-path renderer.
   if (TEMPLATE_half) {
      if (TEMPLATE_score == 0) {
         asm lda #<TEMPLATE_half_renderer_0;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_0;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 1) {
         asm lda #<TEMPLATE_half_renderer_1;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_1;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 2) {
         asm lda #<TEMPLATE_half_renderer_2;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_2;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 3) {
         asm lda #<TEMPLATE_half_renderer_3;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_3;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 4) {
         asm lda #<TEMPLATE_half_renderer_4;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_4;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 5) {
         asm lda #<TEMPLATE_half_renderer_5;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_5;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 6) {
         asm lda #<TEMPLATE_half_renderer_6;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_6;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 7) {
         asm lda #<TEMPLATE_half_renderer_7;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_7;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 8) {
         asm lda #<TEMPLATE_half_renderer_8;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_8;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 9) {
         asm lda #<TEMPLATE_half_renderer_9;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_9;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      if (TEMPLATE_score == 10) {
         asm lda #<TEMPLATE_half_renderer_10;
         asm sta.z TEMPLATE_renderer_ptr;
         asm lda #>TEMPLATE_half_renderer_10;
         asm sta.z TEMPLATE_renderer_ptr + 1;
         return;
      }
      asm lda #<TEMPLATE_half_renderer_11;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_half_renderer_11;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }

   // Clamp values above 11 by selecting the eleven-heart variant. This runs
   // in init/VBLANK, not in the visible renderer.
   if (TEMPLATE_score == 0) {
      asm lda #<TEMPLATE_renderer_0;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_0;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 1) {
      asm lda #<TEMPLATE_renderer_1;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_1;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 2) {
      asm lda #<TEMPLATE_renderer_2;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_2;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 3) {
      asm lda #<TEMPLATE_renderer_3;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_3;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 4) {
      asm lda #<TEMPLATE_renderer_4;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_4;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 5) {
      asm lda #<TEMPLATE_renderer_5;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_5;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 6) {
      asm lda #<TEMPLATE_renderer_6;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_6;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 7) {
      asm lda #<TEMPLATE_renderer_7;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_7;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 8) {
      asm lda #<TEMPLATE_renderer_8;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_8;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 9) {
      asm lda #<TEMPLATE_renderer_9;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_9;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   if (TEMPLATE_score == 10) {
      asm lda #<TEMPLATE_renderer_10;
      asm sta.z TEMPLATE_renderer_ptr;
      asm lda #>TEMPLATE_renderer_10;
      asm sta.z TEMPLATE_renderer_ptr + 1;
      return;
   }
   asm lda #<TEMPLATE_renderer_11;
   asm sta.z TEMPLATE_renderer_ptr;
   asm lda #>TEMPLATE_renderer_11;
   asm sta.z TEMPLATE_renderer_ptr + 1;
}

// Fixed 22-cycle dispatcher body. Together with the 6-cycle JSR and the
// draw prelude's 38 cycles, the selected ROM renderer begins at cycle 66 -- the
// same centered phase as the certified RAM implementation. X is a VBLANK-cached
// renderer prefetch: full streams use a right-half PF byte, low half streams use
// the SAX $F0 mask, and dense half streams use their fixed left-PF1 value.
#if TEMPLATE_banked == 1
bank1 static void TEMPLATE_dispatch(void) {
#else
static void TEMPLATE_dispatch(void) {
#endif
   asm ldx.a TEMPLATE_pf_prefetch;
   asm bit.a TEMPLATE_half;
   asm nop;
   asm bit.z TEMPLATE_score;
   asm nop;
   asm nop;
   asm jmp.i (TEMPLATE_renderer_ptr);
}

// The visible setup line re-establishes P0/P1 horizontal state on every draw.
// Back-to-back absolute RESP strobes preserve the 12-pixel heart pitch; the
// late $50 setup HMOVE places singleton P0/P1 so the renderer's normal $80
// row HMOVE yields the fixed X=16/X=28 slots. Higher-count streams issue their
// own timed RESP strobes. This makes draw order independent of predecessor X.

require inline void TEMPLATE_init(void) {
   TEMPLATE_select_renderer();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_select_renderer();
}

static inline void TEMPLATE_configure_tia(void) {
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENABL;
   // Clear the playfield in the old nine-cycle dead-time window. The row
   // kernels establish PF1/PF2 only after the meter's left edge.
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm .byte $8d,$10,$00;
   asm .byte $8d,$11,$00;
   asm lda #$50;
   asm sta HMP0;
   asm sta HMP1;
   asm lda #0;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta HMM1;
   asm sta HMM0;
   asm sta HMBL;
   asm sta HMOVE;
   asm lda #1;
   asm sta CTRLPF;
   asm lda.z TEMPLATE_box_color;
   asm sta COLUPF;
}

require inline void TEMPLATE_draw(void) {
   TEMPLATE_configure_tia();
   // Consume the historical three-cycle pre-WSYNC slack by preloading Y. Loop
   // renderers receive 6; the dense unrolled half renderers receive right PF1.
   asm ldy.z TEMPLATE_y_prefetch;
   asm sta WSYNC;

   // Restore score-dependent Jentzsch motion and color in exactly 38 cycles
   // before JSR, preserving the certified cycle-66 renderer entry.
   asm sta REFP0;
   asm sta REFP1;
   asm lda.z TEMPLATE_nusiz1;
   asm sta NUSIZ1;
   asm lda.z TEMPLATE_nusiz0;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_final_hmp0;
   asm sta HMP0;
   asm lda #$80;
   asm sta HMP1;
   asm lda.z TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
   TEMPLATE_dispatch();

   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENABL;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {}
