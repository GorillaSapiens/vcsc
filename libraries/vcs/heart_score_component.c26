static inline void TEMPLATE_select_renderer(void) {
   asm ldx.z TEMPLATE_score;
   asm cpx #11;
   asm bcc.flex @TEMPLATE_count_ok;
   asm ldx #11;
   asm @TEMPLATE_count_ok:;
   asm stx.z TEMPLATE_count;
   asm txa;
   asm asl;
   asm tax;
   asm lda.ax @TEMPLATE_table,x;
   asm sta.z TEMPLATE_renderer;
   asm inx;
   asm lda.ax @TEMPLATE_table,x;
   asm sta.z TEMPLATE_renderer + 1;
   asm jmp @TEMPLATE_table_done;
   asm @TEMPLATE_table:;
   asm .word TEMPLATE_render_0,TEMPLATE_render_1,TEMPLATE_render_2,TEMPLATE_render_3;
   asm .word TEMPLATE_render_4,TEMPLATE_render_5,TEMPLATE_render_6,TEMPLATE_render_7;
   asm .word TEMPLATE_render_8,TEMPLATE_render_9,TEMPLATE_render_10,TEMPLATE_render_11;
   asm @TEMPLATE_table_done:;
}

static void TEMPLATE_render(void) {
   asm jmp.i (TEMPLATE_renderer);
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_select_renderer();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_select_renderer();
}

require inline void TEMPLATE_draw(void) {
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENABL;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta REFP0;
   asm sta REFP1;

   // Fixed geometry derived from the literal 11-Invaders renderer.  This HMP
   // pair plus cycle-67 entry retains all eleven copies while placing the
   // maximum row essentially at screen center.  Every smaller state is a
   // left-anchored prefix of the same geometry.
   asm lda #$80;
   asm sta HMP0;
   asm lda #$50;
   asm sta HMP1;
   asm lda #$81;
   asm sta NUSIZ0;
   asm lda #$01;
   asm sta NUSIZ1;
   asm lda.z TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta WSYNC;

   // The original code enters its 76-cycle RAM renderer at a precise raster
   // phase.  Our ROM dispatcher adds 15 cycles after this padding: LDY/LDX (4),
   // JSR (6), and JMP (renderer) (5).  Thirteen absolute BITs contribute 52
   // cycles, so the first renderer instruction lands at cycle 67.
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm bit.a TEMPLATE_count;
   asm ldy #5;
   asm ldx #0;
   TEMPLATE_render();

   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENABL;
   asm sta WSYNC;
}

require inline void TEMPLATE_overscan(void) {
}
