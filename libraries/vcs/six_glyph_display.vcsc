// Shared centered six-glyph TIA display kernel.
//
// Include one fonts/*_decimal.vcsc or fonts/*_hex.vcsc module first; it must
// define score_font. The caller fills six_glyph_pointers with six complete
// 16-bit glyph addresses in left-to-right order, calls six_glyph_setup() once
// while VBLANK is active, then calls six_glyph_draw() for each eight-row block.
//
// The positioning and GRP write schedule are one inseparable timing contract.
// Keep both here so examples cannot copy the row loop while accidentally
// compiling a differently timed RESP0/RESP1 setup.

uint8_t six_glyph_pointers[12];
uint8_t six_glyph_row;
uint8_t six_glyph_delayed;

void six_glyph_setup(void) {
   // Horizontal positions persist, so perform this exact sequence once under
   // VBLANK. The cycle at which RESP0/RESP1 are written determines whether the
   // cycle-16 GRP0 update is safely past the first P0 copy.
   WSYNC := 0;
   asm lda #$03;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm lda #$0e;
   asm bit six_glyph_pointers;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta HMCLR;
   asm lda #$80;
   asm sta HMP0;
   asm lda #$90;
   asm sta HMP1;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
   WSYNC := 0;
   HMOVE := 0;
}

void six_glyph_draw(void) {
   COLUP0 := 0x0e;
   COLUP1 := 0x0e;
   GRP0 := 0;
   GRP1 := 0;
   VDELP0 := 1;
   VDELP1 := 1;
   six_glyph_row := 7;

   // Canonical documented-opcode 48-pixel pipeline. Digit 1 is preloaded
   // immediately before WSYNC. After WSYNC, the remaining GRP writes complete
   // at cycles 8, 16, 44, 47, 50, and 53.
   asm @six_glyph_loop:;
   asm ldy six_glyph_row;
   asm lda (six_glyph_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   asm lda (six_glyph_pointers+$2),y;
   asm sta GRP1;
   asm lda (six_glyph_pointers+$4),y;
   asm sta GRP0;
   asm lda (six_glyph_pointers+$6),y;
   asm sta six_glyph_delayed;
   asm lda (six_glyph_pointers+$8),y;
   asm tax;
   asm lda (six_glyph_pointers+$a),y;
   asm tay;
   asm lda six_glyph_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   asm dec six_glyph_row;
   asm bpl @six_glyph_loop;

   GRP0 := 0;
   GRP1 := 0;
   VDELP0 := 0;
   VDELP1 := 0;
   WSYNC := 0;
}
