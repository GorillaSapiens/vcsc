// Dynacom Megaboy F0: sixteen physical 4K ROM banks.  All banks share the
// canonical $F000-$FFFF link/CPU window.  Hardware powers up in physical bank
// 15 and every access to $1FF0 advances to the next bank modulo 16.
include "vcs.c26"

cartridge {
   $bankcall
   $fill:0xff $signature:F0
   $trampoline_offset:0x0f00 $trampoline_size:0x0060
   // Keep reset bridges below $FFF0: fetching $FFF0 itself advances F0.
   $vector_bridge_offset:0x0ee0 $vector_bridge_size:0x0012
   $vectors_offset:0x0ffa $vectors_size:0x0006
};

bank bank0 { $image_size:0x1000 $file_index:0 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x00 };
mem bank0 { $start:0xf000 $size:0x0ee0 $ro $bank:bank0 };

bank bank1 { $image_size:0x1000 $file_index:1 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x01 };
mem bank1 { $start:0xf000 $size:0x0ee0 $ro $bank:bank1 };

bank bank2 { $image_size:0x1000 $file_index:2 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x02 };
mem bank2 { $start:0xf000 $size:0x0ee0 $ro $bank:bank2 };

bank bank3 { $image_size:0x1000 $file_index:3 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x03 };
mem bank3 { $start:0xf000 $size:0x0ee0 $ro $bank:bank3 };

bank bank4 { $image_size:0x1000 $file_index:4 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x04 };
mem bank4 { $start:0xf000 $size:0x0ee0 $ro $bank:bank4 };

bank bank5 { $image_size:0x1000 $file_index:5 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x05 };
mem bank5 { $start:0xf000 $size:0x0ee0 $ro $bank:bank5 };

bank bank6 { $image_size:0x1000 $file_index:6 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x06 };
mem bank6 { $start:0xf000 $size:0x0ee0 $ro $bank:bank6 };

bank bank7 { $image_size:0x1000 $file_index:7 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x07 };
mem bank7 { $start:0xf000 $size:0x0ee0 $ro $bank:bank7 };

bank bank8 { $image_size:0x1000 $file_index:8 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x08 };
mem bank8 { $start:0xf000 $size:0x0ee0 $ro $bank:bank8 };

bank bank9 { $image_size:0x1000 $file_index:9 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x09 };
mem bank9 { $start:0xf000 $size:0x0ee0 $ro $bank:bank9 };

bank bank10 { $image_size:0x1000 $file_index:10 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x0a };
mem bank10 { $start:0xf000 $size:0x0ee0 $ro $bank:bank10 };

bank bank11 { $image_size:0x1000 $file_index:11 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x0b };
mem bank11 { $start:0xf000 $size:0x0ee0 $ro $bank:bank11 };

bank bank12 { $image_size:0x1000 $file_index:12 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x0c };
mem bank12 { $start:0xf000 $size:0x0ee0 $ro $bank:bank12 };

bank bank13 { $image_size:0x1000 $file_index:13 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x0d };
mem bank13 { $start:0xf000 $size:0x0ee0 $ro $bank:bank13 };

bank bank14 { $image_size:0x1000 $file_index:14 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $bankcall_descriptor:0x0e };
mem bank14 { $start:0xf000 $size:0x0ee0 $ro $bank:bank14 };

bank bank15 { $image_size:0x1000 $file_index:15 $image_offset:0 $link_start:0xf000 $cpu_start:0xf000 $map_size:0x1000 $startup $bankcall_descriptor:0x0f };
mem bank15 { $start:0xf000 $size:0x0ee0 $ro $bank:bank15 $priority:2 };

