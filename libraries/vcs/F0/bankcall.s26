;
; Descriptor-ABI cross-bank JSR/RTS trampoline for Dynacom Megaboy F0.
; Descriptors are physical bank numbers 0..15.  F0 has no absolute selector:
; every access to $1FF0 advances to the next bank modulo 16.  The source copy
; computes (destination-source)&15 before the first switch.  After the target
; RTS reaches this same replicated address in the destination bank, that copy
; computes (source-destination)&15 and advances back to the caller.
;
; All bytes executed after the first $1FF0 access are identical in every bank.
; The only bank-local immediate, VCSC_BANKCALL_SOURCE_DESCRIPTOR, is consumed
; before switching.  Manual code that changes F0 banks behind the compiler's
; back is outside the generated-call state contract.

.ifndef VCSC_BANKCALL_PTR0
VCSC_BANKCALL_PTR0 = $0080
.endif
.ifndef VCSC_BANKCALL_SOURCE_DESCRIPTOR
VCSC_BANKCALL_SOURCE_DESCRIPTOR = $00
.endif
.ifndef VCSC_BANKCALL_SELECTOR_BASE
VCSC_BANKCALL_SELECTOR_BASE = $0000
.endif

; TEMPLATE ASSEMBLY ORIGIN ONLY.
.segmentdef "CODE", $6000, $0100
.segment "CODE"

.export __vcsc_generic_bankcall_begin
.export __vcsc_generic_bankreturn
.export __vcsc_generic_bankcall_switch_and_jump
.export __vcsc_generic_bankcall_end
.export __vcsc_generic_bankcall_reserved_end

__vcsc_generic_bankcall_begin:
    tsx
    lda $0101,x
    sta VCSC_BANKCALL_PTR0
    lda $0102,x
    sta VCSC_BANKCALL_PTR0 + 1

    ; Skip target-low, target-high, and destination descriptor on final RTS.
    lda $0101,x
    clc
    adc #3
    sta $0101,x
    bcc.same @return_adjusted
    inc $0102,x
@return_adjusted:

    ; Consume the complete inline target while the source bank is mapped.
    ldy #3
    lda (VCSC_BANKCALL_PTR0),y
    tax
    dey
    lda (VCSC_BANKCALL_PTR0),y
    pha
    dey
    lda (VCSC_BANKCALL_PTR0),y
    sta VCSC_BANKCALL_PTR0
    pla
    sta VCSC_BANKCALL_PTR0 + 1

    ; Convert destination bank ID to a forward F0 advance count before the
    ; first bank switch.  Also save the original source ID as call metadata.
    txa
    sec
    sbc #VCSC_BANKCALL_SOURCE_DESCRIPTOR
    and #$0f
    tax
    lda #VCSC_BANKCALL_SOURCE_DESCRIPTOR
    pha
    jsr __vcsc_generic_bankcall_switch_and_jump

__vcsc_generic_bankreturn:
    ; Preserve the public A:X return value while restoring the source bank.
    sta VCSC_BANKCALL_PTR0
    stx VCSC_BANKCALL_PTR0 + 1
    pla
    sec
    sbc #VCSC_BANKCALL_SOURCE_DESCRIPTOR
    and #$0f
    tax
@return_advance:
    ; Raw undocumented NMOS NOP abs.  The cartridge observes the read and
    ; advances one bank; the next opcode is fetched from the next bank at the
    ; same replicated trampoline address.
    op0C $1FF0
    dex
    bne.same @return_advance
    lda VCSC_BANKCALL_PTR0
    ldx VCSC_BANKCALL_PTR0 + 1
    rts

__vcsc_generic_bankcall_switch_and_jump:
@call_advance:
    op0C $1FF0
    dex
    bne.same @call_advance
    jmp (VCSC_BANKCALL_PTR0)

__vcsc_generic_bankcall_end:
__vcsc_generic_bankcall_reserved_end = $6060
