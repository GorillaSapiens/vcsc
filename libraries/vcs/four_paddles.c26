// Four Atari CX30-style paddle controllers across both VCS controller ports.
//
// This is the four-channel companion to two_paddles.c26. The public naming is
// deliberately a strict extension of the two-paddle API: position0/1,
// button0/1, valid, init(), sample0/1(), advance_pair(), account_gap(),
// vblank(), overscan(), and dump() keep the same roles, while position2/3,
// button2/3, and sample2/3() add the right-port pair.
//
// All four paddle capacitors are released together when VBLANK.7 is cleared,
// so one elapsed counter is the correct wall-clock for every channel. The
// public positions use the same two-scanline raw units as two_paddles.c26.
// A renderer does not need to branch on all four on one scanline.  When exact
// cross-channel comparability matters, score_latch0123_fixed() captures all
// four INPT bits at one fixed beam phase and the inexpensive commit helpers may
// consume that snapshot later. The built-in blank sampler uses that mechanism
// once per four-scanline group, then advances elapsed by two two-scanline units.
//
// Typical NTSC lifecycle:
//
//   vcs_ntsc_begin_vblank();
//   paddles_vblank();          // 7 four-line cycles = 28 scanlines
//   paddles_account_gap(12);   // account unsampled score/setup span
//   ...
//   // visible renderer: sample0/sample1, then sample2/sample3 on next pair
//   ...
//   vcs_ntsc_begin_overscan();
//   paddles_account_gap(pairs);
//   paddles_overscan();        // one four-line cycle + four buttons
//   ...
//   vcs_ntsc_end_overscan();
//   paddles_dump();
//
// A completed sample is the longest path. Keep each sample on a scanline with
// enough headroom for that path; do not stack multiple completed samples onto
// a beam-critical line merely because the unfinished paths appear to fit.

enum TEMPLATE_constants {
   TEMPLATE_RAW_TIMEOUT := 255,
   TEMPLATE_VBLANK_CYCLES := 7,
   TEMPLATE_OVERSCAN_CYCLES := 1
};

uint8_t TEMPLATE_position0 := 0;
uint8_t TEMPLATE_position1 := 0;
uint8_t TEMPLATE_position2 := 0;
uint8_t TEMPLATE_position3 := 0;
uint8_t TEMPLATE_button0 := 0;
uint8_t TEMPLATE_button1 := 0;
uint8_t TEMPLATE_button2 := 0;
uint8_t TEMPLATE_button3 := 0;
uint8_t TEMPLATE_valid := 0;

// Per-channel active flags use bit 7 (0x80=active, 0=complete). That lets
// beam-critical score renderers AND the active bit with INPTx.7 and clear it
// with STX when they reserve X=0, keeping the completed sample path to 17 cycles.
// complete is refreshed in overscan and is used by the cycle-balanced dump path.
uint8_t TEMPLATE_elapsed := 0;
uint8_t TEMPLATE_active0 := 0;
uint8_t TEMPLATE_active1 := 0;
uint8_t TEMPLATE_active2 := 0;
uint8_t TEMPLATE_active3 := 0;
uint8_t TEMPLATE_complete := 0;
uint8_t TEMPLATE_dumped := 1;
// Fixed-phase score latches.  The three-plus-three score uses 2/3 instead of
// variable-time completion branches inside its RESP1 delay; diagnostic-style
// users may snapshot all four channels together for directly comparable input.
uint8_t TEMPLATE_score_latch0 := 0;
uint8_t TEMPLATE_score_latch1 := 0;
uint8_t TEMPLATE_score_latch2 := 0;
uint8_t TEMPLATE_score_latch3 := 0;
uint8_t TEMPLATE_score_latch_time := 0;

require inline void TEMPLATE_init(void) {
   SWACNT := 0;
   TEMPLATE_position0 := 0;
   TEMPLATE_position1 := 0;
   TEMPLATE_position2 := 0;
   TEMPLATE_position3 := 0;
   TEMPLATE_button0 := 0;
   TEMPLATE_button1 := 0;
   TEMPLATE_button2 := 0;
   TEMPLATE_button3 := 0;
   TEMPLATE_valid := 0;
   TEMPLATE_elapsed := 0;
   TEMPLATE_active0 := 0;
   TEMPLATE_active1 := 0;
   TEMPLATE_active2 := 0;
   TEMPLATE_active3 := 0;
   TEMPLATE_complete := 0;
   TEMPLATE_dumped := 1;
   TEMPLATE_score_latch0 := 0;
   TEMPLATE_score_latch1 := 0;
   TEMPLATE_score_latch2 := 0;
   TEMPLATE_score_latch3 := 0;
   TEMPLATE_score_latch_time := 0;
   VBLANK := 0x82;
}

inline void TEMPLATE_sample0(void) {
   asm lda.z TEMPLATE_active0;
   asm beq.same @not_ready;
   asm bit.z INPT0;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_position0;
   asm lda #0;
   asm sta.z TEMPLATE_active0;
   asm @not_ready:;
}

inline void TEMPLATE_sample1(void) {
   asm lda.z TEMPLATE_active1;
   asm beq.same @not_ready;
   asm bit.z INPT1;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_position1;
   asm lda #0;
   asm sta.z TEMPLATE_active1;
   asm @not_ready:;
}

inline void TEMPLATE_sample2(void) {
   asm lda.z TEMPLATE_active2;
   asm beq.same @not_ready;
   asm bit.z INPT2;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_position2;
   asm lda #0;
   asm sta.z TEMPLATE_active2;
   asm @not_ready:;
}

inline void TEMPLATE_sample3(void) {
   asm lda.z TEMPLATE_active3;
   asm beq.same @not_ready;
   asm bit.z INPT3;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_position3;
   asm lda #0;
   asm sta.z TEMPLATE_active3;
   asm @not_ready:;
}

// Beam-safe score-renderer probes. The caller must reserve X=0 for the
// complete probe. Each helper is at most 17 cycles on the threshold-completion
// path, preserves X=0 and Y, and clobbers A/flags. The ordinary sampleN()
// entry points above remain unconstrained for application renderers.
inline void TEMPLATE_score_sample0(void) {
   asm lda.z TEMPLATE_active0;
   asm and.z INPT0;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_position0;
   asm stx.z TEMPLATE_active0;
   asm @not_ready:;
}

inline void TEMPLATE_score_sample1(void) {
   asm lda.z TEMPLATE_active1;
   asm and.z INPT1;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_position1;
   asm stx.z TEMPLATE_active1;
   asm @not_ready:;
}

inline void TEMPLATE_score_sample2(void) {
   asm lda.z TEMPLATE_active2;
   asm and.z INPT2;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_position2;
   asm stx.z TEMPLATE_active2;
   asm @not_ready:;
}

inline void TEMPLATE_score_sample3(void) {
   asm lda.z TEMPLATE_active3;
   asm and.z INPT3;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_position3;
   asm stx.z TEMPLATE_active3;
   asm @not_ready:;
}

// Thirty fixed cycles. Capture all four analog input bits plus one shared
// timestamp without data-dependent branches.  The snapshot may be committed
// channel-by-channel later, even on different scanlines, without introducing
// a sampling-phase bias between ports.
inline void TEMPLATE_score_latch0123_fixed(void) {
   asm lda.z INPT0;
   asm sta.z TEMPLATE_score_latch0;
   asm lda.z INPT1;
   asm sta.z TEMPLATE_score_latch1;
   asm lda.z INPT2;
   asm sta.z TEMPLATE_score_latch2;
   asm lda.z INPT3;
   asm sta.z TEMPLATE_score_latch3;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_score_latch_time;
}

// A latched-channel commit is at most 19 cycles, preserves X/Y, and clobbers
// A/flags.  Testing active&latch makes stale/high snapshots harmless after a
// channel has already completed.
inline void TEMPLATE_score_commit_latched0(void) {
   asm lda.z TEMPLATE_active0;
   asm and.z TEMPLATE_score_latch0;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_score_latch_time;
   asm sta.z TEMPLATE_position0;
   asm lda #0;
   asm sta.z TEMPLATE_active0;
   asm @not_ready:;
}

inline void TEMPLATE_score_commit_latched1(void) {
   asm lda.z TEMPLATE_active1;
   asm and.z TEMPLATE_score_latch1;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_score_latch_time;
   asm sta.z TEMPLATE_position1;
   asm lda #0;
   asm sta.z TEMPLATE_active1;
   asm @not_ready:;
}

inline void TEMPLATE_score_commit_latched2(void) {
   asm lda.z TEMPLATE_active2;
   asm and.z TEMPLATE_score_latch2;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_score_latch_time;
   asm sta.z TEMPLATE_position2;
   asm lda #0;
   asm sta.z TEMPLATE_active2;
   asm @not_ready:;
}

inline void TEMPLATE_score_commit_latched3(void) {
   asm lda.z TEMPLATE_active3;
   asm and.z TEMPLATE_score_latch3;
   asm bpl.same @not_ready;
   asm lda.z TEMPLATE_score_latch_time;
   asm sta.z TEMPLATE_position3;
   asm lda #0;
   asm sta.z TEMPLATE_active3;
   asm @not_ready:;
}

// Fixed 24-cycle score probe for the right-port pair. It records active&INPT
// state plus the shared timestamp without any data-dependent branches, so a
// renderer may safely substitute it for calibrated horizontal-position delay.
inline void TEMPLATE_score_latch23_fixed(void) {
   asm lda.z TEMPLATE_active2;
   asm and.z INPT2;
   asm sta.z TEMPLATE_score_latch2;
   asm lda.z TEMPLATE_active3;
   asm and.z INPT3;
   asm sta.z TEMPLATE_score_latch3;
   asm lda.z TEMPLATE_elapsed;
   asm sta.z TEMPLATE_score_latch_time;
}

// Commit a fixed-phase latch later in a known slack/blank line. A later direct
// sample must not win over an earlier score threshold, so a latched high value
// always installs the score timestamp and clears that channel's active flag.
inline void TEMPLATE_score_commit_latched23(void) {
   if (TEMPLATE_score_latch2 & 0x80) {
      TEMPLATE_position2 := TEMPLATE_score_latch_time;
      TEMPLATE_active2 := 0;
   }
   if (TEMPLATE_score_latch3 & 0x80) {
      TEMPLATE_position3 := TEMPLATE_score_latch_time;
      TEMPLATE_active3 := 0;
   }
   TEMPLATE_score_latch2 := 0;
   TEMPLATE_score_latch3 := 0;
}

// Score slots advance unconditionally: once all channels complete, elapsed is
// no longer observable until the next measurement anyway. This keeps the
// beam-critical path bounded to 12 cycles including saturation at raw 255.
inline void TEMPLATE_score_advance_pair(void) {
   asm inc.z TEMPLATE_elapsed;
   asm bne.same @done;
   asm dec.z TEMPLATE_elapsed;
   asm @done:;
}

// Add a compile-time scheduled unsampled span while another visible component
// owns the beam. A holds the number of two-scanline pairs. The helper preserves
// X/Y and saturates at 255 in at most 12 cycles, making it safe to place in a
// known blank scanline adjacent to score rendering.
inline void TEMPLATE_score_account_a(void) {
   asm clc;
   asm adc.z TEMPLATE_elapsed;
   asm bcc.same @store;
   asm lda #$ff;
   asm @store:;
   asm sta.z TEMPLATE_elapsed;
}

// The renderer calls this after each two-line pair. Saturating unconditionally
// is both correct and faster than testing four active flags on a beam-critical
// line; once every channel has completed, the elapsed value is irrelevant.
inline void TEMPLATE_advance_pair(void) {
   asm inc.z TEMPLATE_elapsed;
   asm bne.same @done;
   asm dec.z TEMPLATE_elapsed;
   asm @done:;
}

// Four scanlines. Snapshot all four channels together on the first line, then
// commit one channel per line from that shared timestamp. This gives every
// channel exactly the same physical sampling phase instead of merely assigning
// staggered probes the same numeric bucket. After the fourth commit, advance
// by two two-scanline raw units so wall-clock scaling remains unchanged.
static inline void TEMPLATE_sample_blank_cycle(void) {
   TEMPLATE_score_latch0123_fixed();
   TEMPLATE_score_commit_latched0();
   WSYNC := 0;
   TEMPLATE_score_commit_latched1();
   WSYNC := 0;
   TEMPLATE_score_commit_latched2();
   WSYNC := 0;
   TEMPLATE_score_commit_latched3();
   asm lda #2;
   TEMPLATE_score_account_a();
   WSYNC := 0;
}

require inline void TEMPLATE_vblank(void) {
   if (TEMPLATE_dumped) {
      TEMPLATE_elapsed := 0;
      TEMPLATE_active0 := 0x80;
      TEMPLATE_active1 := 0x80;
      TEMPLATE_active2 := 0x80;
      TEMPLATE_active3 := 0x80;
      TEMPLATE_complete := 0;
      TEMPLATE_dumped := 0;
      TEMPLATE_score_latch0 := 0;
      TEMPLATE_score_latch1 := 0;
      TEMPLATE_score_latch2 := 0;
      TEMPLATE_score_latch3 := 0;
      TEMPLATE_score_latch_time := 0;
   }

   for (uint8_t i := TEMPLATE_VBLANK_CYCLES; i; i--) {
      TEMPLATE_sample_blank_cycle();
   }
}

// Advance over an unsampled span. If a channel is already high at the start
// of the span, record the midpoint; otherwise the next explicit sample records
// the end of the gap. 'pairs' is in two-scanline units.
require void TEMPLATE_account_gap(uint8_t pairs) {
   // Positions and active flags are deliberately declared as contiguous four-byte
   // groups above; INPT0..INPT3 are contiguous TIA registers. The dedicated
   // four-player oracle pins that layout because this compact indexed loop relies
   // on it. Walk the four channels with X so this reusable helper exists once rather
   // than expanding the same gap-accounting logic at every call site.
   asm lda.z TEMPLATE_account_gap$pairs;
   asm lsr;
   asm clc;
   asm adc.z TEMPLATE_elapsed;
   asm bcc @midpoint_ok;
   asm lda #$ff;
   asm @midpoint_ok:;
   asm tay;

   asm ldx #0;
   asm @channel:;
   asm lda TEMPLATE_active0,x;
   asm beq @next;
   asm lda INPT0,x;
   asm bpl @next;
   asm tya;
   asm sta TEMPLATE_position0,x;
   asm lda #0;
   asm sta TEMPLATE_active0,x;
   asm @next:;
   asm inx;
   asm cpx #4;
   asm bne @channel;

   asm clc;
   asm lda.z TEMPLATE_elapsed;
   asm adc.z TEMPLATE_account_gap$pairs;
   asm bcc @elapsed_ok;
   asm lda #$ff;
   asm @elapsed_ok:;
   asm sta.z TEMPLATE_elapsed;
}

require inline void TEMPLATE_overscan(void) {
   if (TEMPLATE_active0 || TEMPLATE_active1 || TEMPLATE_active2 || TEMPLATE_active3) {
      for (uint8_t i := TEMPLATE_OVERSCAN_CYCLES; i; i--) {
         TEMPLATE_sample_blank_cycle();
      }
   }

   if (TEMPLATE_elapsed == TEMPLATE_RAW_TIMEOUT) {
      if (TEMPLATE_active0) { TEMPLATE_position0 := TEMPLATE_RAW_TIMEOUT; }
      if (TEMPLATE_active1) { TEMPLATE_position1 := TEMPLATE_RAW_TIMEOUT; }
      if (TEMPLATE_active2) { TEMPLATE_position2 := TEMPLATE_RAW_TIMEOUT; }
      if (TEMPLATE_active3) { TEMPLATE_position3 := TEMPLATE_RAW_TIMEOUT; }
      TEMPLATE_active0 := 0;
      TEMPLATE_active1 := 0;
      TEMPLATE_active2 := 0;
      TEMPLATE_active3 := 0;
   }

   TEMPLATE_button0 := (SWCHA & 0x80) == 0;
   TEMPLATE_button1 := (SWCHA & 0x40) == 0;
   TEMPLATE_button2 := (SWCHA & 0x08) == 0;
   TEMPLATE_button3 := (SWCHA & 0x04) == 0;

   TEMPLATE_complete := !(TEMPLATE_active0 || TEMPLATE_active1 || TEMPLATE_active2 || TEMPLATE_active3);
   if (TEMPLATE_complete) { TEMPLATE_valid := 1; }
}

require inline void TEMPLATE_dump(void) {
   // After scheduler-owned overscan, both paths consume the same cycles so a
   // completed versus spanning four-channel measurement cannot shift VSYNC.
   asm lda.z TEMPLATE_complete;
   asm beq @still_active;
   asm lda #$82;
   asm sta VBLANK;
   asm lda #1;
   asm sta.z TEMPLATE_dumped;
   asm jmp @done;
   asm @still_active:;
   asm lda #$02;
   asm sta VBLANK;
   asm bit.z CXM0P;
   asm nop;
   asm nop;
   asm @done:;
}
