// Shared NTSC frame-scheduling primitives for the Atari 2600 / VCS.
//
// Include vcs.c26 before this file.  The application remains responsible for
// composing display components and for owning the complete frame loop.  This
// file supplies only standard phase constants and small cycle-transparent
// operations; component code must not take ownership of VSYNC, VBLANK, or the
// RIOT interval timer. Blanking callbacks may use WSYNC for bounded internal
// scheduling; every stalled cycle remains part of the shared phase deadline.

enum vcs_ntsc_frame_timing {
   VCS_NTSC_CYCLES_PER_SCANLINE := 76,
   VCS_NTSC_VSYNC_SCANLINES := 3,
   VCS_NTSC_VBLANK_SCANLINES := 37,
   VCS_NTSC_VISIBLE_SCANLINES := 192,
   VCS_NTSC_OVERSCAN_SCANLINES := 30,
   VCS_NTSC_FRAME_SCANLINES := 262
};

// Wait for exactly scanlines WSYNC boundaries. A zero count is a no-op.
// The compiler-generated loop performs ordinary bookkeeping after the final
// WSYNC, so its return phase is not suitable for entering a cycle-counted
// visible component. Use vcs_ntsc_wait_component_scanlines() for a blank gap
// immediately followed by such a component.
inline void vcs_ntsc_wait_scanlines(uint8_t scanlines) {
   while (scanlines) {
      WSYNC := 0;
      scanlines--;
   }
}

// Draw a blank visible tail and return at the established phase used before
// entering overscan.  Unlike vcs_ntsc_wait_scanlines(), this helper has a
// phase contract: compact uint8_t lowering removed nineteen cycles of generic
// loop-exit bookkeeping, so the calibrated tail makes those cycles explicit.
// Use this only for the final visible blank gap immediately before
// vcs_ntsc_begin_overscan().
inline void vcs_ntsc_wait_visible_tail_scanlines(uint8_t scanlines) {
   while (scanlines) {
      WSYNC := 0;
      scanlines--;
   }

   asm ldy #3;
   asm @return_delay:;
   asm dey;
   asm bne.same @return_delay;
   // Keep this return phase independent of whether compiler-owned byte locals
   // use zero-page or absolute addressing.
   asm nop;
   asm bit.z $00;
}

// Draw a blank visible gap and enter the following component at the same
// measured phase as the first component after vcs_ntsc_end_vblank(). The
// count must be at least two. The controlled tail completes the final blank
// scanline without spending another WSYNC boundary.
inline void vcs_ntsc_wait_component_scanlines(uint8_t scanlines) {
   scanlines--;
   while (scanlines) {
      WSYNC := 0;
      scanlines--;
   }

   // Compact uint8_t lowering leaves the final WSYNC loop 19 cycles earlier
   // than the historical generic lowering used when this helper was first
   // calibrated.  Make that phase compensation explicit here: the 56-cycle
   // delay loop, three NOPs, and mapper-safe three-cycle base-TIA read
   // complete a 65-cycle tail. The third NOP compensates for allowing the
   // assembler to relax compiler-owned byte locals into zero page, preserving
   // the documented cycle-3 component entry.
   asm ldy #11;
   asm @delay:;
   asm dey;
   asm bne.same @delay;
   asm nop;
   asm nop;
   // Keep this return phase independent of whether compiler-owned byte locals
   // use zero-page or absolute addressing.
   asm nop;
   asm bit.z $00;
}

// The scheduler enters the first visible component at the measured cycle-3
// phase produced by clearing VBLANK. A component returns at cycle zero after
// its final WSYNC. Insert this bridge between adjacent visible components so
// every component sees the same entry phase without spending another line.
inline void vcs_ntsc_component_handoff(void) {
   asm bit.z $00;
}

// Generate an exact three-scanline NTSC vertical-sync pulse.  First align to
// a scanline boundary, then assert and clear VSYNC at the same cycle phase
// exactly three WSYNC boundaries apart (3 * 76 = 228 CPU cycles).  Keeping the
// two VSYNC assignments symmetric also makes the pulse width independent of
// the caller's entry phase and compiler addressing-mode relaxation.
inline void vcs_ntsc_vsync(void) {
   // The leading WSYNC fixes the scanline phase.  The dead-flags BIT read uses raw TIA $00 rather than the canonical
   // CXM0P=$30 alias, because $30-$3F are WD read selectors. It remains a
   // side-effect-free three-cycle delay; compiler literal reload then places
   // the VSYNC assertion at the historical cycle-8 phase. Repeat that delay
   // before clearing VSYNC so the two edges stay exactly 228 cycles apart.
   WSYNC := 2;
   asm bit.z $00;
   VSYNC := 2;
   WSYNC := 0;
   WSYNC := 0;
   WSYNC := 0;
   asm bit.z $00;
   VSYNC := 0;
}

// TIM64T preload values chosen so the scheduler can spend most of each blank
// phase in component callbacks, then wait for the unused remainder and use one
// final WSYNC to enter the next phase on a scanline boundary.  Exact cycle
// calibration and deliberate-overrun coverage live in the frame-scheduler
// emulator regressions.
// A renderer that must do beam-independent positioning during VBLANK can ask
// for a heavier VBLANK/lighter overscan split.  The two preloads still sum to
// the same 76 TIM64T quanta, so the calibrated total blank-frame budget is
// unchanged; only which blank phase owns those quanta changes.  This split is
// scanline-phase calibrated, not just sum-of-cycles calibrated: the asymmetric
// renderer can preload two X=0/Y=95 sprites after its worst persistent-priority
// schedule and still reach the VBLANK deadline.  Smaller VBLANK shares can let
// that scene settle at 265 lines in Stella 7.0 even though overscan has ample
// spare time.
#ifdef VCS_NTSC_EXTENDED_VBLANK
enum vcs_ntsc_deadline_timing {
   VCS_NTSC_VBLANK_TIM64T := 63,
   VCS_NTSC_OVERSCAN_TIM64T := 13
};
#else
enum vcs_ntsc_deadline_timing {
   VCS_NTSC_VBLANK_TIM64T := 42,
   VCS_NTSC_OVERSCAN_TIM64T := 34
};
#endif

#ifdef VCS_NTSC_DIAGNOSTICS
// Optional sticky diagnostics.  Define the object-like alias
// VCS_NTSC_DIAGNOSTICS before including this file to pay for these flags.
// Production builds omit both diagnostic RAM bytes and all flag-setting code.
enum vcs_ntsc_overrun_flag_t {
   VCS_NTSC_VBLANK_OVERRUN := 1,
   VCS_NTSC_OVERSCAN_OVERRUN := 2
};

static uint8_t vcs_ntsc_overrun_flags := 0;
static uint8_t vcs_ntsc_overrun_phase := 0;
#endif

// Wait for a scheduler-owned TIM64T deadline.  This is intentionally private:
// callers must use the phase end operations so they cannot omit the final
// WSYNC/VBLANK transition.  Reading INTIM clears the RIOT timer flag, so each
// iteration samples TIMINT first.  A timer underflow racing between those two
// reads is still detected because every valid preload is below $80 whereas the
// post-underflow INTIM value begins at $ff and therefore has bit 7 set.
//
// Missing a deadline cannot be repaired generically.  Production behavior is
// therefore simply to stop waiting, align at the next WSYNC, and continue with
// one long frame.  Optional diagnostics record which phase overran.
#ifdef VCS_NTSC_DIAGNOSTICS
// Diagnostic builds add one phase byte and a short sticky-flag tail.  The
// polling path remains hand-written so enabling diagnostics does not turn the
// deadline loop into compiler-generated workspace and status plumbing.
static void vcs_ntsc_finish_deadline(void) {
   asm @wait:
   asm lda TIMINT
   asm bmi @overrun
   asm lda INTIM
   asm bmi @overrun
   asm beq @done
   asm bne @wait
   asm @overrun:
   asm lda vcs_ntsc_overrun_flags
   asm ora vcs_ntsc_overrun_phase
   asm sta vcs_ntsc_overrun_flags
   // The phase transition consumes A directly.  The normal path reaches
   // @done with A == 0 from INTIM; normalize only the overrun tail.
   asm lda #0
   asm @done:
}
#else
// Keep the mandatory production path compact: one shared polling subroutine,
// no result construction, and no RAM workspace.  Inline assembly is used here
// only to express the RIOT polling loop exactly; it remains an optimizer barrier.
static void vcs_ntsc_finish_deadline(void) {
   asm @wait:
   asm lda TIMINT
   asm bmi @timint_overrun
   // X is caller-clobbered.  Reading INTIM into X preserves the zero already
   // in A, including the race where INTIM underflows between the TIMINT and
   // INTIM reads.
   asm ldx INTIM
   asm bmi @done
   asm bne @wait
   asm @done:
   asm rts
   // TIMINT is exactly $80 when asserted; one-byte ASL normalizes it to zero.
   // This path is already an overrun, so its extra two cycles are irrelevant to
   // the normal deadline phase.
   asm @timint_overrun:
   asm asl
}
#endif

// Begin the shared 37-scanline VBLANK budget. Component vblank callbacks run
// after this operation. They may use WSYNC internally, but must not write
// VBLANK, start/read the RIOT timer, wait for expiry, or perform the final phase
// transition; all their cycles and WSYNC stalls consume this shared deadline.
inline void vcs_ntsc_begin_vblank(void) {
   // Exact VSYNC now clears at cycle 8 instead of the historical padded clear
   // at cycle 21. Keep those thirteen compensation cycles out of the asserted
   // pulse: restore the old callback entry phase only after VSYNC is low.
   asm bit.z $00;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   VBLANK := 2;
   TIM64T := VCS_NTSC_VBLANK_TIM64T`uint8_t;
}

// Wait only for the unused VBLANK budget, align the visible phase, and clear
// VBLANK.  If callbacks missed the deadline, continue at the next scanline
// boundary; optional diagnostics record the overrun.
inline void vcs_ntsc_end_vblank(void) {
#ifdef VCS_NTSC_DIAGNOSTICS
   vcs_ntsc_overrun_phase := VCS_NTSC_VBLANK_OVERRUN`uint8_t;
#endif
   vcs_ntsc_finish_deadline();
   // finish_deadline guarantees A == 0.  Store it directly: materializing
   // another zero here can cross the scanline boundary when the RIOT poll
   // returns late in a line, turning one frame into 263 scanlines.
   asm sta WSYNC
   asm sta VBLANK
}

// Begin the shared 30-scanline overscan budget. Component overscan callbacks
// may use WSYNC internally, but must not write VBLANK, start/read the RIOT
// timer, wait for expiry, or perform the final phase transition; all their
// cycles and WSYNC stalls consume this shared deadline.
inline void vcs_ntsc_begin_overscan(void) {
   VBLANK := 2;
   TIM64T := VCS_NTSC_OVERSCAN_TIM64T`uint8_t;
}

// Wait only for the unused overscan budget and align the following VSYNC phase.
// VBLANK remains asserted across overscan and VSYNC. Stella's TIA frame
// accounting needs three blanked frame-boundary WSYNCs around this transition.
// Two remain here after the timer-owned overscan budget; the leading alignment
// WSYNC in the next exact VSYNC pulse supplies the third. Keep the compensation
// after all game work and visible drawing so it cannot perturb component raster
// timing. The CPU-only scheduler regression therefore still expects 264 raw
// harness lines for Stella's authoritative 262-line / 60.0 Hz result.
// If callbacks missed the deadline, continue at the next scanline boundary;
// optional diagnostics record the overrun.
inline void vcs_ntsc_end_overscan(void) {
#ifdef VCS_NTSC_DIAGNOSTICS
   vcs_ntsc_overrun_phase := VCS_NTSC_OVERSCAN_OVERRUN`uint8_t;
#endif
   vcs_ntsc_finish_deadline();
   WSYNC := 0;
   WSYNC := 0;
}
