// Shared NTSC frame-scheduling primitives for the Atari 2600 / VCS.
//
// Include vcs.c26 before this file.  The application remains responsible for
// composing display components and for owning the complete frame loop.  This
// file supplies only standard phase constants and small cycle-transparent
// operations; component code must not take ownership of VSYNC, VBLANK, WSYNC,
// or the RIOT interval timer.

enum vcs_ntsc_frame_timing {
   VCS_NTSC_CYCLES_PER_SCANLINE := 76,
   VCS_NTSC_VSYNC_SCANLINES := 3,
   VCS_NTSC_VBLANK_SCANLINES := 37,
   VCS_NTSC_VISIBLE_SCANLINES := 192,
   VCS_NTSC_OVERSCAN_SCANLINES := 30,
   VCS_NTSC_FRAME_SCANLINES := 262
};

// Wait for exactly scanlines WSYNC boundaries.  A zero count is a no-op.
inline void vcs_ntsc_wait_scanlines(uint8_t scanlines) {
   while (scanlines) {
      WSYNC := 0;
      scanlines--;
   }
}

// Generate the standard three-scanline NTSC vertical-sync pulse.  The caller
// enters at an arbitrary cycle and leaves immediately after clearing VSYNC;
// the following phase helper will own alignment of the first VBLANK line.
inline void vcs_ntsc_vsync(void) {
   VSYNC := 2;
   vcs_ntsc_wait_scanlines(VCS_NTSC_VSYNC_SCANLINES`uint8_t);
   VSYNC := 0;
}

// TIM64T preload values chosen so the scheduler can spend most of each blank
// phase in component callbacks, then wait for the unused remainder and use one
// final WSYNC to enter the next phase on a scanline boundary.  Exact cycle
// calibration and deliberate-overrun coverage live in the frame-scheduler
// emulator regressions.
enum vcs_ntsc_deadline_timing {
   VCS_NTSC_VBLANK_TIM64T := 42,
   VCS_NTSC_OVERSCAN_TIM64T := 34
};

#ifdef VCS_NTSC_DIAGNOSTICS
// Optional sticky diagnostics.  Define the object-like alias
// VCS_NTSC_DIAGNOSTICS before including this file to pay for these flags.
// Production builds omit both diagnostic RAM bytes and all flag-setting code.
enum vcs_ntsc_overrun_flag_t {
   VCS_NTSC_VBLANK_OVERRUN := 1,
   VCS_NTSC_OVERSCAN_OVERRUN := 2
};

static uint8_t vcs_ntsc_overrun_flags := 0;
static uint8_t vcs_ntsc_overrun_phase := 0;
#endif

// Wait for a scheduler-owned TIM64T deadline.  This is intentionally private:
// callers must use the phase end operations so they cannot omit the final
// WSYNC/VBLANK transition.  Reading INTIM clears the RIOT timer flag, so each
// iteration samples TIMINT first.  A timer underflow racing between those two
// reads is still detected because every valid preload is below $80 whereas the
// post-underflow INTIM value begins at $ff and therefore has bit 7 set.
//
// Missing a deadline cannot be repaired generically.  Production behavior is
// therefore simply to stop waiting, align at the next WSYNC, and continue with
// one long frame.  Optional diagnostics record which phase overran.
#ifdef VCS_NTSC_DIAGNOSTICS
// Diagnostic builds add one phase byte and a short sticky-flag tail.  The
// polling path remains hand-written so enabling diagnostics does not turn the
// deadline loop into compiler-generated workspace and status plumbing.
static void vcs_ntsc_finish_deadline(void) {
   asm @wait:
   asm lda TIMINT
   asm bmi @overrun
   asm lda INTIM
   asm bmi @overrun
   asm beq @done
   asm bne @wait
   asm @overrun:
   asm lda vcs_ntsc_overrun_flags
   asm ora vcs_ntsc_overrun_phase
   asm sta vcs_ntsc_overrun_flags
   asm @done:
}
#else
// Keep the mandatory production path compact: one shared 13-byte subroutine,
// no result construction, and no RAM workspace.  Inline assembly is used here
// only to express the RIOT polling loop exactly; it remains an optimizer barrier.
static void vcs_ntsc_finish_deadline(void) {
   asm @wait:
   asm lda TIMINT
   asm bmi @done
   asm lda INTIM
   asm bmi @done
   asm bne @wait
   asm @done:
}
#endif

// Begin the shared 37-scanline VBLANK budget.  Component vblank callbacks run
// after this operation and must not touch VBLANK, WSYNC, or RIOT timer state.
inline void vcs_ntsc_begin_vblank(void) {
   VBLANK := 2;
   TIM64T := VCS_NTSC_VBLANK_TIM64T`uint8_t;
}

// Wait only for the unused VBLANK budget, align the visible phase, and clear
// VBLANK.  If callbacks missed the deadline, continue at the next scanline
// boundary; optional diagnostics record the overrun.
inline void vcs_ntsc_end_vblank(void) {
#ifdef VCS_NTSC_DIAGNOSTICS
   vcs_ntsc_overrun_phase := VCS_NTSC_VBLANK_OVERRUN`uint8_t;
#endif
   vcs_ntsc_finish_deadline();
   WSYNC := 0;
   VBLANK := 0;
}

// Begin the shared 30-scanline overscan budget.  Component overscan callbacks
// run after this operation and must not touch VBLANK, WSYNC, or RIOT timer
// state.
inline void vcs_ntsc_begin_overscan(void) {
   VBLANK := 2;
   TIM64T := VCS_NTSC_OVERSCAN_TIM64T`uint8_t;
}

// Wait only for the unused overscan budget and align the following VSYNC phase.
// VBLANK remains asserted across overscan and VSYNC.  If callbacks missed the
// deadline, continue at the next scanline boundary; optional diagnostics record
// the overrun.
inline void vcs_ntsc_end_overscan(void) {
#ifdef VCS_NTSC_DIAGNOSTICS
   vcs_ntsc_overrun_phase := VCS_NTSC_OVERSCAN_OVERRUN`uint8_t;
#endif
   vcs_ntsc_finish_deadline();
   WSYNC := 0;
}
