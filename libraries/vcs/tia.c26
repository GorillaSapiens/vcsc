// Atari 2600 / VCS TIA register bindings.
//
// This file assumes the target has already defined the core 6502-sized types
// such as `int8_t`, `int16_t`, `int24_t`, and pointers. `vcs.c26` provides those for the
// stock target; isolated compiler tests may provide their own fixture machine.
//
// Canonical register addresses use the usual TIA base page locations. The TIA
// is heavily mirrored in the VCS address space, but these are the conventional
// symbolic addresses to use in source.

// write-only TIA registers ($00-$2C)
uint8_t VSYNC @[none/0x00];
uint8_t VBLANK@[none/0x01];
uint8_t WSYNC @[none/0x02];
uint8_t RSYNC @[none/0x03];
uint8_t NUSIZ0@[none/0x04];
uint8_t NUSIZ1@[none/0x05];
uint8_t COLUP0@[none/0x06];
uint8_t COLUP1@[none/0x07];
uint8_t COLUPF@[none/0x08];
uint8_t COLUBK@[none/0x09];
uint8_t CTRLPF@[none/0x0A];
uint8_t REFP0 @[none/0x0B];
uint8_t REFP1 @[none/0x0C];
uint8_t PF0   @[none/0x0D];
uint8_t PF1   @[none/0x0E];
uint8_t PF2   @[none/0x0F];
uint8_t RESP0 @[none/0x10];
uint8_t RESP1 @[none/0x11];
uint8_t RESM0 @[none/0x12];
uint8_t RESM1 @[none/0x13];
uint8_t RESBL @[none/0x14];
uint8_t AUDC0 @[none/0x15];
uint8_t AUDC1 @[none/0x16];
uint8_t AUDF0 @[none/0x17];
uint8_t AUDF1 @[none/0x18];
uint8_t AUDV0 @[none/0x19];
uint8_t AUDV1 @[none/0x1A];
uint8_t GRP0  @[none/0x1B];
uint8_t GRP1  @[none/0x1C];
uint8_t ENAM0 @[none/0x1D];
uint8_t ENAM1 @[none/0x1E];
uint8_t ENABL @[none/0x1F];
uint8_t HMP0  @[none/0x20];
uint8_t HMP1  @[none/0x21];
uint8_t HMM0  @[none/0x22];
uint8_t HMM1  @[none/0x23];
uint8_t HMBL  @[none/0x24];
uint8_t VDELP0@[none/0x25];
uint8_t VDELP1@[none/0x26];
uint8_t VDELBL@[none/0x27];
uint8_t RESMP0@[none/0x28];
uint8_t RESMP1@[none/0x29];
uint8_t HMOVE @[none/0x2A];
uint8_t HMCLR @[none/0x2B];
uint8_t CXCLR @[none/0x2C];

// read-only TIA registers ($30-$3D)
uint8_t CXM0P @[0x30/none];
uint8_t CXM1P @[0x31/none];
uint8_t CXP0FB@[0x32/none];
uint8_t CXP1FB@[0x33/none];
uint8_t CXM0FB@[0x34/none];
uint8_t CXM1FB@[0x35/none];
uint8_t CXBLPF@[0x36/none];
uint8_t CXPPMM@[0x37/none];
uint8_t INPT0 @[0x38/none];
uint8_t INPT1 @[0x39/none];
uint8_t INPT2 @[0x3A/none];
uint8_t INPT3 @[0x3B/none];
uint8_t INPT4 @[0x3C/none];
uint8_t INPT5 @[0x3D/none];
