// Shared directly-instantiated 50 Hz frame scheduler core.
//
// Do not include this file directly from an application. Public PAL and SECAM
// front ends instantiate it with their own prefixes and measured constants.
// The common scheduler owns only VSYNC/VBLANK and the RIOT interval timer;
// visible components retain their ordinary cycle-3 entry / cycle-0 return
// contracts and must not take ownership of those frame-level resources.

parameter vblank_tim64t;
parameter overscan_tim64t;
parameter diagnostics := 0;

inline void TEMPLATE_wait_scanlines(uint8_t scanlines) {
   while (scanlines) {
      WSYNC := 0;
      scanlines--;
   }
}

inline void TEMPLATE_wait_visible_tail_scanlines(uint8_t scanlines) {
   while (scanlines) {
      WSYNC := 0;
      scanlines--;
   }

   asm ldy #3;
   asm @return_delay:;
   asm dey;
   asm bne.same @return_delay;
   asm nop;
   asm bit.z $00;
}

inline void TEMPLATE_wait_component_scanlines(uint8_t scanlines) {
   scanlines--;
   while (scanlines) {
      WSYNC := 0;
      scanlines--;
   }

   asm ldy #11;
   asm @delay:;
   asm dey;
   asm bne.same @delay;
   asm nop;
   asm nop;
   asm nop;
   asm bit.z $00;
}

inline void TEMPLATE_component_handoff(void) {
   asm bit.z $00;
}

// A full-height cycle-counted visible component returns at cycle zero of the
// line after its final visible WSYNC.  The generic 228-line wait path reaches
// begin_overscan() sixteen cycles later because of loop-exit bookkeeping.
// Normalize the component path to that same established phase so the shared
// overscan TIM64T deadline retains its calibrated 312-line frame.
inline void TEMPLATE_component_to_overscan_handoff(void) {
   asm ldy #3;
   asm @visible_to_overscan_delay:;
   asm dey;
   asm bne.same @visible_to_overscan_delay;
}

inline void TEMPLATE_vsync(void) {
   // The leading WSYNC fixes the scanline phase. A side-effect-free three-cycle
   // BIT delay plus compiler literal reload places both VSYNC stores at cycle 8,
   // exactly 228 CPU cycles apart.
   WSYNC := 2;
   asm bit.z $00;
   VSYNC := 2;
   WSYNC := 0;
   WSYNC := 0;
   WSYNC := 0;
   asm bit.z $00;
   VSYNC := 0;
}

#if TEMPLATE_diagnostics
static uint8_t TEMPLATE_overrun_flags := 0;
static uint8_t TEMPLATE_overrun_phase := 0;

static void TEMPLATE_finish_deadline(void) {
   asm @wait:
   asm lda TIMINT
   asm bmi @overrun
   asm lda INTIM
   asm bmi @overrun
   asm beq @done
   asm bne @wait
   asm @overrun:
   asm lda TEMPLATE_overrun_flags
   asm ora TEMPLATE_overrun_phase
   asm sta TEMPLATE_overrun_flags
   // Normal completion already has A == 0 from INTIM.  Normalize only the
   // overrun tail so the phase transition can consume A directly.
   asm lda #0
   asm @done:
}
#else
static void TEMPLATE_finish_deadline(void) {
   asm @wait:
   asm lda TIMINT
   asm bmi @timint_overrun
   // Preserve A==0 across the INTIM read.  X is caller-clobbered.
   asm ldx INTIM
   asm bmi @done
   asm bne @wait
   asm @done:
   asm rts
   // An asserted TIMINT read is $80, so ASL yields the required zero.
   asm @timint_overrun:
   asm asl
}
#endif

inline void TEMPLATE_begin_vblank(void) {
   // Keep the exact pulse exact; restore the historical callback phase only
   // after VSYNC is low (3 + 5*2 = 13 cycles).
   asm bit.z $00;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   VBLANK := 2;
   TIM64T := TEMPLATE_vblank_tim64t`uint8_t;
}

inline void TEMPLATE_end_vblank(void) {
#if TEMPLATE_diagnostics
   TEMPLATE_overrun_phase := 1;
#endif
   TEMPLATE_finish_deadline();
   // Do not materialize zero between the timer poll and WSYNC: if the poll
   // returns near the end of a scanline, that load can push WSYNC onto the
   // following line and lengthen the frame.
   asm sta WSYNC
   asm sta VBLANK
}

inline void TEMPLATE_begin_overscan(void) {
   VBLANK := 2;
   TIM64T := TEMPLATE_overscan_tim64t`uint8_t;
}

inline void TEMPLATE_end_overscan(void) {
#if TEMPLATE_diagnostics
   TEMPLATE_overrun_phase := 2;
#endif
   TEMPLATE_finish_deadline();
   // Two post-deadline accounting boundaries remain here; the next frame's
   // leading alignment WSYNC is the adjacent frame boundary. This keeps the
   // exact three-line pulse from lengthening the 312-line PAL/SECAM display.
   WSYNC := 0;
   WSYNC := 0;
}
