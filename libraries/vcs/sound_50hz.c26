// Shared PAL50 / SECAM50 TIA music constants.
//
// TIA AUDC/AUDF/AUDV register semantics are common across console timings.
// The physical audio clock follows the console master timing, so the same AUDF
// value is pitched slightly differently on NTSC, PAL, and SECAM hardware.  For
// the small lead-note set used by VCSC, the closest integer AUDC=12 divider
// remains the same on all three timings; only the frame-duration aliases differ.
//
// Include sound_pal.c26 or sound_secam.c26 from applications instead of
// including this shared file directly.

alias MUSIC_CONTROL_BUZZY      1
alias MUSIC_CONTROL_SQUARE     4
alias MUSIC_CONTROL_BASS       6
alias MUSIC_CONTROL_PITFALL    7
alias MUSIC_CONTROL_NOISE      8
alias MUSIC_CONTROL_LEAD      12
alias MUSIC_CONTROL_LOW_BASS  14
alias MUSIC_CONTROL_SYNTH     15

alias MUSIC_FREQ_C4          19
alias MUSIC_FREQ_C_SHARP4    18
alias MUSIC_FREQ_D4          17
alias MUSIC_FREQ_E4          15
alias MUSIC_FREQ_F4          14
alias MUSIC_FREQ_F_SHARP4    13
alias MUSIC_FREQ_G4          12
alias MUSIC_FREQ_A4          11

alias MUSIC_VOLUME_OFF        0
alias MUSIC_VOLUME_SOFT       6
alias MUSIC_VOLUME_MEDIUM     8
alias MUSIC_VOLUME_LOUD      12
alias MUSIC_VOLUME_MAX       15

// music_tick() advances when counter > timing.  At 50 frames/second these
// aliases therefore represent 2, 12, 25, and 50 frames.  The eighth-note
// duration is rounded to 12 frames (0.24 s); quarter and half remain exactly
// 0.5 s and 1.0 s.
alias MUSIC_TIME_GAP           1
alias MUSIC_TIME_EIGHTH       11
alias MUSIC_TIME_QUARTER      24
alias MUSIC_TIME_HALF         49
