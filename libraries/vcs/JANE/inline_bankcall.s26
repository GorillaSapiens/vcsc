;
; JANE inline-target cross-bank JSR/RTS trampoline.
;
; JANE's four selectors are irregular: logical/physical banks 0,1,2,3 use
; $1FF0,$1FF1,$1FF8,$1FF9.  VCSC logical bank ORGs descend from $Fxxx, so
; EOR #7 converts PC[15:13] into logical bank 0..3.  Banks 0/1 already equal
; their selector offsets; adding six maps banks 2/3 to offsets 8/9, allowing the actual
; selector access to be the compact indexed store STA $1FF0,Y without embedding
; any template-origin-dependent table address.
;
; This is the maintained source for JANE's fixed $inline_bankcall block.
; linker/gen_inline_bankcall_template.pl assembles it at build time; vcsc-ld
; patches only the runtime-selected zero-page scratch address, selector base,
; and internal JSR target before replicating the block into every bank.
;
; The source is assembled at an arbitrary template origin ($6000).  The logical
; bank origins used by the linked cartridge are unrelated to that build-time
; origin.

.ifndef VCSC_BANKCALL_PTR0
VCSC_BANKCALL_PTR0 = $0080
.endif
.ifndef VCSC_BANKCALL_SELECTOR_BASE
VCSC_BANKCALL_SELECTOR_BASE = $1F20
.endif

.segmentdef "CODE", $6000, $0100
.segment "CODE"

.export __vcsc_generic_bankcall_begin
.export __vcsc_generic_bankreturn
.export __vcsc_generic_bankcall_switch_and_jump
.export __vcsc_generic_bankcall_end
.export __vcsc_generic_bankcall_reserved_end

; __bankcall
;
; The caller emitted:
;
;     JSR __bankcall
;     .word logical_target
;
; JSR left the real 16-bit logical return PC on the hardware stack.  Copy that
; PC into ptr0, read the following inline target before leaving the source bank,
; and advance the saved return PC by three so the final RTS skips the inline target and descriptor.
; (ptr0),Y performs ordinary 16-bit page carry when the inline payload straddles a
; page boundary.
__vcsc_generic_bankcall_begin:
    tsx
    lda $0101,x
    sta VCSC_BANKCALL_PTR0
    lda $0102,x
    sta VCSC_BANKCALL_PTR0 + 1
    ldy #1
    lda (VCSC_BANKCALL_PTR0),y
    pha
    iny
    lda (VCSC_BANKCALL_PTR0),y
    sta VCSC_BANKCALL_PTR0 + 1
    pla
    sta VCSC_BANKCALL_PTR0

    lda $0101,x
    clc
    adc #3
    sta $0101,x
    bcc.same @return_adjusted
    inc $0102,x
@return_adjusted:

    ; This JSR creates the synthetic return frame.  The remote callee's RTS
    ; lands immediately below in __vcsc_generic_bankreturn.
    jsr __vcsc_generic_bankcall_switch_and_jump

; __bankreturn
;
; Preserve the A:X result.  Convert the original caller return PC into logical
; bank 0..3, map that to JANE's selector offset, restore the source
; bank, then return through the original caller frame.
__vcsc_generic_bankreturn:
    pha
    txa
    pha
    tsx
    lda $0104,x
    lsr
    lsr
    lsr
    lsr
    lsr
    eor #7
    cmp #2
    bcc.same @return_selector_ready
    adc #5
@return_selector_ready:
    tay
    lda #0
    sta VCSC_BANKCALL_SELECTOR_BASE,y
    pla
    tax
    pla
    rts

; Select the destination from the inline target's logical high bits, then jump
; through ptr0.  The selector access and this code are replicated at identical
; CPU addresses in every JANE bank, so execution continues safely after STA
; changes the mapped physical bank.
__vcsc_generic_bankcall_switch_and_jump:
    lda VCSC_BANKCALL_PTR0 + 1
    lsr
    lsr
    lsr
    lsr
    lsr
    eor #7
    cmp #2
    bcc.same @target_selector_ready
    adc #5
@target_selector_ready:
    tay
    lda #0
    sta VCSC_BANKCALL_SELECTOR_BASE,y
    jmp (VCSC_BANKCALL_PTR0)

__vcsc_generic_bankcall_end:
__vcsc_generic_bankcall_reserved_end = $6060
