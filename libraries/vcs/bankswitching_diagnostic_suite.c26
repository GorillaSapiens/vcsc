// F8/F6/F4 bank-transition diagnostic suite.
//
// Build this source once per SOURCE_BANK for JSR/RTS coverage from that bank,
// and once per SOURCE_BANK/JUMP_DEST pair for direct one-way JMP coverage.
// Each completed transition writes and verifies RIOT-RAM signatures and stack
// state, shows a transition-colored PASS/FAIL glyph for one frame, and ends on
// a stable all-pass or fail frame suitable for Stella snapshot testing.

include "vcs.c26"

#ifndef MAPPER_BANKS
MAPPER_BANKS_must_be_2_4_or_8
#endif
#ifndef SOURCE_BANK
SOURCE_BANK_must_select_a_bank
#endif
#ifndef JUMP_DEST
JUMP_DEST_must_select_a_bank
#endif

mem bank0 { $start:0xF000 $size:0x0F00 $ro };
#if MAPPER_BANKS > 1
mem bank1 { $start:0xD000 $size:0x0F00 $ro };
#endif
#if MAPPER_BANKS > 2
mem bank2 { $start:0xB000 $size:0x0F00 $ro };
mem bank3 { $start:0x9000 $size:0x0F00 $ro };
#endif
#if MAPPER_BANKS > 4
mem bank4 { $start:0x7000 $size:0x0F00 $ro };
mem bank5 { $start:0x5000 $size:0x0F00 $ro };
mem bank6 { $start:0x3000 $size:0x0F00 $ro };
mem bank7 { $start:0x1000 $size:0x0F00 $ro };
#endif

uint8_t failure;
uint8_t signature;
uint8_t source_seen;
uint8_t transition_count;
uint8_t status_color;
uint8_t stack_before;
uint8_t stack_after;

bank0 const uint8_t pass_glyph[8] := {
   0b.XXXXX..,
   0b.XX..XX.,
   0b.XX..XX.,
   0b.XXXXX..,
   0b.XX.....,
   0b.XX.....,
   0b.XX.....,
   0b........
};

bank0 const uint8_t fail_glyph[8] := {
   0b.XX..XX.,
   0b..XXXX..,
   0b...XX...,
   0b...XX...,
   0b...XX...,
   0b..XXXX..,
   0b.XX..XX.,
   0b........
};

bank0 void draw_status_frame(void) {
   asm lda failure;
   asm beq @pass_colors;
   asm lda #$46;
   asm sta COLUP0;
   asm lda #$20;
   asm jmp @colors_done;
   asm @pass_colors:;
   asm lda #$c8;
   asm sta COLUP0;
   asm lda status_color;
   asm @colors_done:;
   asm sta COLUBK;
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta REFP0;
   asm sta VDELP0;
   asm sta RESMP0;
   asm sta HMP0;
   asm sta CTRLPF;
   asm sta HMCLR;
   asm lda #5;
   asm sta NUSIZ0;

   asm lda #2;
   asm sta VSYNC;
   asm ldx #3;
   asm @vsync_loop:;
   asm sta WSYNC;
   asm dex;
   asm bne @vsync_loop;

   asm lda #0;
   asm sta VSYNC;
   asm lda #2;
   asm sta VBLANK;
   asm ldx #37;
   asm @vblank_loop:;
   asm sta WSYNC;
   asm dex;
   asm bne @vblank_loop;

   asm lda #0;
   asm sta VBLANK;
   asm ldx #76;
   asm @visible_top:;
   asm sta WSYNC;
   asm dex;
   asm bne @visible_top;

   asm sta WSYNC;
   asm ldx #20;
   asm @position_delay:;
   asm dex;
   asm bne @position_delay;
   asm sta RESP0;

   asm ldx #7;
   asm @glyph_loop:;
   asm lda failure;
   asm beq @pass_row;
   asm lda fail_glyph,x;
   asm jmp @row_ready;
   asm @pass_row:;
   asm lda pass_glyph,x;
   asm @row_ready:;
   asm sta GRP0;
   asm sta WSYNC;
   asm sta WSYNC;
   asm dex;
   asm bpl @glyph_loop;

   asm lda #0;
   asm sta GRP0;
   asm ldx #99;
   asm @visible_bottom:;
   asm sta WSYNC;
   asm dex;
   asm bne @visible_bottom;

   asm lda #2;
   asm sta VBLANK;
   asm lda #0;
   asm ldx #30;
   asm @overscan_loop:;
   asm sta WSYNC;
   asm dex;
   asm bne @overscan_loop;
}

bank0 void finish_jump(void) {
   asm tsx;
   asm stx stack_after;
   if (signature != 0x80 + JUMP_DEST || stack_before != stack_after) {
      failure := 0xE0 + JUMP_DEST;
   }
   if (source_seen != SOURCE_BANK || transition_count != MAPPER_BANKS + 1) {
      failure := 0xFE;
   }
   status_color := 0xC4;
#ifdef SIMULATOR_TEST
   asm jmp simulator_done;
#else
   while (1) {
      draw_status_frame();
   }
#endif
}

#ifdef SIMULATOR_TEST
bank0 void simulator_done(void) {
   while (1) {
   }
}
#endif

bank1 void nested_leaf1(void) {
   signature := 0xA1;
}

bank0 void call_target0(void) {
   // Every source build reaches this target.  The additional BANK0 -> BANK1
   // call makes source -> target0 -> nested_leaf1 a genuine nested path when
   // the source itself is in another bank, and still exercises a nested
   // cross-bank return when SOURCE_BANK is BANK0.
   nested_leaf1();
   signature := 0x40;
   transition_count := transition_count + 1;
}

bank0 void jump_target0(void) {
   signature := 0x80;
   transition_count := transition_count + 1;
   asm jmp finish_jump;
}

#if MAPPER_BANKS > 1
bank1 void call_target1(void) {
   signature := 0x41;
   transition_count := transition_count + 1;
}

bank1 void jump_target1(void) {
   signature := 0x81;
   transition_count := transition_count + 1;
   asm jmp finish_jump;
}

#endif
