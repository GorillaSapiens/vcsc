   call_target2();
   asm tsx;
   asm stx stack_after;
   if (signature != 0x42 || stack_before != stack_after) {
      failure := 0x03;
   }
   status_color := 0x8A;
#ifndef SIMULATOR_TEST
   draw_status_frame();
#endif
   signature := 0;
   asm tsx;
   asm stx stack_before;
   call_target3();
   asm tsx;
   asm stx stack_after;
   if (signature != 0x43 || stack_before != stack_after) {
