#endif
#endif
#if MAPPER_BANKS > 4
   signature := 0;
   asm tsx;
   asm stx stack_before;
   call_target4();
   asm tsx;
   asm stx stack_after;
   if (signature != 0x44 || stack_before != stack_after) {
      failure := 0x05;
   }
   status_color := 0x92;
#ifndef SIMULATOR_TEST
   draw_status_frame();
#endif
   signature := 0;
   asm tsx;
   asm stx stack_before;
   call_target5();
   asm tsx;
   asm stx stack_after;
   if (signature != 0x45 || stack_before != stack_after) {
      failure := 0x06;
   }
   status_color := 0x96;
#ifndef SIMULATOR_TEST
   draw_status_frame();
#endif
   signature := 0;
   asm tsx;
   asm stx stack_before;
   call_target6();
   asm tsx;
   asm stx stack_after;
