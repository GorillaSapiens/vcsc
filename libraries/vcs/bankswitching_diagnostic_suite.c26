// F8/F6/F4 complete bank-transition diagnostic suite.
//
// One build exercises the entire ordered source-bank/destination-bank matrix
// for its mapper.  Every source bank makes a same-bank JSR/RTS call, and
// BANK0 also makes a nested cross-bank call, before every source directly
// jumps to every destination bank.  RIOT-RAM signatures, transition counts, and
// hardware-stack balance are checked before the cartridge settles on a stable
// green PASS or dark-red FAIL frame for emulator certification.

#ifndef MAPPER_BANKS
MAPPER_BANKS_must_be_2_4_or_8
#endif

#ifdef SUPERCHIP_TEST
#if MAPPER_BANKS == 2
include "vcs_8k_f8sc.c26"
#elif MAPPER_BANKS == 4
include "vcs_16k_f6sc.c26"
#elif MAPPER_BANKS == 8
include "vcs_32k_f4sc.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#else
#if MAPPER_BANKS == 2
include "vcs_8k_f8.c26"
#elif MAPPER_BANKS == 4
include "vcs_16k_f6.c26"
#elif MAPPER_BANKS == 8
include "vcs_32k_f4.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#endif

#ifndef SIMULATOR_TEST
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"
instantiate "six_glyph_wide_component.c26" as status_word
#endif

#ifdef SUPERCHIP_TEST
// Own the complete region with both BSS and DATA objects. Stock reset/startup
// must clear every BSS byte and copy every DATA byte through the write window.
// The diagnostic later poisons these objects before entering its result loop;
// an emulator or console RESET must restore them before main runs again.
superchip uint8_t diagnostic_superchip_bss_head;
superchip uint8_t diagnostic_superchip_data_head := 0x5A;
superchip uint8_t diagnostic_superchip_count;
superchip uint8_t diagnostic_superchip_bss[124];
superchip uint8_t diagnostic_superchip_data_tail := 0xA5;
#endif

uint8_t failure;
uint8_t signature;
uint8_t source_seen;
uint8_t current_source;
uint8_t current_destination;
uint8_t call_count;
uint8_t transition_count;
uint8_t nested_count;
uint8_t status_color;
uint8_t stack_before;
uint8_t stack_after;
#ifdef SUPERCHIP_TEST
uint8_t diagnostic_superchip_index;
#endif

#ifndef SIMULATOR_TEST
// Exact space/A/F/I/L/P/S designs copied from fonts/default_ascii.c26.
// The local alias stores them bottom-to-top because six_glyph_wide_component
// counts its row index down from seven to zero.  PASS and FAIL occupy the
// middle four of the component's six wide glyph cells, so their 56-pixel word
// boxes are centered at X=79.5 on the 160-pixel visible raster.
alias BANK_DIAGNOSTIC_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

bank0 const uint8_t status_blank_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b........,
      0b........,
      0b........,
      0b........,
      0b........,
      0b........,
      0b........,
      0b........
   )
};

bank0 const uint8_t status_a_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b..XXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXXX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XX..XX.
   )
};

bank0 const uint8_t status_f_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b.XXXXXX.,
      0b.XX.....,
      0b.XX.....,
      0b.XXXXX..,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....
   )
};

bank0 const uint8_t status_i_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b.XXXXXX.,
      0b...XX...,
      0b...XX...,
      0b...XX...,
      0b...XX...,
      0b...XX...,
      0b...XX...,
      0b.XXXXXX.
   )
};

bank0 const uint8_t status_l_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XXXXXX.
   )
};

bank0 const uint8_t status_p_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b.XXXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXX..,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....
   )
};

bank0 const uint8_t status_s_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b..XXXX..,
      0b.XX..XX.,
      0b.XX.....,
      0b..XXXX..,
      0b.....XX.,
      0b.....XX.,
      0b.XX..XX.,
      0b..XXXX..
   )
};

inline void load_status_pass(void) {
   asm lda #<status_blank_glyph;
   asm sta status_word_pointers;
   asm lda #>status_blank_glyph;
   asm sta status_word_pointers+1;
   asm lda #<status_p_glyph;
   asm sta status_word_pointers+2;
   asm lda #>status_p_glyph;
   asm sta status_word_pointers+3;
   asm lda #<status_a_glyph;
   asm sta status_word_pointers+4;
   asm lda #>status_a_glyph;
   asm sta status_word_pointers+5;
   asm lda #<status_s_glyph;
   asm sta status_word_pointers+6;
   asm lda #>status_s_glyph;
   asm sta status_word_pointers+7;
   asm lda #<status_s_glyph;
   asm sta status_word_pointers+8;
   asm lda #>status_s_glyph;
   asm sta status_word_pointers+9;
   asm lda #<status_blank_glyph;
   asm sta status_word_pointers+10;
   asm lda #>status_blank_glyph;
   asm sta status_word_pointers+11;
   status_word_color := 0x0e;
}

inline void load_status_fail(void) {
   asm lda #<status_blank_glyph;
   asm sta status_word_pointers;
   asm lda #>status_blank_glyph;
   asm sta status_word_pointers+1;
   asm lda #<status_f_glyph;
   asm sta status_word_pointers+2;
   asm lda #>status_f_glyph;
   asm sta status_word_pointers+3;
   asm lda #<status_a_glyph;
   asm sta status_word_pointers+4;
   asm lda #>status_a_glyph;
   asm sta status_word_pointers+5;
   asm lda #<status_i_glyph;
   asm sta status_word_pointers+6;
   asm lda #>status_i_glyph;
   asm sta status_word_pointers+7;
   asm lda #<status_l_glyph;
   asm sta status_word_pointers+8;
   asm lda #>status_l_glyph;
   asm sta status_word_pointers+9;
   asm lda #<status_blank_glyph;
   asm sta status_word_pointers+10;
   asm lda #>status_blank_glyph;
   asm sta status_word_pointers+11;
   status_word_color := 0x0e;
}

bank0 void draw_status_frame(void) {
   // Exercise the component lifecycle normally.  Its stock decimal pointer
   // preparation is immediately replaced with the exact ASCII PASS/FAIL
   // pointers during VBLANK, before the component becomes visible.
   status_word_score := 0;
   status_word_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      status_word_vblank();
      if (failure) {
         load_status_fail();
      }
      else {
         load_status_pass();
      }

      COLUP0 := 0x0e;
      COLUP1 := 0x0e;
      if (failure) {
         COLUBK := 0x20;
      }
      else {
         COLUBK := status_color;
      }
      PF0 := 0;
      PF1 := 0;
      PF2 := 0;
      GRP0 := 0;
      GRP1 := 0;
      ENAM0 := 0;
      ENAM1 := 0;
      ENABL := 0;
      CTRLPF := 0;

      vcs_ntsc_end_vblank();

      // 90 blank lines + the component's exact 11 lines + 91 blank lines =
      // 192 visible scanlines.  The one-line asymmetry is the unavoidable
      // half-scanline centering of an odd-height component in an even-height
      // visible field.
      vcs_ntsc_wait_component_scanlines(90);
      status_word_draw();
      vcs_ntsc_wait_visible_tail_scanlines(91);

      vcs_ntsc_begin_overscan();
      status_word_overscan();
      vcs_ntsc_end_overscan();
   }
}

#endif

#ifdef SIMULATOR_TEST
bank0 void simulator_done(void) {
   while (1) {
   }
}
#endif

bank1 void nested_leaf1(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD1;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   nested_count := nested_count + 1;
   signature := 0xA1;
}

bank0 void call_target0(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD0;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   nested_leaf1();
   signature := 0x40;
   call_count := call_count + 1;
}

bank0 void jump_target0(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD0;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   asm tsx;
   asm stx stack_after;
   if (current_destination != 0 || source_seen != current_source ||
       stack_before != stack_after) {
      failure := 0xE0;
   }
   signature := 0x80;
   transition_count := transition_count + 1;
   status_color := 0x82;
   asm jmp advance_transition;
}

