// F8/F6/F4 complete bank-transition diagnostic suite.
//
// One build exercises the entire ordered source-bank/destination-bank matrix
// for its mapper.  Every source bank makes a same-bank JSR/RTS call, and
// BANK0 also makes a nested cross-bank call, before every source directly
// jumps to every destination bank.  RIOT-RAM signatures, transition counts, and
// hardware-stack balance are checked before the cartridge settles on a stable
// green lowercase pass or dark-red uppercase FAIL frame, with a second cart-type line, for emulator certification.

#ifndef MAPPER_BANKS
MAPPER_BANKS_must_be_2_4_or_8
#endif

#ifdef SUPERCHIP_TEST
#if MAPPER_BANKS == 2
include "vcs_8k_f8sc.c26"
#elif MAPPER_BANKS == 4
include "vcs_16k_f6sc.c26"
#elif MAPPER_BANKS == 8
include "vcs_32k_f4sc.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#else
#if MAPPER_BANKS == 2
include "vcs_8k_f8.c26"
#elif MAPPER_BANKS == 4
include "vcs_16k_f6.c26"
#elif MAPPER_BANKS == 8
include "vcs_32k_f4.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#endif

#ifndef SIMULATOR_TEST
include "frame_ntsc.c26"
// Both display components require a score_font symbol for their normal
// lifecycle pointer preparation. The diagnostic replaces those pointers with
// its two exact ASCII subset tables during VBLANK before either becomes visible.
include "fonts/default_decimal.c26"
instantiate "six_glyph_big_wide_component.c26" as status_result
instantiate "six_glyph_component.c26" as cart_type (compact_font:=0)
#endif

#ifdef SUPERCHIP_TEST
// Own the complete region with both BSS and DATA objects. Stock reset/startup
// must clear every BSS byte and copy every DATA byte through the write window.
// The diagnostic later poisons these objects before entering its result loop;
// an emulator or console RESET must restore them before main runs again.
cartram uint8_t diagnostic_superchip_bss_head;
cartram uint8_t diagnostic_superchip_data_head := 0x5A;
cartram uint8_t diagnostic_superchip_count;
cartram uint8_t diagnostic_superchip_bss[124];
cartram uint8_t diagnostic_superchip_data_tail := 0xA5;
#endif

uint8_t failure;
uint8_t signature;
uint8_t source_seen;
uint8_t current_source;
uint8_t current_destination;
uint8_t call_count;
uint8_t transition_count;
uint8_t nested_count;
uint8_t status_color;
uint8_t stack_before;
uint8_t stack_after;
#ifdef SUPERCHIP_TEST
uint8_t diagnostic_superchip_index;
#endif

#ifndef SIMULATOR_TEST
// Exact glyph subsets copied mechanically from the canonical ASCII fonts.
// Keep each table page-contained so every cycle-counted indirect indexed load
// remains page-cross free.
//
// Big result table order:
//   blank, p, a, s, F, A, I, L
// Small cart-type table order:
//   blank, F, 4, 6, 8, S, C, ?
alias BANK_DIAGNOSTIC_BIG_GLYPH(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p) p,o,n,m,l,k,j,i,h,g,f,e,d,c,b,a
alias BANK_DIAGNOSTIC_SMALL_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

bank0 page const uint8_t status_big_glyphs[128] := {
   // space -- exact big_ascii.c26 0x20
   BANK_DIAGNOSTIC_BIG_GLYPH(
