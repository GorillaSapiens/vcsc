#ifdef SUPERCHIP_TEST
bank0 void validate_superchip_startup(void) {
   if (diagnostic_superchip_data_head != 0x5A ||
       diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xF0;
   }
   if (diagnostic_superchip_bss_head != 0 || diagnostic_superchip_count != 0) {
      failure := 0xF1;
   }
   diagnostic_superchip_index := 0;
   while (diagnostic_superchip_index < 124) {
      if (diagnostic_superchip_bss[diagnostic_superchip_index] != 0) {
         failure := 0xF2;
      }
      diagnostic_superchip_index := diagnostic_superchip_index + 1;
   }
}

bank0 void poison_superchip_before_result(void) {
   diagnostic_superchip_bss_head := 0xC3;
   diagnostic_superchip_data_head := 0x3C;
   diagnostic_superchip_count := 0x96;
   diagnostic_superchip_bss[0] := 0x69;
   diagnostic_superchip_bss[123] := 0xA6;
   diagnostic_superchip_data_tail := 0x69;
}
#endif

bank0 void finish_all(void) {
   if (call_count != MAPPER_BANKS ||
       transition_count != MAPPER_BANKS * MAPPER_BANKS ||
       nested_count != 1 ||
       source_seen != MAPPER_BANKS - 1 ||
       signature != 0x80 + MAPPER_BANKS - 1 ||
       stack_before != stack_after) {
      failure := 0xFE;
   }
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5 ||
       diagnostic_superchip_count != MAPPER_BANKS * MAPPER_BANKS + MAPPER_BANKS + 1) {
      failure := 0xFD;
   }
#endif
   status_color := 0xC4;
#ifdef SUPERCHIP_TEST
   // Leave every startup class visibly dirty. A subsequent CPU/console RESET
   // preserves the physical cartridge RAM but must re-run BSS/DATA startup.
   poison_superchip_before_result();
#endif
#ifdef SIMULATOR_TEST
   asm jmp simulator_done;
#else
   draw_status_frame();
#endif
}

bank0 void dispatch_source(void) {
   if (current_source == 0) {
      asm jmp source_entry0;
   }
#if MAPPER_BANKS > 1
   if (current_source == 1) {
      asm jmp source_entry1;
   }
#endif
#if MAPPER_BANKS > 2
   if (current_source == 2) {
      asm jmp source_entry2;
   }
   if (current_source == 3) {
      asm jmp source_entry3;
   }
#endif
#if MAPPER_BANKS > 4
   if (current_source == 4) {
      asm jmp source_entry4;
   }
   if (current_source == 5) {
      asm jmp source_entry5;
   }
   if (current_source == 6) {
      asm jmp source_entry6;
   }
   if (current_source == 7) {
      asm jmp source_entry7;
   }
#endif
   failure := 0xFC;
   asm jmp finish_all;
}

bank0 void advance_transition(void) {
   current_destination := current_destination + 1;
   if (current_destination < MAPPER_BANKS) {
      asm jmp dispatch_source;
   }
   current_destination := 0;
   current_source := current_source + 1;
   if (current_source < MAPPER_BANKS) {
      asm jmp dispatch_source;
   }
   asm jmp finish_all;
}

bank0 void source_entry0(void) {
   if (current_source != 0) {
      failure := 0xB0;
   }
   source_seen := 0;
   if (current_destination == 0) {
      signature := 0;
      asm tsx;
      asm stx stack_before;
      call_target0();
      asm tsx;
      asm stx stack_after;
      if (signature != 0x40 || stack_before != stack_after) {
         failure := 0xC0;
      }
   }
   signature := 0;
   asm tsx;
   asm stx stack_before;
   if (current_destination == 0) {
      asm jmp jump_target0;
   }
#if MAPPER_BANKS > 1
   if (current_destination == 1) {
      asm jmp jump_target1;
   }
#endif
#if MAPPER_BANKS > 2
   if (current_destination == 2) {
      asm jmp jump_target2;
   }
   if (current_destination == 3) {
      asm jmp jump_target3;
   }
#endif
#if MAPPER_BANKS > 4
   if (current_destination == 4) {
      asm jmp jump_target4;
   }
   if (current_destination == 5) {
      asm jmp jump_target5;
   }
   if (current_destination == 6) {
      asm jmp jump_target6;
   }
   if (current_destination == 7) {
      asm jmp jump_target7;
   }
#endif
   failure := 0xFB;
   asm jmp finish_all;
}

#if MAPPER_BANKS > 1
bank1 void source_entry1(void) {
   if (current_source != 1) {
      failure := 0xB1;
   }
   source_seen := 1;
   if (current_destination == 0) {
      signature := 0;
      asm tsx;
      asm stx stack_before;
      call_target1();
      asm tsx;
