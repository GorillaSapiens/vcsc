}

bank6 void jump_target6(void) {
   signature := 0x86;
   transition_count := transition_count + 1;
   asm jmp finish_jump;
}

#endif
#if MAPPER_BANKS > 4
bank7 void call_target7(void) {
   signature := 0x47;
   transition_count := transition_count + 1;
}

bank7 void jump_target7(void) {
   signature := 0x87;
   transition_count := transition_count + 1;
   asm jmp finish_jump;
}

#endif
#if SOURCE_BANK == 0
bank0 void run_source(void) {
   source_seen := 0;
   signature := 0;
   asm tsx;
   asm stx stack_before;
   call_target0();
   asm tsx;
   asm stx stack_after;
   if (signature != 0x40 || stack_before != stack_after) {
      failure := 0x01;
   }
   status_color := 0x82;
#ifndef SIMULATOR_TEST
   draw_status_frame();
#endif
   signature := 0;
   asm tsx;
   asm stx stack_before;
   call_target1();
   asm tsx;
   asm stx stack_after;
   if (signature != 0x41 || stack_before != stack_after) {
