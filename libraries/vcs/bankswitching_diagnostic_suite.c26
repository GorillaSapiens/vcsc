#endif
   asm tsx;
   asm stx stack_after;
   if (current_destination != 1 || source_seen != current_source ||
       stack_before != stack_after) {
      failure := 0xE1;
   }
   signature := 0x81;
   transition_count := transition_count + 1;
   status_color := 0x86;
   asm jmp advance_transition;
}

#endif

