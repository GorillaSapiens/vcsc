// F8/F6/F4 complete bank-transition diagnostic suite.
//
// One build exercises the entire ordered source-bank/destination-bank matrix
// for its mapper.  Every source bank makes a same-bank JSR/RTS call, and
// BANK0 also makes a nested cross-bank call, before every source directly
// jumps to every destination bank.  RIOT-RAM signatures, transition counts, and
// hardware-stack balance are checked before the cartridge settles on a stable
// green P (PASS) or dark-red F (FAIL) frame for emulator certification.

#ifndef MAPPER_BANKS
MAPPER_BANKS_must_be_2_4_or_8
#endif

#ifdef SUPERCHIP_TEST
#if MAPPER_BANKS == 2
include "vcs_8k_f8sc.c26"
#elif MAPPER_BANKS == 4
include "vcs_16k_f6sc.c26"
#elif MAPPER_BANKS == 8
include "vcs_32k_f4sc.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#else
#if MAPPER_BANKS == 2
include "vcs_8k_f8.c26"
#elif MAPPER_BANKS == 4
include "vcs_16k_f6.c26"
#elif MAPPER_BANKS == 8
include "vcs_32k_f4.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#endif

#ifdef SUPERCHIP_TEST
// Own the complete region with both BSS and DATA objects. Stock reset/startup
// must clear every BSS byte and copy every DATA byte through the write window.
// The diagnostic later poisons these objects before entering its result loop;
// an emulator or console RESET must restore them before main runs again.
superchip uint8_t diagnostic_superchip_bss_head;
superchip uint8_t diagnostic_superchip_data_head := 0x5A;
superchip uint8_t diagnostic_superchip_count;
superchip uint8_t diagnostic_superchip_bss[124];
superchip uint8_t diagnostic_superchip_data_tail := 0xA5;
#endif

uint8_t failure;
uint8_t signature;
uint8_t source_seen;
uint8_t current_source;
uint8_t current_destination;
uint8_t call_count;
uint8_t transition_count;
uint8_t nested_count;
uint8_t status_color;
uint8_t stack_before;
uint8_t stack_after;
#ifdef SUPERCHIP_TEST
uint8_t diagnostic_superchip_index;
#endif

// Exact 0x50 P and 0x46 F designs copied from fonts/default_ascii.c26.
// The local alias stores them bottom-to-top because the display loop counts
// its row index down from seven to zero.
alias BANK_DIAGNOSTIC_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a

bank0 const uint8_t pass_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b.XXXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXX..,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....
   )
};

bank0 const uint8_t fail_glyph[8] := {
   BANK_DIAGNOSTIC_GLYPH(
      0b.XXXXXX.,
      0b.XX.....,
      0b.XX.....,
      0b.XXXXX..,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....,
      0b.XX.....
   )
};

bank0 void draw_status_frame(void) {
   // This is a non-returning display loop.  Keeping the frame-to-frame branch
   // here avoids an invisible JSR/RTS/C-loop scanline between nominal frames.
   asm @status_frame_loop:;

   // Begin VSYNC immediately on re-entry.  All per-frame TIA setup is split
   // across two budgeted VBLANK scanlines below, so it cannot silently add
   // uncounted lines between frames.
   asm lda #2;
   asm sta VSYNC;
   asm ldx #3;
   asm @vsync_loop:;
   asm sta WSYNC;
   asm dex;
   asm bne @vsync_loop;

   asm lda #0;
   asm sta VSYNC;
   asm lda #2;
   asm sta VBLANK;

   // VBLANK setup line 1 of 37.  The status glyph is always white; only the
   // background distinguishes PASS from FAIL.
   asm lda #$0E;
   asm sta COLUP0;
   asm lda failure;
   asm beq @pass_colors;
   asm lda #$20;
   asm jmp @colors_done;
   asm @pass_colors:;
   asm lda status_color;
   asm @colors_done:;
   asm sta COLUBK;
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta WSYNC;

   // VBLANK setup line 2 of 37.
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta REFP0;
   asm sta VDELP0;
   asm sta RESMP0;
   asm sta HMP0;
   asm sta CTRLPF;
   asm sta HMCLR;
   asm lda #5;
   asm sta NUSIZ0;
   asm sta WSYNC;

   asm ldx #35;
   asm @vblank_loop:;
   asm sta WSYNC;
   asm dex;
   asm bne @vblank_loop;

   asm lda #0;
   asm sta VBLANK;
   asm ldx #76;
   asm @visible_top:;
   asm sta WSYNC;
   asm dex;
   asm bne @visible_top;

   asm sta WSYNC;
   asm ldx #20;
   asm @position_delay:;
   asm dex;
   asm bne @position_delay;
   asm sta RESP0;

   asm ldx #7;
   asm @glyph_loop:;
   asm lda failure;
   asm beq @pass_row;
   asm lda fail_glyph,x;
   asm jmp @row_ready;
   asm @pass_row:;
   asm lda pass_glyph,x;
   asm @row_ready:;
   // Wait for the next scanline before changing GRP0.  Updating GRP0 before
   // WSYNC tears each row in half because the row-selection branches consume
   // part of the visible scanline.
   asm sta WSYNC;
   asm sta GRP0;
   asm sta WSYNC;
   asm dex;
   asm bpl @glyph_loop;

   asm lda #0;
   asm sta GRP0;
   asm ldx #99;
   asm @visible_bottom:;
   asm sta WSYNC;
   asm dex;
   asm bne @visible_bottom;

   asm lda #2;
   asm sta VBLANK;
   asm lda #0;
   // Twenty-nine WSYNCs plus the branch/restart interval after the final
   // WSYNC occupy thirty overscan scanlines as Stella counts them.
   asm ldx #29;
   asm @overscan_loop:;
   asm sta WSYNC;
   asm dex;
   asm bne @overscan_loop;
   asm jmp @status_frame_loop;
}

#ifdef SIMULATOR_TEST
bank0 void simulator_done(void) {
   while (1) {
   }
}
#endif

bank1 void nested_leaf1(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD1;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   nested_count := nested_count + 1;
   signature := 0xA1;
}

bank0 void call_target0(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD0;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   nested_leaf1();
   signature := 0x40;
   call_count := call_count + 1;
}

bank0 void jump_target0(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD0;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   asm tsx;
   asm stx stack_after;
   if (current_destination != 0 || source_seen != current_source ||
       stack_before != stack_after) {
      failure := 0xE0;
   }
   signature := 0x80;
   transition_count := transition_count + 1;
   status_color := 0x82;
   asm jmp advance_transition;
}

