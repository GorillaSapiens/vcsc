   failure := 1;
#endif
   signature := 0;
   source_seen := 0xFF;
   current_source := 0;
   current_destination := 0;
   call_count := 0;
   transition_count := 0;
   nested_count := 0;
   status_color := 0x84;
   asm jmp dispatch_source;
}
