inline void load_status_pass(void) {
   asm lda #<{status_big_glyphs + 0};
   asm sta status_result_pointers+0;
   asm lda #>{status_big_glyphs + 0};
   asm sta status_result_pointers+1;
   asm lda #<{status_big_glyphs + 16};
   asm sta status_result_pointers+2;
   asm lda #>{status_big_glyphs + 16};
   asm sta status_result_pointers+3;
   asm lda #<{status_big_glyphs + 32};
   asm sta status_result_pointers+4;
   asm lda #>{status_big_glyphs + 32};
   asm sta status_result_pointers+5;
   asm lda #<{status_big_glyphs + 48};
   asm sta status_result_pointers+6;
   asm lda #>{status_big_glyphs + 48};
   asm sta status_result_pointers+7;
   asm lda #<{status_big_glyphs + 48};
   asm sta status_result_pointers+8;
   asm lda #>{status_big_glyphs + 48};
   asm sta status_result_pointers+9;
   asm lda #<{status_big_glyphs + 0};
   asm sta status_result_pointers+10;
   asm lda #>{status_big_glyphs + 0};
   asm sta status_result_pointers+11;
   status_result_color := 0x0e;
}

inline void load_status_fail(void) {
   asm lda #<{status_big_glyphs + 0};
   asm sta status_result_pointers+0;
   asm lda #>{status_big_glyphs + 0};
   asm sta status_result_pointers+1;
   asm lda #<{status_big_glyphs + 64};
   asm sta status_result_pointers+2;
   asm lda #>{status_big_glyphs + 64};
   asm sta status_result_pointers+3;
   asm lda #<{status_big_glyphs + 80};
   asm sta status_result_pointers+4;
   asm lda #>{status_big_glyphs + 80};
   asm sta status_result_pointers+5;
   asm lda #<{status_big_glyphs + 96};
   asm sta status_result_pointers+6;
   asm lda #>{status_big_glyphs + 96};
   asm sta status_result_pointers+7;
   asm lda #<{status_big_glyphs + 112};
   asm sta status_result_pointers+8;
   asm lda #>{status_big_glyphs + 112};
   asm sta status_result_pointers+9;
   asm lda #<{status_big_glyphs + 0};
   asm sta status_result_pointers+10;
   asm lda #>{status_big_glyphs + 0};
   asm sta status_result_pointers+11;
   status_result_color := 0x0e;
}

inline void load_cart_type(void) {
#ifdef POISONED_RESULT
   // The poison diagnostic deliberately withholds its mapper identity.
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+0;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+1;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+2;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+3;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+5;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+7;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+8;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+9;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+10;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+11;
#else
#ifdef SUPERCHIP_TEST
   // blank / F / mapper-digit / S / C / blank
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+0;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+1;
   asm lda #<{status_small_glyphs + 8};
   asm sta cart_type_pointers+2;
   asm lda #>{status_small_glyphs + 8};
   asm sta cart_type_pointers+3;
#if MAPPER_BANKS == 2
   asm lda #<{status_small_glyphs + 32};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 32};
   asm sta cart_type_pointers+5;
#elif MAPPER_BANKS == 4
   asm lda #<{status_small_glyphs + 24};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 24};
   asm sta cart_type_pointers+5;
#elif MAPPER_BANKS == 8
   asm lda #<{status_small_glyphs + 16};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 16};
   asm sta cart_type_pointers+5;
#endif
   asm lda #<{status_small_glyphs + 40};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 40};
   asm sta cart_type_pointers+7;
   asm lda #<{status_small_glyphs + 48};
   asm sta cart_type_pointers+8;
   asm lda #>{status_small_glyphs + 48};
   asm sta cart_type_pointers+9;
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+10;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+11;
#else
   // blank / blank / F / mapper-digit / blank / blank
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+0;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+1;
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+2;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+3;
   asm lda #<{status_small_glyphs + 8};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 8};
   asm sta cart_type_pointers+5;
#if MAPPER_BANKS == 2
   asm lda #<{status_small_glyphs + 32};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 32};
   asm sta cart_type_pointers+7;
#elif MAPPER_BANKS == 4
   asm lda #<{status_small_glyphs + 24};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 24};
   asm sta cart_type_pointers+7;
#elif MAPPER_BANKS == 8
   asm lda #<{status_small_glyphs + 16};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 16};
   asm sta cart_type_pointers+7;
#endif
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+8;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+9;
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+10;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+11;
#endif
#endif
}

bank0 void draw_status_frame(void) {
   // Exercise both component lifecycles normally. Their decimal preparation is
   // immediately replaced with the exact ASCII subset pointers during VBLANK.
   status_result_score := 0;
   cart_type_score := 0;
   status_result_init();
   cart_type_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      status_result_vblank();
      cart_type_vblank();
      if (failure) {
         load_status_fail();
      }
      else {
         load_status_pass();
      }
      load_cart_type();

      COLUP0 := 0x0e;
      COLUP1 := 0x0e;
      if (failure) {
         COLUBK := 0x20;
      }
      else {
         COLUBK := status_color;
      }
      PF0 := 0;
      PF1 := 0;
      PF2 := 0;
      GRP0 := 0;
      GRP1 := 0;
      ENAM0 := 0;
      ENAM1 := 0;
      ENABL := 0;
      CTRLPF := 0;

      vcs_ntsc_end_vblank();

      // Center the combined 30-line result block in the 192-line visible field:
      // 81 blank + 19 big result + 11 cart type + 81 blank = 192.
      vcs_ntsc_wait_component_scanlines(81);
      status_result_draw();
      vcs_ntsc_component_handoff();
      cart_type_draw();
      vcs_ntsc_wait_visible_tail_scanlines(81);

      vcs_ntsc_begin_overscan();
      status_result_overscan();
      cart_type_overscan();
      vcs_ntsc_end_overscan();
   }
}
#endif

#ifdef SIMULATOR_TEST
bank0 void simulator_done(void) {
   while (1) {
   }
}
#endif

bank1 void nested_leaf1(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD1;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   nested_count := nested_count + 1;
   signature := 0xA1;
}

bank0 void call_target0(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD0;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   nested_leaf1();
   signature := 0x40;
   call_count := call_count + 1;
}

bank0 void jump_target0(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD0;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   asm tsx;
   asm stx stack_after;
   if (current_destination != 0 || source_seen != current_source ||
       stack_before != stack_after) {
      failure := 0xE0;
   }
   signature := 0x80;
   transition_count := transition_count + 1;
   status_color := 0x82;
   asm jmp advance_transition;
}

#if MAPPER_BANKS > 1
bank1 void call_target1(void) {
#ifdef SUPERCHIP_TEST
