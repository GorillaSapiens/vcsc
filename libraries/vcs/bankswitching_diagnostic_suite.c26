void main(void) {
   failure := 0;
#ifdef SUPERCHIP_TEST
   // This check happens before the diagnostic writes any Superchip object.
   // It therefore certifies both first-start initialization and reinitialization
   // after an external RESET which preserves physical cartridge RAM.
   validate_superchip_startup();
#endif
#ifndef SIMULATOR_TEST
   // A genuine startup-contract failure has no reason to exercise bank
   // transitions. Enter the stable result display immediately. This real error
   // path also makes the component lifecycle reachable from main for its
   // require contracts without changing the deliberately poisoned matrix run.
   if (failure) {
      draw_status_frame();
   }
#endif
#ifdef POISONED_RESULT
   failure := 1;
#endif
   signature := 0;
   source_seen := 0xFF;
   current_source := 0;
   current_destination := 0;
   call_count := 0;
   transition_count := 0;
   nested_count := 0;
   status_color := 0x84;
   asm jmp dispatch_source;
}
