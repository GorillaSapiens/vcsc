include "vcs.c26"
include "FA/ram.c26"

// Harmony FA2: 7 physical 4K ROM banks selected directly by $1FF5-$1FFB.
// Physical/file bank 0 powers up. VCSC keeps logical bank0 as the startup/home
// bank and assigns physical/file indices in the same order as logical banks.
// The $x000-$x0FF write port and $x100-$x1FF read port hide the first $200
// bytes of every selected bank, leaving $x200-$xFFF as ROM.
// Harmony flash persistence through $1FF4 is optional hardware behavior and is
// intentionally outside this core ROM/RAM profile.

cartridge {
#ifdef VCSC_INLINE_BANKCALL
   $inline_bankcall
#endif
   $fill:0xff $signature:FA2
   $trampoline_offset:0x0f00 $trampoline_size:0x00e0
   $vector_bridge_offset:0x0fe0 $vector_bridge_size:0x0012
   $vectors_offset:0x0ffa $vectors_size:0x0006
};

bank bank0 {
   $image_size:0x1000 $file_index:0 $image_offset:0x0200
   $link_start:0xf200 $cpu_start:0xf200 $map_size:0x0e00
   $select_access:0x1ff5 $startup
};

bank bank1 {
   $image_size:0x1000 $file_index:1 $image_offset:0x0200
   $link_start:0xd200 $cpu_start:0xf200 $map_size:0x0e00
   $select_access:0x1ff6
};

bank bank2 {
   $image_size:0x1000 $file_index:2 $image_offset:0x0200
   $link_start:0xb200 $cpu_start:0xf200 $map_size:0x0e00
   $select_access:0x1ff7
};

bank bank3 {
   $image_size:0x1000 $file_index:3 $image_offset:0x0200
   $link_start:0x9200 $cpu_start:0xf200 $map_size:0x0e00
   $select_access:0x1ff8
};

bank bank4 {
   $image_size:0x1000 $file_index:4 $image_offset:0x0200
   $link_start:0x7200 $cpu_start:0xf200 $map_size:0x0e00
   $select_access:0x1ff9
};

bank bank5 {
   $image_size:0x1000 $file_index:5 $image_offset:0x0200
   $link_start:0x5200 $cpu_start:0xf200 $map_size:0x0e00
   $select_access:0x1ffa
};

bank bank6 {
   $image_size:0x1000 $file_index:6 $image_offset:0x0200
   $link_start:0x3200 $cpu_start:0xf200 $map_size:0x0e00
   $select_access:0x1ffb
};

mem bank0 { $start:0xf200 $size:0x0d00 $ro $priority:2 };
mem bank1 { $start:0xd200 $size:0x0d00 $ro };
mem bank2 { $start:0xb200 $size:0x0d00 $ro };
mem bank3 { $start:0x9200 $size:0x0d00 $ro };
mem bank4 { $start:0x7200 $size:0x0d00 $ro };
mem bank5 { $start:0x5200 $size:0x0d00 $ro };
mem bank6 { $start:0x3200 $size:0x0d00 $ro };
