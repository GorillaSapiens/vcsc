// Approximate names for selected Atari 2600 NTSC TIA colors.
//
// TIA color bytes are hardware color/luminance codes, not RGB values. These
// names describe the Stella-compatible NTSC reference palette used by
// __builtin_ntsc_rgb(). The builtin performs compile-time nearest-color
// matching by squared RGB distance, so these exact reference RGB triplets fold
// back to their documented TIA values with no runtime code or lookup table.
// Names were chosen from nearby entries in X11 rgb.txt and made unique where
// neighboring TIA colors would otherwise receive the same name.

alias VCS_NTSC_GRAY_92          __builtin_ntsc_rgb(0xea, 0xea, 0xe9) // TIA 0x0e; near X11 gray92
alias VCS_NTSC_GOLDENROD        __builtin_ntsc_rgb(0xea, 0xc2, 0x54) // TIA 0x2e; near X11 goldenrod
alias VCS_NTSC_SANDY_BROWN      __builtin_ntsc_rgb(0xfd, 0xb5, 0x68) // TIA 0x3e; near X11 sandy brown
alias VCS_NTSC_LIGHT_CORAL      __builtin_ntsc_rgb(0xfd, 0x86, 0x85) // TIA 0x4e; near X11 light coral
alias VCS_NTSC_ORCHID           __builtin_ntsc_rgb(0xea, 0x82, 0xdc) // TIA 0x5e; near X11 orchid
alias VCS_NTSC_VIOLET           __builtin_ntsc_rgb(0xd0, 0x82, 0xfb) // TIA 0x6e; between violet and medium purple
alias VCS_NTSC_MEDIUM_PURPLE    __builtin_ntsc_rgb(0xb5, 0x86, 0xfb) // TIA 0x7e; near X11 MediumPurple1
alias VCS_NTSC_DARK_BLUE        __builtin_ntsc_rgb(0x12, 0x13, 0x9d) // TIA 0x82; near X11 dark blue
alias VCS_NTSC_MEDIUM_BLUE      __builtin_ntsc_rgb(0x24, 0x28, 0xb0) // TIA 0x84; near X11 medium blue
alias VCS_NTSC_ROYAL_BLUE       __builtin_ntsc_rgb(0x79, 0x86, 0xfb) // TIA 0x8e; near X11 royal blue
alias VCS_NTSC_SKY_BLUE_2       __builtin_ntsc_rgb(0x79, 0xc2, 0xfb) // TIA 0x9e; near X11 SkyBlue2
alias VCS_NTSC_SKY_BLUE         __builtin_ntsc_rgb(0x79, 0xdd, 0xfb) // TIA 0xae; near X11 sky blue
alias VCS_NTSC_AQUAMARINE       __builtin_ntsc_rgb(0x79, 0xfd, 0xcf) // TIA 0xbe; near X11 aquamarine
alias VCS_NTSC_PALE_GREEN       __builtin_ntsc_rgb(0x86, 0xfd, 0x85) // TIA 0xce; near X11 pale green
