// Shared state for all_five_section.c26. Include ONCE, instead of the alternative
// all_five_objects.c26. Seven constant runs encode all Ball/M0/M1 transitions.
// D0=M1, D1=Ball, D2=M0. No graphics are copied.
// Shared data42 bytes, including the event stack; peak ordinary stack2.
// Use extended VBLANK and perform preparation/intro/priming in a separate
// ordinary blanking callback, as in test/fixtures/layers/all_five_sections.c26.
uint8_t layers_object_x[5];
uint8_t layers_player0_y;
uint8_t layers_player1_y;
uint8_t layers_missile1_height;
uint8_t layers_missile1_y;
uint8_t layers_ball_y;
uint8_t *layers_player0_graphics;
uint8_t *layers_player1_graphics;
uint8_t layers_player0_height;
uint8_t layers_player1_height;
uint8_t layers_missile0_height;
uint8_t layers_missile0_y;
uint8_t layers_ball_height;
// Initial state plus at most six transitions, each [duration, mask]. The final
// duration is255, so visible drawing never consumes an uninitialized tail.
// During drawing S points into this already-allocated array; it is NOT extra
// hardware-stack RAM. Ordinary JSR/RTS are forbidden until layers_finish().
uint8_t layers_event_data[14];
uint8_t layers_current_mask;
uint8_t layers_run_remaining;
uint8_t layers_saved_stack;
uint8_t layers_player1_blank_color;
uint8_t layers_player0_counter;
uint8_t layers_player1_counter;
uint8_t layers_player0_limit;
uint8_t layers_player1_limit;
uint8_t layers_section_remaining;
// Preparation uses the byte above as an interval cursor; all visible section
// instances share it as their loop counter. No instance owns private RAM.

inline void layers_step_player0(void) {
   asm ldy.z layers_player0_counter;
   asm dey;
   asm sty.z layers_player0_counter;
   asm cpy.z layers_player0_limit;
}
inline void layers_step_player1(void) {
   asm ldy.z layers_player1_counter;
   asm dey;
   asm sty.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
}

inline void layers_consider_interval(void) {
   // A wrapped interval is initially on. Each event toggles its bit;
   // future events compete to end the current constant run. Y is its bit.
   // Inline deliberately: no nested JSR/RTS stack allocation during blanking.
   asm lda.z layers_player0_limit;
   asm cmp.z layers_player1_limit;
   asm beq.same @no_wrap;
   asm bcc.same @no_wrap;
   asm tya;
   asm ora.z layers_player0_counter;
   asm sta.z layers_player0_counter;
   asm @no_wrap:;
   asm lda.z layers_player0_limit;
   asm beq.same @enter;
   asm sec;
   asm sbc #1;
   asm @enter:;
   asm cmp.z layers_section_remaining;
   asm bcc.same @entered;
   asm beq.same @entered;
   asm cmp.z layers_player1_counter;
   asm bcs.same @exit;
   asm sta.z layers_player1_counter;
   asm jmp @exit;
   asm @entered:;
   asm tya;
   asm eor.z layers_player0_counter;
   asm sta.z layers_player0_counter;
   asm @exit:;
   asm lda.z layers_player1_limit;
   asm cmp.z layers_section_remaining;
   asm bcc.same @exited;
   asm beq.same @exited;
   asm cmp.z layers_player1_counter;
   asm bcs.same @done;
   asm sta.z layers_player1_counter;
   asm jmp @done;
   asm @exited:;
   asm tya;
   asm eor.z layers_player0_counter;
   asm sta.z layers_player0_counter;
   asm @done:;
}

inline void layers_prepare_vertical(void) {
   // Counter/limit bytes and shared section count are scratch until @ready:
   // p0counter=bits, p1counter=next event, p0limit=raw interval start,
   // p1limit=raw interval end, remaining=cursor. X is the event byte cursor.
   // At most six transitions split the visible interval into seven runs.
   asm ldx #0;
   asm stx.z layers_section_remaining;
   asm @range:;
   asm lda #0;
   asm sta.z layers_player0_counter;
   asm lda #96;
   asm sta.z layers_player1_counter;
   asm lda.z layers_ball_y;
   asm clc;
   asm adc #2;
   asm sta.z layers_player1_limit;
   asm sec;
   asm sbc.z layers_ball_height;
   asm sta.z layers_player0_limit;
   asm ldy #2;
   layers_consider_interval();
   asm lda.z layers_missile1_y;
   asm clc;
   asm adc #1;
   asm sta.z layers_player1_limit;
   asm sec;
   asm sbc.z layers_missile1_height;
   asm sta.z layers_player0_limit;
   asm ldy #1;
   layers_consider_interval();
   asm lda.z layers_missile0_y;
   asm clc;
   asm adc #1;
   asm sta.z layers_player1_limit;
   asm sec;
   asm sbc.z layers_missile0_height;
   asm sta.z layers_player0_limit;
   asm ldy #4;
   layers_consider_interval();
   asm lda.z layers_player1_counter;
   asm cmp #96;
   asm bne.same @duration;
   asm lda #255;
   asm jmp @store_duration;
   asm @duration:;
   asm sec;
   asm sbc.z layers_section_remaining;
   asm @store_duration:;
   asm sta.zx layers_event_data,x;
   asm lda.z layers_player0_counter;
   asm sta.zx layers_event_data + 1,x;
   asm inx;
   asm inx;
   asm lda.z layers_player1_counter;
   asm sta.z layers_section_remaining;
   asm cmp #96;
   asm bcs.same @ready;
   asm jmp @range;
   asm @ready:;
   asm lda.z layers_event_data;
   asm sta.z layers_run_remaining;
   asm lda.z layers_event_data + 1;
   asm sta.z layers_current_mask;
   asm lda.a layers_player1_colors;
   asm sta.z layers_player1_blank_color;
   asm lda.z layers_player0_y;
   asm sta.z layers_player0_counter;
   asm lda.z layers_player1_y;
   asm clc;
   asm adc #1;
   asm sta.z layers_player1_counter;
   asm lda.z layers_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z layers_player0_limit;
   asm lda.z layers_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z layers_player1_limit;
}

inline void layers_prime(void) {
   // All graphics/enables are immediate. Ball changes with M1 on odd HBlanks,
   // reproducing the former delayed-Ball row phase without a latch dependency.
   VDELP0 := 0; VDELP1 := 0; VDELBL := 0;
   asm ldx #0;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm lsr;
   asm sta ENAM0;
   asm lda.z layers_current_mask;
   asm asl;
   asm sta ENAM1;
   layers_step_player0();
   asm bcc.same @p0_on;
   asm ldy #0;
   asm @p0_on:;
   asm lda.ay layers_player0_colors,y;
   asm sta COLUP0;
   asm lda.iy (layers_player0_graphics),y;
   asm sta GRP0;
   layers_step_player1();
   asm bcc.same @p1_on;
   asm ldy #0;
   asm @p1_on:;
   asm lda.ay layers_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (layers_player1_graphics),y;
   asm sta GRP1;
   // Next P1 index is prepared before the visible first pair. Subsequent
   // decrements run on even lines after P1 selection.
   asm dec.z layers_player1_counter;
   asm ldy.z layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @p0_index;
   asm ldy #0;
   asm @p0_index:;
   asm ldx #0;
}

inline void layers_finish(void) {
   // Last section returns53 on its final visible line. Restore the real stack
   // and use23 cycles to reach0; never consume an offscreen event or sprite row.
   asm ldx.z layers_saved_stack;
   asm txs;
   asm .repeat 3;
   asm bit.a CXM0P;
   asm .endrepeat;
   asm bit.z $00;
   asm bit.z $00;
}
