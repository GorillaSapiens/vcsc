// Cooperating all-five section. Include all_five_dense_objects.c26 once.
// first(): entry3 after end_vblank, with primed TIA graphics/enables.
// draw()/exit: cycle53 on the predecessor's/final odd line. Preserve A/X/Y,
// shared counters, event stack, Y=P0 index and X=P0 glyph across handoffs.
// Finish the last section with layers_finish() before overscan or score handoff.
// Player colour/graphics transfer only in HBlank. One shared section counter.
// NMOS opB3 is LAX (zp),Y, a five-cycle ROM read into A/X. opAB #0 is the
// immediate LAX form with a zero operand (unlike nonzero operands, its result
// is unconditionally zero). Raw opcodes keep the ordinary assembler flags.
// First, loop and terminal bodies are explicit so a two-line section needs no
// setup line or loop counter. No-event islands live in skipped player branches;
// moving them out of line makes the worst-case event path fit without a JMP.
// The .same contracts below are part of that balance, not optional hints.
parameter number_of_scanlines := 2;
parameter playfield_row := 0;
parameter pf_color := 14;
parameter bk_color := 0;
#if TEMPLATE_number_of_scanlines < 2 || TEMPLATE_number_of_scanlines > 254
extern const uint8_t TEMPLATE_bad_height[TEMPLATE_section_height_must_be_positive_even_and_at_most_254];
#endif
const uint8_t TEMPLATE_height_validation[1 - (TEMPLATE_number_of_scanlines & 1)] := {0};
#if TEMPLATE_pf_color < 0 || TEMPLATE_pf_color > 255 || TEMPLATE_bk_color < 0 || TEMPLATE_bk_color > 255
extern const uint8_t TEMPLATE_bad_colour[TEMPLATE_section_colours_must_be_bytes];
#endif
alias TEMPLATE_reverse8(x) ( \
   ((((x) & 1) << 7) | (((x) & 2) << 5) | (((x) & 4) << 3) | \
     (((x) & 8) << 1) | (((x) & 16) >> 1) | (((x) & 32) >> 3) | \
     (((x) & 64) >> 5) | (((x) & 128) >> 7)) )
alias TEMPLATE_left1 (((TEMPLATE_playfield_row`uint32_t) >> 24) & 255)
alias TEMPLATE_left2 TEMPLATE_reverse8(((TEMPLATE_playfield_row`uint32_t) >> 16) & 255)
alias TEMPLATE_right2 (((TEMPLATE_playfield_row`uint32_t) >> 8) & 255)
alias TEMPLATE_right1 TEMPLATE_reverse8((TEMPLATE_playfield_row`uint32_t) & 255)

const uint8_t TEMPLATE_pf_right1 := TEMPLATE_right1;
inline void TEMPLATE_first(void) {

   PF1 := TEMPLATE_left1;
   asm @first_bk_barrier:;
   COLUBK := TEMPLATE_bk_color;
   asm @first_pf_barrier:;
   COLUPF := TEMPLATE_pf_color;
   asm tsx;
   asm stx.a layers_saved_stack;
   asm ldx #<layers_event_data + 1;
   asm txs;

   asm @first_pixels_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
   $X := TEMPLATE_pf_right1;
   asm @first_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm stx PF1;
   asm bcc.same @first_p1_on;
   asm opAB #0;
   asm tay;
   asm lda.z layers_player1_blank_color;
   asm bcs.same @first_p1_ready;
   asm @first_p1_on:;
   asm opB3 (layers_player1_graphics),y;
   asm lda.ay layers_player1_colors,y;
   asm @first_p1_ready:;
   asm dec.z layers_player1_counter;
   asm dec.z layers_player0_counter;
   asm sta COLUP1;
   asm stx GRP1;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm asl;
   asm sta ENAM1;
   PF1 := TEMPLATE_left1;
   asm @first_left_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.a layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @first_p0_on;
   asm ldy #0;
   asm bcs.same @first_p0_ready;


   asm @first_p0_on:;
   asm bit.a CXM0P;
   asm @first_p0_ready:;
   asm opB3 (layers_player0_graphics),y;
   asm @first_odd_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm @first_odd_right1_barrier:;
   PF1 := TEMPLATE_right1;

#if TEMPLATE_number_of_scanlines > 2

   asm dec.z layers_run_remaining;
   asm bne.same @second_no_event;
   asm pla;
   asm sta.z layers_run_remaining;
   asm pla;
   asm sta.z layers_current_mask;
   asm @second_event_ready:;
   asm lsr;
   asm sta ENAM0;
   asm lda.ay layers_player0_colors,y;
   asm sta COLUP0;
   asm stx GRP0;

   PF1 := TEMPLATE_left1;

#if TEMPLATE_number_of_scanlines == 4
   asm .repeat 2;
   asm bit.a CXM0P;
   asm .endrepeat;
   asm nop;

   asm @last_two_pixels_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
   $X := TEMPLATE_pf_right1;
   asm @last_two_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm stx PF1;
   asm bcc.same @last_two_p1_on;
   asm opAB #0;
   asm tay;
   asm lda.z layers_player1_blank_color;
   asm bcs.same @last_two_p1_ready;
   asm @second_no_event:;
   asm lda.z layers_current_mask;
   asm bit.a CXM0P;
   asm bit.z $00;
   asm jmp @second_event_ready;

   asm @last_two_p1_on:;
   asm opB3 (layers_player1_graphics),y;
   asm lda.ay layers_player1_colors,y;
   asm @last_two_p1_ready:;
   asm dec.z layers_player1_counter;
   asm dec.z layers_player0_counter;
   asm sta COLUP1;
   asm stx GRP1;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm asl;
   asm sta ENAM1;
   PF1 := TEMPLATE_left1;
   asm @last_two_left_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.a layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @last_two_p0_on;
   asm ldy #0;
   asm bcs.same @last_two_p0_ready;



   asm @last_two_p0_on:;
   asm bit.a CXM0P;
   asm @last_two_p0_ready:;
   asm opB3 (layers_player0_graphics),y;
   asm @last_two_odd_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm @last_two_odd_right1_barrier:;
   PF1 := TEMPLATE_right1;

#else
   asm @init_count_barrier:;
   layers_section_remaining := TEMPLATE_number_of_scanlines / 2 - 2;
   asm bit.z $00;
   asm nop;
   asm @normal_pixels:;

   PF2 := TEMPLATE_left2;
   asm ldy.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
   $X := TEMPLATE_pf_right1;
   asm @normal_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm stx PF1;
   asm bcc.same @normal_p1_on;
   asm opAB #0;
   asm tay;
   asm lda.z layers_player1_blank_color;
   asm bcs.same @normal_p1_ready;
   asm @second_no_event:;
   asm lda.z layers_current_mask;
   asm bit.a CXM0P;
   asm bit.z $00;
   asm jmp @second_event_ready;

   asm @normal_p1_on:;
   asm opB3 (layers_player1_graphics),y;
   asm lda.ay layers_player1_colors,y;
   asm @normal_p1_ready:;
   asm dec.z layers_player1_counter;
   asm dec.z layers_player0_counter;
   asm sta COLUP1;
   asm stx GRP1;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm asl;
   asm sta ENAM1;
   PF1 := TEMPLATE_left1;
   asm @normal_left_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.a layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @normal_p0_on;
   asm ldy #0;
   asm bcs.same @normal_p0_ready;


   asm @loop_no_event:;
   asm lda.z layers_current_mask;
   asm bit.a CXM0P;
   asm bit.z $00;
   asm jmp @loop_event_ready;


   asm @normal_p0_on:;
   asm bit.a CXM0P;
   asm @normal_p0_ready:;
   asm opB3 (layers_player0_graphics),y;
   asm @normal_odd_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm @normal_odd_right1_barrier:;
   PF1 := TEMPLATE_right1;

   asm dec.z layers_run_remaining;
   asm bne.same @loop_no_event;
   asm pla;
   asm sta.z layers_run_remaining;
   asm pla;
   asm sta.z layers_current_mask;
   asm @loop_event_ready:;
   asm lsr;
   asm sta ENAM0;
   asm lda.ay layers_player0_colors,y;
   asm sta COLUP0;
   asm stx GRP0;

   PF1 := TEMPLATE_left1;
   asm dec.z layers_section_remaining;
   asm beq.same @terminal;
   asm jmp @normal_pixels;
   asm @terminal:;
   asm nop;

   PF2 := TEMPLATE_left2;
   asm ldy.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
   $X := TEMPLATE_pf_right1;
   asm @last_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm stx PF1;
   asm bcc.same @last_p1_on;
   asm opAB #0;
   asm tay;
   asm lda.z layers_player1_blank_color;
   asm bcs.same @last_p1_ready;
   asm @last_p1_on:;
   asm opB3 (layers_player1_graphics),y;
   asm lda.ay layers_player1_colors,y;
   asm @last_p1_ready:;
   asm dec.z layers_player1_counter;
   asm dec.z layers_player0_counter;
   asm sta COLUP1;
   asm stx GRP1;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm asl;
   asm sta ENAM1;
   PF1 := TEMPLATE_left1;
   asm @last_left_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.a layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @last_p0_on;
   asm ldy #0;
   asm bcs.same @last_p0_ready;


   asm @last_p0_on:;
   asm bit.a CXM0P;
   asm @last_p0_ready:;
   asm opB3 (layers_player0_graphics),y;
   asm @last_odd_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm @last_odd_right1_barrier:;
   PF1 := TEMPLATE_right1;

#endif
#endif
}

inline void TEMPLATE_draw(void) {

   asm dec.z layers_run_remaining;
   asm bne.same @boundary_no_event;
   asm pla;
   asm sta.z layers_run_remaining;
   asm pla;
   asm sta.z layers_current_mask;
   asm @boundary_event_ready:;
   asm lsr;
   asm sta ENAM0;
   asm lda.ay layers_player0_colors,y;
   asm sta COLUP0;
   asm stx GRP0;

   COLUBK := TEMPLATE_bk_color;
   asm @boundary_bk_barrier:;
   PF1 := TEMPLATE_left1;
   asm @boundary_pf_barrier:;
   COLUPF := TEMPLATE_pf_color;

   asm @first_pixels_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
   $X := TEMPLATE_pf_right1;
   asm @first_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm stx PF1;
   asm bcc.same @first_p1_on;
   asm opAB #0;
   asm tay;
   asm lda.z layers_player1_blank_color;
   asm bcs.same @first_p1_ready;
   asm @boundary_no_event:;
   asm lda.z layers_current_mask;
   asm bit.a CXM0P;
   asm bit.z $00;
   asm jmp @boundary_event_ready;

   asm @first_p1_on:;
   asm opB3 (layers_player1_graphics),y;
   asm lda.ay layers_player1_colors,y;
   asm @first_p1_ready:;
   asm dec.z layers_player1_counter;
   asm dec.z layers_player0_counter;
   asm sta COLUP1;
   asm stx GRP1;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm asl;
   asm sta ENAM1;
   PF1 := TEMPLATE_left1;
   asm @first_left_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.a layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @first_p0_on;
   asm ldy #0;
   asm bcs.same @first_p0_ready;



   asm @first_p0_on:;
   asm bit.a CXM0P;
   asm @first_p0_ready:;
   asm opB3 (layers_player0_graphics),y;
   asm @first_odd_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm @first_odd_right1_barrier:;
   PF1 := TEMPLATE_right1;

#if TEMPLATE_number_of_scanlines > 2

   asm dec.z layers_run_remaining;
   asm bne.same @second_no_event;
   asm pla;
   asm sta.z layers_run_remaining;
   asm pla;
   asm sta.z layers_current_mask;
   asm @second_event_ready:;
   asm lsr;
   asm sta ENAM0;
   asm lda.ay layers_player0_colors,y;
   asm sta COLUP0;
   asm stx GRP0;

   PF1 := TEMPLATE_left1;

#if TEMPLATE_number_of_scanlines == 4
   asm .repeat 2;
   asm bit.a CXM0P;
   asm .endrepeat;
   asm nop;

   asm @last_two_pixels_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
   $X := TEMPLATE_pf_right1;
   asm @last_two_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm stx PF1;
   asm bcc.same @last_two_p1_on;
   asm opAB #0;
   asm tay;
   asm lda.z layers_player1_blank_color;
   asm bcs.same @last_two_p1_ready;
   asm @second_no_event:;
   asm lda.z layers_current_mask;
   asm bit.a CXM0P;
   asm bit.z $00;
   asm jmp @second_event_ready;

   asm @last_two_p1_on:;
   asm opB3 (layers_player1_graphics),y;
   asm lda.ay layers_player1_colors,y;
   asm @last_two_p1_ready:;
   asm dec.z layers_player1_counter;
   asm dec.z layers_player0_counter;
   asm sta COLUP1;
   asm stx GRP1;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm asl;
   asm sta ENAM1;
   PF1 := TEMPLATE_left1;
   asm @last_two_left_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.a layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @last_two_p0_on;
   asm ldy #0;
   asm bcs.same @last_two_p0_ready;



   asm @last_two_p0_on:;
   asm bit.a CXM0P;
   asm @last_two_p0_ready:;
   asm opB3 (layers_player0_graphics),y;
   asm @last_two_odd_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm @last_two_odd_right1_barrier:;
   PF1 := TEMPLATE_right1;

#else
   asm @init_count_barrier:;
   layers_section_remaining := TEMPLATE_number_of_scanlines / 2 - 2;
   asm bit.z $00;
   asm nop;
   asm @normal_pixels:;

   PF2 := TEMPLATE_left2;
   asm ldy.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
   $X := TEMPLATE_pf_right1;
   asm @normal_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm stx PF1;
   asm bcc.same @normal_p1_on;
   asm opAB #0;
   asm tay;
   asm lda.z layers_player1_blank_color;
   asm bcs.same @normal_p1_ready;
   asm @second_no_event:;
   asm lda.z layers_current_mask;
   asm bit.a CXM0P;
   asm bit.z $00;
   asm jmp @second_event_ready;

   asm @normal_p1_on:;
   asm opB3 (layers_player1_graphics),y;
   asm lda.ay layers_player1_colors,y;
   asm @normal_p1_ready:;
   asm dec.z layers_player1_counter;
   asm dec.z layers_player0_counter;
   asm sta COLUP1;
   asm stx GRP1;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm asl;
   asm sta ENAM1;
   PF1 := TEMPLATE_left1;
   asm @normal_left_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.a layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @normal_p0_on;
   asm ldy #0;
   asm bcs.same @normal_p0_ready;


   asm @loop_no_event:;
   asm lda.z layers_current_mask;
   asm bit.a CXM0P;
   asm bit.z $00;
   asm jmp @loop_event_ready;


   asm @normal_p0_on:;
   asm bit.a CXM0P;
   asm @normal_p0_ready:;
   asm opB3 (layers_player0_graphics),y;
   asm @normal_odd_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm @normal_odd_right1_barrier:;
   PF1 := TEMPLATE_right1;

   asm dec.z layers_run_remaining;
   asm bne.same @loop_no_event;
   asm pla;
   asm sta.z layers_run_remaining;
   asm pla;
   asm sta.z layers_current_mask;
   asm @loop_event_ready:;
   asm lsr;
   asm sta ENAM0;
   asm lda.ay layers_player0_colors,y;
   asm sta COLUP0;
   asm stx GRP0;

   PF1 := TEMPLATE_left1;
   asm dec.z layers_section_remaining;
   asm beq.same @terminal;
   asm jmp @normal_pixels;
   asm @terminal:;
   asm nop;

   PF2 := TEMPLATE_left2;
   asm ldy.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
   $X := TEMPLATE_pf_right1;
   asm @last_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm stx PF1;
   asm bcc.same @last_p1_on;
   asm opAB #0;
   asm tay;
   asm lda.z layers_player1_blank_color;
   asm bcs.same @last_p1_ready;
   asm @last_p1_on:;
   asm opB3 (layers_player1_graphics),y;
   asm lda.ay layers_player1_colors,y;
   asm @last_p1_ready:;
   asm dec.z layers_player1_counter;
   asm dec.z layers_player0_counter;
   asm sta COLUP1;
   asm stx GRP1;
   asm lda.z layers_current_mask;
   asm sta ENABL;
   asm asl;
   asm sta ENAM1;
   PF1 := TEMPLATE_left1;
   asm @last_left_barrier:;
   PF2 := TEMPLATE_left2;
   asm ldy.a layers_player0_counter;
   asm cpy.z layers_player0_limit;
   asm bcc.same @last_p0_on;
   asm ldy #0;
   asm bcs.same @last_p0_ready;


   asm @last_p0_on:;
   asm bit.a CXM0P;
   asm @last_p0_ready:;
   asm opB3 (layers_player0_graphics),y;
   asm @last_odd_right_barrier:;
   PF2 := TEMPLATE_right2;
   asm @last_odd_right1_barrier:;
   PF1 := TEMPLATE_right1;

#endif
#endif
}
