// Experimental SINGLE shared object-state owner. Include once, not once per
// section. Include vcs.c26 first. Preparation is not a visible renderer.
// The public coordinates/heights/pointers are never biased in place.
// Coordinates use the ancestor's two-scanline units. Heights are inclusive
// extent limits (player height 7 selects eight rows, with row zero blank).
// Player graphics must obey the ancestor's indexed-read page contract; this
// preparer neither reads nor copies graphics or colour tables.
uint8_t layers_object_x[5];
uint8_t layers_player0_y;
uint8_t layers_player1_y;
uint8_t layers_missile1_height;
uint8_t layers_missile1_y;
uint8_t layers_ball_y;
uint8_t *layers_player0_graphics;
uint8_t *layers_player1_graphics;
uint8_t layers_player0_height;
uint8_t layers_player1_height;
uint8_t layers_missile0_height;
uint8_t layers_missile0_y;
uint8_t layers_ball_height;

// The certified three-object mask representation: each eight-pair group has
// BL/M1/M0 streams, then packed eighth bits in D1/D2/D3 respectively.
uint8_t layers_object_masks[48];
uint8_t layers_ball_bits;
uint8_t layers_missile1_bits;
uint8_t layers_missile0_bits;
uint8_t layers_player0_counter;
uint8_t layers_player1_counter;
uint8_t layers_player0_limit;
uint8_t layers_player1_limit;

// Cycle-transparent drawing primitives. Each consumes ONE shared player row,
// takes exactly eleven cycles, preserves A/X, and returns Y=the next graphics
// index and C=(index >= limit). No private copy or per-section reset is allowed.
// The caller must preserve C until selecting the active/blank graphics path.
// These do not write graphics/colours: their deadlines belong to the enclosing
// drawing schedule, which can separate the counter test from the TIA stores.
inline void layers_step_player0(void) {
   asm ldy.z layers_player0_counter;
   asm dey;
   asm sty.z layers_player0_counter;
   asm cpy.z layers_player0_limit;
}

inline void layers_step_player1(void) {
   asm ldy.z layers_player1_counter;
   asm dey;
   asm sty.z layers_player1_counter;
   asm cpy.z layers_player1_limit;
}

inline void layers_prepare_vertical(void) {
   // Local JSR helpers use six stack bytes at peak (including the first JSR).
   asm .callstackextra 4;
   asm jsr @build_masks;
   asm jmp @built;
   asm @build_masks:;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx layers_object_masks,x;
   asm sty.zx layers_object_masks + 1,x;
   asm sty.zx layers_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #48;
   asm bcc.same @clear;
   // Ball needs one additional pair of lookahead for VDELBL.
   asm lda #96;
   asm sta.z layers_object_masks + 31;
   asm lda.z layers_ball_y;
   asm clc;
   asm adc #2;
   asm ldy.z layers_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   asm lda #96;
   asm sta.z layers_object_masks + 31;
   asm lda.z layers_missile1_y;
   asm clc;
   asm adc #1;
   asm ldy.z layers_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z layers_missile0_y;
   asm clc;
   asm adc #1;
   asm ldy.z layers_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm rts;
   asm @prepare_one:;
   asm sta.z layers_object_masks + 11;
   asm stx.z layers_object_masks + 3;
   asm sty.z layers_object_masks + 35;
   asm sec;
   asm sbc.z layers_object_masks + 35;
   asm sta.z layers_object_masks + 7;
   asm sta.z layers_object_masks + 39;
   asm cmp.z layers_object_masks + 11;
   asm bcc.same @no_wrap;
   asm beq.same @no_wrap;
   asm lda.z layers_object_masks + 11;
   asm beq.same @wrapped_high;
   asm cmp.z layers_object_masks + 31;
   asm bcc.same @wrapped_low_ready;
   asm beq.same @wrapped_low_ready;
   asm lda.z layers_object_masks + 31;
   asm sta.z layers_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z layers_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z layers_object_masks + 39;
   asm cmp.z layers_object_masks + 31;
   asm bcc.same @wrapped_high_ready;
   asm beq.same @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z layers_object_masks + 7;
   asm lda.z layers_object_masks + 31;
   asm sta.z layers_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z layers_object_masks + 7;
   asm bne.same @first_ready;
   asm lda #1;
   asm sta.z layers_object_masks + 7;
   asm @first_ready:;
   asm lda.z layers_object_masks + 11;
   asm cmp.z layers_object_masks + 31;
   asm bcc.same @last_ready;
   asm beq.same @last_ready;
   asm lda.z layers_object_masks + 31;
   asm sta.z layers_object_masks + 11;
   asm @last_ready:;
   asm lda.z layers_object_masks + 7;
   asm cmp.z layers_object_masks + 11;
   asm bcc.same @set_range;
   asm beq.same @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z layers_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z layers_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z layers_object_masks + 15;
   asm lda.z layers_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z layers_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z layers_object_masks + 19;
   asm lda.z layers_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z layers_object_masks + 3;
   asm tax;
   asm lda.z layers_object_masks + 15;
   asm cmp.z layers_object_masks + 19;
   asm bne.same @many;
   asm lda.z layers_object_masks + 23;
   asm and.z layers_object_masks + 27;
   asm ora.zx layers_object_masks,x;
   asm sta.zx layers_object_masks,x;
   asm rts;
   asm @many:;
   asm lda.zx layers_object_masks,x;
   asm ora.z layers_object_masks + 23;
   asm sta.zx layers_object_masks,x;
   asm inc.z layers_object_masks + 15;
   asm @middle:;
   asm lda.z layers_object_masks + 15;
   asm cmp.z layers_object_masks + 19;
   asm bcs.same @last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx layers_object_masks,x;
   asm inc.z layers_object_masks + 15;
   asm jmp @middle;
   asm @last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx layers_object_masks,x;
   asm ora.z layers_object_masks + 27;
   asm sta.zx layers_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm @built:;
   asm ldx #0;
   asm @encode:;
   asm asl.zx layers_object_masks + 2,x;
   asm lda #0;
   asm rol;
   asm asl.zx layers_object_masks + 1,x;
   asm rol;
   asm asl.zx layers_object_masks,x;
   asm rol;
   asm asl;
   asm sta.zx layers_object_masks + 3,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #48;
   asm bcc.same @encode;
   asm lda.z layers_object_masks;
   asm sta.z layers_ball_bits;
   asm lda.z layers_object_masks + 1;
   asm sta.z layers_missile1_bits;
   asm lda.z layers_object_masks + 2;
   asm sta.z layers_missile0_bits;
   asm lda.z layers_player0_y;
   asm sta.z layers_player0_counter;
   asm lda.z layers_player1_y;
   asm clc;
   asm adc #1;
   asm sta.z layers_player1_counter;
   asm lda.z layers_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z layers_player0_limit;
   asm lda.z layers_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z layers_player1_limit;
}
