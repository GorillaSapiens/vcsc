// Atari 2600 / VCS TIA register bindings through the $40-$7F mirror.
//
// This file assumes the target has already defined the core 6502-sized types
// such as `int8_t`, `int16_t`, `int24_t`, and pointers. `vcs.c26` provides those for the
// stock target; isolated compiler tests may provide their own fixture machine.
//
// The classic 3F mapper claims the entire $00-$3F page in Stella and classic
// 3F software therefore uses the equivalent $40-$7F TIA mirror.  Keep the
// ordinary canonical names while binding them to that mirror.

// write-only TIA registers (mirrored at $40-$6C)
uint8_t VSYNC @[none/0x40];
uint8_t VBLANK@[none/0x41];
uint8_t WSYNC @[none/0x42];
uint8_t RSYNC @[none/0x43];
uint8_t NUSIZ0@[none/0x44];
uint8_t NUSIZ1@[none/0x45];
uint8_t COLUP0@[none/0x46];
uint8_t COLUP1@[none/0x47];
uint8_t COLUPF@[none/0x48];
uint8_t COLUBK@[none/0x49];
uint8_t CTRLPF@[none/0x4A];
uint8_t REFP0 @[none/0x4B];
uint8_t REFP1 @[none/0x4C];
uint8_t PF0   @[none/0x4D];
uint8_t PF1   @[none/0x4E];
uint8_t PF2   @[none/0x4F];
uint8_t RESP0 @[none/0x50];
uint8_t RESP1 @[none/0x51];
uint8_t RESM0 @[none/0x52];
uint8_t RESM1 @[none/0x53];
uint8_t RESBL @[none/0x54];
uint8_t AUDC0 @[none/0x55];
uint8_t AUDC1 @[none/0x56];
uint8_t AUDF0 @[none/0x57];
uint8_t AUDF1 @[none/0x58];
uint8_t AUDV0 @[none/0x59];
uint8_t AUDV1 @[none/0x5A];
uint8_t GRP0  @[none/0x5B];
uint8_t GRP1  @[none/0x5C];
uint8_t ENAM0 @[none/0x5D];
uint8_t ENAM1 @[none/0x5E];
uint8_t ENABL @[none/0x5F];
uint8_t HMP0  @[none/0x60];
uint8_t HMP1  @[none/0x61];
uint8_t HMM0  @[none/0x62];
uint8_t HMM1  @[none/0x63];
uint8_t HMBL  @[none/0x64];
uint8_t VDELP0@[none/0x65];
uint8_t VDELP1@[none/0x66];
uint8_t VDELBL@[none/0x67];
uint8_t RESMP0@[none/0x68];
uint8_t RESMP1@[none/0x69];
uint8_t HMOVE @[none/0x6A];
uint8_t HMCLR @[none/0x6B];
uint8_t CXCLR @[none/0x6C];

// read-only TIA registers (mirrored at $70-$7D)
uint8_t CXM0P @[0x70/none];
uint8_t CXM1P @[0x71/none];
uint8_t CXP0FB@[0x72/none];
uint8_t CXP1FB@[0x73/none];
uint8_t CXM0FB@[0x74/none];
uint8_t CXM1FB@[0x75/none];
uint8_t CXBLPF@[0x76/none];
uint8_t CXPPMM@[0x77/none];
uint8_t INPT0 @[0x78/none];
uint8_t INPT1 @[0x79/none];
uint8_t INPT2 @[0x7A/none];
uint8_t INPT3 @[0x7B/none];
uint8_t INPT4 @[0x7C/none];
uint8_t INPT5 @[0x7D/none];
