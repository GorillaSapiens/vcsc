// Reusable right-justified six-glyph TIA display component.
//
// Instantiate this source with:
//
//     instantiate "six_glyph_right_component.c26" as score1
//
// Include one fonts/*_decimal.c26 or fonts/*_hex.c26 module first; it
// must define the shared page-contained score_font table.  Each instance owns
// its score, color, two one-byte glyph offsets, four 16-bit glyph pointers, and delayed glyph byte.
//
// Visible contract: enter TEMPLATE_draw at the canonical cycle-3 phase with
// VBLANK clear. It consumes glyph_rows+3 scanlines and returns at cycle zero
// of the following line. Use vcs_ntsc_component_handoff() before an adjacent
// visible component. It owns P0/P1 graphics, colors, reflection, VDEL, NUSIZ,
// horizontal motion, and RESP0/RESP1 while drawing. It may leave all of that
// P0/P1 state clobbered.
// It preserves playfield, missile, and Ball state, flushes GRP0/GRP1, and
// disables player VDEL before returning. It never touches VSYNC, VBLANK, the RIOT timer, or collision
// latches.  A/X/Y and arithmetic flags are clobbered; hardware stack depth is
// unchanged at lifecycle boundaries.

// Normal score use keeps compact page-contained-font storage. Set this to
// zero only for applications that deliberately replace all six glyph pointers
// with another page-contained glyph table (the fingerprint logo does this).
parameter compact_font := 1;
// Number of stored and rendered rows per glyph. Default score fonts use eight;
// shorter fonts are tightly packed and automatically use the full-pointer path.
parameter glyph_rows := 8;

// The machine-readable visible handoff fields below are defined in
// renderers/COMPONENT_CONVERSION.md under "Measured visible-component handoff".
#if TEMPLATE_glyph_rows == 1
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 4
#elif TEMPLATE_glyph_rows == 2
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 5
#elif TEMPLATE_glyph_rows == 3
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 6
#elif TEMPLATE_glyph_rows == 4
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 7
#elif TEMPLATE_glyph_rows == 5
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 8
#elif TEMPLATE_glyph_rows == 6
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 9
#elif TEMPLATE_glyph_rows == 7
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 10
#elif TEMPLATE_glyph_rows == 8
alias TEMPLATE_VISIBLE_SCANLINES_VALUE 11
#else
extern const uint8_t TEMPLATE_glyph_rows_must_be_1_through_8[TEMPLATE_glyph_rows];
#endif

enum TEMPLATE_contract {
   TEMPLATE_VISIBLE_SCANLINES := TEMPLATE_VISIBLE_SCANLINES_VALUE,
   TEMPLATE_DRAW_ENTRY_CYCLE := 3,
   TEMPLATE_DRAW_RETURN_CYCLE := 0,
   TEMPLATE_DRAW_COMPLETE_SCANLINES := TEMPLATE_VISIBLE_SCANLINES_VALUE,
   TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES := 0,
   TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES := 0,
   TEMPLATE_DRAW_TERMINAL_WSYNC := 1,
   TEMPLATE_DRAW_HMOVE_COUNT := 1,
   TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE := 1,
   TEMPLATE_VBLANK_MAX_CYCLES := 260,
   TEMPLATE_OVERSCAN_MAX_CYCLES := 0
};

#if TEMPLATE_compact_font && TEMPLATE_glyph_rows == 8
recommend bcd24_t TEMPLATE_score := 0;
// Digits 1/2 are page-contained font offsets (digit*8). Digits 3..6 retain
// complete pointers for the cycle-dense post-WSYNC half of each glyph row.
uint8_t TEMPLATE_offsets[2];
uint16_t TEMPLATE_pointers[4];
uint8_t TEMPLATE_delayed;
recommend uint8_t TEMPLATE_color := 0x0e;

#else
recommend bcd24_t TEMPLATE_score := 0;
recommend uint8_t TEMPLATE_color := 0x0e;
uint16_t TEMPLATE_pointers[6];
uint8_t TEMPLATE_delayed;

#endif

#if TEMPLATE_glyph_rows != 8
// Non-native-height score fonts are tightly packed: digit N starts at
// N*glyph_rows. Native-height instantiations omit this table and retain their
// established pointer-generation code byte-for-byte.
const uint8_t TEMPLATE_glyph_offsets[10] := {
   0,
   TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows,
   TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows + TEMPLATE_glyph_rows
};
#endif

static inline void TEMPLATE_prepare_pointers(void) {
#if TEMPLATE_compact_font && TEMPLATE_glyph_rows == 8

   // Digits 1/2: only digit*8 is needed because score_font is page-contained.
   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm sta TEMPLATE_offsets;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm sta TEMPLATE_offsets+1;

   // Digits 3/4 retain complete pointers.
   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   // Digits 5/6 retain complete pointers.
   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;
#else

   // Build six complete 16-bit pointers in human digit order. Packed BCD is
   // little-endian, so score+2 supplies digits 1/2 and score supplies 5/6.
   asm lda TEMPLATE_score+2;
   asm tax;
   asm and #$f0;
#if TEMPLATE_glyph_rows == 8
   asm lsr;
#else
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+1;
   asm txa;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+3;

   asm lda TEMPLATE_score+1;
   asm tax;
   asm and #$f0;
#if TEMPLATE_glyph_rows == 8
   asm lsr;
#else
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+5;
   asm txa;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+7;

   asm lda TEMPLATE_score;
   asm tax;
   asm and #$f0;
#if TEMPLATE_glyph_rows == 8
   asm lsr;
#else
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+9;
   asm txa;
   asm and #$0f;
#if TEMPLATE_glyph_rows == 8
   asm asl;
   asm asl;
   asm asl;
#else
   asm tay;
   asm lda.ay TEMPLATE_glyph_offsets,y;
#endif
   asm clc;
   asm adc #<score_font;
   asm sta TEMPLATE_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta TEMPLATE_pointers+11;
#endif
}

require inline void TEMPLATE_init(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare_pointers();
}

require inline void TEMPLATE_draw(void) {


   // Position P0 at x=112 and P1 at x=120, so the final P1 copy ends at
   // x=159. These calibrated fine-motion values compensate for the eleven-NOP
   // coarse-position delay and consecutive RESP strobes.
   asm lda #$03;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   // Clear HMxx and preserve the original positioning phase. The
   // mutable color is loaded after RESP0/RESP1 so its extra zero-page cycle
   // cannot move the right-justified score.
   asm sta HMCLR;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm lda #$c0;
   asm sta HMP0;
   asm lda #$d0;
   asm sta HMP1;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
   asm lda.z TEMPLATE_color;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta WSYNC;

   // Apply motion, clear both player pipelines, enable VDEL, and preload the
   // first glyph. The eight visible rows are unrolled so row-to-row setup can
   // straddle the scanline boundary while the four late writes remain inside
   // the narrow copy-update windows at the right edge.
   asm sta HMOVE;
   asm lda #0;
   asm sta GRP0;
   asm sta GRP1;
   asm sta GRP0;
   // Preserve the former eight-cycle color reload while clearing reflection.
   asm sta REFP0;
   asm sta REFP1;
   asm nop;
   asm lda #1;
   asm sta VDELP0;
   asm sta VDELP1;
#if TEMPLATE_compact_font && TEMPLATE_glyph_rows == 8
   asm ldy TEMPLATE_offsets;
   asm lda score_font+7,y;
   asm sta GRP0;
   asm sta WSYNC;

   // Glyph row 1: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+7,y;
   asm ldy #7;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Glyph row 2: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm ldy TEMPLATE_offsets;
   asm lda score_font+6,y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+6,y;
   asm ldy #6;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Glyph row 3: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm ldy TEMPLATE_offsets;
   asm lda score_font+5,y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+5,y;
   asm ldy #5;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Glyph row 4: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm ldy TEMPLATE_offsets;
   asm lda score_font+4,y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+4,y;
   asm ldy #4;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Glyph row 5: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm ldy TEMPLATE_offsets;
   asm lda score_font+3,y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+3,y;
   asm ldy #3;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Glyph row 6: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm ldy TEMPLATE_offsets;
   asm lda score_font+2,y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+2,y;
   asm ldy #2;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Glyph row 7: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm ldy TEMPLATE_offsets;
   asm lda score_font+1,y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+1,y;
   asm ldy #1;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   // Glyph row 8: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm ldy TEMPLATE_offsets;
   asm lda score_font+0,y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm ldy TEMPLATE_offsets+1;
   asm lda score_font+0,y;
   asm ldy #0;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$4),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$6),y;
#else
#if TEMPLATE_glyph_rows == 1
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 2
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 3
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #4;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #5;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #6;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #7;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;

   // Glyph row 1: TIA write events land at CPU cycles 55, 58, 61, and 64.
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;

   #if TEMPLATE_glyph_rows >= 2
// Glyph row 2: TIA write events land at CPU cycles 55, 58, 61, and 64.
#if TEMPLATE_glyph_rows == 2
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 3
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #4;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #5;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #6;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#endif

#if TEMPLATE_glyph_rows >= 3
// Glyph row 3: TIA write events land at CPU cycles 55, 58, 61, and 64.
#if TEMPLATE_glyph_rows == 3
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 4
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #4;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #5;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#endif

#if TEMPLATE_glyph_rows >= 4
// Glyph row 4: TIA write events land at CPU cycles 55, 58, 61, and 64.
#if TEMPLATE_glyph_rows == 4
   asm ldy #0;
#elif TEMPLATE_glyph_rows == 5
   asm ldy #1;
#elif TEMPLATE_glyph_rows == 6
   asm ldy #2;
#elif TEMPLATE_glyph_rows == 7
   asm ldy #3;
#elif TEMPLATE_glyph_rows == 8
   asm ldy #4;
#endif
   asm lda (TEMPLATE_pointers),y;
   asm sta GRP0;
   asm bit TEMPLATE_delayed;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm lda (TEMPLATE_pointers+$2),y;
   asm sta GRP1;
   asm lda (TEMPLATE_pointers+$4),y;
   asm sta GRP0;
   asm lda (TEMPLATE_pointers+$6),y;
   asm sta TEMPLATE_delayed;
   asm lda (TEMPLATE_pointers+$8),y;
   asm tax;
   asm lda (TEMPLATE_pointers+$a),y;
   asm tay;
   asm lda TEMPLATE_delayed;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
#endif

#if TEMPLATE_glyph_rows >= 5
