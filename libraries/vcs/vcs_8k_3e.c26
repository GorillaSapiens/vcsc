// Classic 3E reserves $3E/$3F in the low TIA page for mapper control.
// Use the equivalent $40-$7F TIA mirror for ordinary TIA accesses so
// display timing does not depend on an emulator forwarding those writes.
alias VCS_TIA_USE_40_MIRROR 1
include "vcs.c26"

// Tigervision 3E, certified 8K ROM shape: the same four physical 2K ROM chunks
// as 3F, plus up to 32 independently selected 1K cartridge-RAM banks.  Writing
// a ROM-bank value to TIA $3F maps that 2K ROM chunk into $1000-$17FF; writing
// a RAM-bank value to TIA $3E instead maps its read alias at $1000-$13FF and
// write alias at $1400-$17FF.  The final physical 2K ROM remains fixed at
// $1800-$1FFF and owns startup/vectors.
cartridge { $fill:0xff $signature:3E };

bank bank0 { $image_size:0x0800 $file_index:0 $image_offset:0 $link_start:0x9000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank1 { $image_size:0x0800 $file_index:1 $image_offset:0 $link_start:0xb000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank2 { $image_size:0x0800 $file_index:2 $image_offset:0 $link_start:0xd000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank3 { $image_size:0x0800 $file_index:3 $image_offset:0 $link_start:0xf800 $cpu_start:0x1800 $map_size:0x0800 $startup };

mem bank0 { $start:0x9000 $size:0x0800 $ro };
mem bank1 { $start:0xb000 $size:0x0800 $ro };
mem bank2 { $start:0xd000 $size:0x0800 $ro };
mem bank3 { $start:0xf800 $size:0x07f8 $ro $priority:2 };
