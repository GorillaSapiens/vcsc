// Classic 3E reserves $3E/$3F in the low TIA page for mapper control.
// Use the equivalent $40-$7F TIA mirror for ordinary TIA accesses so
// display timing does not depend on an emulator forwarding those writes.
alias VCS_TIA_USE_40_MIRROR 1
include "vcs.c26"

// Tigervision 3E, certified 16K shape: eight physical 2K ROM chunks.
// Physical banks 0-6 are selectable in the lower $1000-$17FF window;
// physical bank 7 is also selectable there and is permanently mapped at
// $1800-$1FFF.  The distinct 6507 mirror aliases preserve physical-bank
// identity for ordinary 16-bit VCSC symbols.
cartridge { $fill:0xff $signature:3E };

bank bank0 { $image_size:0x0800 $file_index:0 $image_offset:0 $link_start:0x1000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank1 { $image_size:0x0800 $file_index:1 $image_offset:0 $link_start:0x3000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank2 { $image_size:0x0800 $file_index:2 $image_offset:0 $link_start:0x5000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank3 { $image_size:0x0800 $file_index:3 $image_offset:0 $link_start:0x7000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank4 { $image_size:0x0800 $file_index:4 $image_offset:0 $link_start:0x9000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank5 { $image_size:0x0800 $file_index:5 $image_offset:0 $link_start:0xb000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank6 { $image_size:0x0800 $file_index:6 $image_offset:0 $link_start:0xd000 $cpu_start:0x1000 $map_size:0x0800 };
bank bank7 { $image_size:0x0800 $file_index:7 $image_offset:0 $link_start:0xf800 $cpu_start:0x1800 $map_size:0x0800 $startup };

mem bank0 { $start:0x1000 $size:0x0800 $ro };
mem bank1 { $start:0x3000 $size:0x0800 $ro };
mem bank2 { $start:0x5000 $size:0x0800 $ro };
mem bank3 { $start:0x7000 $size:0x0800 $ro };
mem bank4 { $start:0x9000 $size:0x0800 $ro };
mem bank5 { $start:0xb000 $size:0x0800 $ro };
mem bank6 { $start:0xd000 $size:0x0800 $ro };
mem bank7 { $start:0xf800 $size:0x07f8 $ro $priority:2 };
mem swapram { $size:0x8000 $bank_size:0x0400 $rw $swapram };
