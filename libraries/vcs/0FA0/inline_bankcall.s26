;
; Descriptor-ABI cross-bank JSR/RTS trampoline for Brazilian Fotomania 0FA0.
;
; The caller emits JSR __bankcall followed by a three-byte .banktarget payload:
; 16-bit target address, then the destination bank-call descriptor. 0FA0 uses
; the low byte of its canonical selector alias as the descriptor: $A0 selects
; physical/file bank 0 (logical bank1) through $0FA0 and $C0 selects physical/
; file bank 1 (logical/startup bank0) through $0FC0. Selecting/restoring a bank
; is therefore an indexed read from $0F00. Each replicated trampoline copy has
; its source-bank descriptor patched into the immediate operand below; no bank
; identity is inferred from the caller, callee, or return PC.
;
; Selector accesses must remain reads because 0FA0 decodes below-cartridge
; console addresses. LDA $0F00,Y performs the required non-destructive selector
; read through the canonical alias family; the broader hardware alias mask is
; a simulator/disassembler concern.

.ifndef VCSC_BANKCALL_PTR0
VCSC_BANKCALL_PTR0 = $0080
.endif
.ifndef VCSC_BANKCALL_SELECTOR_BASE
VCSC_BANKCALL_SELECTOR_BASE = $0F00
.endif
.ifndef VCSC_BANKCALL_SOURCE_DESCRIPTOR
VCSC_BANKCALL_SOURCE_DESCRIPTOR = $C0
.endif

.segmentdef "CODE", $6000, $0100
.segment "CODE"

.export __vcsc_generic_bankcall_begin
.export __vcsc_generic_bankreturn
.export __vcsc_generic_bankcall_switch_and_jump
.export __vcsc_generic_bankcall_end
.export __vcsc_generic_bankcall_reserved_end

__vcsc_generic_bankcall_begin:
    tsx
    lda $0101,x
    sta VCSC_BANKCALL_PTR0
    lda $0102,x
    sta VCSC_BANKCALL_PTR0 + 1

    lda $0101,x
    clc
    adc #3
    sta $0101,x
    bcc.same @return_adjusted
    inc $0102,x
@return_adjusted:

    ldy #1
    lda (VCSC_BANKCALL_PTR0),y
    tax
    iny
    lda (VCSC_BANKCALL_PTR0),y
    pha
    iny
    lda (VCSC_BANKCALL_PTR0),y
    tay
    pla
    sta VCSC_BANKCALL_PTR0 + 1
    stx VCSC_BANKCALL_PTR0

    lda #VCSC_BANKCALL_SOURCE_DESCRIPTOR
    pha

    jsr __vcsc_generic_bankcall_switch_and_jump

__vcsc_generic_bankreturn:
    sta VCSC_BANKCALL_PTR0
    stx VCSC_BANKCALL_PTR0 + 1
    pla
    tay
    lda VCSC_BANKCALL_SELECTOR_BASE,y
    lda VCSC_BANKCALL_PTR0
    ldx VCSC_BANKCALL_PTR0 + 1
    rts

__vcsc_generic_bankcall_switch_and_jump:
    lda VCSC_BANKCALL_SELECTOR_BASE,y
    jmp (VCSC_BANKCALL_PTR0)

__vcsc_generic_bankcall_end:
__vcsc_generic_bankcall_reserved_end = $6048
