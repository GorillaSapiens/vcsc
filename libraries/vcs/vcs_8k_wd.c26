// WD owns TIA reads at $30-$3F as arrangement selectors. Use the equivalent
// $40-$7F TIA mirror for ordinary TIA I/O so collision/input reads cannot
// change the ROM arrangement.
alias VCS_TIA_USE_40_MIRROR 1
include "vcs.c26"

// Wickstead Design / Pursuit of the Pink Panther: eight physical 1K ROM
// chunks arranged four at a time in the $1000-$1FFF cartridge window. Reads
// from TIA $30-$3F select one of eight complete four-segment arrangements;
// hardware applies the new arrangement only after the selector read has aged
// by at least three CPU cycles. Power-on arrangement 0 is 0,0,1,3, so physical
// chunk 3 supplies RESET/vectors in the top $1C00-$1FFF segment.
//
// WD also owns 64 bytes of split-address RAM: reads $1000-$103F, writes
// $1040-$107F. The ROM bytes under that window are hidden whenever a physical
// chunk occupies segment 0.
//
// These synthetic link addresses preserve each bank's chosen 6507 CPU-window
// alias while keeping all eight physical chunks distinct to the linker. VCSC
// does not synthesize WD arrangement transitions; explicitly banked code/data
// must be reached only after the program has selected an arrangement that maps
// the target physical chunk into its canonical CPU segment.
cartridge { $fill:0xff $signature:WD };

bank bank0 { $image_size:0x0400 $file_index:0 $image_offset:0 $link_start:0x1000 $cpu_start:0x1000 $map_size:0x0400 };
bank bank1 { $image_size:0x0400 $file_index:1 $image_offset:0 $link_start:0x3400 $cpu_start:0x1400 $map_size:0x0400 };
bank bank2 { $image_size:0x0400 $file_index:2 $image_offset:0 $link_start:0x5800 $cpu_start:0x1800 $map_size:0x0400 };
bank bank3 { $image_size:0x0400 $file_index:3 $image_offset:0 $link_start:0xfc00 $cpu_start:0x1c00 $map_size:0x0400 $startup };
bank bank4 { $image_size:0x0400 $file_index:4 $image_offset:0 $link_start:0x7400 $cpu_start:0x1400 $map_size:0x0400 };
bank bank5 { $image_size:0x0400 $file_index:5 $image_offset:0 $link_start:0x9c00 $cpu_start:0x1c00 $map_size:0x0400 };
bank bank6 { $image_size:0x0400 $file_index:6 $image_offset:0 $link_start:0xb800 $cpu_start:0x1800 $map_size:0x0400 };
bank bank7 { $image_size:0x0400 $file_index:7 $image_offset:0 $link_start:0xd000 $cpu_start:0x1000 $map_size:0x0400 };

// Segment-0 canonical banks lose their first $80 bytes to the RAM aliases.
mem bank0 { $start:0x1080 $size:0x0380 $ro };
mem bank1 { $start:0x3400 $size:0x0400 $ro };
mem bank2 { $start:0x5800 $size:0x0400 $ro };
// Physical chunk 3 owns the reset vectors at offsets $3FA-$3FF.
mem bank3 { $start:0xfc00 $size:0x03fa $ro $priority:2 };
mem bank4 { $start:0x7400 $size:0x0400 $ro };
mem bank5 { $start:0x9c00 $size:0x0400 $ro };
mem bank6 { $start:0xb800 $size:0x0400 $ro };
// Physical chunk 7 is the final file chunk, so reserve its final eight bytes
// for the VCSC profile signature. Its canonical segment-0 prefix is RAM-hidden.
mem bank7 { $start:0xd080 $size:0x0378 $ro };

mem cartram { $read_start:0xf000 $write_start:0xf040 $size:0x0040 $rw $read_hazard };
