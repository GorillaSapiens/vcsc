; vcsc-rt0.s26

.weak __nmi
.weak __irqbrk

.global __reset
.global __nmi
.global __irqbrk

.export __reset
.export __nmi
.export __irqbrk
.export __vcsc_startup_full

.import main

.import __copy_table
.import __zero_table
.import __stack_start
.import __init_table

; Stock startup deliberately selects only two generic zero-page pointers.  ptr0
; remains the current linker-table pointer while ptr1 is reconstructed as the
; active source/destination pointer.  Copying therefore trades reset-time ROM
; and cycles for four fewer permanently reserved RIOT bytes.
.importzp _vcsc_ptr0, _vcsc_ptr1

.include "../vcsc-runtime.inc"

.segment "CODE"

__vcsc_startup_full:
__reset:
   sei
   cld

   ; hardware stack at $01FF downward
   ldx #$ff
   txs

   ; ptr0 = __copy_table
   lda #<__copy_table
   sta ptr0
   lda #>__copy_table
   sta ptr0+1

_copy_record:
   ; A zero 16-bit count terminates the copy table.
   ldy #4
   lda (ptr0),y
   iny
   ora (ptr0),y
   beq _zero_setup

   ; X is the source/destination 256-byte page index.  Full pages use Y as
   ; the byte offset.  Reconstructing ptr1 for each byte keeps ptr0 available
   ; as the immutable record pointer and avoids ptr2/arg0/arg1 RAM entirely.
   ldx #0
_copy_page:
   ldy #5
   txa
   cmp (ptr0),y
   bcc _copy_full_page

   ; Final partial page.  X becomes the remaining low-byte count; this page's
   ; high-byte offset is the record's count-high value itself.
   ldy #4
   lda (ptr0),y
   beq _copy_record_done
   tax
   ldy #0
_copy_tail_loop:
   ; Preserve the data offset while using Y to address the startup record.
   tya
   pha
   ldy #0
   lda (ptr0),y
   sta ptr1
   iny
   lda (ptr0),y
   ldy #5
   clc
   adc (ptr0),y
   sta ptr1+1
   pla
   tay

   lda (ptr1),y
   pha
   tya
   pha
   ldy #2
   lda (ptr0),y
   sta ptr1
   iny
   lda (ptr0),y
   ldy #5
   clc
   adc (ptr0),y
   sta ptr1+1
   pla
   tay
   pla
   sta (ptr1),y
   iny
   dex
   bne _copy_tail_loop
   jmp _copy_record_done

_copy_full_page:
   ldy #0
_copy_full_loop:
   ; Two temporary hardware-stack bytes hold the byte offset/data while ptr1
   ; changes roles. The linker reserves these real startup bytes explicitly;
   ; main itself is tail-entered and contributes no return-address slot.
   tya
   pha
   ldy #0
   lda (ptr0),y
   sta ptr1
   iny
   txa
   clc
   adc (ptr0),y
   sta ptr1+1
   pla
   tay

   lda (ptr1),y
   pha
   tya
   pha
   ldy #2
   lda (ptr0),y
   sta ptr1
   iny
   txa
   clc
   adc (ptr0),y
   sta ptr1+1
   pla
   tay
   pla
   sta (ptr1),y
   iny
   bne _copy_full_loop
   inx
   jmp _copy_page

_copy_record_done:
   clc
   lda ptr0
   adc #6
   sta ptr0
   bcc _copy_record
   inc ptr0+1
   jmp _copy_record

_zero_setup:
   ; ptr0 = __zero_table
   lda #<__zero_table
   sta ptr0
   lda #>__zero_table
   sta ptr0+1

_zero_record:
   ; A zero 16-bit count terminates the zero table.
   ldy #2
   lda (ptr0),y
   iny
   ora (ptr0),y
   beq _start_init

   ldx #0
_zero_page:
   ldy #3
   txa
   cmp (ptr0),y
   bcc _zero_full_page

   ; Final partial page; X becomes the low-byte remaining count.
   ldy #2
   lda (ptr0),y
   beq _zero_record_done
   tax
   ldy #0
   lda (ptr0),y
   sta ptr1
   iny
   lda (ptr0),y
   iny
   iny
   clc
   adc (ptr0),y
   sta ptr1+1
   lda #0
   ldy #0
_zero_tail_loop:
   sta (ptr1),y
   iny
   dex
   bne _zero_tail_loop
   jmp _zero_record_done

_zero_full_page:
   ; Build this page's write pointer once, then clear all 256 bytes via Y.
   ldy #0
   lda (ptr0),y
   sta ptr1
   iny
   txa
   clc
   adc (ptr0),y
   sta ptr1+1
   lda #0
   ldy #0
_zero_full_loop:
   sta (ptr1),y
   iny
   bne _zero_full_loop
   inx
   jmp _zero_page

_zero_record_done:
   clc
   lda ptr0
   adc #4
   sta ptr0
   bcc _zero_record
   inc ptr0+1
   jmp _zero_record

_start_init:
   lda #<__init_table
   sta ptr0
   lda #>__init_table
   sta ptr0+1

_call_init_loop:
   ldy #0
   lda (ptr0),y
   sta ptr1
   iny
   lda (ptr0),y
   sta ptr1+1
   lda ptr1
   ora ptr1+1
   beq _start_main
   lda ptr0
   pha
   lda ptr0+1
   pha
   jsr _call_init_trampoline
   pla
   sta ptr0+1
   pla
   sta ptr0
   clc
   lda ptr0
   adc #2
   sta ptr0
   bcc _call_init_loop
   inc ptr0+1
   jmp _call_init_loop

_call_init_trampoline:
   jmp (ptr1)

_start_main:
   ; main is non-returning and its compiler epilogue jumps through RESET.
   jmp main

; The 6502 image format still requires NMI and IRQ/BRK vector targets.
; The 6507 used by the VCS has no connected hardware interrupt inputs, and
; compiled interrupt handlers are unsupported, so the stock runtime supplies
; only weak RTI fillers. A completely custom runtime may replace them.
__nmi:
__irqbrk:
   rti
