include "vcs.c26"
include "playfield.c26"

template "kernels/faithful_legacy_playercolors/faithful_legacy_playercolors.c26" as legacy

uint8_t legacy_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0bX......X_...X...._......X._X......X),
   VCS_PLAYFIELD_ROW(0bX...X..X_.....X.._..X....._X..X...X),
   VCS_PLAYFIELD_ROW(0bX......X_..XX...._....XX.._X......X),
   VCS_PLAYFIELD_ROW(0bX.X....X_......X._.X......_X....X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bX..X...X_.X......_......X._X...X..X),
   VCS_PLAYFIELD_ROW(0bX......X_....X..._...X...._X......X),
   VCS_PLAYFIELD_ROW(0bX....X.X_.......X_X......._X.X....X),
   VCS_PLAYFIELD_ROW(0bX......X_.XX....._.....XX._X......X),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0b........_........_........_........)
};
page const uint8_t p0g[8] := { legacy_SPRITE_GLYPH(0x3c,0x66,0x66,0x7e,0x66,0x66,0x66,0x3c) };
page const uint8_t p1g[8] := { legacy_SPRITE_GLYPH(0x7c,0x66,0x66,0x7c,0x66,0x66,0x66,0x7c) };
page const uint8_t p0c[8] := { legacy_SPRITE_ROWS(0x3e,0x4e,0x5e,0x6e,0x7e,0x8e,0x9e,0xae) };
page const uint8_t p1c[8] := { legacy_SPRITE_ROWS(0xce,0xbe,0xae,0x9e,0x8e,0x7e,0x6e,0x5e) };

void main(void) {
   COLUBK:=0x82; COLUPF:=0x2e; CTRLPF:=0x21;
   legacy_PLAYER0_X:=44; legacy_PLAYER1_X:=108; legacy_BALL_X:=78;
   legacy_object_x[2]:=0; legacy_object_x[3]:=0;
   legacy_player0_y:=78; legacy_player1_y:=42; legacy_ball_y:=45;
   legacy_player0_graphics:=p0g; legacy_player1_graphics:=p1g;
   legacy_player0_height:=7; legacy_player1_height:=7; legacy_ball_height:=3;
   // These fields overlay the color pointers. Initialize them first.
   legacy_missile0_height:=0; legacy_missile1_height:=0;
   legacy_missile0_y:=0; legacy_missile1_y:=0;
   legacy_player0_colors:=p0c; legacy_player1_colors:=p1c;
   legacy_score[0]:=0x21; legacy_score[1]:=0x07; legacy_score[2]:=0x21;
   legacy_score_color:=0x0e; legacy_playfield_position:=8;
   VBLANK:=2; TIM64T:=0;
   while (1) {
      COLUPF:=0x2e; CTRLPF:=0x21; NUSIZ0:=0x20; NUSIZ1:=0x20;
      legacy_drawscreen();
   }
}
