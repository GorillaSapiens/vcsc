// Full-height all-five scene with P0 moving simultaneously in X and Y.
include "vcs.c26"
include "frame_ntsc.c26"

page const uint8_t game_playfield[48] := {
   0xff,0xff,0xff,0xff,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0x81,0x18,0x18,0x81,
   0x81,0x00,0x00,0x81,
   0xff,0xff,0xff,0xff
};
template "kernels/all_five_192/all_five_192.c26" as game

page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(0x3c,0x66,0x66,0x7e,0x66,0x66,0x66,0x00)
};
page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(0x7c,0x66,0x66,0x7c,0x66,0x66,0x7c,0x00)
};

alias P0_RIGHT 0x01
alias P0_DOWN  0x02
uint8_t p0_direction := P0_RIGHT | P0_DOWN;

inline void update_p0_motion(void) {
   if (p0_direction & P0_RIGHT) {
      if (game_PLAYER0_X == 159) {
         p0_direction ^= P0_RIGHT;
      }
      else {
         game_PLAYER0_X++;
      }
   }
   else {
      if (game_PLAYER0_X == 0) {
         p0_direction ^= P0_RIGHT;
      }
      else {
         game_PLAYER0_X--;
      }
   }

   if (p0_direction & P0_DOWN) {
      if (game_player0_y == 80) {
         p0_direction ^= P0_DOWN;
      }
      else {
         game_player0_y++;
      }
   }
   else {
      if (game_player0_y == 8) {
         p0_direction ^= P0_DOWN;
      }
      else {
         game_player0_y--;
      }
   }
}

void configure_game_frame(void) {
   COLUPF := 0x2e;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;
   NUSIZ0 := 0x20;
   NUSIZ1 := 0x20;
}

void initialize_scene(void) {
   VBLANK := 2;
   COLUBK := 0x84;
   game_PLAYER0_X := 0;
   game_PLAYER1_X := 130;
   game_MISSILE0_X := 50;
   game_MISSILE1_X := 110;
   game_BALL_X := 80;
   game_player0_y := 8;
   game_player1_y := 78;
   game_missile0_y := 34;
   game_missile1_y := 62;
   game_ball_y := 48;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 5;
   game_missile1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;
   game_init();
}

void main(void) {
   initialize_scene();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      configure_game_frame();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_p0_motion();
      vcs_ntsc_end_overscan();
   }
}
