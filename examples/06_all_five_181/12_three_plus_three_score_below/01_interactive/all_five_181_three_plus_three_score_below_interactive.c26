// Independent three-digit left/right scores below all_five_181 gameplay.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"
include "fonts/default_decimal.c26"

instantiate "renderers/all_five/all_five.c26" as game (lines:=181)
instantiate "three_plus_three_score_component.c26" as score

include "../../../common/three_plus_three_controls.c26"

inline void draw_visible_components(void) {
   game_draw();
   vcs_ntsc_component_handoff();
   score_draw();
}

include "../../../common/all_five_181_interactive_common.c26"
