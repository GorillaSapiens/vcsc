// Multicolor Score Above Dynamic X Motion.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"
include "fonts/default_decimal.c26"

page const uint8_t game_playfield[44] := {
VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0bX......X_...X...._......X._X......X),
   VCS_PLAYFIELD_ROW(0bX...X..X_.....X.._..X....._X..X...X),
   VCS_PLAYFIELD_ROW(0bX......X_..XX...._....XX.._X......X),
   VCS_PLAYFIELD_ROW(0bX.X....X_......X._.X......_X....X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bX..X...X_.X......_......X._X...X..X),
   VCS_PLAYFIELD_ROW(0bX......X_....X..._...X...._X......X),
   VCS_PLAYFIELD_ROW(0bX....X.X_.......X_X......._X.X....X),
   VCS_PLAYFIELD_ROW(0bX......X_.XX....._.....XX._X......X),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX)
};

template "kernels/player_color_181/player_color_181.c26" as game
template "six_glyph_component.c26" as score

page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(
      0b..XXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXXX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b..XXXX..
   )
};

page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(
      0b.XXXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXX..
   )
};

page const uint8_t game_player0_colors[8] := {
   game_SPRITE_GLYPH(
      VCS_NTSC_SANDY_BROWN,
      VCS_NTSC_LIGHT_CORAL,
      VCS_NTSC_ORCHID,
      VCS_NTSC_VIOLET,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_SKY_BLUE
   )
};

page const uint8_t game_player1_colors[8] := {
   game_SPRITE_GLYPH(
      VCS_NTSC_PALE_GREEN,
      VCS_NTSC_AQUAMARINE,
      VCS_NTSC_SKY_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_VIOLET,
      VCS_NTSC_ORCHID
   )
};

void configure_game_frame(void) {
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;
}

void initialize_scene(void) {
   VBLANK := 2;
   game_PLAYER0_X := 0;
   game_PLAYER1_X := 159;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_BALL_X := 80;
   game_player0_y := 18;
   game_player1_y := 78;
   game_ball_y := 48;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;
   score_score := 123456;
   game_init();
   score_init();
}

alias P0_X_RIGHT   0x01
alias P1_X_RIGHT   0x02
alias BALL_X_RIGHT 0x04

uint8_t motion_directions := P0_X_RIGHT | BALL_X_RIGHT;

inline void update_x_motion(void) {
   if (motion_directions & P0_X_RIGHT) {
      if (game_PLAYER0_X >= 158) {
         game_PLAYER0_X := 159;
         motion_directions ^= P0_X_RIGHT;
      }
      else {
         game_PLAYER0_X++;
      }
   }
   else {
      if (game_PLAYER0_X <= 1) {
         game_PLAYER0_X := 0;
         motion_directions ^= P0_X_RIGHT;
      }
      else {
         game_PLAYER0_X--;
      }
   }

   if (motion_directions & P1_X_RIGHT) {
      if (game_PLAYER1_X >= 154) {
         game_PLAYER1_X := 159;
         motion_directions ^= P1_X_RIGHT;
      }
      else {
         game_PLAYER1_X += 5;
      }
   }
   else {
      if (game_PLAYER1_X <= 5) {
         game_PLAYER1_X := 0;
         motion_directions ^= P1_X_RIGHT;
      }
      else {
         game_PLAYER1_X -= 5;
      }
   }

   if (motion_directions & BALL_X_RIGHT) {
      if (game_BALL_X >= 152) {
         game_BALL_X := 159;
         motion_directions ^= BALL_X_RIGHT;
      }
      else {
         game_BALL_X += 7;
      }
   }
   else {
      if (game_BALL_X <= 7) {
         game_BALL_X := 0;
         motion_directions ^= BALL_X_RIGHT;
      }
      else {
         game_BALL_X -= 7;
      }
   }
}

void main(void) {
   initialize_scene();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      score_vblank();
      configure_game_frame();
      vcs_ntsc_end_vblank();
      score_draw();
      vcs_ntsc_component_handoff();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_x_motion();
      score_overscan();
      vcs_ntsc_end_overscan();
   }
}
