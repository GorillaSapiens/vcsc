// Visible horizontal/vertical reference cartridge for the normalized unbanked
// 4K NTSC standard kernel. Every object moves exactly one source coordinate per
// frame inside its own range, against a fixed ruler-like playfield.

include "vcs.c26"

// Border plus four fixed vertical rulers. This is intentionally visible: a
// motion regression that draws on an empty field is lousy diagnostic equipment.
page const uint8_t vcs_standard_playfield[48] := {
   0xff, 0xff, 0xff, 0xff,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0xff, 0xff, 0xff, 0xff,
   0x00, 0x00, 0x00, 0x00
};

include "kernels/standard_4k_ntsc/standard_4k_ntsc.c26"

page const uint8_t player0_graphics[8] := {
   VCS_STANDARD_SPRITE_GLYPH(
      0b.XXXXXX.,
      0bXX....XX,
      0bXX...XXX,
      0bXX..X.XX,
      0bXX.X..XX,
      0bXXX...XX,
      0bXX....XX,
      0b.XXXXXX.
   )
};

page const uint8_t player1_graphics[8] := {
   VCS_STANDARD_SPRITE_GLYPH(
      0b...XX...,
      0b..XXX...,
      0b...XX...,
      0b...XX...,
      0b...XX...,
      0b...XX...,
      0b...XX...,
      0b..XXXX..
   )
};

alias DIRECTION_PLAYER0 0x01
alias DIRECTION_PLAYER1 0x02
alias DIRECTION_MISSILE0 0x04
alias DIRECTION_MISSILE1 0x08
alias DIRECTION_BALL    0x10

uint8_t motion_frame := 0;
uint8_t motion_directions := 0x15;

void move_object(uint8_t object, uint8_t direction, uint8_t low, uint8_t high) {
   if (motion_directions & direction) {
      vcs_standard_object_x[object]++;
      if (vcs_standard_object_x[object] == high) {
         motion_directions ^= direction;
      }
   }
   else {
      vcs_standard_object_x[object]--;
      if (vcs_standard_object_x[object] == low) {
         motion_directions ^= direction;
      }
   }
}

void update_motion(void) {
   motion_frame++;

   // Every object advances one source coordinate every frame. Distinct ranges,
   // phases, and initial directions make the reversals independent without the
   // deliberate frame-skipping that made the old diagnostic look broken.
   move_object(VCS_STANDARD_OBJECT_PLAYER0, DIRECTION_PLAYER0, 12, 144);
   move_object(VCS_STANDARD_OBJECT_PLAYER1, DIRECTION_PLAYER1, 20, 148);
   move_object(VCS_STANDARD_OBJECT_MISSILE0, DIRECTION_MISSILE0, 24, 136);
   move_object(VCS_STANDARD_OBJECT_MISSILE1, DIRECTION_MISSILE1, 8, 128);
   move_object(VCS_STANDARD_OBJECT_BALL, DIRECTION_BALL, 32, 120);
}

void initialize_motion_scene(void) {
   COLUBK := 0x84;

   VCS_STANDARD_PLAYER0_X := 20;
   VCS_STANDARD_PLAYER1_X := 140;
   VCS_STANDARD_MISSILE0_X := 48;
   VCS_STANDARD_MISSILE1_X := 112;
   VCS_STANDARD_BALL_X := 80;

   // Fixed non-overlapping vertical bands in the kernel's public Y convention.
   vcs_standard_player0_y := 18;
   vcs_standard_missile0_y := 34;
   vcs_standard_ball_y := 48;
   vcs_standard_missile1_y := 62;
   vcs_standard_player1_y := 78;

   vcs_standard_player0_graphics := player0_graphics;
   vcs_standard_player1_graphics := player1_graphics;
   vcs_standard_player0_height := 7;
   vcs_standard_player1_height := 7;
   vcs_standard_missile0_height := 5;
   vcs_standard_missile1_height := 7;
   vcs_standard_ball_height := 3;

   vcs_standard_score := 123456;
   vcs_standard_score_color := 0x0e;
   vcs_standard_playfield_position := 8;

   VBLANK := 2;
   TIM64T := 0;
}

// The kernel borrows the player colors for the score and clears NUSIZ0/1.
// Reapply all geometry/color registers whose persistence is not in the ABI.
void configure_motion_frame(void) {
   COLUPF := 0x2e;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;
   NUSIZ0 := 0x20;
   NUSIZ1 := 0x20;
}

void main(void) {
   initialize_motion_scene();
   while (1) {
      configure_motion_frame();
      vcs_standard_kernel_drawscreen();
      update_motion();
   }
}
