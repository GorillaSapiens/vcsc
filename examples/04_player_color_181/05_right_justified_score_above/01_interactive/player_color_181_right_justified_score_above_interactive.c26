// Right-justified six-digit score above player_color_181 interactive diagnostic.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"
include "fonts/default_decimal.c26"

instantiate "renderers/player_color/player_color.c26" as game (lines:=181)
instantiate "six_glyph_right_component.c26" as score

include "../../../common/fixed_six_digit_controls.c26"

inline void draw_visible_components(void) {
   score_draw();
   vcs_ntsc_component_handoff();
   game_draw();
}

include "../../../common/player_color_181_interactive_common.c26"
