// Left/right two-plus-two score above player_color_181 interactive diagnostic.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"
include "two_plus_two_score_support.c26"

instantiate "renderers/player_color_181/player_color_181.c26" as game
instantiate "two_plus_two_score_component.c26" as score

include "../../../common/two_plus_two_controls.c26"

inline void draw_visible_components(void) {
   score_draw();
   vcs_ntsc_component_handoff();
   game_draw();
}

include "../../../common/player_color_181_interactive_common.c26"
