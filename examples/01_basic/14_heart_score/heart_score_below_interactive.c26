// Interactive heart score below the maintained 181-line player-color renderer.
include "4K/mapper.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"

instantiate "renderers/player_color/player_color.c26" as game (lines:=181)
instantiate "heart_score_component.c26" as score

include "../../common/heart_score_controls.c26"

inline void draw_visible_components(void) {
   game_draw();
   vcs_ntsc_component_handoff();
   vcs_ntsc_wait_component_scanlines(4);
   score_draw();
}

include "../../common/heart_score_player_color_181_common.c26"
