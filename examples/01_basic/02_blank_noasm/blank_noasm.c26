// Minimal unbanked 4K Atari VCS cartridge.
//
// This deliberately expresses the complete frame in VCSC source while
// exercising the static-frame source ABI during initialization.

include "vcs.c26"

typedef int16_t int;
typedef uint8_t char;
typedef uint8_t bool;

uint8_t choose_background(uint8_t seed) {
   uint8_t color := seed + 2;
   return color;
}

void main(void) {
   uint8_t color := choose_background(0x82);

   // Clear every object that could otherwise contain power-up garbage.
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := color;

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   while(1) {

      // 3 scanlines VSYNC
      VSYNC := 2;
      for (uint8_t i := 3; i; i--) {
         WSYNC := _;
      }
      VSYNC := 0;

      // 37 scanlines vertical blank. The RIOT timer owns the deadline, so
      // useful game logic can run here without spending the phase in WSYNC.
      VBLANK := 2;
      TIM64T := 42;

      // Read controls, update movement/collisions, prepare display state, etc.
      // The timer keeps running while that work executes.

      // Once the useful work is finished, wait out only the unused budget.
      // TIMINT.7 is set when the interval timer expires, even if work ran late.
      while (!(TIMINT & 0x80)) {
      }
      WSYNC := _;
      VBLANK := 0;

      // 192 visible scanlines. Visible drawing still has scanline deadlines.
      for (uint8_t i := 192; i; i--) {
         WSYNC := _;
      }

      // 30 scanlines overscan: another timer-owned game-logic budget.
      VBLANK := 2;
      TIM64T := 34;

      // Do any remaining per-frame game logic here.

      // Align the next frame only after the overscan deadline expires.
      while (!(TIMINT & 0x80)) {
      }
      WSYNC := _;

      // Stella's TIA frame accounting needs two additional blanked scanline
      // boundaries here. Without them this timer-owned layout is reported as
      // a 260-line / ~60.5 Hz frame even though the CPU-only interval is 262
      // lines. These are frame-boundary compensation, not game-logic waits.
      WSYNC := _;
      WSYNC := _;
   }
}
