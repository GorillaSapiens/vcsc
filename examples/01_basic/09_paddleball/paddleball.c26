include "vcs_4k.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "sound_ntsc.c26"
include "fonts/default_decimal.c26"

alias PADDLEBALL_BLACK 0x00
alias PADDLEBALL_WHITE __builtin_ntsc_rgb(0xff, 0xff, 0xff)
alias PADDLEBALL_BLUE  __builtin_ntsc_rgb(0x20, 0x40, 0xff)
alias PADDLEBALL_RED   __builtin_ntsc_rgb(0xff, 0x20, 0x20)

instantiate "two_paddles.c26" as paddles (port:=0)

// Bind the score renderer's compile-time paddle slots directly to this reader.
inline void score_paddle_sample0(void) { paddles_score_sample0(); }
inline void score_paddle_sample1(void) { paddles_score_sample1(); }
inline void score_paddle_advance_pair(void) { paddles_score_advance_pair(); }
instantiate "three_plus_three_score_component.c26" as score (paddle_samples:=2)

// Local 181-line Paddleball playfield renderer. P0/P1 are reserved for the score;
// gameplay uses M0/M1 as paddles and Ball as the ball.

enum paddleball_renderer_constants {
   PADDLEBALL_VISIBLE_LINES := 181,
   PADDLEBALL_PAIR_COUNT := 88,
   PADDLEBALL_LEFT_X := 16,
   PADDLEBALL_RIGHT_X := 156,
   PADDLEBALL_LEFT_SCORE_X := 4,
   PADDLEBALL_RIGHT_SCORE_X := 163,
   PADDLEBALL_PADDLE_HEIGHT := 16,
   PADDLEBALL_BALL_HEIGHT := 4,
   PADDLEBALL_PADDLE_TOP_Y := 9,
   PADDLEBALL_PADDLE_BOTTOM_Y := 159,
   PADDLEBALL_PADDLE_RAW_MIN := 12,
   PADDLEBALL_BALL_TOP_Y := 8,
   PADDLEBALL_BALL_BOTTOM_Y := 172,
   PADDLEBALL_PADDLE_SOUND_FRAMES := 3
};

uint8_t paddleball_left_y := 81;
uint8_t paddleball_right_y := 81;
uint8_t paddleball_ball_x := 78;
uint8_t paddleball_ball_y := 88;
uint8_t paddleball_left_start_pair := 40;
uint8_t paddleball_left_end_pair := 48;
uint8_t paddleball_right_start_pair := 40;
uint8_t paddleball_right_end_pair := 48;
uint8_t paddleball_ball_start_pair := 44;
uint8_t paddleball_ball_end_pair := 46;
uint8_t paddleball_sound_frames := 0;

// PF2.7 is the center-most playfield bit when CTRLPF reflect is enabled.
// The explicit setup consumes lines 0..7: three black lines below the score,
// four top-wall lines, then one black line before the center stripe. Pairs
// 4..87 therefore cover lines 8..175 with a continuous 8-on/8-off dash pattern.
// Line 176 is black; the bottom wall occupies lines 177..180. That leaves the
// same one-scanline gap between the dashed center line and each horizontal wall.
align(256) const uint8_t paddleball_pf2_pairs[88] := {
   0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80, 0x00,0x00,0x00,0x00,
   0x80,0x80,0x80,0x80
};

// The standard divide-by-15 RESP/HMxx fine-motion table used by the other VCS
// renderers. Indexing is by the negative divide remainder (-15..-1).
align(256) const uint8_t paddleball_reposition_table[16] := {
   0x70,0x60,0x50,0x40,0x30,0x20,0x10,0x00,
   0xf0,0xe0,0xd0,0xc0,0xb0,0xa0,0x90,0x80
};

inline void paddleball_prepare_vertical(void) {
   paddleball_left_start_pair := paddleball_left_y >> 1;
   paddleball_left_end_pair := paddleball_left_start_pair + 8;
   paddleball_right_start_pair := paddleball_right_y >> 1;
   paddleball_right_end_pair := paddleball_right_start_pair + 8;
   paddleball_ball_start_pair := paddleball_ball_y >> 1;
   paddleball_ball_end_pair := paddleball_ball_start_pair + 2;
}

// Initial fixed X positions for M0/M1 plus the initial Ball position. Call only
// while VBLANK is asserted.
inline void paddleball_position_all(void) {
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;

   asm sta WSYNC;
   asm ldx #2;
   asm bit.z CXM0P;
   asm lda #16;
   asm sec;
   asm @m0_divide:;
   asm sbc #15;
   asm bcs.same @m0_divide;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda paddleball_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm ldx #3;
   asm bit.z CXM0P;
   asm lda #156;
   asm sec;
   asm @m1_divide:;
   asm sbc #15;
   asm bcs.same @m1_divide;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda paddleball_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm ldx #4;
   asm bit.z CXM0P;
   asm lda.z paddleball_ball_x;
   asm sec;
   asm @ball_divide:;
   asm sbc #15;
   asm bcs.same @ball_divide;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda paddleball_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm sta HMOVE;
}

// Reposition only Ball; fixed paddle X positions survive the score component.
inline void paddleball_position_ball(void) {
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z CXM0P;
   asm lda.z paddleball_ball_x;
   asm sec;
   asm @ball_divide:;
   asm sbc #15;
   asm bcs.same @ball_divide;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda paddleball_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm sta HMOVE;
}

// Enter at the standard component cycle-3 phase after the score handoff.
// Consumes exactly 181 lines and returns at cycle zero of the following line.
inline void paddleball_draw(void) {
   // Clear PF first so the score hands off to black rather than leaving any
   // transient score/playfield residue below the digits.
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;

   asm lda #$10;              // 2-pixel missiles for thinner paddles
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm lda #$84;
   asm sta COLUP0;
   asm lda #$46;
   asm sta COLUP1;
   asm lda #$0e;
   asm sta COLUPF;
   asm lda #$00;
   asm sta COLUBK;
   asm lda #$11;              // reflected PF, 2-pixel Ball
   asm sta CTRLPF;
   asm lda #0;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;

   // Lines 0..2: blank gap between the score and the top wall. The score
   // sampled both channels in its first two scanlines and advanced one pair.
   // Nine more pairs account the remaining score/setup time and the one odd
   // VBLANK scanline intentionally left out of the pre-score gap.
   asm sta WSYNC;
   asm lda #9;
   paddles_score_account_a();
   asm sta WSYNC;
   asm sta WSYNC;

   // Lines 3..6: full-width top wall.
   asm lda #$ff;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;

   // Line 7: blank gap between the top wall and the dashed center line.
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta WSYNC;

   // Interior pairs 4..87 cover gameplay lines 8..175.
   asm ldx #4;
   asm @pair:;

   // Ball is the only object that changes on line A. Sample channel 0 here
   // and channel 1 on line B. A completed RC sample takes substantially more
   // cycles than an unfinished sample; splitting the channels prevents two
   // simultaneous threshold crossings from overflowing one scanline. Paddle
   // graphics still transition together on line B, so their raster phase is
   // identical even though their analog samples are distributed across the pair.
   asm cpx.z paddleball_ball_start_pair;
   asm bne.same @ball_not_start;
   asm lda #2;
   asm sta ENABL;
   asm @ball_not_start:;
   asm cpx.z paddleball_ball_end_pair;
   asm bne.same @ball_not_end;
   asm lda #0;
   asm sta ENABL;
   asm @ball_not_end:;

   asm lda paddleball_pf2_pairs,x;
   asm sta PF2;
   paddles_sample0();
   WSYNC := _;

   // Both paddles transition on line B. Keeping M0 and M1 in the same raster
   // phase removes the one-scanline vertical bias that existed when M0 changed
   // on line A and M1 on line B.
   asm cpx.z paddleball_left_start_pair;
   asm bne.same @m0_not_start;
   asm lda #2;
   asm sta ENAM0;
   asm @m0_not_start:;
   asm cpx.z paddleball_left_end_pair;
   asm bne.same @m0_not_end;
   asm lda #0;
   asm sta ENAM0;
   asm @m0_not_end:;

   asm cpx.z paddleball_right_start_pair;
   asm bne.same @m1_not_start;
   asm lda #2;
   asm sta ENAM1;
   asm @m1_not_start:;
   asm cpx.z paddleball_right_end_pair;
   asm bne.same @m1_not_end;
   asm lda #0;
   asm sta ENAM1;
   asm @m1_not_end:;

   paddles_sample1();

   // End line B before advancing the RC pair clock. Keeping the elapsed-count
   // update off this already busy line leaves enough headroom for the worst
   // case where a paddle enable/disable transition and an RC threshold crossing
   // happen in the same scanline.
   asm inx;
   asm sta WSYNC;
   paddles_advance_pair();
   asm cpx #88;
   asm beq @tail;
   asm jmp @pair;

   // Finish pair 87 at line 175 and enter line 176. Pair 87 already left PF
   // black; hold one more blank scanline so the four-line bottom wall remains
   // lines 177..180 and paddleball_draw() consumes the promised 181 visible lines.
   asm @tail:;
   // Clear the retained center bit during line-176 horizontal blank so the
   // final dash ends on line 175 and line 176 is the same one-line wall gap
   // used above the first dash.
   asm lda #0;
   asm sta PF2;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta WSYNC;

   // Lines 177..180: full-width bottom wall.
   asm lda #$ff;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
   asm sta WSYNC;
}


uint8_t ball_right := 1;
uint8_t ball_down := 1;
uint8_t waiting_for_serve := 1;

inline uint8_t paddle_target_y(uint8_t raw) {
   // Real CX30 paddles do not all reach the same raw endpoint. Reserve a small
   // dead zone at the low end, then map the useful range nearly 1:1 onto odd
   // rendered top coordinates 9..159. The odd coordinates match the
   // line-B enable phase used identically by M0 and M1.
   uint8_t y := 0;
   if (raw > PADDLEBALL_PADDLE_RAW_MIN) {
      y := raw - PADDLEBALL_PADDLE_RAW_MIN;
      if (y > 150) { return PADDLEBALL_PADDLE_BOTTOM_Y; }
   }
   return (PADDLEBALL_PADDLE_TOP_Y + y) | 1;
}

inline void paddleball_sound_tick(void) {
   if (paddleball_sound_frames) {
      paddleball_sound_frames--;
      if (!paddleball_sound_frames) {
         AUDV0 := MUSIC_VOLUME_OFF;
      }
   }
}

inline void paddleball_sound_paddle(void) {
   // A short, bright square-wave ping for a paddle rebound.
   AUDV0 := MUSIC_VOLUME_OFF;
   AUDC0 := MUSIC_CONTROL_SQUARE;
   AUDF0 := 6;
   AUDV0 := MUSIC_VOLUME_LOUD;
   paddleball_sound_frames := PADDLEBALL_PADDLE_SOUND_FRAMES;
}

inline void paddleball_sound_wall(void) {
   // Same square-wave beep as a paddle rebound, exactly one octave lower.
   // TIA tone frequency is proportional to 1/(AUDF+1), so 13+1 is twice
   // the divider used by the paddle beep at 6+1.
   AUDV0 := MUSIC_VOLUME_OFF;
   AUDC0 := MUSIC_CONTROL_SQUARE;
   AUDF0 := 13;
   AUDV0 := MUSIC_VOLUME_LOUD;
   paddleball_sound_frames := PADDLEBALL_PADDLE_SOUND_FRAMES;
}

inline void paddleball_sound_stop(void) {
   paddleball_sound_frames := 0;
   AUDV0 := MUSIC_VOLUME_OFF;
}

inline void reset_ball(void) {
   paddleball_ball_x := 78;
   paddleball_ball_y := 88;
   ball_down := 1;
   waiting_for_serve := 1;
}

inline void reset_game(void) {
   score_left_score := 0;
   score_right_score := 0;
   ball_right := 1;
   paddleball_sound_stop();
   reset_ball();
}

inline void update_game(void) {
   // Audio is frame-driven game state, so keep it in overscan with the rest of
   // the collision/update work rather than touching audio in the renderer.
   paddleball_sound_tick();

   // Use the TIA's actual rendered-pixel collision latches for paddle hits.
   // CXM0FB.6 is M0-Ball and CXM1FB.6 is M1-Ball. These latches describe
   // the frame that was just drawn, so a rebound only happens when Ball and
   // the corresponding paddle missile really overlapped on screen.
   uint8_t left_ball_collision := CXM0FB & 0x40;
   uint8_t right_ball_collision := CXM1FB & 0x40;

   if (paddles_valid) {
      // Do not slew toward a stale target. CX30 RC measurements can already
      // span more than one frame at the high-resistance end; adding another
      // 2-scanline-per-frame chase makes the control feel like it keeps moving
      // after the knob stops. Apply each completed measurement immediately.
      paddleball_left_y := paddle_target_y(paddles_position0);
      paddleball_right_y := paddle_target_y(paddles_position1);
   }

   if ((SWCHB & 1) == 0) {
      reset_game();
      return;
   }

   if (waiting_for_serve) {
      if (paddles_button0) {
         ball_right := 1;
         waiting_for_serve := 0;
      }
      else {
         if (paddles_button1) {
            ball_right := 0;
            waiting_for_serve := 0;
         }
      }
      return;
   }

   if (ball_down) {
      // Trigger the rebound as we move into the contact position. Waiting until
      // a frame after Y reaches the boundary makes the sound visibly late.
      if (paddleball_ball_y >= PADDLEBALL_BALL_BOTTOM_Y - 2) {
         paddleball_ball_y := PADDLEBALL_BALL_BOTTOM_Y;
         ball_down := 0;
         paddleball_sound_wall();
      }
      else { paddleball_ball_y += 2; }
   }
   else {
      if (paddleball_ball_y <= PADDLEBALL_BALL_TOP_Y + 2) {
         paddleball_ball_y := PADDLEBALL_BALL_TOP_Y;
         ball_down := 1;
         paddleball_sound_wall();
      }
      else { paddleball_ball_y -= 2; }
   }

   if (ball_right) {
      if (right_ball_collision) {
         // The just-drawn frame contained a real M1-Ball pixel overlap.
         // Reverse and take one normal horizontal step away for next frame.
         paddleball_ball_x--;
         ball_right := 0;
         paddleball_sound_paddle();
      }
      else {
         paddleball_ball_x++;
         if (paddleball_ball_x >= PADDLEBALL_RIGHT_SCORE_X) {
            score_left_score++;
            ball_right := 1;
            reset_ball();
         }
      }
   }
   else {
      if (left_ball_collision) {
         paddleball_ball_x++;
         ball_right := 1;
         paddleball_sound_paddle();
      }
      else {
         paddleball_ball_x--;
         if (paddleball_ball_x <= PADDLEBALL_LEFT_SCORE_X) {
            score_right_score++;
            ball_right := 0;
            reset_ball();
         }
      }
   }
}

void main(void) {
   VBLANK := 2;
   COLUBK := PADDLEBALL_BLACK;
   COLUPF := PADDLEBALL_WHITE;
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   AUDV0 := MUSIC_VOLUME_OFF;
   AUDV1 := MUSIC_VOLUME_OFF;

   score_left_color := PADDLEBALL_BLUE;
   score_right_color := PADDLEBALL_RED;
   score_init();
   paddles_init();
   reset_game();
   paddleball_prepare_vertical();
   paddleball_position_all();

   while (1) {
      vcs_ntsc_vsync();

      vcs_ntsc_begin_vblank();
      paddles_vblank();
      // Account only the first 20 of the 21 remaining VBLANK scanlines here.
      // The score now samples both paddles itself and advances one pair; the
      // rest of the score/setup span is advanced in a known blank gameplay line.
      paddles_account_gap(10);
      score_vblank();
      // The score preserves playfield state; clear the prior frame's bottom
      // wall so the score is drawn over black rather than a white PF stripe.
      PF0 := 0;
      PF1 := 0;
      PF2 := 0;
      // Start gameplay with fresh collision latches. The score component does
      // not use M0/M1/Ball, so any M0-Ball or M1-Ball latch set after this
      // point belongs to the Paddleball renderer below.
      CXCLR := _;
      vcs_ntsc_end_vblank();

      score_draw();
      vcs_ntsc_component_handoff();
      paddleball_draw();

      vcs_ntsc_begin_overscan();
      // Visible line 176 plus the 4-line bottom wall do not sample the pots:
      // account the final fixed tail as three two-line units.
      paddles_account_gap(3);
      paddles_overscan();
      update_game();
      paddleball_prepare_vertical();
      paddleball_position_ball();
      score_overscan();
      vcs_ntsc_end_overscan();

      // Keep the completed RC measurement grounded across the following VSYNC.
      paddles_dump();
   }
}
