// Centered six-digit score display built from the reusable lifecycle component.
// The application owns frame scheduling and score cadence; the instantiated
// component owns only its score state, glyph pointers, and timed draw pipeline.

include "vcs_2k.c26"
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"

alias BACKGROUND_COLOR 0x84
alias SCORE_PERIOD     20

template "six_glyph_component.c26" as score
uint8_t frame_counter := 0;

void main(void) {
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := BACKGROUND_COLOR;
   VBLANK := 2;

   score_score := 123456;
   score_init();

   while (1) {
      vcs_ntsc_vsync();

      vcs_ntsc_begin_vblank();
      score_vblank();
      vcs_ntsc_end_vblank();

      // Keep the legacy display's absolute visible-line placement.  The
      // component consumes eleven scanlines, leaving 91 above and 90 below.
      vcs_ntsc_wait_component_scanlines(91);
      score_draw();
      vcs_ntsc_wait_scanlines(90);

      vcs_ntsc_begin_overscan();
      frame_counter++;
      if (frame_counter == SCORE_PERIOD) {
         frame_counter := 0;
         score_score++;
      }
      score_overscan();
      vcs_ntsc_end_overscan();
   }
}
