// Minimal unbanked 4K Atari VCS cartridge with a frame-driven melody.
// Plays the opening phrase of Beethoven's "Ode to Joy" forever on TIA audio 0.

include "vcs.c26"
include "sound_ntsc.c26"

struct MusicStep {
   uint8_t volume;
   uint8_t frequency;
   uint8_t control;
   uint8_t timing;
};

alias MUSIC_STEP_COUNT 32

const MusicStep music[MUSIC_STEP_COUNT] := {
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_F4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_G4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },

   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_G4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_F4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_D4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },

   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_D4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },

   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_D4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_D4, MUSIC_CONTROL_LEAD, MUSIC_TIME_HALF },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_EIGHTH },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP }
};

uint8_t music_index := 0;
uint8_t music_counter := 0xff;

void music_apply_current(void) {
   // Silence the old step before changing waveform or frequency, then enable
   // the new step last.  Without this first write, note-to-gap transitions
   // briefly retune an audible channel and produce a chirp/buzz.
   AUDV0 := 0;
   AUDC0 := music[music_index].control;
   AUDF0 := music[music_index].frequency;
   AUDV0 := music[music_index].volume;
}

void music_tick(void) {
   // $ff means that no note has started yet. Begin the first note at the same
   // overscan phase used by every later score transition.
   if (music_counter == 0xff) {
      music_counter := 0;
      music_apply_current();
      return;
   }

   music_counter++;
   if (music_counter > music[music_index].timing) {
      music_counter := 0;
      music_index++;
      if (music_index == MUSIC_STEP_COUNT) {
         music_index := 0;
      }
      music_apply_current();
   }
}

void main(void) {
   // Clear video objects and silence both audio channels before the first
   // synchronized frame begins.
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := 0x84;
   AUDV0 := 0;
   AUDV1 := 0;

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   // Like blank_noasm, the blanking intervals are timer-owned CPU budgets:
   // useful program work runs while the RIOT timer counts down instead of
   // spending those intervals in per-scanline WSYNC loops.
   while (1) {
      // Exactly 3 scanlines VSYNC: align first, then use the same phase
      // for assertion and deassertion.
      WSYNC := 2;
      VSYNC := 2;
      WSYNC := 0;
      WSYNC := 0;
      WSYNC := 0;
      VSYNC := 0;

      // 37 scanlines vertical blank. A real game can read controls, update
      // objects, calculate collisions, or prepare renderer state here.
      VBLANK := 2;
      TIM64T := 42;

      // No VBLANK work is required by this tiny example, so wait out whatever
      // remains of the timer-owned budget and align the visible phase once.
      while (!(TIMINT & 0x80)) {
      }
      WSYNC := _;
      VBLANK := 0;

      // 192 visible scanlines. There is nothing to draw except COLUBK, but the
      // visible region still has scanline deadlines.
      for (uint8_t i := 192; i; i--) {
         WSYNC := _;
      }

      // 30 scanlines overscan. This is another timer-owned game-logic budget.
      // Advance the music once per frame while the timer is running. The
      // preload is calibrated for the one WSYNC used below to normalize the
      // variable-length music path before polling the remaining budget.
      VBLANK := 2;
      TIM64T := 35;
      music_tick();

      // music_tick() has short and long paths. Align once after useful work so
      // the timer poll always begins on a scanline boundary; this avoids
      // making frame length depend on which score path ran this frame.
      WSYNC := _;
      while (!(TIMINT & 0x80)) {
      }

      // One final blanked boundary remains here; the leading alignment WSYNC
      // of the next exact VSYNC pulse supplies the second frame boundary.
      WSYNC := _;

   }
}
