// Shared controls for the independently positioned two-plus-two score examples.
// The including source must instantiate the display as `score`.

uint8_t selected_score_field := 0;
uint8_t right_score_fire_ready := 1;
uint8_t right_joystick_countdown := 19;
uint8_t right_joystick_previous := 0x0f;

inline void initialize_score_state(void) {
   score_left_score := 12;
   score_right_score := 34;
   // The selected field is bright; the other field is dimmed.
   score_left_color := VCS_NTSC_GRAY_92;
   score_right_color := 0x26;
   score_left_x := 16;
   score_right_x := 104;
   selected_score_field := 0;
   right_score_fire_ready := 1;
   right_joystick_countdown := 19;
   right_joystick_previous := 0x0f;
}

inline void update_score_field_selection(void) {
   if (INPT5 & 0x80) {
      right_score_fire_ready := 1;
   }
   else {
      if (right_score_fire_ready) {
         selected_score_field ^= 1;
         if (selected_score_field) {
            score_left_color := 0x06;
            score_right_color := VCS_NTSC_GOLDENROD;
         }
         else {
            score_left_color := VCS_NTSC_GRAY_92;
            score_right_color := 0x26;
         }
         right_score_fire_ready := 0;
      }
   }
}

inline void update_score_controls(void) {
   update_score_field_selection();

   // Sample once every twenty frames and require two matching samples.
   asm lda right_joystick_countdown;
   asm beq @sample;
   asm dec right_joystick_countdown;
   asm jmp @done;

   asm @sample:;
   asm lda SWCHA;
   asm and #$0f;
   asm tax;
   asm eor right_joystick_previous;
   asm bne @record;

   // Horizontal input moves only the selected field's private X origin.
   asm txa;
   asm and #$04;
   asm bne @not_left;
   asm lda selected_score_field;
   asm bne @move_right_field_left;
   asm lda score_left_x;
   asm cmp #0;
   asm beq @vertical;
   asm dec score_left_x;
   asm jmp @vertical;
   asm @move_right_field_left:;
   asm lda score_right_x;
   asm cmp #32;
   asm beq @vertical;
   asm dec score_right_x;
   asm jmp @vertical;

   asm @not_left:;
   asm txa;
   asm and #$08;
   asm bne @vertical;
   asm lda selected_score_field;
   asm bne @move_right_field_right;
   asm lda score_left_x;
   asm cmp #64;
   asm beq @vertical;
   asm inc score_left_x;
   asm jmp @vertical;
   asm @move_right_field_right:;
   asm lda score_right_x;
   asm cmp #144;
   asm beq @vertical;
   asm inc score_right_x;

   // Vertical input changes only the selected packed-BCD two-digit value.
   asm @vertical:;
   asm txa;
   asm and #$01;
   asm bne @not_up;
   asm sed;
   asm clc;
   asm lda selected_score_field;
   asm bne @increment_right;
   asm lda score_left_score;
   asm adc #1;
   asm sta score_left_score;
   asm cld;
   asm jmp @record;
   asm @increment_right:;
   asm lda score_right_score;
   asm adc #1;
   asm sta score_right_score;
   asm cld;
   asm jmp @record;

   asm @not_up:;
   asm txa;
   asm and #$02;
   asm bne @record;
   asm sed;
   asm sec;
   asm lda selected_score_field;
   asm bne @decrement_right;
   asm lda score_left_score;
   asm sbc #1;
   asm sta score_left_score;
   asm cld;
   asm jmp @record;
   asm @decrement_right:;
   asm lda score_right_score;
   asm sbc #1;
   asm sta score_right_score;
   asm cld;

   asm @record:;
   asm stx right_joystick_previous;
   asm lda #19;
   asm sta right_joystick_countdown;
   asm @done:;
}
