// Shared right-joystick controls for heart-score composition examples.
// The including source must instantiate heart_score_component.c26 as `score`.

uint8_t right_joystick_ready := 0x0f;

inline void initialize_score_state(void) {
#ifdef HEART_SCORE_INITIAL_SCORE
   score_score := HEART_SCORE_INITIAL_SCORE;
#else
   score_score := 5;
#endif
#ifdef HEART_SCORE_INITIAL_HALF
   score_half := HEART_SCORE_INITIAL_HALF;
#else
   score_half := 1;
#endif
#ifdef HEART_SCORE_INITIAL_BOXES
   score_boxes := HEART_SCORE_INITIAL_BOXES;
#else
   score_boxes := 8;
#endif
#ifdef HEART_SCORE_INITIAL_BOX_COLOR
   score_box_color := HEART_SCORE_INITIAL_BOX_COLOR;
#else
   score_box_color := VCS_NTSC_PALE_GREEN;
#endif
   score_color := VCS_NTSC_LIGHT_CORAL;
   right_joystick_ready := 0x0f;
}

void clamp_score_to_boxes(void) {
   if (score_score > score_boxes) {
      score_score := score_boxes;
      score_half := 0;
   }
   else {
      if (score_half) {
         if (score_score >= score_boxes) {
            score_half := 0;
         }
      }
   }
}

void update_score_controls(void) {
   // 0x0f means armed; 0 means a press is latched. A direction roll remains
   // part of the same press; the stick must return fully neutral to re-arm.
   if (right_joystick_ready) {
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         // Right joystick UP/DOWN changes health by half a heart. LEFT/RIGHT
         // decreases/increases capacity by one box. Direction priority is
         // UP, DOWN, LEFT, RIGHT if impossible diagonals are asserted.
         if (!(right_joystick_ready & 0x01)) {
            if (score_half) {
               if (score_score < score_boxes) {
                  score_score++;
               }
               score_half := 0;
            }
            else {
               if (score_score < score_boxes) {
                  score_half := 1;
               }
            }
         }
         else {
            if (!(right_joystick_ready & 0x02)) {
               if (score_half) {
                  score_half := 0;
               }
               else {
                  if (score_score) {
                     score_score--;
                     score_half := 1;
                  }
               }
            }
            else {
               if (!(right_joystick_ready & 0x04)) {
                  if (score_boxes) {
                     score_boxes--;
                     clamp_score_to_boxes();
                  }
               }
               else {
                  if (!(right_joystick_ready & 0x08)) {
                     if (score_boxes < 11) {
                        score_boxes++;
                     }
                  }
               }
            }
         }
         right_joystick_ready := 0;
      }
   }
   else {
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         right_joystick_ready := 0;
      }
   }
}
