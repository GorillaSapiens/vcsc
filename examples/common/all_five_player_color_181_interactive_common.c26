// Shared 181-line all-five/player-color interactive body.
// The including cartridge must instantiate `game` and a mutable-color `score`,
// then define draw_visible_components() for score-above or score-below ordering.

page const uint8_t game_playfield[44] := {
   VCS_PLAYFIELD_ROW(0bX.....X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.X.....X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0b..X....._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b...X...._.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b....X..._..X....._X.....X._....X...),
   VCS_PLAYFIELD_ROW(0b.....X.._...X...._.X.....X_.....X..),
   VCS_PLAYFIELD_ROW(0b......X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.......X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0bX......._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b.X......_.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b..X....._..X....._X.....X._....X...)
};

page const uint8_t game_player0_colors[8] := {
   VCS_NTSC_SKY_BLUE,
   VCS_NTSC_SKY_BLUE_2,
   VCS_NTSC_ROYAL_BLUE,
   VCS_NTSC_MEDIUM_PURPLE,
   VCS_NTSC_VIOLET,
   VCS_NTSC_ORCHID,
   VCS_NTSC_LIGHT_CORAL,
   VCS_NTSC_SANDY_BROWN
};

page const uint8_t game_player1_colors[8] := {
   VCS_NTSC_PALE_GREEN,
   VCS_NTSC_AQUAMARINE,
   VCS_NTSC_SKY_BLUE,
   VCS_NTSC_SKY_BLUE_2,
   VCS_NTSC_ROYAL_BLUE,
   VCS_NTSC_MEDIUM_PURPLE,
   VCS_NTSC_VIOLET,
   VCS_NTSC_ORCHID
};

// These source rows are intentionally bottom-to-top. The maintained renderers
// reverse macro arguments for highest-index-to-zero traversal, so this matches
// the faithful legacy interactive sprite orientation.
page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(
      0b.X....X.,
      0bX.X..X.X,
      0bX.XXXX.X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0b.XXXXXX.,
      0b..XXXX..,
      0b.XX..XX.
   )
};

page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(
      0bX.X..X.X,
      0b.X.XX.X.,
      0b..X..X..,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.XX..XX.,
      0b..XXXX..
   )
};

alias OBJECT_MAX_Y 87
alias SELECTED_OBJECT_COUNT 5

uint8_t selected_object := 0;
uint8_t select_switch_ready := 1;
uint8_t selected_score_digit := 0;
uint8_t right_joystick_ready := 1;
uint8_t object_y[5] := { 18, 78, 34, 62, 48 };

inline void update_controls(void) {
   // Compact hand-written controls keep this combined renderer + score inside
   // an unbanked 4K cartridge.  X indexes the five contiguous object arrays;
   // Y holds the sampled SWCHA value for both joysticks.
   asm lda SWCHB;
   asm lsr;
   asm bcc.flex @afpc_reset;
   asm and #$01;
   asm beq.flex @afpc_select_pressed;
   // A is $02 on release; keep that nonzero value as the ready flag.
   asm sta.z select_switch_ready;
   asm bne.flex @afpc_move_object;

   asm @afpc_reset:;
   asm jmp ($fffc);

   asm @afpc_select_pressed:;
   asm lda.z select_switch_ready;
   asm beq.flex @afpc_move_object;
   asm lda #$00;
   asm sta.z select_switch_ready;
   asm inc.z selected_object;
   asm lda.z selected_object;
   asm cmp #$05;
   asm bcc.flex @afpc_move_object;
   asm lda #$00;
   asm sta.z selected_object;

   asm @afpc_move_object:;
   asm ldx.z selected_object;
   asm ldy SWCHA;

   // Left joystick horizontal: left has priority over right.
   asm tya;
   asm and #$40;
   asm bne.flex @afpc_check_right;
   asm lda.zx game_object_x,x;
   asm beq.flex @afpc_check_up;
   asm dec.zx game_object_x,x;
   asm jmp @afpc_check_up;
   asm @afpc_check_right:;
   asm tya;
   asm and #$80;
   asm bne.flex @afpc_check_up;
   asm lda.zx game_object_x,x;
   asm cmp #$9f;
   asm bcs.flex @afpc_check_up;
   asm inc.zx game_object_x,x;

   // Left joystick vertical: up has priority over down.
   asm @afpc_check_up:;
   asm tya;
   asm and #$10;
   asm bne.flex @afpc_check_down;
   asm lda.zx object_y,x;
   asm beq.flex @afpc_score_controls;
   asm dec.zx object_y,x;
   asm jmp @afpc_score_controls;
   asm @afpc_check_down:;
   asm tya;
   asm and #$20;
   asm bne.flex @afpc_score_controls;
   asm lda.zx object_y,x;
   asm cmp #$57;
   asm bcs.flex @afpc_score_controls;
   asm inc.zx object_y,x;

   // Right joystick uses the standard immediate one-action-per-press score
   // controls.  Full neutral is required before another direction can act.
   asm @afpc_score_controls:;
   asm lda.z right_joystick_ready;
   asm beq.flex @afpc_score_latched;
   asm tya;
   asm and #$0f;
   asm cmp #$0f;
   asm beq.flex @afpc_controls_done;
   // Keep Y as the sampled joystick state; the ready byte is just a latch.

   // Right/left select the decimal digit; either horizontal action advances
   // the score hue by $10, matching the other interactive score examples.
   asm and #$04;
   asm bne.flex @afpc_score_check_left;
   asm inc.z selected_score_digit;
   asm lda.z selected_score_digit;
   asm cmp #$06;
   asm bcc.flex @afpc_score_color;
   asm lda #$00;
   asm sta.z selected_score_digit;
   asm beq.flex @afpc_score_color;
   asm @afpc_score_check_left:;
   asm tya;
   asm and #$08;
   asm bne.flex @afpc_score_vertical;
   asm dec.z selected_score_digit;
   asm bpl.flex @afpc_score_color;
   asm lda #$05;
   asm sta.z selected_score_digit;
   asm @afpc_score_color:;
   score_color += 0x10;

   // Up/down add/subtract 10^selected_digit directly in packed BCD.  This is
   // equivalent to the shared bcd24_t weight-table implementation, but avoids
   // bringing its 24-bit generic arithmetic into this nearly-full 4K image.
   asm @afpc_score_vertical:;
   asm tya;
   asm and #$01;
   asm beq.flex @afpc_score_increment;
   asm tya;
   asm and #$02;
   asm beq.flex @afpc_score_decrement;
   asm bne.flex @afpc_score_latch;

   asm @afpc_score_increment:;
   asm ldx.z selected_score_digit;
   asm txa;
   asm lsr;
   asm tax;
   asm lda.zx score_score,x;
   asm sed;
   asm bcc.flex @afpc_score_inc_even;
   asm clc;
   asm adc #$10;
   asm jmp @afpc_score_inc_store;
   asm @afpc_score_inc_even:;
   asm clc;
   asm adc #$01;
   asm @afpc_score_inc_store:;
   asm sta.zx score_score,x;
   asm @afpc_score_inc_carry:;
   asm bcc.flex @afpc_score_adjust_done;
   asm inx;
   asm cpx #$03;
   asm bcs.flex @afpc_score_adjust_done;
   asm lda.zx score_score,x;
   asm sec;
   asm adc #$00;
   asm sta.zx score_score,x;
   asm jmp @afpc_score_inc_carry;

   asm @afpc_score_decrement:;
   asm ldx.z selected_score_digit;
   asm txa;
   asm lsr;
   asm tax;
   asm lda.zx score_score,x;
   asm sed;
   asm bcc.flex @afpc_score_dec_even;
   asm sec;
   asm sbc #$10;
   asm jmp @afpc_score_dec_store;
   asm @afpc_score_dec_even:;
   asm sec;
   asm sbc #$01;
   asm @afpc_score_dec_store:;
   asm sta.zx score_score,x;
   asm @afpc_score_dec_borrow:;
   asm bcs.flex @afpc_score_adjust_done;
   asm inx;
   asm cpx #$03;
   asm bcs.flex @afpc_score_adjust_done;
   asm lda.zx score_score,x;
   asm clc;
   asm sbc #$00;
   asm sta.zx score_score,x;
   asm jmp @afpc_score_dec_borrow;

   asm @afpc_score_adjust_done:;
   asm cld;
   asm @afpc_score_latch:;
   asm lda #$00;
   asm sta.z right_joystick_ready;
   asm beq.flex @afpc_controls_done;

   asm @afpc_score_latched:;
   asm tya;
   asm and #$0f;
   asm cmp #$0f;
   asm bne.flex @afpc_controls_done;
   asm sta.z right_joystick_ready;
   asm @afpc_controls_done:;
}
inline void sync_object_y(void) {
   game_player0_y := object_y[0];
   game_player1_y := object_y[1];
   game_missile0_y := object_y[2];
   game_missile1_y := object_y[3];
   game_ball_y := object_y[4];
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;

   game_PLAYER0_X := 20;
   game_PLAYER1_X := 130;
   game_MISSILE0_X := 50;
   game_MISSILE1_X := 110;
   game_BALL_X := 80;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 5;
   game_missile1_height := 7;
   game_ball_height := 3;
   score_score := 123456;

   game_init();
   score_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      sync_object_y();
      game_vblank();
      score_vblank();
      vcs_ntsc_end_vblank();
      draw_visible_components();
      vcs_ntsc_begin_overscan();
      game_overscan();
      score_overscan();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
