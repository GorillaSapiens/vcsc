// Shared 181-line all-five/player-color interactive body with a fixed score.
// The including cartridge must instantiate `game` and `score`, then define
// draw_visible_components() for score-above or score-below ordering.

page const uint8_t game_playfield[44] := {
   VCS_PLAYFIELD_ROW(0bX......._........_........_........),
   VCS_PLAYFIELD_ROW(0b.X......_........_........_........),
   VCS_PLAYFIELD_ROW(0b..X....._........_........_........),
   VCS_PLAYFIELD_ROW(0b...X...._........_........_........),
   VCS_PLAYFIELD_ROW(0b....X..._........_........_........),
   VCS_PLAYFIELD_ROW(0b.....X.._........_........_........),
   VCS_PLAYFIELD_ROW(0b......X._........_........_........),
   VCS_PLAYFIELD_ROW(0b.......X_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_X......._........_........),
   VCS_PLAYFIELD_ROW(0b........_.X......_........_........),
   VCS_PLAYFIELD_ROW(0b........_..X....._........_........)
};

page const uint8_t game_player0_colors[8] := {
   VCS_NTSC_SKY_BLUE,
   VCS_NTSC_SKY_BLUE_2,
   VCS_NTSC_ROYAL_BLUE,
   VCS_NTSC_MEDIUM_PURPLE,
   VCS_NTSC_VIOLET,
   VCS_NTSC_ORCHID,
   VCS_NTSC_LIGHT_CORAL,
   VCS_NTSC_SANDY_BROWN
};

page const uint8_t game_player1_colors[8] := {
   VCS_NTSC_PALE_GREEN,
   VCS_NTSC_AQUAMARINE,
   VCS_NTSC_SKY_BLUE,
   VCS_NTSC_SKY_BLUE_2,
   VCS_NTSC_ROYAL_BLUE,
   VCS_NTSC_MEDIUM_PURPLE,
   VCS_NTSC_VIOLET,
   VCS_NTSC_ORCHID
};

// These source rows are intentionally bottom-to-top. The maintained renderers
// reverse macro arguments for highest-index-to-zero traversal, so this matches
// the faithful legacy interactive sprite orientation.
page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(
      0b.X....X.,
      0bX.X..X.X,
      0bX.XXXX.X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0b.XXXXXX.,
      0b..XXXX..,
      0b.XX..XX.
   )
};

page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(
      0bX.X..X.X,
      0b.X.XX.X.,
      0b..X..X..,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.XX..XX.,
      0b..XXXX..
   )
};

alias OBJECT_MAX_Y 87
alias SELECTED_OBJECT_COUNT 5

uint8_t selected_object := 0;
uint8_t select_switch_ready := 1;
uint8_t object_y[5] := { 18, 78, 34, 62, 48 };

inline void update_controls(void) {
   // Game Select cycles P0, P1, M0, M1, Ball once per press.
   if (SWCHB & 0x02) {
      select_switch_ready := 1;
   }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object >= SELECTED_OBJECT_COUNT) {
            selected_object := 0;
         }
         select_switch_ready := 0;
      }
   }

   // Left joystick moves the selected object in both axes.
   if (!(SWCHA & 0x40)) {
      if (game_object_x[selected_object] > 0) {
         game_object_x[selected_object]--;
      }
   }
   else {
      if (!(SWCHA & 0x80)) {
         if (game_object_x[selected_object] < 159) {
            game_object_x[selected_object]++;
         }
      }
   }

   if (!(SWCHA & 0x10)) {
      if (object_y[selected_object] > 0) {
         object_y[selected_object]--;
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         if (object_y[selected_object] < OBJECT_MAX_Y) {
            object_y[selected_object]++;
         }
      }
   }
}

inline void sync_object_y(void) {
   game_player0_y := object_y[0];
   game_player1_y := object_y[1];
   game_missile0_y := object_y[2];
   game_missile1_y := object_y[3];
   game_ball_y := object_y[4];
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;

   game_PLAYER0_X := 20;
   game_PLAYER1_X := 130;
   game_MISSILE0_X := 50;
   game_MISSILE1_X := 110;
   game_BALL_X := 80;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 5;
   game_missile1_height := 7;
   game_ball_height := 3;
   score_score := 123456;

   game_init();
   score_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      sync_object_y();
      game_vblank();
      score_vblank();
      vcs_ntsc_end_vblank();
      draw_visible_components();
      vcs_ntsc_begin_overscan();
      game_overscan();
      score_overscan();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
