// Shared player-color 181-line interactive application body.
// The including cartridge must instantiate `game` and `score`, then define:
//   initialize_score_state(), update_score_controls(), draw_visible_components().

page const uint8_t game_playfield[44] := {
   VCS_PLAYFIELD_ROW(0bX.....X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.X.....X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0b..X....._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b...X...._.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b....X..._..X....._X.....X._....X...),
   VCS_PLAYFIELD_ROW(0b.....X.._...X...._.X.....X_.....X..),
   VCS_PLAYFIELD_ROW(0b......X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.......X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0bX......._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b.X......_.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b..X....._..X....._X.....X._....X...)
};

// These source rows are intentionally bottom-to-top. The maintained renderers
// reverse macro arguments for highest-index-to-zero traversal, so this makes
// the displayed sprites match the faithful legacy interactive example.
// Four-frame versions of the two standard interactive-example sprites.
// Frame zero is the original artwork; the frame is selected from X/Y.
page const uint8_t p0_animation[32] := {
   game_SPRITE_GLYPH(
      0b.X....X.,
      0bX.X..X.X,
      0bX.XXXX.X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0b.XXXXXX.,
      0b..XXXX..,
      0b.XX..XX.
   ),
   game_SPRITE_GLYPH(
      0b..X..X..,
      0b.X.XX.X.,
      0bX.XXXX.X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0b.XXXXXX.,
      0b.X.XX.X.,
      0bX..XX..X
   ),
   game_SPRITE_GLYPH(
      0b.X....X.,
      0bX.X..X.X,
      0bX.XXXX.X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0b.XXXXXX.,
      0b.X.XX.X.,
      0bX......X
   ),
   game_SPRITE_GLYPH(
      0bX......X,
      0b.X.XX.X.,
      0bX.XXXX.X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0b.XXXXXX.,
      0b..XXXX..,
      0b..X..X..
   )
};

page const uint8_t p1_animation[32] := {
   game_SPRITE_GLYPH(
      0bX.X..X.X,
      0b.X.XX.X.,
      0b..X..X..,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.XX..XX.,
      0b..XXXX..
   ),
   game_SPRITE_GLYPH(
      0b.X.X.X..,
      0b..XXXX..,
      0b.X....X.,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.XX..XX.,
      0b..XXXX..
   ),
   game_SPRITE_GLYPH(
      0b..X..X..,
      0b.X.XX.X.,
      0bX......X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.XX..XX.,
      0b..XXXX..
   ),
   game_SPRITE_GLYPH(
      0b..X.X.X.,
      0b..XXXX..,
      0b.X....X.,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.XX..XX.,
      0b..XXXX..
   )
};

page const uint8_t game_player0_colors[8] := {
   game_SPRITE_GLYPH(
      VCS_NTSC_SKY_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_VIOLET,
      VCS_NTSC_ORCHID,
      VCS_NTSC_LIGHT_CORAL,
      VCS_NTSC_SANDY_BROWN
   )
};

page const uint8_t game_player1_colors[8] := {
   game_SPRITE_GLYPH(
      VCS_NTSC_ORCHID,
      VCS_NTSC_VIOLET,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_SKY_BLUE,
      VCS_NTSC_AQUAMARINE,
      VCS_NTSC_PALE_GREEN
   )
};

alias OBJECT_MAX_Y 87
alias SELECTED_PLAYER0 0
alias SELECTED_PLAYER1 1
alias SELECTED_BALL    2
alias SELECTED_OBJECT_COUNT 3

uint8_t selected_object := SELECTED_PLAYER0;
uint8_t select_switch_ready := 1;

void configure_game_frame(void) {
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;
}

inline void update_player_animation(void) {
   game_player0_graphics := p0_animation;
   game_player0_graphics += ((game_PLAYER0_X ^ game_player0_y) & 0x03) << 3;

   game_player1_graphics := p1_animation;
   game_player1_graphics += ((game_PLAYER1_X ^ game_player1_y) & 0x03) << 3;
}

void initialize_scene(void) {
   VBLANK := 2;
   game_PLAYER0_X := 44;
   game_PLAYER1_X := 108;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_BALL_X := 78;
   game_player0_y := 70;
   game_player1_y := 42;
   game_ball_y := 45;
   update_player_animation();
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;
   selected_object := SELECTED_PLAYER0;
   select_switch_ready := 1;
   initialize_score_state();
   game_init();
   score_init();
}

inline void update_object_selection(void) {
   if (SWCHB & 0x02) {
      select_switch_ready := 1;
   }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object >= SELECTED_OBJECT_COUNT) {
            selected_object := SELECTED_PLAYER0;
         }
         select_switch_ready := 0;
      }
   }
}

inline void move_selected_object(void) {
   if (!(SWCHA & 0x40)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:
            if (game_PLAYER0_X > 0) { game_PLAYER0_X--; }
            break;
         case SELECTED_PLAYER1:
            if (game_PLAYER1_X > 0) { game_PLAYER1_X--; }
            break;
         default:
            if (game_BALL_X > 0) { game_BALL_X--; }
      }
   }
   else {
      if (!(SWCHA & 0x80)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:
               if (game_PLAYER0_X < 159) { game_PLAYER0_X++; }
               break;
            case SELECTED_PLAYER1:
               if (game_PLAYER1_X < 159) { game_PLAYER1_X++; }
               break;
            default:
               if (game_BALL_X < 159) { game_BALL_X++; }
         }
      }
   }

   if (!(SWCHA & 0x10)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:
            if (game_player0_y > 0) { game_player0_y--; }
            break;
         case SELECTED_PLAYER1:
            if (game_player1_y > 0) { game_player1_y--; }
            break;
         default:
            if (game_ball_y > 0) { game_ball_y--; }
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:
               if (game_player0_y < OBJECT_MAX_Y) { game_player0_y++; }
               break;
            case SELECTED_PLAYER1:
               if (game_player1_y < OBJECT_MAX_Y) { game_player1_y++; }
               break;
            default:
               if (game_ball_y < OBJECT_MAX_Y) { game_ball_y++; }
         }
      }
   }
}

inline void update_controls(void) {
   // Keep the console Reset path scratch-free; the renderer's hidden
   // assembly helper stack now consumes the bytes previously borrowed here.
   if (!(SWCHB & 0x01)) {
      hard_reset();
   }
   update_object_selection();
   move_selected_object();
   update_player_animation();
   update_score_controls();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   initialize_scene();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      score_vblank();
      configure_game_frame();
      vcs_ntsc_end_vblank();
      draw_visible_components();
      vcs_ntsc_begin_overscan();
      game_overscan();
      score_overscan();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
