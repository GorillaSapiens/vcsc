// Shared controls for fixed-position six-digit packed-BCD score examples.
// The including source must instantiate the display as `score`.

uint8_t selected_score_digit := 0;
uint8_t right_joystick_ready := 0x0f;

// Decimal digit weights, indexed from ones through hundred-thousands.
page const bcd24_t score_digit_weight[6] := { 1, 10, 100, 1000, 10000, 100000 };

inline void initialize_score_state(void) {
   score_score := 123456;
   score_color := VCS_NTSC_GRAY_92;
   selected_score_digit := 0;
   right_joystick_ready := 0x0f;
}

inline void update_score_controls(void) {
   // 0x0f means armed; 0 means a press is latched. Reuse this byte for the
   // current low SWCHA nibble so edge detection needs no extra scratch RAM.
   if (right_joystick_ready) {
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         // A horizontal press chooses the decimal digit and advances the hue.
         if (!(right_joystick_ready & 0x04)) {
            selected_score_digit++;
            if (selected_score_digit >= 6) {
               selected_score_digit := 0;
            }
            score_color += 0x10;
         }
         else {
            if (!(right_joystick_ready & 0x08)) {
               if (selected_score_digit == 0) {
                  selected_score_digit := 5;
               }
               else {
                  selected_score_digit--;
               }
               score_color += 0x10;
            }
         }

         // A vertical press changes the selected decimal weight. Up has
         // priority if both active-low direction bits are asserted.
         if (!(right_joystick_ready & 0x01)) {
            score_score += score_digit_weight[selected_score_digit];
         }
         else {
            if (!(right_joystick_ready & 0x02)) {
               score_score -= score_digit_weight[selected_score_digit];
            }
         }
         right_joystick_ready := 0;
      }
   }
   else {
      // Stay latched through a hold or direction roll; only full neutral re-arms.
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         right_joystick_ready := 0;
      }
   }
}
