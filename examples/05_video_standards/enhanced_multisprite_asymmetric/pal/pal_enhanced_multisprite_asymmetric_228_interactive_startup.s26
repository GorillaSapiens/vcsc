;
; Compact startup for the native 228-line F8 enhanced-asymmetric diagnostic.
;
; This example initializes every writable DATA value explicitly before the
; first frame and needs no C constructors.  The stock generic VCSC runtime
; therefore spends several hundred ROM bytes on copy/zero/init machinery this
; cartridge cannot use.  Clear the whole RIOT RAM/TIA windows directly and
; tail-enter main instead.  Do not copy this startup into programs that depend
; on nonzero DATA initializers or constructors.

.import main
.export __reset
.export __nmi
.export __irqbrk

.segment "CODE"
__reset:
   sei
   cld
   ldx #$ff
   txs

   lda #0
   ldx #$7f
@clear_ram:
   sta $80,x
   dex
   bpl.same @clear_ram

   ; Real TIA power-on state is unspecified.  Clear the non-beam write window through the always-valid TIA $40 mirror
   ; ($44-$6C mirrors $04-$2C) while deliberately leaving VSYNC/VBLANK/WSYNC/RSYNC ($00-$03)
   ; alone.  Descending order reaches HMCLR immediately before HMOVE, so HMOVE
   ; applies zero motion; graphics/enables are cleared before the position-reset
   ; strobes at $10-$14.  This also clears VDEL state and collision latches.
   ldx #$28
@clear_tia:
   sta $44,x
   dex
   bpl.same @clear_tia

   ldx #$ff
   txs
   jmp main

__nmi:
__irqbrk:
   rti
