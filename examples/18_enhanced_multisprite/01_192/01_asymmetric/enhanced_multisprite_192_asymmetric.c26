// Asymmetric-PF P0/P1 six-sprite multiplexer, using the maintained multisprite
// scene data and Select/joystick/Reset controls.
include "vcs_4k.c26"

// The build selects VCS_NTSC_EXTENDED_VBLANK because top-edge sprites are
// pre-positioned during VBLANK.  frame_ntsc.c26 moves timer budget from this
// example's light overscan into VBLANK without changing the frame total.
include "frame_ntsc.c26"
include "color_ntsc.c26"
instantiate "renderers/enhanced_multisprite_asymmetric/enhanced_multisprite.c26" as game (lines:=192)
include "../../../common/multisprite_interactive_common.c26"

// Twelve 16-scanline diagnostic rows.  Each row is eight logical
// two-scanline bands, so all 192 visible scanlines are covered.  The 40
// playfield bits form parallel one-bit diagonals with exactly five blank
// playfield bits between them.  Successive rows shift the pattern by one bit;
// any wrong PF byte, stale half, or mistimed rewrite is therefore easy to spot.
//
// Arrays are indexed bottom-to-top by the raster (95 -> 0), so the 12 visual
// rows below are stored in reverse order.  PF0 uses bits 4..7; PF1/PF2 retain
// the renderer's existing hardware-order packing.
alias ASYM_ROW8(x) x,x,x,x,x,x,x,x

page const uint8_t game_playfield_left_pf0[96] := {
   ASYM_ROW8(0x00), ASYM_ROW8(0x00), ASYM_ROW8(0x80), ASYM_ROW8(0x40),
   ASYM_ROW8(0x20), ASYM_ROW8(0x10), ASYM_ROW8(0x00), ASYM_ROW8(0x00),
   ASYM_ROW8(0x80), ASYM_ROW8(0x40), ASYM_ROW8(0x20), ASYM_ROW8(0x10)
};
page const uint8_t game_playfield_right_pf0[96] := {ASYM_ROW8(0x80), ASYM_ROW8(0x40), ASYM_ROW8(0x20), ASYM_ROW8(0x10),
   ASYM_ROW8(0x00), ASYM_ROW8(0x00), ASYM_ROW8(0x80), ASYM_ROW8(0x40),
   ASYM_ROW8(0x20), ASYM_ROW8(0x10), ASYM_ROW8(0x00), ASYM_ROW8(0x00)
};

// PF1 occupies [0..95] and PF2 [96..191] on the left.  The right table keeps
// the renderer's historical packing: PF2 first, PF1 second.
page const uint8_t game_playfield_left[192] := {
   // left PF1, visual rows 11..0
   ASYM_ROW8(0x41), ASYM_ROW8(0x82), ASYM_ROW8(0x04), ASYM_ROW8(0x08),
   ASYM_ROW8(0x10), ASYM_ROW8(0x20), ASYM_ROW8(0x41), ASYM_ROW8(0x82),
   ASYM_ROW8(0x04), ASYM_ROW8(0x08), ASYM_ROW8(0x10), ASYM_ROW8(0x20),
   // left PF2, visual rows 11..0
   ASYM_ROW8(0x20), ASYM_ROW8(0x10), ASYM_ROW8(0x08), ASYM_ROW8(0x04),
   ASYM_ROW8(0x82), ASYM_ROW8(0x41), ASYM_ROW8(0x20), ASYM_ROW8(0x10),
   ASYM_ROW8(0x08), ASYM_ROW8(0x04), ASYM_ROW8(0x82), ASYM_ROW8(0x41)
};
page const uint8_t game_playfield_right[192] := {
   // right PF2, visual rows 11..0
   ASYM_ROW8(0x08), ASYM_ROW8(0x04), ASYM_ROW8(0x82), ASYM_ROW8(0x41),
   ASYM_ROW8(0x20), ASYM_ROW8(0x10), ASYM_ROW8(0x08), ASYM_ROW8(0x04),
   ASYM_ROW8(0x82), ASYM_ROW8(0x41), ASYM_ROW8(0x20), ASYM_ROW8(0x10),
   // right PF1, visual rows 11..0
   ASYM_ROW8(0x04), ASYM_ROW8(0x08), ASYM_ROW8(0x10), ASYM_ROW8(0x20),
   ASYM_ROW8(0x41), ASYM_ROW8(0x82), ASYM_ROW8(0x04), ASYM_ROW8(0x08),
   ASYM_ROW8(0x10), ASYM_ROW8(0x20), ASYM_ROW8(0x41), ASYM_ROW8(0x82)
};

const uint8_t asymmetric_initial_x[6] := { 18,36,62,88,114,140 };
const uint8_t asymmetric_initial_y[6] := { 76,76,76,42,42,16 };
const uint8_t asymmetric_initial_color[6] := {
   VCS_NTSC_GRAY_92,VCS_NTSC_LIGHT_CORAL,VCS_NTSC_PALE_GREEN,
   VCS_NTSC_SKY_BLUE,VCS_NTSC_ORCHID,VCS_NTSC_AQUAMARINE
};

void initialize_enhanced_scene(void) {
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0;

   // Initialize the five parallel six-sprite arrays in one compact loop.
   asm ldx #5;
   asm @asymmetric_init_loop:;
   asm lda.ax asymmetric_initial_x,X;
   asm sta.zx game_x,X;
   asm lda.ax asymmetric_initial_y,X;
   asm sta.zx game_y,X;
   asm lda #9;
   asm sta.zx game_height,X;
   asm lda #0;
   asm sta.zx game_nusiz,X;
   asm lda.ax asymmetric_initial_color,X;
   asm sta.zx game_color,X;
   asm dex;
   asm bpl.same @asymmetric_init_loop;

   selected_object := SELECTED_PLAYER0;
   select_switch_ready := 1;
   game_init();
}

// The selected sprite index directly addresses the renderer's parallel X/Y
// arrays, so motion needs no switch table or four out-of-line wrappers.
void update_asymmetric_selection(void) {
   update_multisprite_selection();
}
void update_asymmetric_motion(void) {
   asm ldx.z selected_object;

   // Horizontal: left wins if both impossible directions are asserted.
   asm lda SWCHA;
   asm and #$40;
   asm bne.same @asymmetric_check_right;
   asm lda.zx game_x,X;
   asm beq.same @asymmetric_vertical;
   asm dec.zx game_x,X;
   asm jmp @asymmetric_vertical;
   asm @asymmetric_check_right:;
   asm lda SWCHA;
   asm bmi.same @asymmetric_vertical;
   asm lda.zx game_x,X;
   asm cmp #159;
   asm bcs.same @asymmetric_vertical;
   asm inc.zx game_x,X;

   asm @asymmetric_vertical:;
   asm lda SWCHA;
   asm and #$10;
   asm bne.same @asymmetric_check_down;
   asm lda.zx game_y,X;
   asm cmp #95;
   asm bcs.same @asymmetric_motion_done;
   asm inc.zx game_y,X;
   asm rts;
   asm @asymmetric_check_down:;
   asm lda SWCHA;
   asm and #$20;
   asm bne.same @asymmetric_motion_done;
   asm lda.zx game_y,X;
   asm beq.same @asymmetric_motion_done;
   asm dec.zx game_y,X;
   asm @asymmetric_motion_done:;
}

void run_asymmetric_frame(void) {
   vcs_ntsc_vsync();
   vcs_ntsc_begin_vblank();
   game_vblank();
   vcs_ntsc_end_vblank();

   game_draw();

   vcs_ntsc_begin_overscan();
   game_overscan();
   if (!(SWCHB & 0x01)) { initialize_enhanced_scene(); }
   else { update_asymmetric_selection(); update_asymmetric_motion(); }
   vcs_ntsc_end_overscan();
   // Calibrated terminal blank boundary: VBLANK remains asserted and the
   // public diagnostic stays at a stable 262-line NTSC frame.
   WSYNC := _;
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   initialize_enhanced_scene();

   while (1) {
      run_asymmetric_frame();
   }
}
