// Symmetric P0/P1 six-sprite multiplexer, using the maintained multisprite
// scene data and Select/joystick/Reset controls.
include "vcs_8k_f8sc.c26"

// The build selects VCS_NTSC_EXTENDED_VBLANK because top-edge sprites are
// pre-positioned during VBLANK.  frame_ntsc.c26 moves nine timer quanta from
// this example's light overscan into VBLANK without changing the frame total.
include "frame_ntsc.c26"
include "color_ntsc.c26"
instantiate "renderers/enhanced_multisprite_asymmetric/enhanced_multisprite.c26" as game
include "../../../common/multisprite_interactive_common.c26"

// Six asymmetric 40-bit rows, expanded to one byte per two-line logical band
// so the beam-critical raster never calculates a row transition.  PF0 uses
// its high nibble, as on the TIA; left and right halves are fully independent.
page const uint8_t game_playfield_left_pf0[96] := {
   0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,0xf0,
   0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,0x90,
