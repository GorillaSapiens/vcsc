// Symmetric P0/P1 six-sprite multiplexer, using the maintained multisprite
// scene data and Select/joystick/Reset controls.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
instantiate "renderers/enhanced_multisprite_asymmetric/enhanced_multisprite.c26" as game
include "../../../common/multisprite_interactive_common.c26"

// Six asymmetric 32-scanline rows, expanded to one byte per two-line logical
// band so the beam-critical raster never calculates a row transition.
page const uint8_t game_playfield_left[192] := {
   0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,0xc3,
   0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,0xa5,
