void initialize_enhanced_scene(void) {
   // Initialize only state this player-only diagnostic actually consumes.
   // The shared multisprite initializer also writes missile/ball compatibility
   // state and a set of Y positions immediately overwritten below; omitting
   // those dead stores keeps the asymmetric 4K stress cartridge linkable as
   // the beam-critical renderer grows.
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0;

   game_PLAYER0_X := 18;
   game_PLAYER1_X := 36;
   game_PLAYER2_X := 62;
   game_PLAYER3_X := 88;
   game_PLAYER4_X := 114;
   game_PLAYER5_X := 140;

   // Three-way overlap: two of these three are visible every frame and the
   // pair rotates 0/1, 1/2, 2/0. Their X positions stay independent.
   game_PLAYER0_Y := 76;
   game_PLAYER1_Y := 76;
   game_PLAYER2_Y := 76;

   // Two-way overlap: both are solid because P0 and P1 can service the band.
   game_PLAYER3_Y := 42;
   game_PLAYER4_Y := 42;

   // One isolated sprite demonstrates same-frame hardware-player reuse.
   game_PLAYER5_Y := 16;

   game_PLAYER0_HEIGHT := 9;
   game_PLAYER1_HEIGHT := 9;
   game_PLAYER2_HEIGHT := 9;
   game_PLAYER3_HEIGHT := 9;
   game_PLAYER4_HEIGHT := 9;
   game_PLAYER5_HEIGHT := 9;

   game_PLAYER0_NUSIZ := 0;
   game_PLAYER1_NUSIZ := 0;
   game_PLAYER2_NUSIZ := 0;
   game_PLAYER3_NUSIZ := 0;
   game_PLAYER4_NUSIZ := 0;
   game_PLAYER5_NUSIZ := 0;

   game_PLAYER0_COLOR := VCS_NTSC_GRAY_92;
   game_PLAYER1_COLOR := VCS_NTSC_LIGHT_CORAL;
   game_PLAYER2_COLOR := VCS_NTSC_PALE_GREEN;
   game_PLAYER3_COLOR := VCS_NTSC_SKY_BLUE;
   game_PLAYER4_COLOR := VCS_NTSC_ORCHID;
   game_PLAYER5_COLOR := VCS_NTSC_AQUAMARINE;

   selected_object := SELECTED_PLAYER0;
   select_switch_ready := 1;
   game_init();
}

// Keep the interactive controls fragmented into separate out-of-line helpers.
// The RESP jump table is page-contained; one monolithic control function can
// otherwise fail placement despite the cartridge having enough total ROM.
void update_asymmetric_selection(void) {
   update_multisprite_selection();
}
void move_asymmetric_left(void) {
   asm ldx.z selected_object;
   asm lda.zx game_x,X;
   asm beq.same @done;
   asm sec;
   asm sbc #1;
   asm sta.zx game_x,X;
   asm @done:;
}
void move_asymmetric_right(void) {
   asm ldx.z selected_object;
   asm lda.zx game_x,X;
   asm cmp #159;
   asm bcs.same @done;
   asm clc;
   asm adc #1;
   asm sta.zx game_x,X;
   asm @done:;
}
void move_asymmetric_up(void) {
   asm ldx.z selected_object;
   asm lda.zx game_y,X;
   asm cmp #95;
   asm bcs.same @done;
   asm clc;
   asm adc #1;
   asm sta.zx game_y,X;
   asm @done:;
}
void move_asymmetric_down(void) {
   asm ldx.z selected_object;
   asm lda.zx game_y,X;
   asm beq.same @done;
   asm sec;
   asm sbc #1;
   asm sta.zx game_y,X;
   asm @done:;
}
void update_asymmetric_motion(void) {
   if (!(SWCHA & 0x40)) { move_asymmetric_left(); }
   else { if (!(SWCHA & 0x80)) { move_asymmetric_right(); } }
   if (!(SWCHA & 0x10)) { move_asymmetric_up(); }
   else { if (!(SWCHA & 0x20)) { move_asymmetric_down(); } }
}

void run_asymmetric_frame(void) {
   vcs_ntsc_vsync();
   vcs_ntsc_begin_vblank();
   game_vblank();
   vcs_ntsc_end_vblank();

   game_draw();

   vcs_ntsc_begin_overscan();
   game_overscan();
   if (!(SWCHB & 0x01)) { initialize_enhanced_scene(); }
   else { update_asymmetric_selection(); update_asymmetric_motion(); }
   vcs_ntsc_end_overscan();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   initialize_enhanced_scene();

   while (1) {
      run_asymmetric_frame();
   }
}
