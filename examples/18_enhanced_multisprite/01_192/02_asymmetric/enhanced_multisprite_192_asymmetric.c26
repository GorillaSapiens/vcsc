   0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42,0x42
};

inline void initialize_enhanced_scene(void) {
   initialize_multisprite_scene();

   // Three-way overlap: two of these three are visible every frame and the
   // pair rotates 0/1, 1/2, 2/0. Their X positions stay independent.
   game_PLAYER0_Y := 76;
   game_PLAYER1_Y := 76;
   game_PLAYER2_Y := 76;

   // Two-way overlap: both are solid because P0 and P1 can service the band.
   game_PLAYER3_Y := 42;
   game_PLAYER4_Y := 42;

   // One isolated sprite demonstrates same-frame hardware-player reuse.
   game_PLAYER5_Y := 16;
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   initialize_enhanced_scene();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();

      game_draw();

      vcs_ntsc_begin_overscan();
      game_overscan();
      if (!(SWCHB & 0x01)) { initialize_enhanced_scene(); }
      else { update_multisprite_controls(); }
      vcs_ntsc_end_overscan();
   }
}
