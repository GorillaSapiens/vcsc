alias SPRITE_COUNT 30
alias FRAME_HOLD 8
alias RIGHT_EDGE 159

uint8_t sprite0 := 0;
uint8_t sprite1 := 1;
uint8_t animation_frame := 0;
uint8_t animation_clock := 0;
uint8_t select_ready := 1;
uint8_t pause_animation := 0;
uint8_t fire_ready := 1;

void install_frames(void) {
   // Each hard page starts at low byte zero. Bits 0..2 select a set inside
   // that page; bits 3..4 select one of the four hard-page high bytes.
   asm lda.z sprite0;
   asm and #$07;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta.z game_player0_graphics;
   asm lda.z animation_frame;
   asm asl;
   asm asl;
   asm asl;
   asm ora.z game_player0_graphics;
   asm sta.z game_player0_graphics;
   asm lda.z sprite0;
   asm cmp #8;
   asm bcc @p0_page0;
   asm cmp #16;
   asm bcc @p0_page1;
   asm cmp #24;
   asm bcc @p0_page2;
   asm lda #>sprite_frames_3;
   asm jmp @p0_page_done;
   asm @p0_page0:;
   asm lda #>sprite_frames_0;
   asm jmp @p0_page_done;
   asm @p0_page1:;
   asm lda #>sprite_frames_1;
   asm jmp @p0_page_done;
   asm @p0_page2:;
   asm lda #>sprite_frames_2;
   asm @p0_page_done:;
   asm sta.z game_player0_graphics + 1;

   asm lda.z sprite1;
   asm and #$07;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta.z game_player1_graphics;
   asm lda.z animation_frame;
   asm asl;
   asm asl;
   asm asl;
   asm ora.z game_player1_graphics;
   asm sta.z game_player1_graphics;
   asm lda.z sprite1;
   asm cmp #8;
   asm bcc @p1_page0;
   asm cmp #16;
   asm bcc @p1_page1;
   asm cmp #24;
   asm bcc @p1_page2;
   asm lda #>sprite_frames_3;
   asm jmp @p1_page_done;
   asm @p1_page0:;
   asm lda #>sprite_frames_0;
   asm jmp @p1_page_done;
   asm @p1_page1:;
   asm lda #>sprite_frames_1;
   asm jmp @p1_page_done;
   asm @p1_page2:;
   asm lda #>sprite_frames_2;
   asm @p1_page_done:;
   asm sta.z game_player1_graphics + 1;

   // Count transparent rows above each glyph, then rotate that player's
   // palette by the same amount. The graphics remain immutable;
   // only the row-color mapping follows vertical motion inside the 8x8 cell.
   asm ldy #7;
   asm @p0_find_top:;
   asm lda.iy (game_player0_graphics),y;
   asm bne @p0_top_found;
   asm dey;
   asm bpl @p0_find_top;
   asm ldy #7;
   asm @p0_top_found:;
   asm tya;
   asm eor #7;
   asm tay;
   asm ldx #0;
   asm @p0_copy_colors:;
   asm lda.ay player0_palette,y;
   asm sta.ax game_player0_colors,x;
   asm iny;
   asm tya;
   asm and #7;
   asm tay;
   asm inx;
   asm cpx #8;
   asm bne @p0_copy_colors;

   asm ldy #7;
   asm @p1_find_top:;
   asm lda.iy (game_player1_graphics),y;
   asm bne @p1_top_found;
   asm dey;
   asm bpl @p1_find_top;
   asm ldy #7;
   asm @p1_top_found:;
   asm tya;
   asm eor #7;
   asm tay;
   asm ldx #0;
   asm @p1_copy_colors:;
   asm lda.ay player1_palette,y;
   asm sta.ax game_player1_colors,x;
   asm iny;
   asm tya;
   asm and #7;
   asm tay;
   asm inx;
   asm cpx #8;
   asm bne @p1_copy_colors;
}

inline void next_pair(void) {
   sprite0 += 2;
   if (sprite0 >= SPRITE_COUNT) { sprite0 := 0; }
   sprite1 := sprite0 + 1;
   game_PLAYER0_X := 0;
   game_PLAYER1_X := 0;
   animation_frame := 0;
   animation_clock := 0;
   install_frames();
}

inline void update_animation(void) {
   if (!pause_animation) {
      if (game_PLAYER0_X >= RIGHT_EDGE) {
         next_pair();
      }
      else {
         game_PLAYER0_X++;
         game_PLAYER1_X++;
         animation_clock++;
         if (animation_clock >= FRAME_HOLD) {
            animation_clock := 0;
            animation_frame++;
            if (animation_frame >= 4) {
               animation_frame := 0;
            }
            install_frames();
         }
      }
   }
}

inline void update_controls(void) {
   // Keep the console Reset path scratch-free; the renderer's hidden
   // assembly helper stack now consumes the bytes previously borrowed here.
   asm lda SWCHB;
   asm and #$01;
   asm bne @reset_not_pressed;
   asm jmp ($fffc);
   asm @reset_not_pressed:;

   if (SWCHB & 0x02) {
      select_ready := 1;
   }
   else {
      if (select_ready) {
         next_pair();
         select_ready := 0;
      }
   }

   if (INPT4 & 0x80) {
      fire_ready := 1;
   }
   else {
      if (fire_ready) {
         pause_animation := !pause_animation;
         fire_ready := 0;
      }
   }
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_MEDIUM_PURPLE;
   CTRLPF := 0x21;

   game_PLAYER0_X := 0;
   game_PLAYER1_X := 0;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_BALL_X := 80;

   game_player0_y := 60;
   game_player1_y := 44;
   game_ball_y := 94;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 0;
   game_playfield_position := 8;

   install_frames();
   game_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_animation();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
