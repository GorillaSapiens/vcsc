alias SPRITE_COUNT 30
alias FRAME_HOLD 8
alias THREE_FRAME_SET 3
alias LEFT_EDGE 16
alias RIGHT_EDGE 140

uint8_t sprite0 := 0;
uint8_t sprite1 := 1;
// The low nibble carries the normal modulo-4 phase in bits 0..1 and the
// source-set-03 modulo-3 phase in bits 2..3. The high nibble is the eight-frame
// hold clock, so animation playback needs one persistent byte rather than two.
uint8_t animation_state := 0;

alias CONTROL_SELECT_READY 0x01
alias CONTROL_PAUSED 0x02
alias CONTROL_FIRE_READY 0x04
uint8_t control_flags := CONTROL_SELECT_READY | CONTROL_FIRE_READY;

// Packed phase transition: low bits advance modulo 4 while bits 2..3
// independently advance modulo 3 for source set 03.
const uint8_t animation_phase_next[16] := {
   0x05, 0x06, 0x07, 0x04,
   0x09, 0x0a, 0x0b, 0x08,
   0x01, 0x02, 0x03, 0x00,
   0x05, 0x06, 0x07, 0x04
};

void install_frames(void) {
   // Select the packed row-color page, then advance to this sprite/frame.
   if (sprite0 < 16) {
      game_player0_graphics := sprite_row_colors_0;
   }
   else {
      game_player0_graphics := sprite_row_colors_1;
   }
   game_player0_graphics += (sprite0 & 0x0f) << 4;
   game_player0_graphics += (animation_state & 0x03) << 2;

   // Four packed bytes expand to the renderer's eight per-row TIA colors.
   for (uint8_t color_row0 := 0; color_row0 < 8; color_row0 += 2) {
      game_player0_colors[color_row0] :=
         pico8_tia_palette[game_player0_graphics[color_row0 >> 1] & 0x0f];
      game_player0_colors[color_row0 + 1] :=
         pico8_tia_palette[game_player0_graphics[color_row0 >> 1] >> 4];
   }

   // Install the selected eight-byte bitmap frame.
   if (sprite0 < 8) {
      game_player0_graphics := sprite_frames_0;
   }
   else {
      if (sprite0 < 16) {
         game_player0_graphics := sprite_frames_1;
      }
      else {
         if (sprite0 < 24) {
            game_player0_graphics := sprite_frames_2;
         }
         else {
            game_player0_graphics := sprite_frames_3;
         }
      }
   }
   game_player0_graphics += (sprite0 & 0x07) << 5;
   game_player0_graphics += (animation_state & 0x03) << 3;

   if (sprite1 < 16) {
      game_player1_graphics := sprite_row_colors_0;
   }
   else {
      game_player1_graphics := sprite_row_colors_1;
   }
   game_player1_graphics += (sprite1 & 0x0f) << 4;
   if (sprite1 == THREE_FRAME_SET) {
      // Bits 2..3 are this set's independent modulo-3 phase field.
      game_player1_graphics += animation_state & 0x0c;
   }
   else {
      game_player1_graphics += (animation_state & 0x03) << 2;
   }

   for (uint8_t color_row1 := 0; color_row1 < 8; color_row1 += 2) {
      game_player1_colors[color_row1] :=
         pico8_tia_palette[game_player1_graphics[color_row1 >> 1] & 0x0f];
      game_player1_colors[color_row1 + 1] :=
         pico8_tia_palette[game_player1_graphics[color_row1 >> 1] >> 4];
   }

   if (sprite1 < 8) {
      game_player1_graphics := sprite_frames_0;
   }
   else {
      if (sprite1 < 16) {
         game_player1_graphics := sprite_frames_1;
      }
      else {
         if (sprite1 < 24) {
            game_player1_graphics := sprite_frames_2;
         }
         else {
            game_player1_graphics := sprite_frames_3;
         }
      }
   }
   game_player1_graphics += (sprite1 & 0x07) << 5;
   if (sprite1 == THREE_FRAME_SET) {
      game_player1_graphics += (animation_state & 0x0c) << 1;
   }
   else {
      game_player1_graphics += (animation_state & 0x03) << 3;
   }
}

inline void next_pair(void) {
   sprite0 += 2;
   if (sprite0 >= SPRITE_COUNT) { sprite0 := 0; }
   sprite1 := sprite0 + 1;
   game_PLAYER0_X := LEFT_EDGE;
   game_PLAYER1_X := LEFT_EDGE;
   animation_state := 0;
   install_frames();
}

inline void update_animation(void) {
   if (!(control_flags & CONTROL_PAUSED)) {
      if (game_PLAYER0_X >= RIGHT_EDGE) {
         next_pair();
      }
      else {
         game_PLAYER0_X++;
         game_PLAYER1_X++;
         animation_state += 0x10;
         if (animation_state >= (FRAME_HOLD << 4)) {
            // The ROM transition advances both phase fields and clears the
            // high-nibble frame-hold clock in the same assignment.
            animation_state := animation_phase_next[animation_state & 0x0f];
            install_frames();
         }
      }
   }
}

inline void update_controls(void) {
   // Keep the console Reset path scratch-free; the renderer's hidden
   // assembly helper stack now consumes the bytes previously borrowed here.
   asm lda SWCHB;
   asm and #$01;
   asm bne @reset_not_pressed;
   asm jmp ($fffc);
   asm @reset_not_pressed:;

   if (SWCHB & 0x02) {
      control_flags |= CONTROL_SELECT_READY;
   }
   else {
      if (control_flags & CONTROL_SELECT_READY) {
         next_pair();
         control_flags &= 0xfe;
      }
   }

   if (INPT4 & 0x80) {
      control_flags |= CONTROL_FIRE_READY;
   }
   else {
      if (control_flags & CONTROL_FIRE_READY) {
         control_flags ^= CONTROL_PAUSED;
         control_flags &= 0xfb;
      }
   }
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_MEDIUM_PURPLE;
   CTRLPF := 0x21;

   game_PLAYER0_X := LEFT_EDGE;
   game_PLAYER1_X := LEFT_EDGE;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_BALL_X := 80;

   game_player0_y := 55;
   game_player1_y := 44;
   game_ball_y := 94;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 0;
   game_playfield_position := 8;

   install_frames();
   game_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_animation();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
