include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"

page const uint8_t game_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0b.X.X.X.X_.X.X.X.X_.X.X.X.X_.X.X.X.X),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0bX.X.X.X._X.X.X.X._X.X.X.X._X.X.X.X.),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX)
};

// Graphics and colors use the renderer's highest-index-to-zero row order.
// The immutable palettes are rotated into the renderer's RAM color tables so
// the bands follow sprites that bob vertically inside their 8x8 source cells.
const uint8_t player0_palette[8] := {
   VCS_NTSC_GOLDENROD, VCS_NTSC_LIGHT_CORAL, VCS_NTSC_SANDY_BROWN,
   VCS_NTSC_GOLDENROD, VCS_NTSC_SANDY_BROWN, VCS_NTSC_LIGHT_CORAL,
   VCS_NTSC_GOLDENROD, VCS_NTSC_MEDIUM_PURPLE
};

const uint8_t player1_palette[8] := {
   VCS_NTSC_SKY_BLUE, VCS_NTSC_AQUAMARINE, VCS_NTSC_PALE_GREEN,
   VCS_NTSC_SKY_BLUE_2, VCS_NTSC_PALE_GREEN, VCS_NTSC_AQUAMARINE,
   VCS_NTSC_SKY_BLUE, VCS_NTSC_ROYAL_BLUE
};

uint8_t game_player0_colors[8];
uint8_t game_player1_colors[8];

alias VCS_PLAYER_COLOR_192_MUTABLE_COLORS 1
template "renderers/player_color_192/player_color_192.c26" as game

// Exact one-bit silhouettes extracted from source PICO-8 sprites 1 through 120.
// Source color 0 is transparent; every other source color becomes a set Atari bit.
// The source program presents these as 30 consecutive four-frame sets. Each
// 32-byte set begins on a 32-byte boundary inside one of four hard pages.
