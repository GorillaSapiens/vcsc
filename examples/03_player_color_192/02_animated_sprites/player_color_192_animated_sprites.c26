include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"

page const uint8_t game_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0b.X.X.X.X_.X.X.X.X_.X.X.X.X_.X.X.X.X),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0b........_........_........_........),
   VCS_PLAYFIELD_ROW(0bX.X.X.X._X.X.X.X._X.X.X.X._X.X.X.X.),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX)
};

// Each displayed scanline gets one source-derived PICO-8 color. A source row's
// most frequent nontransparent color wins; ties choose the tied color whose
// pixels lie nearest the horizontal center, then the lower PICO-8 palette index.
// The chosen source color is mapped at compile time to the nearest NTSC TIA color.
const uint8_t pico8_tia_palette[16] := {
   __builtin_ntsc_rgb(0x00, 0x00, 0x00), //  0 black / transparent
   __builtin_ntsc_rgb(0x1d, 0x2b, 0x53), //  1 dark blue
   __builtin_ntsc_rgb(0x7e, 0x25, 0x53), //  2 dark purple
   __builtin_ntsc_rgb(0x00, 0x87, 0x51), //  3 dark green
   __builtin_ntsc_rgb(0xab, 0x52, 0x36), //  4 brown
   __builtin_ntsc_rgb(0x5f, 0x57, 0x4f), //  5 dark gray
   __builtin_ntsc_rgb(0xc2, 0xc3, 0xc7), //  6 light gray
   __builtin_ntsc_rgb(0xff, 0xf1, 0xe8), //  7 white
   __builtin_ntsc_rgb(0xff, 0x00, 0x4d), //  8 red
   __builtin_ntsc_rgb(0xff, 0xa3, 0x00), //  9 orange
   __builtin_ntsc_rgb(0xff, 0xec, 0x27), // 10 yellow
   __builtin_ntsc_rgb(0x00, 0xe4, 0x36), // 11 green
   __builtin_ntsc_rgb(0x29, 0xad, 0xff), // 12 blue
   __builtin_ntsc_rgb(0x83, 0x76, 0x9c), // 13 lavender
   __builtin_ntsc_rgb(0xff, 0x77, 0xa8), // 14 pink
   __builtin_ntsc_rgb(0xff, 0xcc, 0xaa)  // 15 peach
};

uint8_t game_player0_colors[8];
uint8_t game_player1_colors[8];

alias VCS_PLAYER_COLOR_192_MUTABLE_COLORS 1
instantiate "renderers/player_color_192/player_color_192.c26" as game

// Exact one-bit silhouettes extracted from source PICO-8 sprites 1 through 120.
// Source color 0 is transparent; every other source color becomes a set Atari bit.
// A parallel packed table below retains one source-derived color per sprite row.
// The source contains 29 four-frame animations and one three-frame animation.
// Source sprite 16 remains blank in the table; set 03 uses its own modulo-3
// playback counter and therefore selects only sprites 13, 14, and 15. Each
// 32-byte source set begins on a 32-byte boundary inside one of four hard pages.
page align(256) const uint8_t sprite_frames_0[256] := {
