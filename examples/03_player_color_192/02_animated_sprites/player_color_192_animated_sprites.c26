alias SPRITE_COUNT 8
alias FRAME_HOLD 8
alias PAIR_LOOPS 4

uint8_t sprite0 := 0;
uint8_t sprite1 := 1;
uint8_t animation_frame := 0;
uint8_t animation_clock := 0;
uint8_t animation_loop := 0;
uint8_t select_ready := 1;
uint8_t pause_animation := 0;
uint8_t fire_ready := 1;

inline void install_frames(void) {
   // All frames share one aligned page, so only the low pointer byte changes.
   asm lda.z sprite0;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta.z game_player0_graphics;
   asm lda.z animation_frame;
   asm asl;
   asm asl;
   asm asl;
   asm ora.z game_player0_graphics;
   asm clc;
   asm adc #<sprite_frames;
   asm sta.z game_player0_graphics;
   asm lda #>sprite_frames;
   asm sta.z game_player0_graphics + 1;

   asm lda.z sprite1;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta.z game_player1_graphics;
   asm lda.z animation_frame;
   asm asl;
   asm asl;
   asm asl;
   asm ora.z game_player1_graphics;
   asm clc;
   asm adc #<sprite_frames;
   asm sta.z game_player1_graphics;
   asm lda #>sprite_frames;
   asm sta.z game_player1_graphics + 1;
}

inline void next_pair(void) {
   sprite0 += 2;
   if (sprite0 >= SPRITE_COUNT) { sprite0 := 0; }
   sprite1 := sprite0 + 1;
   animation_frame := 0;
   animation_clock := 0;
   animation_loop := 0;
   install_frames();
}

inline void update_animation(void) {
   if (!pause_animation) {
      animation_clock++;
      if (animation_clock >= FRAME_HOLD) {
         animation_clock := 0;
         animation_frame++;
         if (animation_frame >= 4) {
            animation_frame := 0;
            animation_loop++;
            if (animation_loop >= PAIR_LOOPS) {
               next_pair();
            }
            else {
               install_frames();
            }
         }
         else {
            install_frames();
         }
      }
   }
}

inline void update_controls(void) {
   if (!(SWCHB & 0x01)) { asm jmp ($fffc); }

   if (SWCHB & 0x02) {
      select_ready := 1;
   }
   else {
      if (select_ready) {
         next_pair();
         select_ready := 0;
      }
   }

   if (INPT4 & 0x80) {
      fire_ready := 1;
   }
   else {
      if (fire_ready) {
         pause_animation := !pause_animation;
         fire_ready := 0;
      }
   }
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_MEDIUM_PURPLE;
   CTRLPF := 0x21;

   game_PLAYER0_X := 48;
   game_PLAYER1_X := 104;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_BALL_X := 80;

   game_player0_y := 55;
   game_player1_y := 54;
   game_ball_y := 94;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 0;
   game_playfield_position := 8;

   install_frames();
   game_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_controls();
      update_animation();
      vcs_ntsc_end_overscan();
   }
}
