alias SPRITE_COUNT 30
alias FRAME_HOLD 8
alias THREE_FRAME_SET 3
alias LEFT_EDGE 16
alias RIGHT_EDGE 140

uint8_t sprite0 := 0;
uint8_t sprite1 := 1;
uint8_t animation_frame := 0;
uint8_t animation_clock := 0;
uint8_t select_ready := 1;
uint8_t pause_animation := 0;
uint8_t fire_ready := 1;

// Packed phase transition: low bits advance modulo 4 while bits 2..3
// independently advance modulo 3 for source set 03.
const uint8_t animation_phase_next[16] := {
   0x05, 0x06, 0x07, 0x04,
   0x09, 0x0a, 0x0b, 0x08,
   0x01, 0x02, 0x03, 0x00,
   0x05, 0x06, 0x07, 0x04
};

void install_frames(void) {
   // The packed row-color tables use sixteen bytes per animation set: four
   // bytes per frame, with two source palette indices in each byte. Reuse the
   // renderer graphics pointers as temporary color-data pointers so this keeps
   // the existing zero-RAM-overhead selection contract.

   asm lda.z sprite0;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta.z game_player0_graphics;
   asm lda.z animation_frame;
   asm and #$03;
   asm asl;
   asm asl;
   asm ora.z game_player0_graphics;
   asm sta.z game_player0_graphics;
   asm lda.z sprite0;
   asm cmp #16;
   asm bcc @p0_color_page0;
   asm lda #>sprite_row_colors_1;
   asm jmp @p0_color_page_done;
   asm @p0_color_page0:;
   asm lda #>sprite_row_colors_0;
   asm @p0_color_page_done:;
   asm sta.z game_player0_graphics + 1;

   asm ldx #0;
   asm @p0_expand_colors:;
   asm txa;
   asm lsr;
   asm tay;
   asm lda.iy (game_player0_graphics),y;
   asm and #$0f;
   asm tay;
   asm lda.ay pico8_tia_palette,y;
   asm sta.ax game_player0_colors,x;
   asm inx;
   asm txa;
   asm lsr;
   asm tay;
   asm lda.iy (game_player0_graphics),y;
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay pico8_tia_palette,y;
   asm sta.ax game_player0_colors,x;
   asm inx;
   asm cpx #8;
   asm bne @p0_expand_colors;

   // The graphics low byte is exactly twice the packed-color low byte.
   asm lda.z game_player0_graphics;
   asm asl;
   asm sta.z game_player0_graphics;
   asm lda.z sprite0;
   asm cmp #8;
   asm bcc @p0_page0;
   asm cmp #16;
   asm bcc @p0_page1;
   asm cmp #24;
   asm bcc @p0_page2;
   asm lda #>sprite_frames_3;
   asm jmp @p0_page_done;
   asm @p0_page0:;
   asm lda #>sprite_frames_0;
   asm jmp @p0_page_done;
   asm @p0_page1:;
   asm lda #>sprite_frames_1;
   asm jmp @p0_page_done;
   asm @p0_page2:;
   asm lda #>sprite_frames_2;
   asm @p0_page_done:;
   asm sta.z game_player0_graphics + 1;

   asm lda.z sprite1;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta.z game_player1_graphics;
   asm lda.z sprite1;
   asm cmp #3;
   asm bne @p1_color_four_frame;
   // Bits 2..3 are set 03's independent modulo-3 counter.
   asm lda.z animation_frame;
   asm lsr;
   asm lsr;
   asm jmp @p1_color_frame_ready;
   asm @p1_color_four_frame:;
   asm lda.z animation_frame;
   asm and #$03;
   asm @p1_color_frame_ready:;
   asm asl;
   asm asl;
   asm ora.z game_player1_graphics;
   asm sta.z game_player1_graphics;
   asm lda.z sprite1;
   asm cmp #16;
   asm bcc @p1_color_page0;
   asm lda #>sprite_row_colors_1;
   asm jmp @p1_color_page_done;
   asm @p1_color_page0:;
   asm lda #>sprite_row_colors_0;
   asm @p1_color_page_done:;
   asm sta.z game_player1_graphics + 1;

   asm ldx #0;
   asm @p1_expand_colors:;
   asm txa;
   asm lsr;
   asm tay;
   asm lda.iy (game_player1_graphics),y;
   asm and #$0f;
   asm tay;
   asm lda.ay pico8_tia_palette,y;
   asm sta.ax game_player1_colors,x;
   asm inx;
   asm txa;
   asm lsr;
   asm tay;
   asm lda.iy (game_player1_graphics),y;
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay pico8_tia_palette,y;
   asm sta.ax game_player1_colors,x;
   asm inx;
   asm cpx #8;
   asm bne @p1_expand_colors;

   asm lda.z game_player1_graphics;
   asm asl;
   asm sta.z game_player1_graphics;
   asm lda.z sprite1;
   asm cmp #8;
   asm bcc @p1_page0;
   asm cmp #16;
   asm bcc @p1_page1;
   asm cmp #24;
   asm bcc @p1_page2;
   asm lda #>sprite_frames_3;
   asm jmp @p1_page_done;
   asm @p1_page0:;
   asm lda #>sprite_frames_0;
   asm jmp @p1_page_done;
   asm @p1_page1:;
   asm lda #>sprite_frames_1;
   asm jmp @p1_page_done;
   asm @p1_page2:;
   asm lda #>sprite_frames_2;
   asm @p1_page_done:;
   asm sta.z game_player1_graphics + 1;
}

inline void next_pair(void) {
   sprite0 += 2;
   if (sprite0 >= SPRITE_COUNT) { sprite0 := 0; }
   sprite1 := sprite0 + 1;
   game_PLAYER0_X := LEFT_EDGE;
   game_PLAYER1_X := LEFT_EDGE;
   animation_frame := 0;
   animation_clock := 0;
   install_frames();
}

inline void update_animation(void) {
   if (!pause_animation) {
      if (game_PLAYER0_X >= RIGHT_EDGE) {
         next_pair();
      }
      else {
         game_PLAYER0_X++;
         game_PLAYER1_X++;
         animation_clock++;
         if (animation_clock >= FRAME_HOLD) {
            animation_clock := 0;
            // Advance the packed modulo-4/modulo-3 phases together.
            asm ldx.z animation_frame;
            asm lda.ax animation_phase_next,x;
            asm sta.z animation_frame;
            install_frames();
         }
      }
   }
}

inline void update_controls(void) {
   // Keep the console Reset path scratch-free; the renderer's hidden
   // assembly helper stack now consumes the bytes previously borrowed here.
   asm lda SWCHB;
   asm and #$01;
   asm bne @reset_not_pressed;
   asm jmp ($fffc);
   asm @reset_not_pressed:;

   if (SWCHB & 0x02) {
      select_ready := 1;
   }
   else {
      if (select_ready) {
         next_pair();
         select_ready := 0;
      }
   }

   if (INPT4 & 0x80) {
      fire_ready := 1;
   }
   else {
      if (fire_ready) {
         pause_animation := !pause_animation;
         fire_ready := 0;
      }
   }
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_MEDIUM_PURPLE;
   CTRLPF := 0x21;

   game_PLAYER0_X := LEFT_EDGE;
   game_PLAYER1_X := LEFT_EDGE;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_BALL_X := 80;

   game_player0_y := 55;
   game_player1_y := 44;
   game_ball_y := 94;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 0;
   game_playfield_position := 8;

   install_frames();
   game_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_animation();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
