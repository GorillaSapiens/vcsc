include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"

page const uint8_t game_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bX......._...X...._.......X_........),
   VCS_PLAYFIELD_ROW(0b.X......_....X..._........_X.......),
   VCS_PLAYFIELD_ROW(0b..X....._.....X.._........_.X......),
   VCS_PLAYFIELD_ROW(0b...X...._......X._........_..X.....),
   VCS_PLAYFIELD_ROW(0b....X..._.......X_........_...X....),
   VCS_PLAYFIELD_ROW(0b.....X.._........_X......._....X...),
   VCS_PLAYFIELD_ROW(0b......X._........_.X......_.....X..),
   VCS_PLAYFIELD_ROW(0b.......X_........_..X....._......X.),
   VCS_PLAYFIELD_ROW(0b........_X......._...X...._.......X),
   VCS_PLAYFIELD_ROW(0b........_.X......_....X..._......X.),
   VCS_PLAYFIELD_ROW(0b........_..X....._.....X.._.....X..),
   VCS_PLAYFIELD_ROW(0b........_...X...._......X._....X...)
};

// Stored in the renderer's highest-index-to-zero display order.
page const uint8_t game_player0_colors[8] := {
   VCS_NTSC_SKY_BLUE,
   VCS_NTSC_SKY_BLUE_2,
   VCS_NTSC_ROYAL_BLUE,
   VCS_NTSC_MEDIUM_PURPLE,
   VCS_NTSC_VIOLET,
   VCS_NTSC_ORCHID,
   VCS_NTSC_LIGHT_CORAL,
   VCS_NTSC_SANDY_BROWN
};

page const uint8_t game_player1_colors[8] := {
   VCS_NTSC_ORCHID,
   VCS_NTSC_VIOLET,
   VCS_NTSC_MEDIUM_PURPLE,
   VCS_NTSC_ROYAL_BLUE,
   VCS_NTSC_SKY_BLUE_2,
   VCS_NTSC_SKY_BLUE,
   VCS_NTSC_AQUAMARINE,
   VCS_NTSC_PALE_GREEN
};

template "renderers/player_color_192/player_color_192.c26" as game

page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(
      0b.XXXXXX.,
      0bXX....XX,
      0bXX.X..XX,
      0bXX..X.XX,
      0bXX...XXX,
      0bXX....XX,
      0bXX....XX,
      0b.XXXXXX.
   )
};

page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(
      0bXXXXXXX.,
      0bXX....XX,
      0bXX....XX,
      0bXXXXXXX.,
      0bXX....XX,
      0bXX....XX,
      0bXX....XX,
      0bXXXXXXX.
   )
};

alias OBJECT_MAX_Y 95
alias SELECTED_PLAYER0 0
alias SELECTED_PLAYER1 1
alias SELECTED_BALL    2
alias SELECTED_OBJECT_COUNT 3

uint8_t selected_object := SELECTED_PLAYER0;
uint8_t select_switch_ready := 1;

inline void update_object_selection(void) {
   if (SWCHB & 0x02) {
      select_switch_ready := 1;
   }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object >= SELECTED_OBJECT_COUNT) {
            selected_object := SELECTED_PLAYER0;
         }
         select_switch_ready := 0;
      }
   }
}

inline void move_selected_object(void) {
   if (!(SWCHA & 0x40)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:
            if (game_PLAYER0_X > 0) { game_PLAYER0_X--; }
            break;
         case SELECTED_PLAYER1:
            if (game_PLAYER1_X > 0) { game_PLAYER1_X--; }
            break;
         default:
            if (game_BALL_X > 0) { game_BALL_X--; }
      }
   }
   else {
      if (!(SWCHA & 0x80)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:
               if (game_PLAYER0_X < 159) { game_PLAYER0_X++; }
               break;
            case SELECTED_PLAYER1:
               if (game_PLAYER1_X < 159) { game_PLAYER1_X++; }
               break;
            default:
               if (game_BALL_X < 159) { game_BALL_X++; }
         }
      }
   }

   if (!(SWCHA & 0x10)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:
            if (game_player0_y > 0) { game_player0_y--; }
            break;
         case SELECTED_PLAYER1:
            if (game_player1_y > 0) { game_player1_y--; }
            break;
         default:
            if (game_ball_y > 0) { game_ball_y--; }
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:
               if (game_player0_y < OBJECT_MAX_Y) { game_player0_y++; }
               break;
            case SELECTED_PLAYER1:
               if (game_player1_y < OBJECT_MAX_Y) { game_player1_y++; }
               break;
            default:
               if (game_ball_y < OBJECT_MAX_Y) { game_ball_y++; }
         }
      }
   }
}

inline void update_controls(void) {
   if (!(SWCHB & 0x01)) {
      asm jmp ($fffc);
   }
   update_object_selection();
   move_selected_object();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUBK := VCS_NTSC_MEDIUM_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;

   game_PLAYER0_X := 44;
   game_PLAYER1_X := 108;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_BALL_X := 78;

   game_player0_y := 70;
   game_player1_y := 42;
   game_ball_y := 45;

   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;

   game_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
