alias VIDEO_BACKGROUND_COLOR __builtin_secam_rgb(0x24, 0x28, 0xb0)
alias VIDEO_PLAYFIELD_COLOR  __builtin_secam_rgb(0xea, 0xc2, 0x54)
alias VIDEO_PLAYER0_COLOR    __builtin_secam_rgb(0xf0, 0xf0, 0xf0)
alias VIDEO_PLAYER1_COLOR    __builtin_secam_rgb(0xea, 0x82, 0xdc)
