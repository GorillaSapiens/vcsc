instantiate "renderers/enhanced_multisprite_asymmetric/enhanced_multisprite.c26" as game (lines:=228)
include "../../multisprite_228_interactive_common.c26"

// Native 228-line asymmetric playfield: 114 two-scanline logical bands.
// PF1/PF2 halves are stored as two contiguous 114-byte planes.
// PF0 uses independent 114-byte left/right tables. Each indexed half stays
// page-contained so the visible loads keep a constant cycle count.
