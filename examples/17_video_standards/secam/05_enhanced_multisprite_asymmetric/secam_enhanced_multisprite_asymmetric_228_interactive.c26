void initialize_228_scene(void) {
   initialize_multisprite_scene();
   CTRLPF := 0;
   game_PLAYER0_Y := 106;
   game_PLAYER1_Y := 90;
   game_PLAYER2_Y := 70;
   game_PLAYER3_Y := 50;
   game_PLAYER4_Y := 30;
   game_PLAYER5_Y := 10;
}


bank1 void render_visible_frame(void) {
   // Switch into the renderer bank while VBLANK is still asserted.  A direct
   // bank0->game_draw call after end_vblank() costs enough F8 trampoline cycles
   // to miss the first visible scanline and turn a 228-line component into 229.
   game_vblank();
   vcs_secam_end_vblank();
   game_draw();
   vcs_secam_component_to_overscan_handoff();
   vcs_secam_begin_overscan();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   initialize_228_scene();
   while (1) {
      vcs_secam_vsync();
      vcs_secam_begin_vblank();
      render_visible_frame();
      game_overscan();
      if (!(SWCHB & 0x01)) { initialize_228_scene(); }
      else { update_multisprite_controls(); }
      vcs_secam_end_overscan();
   }
}
