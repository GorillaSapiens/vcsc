// Centered six-digit score display adapted from the batari Basic standard
// score mini-kernel. The game-side value and frame cadence are ordinary VCSC;
// the cycle-counted TIA display remains inline 6502 assembly.

include "vcs.vcsc"

bcd24_t score := 123456;
uint8_t frame_counter := 0;

// Six complete glyph pointers in the order consumed by the batari-derived
// display pipeline: digits 1, 3, 5, 2, 4, and 6.
uint8_t score_pointers[12];
uint8_t saved_stack_pointer;

void prepare_score_pointers(void) {
   asm .import score_font;

   // Each pair below builds two complete pointers, including carry into the
   // font address high byte. Fonts therefore need no linker-time page alignment.

   // Digits 1 and 2 from the most-significant packed-BCD byte.
   asm lda score+2;
   asm tax;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+7;
   asm txa;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+1;

   // Digits 3 and 4.
   asm lda score+1;
   asm tax;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+9;
   asm txa;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+3;

   // Digits 5 and 6 from the least-significant packed-BCD byte.
   asm lda score;
   asm tax;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+11;
   asm txa;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+5;
}

void draw_score(void) {
   // The score kernel temporarily uses S as an extra graphics register. Save
   // and restore it without any call or push while it is repurposed.
   asm sta HMCLR;
   asm tsx;
   asm stx saved_stack_pointer;
   asm ldx #$e0;
   asm stx HMP0;
   asm lda #$0e;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta WSYNC;

   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;

   // Twenty-seven cycles preserve the original batari positioning phase now
   // that all six complete pointers were prepared during overscan.
   asm bit score;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm ldy #7;
   asm sty VDELP0;
   asm sta RESP0;
   asm sta RESP1;
   asm lda #$03;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm sta VDELP1;
   asm lda #$f0;
   asm sta HMP1;
   asm lda (score_pointers),y;
   asm sta GRP0;
   asm sta HMOVE;
   asm jmp @score_begin;

   // The prefix below is seven cycles. Together with @score_begin it forms
   // the original 76-cycle batari Basic score-row pipeline.
   asm @score_loop:;
   asm lda (score_pointers),y;
   asm sta GRP0;
   asm bit score;
   asm nop;
   asm nop;

   asm @score_begin:;
   asm lda (score_pointers+$8),y;
   asm sta GRP1;
   asm lda (score_pointers+$6),y;
   asm sta GRP0;
   asm lax (score_pointers+$2),y;
   asm txs;
   asm lax (score_pointers+$4),y;
   asm bit score;
   asm bit score;
   asm bit score;
   asm lda (score_pointers+$a),y;
   asm stx GRP1;
   asm tsx;
   asm stx GRP0;
   asm sta GRP1;
   asm sty GRP0;
   asm dey;
   asm bpl @score_loop;

   asm ldx saved_stack_pointer;
   asm txs;
   asm lda #0;
   asm sta PF1;
   asm sta GRP0;
   asm sta GRP1;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta NUSIZ0;
   asm sta NUSIZ1;

   // Finish the cleanup/support scanline. The visible block is ten lines:
   // one positioning line, eight glyph lines, and one cleanup line.
   asm sta WSYNC;
}

void main(void) {
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := 0x84;

   prepare_score_pointers();

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   asm @frame:;
   asm lda #2;
   asm sta VSYNC;
   asm ldx #3;
   asm @vsync:;
   asm sta WSYNC;
   asm dex;
   asm bne @vsync;

   asm lda #0;
   asm sta VSYNC;
   asm lda #2;
   asm sta VBLANK;
   asm lda #0;
   asm ldx #37;
   asm @vblank:;
   asm sta WSYNC;
   asm dex;
   asm bne @vblank;

   asm lda #0;
   asm sta VBLANK;

   // Ninety explicit lines plus draw_score()'s leading WSYNC make 91 blank
   // lines above the score. Its positioning, glyph, and cleanup lines consume
   // ten more, followed by 91 blank lines: 91 + 10 + 91 = 192.
   asm ldx #90;
   asm @top_blank:;
   asm sta WSYNC;
   asm dex;
   asm bne @top_blank;

   draw_score();

   asm lda #0;
   asm ldx #91;
   asm @bottom_blank:;
   asm sta WSYNC;
   asm dex;
   asm bne @bottom_blank;

   asm lda #2;
   asm sta VBLANK;

   // Keep the frame length fixed while ordinary VCSC logic updates the score.
   // Twenty NTSC frames is one third of a second.
   asm lda #35;
   asm sta TIM64T;
   frame_counter++;
   if (frame_counter == 20) {
      frame_counter := 0;
      score++;
      prepare_score_pointers();
   }
   asm @overscan_wait:;
   asm lda INTIM;
   asm bne @overscan_wait;
   asm sta WSYNC;
   asm sta WSYNC;
   asm jmp @frame;
}
