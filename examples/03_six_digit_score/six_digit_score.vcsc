// Centered six-digit score display adapted from a legacy standard score
// mini-kernel. VCSC owns the score, font, frame structure, scanline waits,
// update cadence, and ordinary TIA setup. Inline assembly is confined to
// compact glyph-pointer construction and the cycle-counted visible kernel.

include "vcs.vcsc"
include "fonts/default_decimal.vcsc"

alias BACKGROUND_COLOR 0x84
alias SCORE_PERIOD     20

bcd24_t score := 123456;
uint8_t frame_counter := 0;
include "six_glyph_display.vcsc"

void prepare_six_glyph_pointers(void) {
   // Build six complete 16-bit pointers in human digit order. Packed BCD is
   // little-endian, so score+2 supplies digits 1/2 and score supplies 5/6.
   asm lda score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta six_glyph_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta six_glyph_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta six_glyph_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta six_glyph_pointers+3;

   asm lda score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta six_glyph_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta six_glyph_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta six_glyph_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta six_glyph_pointers+7;

   asm lda score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta six_glyph_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta six_glyph_pointers+9;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta six_glyph_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta six_glyph_pointers+11;
}

void wait_scanlines(uint8_t lines) {
   while (lines) {
      WSYNC := 0;
      lines--;
   }
}


void main(void) {
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := BACKGROUND_COLOR;
   VBLANK := 2;

   six_glyph_setup();
   prepare_six_glyph_pointers();

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   while (1) {
      VSYNC := 2;
      wait_scanlines(3);
      VSYNC := 0;

      VBLANK := 2;
      wait_scanlines(37);
      VBLANK := 0;

      wait_scanlines(89);
      six_glyph_draw();
      wait_scanlines(89);

      VBLANK := 2;
      TIM64T := 35;

      frame_counter++;
      if (frame_counter == SCORE_PERIOD) {
         frame_counter := 0;
         score++;
         prepare_six_glyph_pointers();
      }

      while (INTIM) {
      }
      WSYNC := 0;
      WSYNC := 0;
   }
}
