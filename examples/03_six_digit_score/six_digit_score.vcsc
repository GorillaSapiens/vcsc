// Centered six-digit score display adapted from a legacy standard score
// mini-kernel. VCSC owns the score, font, frame structure, scanline
// waits, update cadence, and ordinary TIA setup. Inline assembly is confined
// to compact glyph-pointer construction and the cycle-counted visible kernel.

include "vcs.vcsc"
include "fonts/clean.vcsc"

alias BACKGROUND_COLOR 0x84
alias SCORE_COLOR      0x0e
alias SCORE_PERIOD     20

bcd24_t score := 123456;
uint8_t frame_counter := 0;
uint8_t score_pointers[12];
uint8_t delayed_glyph;

// Build six complete 16-bit glyph pointers. The delayed-player kernel displays
// pointer slots in order 0, 4, 3, 2, 1, 5, so the packed BCD digits must be
// placed in that non-obvious order. Doing this address arithmetic in assembly
// is dramatically smaller than six generic dynamic 16-bit array lookups.
void prepare_score_pointers(void) {
   // score+2 contains digits 1 and 2.
   asm lda score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+9;

   // score+1 contains digits 3 and 4.
   asm lda score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+7;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+5;

   // score contains digits 5 and 6.
   asm lda score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+3;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+11;
}

void wait_scanlines(uint8_t lines) {
   while (lines) {
      WSYNC := 0;
      lines--;
   }
}

void draw_score(void) {
   // Ordinary setup remains VCSC. The row pipeline below uses only official
   // 6502 instructions and one ordinary zero-page delayed-glyph byte.
   HMCLR := 0;
   HMP0 := 0xe0;
   COLUP0 := SCORE_COLOR;
   COLUP1 := SCORE_COLOR;
   WSYNC := 0;

   // From here through the end of the row loop, every cycle is deliberate.
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;

   // Twenty-seven cycles preserve the original positioning phase.
   asm bit score;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm ldy #7;
   asm sty VDELP0;
   asm sta RESP0;
   asm sta RESP1;
   asm lda #$03;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm sta VDELP1;
   asm lda #$f0;
   asm sta HMP1;
   asm lda (score_pointers),y;
   asm sta GRP0;
   asm sta HMOVE;
   asm jmp @score_begin;

   // The prefix is seven cycles. Together with @score_begin it forms the
   // original 76-cycle score-row pipeline.
   asm @score_loop:;
   asm lda (score_pointers),y;
   asm sta GRP0;
   asm bit score;
   asm nop;
   asm nop;

   asm @score_begin:;
   asm lda (score_pointers+$8),y;
   asm sta GRP1;
   asm lda (score_pointers+$6),y;
   asm sta GRP0;
   asm lda (score_pointers+$2),y;
   asm sta delayed_glyph;
   asm lda (score_pointers+$4),y;
   asm tax;
   asm bit score;
   asm nop;
   asm lda (score_pointers+$a),y;
   asm stx GRP1;
   asm ldx delayed_glyph;
   asm stx GRP0;
   asm sta GRP1;
   asm sty GRP0;
   asm dey;
   asm bpl @score_loop;

   // Cleanup is no longer timing-critical, so return to ordinary VCSC.
   PF1 := 0;
   GRP0 := 0;
   GRP1 := 0;
   VDELP0 := 0;
   VDELP1 := 0;
   NUSIZ0 := 0;
   NUSIZ1 := 0;
   WSYNC := 0;
}

void main(void) {
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := BACKGROUND_COLOR;

   prepare_score_pointers();

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   while (1) {
      VSYNC := 2;
      wait_scanlines(3);
      VSYNC := 0;

      VBLANK := 2;
      wait_scanlines(37);
      VBLANK := 0;

      // The ordinary VCSC call/loop overhead consumes three additional scanlines.
      // These waits keep the ten-line score block centered in 192 visible lines.
      wait_scanlines(89);
      draw_score();
      wait_scanlines(89);

      VBLANK := 2;
      TIM64T := 35;

      frame_counter++;
      if (frame_counter == SCORE_PERIOD) {
         frame_counter := 0;
         score++;
         prepare_score_pointers();
      }

      while (INTIM) {
      }
      WSYNC := 0;
      WSYNC := 0;
   }
}
