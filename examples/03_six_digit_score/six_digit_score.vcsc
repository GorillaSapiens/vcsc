// Centered six-digit score display adapted from a legacy standard score
// mini-kernel. VCSC owns the score, font, frame structure, scanline waits,
// update cadence, and ordinary TIA setup. Inline assembly is confined to
// compact glyph-pointer construction and the cycle-counted visible kernel.

include "vcs.vcsc"
include "fonts/default_decimal.vcsc"

alias BACKGROUND_COLOR 0x84
alias SCORE_COLOR      0x0e
alias SCORE_PERIOD     20

bcd24_t score := 123456;
uint8_t frame_counter := 0;
uint8_t score_pointers[12];
uint8_t score_row;
uint8_t delayed_glyph;

void prepare_score_pointers(void) {
   // Build six complete 16-bit pointers in human digit order. Packed BCD is
   // little-endian, so score+2 supplies digits 1/2 and score supplies 5/6.
   asm lda score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+1;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+2;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+3;

   asm lda score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+4;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+5;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+6;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+7;

   asm lda score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+8;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+9;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #<score_font;
   asm sta score_pointers+10;
   asm lda #>score_font;
   asm adc #0;
   asm sta score_pointers+11;
}

void wait_scanlines(uint8_t lines) {
   while (lines) {
      WSYNC := 0;
      lines--;
   }
}

void setup_score_display(void) {
   // Horizontal positions persist, so do the HMOVE once during vertical blank.
   WSYNC := 0;
   asm lda #$03;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm lda #$0e;
   asm bit score;
   asm sta COLUP0;
   asm sta COLUP1;
   asm sta HMCLR;
   asm lda #$80;
   asm sta HMP0;
   asm lda #$90;
   asm sta HMP1;
   asm nop;
   asm sta RESP0;
   asm sta RESP1;
   WSYNC := 0;
   HMOVE := 0;
}

void draw_score(void) {
   COLUP0 := SCORE_COLOR;
   COLUP1 := SCORE_COLOR;
   GRP0 := 0;
   GRP1 := 0;
   VDELP0 := 1;
   VDELP1 := 1;
   score_row := 7;

   // Official-opcode six-digit score pipeline. D1 is preloaded before WSYNC;
   // the remaining writes complete at cycles 8, 16, 44, 47, 50, and 53.
   asm @score_loop:;
   asm ldy score_row;
   asm lda (score_pointers),y;
   asm sta GRP0;
   asm sta WSYNC;
   asm lda (score_pointers+$2),y;
   asm sta GRP1;
   asm lda (score_pointers+$4),y;
   asm sta GRP0;
   asm lda (score_pointers+$6),y;
   asm sta delayed_glyph;
   asm lda (score_pointers+$8),y;
   asm tax;
   asm lda (score_pointers+$a),y;
   asm tay;
   asm lda delayed_glyph;
   asm sta GRP1;
   asm stx GRP0;
   asm sty GRP1;
   asm sta GRP0;
   asm dec score_row;
   asm bpl @score_loop;

   GRP0 := 0;
   GRP1 := 0;
   VDELP0 := 0;
   VDELP1 := 0;
   WSYNC := 0;
}

void main(void) {
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := BACKGROUND_COLOR;
   VBLANK := 2;

   setup_score_display();
   prepare_score_pointers();

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   while (1) {
      VSYNC := 2;
      wait_scanlines(3);
      VSYNC := 0;

      VBLANK := 2;
      wait_scanlines(37);
      VBLANK := 0;

      wait_scanlines(89);
      draw_score();
      wait_scanlines(89);

      VBLANK := 2;
      TIM64T := 35;

      frame_counter++;
      if (frame_counter == SCORE_PERIOD) {
         frame_counter := 0;
         score++;
         prepare_score_pointers();
      }

      while (INTIM) {
      }
      WSYNC := 0;
      WSYNC := 0;
   }
}
