; Default batari Basic 8x8 decimal font, adapted from the retained CC0 source.
; Digits are stored as ten consecutive eight-byte glyphs. The score kernel
; draws each glyph from row 7 down through row 0.

; 0
.byte %00111100, %01100110, %01100110, %01100110
.byte %01100110, %01100110, %01100110, %00111100
; 1
.byte %01111110, %00011000, %00011000, %00011000
.byte %00011000, %00111000, %00011000, %00001000
; 2
.byte %01111110, %01100000, %01100000, %00111100
.byte %00000110, %00000110, %01000110, %00111100
; 3
.byte %00111100, %01000110, %00000110, %00000110
.byte %00011100, %00000110, %01000110, %00111100
; 4
.byte %00001100, %00001100, %01111110, %01001100
.byte %01001100, %00101100, %00011100, %00001100
; 5
.byte %00111100, %01000110, %00000110, %00000110
.byte %00111100, %01100000, %01100000, %01111110
; 6
.byte %00111100, %01100110, %01100110, %01100110
.byte %01111100, %01100000, %01100010, %00111100
; 7
.byte %00110000, %00110000, %00110000, %00011000
.byte %00001100, %00000110, %01000010, %00111110
; 8
.byte %00111100, %01100110, %01100110, %01100110
.byte %00111100, %01100110, %01100110, %00111100
; 9
.byte %00111100, %01000110, %00000110, %00111110
.byte %01100110, %01100110, %01100110, %00111100
