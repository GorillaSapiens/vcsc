// 6507 silicon fingerprint display.
//
// Four unstable ARR-immediate probes produce accumulator and masked NVZC
// results. VCSC feeds those eight bytes through CRC-24/OPENPGP and displays
// the resulting 24-bit fingerprint as six hexadecimal digits.

include "vcs.c26"
include "frame_ntsc.c26"
include "fonts/default_hex.c26"

alias BACKGROUND_COLOR 0x84

uint8_t probe_accumulator;
uint8_t probe_flags;
uint24_t fingerprint;

#ifndef FINGERPRINT_SELFTEST
template "six_glyph_component.c26" as display
#endif

// ARR is an unstable unofficial NMOS 6502/6507 opcode. The example enables
// named unofficial mnemonics explicitly with -Wa,--illegals; each annotated
// line also records the exact opcode and operand bytes emitted. Each probe
// stores A' and then captures NVZC from P' before any flag-changing cleanup.
void probe1(void) {
   asm cld;
   asm sec;
   asm lda #$e5;
   asm ARR #$b8; // Unstable unofficial ARR; emits bytes $6B,$B8.
   asm sta probe_accumulator;
   asm php;
   asm pla;
   asm and #$c3;
   asm sta probe_flags;
   asm cld;
}

void probe2(void) {
   asm cld;
   asm sec;
   asm lda #$36;
   asm ARR #$6b; // Unstable unofficial ARR; emits bytes $6B,$6B.
   asm sta probe_accumulator;
   asm php;
   asm pla;
   asm and #$c3;
   asm sta probe_flags;
   asm cld;
}

void probe3(void) {
   asm sed;
   asm clc;
   asm lda #$f6;
   asm ARR #$6b; // Unstable unofficial ARR; emits bytes $6B,$6B.
   asm sta probe_accumulator;
   asm php;
   asm pla;
   asm and #$c3;
   asm sta probe_flags;
   asm cld;
}

void probe4(void) {
   asm cld;
   asm clc;
   asm lda #$06;
   asm ARR #$6b; // Unstable unofficial ARR; emits bytes $6B,$6B.
   asm sta probe_accumulator;
   asm php;
   asm pla;
   asm and #$c3;
   asm sta probe_flags;
   asm cld;
}

// CRC-24/OPENPGP: poly 0x864cfb, init 0xb704ce, no reflection, xorout 0.
void crc24_feed(uint8_t value) {
   uint8_t bits := 8;

   fingerprint ^= (uint24_t)value << 16;
   while (bits) {
      if (fingerprint & 0x800000) {
         fingerprint <<= 1;
         fingerprint ^= 0x864cfb;
      }
      else {
         fingerprint <<= 1;
      }
      bits--;
   }
}

void compute_fingerprint(void) {
   fingerprint := 0xb704ce;

   probe1();
   crc24_feed(probe_accumulator);
   crc24_feed(probe_flags);

   probe2();
   crc24_feed(probe_accumulator);
   crc24_feed(probe_flags);

   probe3();
   crc24_feed(probe_accumulator);
   crc24_feed(probe_flags);

   probe4();
   crc24_feed(probe_accumulator);
   crc24_feed(probe_flags);
}

#ifndef FINGERPRINT_SELFTEST
// The display component stores packed BCD for decimal-score users.  This
// hexadecimal application deliberately copies the fingerprint bytes verbatim:
// the component pointer builder interprets the same six nibbles as hex glyphs.
inline void load_display_fingerprint(void) {
   // Satisfy the component score contract before replacing its bytes raw.
   display_score := 0;
   asm lda fingerprint;
   asm sta display_score;
   asm lda fingerprint+1;
   asm sta display_score+1;
   asm lda fingerprint+2;
   asm sta display_score+2;
}
#endif


#ifdef FINGERPRINT_SELFTEST
void main(void) {
   // Standard CRC-24/OPENPGP check vector: ASCII "123456789" -> 0x21cf02.
   fingerprint := 0xb704ce;
   crc24_feed(0x31);
   crc24_feed(0x32);
   crc24_feed(0x33);
   crc24_feed(0x34);
   crc24_feed(0x35);
   crc24_feed(0x36);
   crc24_feed(0x37);
   crc24_feed(0x38);
   crc24_feed(0x39);
   if (fingerprint != 0x21cf02) {
      asm lda #$ff;
      asm ldx #1;
      asm ldy #0;
      asm jsr $ffff;
   }
   asm lda #$ff;
   asm ldx #0;
   asm ldy #0;
   asm jsr $ffff;
}
#else
void main(void) {
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := BACKGROUND_COLOR;
   VBLANK := 2;

   compute_fingerprint();
   load_display_fingerprint();
   display_init();

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   while (1) {
      vcs_ntsc_vsync();

      vcs_ntsc_begin_vblank();
      display_vblank();
      vcs_ntsc_end_vblank();

      // Preserve the predecessor display's absolute visible-line placement.
      vcs_ntsc_wait_scanlines(91);
      display_draw();
      vcs_ntsc_wait_scanlines(90);

      vcs_ntsc_begin_overscan();
      display_overscan();
      vcs_ntsc_end_overscan();
   }
}
#endif
