    ror
    sta ram_lfsr
    bcc.same ram31_bank31_ram_entry_v_lfsr_done
    lda ram_lfsr+1
    eor #$b4
    sta ram_lfsr+1
ram31_bank31_ram_entry_v_lfsr_done:
    inc ram_index
    bne.same ram31_bank31_ram_entry_v_index_low_ok
    inc ram_index+1
ram31_bank31_ram_entry_v_index_low_ok:
    lda ram_index+1
    cmp #4
    bne.same ram31_bank31_ram_entry_v_continue
    lda #0
    sta ram_index
    sta ram_index+1
    lda #$20
    sta ram_bank
    rts
ram31_bank31_ram_entry_v_continue:
    dec step_remaining
    bne.same ram31_bank31_ram_entry_verify
    rts
ram31_bank31_ram_entry_write:
    lda torture_batch
    sta step_remaining
ram31_bank31_ram_entry_write_loop:
    lda ram_lfsr
    eor #$1F
    sta ram_value
    jsr ram_write_031
    lda ram_lfsr+1
    lsr
    sta ram_lfsr+1
    lda ram_lfsr
    ror
    sta ram_lfsr
    bcc.same ram31_bank31_ram_entry_w_lfsr_done
    lda ram_lfsr+1
    eor #$b4
    sta ram_lfsr+1
ram31_bank31_ram_entry_w_lfsr_done:
    inc ram_index
    bne.same ram31_bank31_ram_entry_w_index_low_ok
    inc ram_index+1
ram31_bank31_ram_entry_w_index_low_ok:
    lda ram_index+1
    cmp #4
    bne.same ram31_bank31_ram_entry_w_continue
    lda #0
    sta ram_index
    sta ram_index+1
    lda #$20
    sta ram_bank
    rts
ram31_bank31_ram_entry_w_continue:
    dec step_remaining
    bne.same ram31_bank31_ram_entry_write_loop
    rts

; One cross-lower-bank call per bounded RAM batch.  Each destination wrapper
; performs 4 (VBLANK) or 3 (overscan) compiler-lowered swapram byte accesses
; before returning, instead of paying this dispatch cost for every byte.
step_3ex_max_ram:
    lda #<$1780
    sta bankcall_stub+1
    lda #>$1780
    sta bankcall_stub+2
    lda ram_bank
    cmp #$ff
    beq.same ram_dispatch_255
    sta bankcall_stub+5
    lda #<$1200
    sta bankcall_stub+3
    lda #>$1200
    sta bankcall_stub+4
    jsr bankcall_stub
    rts
ram_dispatch_255:
    lda #$fa
    sta bankcall_stub+5
    lda #<$1300
    sta bankcall_stub+3
    lda #>$1300
    sta bankcall_stub+4
    jsr bankcall_stub
    rts

ram_walk_reset:
    lda #0
    sta ram_bank
    sta ram_index
    sta ram_index+1
    sta ram_failure_bank
    lda #$e1
    sta ram_lfsr
    lda #$ac
    sta ram_lfsr+1
    rts

