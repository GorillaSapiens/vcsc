   VCS_STANDARD_SPRITE_GLYPH(
      0b.XXXXXX.,
      0bXX....XX,
      0bXX....XX,
      0bXX.XX.XX,
      0bXX.XX.XX,
      0bXX....XX,
      0bXX....XX,
      0b.XXXXXX.
   )
};

#ifdef SUPERCHIP_TEST
cartram uint8_t banked_hook_count;
cartram uint8_t banked_hook_signature := 0x5a;
cartram uint8_t banked_hook_epoch;
#else
uint8_t banked_hook_count;
uint8_t banked_hook_signature := 0x5a;
uint8_t banked_hook_epoch;
#endif
uint8_t banked_hook_failure;

#ifndef BANKED_STATIC_TEST
uint8_t selected_object;
uint8_t select_switch_ready := 1;
uint8_t selected_score_digit;
uint8_t right_joystick_ready := 0x0f;

#ifdef UNBANKED_REFERENCE
page const bcd24_t score_digit_weight[6] := {1,10,100,1000,10000,100000};
#else
// Only gameplay reads this table; it belongs beside the controls in bank1.
bank1 page const bcd24_t score_digit_weight[6] := {1,10,100,1000,10000,100000};
#endif

inline void update_banked_controls(void) {
   if (!(SWCHB & 0x01)) { hard_reset(); }
   if (SWCHB & 0x02) { select_switch_ready := 1; }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object == 5) { selected_object := 0; }
         select_switch_ready := 0;
      }
   }
   if (!(SWCHA & 0x40)) {
      if (vcs_standard_object_x[selected_object] > 0) { vcs_standard_object_x[selected_object]--; }
   }
   else {
      if (!(SWCHA & 0x80)) {
         if (vcs_standard_object_x[selected_object] < 159) { vcs_standard_object_x[selected_object]++; }
      }
   }
   if (!(SWCHA & 0x10)) {
      switch (selected_object) {
         case 0: if (vcs_standard_player0_y > 0) { vcs_standard_player0_y--; } break;
         case 1: if (vcs_standard_player1_y > 0) { vcs_standard_player1_y--; } break;
         case 2: if (vcs_standard_missile0_y > 0) { vcs_standard_missile0_y--; } break;
         case 3: if (vcs_standard_missile1_y > 0) { vcs_standard_missile1_y--; } break;
         case 4: if (vcs_standard_ball_y > 0) { vcs_standard_ball_y--; } break;
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         switch (selected_object) {
            case 0: if (vcs_standard_player0_y < 87) { vcs_standard_player0_y++; } break;
            case 1: if (vcs_standard_player1_y < 87) { vcs_standard_player1_y++; } break;
            case 2: if (vcs_standard_missile0_y < 87) { vcs_standard_missile0_y++; } break;
            case 3: if (vcs_standard_missile1_y < 87) { vcs_standard_missile1_y++; } break;
            case 4: if (vcs_standard_ball_y < 87) { vcs_standard_ball_y++; } break;
         }
      }
   }
   // The right joystick selects ones..hundred-thousands with left/right and
   // edits the selected weight with up/down. Full neutral re-arms each press.
   if (right_joystick_ready) {
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         if (!(right_joystick_ready & 0x04)) {
            selected_score_digit++;
            if (selected_score_digit == 6) { selected_score_digit := 0; }
            vcs_standard_score_color += 0x10;
         }
         else {
            if (!(right_joystick_ready & 0x08)) {
               if (selected_score_digit == 0) { selected_score_digit := 5; }
               else { selected_score_digit--; }
               vcs_standard_score_color += 0x10;
            }
         }
         if (!(right_joystick_ready & 0x01)) { vcs_standard_score += score_digit_weight[selected_score_digit]; }
         else {
            if (!(right_joystick_ready & 0x02)) { vcs_standard_score -= score_digit_weight[selected_score_digit]; }
         }
         right_joystick_ready := 0;
      }
   }
   else {
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) { right_joystick_ready := 0; }
   }
}
#endif

#ifdef UNBANKED_REFERENCE
void banked_game_logic(void) {
#else
bank1 void banked_game_logic(void) {
#endif
   if (banked_hook_signature != 0x5a) {
      banked_hook_failure := 1;
   }
#ifdef BANKED_STATIC_TEST
   if (banked_hook_count == 0) {
      VCS_STANDARD_BALL_X := 104;
      vcs_standard_score := 654321;
      banked_hook_epoch := 1;
   }
#else
   update_banked_controls();
   banked_hook_epoch := 1;
#endif
   banked_hook_count++;
}

#ifdef UNBANKED_REFERENCE
void vcs_standard_overscan_hook(void) {
#else
bank1 void vcs_standard_overscan_hook(void) {
#endif
   banked_game_logic();
}

#ifdef UNBANKED_REFERENCE
void initialize_banked_scene(void) {
#else
bank0 void initialize_banked_scene(void) {
#endif
   COLUBK := 0x84;

   VCS_STANDARD_PLAYER0_X := 24;
   VCS_STANDARD_PLAYER1_X := 132;
   VCS_STANDARD_MISSILE0_X := 54;
   VCS_STANDARD_MISSILE1_X := 112;
   VCS_STANDARD_BALL_X := 80;

   vcs_standard_player0_y := 18;
   vcs_standard_missile0_y := 34;
   vcs_standard_ball_y := 48;
   vcs_standard_missile1_y := 62;
   vcs_standard_player1_y := 78;

   vcs_standard_player0_graphics := player0_graphics;
   vcs_standard_player1_graphics := player1_graphics;
   vcs_standard_player0_height := 7;
   vcs_standard_player1_height := 7;
   vcs_standard_missile0_height := 5;
   vcs_standard_missile1_height := 7;
   vcs_standard_ball_height := 3;

   vcs_standard_score := 123456;
   vcs_standard_score_color := 0x0e;
   vcs_standard_playfield_position := 8;

   VBLANK := 2;
   TIM64T := 0;
}

#ifdef UNBANKED_REFERENCE
void configure_banked_frame(void) {
#else
bank0 void configure_banked_frame(void) {
#endif
   if (banked_hook_failure) {
      COLUBK := 0x20;
   }
   else {
      COLUBK := 0x84;
   }
   COLUPF := 0x2e;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;
   NUSIZ0 := 0x20;
   NUSIZ1 := 0x20;
   // RESMP power-on state is unspecified; the renderer needs independent missiles.
   RESMP0 := 0;
   RESMP1 := 0;
}

#ifdef UNBANKED_REFERENCE
void main(void) {
#else
bank0 void main(void) {
#endif
   initialize_banked_scene();
   while (1) {
      configure_banked_frame();
      vcs_standard_renderer_drawscreen();
   }
}
