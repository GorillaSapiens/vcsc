// Unified all-five component composed with generic C26 cartridge topology.
// The public example is F8. Tests build this same source as 4K, F6, F4, and F8SC.

#ifdef UNBANKED_REFERENCE
include "4K/mapper.c26"
#else
#ifdef SUPERCHIP_TEST
#if MAPPER_BANKS == 2
include "F8SC/mapper.c26"
#elif MAPPER_BANKS == 4
include "F6SC/mapper.c26"
#elif MAPPER_BANKS == 8
include "F4SC/mapper.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#else
#if MAPPER_BANKS == 2
include "F8/mapper.c26"
#elif MAPPER_BANKS == 4
include "F6/mapper.c26"
#elif MAPPER_BANKS == 8
include "F4/mapper.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#endif
#endif

include "vcs.c26"
include "frame_ntsc.c26"

#ifdef UNBANKED_REFERENCE
page const uint8_t game_playfield[48] := {
#else
page const uint8_t game_playfield[48] := {
#endif
   0xff, 0xff, 0xff, 0xff,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0x81, 0x18, 0x18, 0x81,
   0x81, 0x00, 0x00, 0x81,
   0xff, 0xff, 0xff, 0xff
};

instantiate "renderers/all_five/all_five.c26" as game (lines:=192)

#ifdef UNBANKED_REFERENCE
page const uint8_t player0_graphics[8] := {
#else
bank0 page const uint8_t player0_graphics[8] := {
#endif
   game_SPRITE_GLYPH(
      0b.XXXXXX.,
      0bXX....XX,
      0bXX...XXX,
      0bXX..X.XX,
      0bXX.X..XX,
      0bXXX...XX,
      0bXX....XX,
      0b.XXXXXX.
   )
};

#ifdef UNBANKED_REFERENCE
page const uint8_t player1_graphics[8] := {
#else
bank0 page const uint8_t player1_graphics[8] := {
#endif
   game_SPRITE_GLYPH(
      0b.XXXXXX.,
      0bXX....XX,
      0bXX....XX,
      0bXX.XX.XX,
      0bXX.XX.XX,
      0bXX....XX,
      0bXX....XX,
      0b.XXXXXX.
   )
};

#ifdef SUPERCHIP_TEST
cartram uint8_t banked_hook_count;
cartram uint8_t banked_hook_signature := 0x5a;
cartram uint8_t banked_hook_epoch;
#else
uint8_t banked_hook_count;
uint8_t banked_hook_signature := 0x5a;
uint8_t banked_hook_epoch;
#endif
uint8_t banked_hook_failure;

#ifdef UNBANKED_REFERENCE
void banked_game_logic(void) {
#else
bank1 void banked_game_logic(void) {
#endif
   if (banked_hook_signature != 0x5a) {
      banked_hook_failure := 1;
   }
   if (banked_hook_count == 0) {
      game_BALL_X := 104;
      banked_hook_epoch := 1;
   }
   banked_hook_count++;
}

#ifdef UNBANKED_REFERENCE
void initialize_banked_scene(void) {
#else
bank0 void initialize_banked_scene(void) {
#endif
   VBLANK := 2;
   COLUBK := 0x84;
   COLUPF := 0x2e;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;

   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_player0_color := 0x0e;
   game_player1_color := 0xc8;

   game_PLAYER0_X := 24;
   game_PLAYER1_X := 132;
   game_MISSILE0_X := 54;
   game_MISSILE1_X := 112;
   game_BALL_X := 80;

   game_player0_y := 18;
   game_missile0_y := 34;
   game_ball_y := 48;
   game_missile1_y := 62;
   game_player1_y := 78;

   game_player0_graphics := player0_graphics;
   game_player1_graphics := player1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 5;
   game_missile1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;

   game_init();
}

#ifdef UNBANKED_REFERENCE
void configure_banked_frame(void) {
#else
bank0 void configure_banked_frame(void) {
#endif
   if (banked_hook_failure) {
      COLUBK := 0x20;
   }
   else {
      COLUBK := 0x84;
   }
   COLUPF := 0x2e;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   // RESMP power-on state is unspecified; the component needs independent missiles.
   RESMP0 := 0;
   RESMP1 := 0;
}

#ifdef UNBANKED_REFERENCE
void main(void) {
#else
bank0 void main(void) {
#endif
   initialize_banked_scene();
   while (1) {
      configure_banked_frame();
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      banked_game_logic();
      vcs_ntsc_end_overscan();
   }
}
