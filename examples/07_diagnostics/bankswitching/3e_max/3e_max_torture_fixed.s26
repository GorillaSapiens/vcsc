;
; Maximum-size Tigervision 3E torture payload. This object contains the fixed-bank ROM scheduler and compiler-swapram driver.
; Cross-bank calls execute a tiny inline descriptor stub from RIOT RAM so
; the full 255 x 255 ordered matrix fits in one 512K cartridge.

.import failure, torture_count, expected_source, expected_dest, fixed_sp
.import torture_done, torture_batch, step_remaining
.import ram_phase, ram_bank, ram_page, ram_offset, ram_value, ram_lfsr
.import bankcall_stub
.import step_3e_max_ram, ram_walk_reset
.export fixed_probe, finish_3e_max_init, step_3e_max_torture, ram_compiler_access

.segment "CODE.bank255"


.segment "CODE.bank255.fixed_probe"
fixed_probe:
    inc torture_count
    bne.same fixed_probe_count_ok
    inc torture_count+1
fixed_probe_count_ok:
    rts

; The lower banks cannot directly relocate against a fixed-bank symbol without
; coupling their placement.  Cache the fixed probe address in ram_lfsr while
; the ROM phase runs; ram_walk_reset replaces it with $ACE1 before RAM testing.
.segment "CODE.bank255.finish_init"
finish_3e_max_init:
    lda #<fixed_probe
    sta ram_lfsr
    lda #>fixed_probe
    sta ram_lfsr+1
    rts

; Execute bounded work, then return to the frame loop.  The complete ROM
; matrix stays in fixed ROM.  RAM work lives in lower bank31 so the fixed 2K
; retains room for the compiler-selected 3E swapram helper.
.segment "CODE.bank255.rom_scheduler"
step_3e_max_torture:
    lda torture_done
    bne.same step_return
    lda ram_phase
    beq.same rom_phase
    jsr step_3e_max_ram
    .banktarget step_3e_max_ram
step_return:
    rts

rom_phase:
    lda expected_source
    cmp #$ff
    beq.same fixed_phase

    lda torture_batch
    sta step_remaining
    lda expected_source
    sta $3f
    jsr $1000
    lda expected_dest
    cmp #$ff
    bne.same step_return
    lda #0
    sta expected_dest
    inc expected_source
    rts

fixed_phase:
    ; The lower-bank matrix is complete. Reuse the one RAM stub from fixed ROM.
    lda #<$1f80
    sta bankcall_stub+1
    lda #>$1f80
    sta bankcall_stub+2
    lda #<$1100
    sta bankcall_stub+3
    lda #>$1100
    sta bankcall_stub+4
    tsx
    stx fixed_sp
    lda torture_batch
    sta step_remaining
fixed_dest_loop:
    lda expected_dest
    cmp #$ff
    beq.same fixed_done
    sta bankcall_stub+5
    jsr bankcall_stub
    inc expected_dest
    lda expected_dest
    cmp #$ff
    beq.same fixed_done
    dec step_remaining
    bne.same fixed_dest_loop

fixed_step_return:
    tsx
    cpx fixed_sp
    beq.same step_return
    lda #$05
    sta failure
    rts

fixed_done:
    tsx
    cpx fixed_sp
    beq.same fixed_stack_ok
    lda #$05
    sta failure
fixed_stack_ok:

    ; 255*255 lower calls + 255 lower->fixed + 255 fixed->lower = 65535.
    lda torture_count
    cmp #$ff
    beq.same count_lo_ok
    lda #$06
    sta failure
count_lo_ok:
    lda torture_count+1
    cmp #$ff
    beq.same count_hi_ok
    lda #$07
    sta failure
count_hi_ok:
    lda #1
    sta ram_phase
    jsr ram_walk_reset
    .banktarget ram_walk_reset
    rts

; Fixed-ROM bridge used by bank31's RAM scheduler.  This dynamic call starts
; from the fixed trampoline copy, selects the RAM object's matching lower ROM
; bank, and enters its $1200 wrapper.  That wrapper calls C26 ram_access_N(),
; whose ordinary swapram lvalue is compiler-lowered through swapram_read1 or
; swapram_write1 in this same fixed bank.
.segment "CODE.bank255.ram_dispatch"
ram_compiler_access:
    lda #<$1200
    sta bankcall_stub+3
    lda #>$1200
    sta bankcall_stub+4
    lda ram_bank
    sta bankcall_stub+5
    lda #<$1f80
    sta bankcall_stub+1
    lda #>$1f80
    sta bankcall_stub+2
    jsr bankcall_stub
    rts

