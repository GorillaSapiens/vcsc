//
// Compiler-lowered swapram accessors for the maximum-size 3E diagnostic.
// There is exactly one 1K swapram object per Stella RAM bank.  The 8-bit
// runtime offset selects within one of four constant 256-byte quarters,
// keeping compiler scratch small while every tested byte remains an ordinary
// C26 swapram lvalue lowered through the mapper-owned helper ABI.
instantiate "3E/mapper.c26" as mapper (VCS_3E_BANKS:=256)

extern uint8_t ram_phase;
extern uint8_t ram_page;
extern uint8_t ram_offset;
extern uint8_t ram_value;

extern swapram uint8_t ram_00[1024];
extern swapram uint8_t ram_01[1024];
extern swapram uint8_t ram_02[1024];
extern swapram uint8_t ram_03[1024];
extern swapram uint8_t ram_04[1024];
extern swapram uint8_t ram_05[1024];
extern swapram uint8_t ram_06[1024];
extern swapram uint8_t ram_07[1024];
extern swapram uint8_t ram_08[1024];
extern swapram uint8_t ram_09[1024];
extern swapram uint8_t ram_10[1024];
extern swapram uint8_t ram_11[1024];
extern swapram uint8_t ram_12[1024];
extern swapram uint8_t ram_13[1024];
extern swapram uint8_t ram_14[1024];
extern swapram uint8_t ram_15[1024];
extern swapram uint8_t ram_16[1024];
extern swapram uint8_t ram_17[1024];
extern swapram uint8_t ram_18[1024];
extern swapram uint8_t ram_19[1024];
extern swapram uint8_t ram_20[1024];
extern swapram uint8_t ram_21[1024];
extern swapram uint8_t ram_22[1024];
extern swapram uint8_t ram_23[1024];
extern swapram uint8_t ram_24[1024];
extern swapram uint8_t ram_25[1024];
extern swapram uint8_t ram_26[1024];
extern swapram uint8_t ram_27[1024];
extern swapram uint8_t ram_28[1024];
extern swapram uint8_t ram_29[1024];
extern swapram uint8_t ram_30[1024];
extern swapram uint8_t ram_31[1024];

bank0 void ram_access_00(void) {
   if (ram_phase == 1) {
      if (ram_page == 0) { ram_00[ram_offset] := ram_value; }
      else { if (ram_page == 1) { ram_00[(uint16_t)ram_offset + 256] := ram_value; }
      else { if (ram_page == 2) { ram_00[(uint16_t)ram_offset + 512] := ram_value; }
      else { ram_00[(uint16_t)ram_offset + 768] := ram_value; } } }
   } else {
      if (ram_page == 0) { ram_value := ram_00[ram_offset]; }
      else { if (ram_page == 1) { ram_value := ram_00[(uint16_t)ram_offset + 256]; }
      else { if (ram_page == 2) { ram_value := ram_00[(uint16_t)ram_offset + 512]; }
      else { ram_value := ram_00[(uint16_t)ram_offset + 768]; } } }
   }
}

