; Backing storage for 19_3e_max compiler-managed swapram lvalues.
; Exactly 32 x 1K objects occupy Stella's complete classic-3E RAM capacity.
.export ram_00
.segment "BSS.swapram.__vcsc_object$ram_00"
ram_00:
    .res 1024

