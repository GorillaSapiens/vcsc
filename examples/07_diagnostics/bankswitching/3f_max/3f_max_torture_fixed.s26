;
; Maximum-size Tigervision 3F torture payload. This object contains the fixed-bank scheduler.
; Cross-bank calls execute a tiny inline descriptor stub from RIOT RAM so
; the full 255 x 255 ordered matrix fits in one 512K cartridge.

.import failure, torture_count, expected_source, expected_dest, fixed_sp
.import torture_done, torture_batch, step_remaining
.import lower_stub, lower_fixed_stub, fixed_stub
.import bank0_link_root
.import bank32_link_root
.import bank64_link_root
.import bank96_link_root
.import bank128_link_root
.import bank160_link_root
.import bank192_link_root
.import bank224_link_root
.importzp _vcsc_ptr0
.export init_3f_max_torture, step_3f_max_torture, run_3f_max_torture

.segment "CODE.bank255"


fixed_probe:
    inc torture_count
    bne.same fixed_probe_count_ok
    inc torture_count+1
fixed_probe_count_ok:
    rts

init_3f_max_torture:
    lda #0
    sta failure
    sta torture_count
    sta torture_count+1
    sta expected_source
    sta expected_dest
    sta torture_done

    ; Force the generic bankcall scratch object into the link so every replicated
    ; trampoline is patched to the actual _vcsc_ptr0 address.
    lda _vcsc_ptr0

    ; lower_stub = JSR $1780 / .word $1100 / .byte destination / RTS
    lda #$20
    sta lower_stub
    lda #<$1780
    sta lower_stub+1
    lda #>$1780
    sta lower_stub+2
    lda #<$1100
    sta lower_stub+3
    lda #>$1100
    sta lower_stub+4
    lda #0
    sta lower_stub+5
    lda #$60
    sta lower_stub+6

    ; lower_fixed_stub uses the lower bank's trampoline but targets fixed ROM.
    lda #$20
    sta lower_fixed_stub
    lda #<$1780
    sta lower_fixed_stub+1
    lda #>$1780
    sta lower_fixed_stub+2
    lda #<fixed_probe
    sta lower_fixed_stub+3
    lda #>fixed_probe
    sta lower_fixed_stub+4
    lda #$ff
    sta lower_fixed_stub+5
    lda #$60
    sta lower_fixed_stub+6

    ; fixed_stub uses the fixed bank's trampoline and targets common lower $1100.
    lda #$20
    sta fixed_stub
    lda #<$1f80
    sta fixed_stub+1
    lda #>$1f80
    sta fixed_stub+2
    lda #<$1100
    sta fixed_stub+3
    lda #>$1100
    sta fixed_stub+4
    lda #0
    sta fixed_stub+5
    lda #$60
    sta fixed_stub+6
    rts

; Execute at most torture_batch target calls, then return to the frame loop.
; Lower-bank state lives in expected_source/expected_dest.  $ff source means
; the lower-bank matrix is complete and the fixed->lower sweep is in progress.
step_3f_max_torture:
    lda torture_done
    bne.same step_return

    lda expected_source
    cmp #$ff
    beq.same fixed_phase

    lda torture_batch
    sta step_remaining
    lda expected_source
    sta $3f
    jsr $1000
    lda expected_dest
    cmp #$ff
    bne.same step_return
    lda #0
    sta expected_dest
    inc expected_source
step_return:
    rts

fixed_phase:
    tsx
    stx fixed_sp
    lda torture_batch
    sta step_remaining
fixed_dest_loop:
    lda expected_dest
    cmp #$ff
    beq.same fixed_done
    sta fixed_stub+5
    jsr fixed_stub
    inc expected_dest
    lda expected_dest
    cmp #$ff
    beq.same fixed_done
    dec step_remaining
    bne.same fixed_dest_loop

fixed_step_return:
    tsx
    cpx fixed_sp
    beq.same step_return
    lda #$05
    sta failure
    rts

fixed_done:
    tsx
    cpx fixed_sp
    beq.same fixed_stack_ok
    lda #$05
    sta failure
fixed_stack_ok:

    ; 255*255 lower calls + 255 lower->fixed + 255 fixed->lower = 65535.
    lda torture_count
    cmp #$ff
    beq.same count_lo_ok
    lda #$06
    sta failure
count_lo_ok:
    lda torture_count+1
    cmp #$ff
    beq.same count_hi_ok
    lda #$07
    sta failure
count_hi_ok:
    lda #1
    sta torture_done
    rts

; Fast path used by the simulator regression: same state machine, maximum batch.
run_3f_max_torture:
    jsr init_3f_max_torture
    lda #$ff
    sta torture_batch
run_torture_loop:
    jsr step_3f_max_torture
    lda torture_done
    beq.same run_torture_loop
    rts

torture_object_roots:
    jsr bank0_link_root
    .banktarget bank0_link_root
    jsr bank32_link_root
    .banktarget bank32_link_root
    jsr bank64_link_root
    .banktarget bank64_link_root
    jsr bank96_link_root
    .banktarget bank96_link_root
    jsr bank128_link_root
    .banktarget bank128_link_root
    jsr bank160_link_root
    .banktarget bank160_link_root
    jsr bank192_link_root
    .banktarget bank192_link_root
    jsr bank224_link_root
    .banktarget bank224_link_root
    rts
