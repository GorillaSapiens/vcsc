// Interactive score-above diagnostic.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"
include "fonts/default_decimal.c26"

instantiate "renderers/all_five_player_color_181/all_five_player_color_181.c26" as game
instantiate "six_glyph_component.c26" as score (mutable_color:=1)

inline void draw_visible_components(void) {
   score_draw();
   vcs_ntsc_component_handoff();
   game_draw();
}

include "../../all_five_player_color_181_interactive_common.c26"
