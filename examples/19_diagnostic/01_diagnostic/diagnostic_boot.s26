;
; Diagnostic reset shim.  A 7800 boot leaves its compatibility loader in
; RIOT RAM before the cartridge reset vector runs.  Capture the distinctive
; JMP ($FFFC) / NOP tail before normal VCSC startup clears allocated BSS,
; publish the one-bit result in compiler-owned noinit Superchip RAM, then
; tail-enter the stock table-driven startup.  The linker omits this noinit
; object from the ordinary ZERO table.

.import diagnostic_boot_7800
.import __vcsc_startup_full
.export __reset

.segment "CODE"
__reset:
   ; Scan every four-byte window in RIOT RAM for 6C FC FF EA.  The JMP
   ; ($FFFC) is the 7800 loader's return through the cartridge reset vector;
   ; the following EA is unreachable in normal flow but strengthens the
   ; signature and is part of the observed 7800 RAM image.
   ldy #0
   ldx #0
@scan_7800:
   lda $80,x
   cmp #$6c
   bne @next_7800
   lda $81,x
   cmp #$fc
   bne @next_7800
   lda $82,x
   cmp #$ff
   bne @next_7800
   lda $83,x
   cmp #$ea
   bne @next_7800
   iny
   jmp @publish_7800
@next_7800:
   inx
   cpx #$7d
   bne @scan_7800

@publish_7800:
   ; Publish the pre-startup result through the F4SC write alias.  Normal
   ; table-driven startup clears every ordinary allocated BSS object but has
   ; no ZERO record for this noinit object, so this byte survives unchanged.
   tya
   sta {diagnostic_boot_7800 - 128}
   jmp __vcsc_startup_full
