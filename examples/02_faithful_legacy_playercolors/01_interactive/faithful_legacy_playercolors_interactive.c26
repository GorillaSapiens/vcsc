include "vcs.c26"
include "color_ntsc.c26"
include "playfield.c26"

// Present legacy_score in the same human left-to-right order as bcd24_t and
// the eleven-line score components, while leaving the renderer's default
// retained-source ordering untouched for oracle fixtures.
alias VCSC_FAITHFUL_LEGACY_HUMAN_SCORE_ORDER 1
instantiate "renderers/faithful_legacy_playercolors/faithful_legacy_playercolors.c26" as legacy
alias score_score legacy_score
alias score_color legacy_score_color
include "../../common/fixed_six_digit_controls.c26"

uint8_t legacy_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX),
   VCS_PLAYFIELD_ROW(0bX......X...X..........X.X......X),
   VCS_PLAYFIELD_ROW(0bX...X..X.....X....X.....X..X...X),
   VCS_PLAYFIELD_ROW(0bX......X..XX........XX..X......X),
   VCS_PLAYFIELD_ROW(0bX.X....X......X..X......X....X.X),
   VCS_PLAYFIELD_ROW(0bX......X...XX......XX...X......X),
   VCS_PLAYFIELD_ROW(0bX..X...X.X............X.X...X..X),
   VCS_PLAYFIELD_ROW(0bX......X....X......X....X......X),
   VCS_PLAYFIELD_ROW(0bX....X.X.......XX.......X.X....X),
   VCS_PLAYFIELD_ROW(0bX......X.XX..........XX.X......X),
   VCS_PLAYFIELD_ROW(0bXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX),
   VCS_PLAYFIELD_ROW(0b................................)
};

page const uint8_t p0g[8] := {
   legacy_SPRITE_GLYPH(
      0b.XX..XX.,
      0b..XXXX..,
      0b.XXXXXX.,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0bX.XXXX.X,
      0bX.X..X.X,
      0b.X....X.
   )
};

page const uint8_t p1g[8] := {
   legacy_SPRITE_GLYPH(
      0b..XXXX..,
      0b.XX..XX.,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b..X..X..,
      0b.X.XX.X.,
      0bX.X..X.X
   )
};

page const uint8_t p0c[8] := {
   legacy_SPRITE_ROWS(
      VCS_NTSC_SANDY_BROWN,
      VCS_NTSC_LIGHT_CORAL,
      VCS_NTSC_ORCHID,
      VCS_NTSC_VIOLET,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_SKY_BLUE
   )
};

page const uint8_t p1c[8] := {
   legacy_SPRITE_ROWS(
      VCS_NTSC_PALE_GREEN,
      VCS_NTSC_AQUAMARINE,
      VCS_NTSC_SKY_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_VIOLET,
      VCS_NTSC_ORCHID
   )
};


alias OBJECT_MAX_Y 87
alias SELECTED_PLAYER0 0
alias SELECTED_PLAYER1 1
alias SELECTED_BALL    2
alias SELECTED_OBJECT_COUNT 3

uint8_t selected_object := SELECTED_PLAYER0;
uint8_t select_switch_ready := 1;
inline void update_object_selection(void) {
   if (SWCHB & 0x02) {
      select_switch_ready := 1;
   }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object >= SELECTED_OBJECT_COUNT) {
            selected_object := SELECTED_PLAYER0;
         }
         select_switch_ready := 0;
      }
   }
}

inline void move_selected_object(void) {
   if (!(SWCHA & 0x40)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:
            if (legacy_PLAYER0_X > 0) { legacy_PLAYER0_X--; }
            break;
         case SELECTED_PLAYER1:
            if (legacy_PLAYER1_X > 0) { legacy_PLAYER1_X--; }
            break;
         default:
            if (legacy_BALL_X > 0) { legacy_BALL_X--; }
      }
   }
   else {
      if (!(SWCHA & 0x80)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:
               if (legacy_PLAYER0_X < 159) { legacy_PLAYER0_X++; }
               break;
            case SELECTED_PLAYER1:
               if (legacy_PLAYER1_X < 159) { legacy_PLAYER1_X++; }
               break;
            default:
               if (legacy_BALL_X < 159) { legacy_BALL_X++; }
         }
      }
   }

   if (!(SWCHA & 0x10)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:
            if (legacy_player0_y > 0) { legacy_player0_y--; }
            break;
         case SELECTED_PLAYER1:
            if (legacy_player1_y > 0) { legacy_player1_y--; }
            break;
         default:
            if (legacy_ball_y > 0) { legacy_ball_y--; }
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:
               if (legacy_player0_y < OBJECT_MAX_Y) { legacy_player0_y++; }
               break;
            case SELECTED_PLAYER1:
               if (legacy_player1_y < OBJECT_MAX_Y) { legacy_player1_y++; }
               break;
            default:
               if (legacy_ball_y < OBJECT_MAX_Y) { legacy_ball_y++; }
         }
      }
   }
}


inline void update_controls(void) {
   // Keep the console Reset path scratch-free; the renderer's hidden
   // assembly helper stack now consumes the bytes previously borrowed here.
   asm lda SWCHB;
   asm and #$01;
   asm bne @reset_not_pressed;
   asm jmp ($fffc);
   asm @reset_not_pressed:;
   update_object_selection();
   move_selected_object();
   update_score_controls();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;

   legacy_PLAYER0_X := 44;
   legacy_PLAYER1_X := 108;
   legacy_BALL_X := 78;
   legacy_object_x[2] := 0;
   legacy_object_x[3] := 0;

   legacy_player0_y := 78;
   legacy_player1_y := 42;
   legacy_ball_y := 45;

   legacy_player0_graphics := p0g;
   legacy_player1_graphics := p1g;
   legacy_player0_height := 7;
   legacy_player1_height := 7;
   legacy_ball_height := 3;

   legacy_missile0_height := 0;
   legacy_missile1_height := 0;
   legacy_missile0_y := 0;
   legacy_missile1_y := 0;

   legacy_player0_colors := p0c;
   legacy_player1_colors := p1c;

   // Standard little-endian packed BCD for the visible value 123456.
   legacy_score := 123456;
   legacy_score_color := VCS_NTSC_GRAY_92;
   legacy_playfield_position := 8;

   VBLANK := 2;
   TIM64T := 0;

   while (1) {
      COLUPF := VCS_NTSC_GOLDENROD;
      CTRLPF := 0x21;
      NUSIZ0 := 0x20;
      NUSIZ1 := 0x20;
      legacy_drawscreen();
      update_controls();
   }
}
