// Minimal unbanked 4K Atari VCS cartridge with a frame-driven melody.
// Plays the opening phrase of Beethoven's "Ode to Joy" forever on TIA audio 0.

include "vcs.n"
include "sound_ntsc.n"

struct MusicStep {
   uint8_t volume;
   uint8_t frequency;
   uint8_t control;
   uint8_t timing;
};

alias MUSIC_STEP_COUNT 32

const MusicStep music[MUSIC_STEP_COUNT] := {
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_F4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_G4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },

   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_G4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_F4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_D4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },

   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_D4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },

   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_E4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_D4, MUSIC_CONTROL_LEAD, MUSIC_TIME_QUARTER },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_MEDIUM, MUSIC_FREQ_D4, MUSIC_CONTROL_LEAD, MUSIC_TIME_HALF },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_EIGHTH },
   { MUSIC_VOLUME_OFF,    MUSIC_FREQ_C4, MUSIC_CONTROL_LEAD, MUSIC_TIME_GAP }
};

uint8_t music_index := 0;
uint8_t music_counter := 0;

extern void music_apply_current(void);
extern void music_tick(void);

void main(void) {
   // Clear video objects and silence the unused audio channel.
   PF0 := 0;
   PF1 := 0;
   PF2 := 0;
   GRP0 := 0;
   GRP1 := 0;
   ENAM0 := 0;
   ENAM1 := 0;
   ENABL := 0;
   COLUBK := 0x24;
   AUDV1 := 0;

   music_apply_current();

   // 262 scanlines: 3 VSYNC, 37 vertical blank, 192 visible, 30 overscan.
   asm @frame:;
   asm lda #2;
   asm sta VSYNC;
   asm ldx #3;
   asm @vsync:;


   asm sta WSYNC;
   asm dex;
   asm bne @vsync;

   asm lda #0;
   asm sta VSYNC;
   asm lda #2;
   asm sta VBLANK;
   asm lda #0;
   asm ldx #37;
   asm @vblank:;
   asm sta WSYNC;
   asm dex;
   asm bne @vblank;

   asm lda #0;
   asm sta VBLANK;
   asm ldx #192;
   asm @visible:;
   asm sta WSYNC;
   asm dex;
   asm bne @visible;

   asm lda #2;
   asm sta VBLANK;

   // Thirty scanlines of overscan. TIM64T=35 reaches zero late in the
   // thirtieth line; music_tick() runs while it counts down. The final WSYNC
   // aligns the next VSYNC to the following scanline boundary.
   asm lda #35;
   asm sta TIM64T;
   music_tick();
   asm @overscan_wait:;
   asm lda INTIM;
   asm bne @overscan_wait;
   asm sta WSYNC;

   asm jmp @frame;
}
