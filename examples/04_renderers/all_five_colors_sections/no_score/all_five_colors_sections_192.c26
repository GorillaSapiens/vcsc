// Interactive experimental preview: build and run from this leaf directory.
// Even-line combined-colour preview; see README.md. Build with make.
include "vcs.c26"
include "frame_ntsc.c26"
#if ALL_FIVE_REPEATED_PREVIEW
include "../../../_common/all_five_colors_sections_repeated_mapper.c26"
#else
include "F8/mapper.c26"
#endif
include "playfield.c26"

// The default build folds two alternating patterns into immediate PF writes.
// `make repeated` instead selects the twelve independently editable rows below.
alias PREVIEW_EVEN_ROW VCS_PLAYFIELD_ROW(0bX......X_...XX..._.X....X._..X..X..)
alias PREVIEW_ODD_ROW VCS_PLAYFIELD_ROW(0b..XX.XX._X......X_...XX..._X.X..X.X)
page const uint8_t game_playfield[48] := {
#if ALL_FIVE_REPEATED_PREVIEW
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._.X....X._..X..X..),
   VCS_PLAYFIELD_ROW(0b..XX.XX._X......X_...XX..._X.X..X.X),
   VCS_PLAYFIELD_ROW(0bXXXX...._....XXXX_X......X_...XX...),
   VCS_PLAYFIELD_ROW(0bX..XX..X_.XX..XX._..XXXX.._XX....XX),
   VCS_PLAYFIELD_ROW(0b.X....X._X.X..X.X_.X.XX.X._X......X),
   VCS_PLAYFIELD_ROW(0bXXX..XXX_...XX..._XX.XX.XX_..X..X..),
   VCS_PLAYFIELD_ROW(0b.XXXXXX._X......X_.XX..XX._X..XX..X),
   VCS_PLAYFIELD_ROW(0bX.X.X.X._.X.X.X.X_XX....XX_..XXXX..),
   VCS_PLAYFIELD_ROW(0b...XX..._XXX..XXX_..X..X.._XX.XX.XX),
   VCS_PLAYFIELD_ROW(0bX.XXXX.X_.X....X._X......X_.XXXXXX.),
   VCS_PLAYFIELD_ROW(0bXX....XX_..XXXX.._X.X..X.X_.X.XX.X.),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_X......X_...XX..._XXXXXXXX)
#else
   PREVIEW_EVEN_ROW, PREVIEW_ODD_ROW,
   PREVIEW_EVEN_ROW, PREVIEW_ODD_ROW,
   PREVIEW_EVEN_ROW, PREVIEW_ODD_ROW,
   PREVIEW_EVEN_ROW, PREVIEW_ODD_ROW,
   PREVIEW_EVEN_ROW, PREVIEW_ODD_ROW,
   PREVIEW_EVEN_ROW, PREVIEW_ODD_ROW
#endif
};

// Independent bottom-to-top player row colours; all five objects stay live.
page const uint8_t game_player0_colors[8] := {0x0e,0x2e,0x4e,0x6e,0x8e,0xae,0xce,0xee};
page const uint8_t game_player1_colors[8] := {0xee,0xce,0xae,0x8e,0x6e,0x4e,0x2e,0x0e};
// Default seams: 6,18,46,80,114,150,190. Even heights total 192.
#if ALL_FIVE_REPEATED_PREVIEW
alias COMBINED_SECTION_COMPONENT "../../../_common/all_five_colors_sections_repeated_preview.c26"
#else
alias COMBINED_SECTION_COMPONENT "../../../_common/all_five_colors_sections_global_preview.c26"
#endif
instantiate COMBINED_SECTION_COMPONENT as game (
   section1_lines:=6, section2_lines:=12, section3_lines:=28, section4_lines:=34,
   section5_lines:=34, section6_lines:=36, section7_lines:=40, section8_lines:=2,
   section1_colupf:=0x2e, section1_colubk:=0x84,
   section2_colupf:=0x46, section2_colubk:=0xc2,
   section3_colupf:=0x8e, section3_colubk:=0x26,
   section4_colupf:=0xae, section4_colubk:=0x64,
   section5_colupf:=0x2e, section5_colubk:=0x84,
   section6_colupf:=0x46, section6_colubk:=0xc2,
   section7_colupf:=0x8e, section7_colubk:=0x26,
   section8_colupf:=0xae, section8_colubk:=0x64
)

include "../../../_common/all_five_colors_sections_preview_sprites.c26"

#if ALL_FIVE_REPEATED_PREVIEW
bank0 void update_player_animation(void) {
#else
inline void update_player_animation(void) {
#endif
   game_player0_graphics := p0_animation;
   game_player0_graphics += ((game_PLAYER0_X ^ game_player0_y) & 0x03) << 3;
   game_player1_graphics := p1_animation;
   game_player1_graphics += ((game_PLAYER1_X ^ game_player1_y) & 0x03) << 3;
}
// Permit bottom clipping so every object can move through the line190 seam.
alias OBJECT_MAX_Y 103
alias SELECTED_PLAYER0  0
alias SELECTED_PLAYER1  1
alias SELECTED_MISSILE0 2
alias SELECTED_MISSILE1 3
alias SELECTED_BALL     4
alias SELECTED_OBJECT_COUNT 5

uint8_t selected_object := SELECTED_PLAYER0;
uint8_t select_switch_ready := 1;

inline void update_object_selection(void) {
   if (SWCHB & 0x02) {
      select_switch_ready := 1;
   }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object >= SELECTED_OBJECT_COUNT) {
            selected_object := SELECTED_PLAYER0;
         }
         select_switch_ready := 0;
      }
   }
}

inline void move_selected_object(void) {
   if (!(SWCHA & 0x40)) {
      if (game_object_x[selected_object] > 0) {
         game_object_x[selected_object] -= 1;
      }
   }
   else {
      if (!(SWCHA & 0x80)) {
         if (game_object_x[selected_object] < 159) {
            game_object_x[selected_object] += 1;
         }
      }
   }
   if (!(SWCHA & 0x10)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:  if (game_player0_y > 0)  { game_player0_y -= 1; } break;
         case SELECTED_PLAYER1:  if (game_player1_y > 0)  { game_player1_y -= 1; } break;
         case SELECTED_MISSILE0: if (game_missile0_y > 0) { game_missile0_y -= 1; } break;
         case SELECTED_MISSILE1: if (game_missile1_y > 0) { game_missile1_y -= 1; } break;
         case SELECTED_BALL:     if (game_ball_y > 0)     { game_ball_y -= 1; } break;
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:  if (game_player0_y < OBJECT_MAX_Y)  { game_player0_y += 1; } break;
            case SELECTED_PLAYER1:  if (game_player1_y < OBJECT_MAX_Y)  { game_player1_y += 1; } break;
            case SELECTED_MISSILE0: if (game_missile0_y < OBJECT_MAX_Y) { game_missile0_y += 1; } break;
            case SELECTED_MISSILE1: if (game_missile1_y < OBJECT_MAX_Y) { game_missile1_y += 1; } break;
            case SELECTED_BALL:     if (game_ball_y < OBJECT_MAX_Y)     { game_ball_y += 1; } break;
         }
      }
   }
}

bank1 void update_controls(void) {
   // Match the other all-five examples: Reset is scratch-free and controls run
   // after renderer cleanup in overscan, ready for next frame's preparation.
   if (!(SWCHB & 0x01)) {
      hard_reset();
   }
   update_object_selection();
   move_selected_object();
}

bank1 void initialize_game(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_PLAYER0_X := 20;
   game_PLAYER1_X := 60;
   game_MISSILE0_X := 85;
   game_MISSILE1_X := 110;
   game_BALL_X := 148;
    game_player0_y := 6;
    game_player1_y := 14;
    game_missile0_y := 30;
    game_missile1_y := 46;
    game_ball_y := 78;
   // The inherited player-height convention is the last row index: 7 means 8.
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 7;
   game_missile1_height := 7;
   game_ball_height := 7;
   game_init();
}

#if ALL_FIVE_REPEATED_PREVIEW
bank0 void draw_repeated_frame(void) {
   vcs_ntsc_end_vblank();
   game_draw();
   vcs_ntsc_begin_overscan();
}
bank1 void run_repeated_game(void) {
#else
void main(void) {
#endif
   initialize_game();
   update_player_animation();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
       COLUPF := game_INITIAL_COLUPF;
       COLUBK := game_INITIAL_COLUBK;
      game_vblank();
#if ALL_FIVE_REPEATED_PREVIEW
       draw_repeated_frame();
#else
       vcs_ntsc_end_vblank();
       game_draw();
       vcs_ntsc_begin_overscan();
#endif
      game_overscan();
       update_controls();
       update_player_animation();
      vcs_ntsc_end_overscan();
   }
}
#if ALL_FIVE_REPEATED_PREVIEW
void main(void) {
   run_repeated_game();
}
#endif
