// Build from the project root:
// driver/vcsc -I libraries/vcs examples/04_renderers/all_five_sections/no_score/all_five_sections_192.c26 -o /tmp/all_five_sections.bin
include "vcs.c26"
include "frame_ntsc.c26"
include "playfield.c26"

// Each visual row is left-to-right; the helper emits four renderer-order bytes.
page const uint8_t game_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._.X....X._..X..X..),
   VCS_PLAYFIELD_ROW(0b..XX.XX._X......X_...XX..._X.X..X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._.X....X._..X..X..),
   VCS_PLAYFIELD_ROW(0b..XX.XX._X......X_...XX..._X.X..X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._.X....X._..X..X..),
   VCS_PLAYFIELD_ROW(0b..XX.XX._X......X_...XX..._X.X..X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._.X....X._..X..X..),
   VCS_PLAYFIELD_ROW(0b..XX.XX._X......X_...XX..._X.X..X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._.X....X._..X..X..),
   VCS_PLAYFIELD_ROW(0b..XX.XX._X......X_...XX..._X.X..X.X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._.X....X._..X..X..),
   VCS_PLAYFIELD_ROW(0b..XX.XX._X......X_...XX..._X.X..X.X)
};

// Edit heights and colours here. Heights are scanlines, not sprite Y units.
// Eight sections total 192; seams are at 6,8,14,16,18,28,62.
instantiate "renderers/all_five_sections_192/all_five_sections_192.c26" as game (
   section1_lines:=6,   section1_colupf:=0x2e, section1_colubk:=0x84,
   section2_lines:=2,   section2_colupf:=0x46, section2_colubk:=0xc2,
   section3_lines:=6,   section3_colupf:=0x8e, section3_colubk:=0x26,
   section4_lines:=2,   section4_colupf:=0xae, section4_colubk:=0x64,
   section5_lines:=2,   section5_colupf:=0x2e, section5_colubk:=0x84,
   section6_lines:=10,  section6_colupf:=0x46, section6_colubk:=0xc2,
   section7_lines:=34,  section7_colupf:=0x8e, section7_colubk:=0x26,
   section8_lines:=130, section8_colupf:=0xae, section8_colubk:=0x64
)

include "../../../_common/all_five_sections_interactive_sprites.c26"

inline void update_player_animation(void) {
   game_player0_graphics := p0_animation;
   game_player0_graphics += ((game_PLAYER0_X ^ game_player0_y) & 0x03) << 3;
   game_player1_graphics := p1_animation;
   game_player1_graphics += ((game_PLAYER1_X ^ game_player1_y) & 0x03) << 3;
}
alias OBJECT_MAX_Y 95
alias SELECTED_PLAYER0  0
alias SELECTED_PLAYER1  1
alias SELECTED_MISSILE0 2
alias SELECTED_MISSILE1 3
alias SELECTED_BALL     4
alias SELECTED_OBJECT_COUNT 5

uint8_t selected_object := SELECTED_PLAYER0;
uint8_t select_switch_ready := 1;

inline void update_object_selection(void) {
   if (SWCHB & 0x02) {
      select_switch_ready := 1;
   }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object >= SELECTED_OBJECT_COUNT) {
            selected_object := SELECTED_PLAYER0;
         }
         select_switch_ready := 0;
      }
   }
}

inline void move_selected_object(void) {
   if (!(SWCHA & 0x40)) {
      if (game_object_x[selected_object] > 0) {
         game_object_x[selected_object] -= 1;
      }
   }
   else {
      if (!(SWCHA & 0x80)) {
         if (game_object_x[selected_object] < 159) {
            game_object_x[selected_object] += 1;
         }
      }
   }
   if (!(SWCHA & 0x10)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:  if (game_player0_y > 0)  { game_player0_y -= 1; } break;
         case SELECTED_PLAYER1:  if (game_player1_y > 0)  { game_player1_y -= 1; } break;
         case SELECTED_MISSILE0: if (game_missile0_y > 0) { game_missile0_y -= 1; } break;
         case SELECTED_MISSILE1: if (game_missile1_y > 0) { game_missile1_y -= 1; } break;
         case SELECTED_BALL:     if (game_ball_y > 0)     { game_ball_y -= 1; } break;
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:  if (game_player0_y < OBJECT_MAX_Y)  { game_player0_y += 1; } break;
            case SELECTED_PLAYER1:  if (game_player1_y < OBJECT_MAX_Y)  { game_player1_y += 1; } break;
            case SELECTED_MISSILE0: if (game_missile0_y < OBJECT_MAX_Y) { game_missile0_y += 1; } break;
            case SELECTED_MISSILE1: if (game_missile1_y < OBJECT_MAX_Y) { game_missile1_y += 1; } break;
            case SELECTED_BALL:     if (game_ball_y < OBJECT_MAX_Y)     { game_ball_y += 1; } break;
         }
      }
   }
}

inline void update_controls(void) {
   // Match the other all-five examples: Reset is scratch-free and controls run
   // after renderer cleanup in overscan, ready for next frame's preparation.
   if (!(SWCHB & 0x01)) {
      hard_reset();
   }
   update_object_selection();
   move_selected_object();
   update_player_animation();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_PLAYER0_X := 20;
   game_PLAYER1_X := 60;
   game_MISSILE0_X := 85;
   game_MISSILE1_X := 110;
   game_BALL_X := 148;
   game_player0_y := 18;
   game_player1_y := 78;
   game_missile0_y := 34;
   game_missile1_y := 62;
   game_ball_y := 48;
   update_player_animation();
   // The inherited player-height convention is the last row index: 7 means 8.
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 7;
   game_missile1_height := 7;
   game_ball_height := 7;
   game_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
