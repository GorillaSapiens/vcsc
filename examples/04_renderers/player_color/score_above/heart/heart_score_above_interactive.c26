// Interactive heart score above the maintained 181-line player-color renderer.
include "4K/mapper.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"

instantiate "renderers/player_color/player_color.c26" as game (lines:=181)
instantiate "heart_score_component.c26" as score (line_markers:=1)

include "../../../../_common/heart_score_controls.c26"

inline void draw_visible_components(void) {
   score_draw();
   // The enabled heart profile is ten lines; one blank line keeps the
   // composed visible field at 192 (10 + 1 + 181).
   WSYNC := _;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;
   vcs_ntsc_component_handoff();
   game_draw();
}

include "../../../../_common/heart_score_player_color_181_common.c26"
