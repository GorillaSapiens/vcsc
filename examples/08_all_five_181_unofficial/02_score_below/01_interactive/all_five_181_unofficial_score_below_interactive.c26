// All-five score below gameplay interactive diagnostic.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"
include "fonts/default_decimal.c26"

page const uint8_t game_playfield[44] := {
   VCS_PLAYFIELD_ROW(0bX.....X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.X.....X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0b..X....._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b...X...._.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b....X..._..X....._X.....X._....X...),
   VCS_PLAYFIELD_ROW(0b.....X.._...X...._.X.....X_.....X..),
   VCS_PLAYFIELD_ROW(0b......X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.......X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0bX......._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b.X......_.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b..X....._..X....._X.....X._....X...)
};

template "renderers/all_five_181_unofficial/all_five_181_unofficial.c26" as game
template "six_glyph_color_component.c26" as score

// These source rows are intentionally bottom-to-top. The maintained renderers
// reverse macro arguments for highest-index-to-zero traversal, so this makes
// the displayed sprites match the faithful legacy interactive example.
page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(
      0b.X....X.,
      0bX.X..X.X,
      0bX.XXXX.X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0b.XXXXXX.,
      0b..XXXX..,
      0b.XX..XX.
   )
};

page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(
      0bX.X..X.X,
      0b.X.XX.X.,
      0b..X..X..,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.XX..XX.,
      0b..XXXX..
   )
};

void configure_game_frame(void) {
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;
}

alias OBJECT_MAX_Y 87
alias SELECTED_PLAYER0  0
alias SELECTED_PLAYER1  1
alias SELECTED_MISSILE0 2
alias SELECTED_MISSILE1 3
alias SELECTED_BALL     4
alias SELECTED_OBJECT_COUNT 5

// object_control_state packs the selected object in bits 0..2 and the
// right-joystick sample countdown in bits 3..7. score_control_state packs the
// previous right-joystick sample in bits 0..3, the selected score digit in
// bits 4..6, and the SELECT-release latch in bit 7. This keeps the scored
// five-object diagnostic within the VCS's 128 bytes of RAM.
uint8_t object_control_state := 0x98;
uint8_t score_control_state := 0x8f;

page const uint8_t score_digit_low[6] := { 0x01, 0x10, 0x00, 0x00, 0x00, 0x00 };
page const uint8_t score_digit_middle[6] := { 0x00, 0x00, 0x01, 0x10, 0x00, 0x00 };
page const uint8_t score_digit_high[6] := { 0x00, 0x00, 0x00, 0x00, 0x01, 0x10 };

void initialize_scene(void) {
   VBLANK := 2;
   game_PLAYER0_X := 20;
   game_PLAYER1_X := 130;
   game_MISSILE0_X := 50;
   game_MISSILE1_X := 110;
   game_BALL_X := 80;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_player0_y := 18;
   game_player1_y := 78;
   game_missile0_y := 34;
   game_missile1_y := 62;
   game_ball_y := 48;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 5;
   game_missile1_height := 7;
   game_ball_height := 3;
   game_player0_color := VCS_NTSC_SKY_BLUE;
   game_player1_color := VCS_NTSC_ORCHID;
   game_playfield_position := 8;
   score_score := 123456;
   score_color := VCS_NTSC_GRAY_92;
   game_init();
   score_init();
}

inline void update_object_selection(void) {
   asm lda SWCHB;
   asm and #$02;
   asm beq @pressed;
   asm lda score_control_state;
   asm ora #$80;
   asm sta score_control_state;
   asm jmp @done;

   asm @pressed:;
   asm lda score_control_state;
   asm bpl @done;
   asm and #$7f;
   asm sta score_control_state;
   asm lda object_control_state;
   asm and #$07;
   asm clc;
   asm adc #1;
   asm cmp #5;
   asm bcc @selected;
   asm lda #0;
   asm @selected:;
   asm tax;
   asm lda object_control_state;
   asm and #$f8;
   asm sta object_control_state;
   asm txa;
   asm ora object_control_state;
   asm sta object_control_state;
   asm @done:;
}

inline void move_selected_object(void) {
   asm .importzp _vcsc_ptr0;
   asm lda object_control_state;
   asm and #$07;
   asm tax;

   asm lda SWCHA;
   asm and #$40;
   asm bne @not_left;
   asm lda.zx game_object_x,x;
   asm beq @vertical;
   asm sec;
   asm sbc #1;
   asm sta.zx game_object_x,x;
   asm jmp @vertical;

   asm @not_left:;
   asm lda SWCHA;
   asm and #$80;
   asm bne @vertical;
   asm lda.zx game_object_x,x;
   asm cmp #159;
   asm bcs @vertical;
   asm clc;
   asm adc #1;
   asm sta.zx game_object_x,x;

   asm @vertical:;
   asm lda @object_y_addresses,x;
   asm sta _vcsc_ptr0;
   asm lda #0;
   asm sta _vcsc_ptr0+1;
   asm ldy #0;
   asm lda SWCHA;
   asm and #$10;
   asm bne @not_up;
   asm lda.iy (_vcsc_ptr0),y;
   asm beq @done;
   asm sec;
   asm sbc #1;
   asm sta.iy (_vcsc_ptr0),y;
   asm jmp @done;

   asm @not_up:;
   asm lda SWCHA;
   asm and #$20;
   asm bne @done;
   asm lda.iy (_vcsc_ptr0),y;
   asm cmp #87;
   asm bcs @done;
   asm clc;
   asm adc #1;
   asm sta.iy (_vcsc_ptr0),y;
   asm @done:;
   asm jmp @addresses_done;
   asm @object_y_addresses:;
   asm .byte game_player0_y,game_player1_y,game_missile0_y,game_missile1_y,game_ball_y;
   asm @addresses_done:;
}

inline void update_score_controls(void) {
   asm lda object_control_state;
   asm and #$f8;
   asm beq @sample;
   asm lda object_control_state;
   asm sec;
   asm sbc #$08;
   asm sta object_control_state;
   asm jmp @done;

   asm @sample:;
   asm lda SWCHA;
   asm and #$0f;
   asm tax;
   asm eor score_control_state;
   asm and #$0f;
   asm bne @record;

   asm txa;
   asm and #$04;
   asm bne @not_left;
   asm lda score_control_state;
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm and #$07;
   asm clc;
   asm adc #1;
   asm cmp #6;
   asm bcc @left_digit;
   asm lda #0;
   asm @left_digit:;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm tay;
   asm lda score_control_state;
   asm and #$8f;
   asm sta score_control_state;
   asm tya;
   asm ora score_control_state;
   asm sta score_control_state;
   asm lda score_color;
   asm clc;
   asm adc #$10;
   asm sta score_color;
   asm jmp @vertical;

   asm @not_left:;
   asm txa;
   asm and #$08;
   asm bne @vertical;
   asm lda score_control_state;
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm and #$07;
   asm bne @right_digit;
   asm lda #6;
   asm @right_digit:;
   asm sec;
   asm sbc #1;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm tay;
   asm lda score_control_state;
   asm and #$8f;
   asm sta score_control_state;
   asm tya;
   asm ora score_control_state;
   asm sta score_control_state;
   asm lda score_color;
   asm clc;
   asm adc #$10;
   asm sta score_color;

   asm @vertical:;
   asm txa;
   asm and #$01;
   asm bne @not_up;
   asm lda score_control_state;
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm and #$07;
   asm tay;
   asm sed;
   asm clc;
   asm lda score_score;
   asm adc score_digit_low,y;
   asm sta score_score;
   asm lda score_score+1;
   asm adc score_digit_middle,y;
   asm sta score_score+1;
   asm lda score_score+2;
   asm adc score_digit_high,y;
   asm sta score_score+2;
   asm cld;
   asm jmp @record;

   asm @not_up:;
   asm txa;
   asm and #$02;
   asm bne @record;
   asm lda score_control_state;
   asm lsr;
   asm lsr;
   asm lsr;
   asm lsr;
   asm and #$07;
   asm tay;
   asm sed;
   asm sec;
   asm lda score_score;
   asm sbc score_digit_low,y;
   asm sta score_score;
   asm lda score_score+1;
   asm sbc score_digit_middle,y;
   asm sta score_score+1;
   asm lda score_score+2;
   asm sbc score_digit_high,y;
   asm sta score_score+2;
   asm cld;

   asm @record:;
   asm txa;
   asm and #$0f;
   asm tay;
   asm lda score_control_state;
   asm and #$f0;
   asm sta score_control_state;
   asm tya;
   asm ora score_control_state;
   asm sta score_control_state;
   asm lda object_control_state;
   asm and #$07;
   asm ora #$98;
   asm sta object_control_state;
   asm @done:;
}

inline void update_controls(void) {
   // Keep the console Reset path scratch-free; the renderer's hidden
   // assembly helper stack now consumes the bytes previously borrowed here.
   asm lda SWCHB;
   asm and #$01;
   asm bne @reset_not_pressed;
   asm jmp ($fffc);
   asm @reset_not_pressed:;
   update_object_selection();
   move_selected_object();
   update_score_controls();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   initialize_scene();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      score_vblank();
      configure_game_frame();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_component_handoff();
      score_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      score_overscan();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
