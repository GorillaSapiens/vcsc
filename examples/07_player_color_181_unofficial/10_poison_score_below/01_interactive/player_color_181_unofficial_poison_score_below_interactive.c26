// Poison diagnostic score below player_color_181_unofficial interactive diagnostic.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"

instantiate "renderers/player_color_181_unofficial/player_color_181_unofficial.c26" as game
instantiate "renderers/poison_debug_score/poison_debug_score.c26" as score

include "../../../common/poison_score_controls.c26"

inline void draw_visible_components(void) {
   game_draw();
   vcs_ntsc_component_handoff();
   score_draw();
}

include "../../../common/player_color_181_interactive_common.c26"
