include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"

page const uint8_t game_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bX......._...X...._.......X_........),
   VCS_PLAYFIELD_ROW(0b.X......_....X..._........_X.......),
   VCS_PLAYFIELD_ROW(0b..X....._.....X.._........_.X......),
   VCS_PLAYFIELD_ROW(0b...X...._......X._........_..X.....),
   VCS_PLAYFIELD_ROW(0b....X..._.......X_........_...X....),
   VCS_PLAYFIELD_ROW(0b.....X.._........_X......._....X...),
   VCS_PLAYFIELD_ROW(0b......X._........_.X......_.....X..),
   VCS_PLAYFIELD_ROW(0b.......X_........_..X....._......X.),
   VCS_PLAYFIELD_ROW(0b........_X......._...X...._.......X),
   VCS_PLAYFIELD_ROW(0b........_.X......_....X..._......X.),
   VCS_PLAYFIELD_ROW(0b........_..X....._.....X.._.....X..),
   VCS_PLAYFIELD_ROW(0b........_...X...._......X._....X...)
};

template "renderers/all_five_192/all_five_192.c26" as game

// These source rows are intentionally bottom-to-top. The maintained renderers
// reverse macro arguments for highest-index-to-zero traversal, so this makes
// the displayed sprites match the faithful legacy interactive example.
page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(
      0b.X....X.,
      0bX.X..X.X,
      0bX.XXXX.X,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0b.XXXXXX.,
      0b..XXXX..,
      0b.XX..XX.
   )
};

page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(
      0bX.X..X.X,
      0b.X.XX.X.,
      0b..X..X..,
      0bXXXXXXXX,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.XX..XX.,
      0b..XXXX..
   )
};

alias OBJECT_MAX_Y 95
alias SELECTED_PLAYER0  0
alias SELECTED_PLAYER1  1
alias SELECTED_MISSILE0 2
alias SELECTED_MISSILE1 3
alias SELECTED_BALL     4
alias SELECTED_OBJECT_COUNT 5

uint8_t selected_object := SELECTED_PLAYER0;
uint8_t select_switch_ready := 1;

inline void update_object_selection(void) {
   if (SWCHB & 0x02) {
      select_switch_ready := 1;
   }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object >= SELECTED_OBJECT_COUNT) {
            selected_object := SELECTED_PLAYER0;
         }
         select_switch_ready := 0;
      }
   }
}

inline void move_selected_object(void) {
   if (!(SWCHA & 0x40)) {
      if (game_object_x[selected_object] > 0) {
         game_object_x[selected_object] -= 1;
      }
   }
   else {
      if (!(SWCHA & 0x80)) {
         if (game_object_x[selected_object] < 159) {
            game_object_x[selected_object] += 1;
         }
      }
   }

   if (!(SWCHA & 0x10)) {
      switch (selected_object) {
         case SELECTED_PLAYER0:  if (game_player0_y > 0)  { game_player0_y -= 1; } break;
         case SELECTED_PLAYER1:  if (game_player1_y > 0)  { game_player1_y -= 1; } break;
         case SELECTED_MISSILE0: if (game_missile0_y > 0) { game_missile0_y -= 1; } break;
         case SELECTED_MISSILE1: if (game_missile1_y > 0) { game_missile1_y -= 1; } break;
         case SELECTED_BALL:     if (game_ball_y > 0)     { game_ball_y -= 1; } break;
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         switch (selected_object) {
            case SELECTED_PLAYER0:  if (game_player0_y < OBJECT_MAX_Y)  { game_player0_y += 1; } break;
            case SELECTED_PLAYER1:  if (game_player1_y < OBJECT_MAX_Y)  { game_player1_y += 1; } break;
            case SELECTED_MISSILE0: if (game_missile0_y < OBJECT_MAX_Y) { game_missile0_y += 1; } break;
            case SELECTED_MISSILE1: if (game_missile1_y < OBJECT_MAX_Y) { game_missile1_y += 1; } break;
            case SELECTED_BALL:     if (game_ball_y < OBJECT_MAX_Y)     { game_ball_y += 1; } break;
         }
      }
   }
}

inline void update_controls(void) {
   // Keep the console Reset path scratch-free; the renderer's hidden
   // assembly helper stack now consumes the bytes previously borrowed here.
   asm lda SWCHB;
   asm and #$01;
   asm bne @reset_not_pressed;
   asm jmp ($fffc);
   asm @reset_not_pressed:;
   update_object_selection();
   move_selected_object();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   COLUBK := VCS_NTSC_MEDIUM_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;

   game_PLAYER0_X := 20;
   game_PLAYER1_X := 130;
   game_MISSILE0_X := 50;
   game_MISSILE1_X := 110;
   game_BALL_X := 80;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;

   game_player0_y := 18;
   game_player1_y := 78;
   game_missile0_y := 34;
   game_missile1_y := 62;
   game_ball_y := 48;

   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 5;
   game_missile1_height := 7;
   game_ball_height := 3;
   game_player0_color := VCS_NTSC_SKY_BLUE;
   game_player1_color := VCS_NTSC_ORCHID;
   game_playfield_position := 8;

   game_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
