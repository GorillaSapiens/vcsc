// Atari JANE PASS/FAIL diagnostic.
// Exercises the complete 4x4 ordered source/destination C-call matrix. Same-bank
// calls use ordinary JSR/RTS; each cross-bank call uses JANE's fixed inline-target
// bankcall block and verifies exact return-bank restoration, return value, and
// hardware-stack balance. One nested bank0 -> bank1 call proves stacked logical
// return PCs compose correctly.
include "JANE/mapper.c26"

#ifndef SIMULATOR_TEST
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"
instantiate "six_glyph_big_wide_component.c26" as status_result
instantiate "six_glyph_component.c26" as cart_type (compact_font:=0)
#endif

uint8_t failure;
uint8_t signature;
uint8_t source_seen;
uint8_t current_source;
uint8_t current_destination;
uint8_t call_count;
uint16_t call_return;
uint8_t nested_count;
uint8_t stack_before;
uint8_t stack_after;

// Stella's current 16K JANE detector looks for LDA $FFF1; RTS. Keep that exact
// byte sequence as inert data so the diagnostic autodetects without coupling
// program control flow to a detector signature.
bank1 const uint8_t jane_stella_signature[4] := { 0xAD, 0xF1, 0xFF, 0x60 };

#ifndef SIMULATOR_TEST
include "status_font.c26"

include "cart_type_font.c26"

inline void load_pass(void) {
   asm lda #<{status_glyphs + 0};   asm sta status_result_pointers+0;
   asm lda #>{status_glyphs + 0};   asm sta status_result_pointers+1;
   asm lda #<{status_glyphs + 16};  asm sta status_result_pointers+2;
   asm lda #>{status_glyphs + 16};  asm sta status_result_pointers+3;
   asm lda #<{status_glyphs + 32};  asm sta status_result_pointers+4;
   asm lda #>{status_glyphs + 32};  asm sta status_result_pointers+5;
   asm lda #<{status_glyphs + 48};  asm sta status_result_pointers+6;
   asm lda #>{status_glyphs + 48};  asm sta status_result_pointers+7;
   asm lda #<{status_glyphs + 48};  asm sta status_result_pointers+8;
   asm lda #>{status_glyphs + 48};  asm sta status_result_pointers+9;
   asm lda #<{status_glyphs + 0};   asm sta status_result_pointers+10;
   asm lda #>{status_glyphs + 0};   asm sta status_result_pointers+11;
}

inline void load_fail(void) {
   asm lda #<{status_glyphs + 0};    asm sta status_result_pointers+0;
   asm lda #>{status_glyphs + 0};    asm sta status_result_pointers+1;
   asm lda #<{status_glyphs + 64};   asm sta status_result_pointers+2;
   asm lda #>{status_glyphs + 64};   asm sta status_result_pointers+3;
   asm lda #<{status_glyphs + 80};   asm sta status_result_pointers+4;
   asm lda #>{status_glyphs + 80};   asm sta status_result_pointers+5;
   asm lda #<{status_glyphs + 96};   asm sta status_result_pointers+6;
   asm lda #>{status_glyphs + 96};   asm sta status_result_pointers+7;
   asm lda #<{status_glyphs + 112};  asm sta status_result_pointers+8;
   asm lda #>{status_glyphs + 112};  asm sta status_result_pointers+9;
   asm lda #<{status_glyphs + 0};    asm sta status_result_pointers+10;
   asm lda #>{status_glyphs + 0};    asm sta status_result_pointers+11;
}

inline void load_jane(void) {
   // " JANE "
   asm lda #<{cart_type_glyphs + 0};  asm sta cart_type_pointers+0;
   asm lda #>{cart_type_glyphs + 0};  asm sta cart_type_pointers+1;
   asm lda #<{cart_type_glyphs + 8};  asm sta cart_type_pointers+2;
   asm lda #>{cart_type_glyphs + 8};  asm sta cart_type_pointers+3;
   asm lda #<{cart_type_glyphs + 16}; asm sta cart_type_pointers+4;
   asm lda #>{cart_type_glyphs + 16}; asm sta cart_type_pointers+5;
   asm lda #<{cart_type_glyphs + 24}; asm sta cart_type_pointers+6;
   asm lda #>{cart_type_glyphs + 24}; asm sta cart_type_pointers+7;
   asm lda #<{cart_type_glyphs + 32}; asm sta cart_type_pointers+8;
   asm lda #>{cart_type_glyphs + 32}; asm sta cart_type_pointers+9;
   asm lda #<{cart_type_glyphs + 0};  asm sta cart_type_pointers+10;
   asm lda #>{cart_type_glyphs + 0};  asm sta cart_type_pointers+11;
}

bank1 void draw_result(void) {
   status_result_score := 0;
   cart_type_score := 0;
   status_result_init();
   cart_type_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      status_result_vblank();
      cart_type_vblank();
      if (failure) { load_fail(); } else { load_pass(); }
      load_jane();
      COLUBK := failure ? 0x20 : 0xC4;
      status_result_color := 0x0e;
      COLUP0 := 0x0E;
      COLUP1 := 0x0E;
      PF0 := 0; PF1 := 0; PF2 := 0; GRP0 := 0; GRP1 := 0;
      ENAM0 := 0; ENAM1 := 0; ENABL := 0; CTRLPF := 0;
      vcs_ntsc_end_vblank();
      // 81 blank + 19 result + 11 mapper + 81 blank = 192 visible lines.
      vcs_ntsc_wait_component_scanlines(81);
      status_result_draw();
      vcs_ntsc_component_handoff();
      cart_type_draw();
      vcs_ntsc_wait_visible_tail_scanlines(81);
      vcs_ntsc_begin_overscan();
      status_result_overscan();
      cart_type_overscan();
      vcs_ntsc_end_overscan();
   }
}
#endif

#ifdef SIMULATOR_TEST
bank1 void simulator_done(void) { while (1) { } }
#endif

bank1 void nested_leaf1(void) {
   nested_count := nested_count + 1;
   signature := 0xA1;
}

bank0 uint16_t call_target0(void) {
   if (current_destination != 0 || source_seen != current_source) {
      failure := 0xD0;
   }
   // One nested cross-bank call proves that stacked logical return PCs compose.
   if (current_source == 0 && current_destination == 0) {
      nested_leaf1();
   }
   signature := 0x40;
   call_count := call_count + 1;
   return 0x5A40`uint16_t;
}

bank1 uint16_t call_target1(void) {
   if (current_destination != 1 || source_seen != current_source) {
      failure := 0xD1;
   }
   signature := 0x41;
   call_count := call_count + 1;
   return 0x5A41`uint16_t;
}

bank2 uint16_t call_target2(void) {
   if (current_destination != 2 || source_seen != current_source) {
      failure := 0xD2;
   }
   signature := 0x42;
   call_count := call_count + 1;
   return 0x5A42`uint16_t;
}

bank3 uint16_t call_target3(void) {
   if (current_destination != 3 || source_seen != current_source) {
      failure := 0xD3;
   }
   signature := 0x43;
   call_count := call_count + 1;
   return 0x5A43`uint16_t;
}

bank0 void source_entry0(void) {
   if (current_source != 0) { failure := 0xB0; }
   source_seen := 0;

   current_destination := 0;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target0();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A40`uint16_t || signature != 0x40 || stack_before != stack_after) {
      failure := 0xC0;
   }

   current_destination := 1;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target1();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A41`uint16_t || signature != 0x41 || stack_before != stack_after) {
      failure := 0xC0;
   }

   current_destination := 2;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target2();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A42`uint16_t || signature != 0x42 || stack_before != stack_after) {
      failure := 0xC0;
   }

   current_destination := 3;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target3();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A43`uint16_t || signature != 0x43 || stack_before != stack_after) {
      failure := 0xC0;
   }
}

bank1 void source_entry1(void) {
   if (current_source != 1) { failure := 0xB1; }
   source_seen := 1;

   current_destination := 0;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target0();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A40`uint16_t || signature != 0x40 || stack_before != stack_after) {
      failure := 0xC1;
   }

   current_destination := 1;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target1();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A41`uint16_t || signature != 0x41 || stack_before != stack_after) {
      failure := 0xC1;
   }

   current_destination := 2;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target2();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A42`uint16_t || signature != 0x42 || stack_before != stack_after) {
      failure := 0xC1;
   }

   current_destination := 3;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target3();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A43`uint16_t || signature != 0x43 || stack_before != stack_after) {
      failure := 0xC1;
   }
}

bank2 void source_entry2(void) {
   if (current_source != 2) { failure := 0xB2; }
   source_seen := 2;

   current_destination := 0;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target0();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A40`uint16_t || signature != 0x40 || stack_before != stack_after) {
      failure := 0xC2;
   }

   current_destination := 1;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target1();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A41`uint16_t || signature != 0x41 || stack_before != stack_after) {
      failure := 0xC2;
   }

   current_destination := 2;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target2();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A42`uint16_t || signature != 0x42 || stack_before != stack_after) {
      failure := 0xC2;
   }

   current_destination := 3;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target3();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A43`uint16_t || signature != 0x43 || stack_before != stack_after) {
      failure := 0xC2;
   }
}

bank3 void source_entry3(void) {
   if (current_source != 3) { failure := 0xB3; }
   source_seen := 3;

   current_destination := 0;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target0();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A40`uint16_t || signature != 0x40 || stack_before != stack_after) {
      failure := 0xC3;
   }

   current_destination := 1;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target1();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A41`uint16_t || signature != 0x41 || stack_before != stack_after) {
      failure := 0xC3;
   }

   current_destination := 2;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target2();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A42`uint16_t || signature != 0x42 || stack_before != stack_after) {
      failure := 0xC3;
   }

   current_destination := 3;
   signature := 0;
   asm tsx; asm stx stack_before;
   call_return := call_target3();
   asm tsx; asm stx stack_after;
   if (call_return != 0x5A43`uint16_t || signature != 0x43 || stack_before != stack_after) {
      failure := 0xC3;
   }
}

bank1 void run_matrix(void) {
   // Complete ordered source/destination matrix: each bank calls all four banks.
   // Keep this sequencer explicitly in startup bank1 so calls to bank-pinned
   // source routines use the inline-target ABI rather than legacy JSR bridges.
   current_source := 0; source_entry0();
   current_source := 1; source_entry1();
   current_source := 2; source_entry2();
   current_source := 3; source_entry3();

   if (call_count != 16 || nested_count != 1 || source_seen != 3 ||
       current_destination != 3 || signature != 0x43 || stack_before != stack_after) {
      failure := 0xFE;
   }
#ifdef SIMULATOR_TEST
   asm jmp simulator_done;
#else
   draw_result();
#endif
}

void main(void) {
   // Hardware reset must recover physical/logical startup bank 1.
   failure := 0;
   signature := 0;
   source_seen := 0xFF;
   current_source := 0;
   current_destination := 0;
   call_count := 0;
   call_return := 0;
   nested_count := 0;
   stack_before := 0;
   stack_after := 0;

   if (jane_stella_signature[0] != 0xAD || jane_stella_signature[1] != 0xF1 ||
       jane_stella_signature[2] != 0xFF || jane_stella_signature[3] != 0x60) {
      failure := 0x01;
   }

   run_matrix();
}
