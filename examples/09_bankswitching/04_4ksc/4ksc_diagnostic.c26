// Atari 2600 4KSC PASS/FAIL diagnostic.
// Exercises all 128 bytes of shared Superchip RAM, verifies normal BSS/DATA
// startup treatment through the split write/read aliases, and leaves a stable
// green PASS / 4KSC display (dark-red FAIL on error).

include "vcs_4k_sc.c26"

#ifndef SIMULATOR_TEST
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"
instantiate "six_glyph_big_wide_component.c26" as status_result
instantiate "six_glyph_component.c26" as cart_type (compact_font:=0)
#endif

// Occupy the complete 128-byte Superchip device: one initialized byte plus
// 127 BSS bytes. Startup must copy/zero through $F000-$F07F while ordinary
// reads use $F080-$F0FF.
superchip uint8_t sc_data := 0x5A;
superchip uint8_t sc_bss[127];

uint8_t failure;
uint8_t index;

#ifndef SIMULATOR_TEST
// Exact glyph subsets copied from the canonical ASCII fonts.
// Big table order: space, p, a, s, F, A, I, L.
// Small table order: space, 4, K, S, C.
alias SC4_GLYPH(a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p) p,o,n,m,l,k,j,i,h,g,f,e,d,c,b,a
alias SC4_SMALL_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
page const uint8_t status_glyphs[128] := {
   SC4_GLYPH(0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........),
   SC4_GLYPH(0b........,0b........,0b........,0b........,0b........,0bXXXXXXX.,0bXXXXXXXX,0bXXX..XXX,0bXXX..XXX,0bXXX..XXX,0bXXXXXXXX,0bXXXXXXX.,0bXXX.....,0bXXX.....,0bXXX.....,0b........),
   SC4_GLYPH(0b........,0b........,0b........,0b........,0b........,0b..XXXXX.,0b.XXXXXXX,0b.....XXX,0b.XXXXXXX,0bXXX..XXX,0bXXXXXXXX,0b.XXXXXXX,0b........,0b........,0b........,0b........),
   SC4_GLYPH(0b........,0b........,0b........,0b........,0b........,0b.XXXXXX.,0bXXXXXXXX,0bXXXX....,0b.XXXXXX.,0b....XXXX,0bXXXXXXXX,0b.XXXXXX.,0b........,0b........,0b........,0b........),
   SC4_GLYPH(0b........,0b........,0bXXXXXXXX,0bXXXXXXXX,0bXXX.....,0bXXX.....,0bXXXXXX..,0bXXXXXX..,0bXXX.....,0bXXX.....,0bXXX.....,0bXXX.....,0b........,0b........,0b........,0b........),
   SC4_GLYPH(0b........,0b........,0b...XX...,0b..XXXX..,0b..XXXX..,0b.XXXXXX.,0b.XX..XX.,0bXXX..XXX,0bXXXXXXXX,0bXXXXXXXX,0bXXX..XXX,0bXXX..XXX,0b........,0b........,0b........,0b........),
   SC4_GLYPH(0b........,0b........,0b.XXXXX..,0b.XXXXX..,0b..XXX...,0b..XXX...,0b..XXX...,0b..XXX...,0b..XXX...,0b..XXX...,0b.XXXXX..,0b.XXXXX..,0b........,0b........,0b........,0b........),
   SC4_GLYPH(0b........,0b........,0bXXX.....,0bXXX.....,0bXXX.....,0bXXX.....,0bXXX.....,0bXXX.....,0bXXX.....,0bXXX.....,0bXXXXXXXX,0bXXXXXXXX,0b........,0b........,0b........,0b........)
};

page const uint8_t cart_type_glyphs[40] := {
   // space -- exact default_ascii.c26 0x20
   SC4_SMALL_GLYPH(0b........,0b........,0b........,0b........,0b........,0b........,0b........,0b........),
   // 4 -- exact default_ascii.c26 0x34
   SC4_SMALL_GLYPH(0b....XX..,0b...XXX..,0b..X.XX..,0b.X..XX..,0b.X..XX..,0b.XXXXXX.,0b....XX..,0b....XX..),
   // K -- exact default_ascii.c26 0x4B
   SC4_SMALL_GLYPH(0b.XX..XX.,0b.XX.XX..,0b.XXXX...,0b.XXX....,0b.XXXX...,0b.XX.XX..,0b.XX..XX.,0b.XX..XX.),
   // S -- exact default_ascii.c26 0x53
   SC4_SMALL_GLYPH(0b..XXXX..,0b.XX..XX.,0b.XX.....,0b..XXXX..,0b.....XX.,0b.....XX.,0b.XX..XX.,0b..XXXX..),
   // C -- exact default_ascii.c26 0x43
   SC4_SMALL_GLYPH(0b..XXXX..,0b.XX..XX.,0b.XX.....,0b.XX.....,0b.XX.....,0b.XX.....,0b.XX..XX.,0b..XXXX..)
};

inline void load_pass(void) {
   asm lda #<{status_glyphs + 0};   asm sta status_result_pointers+0;
   asm lda #>{status_glyphs + 0};   asm sta status_result_pointers+1;
   asm lda #<{status_glyphs + 16};  asm sta status_result_pointers+2;
   asm lda #>{status_glyphs + 16};  asm sta status_result_pointers+3;
   asm lda #<{status_glyphs + 32};  asm sta status_result_pointers+4;
   asm lda #>{status_glyphs + 32};  asm sta status_result_pointers+5;
   asm lda #<{status_glyphs + 48};  asm sta status_result_pointers+6;
   asm lda #>{status_glyphs + 48};  asm sta status_result_pointers+7;
   asm lda #<{status_glyphs + 48};  asm sta status_result_pointers+8;
   asm lda #>{status_glyphs + 48};  asm sta status_result_pointers+9;
   asm lda #<{status_glyphs + 0};   asm sta status_result_pointers+10;
   asm lda #>{status_glyphs + 0};   asm sta status_result_pointers+11;
}

inline void load_fail(void) {
   asm lda #<{status_glyphs + 0};    asm sta status_result_pointers+0;
   asm lda #>{status_glyphs + 0};    asm sta status_result_pointers+1;
   asm lda #<{status_glyphs + 64};   asm sta status_result_pointers+2;
   asm lda #>{status_glyphs + 64};   asm sta status_result_pointers+3;
   asm lda #<{status_glyphs + 80};   asm sta status_result_pointers+4;
   asm lda #>{status_glyphs + 80};   asm sta status_result_pointers+5;
   asm lda #<{status_glyphs + 96};   asm sta status_result_pointers+6;
   asm lda #>{status_glyphs + 96};   asm sta status_result_pointers+7;
   asm lda #<{status_glyphs + 112};  asm sta status_result_pointers+8;
   asm lda #>{status_glyphs + 112};  asm sta status_result_pointers+9;
   asm lda #<{status_glyphs + 0};    asm sta status_result_pointers+10;
   asm lda #>{status_glyphs + 0};    asm sta status_result_pointers+11;
}

inline void load_4ksc_type(void) {
   // blank / 4 / K / S / C / blank
   asm lda #<{cart_type_glyphs + 0};  asm sta cart_type_pointers+0;
   asm lda #>{cart_type_glyphs + 0};  asm sta cart_type_pointers+1;
   asm lda #<{cart_type_glyphs + 8};  asm sta cart_type_pointers+2;
   asm lda #>{cart_type_glyphs + 8};  asm sta cart_type_pointers+3;
   asm lda #<{cart_type_glyphs + 16}; asm sta cart_type_pointers+4;
   asm lda #>{cart_type_glyphs + 16}; asm sta cart_type_pointers+5;
   asm lda #<{cart_type_glyphs + 24}; asm sta cart_type_pointers+6;
   asm lda #>{cart_type_glyphs + 24}; asm sta cart_type_pointers+7;
   asm lda #<{cart_type_glyphs + 32}; asm sta cart_type_pointers+8;
   asm lda #>{cart_type_glyphs + 32}; asm sta cart_type_pointers+9;
   asm lda #<{cart_type_glyphs + 0};  asm sta cart_type_pointers+10;
   asm lda #>{cart_type_glyphs + 0};  asm sta cart_type_pointers+11;
}

void draw_result(void) {
   status_result_score := 0;
   cart_type_score := 0;
   status_result_init();
   cart_type_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      status_result_vblank();
      cart_type_vblank();
      if (failure) { load_fail(); } else { load_pass(); }
      load_4ksc_type();
      status_result_color := 0x0E;
      COLUBK := failure ? 0x20 : 0xC4;
      COLUP0 := 0x0E;
      COLUP1 := 0x0E;
      PF0 := 0; PF1 := 0; PF2 := 0; GRP0 := 0; GRP1 := 0;
      ENAM0 := 0; ENAM1 := 0; ENABL := 0; CTRLPF := 0;
      vcs_ntsc_end_vblank();
      // 81 blank + 19 result + 11 mapper line + 81 blank = 192 visible.
      vcs_ntsc_wait_component_scanlines(81);
      status_result_draw();
      vcs_ntsc_component_handoff();
      cart_type_draw();
      vcs_ntsc_wait_visible_tail_scanlines(81);
      vcs_ntsc_begin_overscan();
      status_result_overscan();
      cart_type_overscan();
      vcs_ntsc_end_overscan();
   }
}
#endif

#ifdef SIMULATOR_TEST
void simulator_done(void) {
   while (1) { }
}
#endif

void main(void) {
   if (sc_data != 0x5A) {
      failure := 0x01;
   }
   index := 0;
   while (index != 127) {
      if (sc_bss[index] != 0) {
         failure := 0x02;
      }
      index := index + 1;
   }

   // Prove split-address read/write behavior at both ends and the middle of RAM.
   sc_data := 0xA5;
   sc_bss[0] := 0x11;
   sc_bss[63] := 0x22;
   sc_bss[126] := 0x33;
   if (sc_data != 0xA5 || sc_bss[0] != 0x11 || sc_bss[63] != 0x22 ||
       sc_bss[126] != 0x33) {
      failure := 0x03;
   }

#ifdef SIMULATOR_TEST
   asm jmp simulator_done;
#else
   draw_result();
#endif
}
