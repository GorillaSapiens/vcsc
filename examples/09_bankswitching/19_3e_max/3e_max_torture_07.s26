bank252_restored:
    inc expected_dest
    lda expected_dest
    cmp #$FF
    beq.same bank252_source_done
    dec step_remaining
    bne.same bank252_dest_loop
    jmp bank252_step_done
bank252_source_done:
    lda ram_lfsr
    sta bankcall_stub+3
    lda ram_lfsr+1
    sta bankcall_stub+4
    lda #$ff
    sta bankcall_stub+5
    jsr bankcall_stub
    lda #<$1100
    sta bankcall_stub+3
    lda #>$1100
    sta bankcall_stub+4
    lda #$FC
    cmp expected_source
    beq.same bank252_fixed_restored
    lda #$03
    sta failure
