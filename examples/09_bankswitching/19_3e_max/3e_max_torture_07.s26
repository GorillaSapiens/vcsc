bank252_step_done:
    tsx
    cpx source_sp
    beq.same bank252_source_stack_ok
    lda #$04
    sta failure
bank252_source_stack_ok:
    rts
    .align 256
bank252_target:
    lda expected_dest
    cmp #$FC
    beq.same bank252_target_ok
    lda #$01
