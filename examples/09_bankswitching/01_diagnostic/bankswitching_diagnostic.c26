// F8/F6/F4 bank-transition diagnostic example.
//
// One visible build exercises the complete ordered source/destination matrix
// twice: first through ordinary C calls (same-bank JSR/RTS or the generic
// cross-bank JSR + inline-target path), then through direct cross-bank JMPs.
// The call matrix checks exact return-bank restoration and hardware-stack
// balance for every ordered pair; one nested call additionally proves that
// stacked logical return PCs compose correctly.  RIOT-RAM signatures and
// transition counts are checked before
// the cartridge settles on a stable
// green lowercase pass or dark-red uppercase FAIL frame, with a second cart-type line, for emulator certification.

#ifndef MAPPER_BANKS
MAPPER_BANKS_must_be_2_4_or_8
#endif


#ifdef SUPERCHIP_TEST
#if MAPPER_BANKS == 2
include "vcs_8k_f8sc.c26"
#elif MAPPER_BANKS == 4
include "vcs_16k_f6sc.c26"
#elif MAPPER_BANKS == 8
include "vcs_32k_f4sc.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#else
#if MAPPER_BANKS == 2
include "vcs_8k_f8.c26"
#elif MAPPER_BANKS == 4
include "vcs_16k_f6.c26"
#elif MAPPER_BANKS == 8
include "vcs_32k_f4.c26"
#else
MAPPER_BANKS_must_be_2_4_or_8
#endif
#endif

#ifndef SIMULATOR_TEST
include "frame_ntsc.c26"
// Both display components require a score_font symbol for their normal
// lifecycle pointer preparation. The diagnostic replaces those pointers with
// its two exact ASCII subset tables during VBLANK before either becomes visible.
include "fonts/default_decimal.c26"
instantiate "six_glyph_big_wide_component.c26" as status_result
instantiate "six_glyph_component.c26" as cart_type (compact_font:=0)
#endif

#ifdef SUPERCHIP_TEST
// Own the complete region with both BSS and DATA objects. Stock reset/startup
// must clear every BSS byte and copy every DATA byte through the write window.
// The diagnostic later poisons these objects before entering its result loop;
// an emulator or console RESET must restore them before main runs again.
cartram uint8_t diagnostic_superchip_bss_head;
cartram uint8_t diagnostic_superchip_data_head := 0x5A;
cartram uint8_t diagnostic_superchip_count;
cartram uint8_t diagnostic_superchip_bss[124];
cartram uint8_t diagnostic_superchip_data_tail := 0xA5;
#endif

uint8_t failure;
uint8_t signature;
uint8_t source_seen;
uint8_t current_source;
uint8_t current_destination;
uint8_t call_count;
uint16_t call_return;
uint8_t transition_count;
uint8_t nested_count;
uint8_t status_color;
uint8_t stack_before;
uint8_t stack_after;
#ifdef SUPERCHIP_TEST
uint8_t diagnostic_superchip_index;
#endif

#ifndef SIMULATOR_TEST
// Checked-in generated subsets of the canonical ASCII fonts.  `make fonts`
// regenerates them; ordinary example builds do not require Perl.
include "status_font.c26"
include "cart_type_font.c26"

inline void load_status_pass(void) {
   asm lda #<{status_big_glyphs + 0};
   asm sta status_result_pointers+0;
   asm lda #>{status_big_glyphs + 0};
   asm sta status_result_pointers+1;
   asm lda #<{status_big_glyphs + 16};
   asm sta status_result_pointers+2;
   asm lda #>{status_big_glyphs + 16};
   asm sta status_result_pointers+3;
   asm lda #<{status_big_glyphs + 32};
   asm sta status_result_pointers+4;
   asm lda #>{status_big_glyphs + 32};
   asm sta status_result_pointers+5;
   asm lda #<{status_big_glyphs + 48};
   asm sta status_result_pointers+6;
   asm lda #>{status_big_glyphs + 48};
   asm sta status_result_pointers+7;
   asm lda #<{status_big_glyphs + 48};
   asm sta status_result_pointers+8;
   asm lda #>{status_big_glyphs + 48};
   asm sta status_result_pointers+9;
   asm lda #<{status_big_glyphs + 0};
   asm sta status_result_pointers+10;
   asm lda #>{status_big_glyphs + 0};
   asm sta status_result_pointers+11;
   status_result_color := 0x0e;
}

inline void load_status_fail(void) {
   asm lda #<{status_big_glyphs + 0};
   asm sta status_result_pointers+0;
   asm lda #>{status_big_glyphs + 0};
   asm sta status_result_pointers+1;
   asm lda #<{status_big_glyphs + 64};
   asm sta status_result_pointers+2;
   asm lda #>{status_big_glyphs + 64};
   asm sta status_result_pointers+3;
   asm lda #<{status_big_glyphs + 80};
   asm sta status_result_pointers+4;
   asm lda #>{status_big_glyphs + 80};
   asm sta status_result_pointers+5;
   asm lda #<{status_big_glyphs + 96};
   asm sta status_result_pointers+6;
   asm lda #>{status_big_glyphs + 96};
   asm sta status_result_pointers+7;
   asm lda #<{status_big_glyphs + 112};
   asm sta status_result_pointers+8;
   asm lda #>{status_big_glyphs + 112};
   asm sta status_result_pointers+9;
   asm lda #<{status_big_glyphs + 0};
   asm sta status_result_pointers+10;
   asm lda #>{status_big_glyphs + 0};
   asm sta status_result_pointers+11;
   status_result_color := 0x0e;
}

inline void load_cart_type(void) {
#ifdef POISONED_RESULT
   // The poison diagnostic deliberately withholds its mapper identity.
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+0;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+1;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+2;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+3;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+5;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+7;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+8;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+9;
   asm lda #<{status_small_glyphs + 56};
   asm sta cart_type_pointers+10;
   asm lda #>{status_small_glyphs + 56};
   asm sta cart_type_pointers+11;
#else
#ifdef SUPERCHIP_TEST
   // blank / F / mapper-digit / S / C / blank
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+0;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+1;
   asm lda #<{status_small_glyphs + 8};
   asm sta cart_type_pointers+2;
   asm lda #>{status_small_glyphs + 8};
   asm sta cart_type_pointers+3;
#if MAPPER_BANKS == 2
   asm lda #<{status_small_glyphs + 32};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 32};
   asm sta cart_type_pointers+5;
#elif MAPPER_BANKS == 4
   asm lda #<{status_small_glyphs + 24};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 24};
   asm sta cart_type_pointers+5;
#elif MAPPER_BANKS == 8
   asm lda #<{status_small_glyphs + 16};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 16};
   asm sta cart_type_pointers+5;
#endif
   asm lda #<{status_small_glyphs + 40};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 40};
   asm sta cart_type_pointers+7;
   asm lda #<{status_small_glyphs + 48};
   asm sta cart_type_pointers+8;
   asm lda #>{status_small_glyphs + 48};
   asm sta cart_type_pointers+9;
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+10;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+11;
#else
   // blank / blank / F / mapper-digit / blank / blank
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+0;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+1;
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+2;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+3;
   asm lda #<{status_small_glyphs + 8};
   asm sta cart_type_pointers+4;
   asm lda #>{status_small_glyphs + 8};
   asm sta cart_type_pointers+5;
#if MAPPER_BANKS == 2
   asm lda #<{status_small_glyphs + 32};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 32};
   asm sta cart_type_pointers+7;
#elif MAPPER_BANKS == 4
   asm lda #<{status_small_glyphs + 24};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 24};
   asm sta cart_type_pointers+7;
#elif MAPPER_BANKS == 8
   asm lda #<{status_small_glyphs + 16};
   asm sta cart_type_pointers+6;
   asm lda #>{status_small_glyphs + 16};
   asm sta cart_type_pointers+7;
#endif
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+8;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+9;
   asm lda #<{status_small_glyphs + 0};
   asm sta cart_type_pointers+10;
   asm lda #>{status_small_glyphs + 0};
   asm sta cart_type_pointers+11;
#endif
#endif
}

bank0 void draw_status_frame(void) {
   // Exercise both component lifecycles normally. Their decimal preparation is
   // immediately replaced with the exact ASCII subset pointers during VBLANK.
   status_result_score := 0;
   cart_type_score := 0;
   status_result_init();
   cart_type_init();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      status_result_vblank();
      cart_type_vblank();
      if (failure) {
         load_status_fail();
      }
      else {
         load_status_pass();
      }
      load_cart_type();

      COLUP0 := 0x0e;
      COLUP1 := 0x0e;
      if (failure) {
         COLUBK := 0x20;
      }
      else {
         COLUBK := status_color;
      }
      PF0 := 0;
      PF1 := 0;
      PF2 := 0;
      GRP0 := 0;
      GRP1 := 0;
      ENAM0 := 0;
      ENAM1 := 0;
      ENABL := 0;
      CTRLPF := 0;

      vcs_ntsc_end_vblank();

      // Center the combined 30-line result block in the 192-line visible field:
      // 81 blank + 19 big result + 11 cart type + 81 blank = 192.
      vcs_ntsc_wait_component_scanlines(81);
      status_result_draw();
      vcs_ntsc_component_handoff();
      cart_type_draw();
      vcs_ntsc_wait_visible_tail_scanlines(81);

      vcs_ntsc_begin_overscan();
      status_result_overscan();
      cart_type_overscan();
      vcs_ntsc_end_overscan();
   }
}
#endif

#ifdef SIMULATOR_TEST
bank0 void simulator_done(void) {
   while (1) {
   }
}
#endif

bank1 void nested_leaf1(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD1;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   nested_count := nested_count + 1;
   signature := 0xA1;
}

bank0 uint16_t call_target0(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD0;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   if (current_source == 0 && current_destination == 0) {
      nested_leaf1();
   }
   signature := 0x40;
   call_count := call_count + 1;
   return 0x5A40`uint16_t;
}

bank0 void jump_target0(void) {
#ifdef SUPERCHIP_TEST
   if (diagnostic_superchip_data_head != 0x5A || diagnostic_superchip_data_tail != 0xA5) {
      failure := 0xD0;
   }
   diagnostic_superchip_count := diagnostic_superchip_count + 1;
#endif
   asm tsx;
   asm stx stack_after;
   if (current_destination != 0 || source_seen != current_source ||
       stack_before != stack_after) {
      failure := 0xE0;
   }
   signature := 0x80;
   transition_count := transition_count + 1;
   status_color := 0x82;
   asm jmp advance_transition;
}

