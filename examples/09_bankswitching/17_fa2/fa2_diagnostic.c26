   call_count := call_count + 1;
   return 0x5A45`uint16_t;
}

bank6 uint16_t bank6_probe(void) {
   if (current_source > 6 || current_destination != 6 ||
       fa2_data != 0xA5 || fa2_bss[0] != 0x11 ||
       fa2_bss[127] != 0x22 || fa2_bss[254] != 0x33) {
      failure := 0x76;
   }
   call_count := call_count + 1;
   return 0x5A46`uint16_t;
}

bank0 void bank0_source(void) {
   current_source := 0;

   current_destination := 0;
   if (bank0_probe() != 0x5A40`uint16_t) { failure := 0x00; }
   current_destination := 1;
   if (bank1_probe() != 0x5A41`uint16_t) { failure := 0x01; }
   current_destination := 2;
   if (bank2_probe() != 0x5A42`uint16_t) { failure := 0x02; }
   current_destination := 3;
   if (bank3_probe() != 0x5A43`uint16_t) { failure := 0x03; }
   current_destination := 4;
   if (bank4_probe() != 0x5A44`uint16_t) { failure := 0x04; }
   current_destination := 5;
   if (bank5_probe() != 0x5A45`uint16_t) { failure := 0x05; }
   current_destination := 6;
   if (bank6_probe() != 0x5A46`uint16_t) { failure := 0x06; }
}

bank1 void bank1_source(void) {
   current_source := 1;

   current_destination := 0;
   if (bank0_probe() != 0x5A40`uint16_t) { failure := 0x10; }
   current_destination := 1;
   if (bank1_probe() != 0x5A41`uint16_t) { failure := 0x11; }
   current_destination := 2;
   if (bank2_probe() != 0x5A42`uint16_t) { failure := 0x12; }
   current_destination := 3;
   if (bank3_probe() != 0x5A43`uint16_t) { failure := 0x13; }
   current_destination := 4;
   if (bank4_probe() != 0x5A44`uint16_t) { failure := 0x14; }
   current_destination := 5;
   if (bank5_probe() != 0x5A45`uint16_t) { failure := 0x15; }
   current_destination := 6;
   if (bank6_probe() != 0x5A46`uint16_t) { failure := 0x16; }
}

bank2 void bank2_source(void) {
   current_source := 2;

   current_destination := 0;
   if (bank0_probe() != 0x5A40`uint16_t) { failure := 0x20; }
   current_destination := 1;
   if (bank1_probe() != 0x5A41`uint16_t) { failure := 0x21; }
   current_destination := 2;
   if (bank2_probe() != 0x5A42`uint16_t) { failure := 0x22; }
   current_destination := 3;
   if (bank3_probe() != 0x5A43`uint16_t) { failure := 0x23; }
   current_destination := 4;
   if (bank4_probe() != 0x5A44`uint16_t) { failure := 0x24; }
   current_destination := 5;
   if (bank5_probe() != 0x5A45`uint16_t) { failure := 0x25; }
   current_destination := 6;
   if (bank6_probe() != 0x5A46`uint16_t) { failure := 0x26; }
}

bank3 void bank3_source(void) {
   current_source := 3;

   current_destination := 0;
   if (bank0_probe() != 0x5A40`uint16_t) { failure := 0x30; }
   current_destination := 1;
   if (bank1_probe() != 0x5A41`uint16_t) { failure := 0x31; }
   current_destination := 2;
   if (bank2_probe() != 0x5A42`uint16_t) { failure := 0x32; }
   current_destination := 3;
   if (bank3_probe() != 0x5A43`uint16_t) { failure := 0x33; }
   current_destination := 4;
   if (bank4_probe() != 0x5A44`uint16_t) { failure := 0x34; }
   current_destination := 5;
   if (bank5_probe() != 0x5A45`uint16_t) { failure := 0x35; }
   current_destination := 6;
   if (bank6_probe() != 0x5A46`uint16_t) { failure := 0x36; }
}

bank4 void bank4_source(void) {
   current_source := 4;

   current_destination := 0;
   if (bank0_probe() != 0x5A40`uint16_t) { failure := 0x40; }
   current_destination := 1;
   if (bank1_probe() != 0x5A41`uint16_t) { failure := 0x41; }
   current_destination := 2;
   if (bank2_probe() != 0x5A42`uint16_t) { failure := 0x42; }
   current_destination := 3;
   if (bank3_probe() != 0x5A43`uint16_t) { failure := 0x43; }
   current_destination := 4;
   if (bank4_probe() != 0x5A44`uint16_t) { failure := 0x44; }
   current_destination := 5;
   if (bank5_probe() != 0x5A45`uint16_t) { failure := 0x45; }
   current_destination := 6;
   if (bank6_probe() != 0x5A46`uint16_t) { failure := 0x46; }
}

bank5 void bank5_source(void) {
   current_source := 5;

   current_destination := 0;
   if (bank0_probe() != 0x5A40`uint16_t) { failure := 0x50; }
   current_destination := 1;
   if (bank1_probe() != 0x5A41`uint16_t) { failure := 0x51; }
   current_destination := 2;
   if (bank2_probe() != 0x5A42`uint16_t) { failure := 0x52; }
   current_destination := 3;
   if (bank3_probe() != 0x5A43`uint16_t) { failure := 0x53; }
   current_destination := 4;
   if (bank4_probe() != 0x5A44`uint16_t) { failure := 0x54; }
   current_destination := 5;
   if (bank5_probe() != 0x5A45`uint16_t) { failure := 0x55; }
   current_destination := 6;
   if (bank6_probe() != 0x5A46`uint16_t) { failure := 0x56; }
}

bank6 void bank6_source(void) {
   current_source := 6;

   current_destination := 0;
   if (bank0_probe() != 0x5A40`uint16_t) { failure := 0x60; }
   current_destination := 1;
   if (bank1_probe() != 0x5A41`uint16_t) { failure := 0x61; }
   current_destination := 2;
   if (bank2_probe() != 0x5A42`uint16_t) { failure := 0x62; }
   current_destination := 3;
   if (bank3_probe() != 0x5A43`uint16_t) { failure := 0x63; }
   current_destination := 4;
   if (bank4_probe() != 0x5A44`uint16_t) { failure := 0x64; }
   current_destination := 5;
   if (bank5_probe() != 0x5A45`uint16_t) { failure := 0x65; }
   current_destination := 6;
   if (bank6_probe() != 0x5A46`uint16_t) { failure := 0x66; }
}

bank0 void main(void) {
   // FA2 powers up in physical bank 0; the reset bridge must preserve that.
   if (fa2_data != 0x5A) { failure := 0x01; }
   index := 0;
   while (index != 255) {
      if (fa2_bss[index] != 0) { failure := 0x02; }
      index := index + 1;
   }

   fa2_data := 0xA5;
   fa2_bss[0] := 0x11;
   fa2_bss[127] := 0x22;
   fa2_bss[254] := 0x33;
   current_source := 0;
   current_destination := 0;
   call_count := 0;

   // Complete 7x7 ordered matrix.  Because each source routine is pinned to
   // its source bank, the diagonal calls compile as ordinary JSRs while every
   // off-diagonal leg uses the inline destination-descriptor ABI.
   bank0_source();
   bank1_source();
   bank2_source();
   bank3_source();
   bank4_source();
   bank5_source();
   bank6_source();

   if (call_count != 49 || fa2_data != 0xA5 ||
       fa2_bss[0] != 0x11 || fa2_bss[127] != 0x22 || fa2_bss[254] != 0x33) {
      failure := 0x03;
   }

#ifdef SIMULATOR_TEST
   asm jmp simulator_done;
#else
   draw_result();
#endif
}
