   if (probe0() != 0x40) { failure := 0x13; }
   if (probe1() != 0x41) { failure := 0x13; }
   if (probe2() != 0x42) { failure := 0x13; }
   if (probe3() != 0x43) { failure := 0x13; }
   if (probe4() != 0x44) { failure := 0x13; }
