// Amiga Power Play FC PASS/FAIL diagnostic. Eight banks exercise every
// ordered source/destination call pair, including same-bank direct JSRs.
instantiate "FC/mapper.c26" as mapper (VCS_FC_BANKS:=8)

#ifndef SIMULATOR_TEST
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"
instantiate "six_glyph_big_wide_component.c26" as status_result
instantiate "six_glyph_component.c26" as cart_type (compact_font:=0)
#endif

uint8_t failure;
uint8_t call_count;

bank0 uint8_t probe0(void) { call_count := call_count + 1; return 0x40; }
bank1 uint8_t probe1(void) { call_count := call_count + 1; return 0x41; }
bank2 uint8_t probe2(void) { call_count := call_count + 1; return 0x42; }
bank3 uint8_t probe3(void) { call_count := call_count + 1; return 0x43; }
bank4 uint8_t probe4(void) { call_count := call_count + 1; return 0x44; }
bank5 uint8_t probe5(void) { call_count := call_count + 1; return 0x45; }
bank6 uint8_t probe6(void) { call_count := call_count + 1; return 0x46; }
bank7 uint8_t probe7(void) { call_count := call_count + 1; return 0x47; }
bank7 uint16_t wide_probe(void) { return 0xbeef; }

bank0 void source0(void) {
   if (probe0() != 0x40) { failure := 0x10; }
   if (probe1() != 0x41) { failure := 0x10; }
   if (probe2() != 0x42) { failure := 0x10; }
   if (probe3() != 0x43) { failure := 0x10; }
   if (probe4() != 0x44) { failure := 0x10; }
   if (probe5() != 0x45) { failure := 0x10; }
   if (probe6() != 0x46) { failure := 0x10; }
   if (probe7() != 0x47) { failure := 0x10; }
}

bank1 void source1(void) {
   if (probe0() != 0x40) { failure := 0x11; }
   if (probe1() != 0x41) { failure := 0x11; }
   if (probe2() != 0x42) { failure := 0x11; }
   if (probe3() != 0x43) { failure := 0x11; }
   if (probe4() != 0x44) { failure := 0x11; }
   if (probe5() != 0x45) { failure := 0x11; }
   if (probe6() != 0x46) { failure := 0x11; }
   if (probe7() != 0x47) { failure := 0x11; }
}

