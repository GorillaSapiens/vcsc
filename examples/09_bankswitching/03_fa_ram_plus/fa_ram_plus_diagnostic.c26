// CBS FA / RAM Plus PASS/FAIL diagnostic.
// Exercises all three physical bank selectors through nested cross-bank calls,
// verifies the physical startup bank-2 reset bridge, and proves that all 256
// bytes of shared FA RAM receive normal BSS/DATA startup treatment and survive
// bank selection.

include "vcs_12k_fa.c26"

#ifndef SIMULATOR_TEST
include "frame_ntsc.c26"
include "fonts/default_decimal.c26"
instantiate "six_glyph_big_wide_component.c26" as status_result
instantiate "six_glyph_component.c26" as cart_type (compact_font:=0)
#endif

// Occupy the complete 256-byte FA RAM device: one initialized byte plus 255 BSS.
cartram uint8_t fa_data := 0x5A;
cartram uint8_t fa_bss[255];

uint8_t failure;
uint8_t trace;
uint8_t ram_count;
uint8_t index;

#ifndef SIMULATOR_TEST
include "status_font.c26"

include "cart_type_font.c26"

inline void load_pass(void) {
   asm lda #<{status_glyphs + 0};   asm sta status_result_pointers+0;
   asm lda #>{status_glyphs + 0};   asm sta status_result_pointers+1;
   asm lda #<{status_glyphs + 16};  asm sta status_result_pointers+2;
   asm lda #>{status_glyphs + 16};  asm sta status_result_pointers+3;
   asm lda #<{status_glyphs + 32};  asm sta status_result_pointers+4;
   asm lda #>{status_glyphs + 32};  asm sta status_result_pointers+5;
   asm lda #<{status_glyphs + 48};  asm sta status_result_pointers+6;
   asm lda #>{status_glyphs + 48};  asm sta status_result_pointers+7;
   asm lda #<{status_glyphs + 48};  asm sta status_result_pointers+8;
   asm lda #>{status_glyphs + 48};  asm sta status_result_pointers+9;
   asm lda #<{status_glyphs + 0};   asm sta status_result_pointers+10;
   asm lda #>{status_glyphs + 0};   asm sta status_result_pointers+11;
}

inline void load_fail(void) {
   asm lda #<{status_glyphs + 0};    asm sta status_result_pointers+0;
   asm lda #>{status_glyphs + 0};    asm sta status_result_pointers+1;
   asm lda #<{status_glyphs + 64};   asm sta status_result_pointers+2;
   asm lda #>{status_glyphs + 64};   asm sta status_result_pointers+3;
   asm lda #<{status_glyphs + 80};   asm sta status_result_pointers+4;
   asm lda #>{status_glyphs + 80};   asm sta status_result_pointers+5;
   asm lda #<{status_glyphs + 96};   asm sta status_result_pointers+6;
   asm lda #>{status_glyphs + 96};   asm sta status_result_pointers+7;
   asm lda #<{status_glyphs + 112};  asm sta status_result_pointers+8;
   asm lda #>{status_glyphs + 112};  asm sta status_result_pointers+9;
   asm lda #<{status_glyphs + 0};    asm sta status_result_pointers+10;
   asm lda #>{status_glyphs + 0};    asm sta status_result_pointers+11;
}

inline void load_fa_type(void) {
   // blank / blank / F / A / blank / blank
   asm lda #<{cart_type_glyphs + 0};  asm sta cart_type_pointers+0;
   asm lda #>{cart_type_glyphs + 0};  asm sta cart_type_pointers+1;
   asm lda #<{cart_type_glyphs + 0};  asm sta cart_type_pointers+2;
   asm lda #>{cart_type_glyphs + 0};  asm sta cart_type_pointers+3;
   asm lda #<{cart_type_glyphs + 8};  asm sta cart_type_pointers+4;
   asm lda #>{cart_type_glyphs + 8};  asm sta cart_type_pointers+5;
   asm lda #<{cart_type_glyphs + 16}; asm sta cart_type_pointers+6;
   asm lda #>{cart_type_glyphs + 16}; asm sta cart_type_pointers+7;
   asm lda #<{cart_type_glyphs + 0};  asm sta cart_type_pointers+8;
   asm lda #>{cart_type_glyphs + 0};  asm sta cart_type_pointers+9;
   asm lda #<{cart_type_glyphs + 0};  asm sta cart_type_pointers+10;
   asm lda #>{cart_type_glyphs + 0};  asm sta cart_type_pointers+11;
}

bank0 void draw_result(void) {
   status_result_score := 0;
   cart_type_score := 0;
   status_result_init();
   cart_type_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      status_result_vblank();
      cart_type_vblank();
      if (failure) { load_fail(); } else { load_pass(); }
      load_fa_type();
      status_result_color := 0x0E;
      COLUBK := failure ? 0x20 : 0xC4;
      COLUP0 := 0x0E;
      COLUP1 := 0x0E;
      PF0 := 0; PF1 := 0; PF2 := 0; GRP0 := 0; GRP1 := 0;
      ENAM0 := 0; ENAM1 := 0; ENABL := 0; CTRLPF := 0;
      vcs_ntsc_end_vblank();
      // Match the established bank diagnostic layout: 81 blank + 19 result +
      // 11 cart type + 81 blank = 192 visible scanlines.
      vcs_ntsc_wait_component_scanlines(81);
      status_result_draw();
      vcs_ntsc_component_handoff();
      cart_type_draw();
      vcs_ntsc_wait_visible_tail_scanlines(81);
      vcs_ntsc_begin_overscan();
      status_result_overscan();
      cart_type_overscan();
      vcs_ntsc_end_overscan();
   }
}
#endif

#ifdef SIMULATOR_TEST
bank0 void simulator_done(void) {
   while (1) { }
}
#endif

bank0 void bank0_probe(void) {
   if (fa_data != 0xA5 || fa_bss[0] != 0x11 ||
       fa_bss[127] != 0x22 || fa_bss[254] != 0x33) {
      failure := 0x30;
   }
   ram_count := ram_count + 1;
   trace := 3;
}

bank2 void bank2_probe(void) {
   if (trace != 1 || fa_data != 0xA5 || fa_bss[254] != 0x33) {
      failure := 0x20;
   }
   ram_count := ram_count + 1;
   trace := 2;
   bank0_probe();
   if (trace != 3 || fa_bss[127] != 0x22) {
      failure := 0x21;
   }
}

bank1 void bank1_probe(void) {
   if (trace != 0 || fa_data != 0xA5 || fa_bss[0] != 0x11) {
      failure := 0x10;
   }
   ram_count := ram_count + 1;
   trace := 1;
   bank2_probe();
   if (trace != 3 || fa_bss[254] != 0x33) {
      failure := 0x11;
   }
   trace := 4;
}

void main(void) {
   // The startup bridge must have selected physical bank 2 before reaching here.
   if (fa_data != 0x5A) {
      failure := 0x01;
   }
   index := 0;
   while (index != 255) {
      if (fa_bss[index] != 0) {
         failure := 0x02;
      }
      index := index + 1;
   }

   fa_data := 0xA5;
   fa_bss[0] := 0x11;
   fa_bss[127] := 0x22;
   fa_bss[254] := 0x33;
   ram_count := 0;
   trace := 0;

   // Nested call chain: physical 2 -> 1 -> 0 -> 2, followed by generated
   // return stubs 2 -> 0 -> 1 -> 2. This exercises all three FA selectors.
   bank1_probe();

   if (trace != 4 || ram_count != 3 || fa_data != 0xA5 ||
       fa_bss[0] != 0x11 || fa_bss[127] != 0x22 || fa_bss[254] != 0x33) {
      failure := 0x03;
   }

#ifdef SIMULATOR_TEST
   asm jmp simulator_done;
#else
   draw_result();
#endif
}
