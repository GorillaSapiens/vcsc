;
; Maximum-size Tigervision 3EX torture payload. This object contains the fixed-bank ROM scheduler.
; Cross-bank calls execute a tiny inline descriptor stub from RIOT RAM so
; the full 255 x 255 ordered matrix fits in one 512K cartridge.

.import failure, torture_count, expected_source, expected_dest, fixed_sp
.import torture_done, torture_batch, step_remaining, ram_phase, ram_lfsr, bankcall_stub
.import step_3ex_max_ram, ram_walk_reset
.export fixed_probe, finish_3ex_max_init, step_3ex_max_torture

.segment "CODE.bank255"

.segment "CODE.bank255.fixed_probe"
fixed_probe:
    inc torture_count
    bne.same fixed_probe_count_ok
    inc torture_count+1
fixed_probe_count_ok:
    rts

.segment "CODE.bank255.finish_init"
finish_3ex_max_init:
    lda #<fixed_probe
    sta ram_lfsr
    lda #>fixed_probe
    sta ram_lfsr+1
    rts

.segment "CODE.bank255.rom_scheduler"
step_3ex_max_torture:
    lda torture_done
    bne.same step_return
    lda ram_phase
    beq.same rom_phase
    jsr step_3ex_max_ram
    .banktarget step_3ex_max_ram
step_return:
    rts

rom_phase:
    lda expected_source
    cmp #$ff
    beq.same fixed_phase
    lda torture_batch
    sta step_remaining
    lda expected_source
    sta $3f
    jsr $1000
    lda expected_dest
    cmp #$ff
    bne.same step_return
    lda #0
    sta expected_dest
    inc expected_source
    rts

fixed_phase:
    lda #<$1f80
    sta bankcall_stub+1
    lda #>$1f80
    sta bankcall_stub+2
    lda #<$1100
    sta bankcall_stub+3
    lda #>$1100
    sta bankcall_stub+4
    tsx
    stx fixed_sp
    lda torture_batch
    sta step_remaining
fixed_dest_loop:
    lda expected_dest
    cmp #$ff
    beq.same fixed_done
    sta bankcall_stub+5
    jsr bankcall_stub
    inc expected_dest
    lda expected_dest
    cmp #$ff
    beq.same fixed_done
    dec step_remaining
    bne.same fixed_dest_loop
fixed_step_return:
    tsx
    cpx fixed_sp
    beq.same step_return
    lda #$05
    sta failure
    rts

fixed_done:
    tsx
    cpx fixed_sp
    beq.same fixed_stack_ok
    lda #$05
    sta failure
fixed_stack_ok:
    lda torture_count
    cmp #$ff
    beq.same count_lo_ok
    lda #$06
    sta failure
count_lo_ok:
    lda torture_count+1
    cmp #$ff
    beq.same count_hi_ok
    lda #$07
    sta failure
count_hi_ok:
    lda #1
    sta ram_phase
    jsr ram_walk_reset
    .banktarget ram_walk_reset
    rts
