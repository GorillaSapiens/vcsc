    .byte $00, $00, $00, $00, $80, $C0, $E0, $F0, $78, $3C, $1E, $0E, $06, $02, $00, $00
    .byte $00, $00, $00, $00, $00, $00, $00, $00, $FE, $FE, $00, $00, $00, $00, $00, $00
    .byte $00, $00, $00, $00, $02, $06, $0E, $1E, $3C, $78, $F0, $E0, $C0, $80, $00, $00
    .byte $00, $00, $00, $38, $38, $38, $38, $38, $38, $38, $38, $38, $38, $38, $38, $00
load_wait:
    lda #<{wait_glyphs + 16}
    sta status_result_pointers+0
    lda #>{wait_glyphs + 16}
    sta status_result_pointers+1
    lda #<{wait_glyphs + 32}
    sta status_result_pointers+2
    lda #>{wait_glyphs + 32}
    sta status_result_pointers+3
    lda #<{wait_glyphs + 48}
    sta status_result_pointers+4
    lda #>{wait_glyphs + 48}
    sta status_result_pointers+5
    lda #<{wait_glyphs + 64}
    sta status_result_pointers+6
    lda #>{wait_glyphs + 64}
    sta status_result_pointers+7
    lda #<wait_glyphs
    sta status_result_pointers+8
    lda #>wait_glyphs
    sta status_result_pointers+9
    lda spinner_index
    asl
    asl
    asl
    asl
    clc
    adc #<{wait_glyphs + 80}
    sta status_result_pointers+10
    lda #>{wait_glyphs + 80}
    adc #0
    sta status_result_pointers+11
    rts

.segmentalign "CODE.bank254", 256
.segment "CODE.bank254"
.export bank254_source, bank254_target
bank254_source:
    tsx
    stx source_sp
bank254_dest_loop:
    lda expected_dest
    cmp #$FE
    beq.same bank254_same
    sta bankcall_stub+5
    jsr bankcall_stub
    jmp bank254_after
bank254_same:
    jsr bank254_target
bank254_after:
    lda #$FE
    cmp expected_source
    beq.same bank254_restored
    lda #$02
    sta failure
bank254_restored:
    inc expected_dest
    lda expected_dest
    cmp #$FF
    beq.same bank254_source_done
    dec step_remaining
    bne.same bank254_dest_loop
    jmp bank254_step_done
bank254_source_done:
    lda ram_lfsr
    sta bankcall_stub+3
    lda ram_lfsr+1
    sta bankcall_stub+4
    lda #$ff
    sta bankcall_stub+5
    jsr bankcall_stub
    lda #<$1100
    sta bankcall_stub+3
    lda #>$1100
    sta bankcall_stub+4
    lda #$FE
    cmp expected_source
    beq.same bank254_fixed_restored
    lda #$03
    sta failure
bank254_fixed_restored:
bank254_step_done:
    tsx
    cpx source_sp
    beq.same bank254_source_stack_ok
    lda #$04
    sta failure
bank254_source_stack_ok:
    rts
    .align 256
bank254_target:
    lda expected_dest
    cmp #$FE
    beq.same bank254_target_ok
    lda #$01
    sta failure
bank254_target_ok:
    inc torture_count
    bne.same bank254_target_count_ok
    inc torture_count+1
bank254_target_count_ok:
    rts
    .align 256
.export bank254_ram_entry
bank254_ram_entry:
    lda ram_phase
    cmp #1
    beq.same ram254_bank254_ram_entry_write
    lda torture_batch
    sta step_remaining
ram254_bank254_ram_entry_verify:
    jsr ram_read_254
    lda ram_lfsr
    eor #$FE
    cmp ram_value
    beq.same ram254_bank254_ram_entry_verify_ok
    lda failure
    bne.same ram254_bank254_ram_entry_verify_ok
    lda #$80
    sta failure
    lda #$FE
    sta ram_failure_bank
ram254_bank254_ram_entry_verify_ok:
    lda ram_lfsr+1
    lsr
    sta ram_lfsr+1
    lda ram_lfsr
    ror
    sta ram_lfsr
    bcc.same ram254_bank254_ram_entry_v_lfsr_done
    lda ram_lfsr+1
    eor #$b4
    sta ram_lfsr+1
ram254_bank254_ram_entry_v_lfsr_done:
    inc ram_index
    bne.same ram254_bank254_ram_entry_v_index_low_ok
    inc ram_index+1
ram254_bank254_ram_entry_v_index_low_ok:
    lda ram_index+1
    cmp #4
    bne.same ram254_bank254_ram_entry_v_continue
    lda #0
    sta ram_index
    sta ram_index+1
    lda #$FF
    sta ram_bank
    rts
ram254_bank254_ram_entry_v_continue:
    dec step_remaining
    bne.same ram254_bank254_ram_entry_verify
    rts
ram254_bank254_ram_entry_write:
    lda torture_batch
    sta step_remaining
ram254_bank254_ram_entry_write_loop:
    lda ram_lfsr
    eor #$FE
    sta ram_value
    jsr ram_write_254
    lda ram_lfsr+1
    lsr
    sta ram_lfsr+1
    lda ram_lfsr
    ror
    sta ram_lfsr
    bcc.same ram254_bank254_ram_entry_w_lfsr_done
    lda ram_lfsr+1
    eor #$b4
    sta ram_lfsr+1
ram254_bank254_ram_entry_w_lfsr_done:
    inc ram_index
    bne.same ram254_bank254_ram_entry_w_index_low_ok
    inc ram_index+1
ram254_bank254_ram_entry_w_index_low_ok:
    lda ram_index+1
    cmp #4
    bne.same ram254_bank254_ram_entry_w_continue
    lda #0
    sta ram_index
    sta ram_index+1
    lda #$FF
    sta ram_bank
    rts
ram254_bank254_ram_entry_w_continue:
    dec step_remaining
    bne.same ram254_bank254_ram_entry_write_loop
    rts

    .align 256
status_glyphs:
    .byte $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
    .byte $00, $E0, $E0, $E0, $FE, $FF, $E7, $E7, $E7, $FF, $FE, $00, $00, $00, $00, $00
    .byte $00, $00, $00, $00, $7F, $FF, $E7, $7F, $07, $7F, $3E, $00, $00, $00, $00, $00
    .byte $00, $00, $00, $00, $7E, $FF, $0F, $7E, $F0, $FF, $7E, $00, $00, $00, $00, $00
    .byte $00, $00, $00, $00, $E0, $E0, $E0, $E0, $FC, $FC, $E0, $E0, $FF, $FF, $00, $00
    .byte $00, $00, $00, $00, $E7, $E7, $FF, $FF, $E7, $66, $7E, $3C, $3C, $18, $00, $00
    .byte $00, $00, $00, $00, $7C, $7C, $38, $38, $38, $38, $38, $38, $7C, $7C, $00, $00
    .byte $00, $00, $00, $00, $FF, $FF, $E0, $E0, $E0, $E0, $E0, $E0, $E0, $E0, $00, $00
load_pass:
    lda #<status_glyphs
    sta status_result_pointers+0
    lda #>status_glyphs
    sta status_result_pointers+1
    lda #<{status_glyphs + 16}
    sta status_result_pointers+2
    lda #>{status_glyphs + 16}
    sta status_result_pointers+3
    lda #<{status_glyphs + 32}
    sta status_result_pointers+4
    lda #>{status_glyphs + 32}
    sta status_result_pointers+5
    lda #<{status_glyphs + 48}
    sta status_result_pointers+6
    lda #>{status_glyphs + 48}
    sta status_result_pointers+7
    lda #<{status_glyphs + 48}
    sta status_result_pointers+8
    lda #>{status_glyphs + 48}
    sta status_result_pointers+9
    lda #<status_glyphs
    sta status_result_pointers+10
    lda #>status_glyphs
    sta status_result_pointers+11
    rts

load_fail:
    lda #<status_glyphs
    sta status_result_pointers+0
    lda #>status_glyphs
    sta status_result_pointers+1
    lda #<{status_glyphs + 64}
    sta status_result_pointers+2
    lda #>{status_glyphs + 64}
    sta status_result_pointers+3
    lda #<{status_glyphs + 80}
    sta status_result_pointers+4
    lda #>{status_glyphs + 80}
    sta status_result_pointers+5
    lda #<{status_glyphs + 96}
    sta status_result_pointers+6
    lda #>{status_glyphs + 96}
    sta status_result_pointers+7
    lda #<{status_glyphs + 112}
    sta status_result_pointers+8
    lda #>{status_glyphs + 112}
    sta status_result_pointers+9
    lda #<status_glyphs
    sta status_result_pointers+10
    lda #>status_glyphs
    sta status_result_pointers+11
    rts

