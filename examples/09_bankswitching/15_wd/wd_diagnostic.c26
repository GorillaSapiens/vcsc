// Wickstead Design PASS/FAIL diagnostic. WD maps four 1K segments from eight
// physical ROM chunks. Reads from TIA $30-$3F request one of eight complete
// arrangements after the hardware delay; 64 bytes of cartridge RAM use split
// read/write aliases at $1000/$1040.
include "vcs_8k_wd.c26"

#ifndef SIMULATOR_TEST
include "frame_ntsc.c26"
instantiate "six_glyph_component.c26" as status (compact_font:=0, external_pointers:=1, mutable_color:=1)
instantiate "six_glyph_component.c26" as cart_type (compact_font:=0, external_pointers:=1)
#endif

uint8_t failure;
uint8_t call_count;
cartram uint8_t wd_ram[64];

bank0 uint8_t bank0_probe(void) { call_count := call_count + 1; return 0x10; }
bank1 uint8_t bank1_probe(void) { call_count := call_count + 1; return 0x21; }
bank2 uint8_t bank2_probe(void) { call_count := call_count + 1; return 0x32; }
bank4 uint8_t bank4_probe(void) { call_count := call_count + 1; return 0x54; }
bank7 uint8_t bank7_probe(void) { call_count := call_count + 1; return 0x87; }

// The released WD detector/switch idiom is a zero-page read followed by a
// three-byte JMP. The selector read arms a delayed latch; the arrangement is
// visible only after the required bus-cycle delay. All labels remain in the
// fixed physical chunk 3 at $1C00-$1FFF for arrangements 0, 1, and 3.
inline void wd_select0(void) { asm lda $30; asm jmp @ready; asm @ready:; }
inline void wd_select1(void) { asm lda $39; asm jmp @ready; asm @ready:; }
inline void wd_select3(void) { asm lda $33; asm jmp @ready; asm @ready:; }

#ifndef SIMULATOR_TEST
include "diagnostic_font.c26"

inline void load_pass(void) {
   // " PASS "
   asm lda #<{wd_glyphs + 0};  asm sta status_pointers+0;
   asm lda #>{wd_glyphs + 0};  asm sta status_pointers+1;
   asm lda #<{wd_glyphs + 8};  asm sta status_pointers+2;
   asm lda #>{wd_glyphs + 8};  asm sta status_pointers+3;
   asm lda #<{wd_glyphs + 16}; asm sta status_pointers+4;
   asm lda #>{wd_glyphs + 16}; asm sta status_pointers+5;
   asm lda #<{wd_glyphs + 24}; asm sta status_pointers+6;
   asm lda #>{wd_glyphs + 24}; asm sta status_pointers+7;
   asm lda #<{wd_glyphs + 24}; asm sta status_pointers+8;
   asm lda #>{wd_glyphs + 24}; asm sta status_pointers+9;
   asm lda #<{wd_glyphs + 0};  asm sta status_pointers+10;
   asm lda #>{wd_glyphs + 0};  asm sta status_pointers+11;
}

inline void load_fail(void) {
   // " FAIL "
   asm lda #<{wd_glyphs + 0};  asm sta status_pointers+0;
   asm lda #>{wd_glyphs + 0};  asm sta status_pointers+1;
   asm lda #<{wd_glyphs + 32}; asm sta status_pointers+2;
   asm lda #>{wd_glyphs + 32}; asm sta status_pointers+3;
   asm lda #<{wd_glyphs + 40}; asm sta status_pointers+4;
   asm lda #>{wd_glyphs + 40}; asm sta status_pointers+5;
   asm lda #<{wd_glyphs + 48}; asm sta status_pointers+6;
   asm lda #>{wd_glyphs + 48}; asm sta status_pointers+7;
   asm lda #<{wd_glyphs + 56}; asm sta status_pointers+8;
   asm lda #>{wd_glyphs + 56}; asm sta status_pointers+9;
   asm lda #<{wd_glyphs + 0};  asm sta status_pointers+10;
   asm lda #>{wd_glyphs + 0};  asm sta status_pointers+11;
}

inline void load_wd(void) {
   // "  WD  "
   asm lda #<{wd_glyphs + 0};  asm sta cart_type_pointers+0;
   asm lda #>{wd_glyphs + 0};  asm sta cart_type_pointers+1;
   asm lda #<{wd_glyphs + 0};  asm sta cart_type_pointers+2;
   asm lda #>{wd_glyphs + 0};  asm sta cart_type_pointers+3;
   asm lda #<{wd_glyphs + 64}; asm sta cart_type_pointers+4;
   asm lda #>{wd_glyphs + 64}; asm sta cart_type_pointers+5;
   asm lda #<{wd_glyphs + 72}; asm sta cart_type_pointers+6;
   asm lda #>{wd_glyphs + 72}; asm sta cart_type_pointers+7;
   asm lda #<{wd_glyphs + 0};  asm sta cart_type_pointers+8;
   asm lda #>{wd_glyphs + 0};  asm sta cart_type_pointers+9;
   asm lda #<{wd_glyphs + 0};  asm sta cart_type_pointers+10;
   asm lda #>{wd_glyphs + 0};  asm sta cart_type_pointers+11;
}

bank2 void draw_result(void) {
   status_init();
   cart_type_init();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      status_vblank();
      cart_type_vblank();
      if (failure) { load_fail(); } else { load_pass(); }
      load_wd();
      status_color := 0x0E;
      COLUBK := failure ? 0x20 : 0xC4;
      COLUP0 := 0x0E; COLUP1 := 0x0E;
      PF0 := 0; PF1 := 0; PF2 := 0; GRP0 := 0; GRP1 := 0;
      ENAM0 := 0; ENAM1 := 0; ENABL := 0; CTRLPF := 0;
      vcs_ntsc_end_vblank();
      // 85 blank + 11 status + 11 mapper + 85 blank = 192 visible.
      vcs_ntsc_wait_component_scanlines(85);
      status_draw();
      vcs_ntsc_component_handoff();
      cart_type_draw();
      vcs_ntsc_wait_visible_tail_scanlines(85);
      vcs_ntsc_begin_overscan();
      status_overscan();
      cart_type_overscan();
      vcs_ntsc_end_overscan();
   }
}
#endif

#ifdef SIMULATOR_TEST
bank3 void simulator_done(void) { while (1) { } }
#endif

bank3 void main(void) {
   failure := 0;
   call_count := 0;

   // Power-on arrangement 0 is 0,0,1,3. Segment 0 therefore sees bank 0.
   if (bank0_probe() != 0x10) { failure := 0x01; }

   // The split-address 64-byte RAM must preserve both boundary bytes.
   wd_ram[0] := 0x5A;
   wd_ram[63] := 0xA5;
   if (wd_ram[0] != 0x5A) { failure := 0x02; }
   if (wd_ram[63] != 0xA5) { failure := 0x03; }

   // Arrangement 1 = physical chunks 0,1,2,3.
   wd_select1();
   if (bank0_probe() != 0x10) { failure := 0x10; }
   if (bank1_probe() != 0x21) { failure := 0x11; }
   if (bank2_probe() != 0x32) { failure := 0x12; }

   // A write to the selector range is merely a TIA write; WD switches only on
   // reads. If it accidentally selected arrangement 3, this bank-1 call would
   // execute physical bank 4 instead.
   asm lda #0;
   asm sta $33;
   if (bank1_probe() != 0x21) { failure := 0x13; }

   // Arrangement 3 = physical chunks 7,4,2,3.
   wd_select3();
   if (bank7_probe() != 0x87) { failure := 0x30; }
   if (bank4_probe() != 0x54) { failure := 0x31; }
   if (bank2_probe() != 0x32) { failure := 0x32; }

   // Return to arrangement 1 for the visible display: its font is in physical
   // chunk 0 while all renderer/application code remains in fixed chunk 3.
   wd_select1();
   if (call_count != 8) { failure := 0x7F; }

#ifdef SIMULATOR_TEST
   asm jmp simulator_done;
#else
   draw_result();
#endif
}
