   // GRP1 lands at cycle 2 of the first B-row line, transferring the delayed
   // Ball bit0 staged above.  M0 intentionally remains on old-row bit7 until
   // B pair 1 updates it on the following line, matching the proven pipeline.
   asm sta GRP1;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta ENAM1;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 12;
   PF1 := TEMPLATE_odd_pf0;
   asm lda.z TEMPLATE_row_cache + 8;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm inx;
   asm inx;
   asm inx;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm bcs.same TEMPLATE_entry_A_firstB_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp TEMPLATE_entry_A_firstB_p0_ready;
   asm .scope TEMPLATE_scope_A_firstB_p0_zero;
   asm TEMPLATE_entry_A_firstB_p0_zero:;
   asm .endscope;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm .scope TEMPLATE_scope_A_firstB_p0_ready;
   asm TEMPLATE_entry_A_firstB_p0_ready:;
   asm .endscope;
   asm sta GRP0;
   asm inx;
   asm txs;
   asm jmp TEMPLATE_entry_B_u1;

   asm .endif;
   asm .endproc;
}
inline void TEMPLATE_emit_boundary_B(void) {
   asm .proc TEMPLATE_boundary_B;
   asm .if TEMPLATE_BOUNDARY;
   asm .scope TEMPLATE_scope_B_boundary;
   asm TEMPLATE_entry_B_boundary:;
   asm .endscope;
   asm sta GRP0;
   // M0 is immediate rather than delayed: pair 7 precomputed its packed bit7
   // into the dead current-cache M0 lane so this final-row-line update is only
   // six cycles and cannot perturb the fixed GRP1 phase.
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.zx TEMPLATE_object_masks + 4,x;
   asm sta ENABL;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 4;
   asm .scope TEMPLATE_scope_global_bound_B_0;
   asm TEMPLATE_entry_global_bound_B_0:;
   asm .endscope;
   TEMPLATE_global_pf1_abs := TEMPLATE_odd_pf0;
   asm .scope TEMPLATE_scope_global_bound_B_1;
   asm TEMPLATE_entry_global_bound_B_1:;
   asm .endscope;
   PF2 := TEMPLATE_odd_pf1;
   asm sty.z TEMPLATE_object_masks + 0;
   asm dec.z TEMPLATE_object_masks + 0;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm .scope TEMPLATE_scope_global_bound_B_2;
   asm TEMPLATE_entry_global_bound_B_2:;
   asm .endscope;
   PF2 := TEMPLATE_odd_pf2;
   asm dey;
   asm .scope TEMPLATE_scope_global_bound_B_3;
   asm TEMPLATE_entry_global_bound_B_3:;
   asm .endscope;
   PF1 := TEMPLATE_odd_pf3;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same TEMPLATE_entry_B_boundary_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm sty.z TEMPLATE_object_masks + 1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm ldy.z TEMPLATE_row_cache + 5;
   // GRP1 lands at cycle 2 of the first B-row line, transferring the delayed
   // Ball bit0 staged above.  M0 intentionally remains on old-row bit7 until
   // B pair 1 updates it on the following line, matching the proven pipeline.
   asm sta GRP1;
   asm sty ENAM1;
   asm lda.ax TEMPLATE_global_pf,x;
   asm sta COLUPF;
   asm lda.ax TEMPLATE_global_bk,x;
   asm sta COLUBK;
   asm .scope TEMPLATE_scope_spread_B_0;
   asm TEMPLATE_entry_spread_B_0:;
   asm .endscope;
   asm .scope TEMPLATE_scope_global_bound_B_4;
   asm TEMPLATE_entry_global_bound_B_4:;
   asm .endscope;
   PF1 := TEMPLATE_even_pf0;
   asm .scope TEMPLATE_scope_spread_B_1;
   asm TEMPLATE_entry_spread_B_1:;
   asm .endscope;
   asm .scope TEMPLATE_scope_global_bound_B_5;
   asm TEMPLATE_entry_global_bound_B_5:;
   asm .endscope;
   PF2 := TEMPLATE_even_pf1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm .scope TEMPLATE_scope_spread_B_2;
   asm TEMPLATE_entry_spread_B_2:;
   asm .endscope;
   asm inx;
   asm .scope TEMPLATE_scope_global_bound_B_6;
   asm TEMPLATE_entry_global_bound_B_6:;
   asm .endscope;
   TEMPLATE_global_pf2_abs := TEMPLATE_even_pf2;
   asm .scope TEMPLATE_scope_spread_B_3;
   asm TEMPLATE_entry_spread_B_3:;
   asm .endscope;
   asm .scope TEMPLATE_scope_global_bound_B_7;
   asm TEMPLATE_entry_global_bound_B_7:;
   asm .endscope;
   PF1 := TEMPLATE_even_pf3;
   asm cpy.z TEMPLATE_player0_height;

   asm inx;
   asm bcs.same TEMPLATE_entry_B_firstB_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm sta GRP0;
   asm inx;
   asm inx;
   asm jmp TEMPLATE_entry_A_u1;
   asm .scope TEMPLATE_scope_B_firstB_p0_zero;
   asm TEMPLATE_entry_B_firstB_p0_zero:;
   asm .endscope;
   asm lda #0;
   asm tay;
   asm sta GRP0;
   asm inx;
   asm inx;
   asm jmp TEMPLATE_entry_A_u1;
   asm .scope TEMPLATE_scope_B_boundary_p1_zero;
   asm TEMPLATE_entry_B_boundary_p1_zero:;
   asm .endscope;
   asm sty.z TEMPLATE_object_masks + 1;
   asm lda.z TEMPLATE_packed_p1_zero;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm ldy.z TEMPLATE_row_cache + 5;
   // GRP1 lands at cycle 2 of the first B-row line, transferring the delayed
   // Ball bit0 staged above.  M0 intentionally remains on old-row bit7 until
   // B pair 1 updates it on the following line, matching the proven pipeline.
   asm sta GRP1;
   asm sty ENAM1;
   asm lda.ax TEMPLATE_global_pf,x;
   asm sta COLUPF;
   asm lda.ax TEMPLATE_global_bk,x;
   asm sta COLUBK;
   asm .scope TEMPLATE_scope_spread_B_4;
   asm TEMPLATE_entry_spread_B_4:;
   asm .endscope;
   asm .scope TEMPLATE_scope_global_bound_B_8;
   asm TEMPLATE_entry_global_bound_B_8:;
   asm .endscope;
   PF1 := TEMPLATE_even_pf0;
   asm .scope TEMPLATE_scope_spread_B_5;
   asm TEMPLATE_entry_spread_B_5:;
   asm .endscope;
   asm .scope TEMPLATE_scope_global_bound_B_9;
   asm TEMPLATE_entry_global_bound_B_9:;
   asm .endscope;
   PF2 := TEMPLATE_even_pf1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm .scope TEMPLATE_scope_spread_B_6;
   asm TEMPLATE_entry_spread_B_6:;
   asm .endscope;
   asm inx;
   asm .scope TEMPLATE_scope_global_bound_B_10;
   asm TEMPLATE_entry_global_bound_B_10:;
   asm .endscope;
   TEMPLATE_global_pf2_abs := TEMPLATE_even_pf2;
   asm .scope TEMPLATE_scope_spread_B_7;
   asm TEMPLATE_entry_spread_B_7:;
   asm .endscope;
   asm .scope TEMPLATE_scope_global_bound_B_11;
   asm TEMPLATE_entry_global_bound_B_11:;
   asm .endscope;
   PF1 := TEMPLATE_even_pf3;
   asm cpy.z TEMPLATE_player0_height;

   asm inx;
   asm bcs.same TEMPLATE_entry_B_zero_firstB_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm sta GRP0;
   asm inx;
   asm inx;
   asm jmp TEMPLATE_entry_A_u1;
   asm .scope TEMPLATE_scope_B_zero_firstB_p0_zero;
   asm TEMPLATE_entry_B_zero_firstB_p0_zero:;
   asm .endscope;
   asm lda #0;
   asm tay;
   asm sta GRP0;
   asm inx;
   asm inx;
   asm jmp TEMPLATE_entry_A_u1;
   asm .else;
   asm .scope TEMPLATE_scope_B_boundary;
   asm TEMPLATE_entry_B_boundary:;
   asm .endscope;
   asm sta GRP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.zx TEMPLATE_object_masks + 4,x;
   asm sta ENABL;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 4;
   asm .scope TEMPLATE_scope_fine_barrier_50;
   asm TEMPLATE_entry_fine_barrier_50:;
   asm .endscope;
   PF1 := TEMPLATE_odd_pf0;
   asm .scope TEMPLATE_scope_fine_barrier_51;
   asm TEMPLATE_entry_fine_barrier_51:;
   asm .endscope;
   PF2 := TEMPLATE_odd_pf1;
   asm sty.z TEMPLATE_object_masks + 0;
   // B boundaries spend the four-cycle terminal check in place of A's Ball
