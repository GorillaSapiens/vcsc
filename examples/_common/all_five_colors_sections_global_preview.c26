inline void TEMPLATE_emit_terminal(void) {
   asm .proc TEMPLATE_terminal;
   asm .scope TEMPLATE_scope_fine_terminal;
   asm TEMPLATE_entry_fine_terminal:;
   asm .endscope;
   asm sta GRP0;
   asm lda.z TEMPLATE_row_cache + 13;
   asm sta ENAM0;
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm lda.z TEMPLATE_row_cache + 7;
   asm sta PF1;
   asm .scope TEMPLATE_scope_fine_barrier_52;
   asm TEMPLATE_entry_fine_barrier_52:;
   asm .endscope;
   PF2 := TEMPLATE_odd_pf1;
   asm sty.z TEMPLATE_object_masks + 0;
   asm ldx.a TEMPLATE_saved_s;
   asm txs;
   asm jmp TEMPLATE_entry_fine_close;
   asm .endproc;
}
require inline void TEMPLATE_draw(void) {
   // Row zero enters at the scheduler's cycle-3 handoff.  The first visible
   // P0 half is timed to place the first cached pair at cycle 75; every normal
   // pair thereafter is exactly 152 cycles.
   asm bit.z $00;
   asm bit.z $00;
   asm nop;
   asm lda.a TEMPLATE_row_cache + 0;
   asm sta PF1;
   asm lda.a TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm bit.z $00;
   asm nop;
   asm lda.a TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same TEMPLATE_entry_first_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp TEMPLATE_entry_first_p0_ready;
   asm .scope TEMPLATE_scope_first_p0_zero;
   asm TEMPLATE_entry_first_p0_zero:;
   asm .endscope;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm .scope TEMPLATE_scope_first_p0_ready;
   asm TEMPLATE_entry_first_p0_ready:;
   asm .endscope;
   asm sta GRP0;
   asm ldx #0;
   asm txs;
   asm jmp TEMPLATE_entry_A_u1;

   TEMPLATE_emit_route_tables();
   // A pair 1: fixed 152-cycle cached pair.
   TEMPLATE_emit_normal_A();
   // A pair 7 consumes the packed eighth BL/M1/M0 bits.  The packed
   // byte is copied to the now-dead cached M1 lane before X becomes P1 color.
   TEMPLATE_emit_normal_B();
   // B pair 7 consumes the packed eighth BL/M1/M0 bits.  The packed
   // byte is copied to the now-dead cached M1 lane before X becomes P1 color.
   asm .if {!{{TEMPLATE_END1 == 30} || {TEMPLATE_END2 == 30} || {TEMPLATE_END3 == 30} || {TEMPLATE_END4 == 30} || {TEMPLATE_END5 == 30} || {TEMPLATE_END6 == 30} || {TEMPLATE_END7 == 30}}} || {!{{TEMPLATE_END1 == 62} || {TEMPLATE_END2 == 62} || {TEMPLATE_END3 == 62} || {TEMPLATE_END4 == 62} || {TEMPLATE_END5 == 62} || {TEMPLATE_END6 == 62} || {TEMPLATE_END7 == 62}}} || {!{{TEMPLATE_END1 == 94} || {TEMPLATE_END2 == 94} || {TEMPLATE_END3 == 94} || {TEMPLATE_END4 == 94} || {TEMPLATE_END5 == 94} || {TEMPLATE_END6 == 94} || {TEMPLATE_END7 == 94}}} || {!{{TEMPLATE_END1 == 126} || {TEMPLATE_END2 == 126} || {TEMPLATE_END3 == 126} || {TEMPLATE_END4 == 126} || {TEMPLATE_END5 == 126} || {TEMPLATE_END6 == 126} || {TEMPLATE_END7 == 126}}} || {!{{TEMPLATE_END1 == 158} || {TEMPLATE_END2 == 158} || {TEMPLATE_END3 == 158} || {TEMPLATE_END4 == 158} || {TEMPLATE_END5 == 158} || {TEMPLATE_END6 == 158} || {TEMPLATE_END7 == 158}}};
   TEMPLATE_emit_packed_B_D();
   asm .endif;
   asm .if {TEMPLATE_SECTION_1 == 1 && {{TEMPLATE_END1 == 30} || {TEMPLATE_END2 == 30} || {TEMPLATE_END3 == 30} || {TEMPLATE_END4 == 30} || {TEMPLATE_END5 == 30} || {TEMPLATE_END6 == 30} || {TEMPLATE_END7 == 30}}} || {TEMPLATE_SECTION_3 == 1 && {{TEMPLATE_END1 == 62} || {TEMPLATE_END2 == 62} || {TEMPLATE_END3 == 62} || {TEMPLATE_END4 == 62} || {TEMPLATE_END5 == 62} || {TEMPLATE_END6 == 62} || {TEMPLATE_END7 == 62}}} || {TEMPLATE_SECTION_5 == 1 && {{TEMPLATE_END1 == 94} || {TEMPLATE_END2 == 94} || {TEMPLATE_END3 == 94} || {TEMPLATE_END4 == 94} || {TEMPLATE_END5 == 94} || {TEMPLATE_END6 == 94} || {TEMPLATE_END7 == 94}}} || {TEMPLATE_SECTION_7 == 1 && {{TEMPLATE_END1 == 126} || {TEMPLATE_END2 == 126} || {TEMPLATE_END3 == 126} || {TEMPLATE_END4 == 126} || {TEMPLATE_END5 == 126} || {TEMPLATE_END6 == 126} || {TEMPLATE_END7 == 126}}} || {TEMPLATE_SECTION_9 == 1 && {{TEMPLATE_END1 == 158} || {TEMPLATE_END2 == 158} || {TEMPLATE_END3 == 158} || {TEMPLATE_END4 == 158} || {TEMPLATE_END5 == 158} || {TEMPLATE_END6 == 158} || {TEMPLATE_END7 == 158}}};
   TEMPLATE_emit_packed_B_1();
