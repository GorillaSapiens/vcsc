   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;
   asm lda.zx TEMPLATE_object_masks + 4,x;
   asm sta ENABL;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 11;
   PF1 := TEMPLATE_even_pf0;
   asm .scope TEMPLATE_scope_fine_barrier_49;
   asm TEMPLATE_entry_fine_barrier_49:;
   asm .endscope;
   PF2 := TEMPLATE_even_pf1;
   asm sty.z TEMPLATE_object_masks + 0;
   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same TEMPLATE_entry_A_boundary_p1_zero;
