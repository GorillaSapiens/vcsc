uint8_t TEMPLATE_global_pf1_abs @[none/0x10E];
uint8_t TEMPLATE_global_pf2_abs @[none/0x10F];
inline void TEMPLATE_slot_macros(void) {
   asm MACRO TEMPLATE_SLOT_A phase;
   asm .if TEMPLATE_ROUTE_A_LO_PARITY == 0 && TEMPLATE_ROUTE_A_LO_PHASE == phase;
   asm lda.ax TEMPLATE_global_route_Alo,x;
   asm sta.z TEMPLATE_packed_route + 0;
   asm .else;
   asm .if TEMPLATE_ROUTE_A_HI_PARITY == 0 && TEMPLATE_ROUTE_A_HI_PHASE == phase;
   asm lda.ax TEMPLATE_global_route_Ahi,x;
   asm sta.z TEMPLATE_packed_route + 1;
   asm .else;
   asm .if TEMPLATE_ROUTE_B_LO_PARITY == 0 && TEMPLATE_ROUTE_B_LO_PHASE == phase;
   asm lda.ax TEMPLATE_global_route_Blo,x;
   asm sta.z TEMPLATE_packed_route + 2;
   asm .else;
   asm .if TEMPLATE_ROUTE_B_HI_PARITY == 0 && TEMPLATE_ROUTE_B_HI_PHASE == phase;
   asm lda.ax TEMPLATE_global_route_Bhi,x;
   asm sta.z TEMPLATE_packed_route + 3;
   asm .else;
   asm .if TEMPLATE_BOUNDARY && TEMPLATE_M1_A_PARITY == 0 && TEMPLATE_M1_A_PHASE == phase && !TEMPLATE_M1_A_LATE;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta.z TEMPLATE_row_cache + 5;
   asm .else;
   asm .if TEMPLATE_BOUNDARY && TEMPLATE_M1_B_PARITY == 0 && TEMPLATE_M1_B_PHASE == phase && !TEMPLATE_M1_B_LATE;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta.z TEMPLATE_row_cache + 12;
   asm .else;
   asm nop;
   asm nop;
   asm bit.z $00;
   asm .endif;
   asm .endif;
   asm .endif;
   asm .endif;
   asm .endif;
   asm .endif;
   asm ENDM;
   asm MACRO TEMPLATE_SLOT_B phase;
   asm .if TEMPLATE_ROUTE_A_LO_PARITY == 1 && TEMPLATE_ROUTE_A_LO_PHASE == phase;
   asm lda.ax TEMPLATE_global_route_Alo,x;
   asm sta.z TEMPLATE_packed_route + 0;
   asm .else;
   asm .if TEMPLATE_ROUTE_A_HI_PARITY == 1 && TEMPLATE_ROUTE_A_HI_PHASE == phase;
   asm lda.ax TEMPLATE_global_route_Ahi,x;
   asm sta.z TEMPLATE_packed_route + 1;
   asm .else;
   asm .if TEMPLATE_ROUTE_B_LO_PARITY == 1 && TEMPLATE_ROUTE_B_LO_PHASE == phase;
   asm lda.ax TEMPLATE_global_route_Blo,x;
   asm sta.z TEMPLATE_packed_route + 2;
   asm .else;
   asm .if TEMPLATE_ROUTE_B_HI_PARITY == 1 && TEMPLATE_ROUTE_B_HI_PHASE == phase;
   asm lda.ax TEMPLATE_global_route_Bhi,x;
   asm sta.z TEMPLATE_packed_route + 3;
   asm .else;
   asm .if TEMPLATE_BOUNDARY && TEMPLATE_M1_A_PARITY == 1 && TEMPLATE_M1_A_PHASE == phase && !TEMPLATE_M1_A_LATE;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta.z TEMPLATE_row_cache + 5;
   asm .else;
   asm .if TEMPLATE_BOUNDARY && TEMPLATE_M1_B_PARITY == 1 && TEMPLATE_M1_B_PHASE == phase && !TEMPLATE_M1_B_LATE;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta.z TEMPLATE_row_cache + 12;
   asm .else;
   asm nop;
   asm nop;
   asm bit.z $00;
   asm .endif;
   asm .endif;
   asm .endif;
   asm .endif;
   asm .endif;
   asm .endif;
   asm ENDM;
}
inline void TEMPLATE_targets_init(void) {

   asm TEMPLATE_SECTION_0 = {14 >= TEMPLATE_END1} + {14 >= TEMPLATE_END2} + {14 >= TEMPLATE_END3} + {14 >= TEMPLATE_END4} + {14 >= TEMPLATE_END5} + {14 >= TEMPLATE_END6} + {14 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_1 = {30 >= TEMPLATE_END1} + {30 >= TEMPLATE_END2} + {30 >= TEMPLATE_END3} + {30 >= TEMPLATE_END4} + {30 >= TEMPLATE_END5} + {30 >= TEMPLATE_END6} + {30 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_2 = {46 >= TEMPLATE_END1} + {46 >= TEMPLATE_END2} + {46 >= TEMPLATE_END3} + {46 >= TEMPLATE_END4} + {46 >= TEMPLATE_END5} + {46 >= TEMPLATE_END6} + {46 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_3 = {62 >= TEMPLATE_END1} + {62 >= TEMPLATE_END2} + {62 >= TEMPLATE_END3} + {62 >= TEMPLATE_END4} + {62 >= TEMPLATE_END5} + {62 >= TEMPLATE_END6} + {62 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_4 = {78 >= TEMPLATE_END1} + {78 >= TEMPLATE_END2} + {78 >= TEMPLATE_END3} + {78 >= TEMPLATE_END4} + {78 >= TEMPLATE_END5} + {78 >= TEMPLATE_END6} + {78 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_5 = {94 >= TEMPLATE_END1} + {94 >= TEMPLATE_END2} + {94 >= TEMPLATE_END3} + {94 >= TEMPLATE_END4} + {94 >= TEMPLATE_END5} + {94 >= TEMPLATE_END6} + {94 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_6 = {110 >= TEMPLATE_END1} + {110 >= TEMPLATE_END2} + {110 >= TEMPLATE_END3} + {110 >= TEMPLATE_END4} + {110 >= TEMPLATE_END5} + {110 >= TEMPLATE_END6} + {110 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_7 = {126 >= TEMPLATE_END1} + {126 >= TEMPLATE_END2} + {126 >= TEMPLATE_END3} + {126 >= TEMPLATE_END4} + {126 >= TEMPLATE_END5} + {126 >= TEMPLATE_END6} + {126 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_8 = {142 >= TEMPLATE_END1} + {142 >= TEMPLATE_END2} + {142 >= TEMPLATE_END3} + {142 >= TEMPLATE_END4} + {142 >= TEMPLATE_END5} + {142 >= TEMPLATE_END6} + {142 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_9 = {158 >= TEMPLATE_END1} + {158 >= TEMPLATE_END2} + {158 >= TEMPLATE_END3} + {158 >= TEMPLATE_END4} + {158 >= TEMPLATE_END5} + {158 >= TEMPLATE_END6} + {158 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_10 = {174 >= TEMPLATE_END1} + {174 >= TEMPLATE_END2} + {174 >= TEMPLATE_END3} + {174 >= TEMPLATE_END4} + {174 >= TEMPLATE_END5} + {174 >= TEMPLATE_END6} + {174 >= TEMPLATE_END7};
   asm TEMPLATE_SECTION_11 = {190 >= TEMPLATE_END1} + {190 >= TEMPLATE_END2} + {190 >= TEMPLATE_END3} + {190 >= TEMPLATE_END4} + {190 >= TEMPLATE_END5} + {190 >= TEMPLATE_END6} + {190 >= TEMPLATE_END7};
   asm TEMPLATE_BUSY TEMPLATE_BUSY_0_1, 0, 1;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_0_2, 0, 2;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_0_3, 0, 3;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_0_4, 0, 4;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_0_5, 0, 5;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_0_6, 0, 6;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_1_1, 1, 1;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_1_2, 1, 2;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_1_3, 1, 3;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_1_4, 1, 4;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_1_5, 1, 5;
   asm TEMPLATE_BUSY TEMPLATE_BUSY_1_6, 1, 6;
}
uint8_t TEMPLATE_packed_route[4];
uint8_t TEMPLATE_saved_s;
uint8_t TEMPLATE_packed_p1_zero;
const uint8_t TEMPLATE_even_pf0 := TEMPLATE_playfield[0];
const uint8_t TEMPLATE_even_pf1 := TEMPLATE_playfield[1];
const uint8_t TEMPLATE_even_pf2 := TEMPLATE_playfield[2];
const uint8_t TEMPLATE_even_pf3 := TEMPLATE_playfield[3];
const uint8_t TEMPLATE_odd_pf0 := TEMPLATE_playfield[4];
const uint8_t TEMPLATE_odd_pf1 := TEMPLATE_playfield[5];
const uint8_t TEMPLATE_odd_pf2 := TEMPLATE_playfield[6];
const uint8_t TEMPLATE_odd_pf3 := TEMPLATE_playfield[7];
// Object controls and preparation below retain the certified ancestor's
// behaviour. Do not copy its public budget declarations onto this private path.

alias TEMPLATE_OBJECT_PLAYER0 0
alias TEMPLATE_OBJECT_PLAYER1 1
alias TEMPLATE_OBJECT_MISSILE0 2
alias TEMPLATE_OBJECT_MISSILE1 3
alias TEMPLATE_OBJECT_BALL 4
alias TEMPLATE_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
alias TEMPLATE_PLAYER0_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER0]
alias TEMPLATE_PLAYER1_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER1]
alias TEMPLATE_MISSILE0_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE0]
alias TEMPLATE_MISSILE1_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE1]
alias TEMPLATE_BALL_X TEMPLATE_object_x[TEMPLATE_OBJECT_BALL]
alias TEMPLATE_PLAYER0_NUSIZ TEMPLATE_player0_nusiz
alias TEMPLATE_PLAYER1_NUSIZ TEMPLATE_player1_nusiz
alias TEMPLATE_INITIAL_COLUPF TEMPLATE_section1_colupf
alias TEMPLATE_INITIAL_COLUBK TEMPLATE_section1_colubk

extern const uint8_t TEMPLATE_playfield[48];
extern const uint8_t TEMPLATE_player0_colors[8];
extern const uint8_t TEMPLATE_player1_colors[8];

// Shared fine-motion conversion table. Indexes 1..15 correspond to the
// negative remainder left by the 15-pixel coarse-position loop.
bank1 page const uint8_t TEMPLATE_reposition_table[16] := {
   0x80,0x70,0x60,0x50,0x40,0x30,0x20,0x10,
   0x00,0xf0,0xe0,0xd0,0xc0,0xb0,0xa0,0x90
};

// Public state retains independent NUSIZ values. P0/P1 colors come from
// immutable eight-entry row-color tables supplied by the instance.
uint8_t TEMPLATE_object_x[5];
uint8_t TEMPLATE_player0_y;
uint8_t TEMPLATE_player1_y;
uint8_t TEMPLATE_missile1_height;
uint8_t TEMPLATE_missile1_y;
uint8_t TEMPLATE_ball_y;
uint8_t *TEMPLATE_player0_graphics;
uint8_t *TEMPLATE_player1_graphics;
uint8_t TEMPLATE_player0_height;
uint8_t TEMPLATE_player1_height;
uint8_t TEMPLATE_missile0_height;
uint8_t TEMPLATE_missile0_y;
uint8_t TEMPLATE_ball_height;
uint8_t TEMPLATE_player0_nusiz;
uint8_t TEMPLATE_player1_nusiz;

// Three compact vertical masks are built for each 16-line playfield row. Bits
// 0..6 are shifted into TIA D1; the eighth BL/M1/M0 bits are packed into the
// fourth byte as D1/D2/D3. Two seven-byte row caches hold the current and next
// row's four playfield bytes plus three D1-ready object masks.
uint8_t TEMPLATE_object_masks[48];
uint8_t TEMPLATE_row_cache[14];

require inline void TEMPLATE_init(void) {
   TEMPLATE_plan_init();
   TEMPLATE_slot_macros();
   TEMPLATE_targets_init();
}

bank1 page const uint8_t TEMPLATE_prepare_playfield[48] := {TEMPLATE_playfield[0],TEMPLATE_playfield[1],TEMPLATE_playfield[2],TEMPLATE_playfield[3],TEMPLATE_playfield[4],TEMPLATE_playfield[5],TEMPLATE_playfield[6],TEMPLATE_playfield[7],TEMPLATE_playfield[8],TEMPLATE_playfield[9],TEMPLATE_playfield[10],TEMPLATE_playfield[11],TEMPLATE_playfield[12],TEMPLATE_playfield[13],TEMPLATE_playfield[14],TEMPLATE_playfield[15],TEMPLATE_playfield[16],TEMPLATE_playfield[17],TEMPLATE_playfield[18],TEMPLATE_playfield[19],TEMPLATE_playfield[20],TEMPLATE_playfield[21],TEMPLATE_playfield[22],TEMPLATE_playfield[23],TEMPLATE_playfield[24],TEMPLATE_playfield[25],TEMPLATE_playfield[26],TEMPLATE_playfield[27],TEMPLATE_playfield[28],TEMPLATE_playfield[29],TEMPLATE_playfield[30],TEMPLATE_playfield[31],TEMPLATE_playfield[32],TEMPLATE_playfield[33],TEMPLATE_playfield[34],TEMPLATE_playfield[35],TEMPLATE_playfield[36],TEMPLATE_playfield[37],TEMPLATE_playfield[38],TEMPLATE_playfield[39],TEMPLATE_playfield[40],TEMPLATE_playfield[41],TEMPLATE_playfield[42],TEMPLATE_playfield[43],TEMPLATE_playfield[44],TEMPLATE_playfield[45],TEMPLATE_playfield[46],TEMPLATE_playfield[47]};
bank1 void TEMPLATE_prepare(void) {
   // Internal assembly helpers add one hidden JSR level.
   asm .callstackextra 4;
   // Build the three non-player schedules directly from public coordinates.
   // P0/P1 are biased only after preparation; BL/M0/M1 never need to mutate
   // their public Y values at all.
   asm jsr TEMPLATE_entry_prepare_object_masks;
   asm jmp TEMPLATE_entry_prepare_object_masks_done;
   asm .scope TEMPLATE_scope_prepare_object_masks;
   asm TEMPLATE_entry_prepare_object_masks:;
   asm .endscope;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #48;
   asm bcc.same @clear;
   // The Ball is biased one pair ahead for VDELBL staging, so the inclusive
   // preparation limit is 96 even though visible pair indices end at 95.
   asm lda #96;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   asm adc #2;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   // Missiles use one-pair bias: inclusive endpoint96 encodes visible pair95.
   asm lda #96;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_missile1_y;
   asm clc;
   asm adc #1;
   asm ldy.z TEMPLATE_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_missile0_y;
   asm clc;
   asm adc #1;
   asm ldy.z TEMPLATE_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;

   // No special terminal row is required: Ball, P0, and P1 all remain in
   // the ordinary raster pipeline through row twelve.
   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @no_wrap;
   asm beq.same @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq.same @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_low_ready;
   asm beq.same @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_high_ready;
   asm beq.same @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne.same @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @no_wrap_last_ready;
   asm beq.same @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @set_range;
   asm beq.same @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne.same @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs.same @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm .scope TEMPLATE_scope_prepare_object_masks_done;
   asm TEMPLATE_entry_prepare_object_masks_done:;
   asm .endscope;

   // Convert each three-byte row mask from D0..D7 into a D1-ready seven-bit
   // stream. The old D7 bits are packed in the fourth lane as BL/M1/M0 in
   // D1/D2/D3. That lane is consumed only by the final pair of each row.
   // These twelve fixed rows cost 336 cycles instead of the indexed loop's
   // 541. Spend bank1 ROM, not visible-phase slots or additional RIOT RAM.
   // Each ASL carry must reach its following ROL without a flag-changing
   // instruction between them; the packed D7 lane remains BL/M1/M0 in D1..D3.
   asm MACRO TEMPLATE_ENCODE_MASK_ROW row;
   asm asl.z TEMPLATE_object_masks + row + 2;
   asm lda #0;
   asm rol;
   asm asl.z TEMPLATE_object_masks + row + 1;
   asm rol;
   asm asl.z TEMPLATE_object_masks + row;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + row + 3;
   asm ENDM;
   asm TEMPLATE_ENCODE_MASK_ROW 0;
   asm TEMPLATE_ENCODE_MASK_ROW 4;
   asm TEMPLATE_ENCODE_MASK_ROW 8;
   asm TEMPLATE_ENCODE_MASK_ROW 12;
   asm TEMPLATE_ENCODE_MASK_ROW 16;
   asm TEMPLATE_ENCODE_MASK_ROW 20;
   asm TEMPLATE_ENCODE_MASK_ROW 24;
   asm TEMPLATE_ENCODE_MASK_ROW 28;
   asm TEMPLATE_ENCODE_MASK_ROW 32;
   asm TEMPLATE_ENCODE_MASK_ROW 36;
   asm TEMPLATE_ENCODE_MASK_ROW 40;
   asm TEMPLATE_ENCODE_MASK_ROW 44;

   // Prime cache A with row zero before reclaiming its compact source bytes as
   // visible-phase working Y coordinates and the current source-row offset.
   asm lda.a TEMPLATE_prepare_playfield;
   asm sta.z TEMPLATE_row_cache;
   asm lda.a TEMPLATE_prepare_playfield + 1;
   asm sta.z TEMPLATE_row_cache + 1;
   asm lda.a TEMPLATE_prepare_playfield + 2;
   asm sta.z TEMPLATE_row_cache + 2;
   asm lda.a TEMPLATE_prepare_playfield + 3;
   asm sta.z TEMPLATE_row_cache + 3;
   asm lda.z TEMPLATE_object_masks;
   asm sta.z TEMPLATE_row_cache + 4;
   asm lda.z TEMPLATE_object_masks + 1;
   asm sta.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_object_masks + 2;
   asm sta.z TEMPLATE_row_cache + 6;

   asm lda.a TEMPLATE_prepare_playfield + 4;
   asm sta.z TEMPLATE_row_cache + 7;
   asm lda.a TEMPLATE_prepare_playfield + 5;
   asm sta.z TEMPLATE_row_cache + 8;
   asm lda.a TEMPLATE_prepare_playfield + 6;
   asm sta.z TEMPLATE_row_cache + 9;
   asm lda.a TEMPLATE_prepare_playfield + 7;
   asm sta.z TEMPLATE_row_cache + 10;
   asm lda.z TEMPLATE_object_masks + 4;
   asm sta.z TEMPLATE_row_cache + 11;
   asm lda.z TEMPLATE_object_masks + 5;
   asm sta.z TEMPLATE_row_cache + 12;
   asm lda.z TEMPLATE_object_masks + 6;
   asm sta.z TEMPLATE_row_cache + 13;
   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_object_masks + 0;
   asm lda.z TEMPLATE_player1_y;
   asm clc;
   // Match P0's public Y origin.  The P1 half already pays its pipeline
   // decrement; the old +2 bias displaced equal public Y coordinates one
   // two-scanline pair below P0.
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 1;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 2;

   // Height+1 is the direct-count threshold used by the player paths. Restore
   // the public values in overscan after the visible phase is complete.
   asm inc.z TEMPLATE_player0_height;
   asm inc.z TEMPLATE_player1_height;

   // Position all five objects during VBLANK with the same calibrated
   // divide-by-fifteen RESP/HMxx sequence proven by player_color_192.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_ball_divide_loop;
   asm TEMPLATE_entry_ball_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #3;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_missile1_divide_loop;
   asm TEMPLATE_entry_missile1_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_missile1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #2;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_missile0_divide_loop;
   asm TEMPLATE_entry_missile0_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_missile0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #1;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_player1_divide_loop;
   asm TEMPLATE_entry_player1_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_player1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #0;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_player0_divide_loop;
   asm TEMPLATE_entry_player0_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_player0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm sta HMOVE;
   asm lda.z TEMPLATE_player0_nusiz;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_player1_nusiz;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;
   asm stx CXCLR;

}
require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare();
   COLUPF := TEMPLATE_section1_colupf;
   COLUBK := TEMPLATE_section1_colubk;
   asm tsx;
   asm stx.z TEMPLATE_saved_s;
   asm lda.a TEMPLATE_player1_colors;
   asm sta.z TEMPLATE_packed_p1_zero;
   asm lda #<{TEMPLATE_TARGET_0};
   asm sta.z TEMPLATE_packed_route + 0;
   asm lda #>{TEMPLATE_TARGET_0};
   asm sta.z TEMPLATE_packed_route + 1;
   asm lda #<{TEMPLATE_TARGET_1};
   asm sta.z TEMPLATE_packed_route + 2;
   asm lda #>{TEMPLATE_TARGET_1};
   asm sta.z TEMPLATE_packed_route + 3;

   // Stage row-zero BL/M1 from cache A. Their D1-ready bytes can be written
   // directly to the TIA before being shifted for the next pair.
   asm lda.z TEMPLATE_row_cache + 4;
   asm sta ENABL;
   asm lsr.z TEMPLATE_row_cache + 4;

   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same TEMPLATE_entry_first_player1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp TEMPLATE_entry_first_player1_ready;
   asm .scope TEMPLATE_scope_first_player1_zero;
   asm TEMPLATE_entry_first_player1_zero:;
   asm .endscope;
   asm lda #0;
   asm tay;
   asm .scope TEMPLATE_scope_first_player1_ready;
   asm TEMPLATE_entry_first_player1_ready:;
   asm .endscope;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.z TEMPLATE_row_cache + 5;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_row_cache + 5;
   asm lda.z TEMPLATE_row_cache + 6;
   asm sta ENAM0;

   // Prime the left half of row zero from cache A while output is blanked.
   asm lda.z TEMPLATE_row_cache;
   asm sta PF1;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
}

