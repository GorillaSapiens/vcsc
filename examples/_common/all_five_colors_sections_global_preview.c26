// This file is covered under CC0-1.0. See examples/LICENSE.txt.
// Experimental display-wide scheduler: alternating PF only, no score ABI.
// Include vcs.c26 and F8/mapper.c26, supply INSTANCE_playfield[48] and both
// eight-byte player colour tables, then instantiate with section heights/colours.
// Only the first two four-byte playfield patterns are folded into this kernel.
// Configure heights through instantiate arguments, not by selecting a kernel:
// they must be even, total 192, and have a nonempty first section.
//
// This file is maintained source. Builds invoke only the ordinary compiler,
// assembler and linker: no Perl planning, address-decoding bridge, byte-layout
// helper, generated renderer, cartridge RAM or mirrored sprite table is needed.
// The planner emits equates/macros only. Normal blocks choose palette/refill
// slots at assembly time; packed blocks exist only for actual phase-14 events.
// Whole procedures use final-link .same/.cross/page contracts for placement.
// Row-target labels preserve actual placement: equate aliases lose relocation.
// Helpers are inline, not required: inactive/zero-byte arms need no link usage.
// draw() retains the ancestor's cycle-3 entry and terminal WSYNC, but no public
// component ABI, arbitrary-PF or score budget is claimed here. The no-score
// interactive example currently uses 106/128 RAM bytes including its stack.
// Private .c26 compile-time scheduling front end. No RAM, ROM data or code.
// Existing assembler macros/equates do all planning after instantiation.
parameter section1_lines := 2;
parameter section2_lines := 2;
parameter section3_lines := 2;
parameter section4_lines := 2;
parameter section5_lines := 2;
parameter section6_lines := 2;
parameter section7_lines := 4;
parameter section8_lines := 176;

inline void TEMPLATE_plan_init(void) {
   asm TEMPLATE_END1 = TEMPLATE_section1_lines;
   asm TEMPLATE_END2 = TEMPLATE_END1 + TEMPLATE_section2_lines;
   asm TEMPLATE_END3 = TEMPLATE_END2 + TEMPLATE_section3_lines;
   asm TEMPLATE_END4 = TEMPLATE_END3 + TEMPLATE_section4_lines;
   asm TEMPLATE_END5 = TEMPLATE_END4 + TEMPLATE_section5_lines;
   asm TEMPLATE_END6 = TEMPLATE_END5 + TEMPLATE_section6_lines;
   asm TEMPLATE_END7 = TEMPLATE_END6 + TEMPLATE_section7_lines;
   asm TEMPLATE_END8 = TEMPLATE_END7 + TEMPLATE_section8_lines;
   asm .if TEMPLATE_section1_lines <= 0 || TEMPLATE_section2_lines < 0 || TEMPLATE_section3_lines < 0 || TEMPLATE_section4_lines < 0 || TEMPLATE_section5_lines < 0 || TEMPLATE_section6_lines < 0 || TEMPLATE_section7_lines < 0 || TEMPLATE_section8_lines < 0;
   asm .error "Global section heights must be nonnegative and first nonempty";
   asm .endif;
   asm .if TEMPLATE_END8 != 192;
   asm .error "Global section heights must total 192";
   asm .endif;
   asm .if {TEMPLATE_section1_lines | TEMPLATE_section2_lines | TEMPLATE_section3_lines | TEMPLATE_section4_lines | TEMPLATE_section5_lines | TEMPLATE_section6_lines | TEMPLATE_section7_lines | TEMPLATE_section8_lines} & 1;
   asm .error "Global section heights must be even";
   asm .endif;

   asm MACRO TEMPLATE_HIT out, end, parity, phase;
   asm out = {end > 0 && end < 192 && {{end >> 4} & 1} == parity && {{end & 15} >> 1} == phase};
   asm ENDM;
   asm MACRO TEMPLATE_BUSY out, parity, phase;
   asm TEMPLATE_HIT @h1, TEMPLATE_END1, parity, phase;
   asm TEMPLATE_HIT @h2, TEMPLATE_END2, parity, phase;
   asm TEMPLATE_HIT @h3, TEMPLATE_END3, parity, phase;
   asm TEMPLATE_HIT @h4, TEMPLATE_END4, parity, phase;
   asm TEMPLATE_HIT @h5, TEMPLATE_END5, parity, phase;
   asm TEMPLATE_HIT @h6, TEMPLATE_END6, parity, phase;
   asm TEMPLATE_HIT @h7, TEMPLATE_END7, parity, phase;
   asm out = @h1 || @h2 || @h3 || @h4 || @h5 || @h6 || @h7;
   asm ENDM;
   asm MACRO TEMPLATE_FREE out, parity;
   asm TEMPLATE_BUSY @b1, parity, 1;
   asm TEMPLATE_BUSY @b2, parity, 2;
   asm TEMPLATE_BUSY @b3, parity, 3;
   asm TEMPLATE_BUSY @b4, parity, 4;
   asm TEMPLATE_BUSY @b5, parity, 5;
   asm TEMPLATE_BUSY @b6, parity, 6;
   asm out = {!@b1} | {{!@b2} << 1} | {{!@b3} << 2} | {{!@b4} << 3} | {{!@b5} << 4} | {{!@b6} << 5};
   asm ENDM;
   asm MACRO TEMPLATE_COUNT out, mask;
   asm out = {{mask & 1} != 0} + {{mask & 2} != 0} + {{mask & 4} != 0} + {{mask & 8} != 0} + {{mask & 16} != 0} + {{mask & 32} != 0};
   asm ENDM;
   asm MACRO TEMPLATE_NTH out, mask, n;
   asm TEMPLATE_COUNT @c1, {mask & 1};
   asm TEMPLATE_COUNT @c2, {mask & 3};
   asm TEMPLATE_COUNT @c3, {mask & 7};
   asm TEMPLATE_COUNT @c4, {mask & 15};
   asm TEMPLATE_COUNT @c5, {mask & 31};
   asm out = {{mask & 1} != 0 && n == 0} + 2*{{mask & 2} != 0 && n == @c1} + 3*{{mask & 4} != 0 && n == @c2} + 4*{{mask & 8} != 0 && n == @c3} + 5*{{mask & 16} != 0 && n == @c4} + 6*{{mask & 32} != 0 && n == @c5};
   asm ENDM;
   asm MACRO TEMPLATE_BOUND out, end;
   asm out = end > 0 && end < 192 && {end & 15} == 0;
   asm ENDM;
   asm TEMPLATE_BOUND TEMPLATE_BOUND1, TEMPLATE_END1;
   asm TEMPLATE_BOUND TEMPLATE_BOUND2, TEMPLATE_END2;
   asm TEMPLATE_BOUND TEMPLATE_BOUND3, TEMPLATE_END3;
   asm TEMPLATE_BOUND TEMPLATE_BOUND4, TEMPLATE_END4;
   asm TEMPLATE_BOUND TEMPLATE_BOUND5, TEMPLATE_END5;
   asm TEMPLATE_BOUND TEMPLATE_BOUND6, TEMPLATE_END6;
   asm TEMPLATE_BOUND TEMPLATE_BOUND7, TEMPLATE_END7;
   asm TEMPLATE_BOUNDARY = TEMPLATE_BOUND1 || TEMPLATE_BOUND2 || TEMPLATE_BOUND3 || TEMPLATE_BOUND4 || TEMPLATE_BOUND5 || TEMPLATE_BOUND6 || TEMPLATE_BOUND7;
   asm TEMPLATE_FREE TEMPLATE_BASE_A, 0;
   asm TEMPLATE_FREE TEMPLATE_BASE_B, 1;
   // Reserve cross-row M1 refills before route bytes. If one parity has no
   // free phase, the other has all six; its pair-six dead shift is the fallback.
   asm .if TEMPLATE_BOUNDARY;
   asm TEMPLATE_NTH TEMPLATE_RESERVE_A, TEMPLATE_BASE_A, 0;
   asm TEMPLATE_NTH TEMPLATE_RESERVE_B, TEMPLATE_BASE_B, 0;
   asm .else;
   asm TEMPLATE_RESERVE_A = 0;
   asm TEMPLATE_RESERVE_B = 0;
   asm .endif;
   asm TEMPLATE_LATE_A = TEMPLATE_BOUNDARY && TEMPLATE_BASE_B == 0;
   asm TEMPLATE_LATE_B = TEMPLATE_BOUNDARY && TEMPLATE_BASE_A == 0;
   asm TEMPLATE_AVAILABLE_A = TEMPLATE_BASE_A & ~{{1 << TEMPLATE_RESERVE_A} >> 1} & ~{32*TEMPLATE_LATE_A};
   asm TEMPLATE_AVAILABLE_B = TEMPLATE_BASE_B & ~{{1 << TEMPLATE_RESERVE_B} >> 1} & ~{32*TEMPLATE_LATE_B};
   asm TEMPLATE_COUNT TEMPLATE_COUNT_A, TEMPLATE_AVAILABLE_A;
   asm TEMPLATE_COUNT TEMPLATE_COUNT_B, TEMPLATE_AVAILABLE_B;
   asm TEMPLATE_OWN_A = {TEMPLATE_COUNT_A < 2}*TEMPLATE_COUNT_A + {TEMPLATE_COUNT_A >= 2}*2;
   asm TEMPLATE_OWN_B = {TEMPLATE_COUNT_B < 2}*TEMPLATE_COUNT_B + {TEMPLATE_COUNT_B >= 2}*2;
   asm MACRO TEMPLATE_ROUTE out_parity, out_phase, out_advance, dest, byte;
   asm .if dest == 0;
   asm @own = TEMPLATE_OWN_A;
   asm @other_own = TEMPLATE_OWN_B;
   asm .else;
   asm @own = TEMPLATE_OWN_B;
   asm @other_own = TEMPLATE_OWN_A;
   asm .endif;
   asm out_parity = {byte < @own}*dest + {byte >= @own}*{1-dest};
   asm @index = {byte < @own}*byte + {byte >= @own}*{@other_own + byte - @own};
   asm .if out_parity == 0;
   asm TEMPLATE_NTH out_phase, TEMPLATE_AVAILABLE_A, @index;
   asm .else;
   asm TEMPLATE_NTH out_phase, TEMPLATE_AVAILABLE_B, @index;
   asm .endif;
   asm out_advance = out_parity != dest;
   asm ENDM;
   asm TEMPLATE_ROUTE TEMPLATE_ROUTE_A_LO_PARITY, TEMPLATE_ROUTE_A_LO_PHASE, TEMPLATE_ROUTE_A_LO_ADVANCE, 0, 0;
   asm TEMPLATE_ROUTE TEMPLATE_ROUTE_A_HI_PARITY, TEMPLATE_ROUTE_A_HI_PHASE, TEMPLATE_ROUTE_A_HI_ADVANCE, 0, 1;
   asm TEMPLATE_ROUTE TEMPLATE_ROUTE_B_LO_PARITY, TEMPLATE_ROUTE_B_LO_PHASE, TEMPLATE_ROUTE_B_LO_ADVANCE, 1, 0;
   asm TEMPLATE_ROUTE TEMPLATE_ROUTE_B_HI_PARITY, TEMPLATE_ROUTE_B_HI_PHASE, TEMPLATE_ROUTE_B_HI_ADVANCE, 1, 1;
   asm MACRO TEMPLATE_M1 out_parity, out_phase, out_advance, out_late, dest;
   asm .if dest == 0;
   asm @other = TEMPLATE_BASE_B;
   asm .else;
   asm @other = TEMPLATE_BASE_A;
   asm .endif;
   asm .if @other != 0;
   asm out_parity = 1-dest;
   asm TEMPLATE_NTH out_phase, @other, 0;
   asm out_advance = 1;
   asm out_late = 0;
   asm .else;
   asm out_parity = dest;
   asm out_phase = 6;
   asm out_advance = 2;
   asm out_late = 1;
   asm .endif;
   asm ENDM;
   asm TEMPLATE_M1 TEMPLATE_M1_A_PARITY, TEMPLATE_M1_A_PHASE, TEMPLATE_M1_A_ADVANCE, TEMPLATE_M1_A_LATE, 0;
   asm TEMPLATE_M1 TEMPLATE_M1_B_PARITY, TEMPLATE_M1_B_PHASE, TEMPLATE_M1_B_ADVANCE, TEMPLATE_M1_B_LATE, 1;
}

