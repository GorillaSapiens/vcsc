   asm ldy.z TEMPLATE_object_masks + 1;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 1;
   asm lda.z TEMPLATE_row_cache + 9;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 10;
   asm sta PF1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same TEMPLATE_entry_B_boundary_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp TEMPLATE_entry_B_boundary_p1_ready;
   asm .scope TEMPLATE_scope_B_boundary_p1_zero;
   asm TEMPLATE_entry_B_boundary_p1_zero:;
   asm .endscope;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm .scope TEMPLATE_scope_B_boundary_p1_ready;
   asm TEMPLATE_entry_B_boundary_p1_ready:;
   asm .endscope;
   asm sta GRP1;
   asm lda.zx TEMPLATE_object_masks + 5,x;
   asm sta ENAM1;
   asm lsr;
   asm sta.z TEMPLATE_row_cache + 5;
   PF1 := TEMPLATE_even_pf0;
   asm lda.z TEMPLATE_row_cache + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_object_masks + 0;
   asm dey;
   asm sty.z TEMPLATE_object_masks + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm inx;
   asm inx;
   asm inx;
   asm lda.z TEMPLATE_row_cache + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_row_cache + 3;
   asm sta PF1;
   asm bcs.same TEMPLATE_entry_B_firstA_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp TEMPLATE_entry_B_firstA_p0_ready;
   asm .scope TEMPLATE_scope_B_firstA_p0_zero;
   asm TEMPLATE_entry_B_firstA_p0_zero:;
   asm .endscope;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm .scope TEMPLATE_scope_B_firstA_p0_ready;
   asm TEMPLATE_entry_B_firstA_p0_ready:;
   asm .endscope;
   asm sta GRP0;
   asm inx;
   asm txs;
   asm jmp TEMPLATE_entry_A_u1;

