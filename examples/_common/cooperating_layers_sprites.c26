   DEMO_GLYPH(0x18,0x3c,0x3c,0x7e,0x7e,0xdb,0x24,0),
   DEMO_GLYPH(0x18,0x3c,0x3c,0x7e,0x7e,0xdb,0x18,0),
   DEMO_GLYPH(0x18,0x3c,0x3c,0x7e,0x7e,0xdb,0x3c,0),
   DEMO_GLYPH(0x18,0x3c,0x3c,0x7e,0x7e,0xdb,0x18,0)
};
