inline void TEMPLATE_schedule_row_10(void) {
   asm TEMPLATE_EVENT_10_1 = {TEMPLATE_END_0 >= 162 && TEMPLATE_END_0 <= 174};
   asm TEMPLATE_EVENT_10_2 = {TEMPLATE_END_1 >= 162 && TEMPLATE_END_1 <= 174};
   asm TEMPLATE_EVENT_10_3 = {TEMPLATE_END_2 >= 162 && TEMPLATE_END_2 <= 174};
   asm TEMPLATE_EVENT_10_4 = {TEMPLATE_END_3 >= 162 && TEMPLATE_END_3 <= 174};
   asm TEMPLATE_EVENT_10_5 = {TEMPLATE_END_4 >= 162 && TEMPLATE_END_4 <= 174};
   asm TEMPLATE_EVENT_10_6 = {TEMPLATE_END_5 >= 162 && TEMPLATE_END_5 <= 174};
   asm TEMPLATE_EVENT_10_7 = {TEMPLATE_END_6 >= 162 && TEMPLATE_END_6 <= 174};
   asm TEMPLATE_EVENT_10_8 = {TEMPLATE_END_7 >= 162 && TEMPLATE_END_7 <= 174};
   asm TEMPLATE_ORD_10 = 7 - TEMPLATE_EVENT_10_1 - TEMPLATE_EVENT_10_2 - TEMPLATE_EVENT_10_3 - TEMPLATE_EVENT_10_4 - TEMPLATE_EVENT_10_5 - TEMPLATE_EVENT_10_6 - TEMPLATE_EVENT_10_7 - TEMPLATE_EVENT_10_8;
}
inline void TEMPLATE_schedule_row_11(void) {
   asm TEMPLATE_EVENT_11_1 = {TEMPLATE_END_0 >= 178 && TEMPLATE_END_0 <= 190};
   asm TEMPLATE_EVENT_11_2 = {TEMPLATE_END_1 >= 178 && TEMPLATE_END_1 <= 190};
   asm TEMPLATE_EVENT_11_3 = {TEMPLATE_END_2 >= 178 && TEMPLATE_END_2 <= 190};
   asm TEMPLATE_EVENT_11_4 = {TEMPLATE_END_3 >= 178 && TEMPLATE_END_3 <= 190};
   asm TEMPLATE_EVENT_11_5 = {TEMPLATE_END_4 >= 178 && TEMPLATE_END_4 <= 190};
   asm TEMPLATE_EVENT_11_6 = {TEMPLATE_END_5 >= 178 && TEMPLATE_END_5 <= 190};
   asm TEMPLATE_EVENT_11_7 = {TEMPLATE_END_6 >= 178 && TEMPLATE_END_6 <= 190};
   asm TEMPLATE_EVENT_11_8 = {TEMPLATE_END_7 >= 178 && TEMPLATE_END_7 <= 190};
   asm TEMPLATE_ORD_11 = 7 - TEMPLATE_EVENT_11_1 - TEMPLATE_EVENT_11_2 - TEMPLATE_EVENT_11_3 - TEMPLATE_EVENT_11_4 - TEMPLATE_EVENT_11_5 - TEMPLATE_EVENT_11_6 - TEMPLATE_EVENT_11_7 - TEMPLATE_EVENT_11_8;
}
inline void TEMPLATE_schedule(void) {
   TEMPLATE_schedule_header();
   TEMPLATE_schedule_row_0();
   TEMPLATE_schedule_row_1();
   TEMPLATE_schedule_row_2();
   TEMPLATE_schedule_row_3();
   TEMPLATE_schedule_row_4();
   TEMPLATE_schedule_row_5();
   TEMPLATE_schedule_row_6();
   TEMPLATE_schedule_row_7();
   TEMPLATE_schedule_row_8();
   TEMPLATE_schedule_row_9();
   TEMPLATE_schedule_row_10();
   TEMPLATE_schedule_row_11();
}
// Object controls and preparation below retain the certified ancestor's
// behaviour. Do not copy its public budget declarations onto this private path.

alias TEMPLATE_OBJECT_PLAYER0 0
alias TEMPLATE_OBJECT_PLAYER1 1
alias TEMPLATE_OBJECT_MISSILE0 2
alias TEMPLATE_OBJECT_MISSILE1 3
alias TEMPLATE_OBJECT_BALL 4
alias TEMPLATE_SPRITE_GLYPH(a,b,c,d,e,f,g,h) h,g,f,e,d,c,b,a
alias TEMPLATE_PLAYER0_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER0]
alias TEMPLATE_PLAYER1_X TEMPLATE_object_x[TEMPLATE_OBJECT_PLAYER1]
alias TEMPLATE_MISSILE0_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE0]
alias TEMPLATE_MISSILE1_X TEMPLATE_object_x[TEMPLATE_OBJECT_MISSILE1]
alias TEMPLATE_BALL_X TEMPLATE_object_x[TEMPLATE_OBJECT_BALL]
alias TEMPLATE_PLAYER0_NUSIZ TEMPLATE_player0_nusiz
alias TEMPLATE_PLAYER1_NUSIZ TEMPLATE_player1_nusiz
alias TEMPLATE_INITIAL_COLUPF TEMPLATE_section1_colupf
alias TEMPLATE_INITIAL_COLUBK TEMPLATE_section1_colubk

extern const uint8_t TEMPLATE_playfield[48];
extern const uint8_t TEMPLATE_player0_colors[8];
extern const uint8_t TEMPLATE_player1_colors[8];

// Shared fine-motion conversion table. Indexes 1..15 correspond to the
// negative remainder left by the 15-pixel coarse-position loop.
bank1 page const uint8_t TEMPLATE_reposition_table[16] := {
   0x80,0x70,0x60,0x50,0x40,0x30,0x20,0x10,
   0x00,0xf0,0xe0,0xd0,0xc0,0xb0,0xa0,0x90
};

// Public state retains independent NUSIZ values. P0/P1 colors come from
// immutable eight-entry row-color tables supplied by the instance.
uint8_t TEMPLATE_object_x[5];
uint8_t TEMPLATE_player0_y;
uint8_t TEMPLATE_player1_y;
uint8_t TEMPLATE_missile1_height;
uint8_t TEMPLATE_missile1_y;
uint8_t TEMPLATE_ball_y;
uint8_t *TEMPLATE_player0_graphics;
uint8_t *TEMPLATE_player1_graphics;
uint8_t TEMPLATE_player0_height;
uint8_t TEMPLATE_player1_height;
uint8_t TEMPLATE_missile0_height;
uint8_t TEMPLATE_missile0_y;
uint8_t TEMPLATE_ball_height;
uint8_t TEMPLATE_player0_nusiz;
uint8_t TEMPLATE_player1_nusiz;

// BL and M1 retain eight raw bits per row. M0 is shifted to a D1-ready stream;
// its final bit lives in lane three. The two cache bytes are player counters.
uint8_t TEMPLATE_object_masks[48];
uint8_t TEMPLATE_dispatch[2];
uint8_t TEMPLATE_row_cache[2];


require inline void TEMPLATE_init(void) {
}

bank1 void TEMPLATE_prepare(void) {
   // Internal assembly helpers add one hidden JSR level.
   asm .callstackextra 4;
   // Build the three non-player schedules directly from public coordinates.
   // P0/P1 are biased only after preparation; BL/M0/M1 never need to mutate
   // their public Y values at all.
   asm jsr TEMPLATE_entry_prepare_object_masks;
   asm jmp TEMPLATE_entry_prepare_object_masks_done;
   asm .scope TEMPLATE_scope_prepare_object_masks;
   asm TEMPLATE_entry_prepare_object_masks:;
   asm .endscope;
   asm ldy #0;
   asm ldx #0;
   asm @clear:;
   asm sty.zx TEMPLATE_object_masks,x;
   asm sty.zx TEMPLATE_object_masks + 1,x;
   asm sty.zx TEMPLATE_object_masks + 2,x;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm cpx #48;
   asm bcc.same @clear;
   // The Ball is biased one pair ahead for VDELBL staging, so the inclusive
   // preparation limit is 96 even though visible pair indices end at 95.
   asm lda #96;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_ball_y;
   asm clc;
   asm adc #2;
   asm ldy.z TEMPLATE_ball_height;
   asm ldx #0;
   asm jsr @prepare_one;
   // Missiles use one-pair bias: inclusive endpoint96 encodes visible pair95.
   asm lda #96;
   asm sta.z TEMPLATE_object_masks + 31;
   asm lda.z TEMPLATE_missile1_y;
   asm clc;
   asm adc #1;
   asm ldy.z TEMPLATE_missile1_height;
   asm ldx #1;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_missile0_y;
   asm clc;
   asm adc #1;
   asm ldy.z TEMPLATE_missile0_height;
   asm ldx #2;
   asm jsr @prepare_one;
   asm lda.z TEMPLATE_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 11;
   asm lda.z TEMPLATE_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda #0;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 23;

   // No special terminal row is required: Ball, P0, and P1 all remain in
   // the ordinary raster pipeline through row twelve.
   asm rts;

   asm @prepare_one:;
   asm sta.z TEMPLATE_object_masks + 11;
   asm stx.z TEMPLATE_object_masks + 3;
   asm sty.z TEMPLATE_object_masks + 35;
   asm sec;
   asm sbc.z TEMPLATE_object_masks + 35;
   asm sta.z TEMPLATE_object_masks + 7;
   asm sta.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @no_wrap;
   asm beq.same @no_wrap;
   asm lda.z TEMPLATE_object_masks + 11;
   asm beq.same @wrapped_high;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_low_ready;
   asm beq.same @wrapped_low_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @wrapped_low_ready:;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm jsr @set_range;
   asm @wrapped_high:;
   asm lda.z TEMPLATE_object_masks + 39;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @wrapped_high_ready;
   asm beq.same @wrapped_high_ready;
   asm rts;
   asm @wrapped_high_ready:;
   asm sta.z TEMPLATE_object_masks + 7;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm jsr @set_range;
   asm rts;
   asm @no_wrap:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm bne.same @no_wrap_first_ready;
   asm lda #1;
   asm sta.z TEMPLATE_object_masks + 7;
   asm @no_wrap_first_ready:;
   asm lda.z TEMPLATE_object_masks + 11;
   asm cmp.z TEMPLATE_object_masks + 31;
   asm bcc.same @no_wrap_last_ready;
   asm beq.same @no_wrap_last_ready;
   asm lda.z TEMPLATE_object_masks + 31;
   asm sta.z TEMPLATE_object_masks + 11;
   asm @no_wrap_last_ready:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm cmp.z TEMPLATE_object_masks + 11;
   asm bcc.same @set_range;
   asm beq.same @set_range;
   asm rts;
   asm @set_range:;
   asm lda.z TEMPLATE_object_masks + 7;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @start_bits,x;
   asm sta.z TEMPLATE_object_masks + 23;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 15;
   asm lda.z TEMPLATE_object_masks + 11;
   asm sec;
   asm sbc #1;
   asm tay;
   asm and #7;
   asm tax;
   asm lda @end_bits,x;
   asm sta.z TEMPLATE_object_masks + 27;
   asm tya;
   asm lsr;
   asm lsr;
   asm lsr;
   asm sta.z TEMPLATE_object_masks + 19;
   asm lda.z TEMPLATE_object_masks + 15;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z TEMPLATE_object_masks + 3;
   asm tax;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bne.same @range_many;
   asm lda.z TEMPLATE_object_masks + 23;
   asm and.z TEMPLATE_object_masks + 27;
   asm ora.zx TEMPLATE_object_masks,x;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @range_many:;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 23;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm @range_middle:;
   asm lda.z TEMPLATE_object_masks + 15;
   asm cmp.z TEMPLATE_object_masks + 19;
   asm bcs.same @range_last;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda #$ff;
   asm sta.zx TEMPLATE_object_masks,x;
   asm inc.z TEMPLATE_object_masks + 15;
   asm jmp @range_middle;
   asm @range_last:;
   asm txa;
   asm clc;
   asm adc #4;
   asm tax;
   asm lda.zx TEMPLATE_object_masks,x;
   asm ora.z TEMPLATE_object_masks + 27;
   asm sta.zx TEMPLATE_object_masks,x;
   asm rts;
   asm @start_bits:;
   asm .byte $ff,$fe,$fc,$f8,$f0,$e0,$c0,$80;
   asm @end_bits:;
   asm .byte $01,$03,$07,$0f,$1f,$3f,$7f,$ff;
   asm .scope TEMPLATE_scope_prepare_object_masks_done;
   asm TEMPLATE_entry_prepare_object_masks_done:;
   asm .endscope;

   asm asl.z TEMPLATE_object_masks + 2;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 3;
   asm asl.z TEMPLATE_object_masks + 6;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 7;
   asm asl.z TEMPLATE_object_masks + 10;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 11;
   asm asl.z TEMPLATE_object_masks + 14;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 15;
   asm asl.z TEMPLATE_object_masks + 18;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 19;
   asm asl.z TEMPLATE_object_masks + 22;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 23;
   asm asl.z TEMPLATE_object_masks + 26;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 27;
   asm asl.z TEMPLATE_object_masks + 30;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 31;
   asm asl.z TEMPLATE_object_masks + 34;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 35;
   asm asl.z TEMPLATE_object_masks + 38;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 39;
   asm asl.z TEMPLATE_object_masks + 42;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 43;
   asm asl.z TEMPLATE_object_masks + 46;
   asm lda #0;
   asm rol;
   asm asl;
   asm sta.z TEMPLATE_object_masks + 47;
   asm lda.z TEMPLATE_player0_y;
   asm sta.z TEMPLATE_row_cache + 0;
   asm lda.z TEMPLATE_player1_y;
   asm clc;
   // Match P0's public Y origin.  The P1 half already pays its pipeline
   // decrement; the old +2 bias displaced equal public Y coordinates one
   // two-scanline pair below P0.
   asm adc #1;
   asm sta.z TEMPLATE_row_cache + 1;

   // Height+1 is the direct-count threshold used by the player paths. Restore
   // the public values in overscan after the visible phase is complete.
   asm inc.z TEMPLATE_player0_height;
   asm inc.z TEMPLATE_player1_height;

   // Position all five objects during VBLANK with the same calibrated
   // divide-by-fifteen RESP/HMxx sequence proven by player_color_192.
   asm sta WSYNC;
   asm ldx #4;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_ball_divide_loop;
   asm TEMPLATE_entry_ball_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_ball_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #3;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_missile1_divide_loop;
   asm TEMPLATE_entry_missile1_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_missile1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #2;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_missile0_divide_loop;
   asm TEMPLATE_entry_missile0_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_missile0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #1;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_player1_divide_loop;
   asm TEMPLATE_entry_player1_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_player1_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm sta WSYNC;
   asm ldx #0;
   asm bit.z $00;
   asm lda.zx TEMPLATE_object_x,x;
   asm sec;
   asm .scope TEMPLATE_scope_player0_divide_loop;
   asm TEMPLATE_entry_player0_divide_loop:;
   asm .endscope;
   asm sbc #15;
   asm bcs.same TEMPLATE_entry_player0_divide_loop;
   asm nop;
   asm nop;
   asm sta RESP0,x;
   asm tay;
   asm lda TEMPLATE_reposition_table + 16 - 256,y;
   asm sta HMP0,x;

   asm sta WSYNC;
   asm sta HMOVE;
   asm lda.z TEMPLATE_player0_nusiz;
   asm sta NUSIZ0;
   asm lda.z TEMPLATE_player1_nusiz;
   asm sta NUSIZ1;
   asm lda #1;
   asm sta VDELBL;
   asm sta VDELP0;
   asm ldx #0;
   asm stx GRP0;
   asm stx GRP1;
   asm stx CXCLR;


   asm lda.z TEMPLATE_object_masks;
   asm asl;
   asm sta ENABL;
   asm lda.z TEMPLATE_object_masks + 1;
   asm asl;
   asm sta ENAM1;
   asm lda.z TEMPLATE_object_masks + 2;
   asm sta ENAM0;
   TEMPLATE_pf_left_0();
   COLUPF := TEMPLATE_section1_colupf;
   COLUBK := TEMPLATE_section1_colubk;
}
bank0 void TEMPLATE_prime_player1(void) {
   asm lda #>TEMPLATE_dispatch_terminal;
   asm sta.z TEMPLATE_dispatch + 1;
   asm ldy.z TEMPLATE_row_cache + 1;
   asm dey;
   asm sty.z TEMPLATE_row_cache + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @first_p1_zero;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @first_p1_ready;
   asm @first_p1_zero:;
   asm lda #0;
   asm tay;
   asm @first_p1_ready:;
   asm sta GRP1;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
}
require inline void TEMPLATE_vblank(void) {
   TEMPLATE_prepare();
   TEMPLATE_prime_player1();
}
// First-row handoff proof. Six ordinary pairs repeat with a local X counter;
// the seventh pair retains the ancestor's distinct P0/P1 clipping phases.
// Dispatch low is dead throughout this local loop: stage Ball there, then M1.
// Row1's normal body reloads dispatch low before its next indirect jump. X holds
// the next PF colour until STX COLUPF, without changing inactive P1 colour timing.
// Subsequent rows still use the fixed-pointer scheduler and remain unfinished.
inline void TEMPLATE_emit_row0_handoff(void) {
   asm .proc TEMPLATE_row0_handoff;
   asm .scope TEMPLATE_normal_0_anchor;
   asm TEMPLATE_normal_0:;
   asm .endscope;
   asm @normal:;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_object_masks + 2;
   asm sta ENAM0;
   TEMPLATE_terminal_pf1_abs := TEMPLATE_playfield[0];
   asm @normal_left_pf_barrier:;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[1];
   asm ldy.z TEMPLATE_row_cache + 1;
   asm dey;
   asm sty.z TEMPLATE_row_cache + 1;
   // Shift before CPY: LSR must not overwrite the clipping comparison's C.
   asm lsr.z TEMPLATE_object_masks + 2;
   asm nop;
   asm cpy.z TEMPLATE_player1_height;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[2];
   asm lda.a TEMPLATE_pf_data_0 + 3;
   asm sta PF1;
   asm lda.z TEMPLATE_object_masks + 0;
   asm sta ENABL;
   asm bcc.same @normal_p1_active;
   asm lda #0;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm bcs.same @normal_p1_ready;
   asm @normal_p1_active:;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm @normal_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_object_masks + 1;
   asm sta ENAM1;
   asm lsr.z TEMPLATE_object_masks + 1;
   TEMPLATE_terminal_pf1_abs := TEMPLATE_playfield[0];
   asm @normal_second_left_pf_barrier:;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[1];
   asm lsr.z TEMPLATE_object_masks + 0;
   asm ldy.z TEMPLATE_row_cache + 0;
   asm dey;
   asm sty.z TEMPLATE_row_cache + 0;
   asm cpy.z TEMPLATE_player0_height;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[2];
   asm lda.a TEMPLATE_pf_data_0 + 3;
   asm sta PF1;
   asm bcs.same @normal_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @normal_p0_ready;
   asm @normal_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @normal_p0_ready:;
   asm sta GRP0;
   asm dex;
   asm beq.same @last_pair;
   asm jmp @normal;
   asm @last_pair:;
   asm nop;
   asm lda.ay TEMPLATE_player0_colors,y;
   asm sta COLUP0;
   asm lda.z TEMPLATE_object_masks + 2;
   asm sta ENAM0;
   TEMPLATE_terminal_pf1_abs := TEMPLATE_playfield[0];
   asm @last_left_pf_barrier:;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[1];
   asm lda.z TEMPLATE_object_masks + 0;
   asm sta ENABL;
   asm lda.z TEMPLATE_object_masks + 4;
