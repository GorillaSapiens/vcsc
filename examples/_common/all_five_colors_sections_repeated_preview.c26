alias TEMPLATE_C_END7 (TEMPLATE_section1_lines + TEMPLATE_section2_lines + TEMPLATE_section3_lines + TEMPLATE_section4_lines + TEMPLATE_section5_lines + TEMPLATE_section6_lines + TEMPLATE_section7_lines)
alias TEMPLATE_FEED_pf(feed_line) ((feed_line) < TEMPLATE_C_END1 ? TEMPLATE_section1_colupf : ((feed_line) < TEMPLATE_C_END2 ? TEMPLATE_section2_colupf : ((feed_line) < TEMPLATE_C_END3 ? TEMPLATE_section3_colupf : ((feed_line) < TEMPLATE_C_END4 ? TEMPLATE_section4_colupf : ((feed_line) < TEMPLATE_C_END5 ? TEMPLATE_section5_colupf : ((feed_line) < TEMPLATE_C_END6 ? TEMPLATE_section6_colupf : ((feed_line) < TEMPLATE_C_END7 ? TEMPLATE_section7_colupf : TEMPLATE_section8_colupf)))))))
