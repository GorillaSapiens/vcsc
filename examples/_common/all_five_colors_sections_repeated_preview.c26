   TEMPLATE_terminal_pf1_abs := TEMPLATE_playfield[3];
   asm bit.z $00;
   asm ldy.z TEMPLATE_row_cache + 1;
   asm dey;
   asm sty.z TEMPLATE_row_cache + 1;
   asm cpy.z TEMPLATE_player1_height;
   asm bcs.same @last_p1_zero;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda.iy (TEMPLATE_player1_graphics),y;
   asm jmp @last_p1_ready;
   asm @last_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm @last_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_object_masks + 1;
   asm sta ENAM1;
   asm bit.z $00;
   TEMPLATE_terminal_pf1_abs := TEMPLATE_playfield[0];
   asm @last_second_left_pf_barrier:;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[1];
   asm ldy.z TEMPLATE_row_cache + 0;
   asm dey;
   asm cpy.z TEMPLATE_player0_height;
   asm lda.a TEMPLATE_pf_data_0 + 2;
   asm sta PF2;
   asm lda.a TEMPLATE_pf_data_0 + 3;
   asm sta PF1;
   asm sty.z TEMPLATE_row_cache + 0;
   asm bcc.same @last_p0_active;
   asm lda #0;
   asm tay;
   asm bit.a CXM0P;
   asm nop;
   asm bcs.same @last_p0_ready;
   asm @last_p0_active:;
