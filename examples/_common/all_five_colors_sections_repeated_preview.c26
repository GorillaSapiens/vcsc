   asm @boundary_p1_zero:;
   asm ldy #0;
   asm lda.ay TEMPLATE_player1_colors,y;
   asm sta COLUP1;
   asm lda #0;
   asm bit.z $00;
   asm @boundary_p1_ready:;
   asm sta GRP1;
   asm lda.z TEMPLATE_dispatch;
   asm sta ENAM1;
   asm stx COLUPF;
   COLUBK := TEMPLATE_FEED_bk(16);
   asm @boundary_bk_pf_barrier:;
   TEMPLATE_terminal_pf1_abs := TEMPLATE_playfield[4];
   asm @boundary_next_left_pf_barrier:;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[5];
   asm ldy.z TEMPLATE_row_cache + 0;
   asm dey;
   asm sty.z TEMPLATE_row_cache + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm bit.z $00;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[6];
   asm lda.a TEMPLATE_pf_data_1 + 3;
   asm sta PF1;
   asm bcs.same @first_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp @first_p0_ready;
   asm @first_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @first_p0_ready:;
   asm sta GRP0;
   asm ldx #86;
