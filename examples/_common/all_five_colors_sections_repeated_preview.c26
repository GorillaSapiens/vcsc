// This file is covered under CC0-1.0. See examples/LICENSE.txt.
// Experimental repeated two-scanline combined-colour preview, not a renderer ABI.
// Geometry is scheduled natively from the eight positive, even C26 parameters.
// Each PF row has a reusable pair body; fine colour boundaries use event bodies.
// Dispatch uses two fixed RAM bytes and a page-contained ROM trampoline page,
// never a growing RAM return vector, cartridge RAM, or mirrored sprite tables.
// The hardware stack remains available throughout drawing and bank crossings.
// Twelve distinct PF rows and the seven-seam default geometry pass the existing
// exact-pixel probe at default positions. Extended/edge control probes still expose
// row-ending P0 colour and P1 clipping timing differences; see the leaf README.
// Row-aligned layouts now use a corrected first-row handoff, not a full fix.
// A final two-line section also has corrected terminal P0/P1/M0/PF timing.
// Other late clipping handoffs and general fine-event controls remain unfinished.
parameter section1_lines := 2;
parameter section2_lines := 2;
parameter section3_lines := 2;
parameter section4_lines := 2;
parameter section5_lines := 2;
parameter section6_lines := 2;
parameter section7_lines := 4;
parameter section8_lines := 176;

parameter section1_colupf := 46;
parameter section1_colubk := 132;
parameter section2_colupf := 70;
parameter section2_colubk := 194;
parameter section3_colupf := 142;
parameter section3_colubk := 38;
parameter section4_colupf := 174;
parameter section4_colubk := 100;
parameter section5_colupf := 22;
parameter section5_colubk := 180;
parameter section6_colupf := 102;
parameter section6_colubk := 52;
parameter section7_colupf := 214;
parameter section7_colubk := 4;
parameter section8_colupf := 246;
parameter section8_colubk := 116;
