require inline void TEMPLATE_draw(void) {
   TEMPLATE_schedule();
   // Row zero enters at the scheduler's cycle-3 handoff.  The first visible
   // P0 half is timed to place the first cached pair at cycle 75; every normal
   // pair thereafter is exactly 152 cycles.
   asm bit.z $00;
   asm bit.z $00;
   asm bit.z $00;
   PF1 := TEMPLATE_playfield[0];
   asm nop;
   asm lda.a TEMPLATE_pf_data_0 + 1;
   asm sta PF2;
   asm ldy.z TEMPLATE_row_cache + 0;
   asm dey;
   asm sty.z TEMPLATE_row_cache + 0;
   asm cpy.z TEMPLATE_player0_height;
   asm bit.z $00;
   asm nop;
   TEMPLATE_initial_pf2_abs := TEMPLATE_playfield[2];
   asm lda.a TEMPLATE_pf_data_0 + 3;
   asm .if TEMPLATE_ROW_END_ALIGNED;
   asm sta PF1;
   asm .else;
   asm sta.a PF1;
   asm .endif;
   asm bcs.same TEMPLATE_entry_first_p0_zero;
   asm lda.iy (TEMPLATE_player0_graphics),y;
   asm jmp TEMPLATE_entry_first_p0_ready;
   asm .scope TEMPLATE_scope_first_p0_zero;
   asm TEMPLATE_entry_first_p0_zero:;
   asm .endscope;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm .scope TEMPLATE_scope_first_p0_ready;
   asm TEMPLATE_entry_first_p0_ready:;
   asm .endscope;
   asm sta GRP0;
   asm .if TEMPLATE_ROW_END_ALIGNED;
   asm ldx #6;
   asm .else;
   asm ldx #94;
   asm .endif;
   asm nop;
   asm .if 2 >= TEMPLATE_END_0 && 2 < TEMPLATE_END_1;
   asm .if 2 == TEMPLATE_END_0;
   asm jmp TEMPLATE_event_0_1;
   asm .else;
   asm jmp TEMPLATE_normal_0;
   asm .endif;
   asm .endif;
   asm .if 2 >= TEMPLATE_END_1 && 2 < TEMPLATE_END_2;
   asm .if 2 == TEMPLATE_END_1;
   asm jmp TEMPLATE_event_0_2;
   asm .else;
   asm jmp TEMPLATE_normal_0;
   asm .endif;
   asm .endif;
   asm .if 2 >= TEMPLATE_END_2 && 2 < TEMPLATE_END_3;
   asm .if 2 == TEMPLATE_END_2;
   asm jmp TEMPLATE_event_0_3;
   asm .else;
   asm jmp TEMPLATE_normal_0;
   asm .endif;
   asm .endif;
   asm .if 2 >= TEMPLATE_END_3 && 2 < TEMPLATE_END_4;
   asm .if 2 == TEMPLATE_END_3;
   asm jmp TEMPLATE_event_0_4;
   asm .else;
   asm jmp TEMPLATE_normal_0;
   asm .endif;
   asm .endif;
   asm .if 2 >= TEMPLATE_END_4 && 2 < TEMPLATE_END_5;
   asm .if 2 == TEMPLATE_END_4;
   asm jmp TEMPLATE_event_0_5;
   asm .else;
   asm jmp TEMPLATE_normal_0;
   asm .endif;
   asm .endif;
   asm .if 2 >= TEMPLATE_END_5 && 2 < TEMPLATE_END_6;
   asm .if 2 == TEMPLATE_END_5;
   asm jmp TEMPLATE_event_0_6;
   asm .else;
   asm jmp TEMPLATE_normal_0;
   asm .endif;
   asm .endif;
   asm .if 2 >= TEMPLATE_END_6 && 2 < TEMPLATE_END_7;
   asm .if 2 == TEMPLATE_END_6;
   asm jmp TEMPLATE_event_0_7;
   asm .else;
   asm jmp TEMPLATE_normal_0;
   asm .endif;
   asm .endif;
   asm .if 2 >= TEMPLATE_END_7 && 2 < TEMPLATE_END_8;
   asm .if 2 == TEMPLATE_END_7;
   asm jmp TEMPLATE_event_0_8;
   asm .else;
   asm jmp TEMPLATE_normal_0;
   asm .endif;
   asm .endif;
   asm .if TEMPLATE_ORD_0 > 0;
