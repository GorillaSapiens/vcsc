// 181-line full-width component: 3 setup + 176 terrain + 2 cleanup lines.
// Three independent six-byte ledges occupy 18 RAM bytes; road/gaps are implicit.
require inline void TEMPLATE_vblank(void) {
   asm .callstackextra 2;
   asm lda.z game_player0_y;
   asm sta.z game_workspace + 1;
   asm sec;
   asm sbc #2;
   asm sta.z game_player0_y;
   asm lda.z game_player1_y;
   asm sta.z game_workspace + 2;
   asm sec;
   asm sbc #2;
   asm sta.z game_player1_y;
   asm lda.z game_ball_y;
   asm sta.z game_workspace + 7;
   asm lda.z game_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z game_workspace + 5;
   asm lda.z game_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z game_workspace + 6;
   asm sta WSYNC;
   asm ldx.z game_aux_index;
   asm bit.z $00;
   asm lda.a game_object_x + 4;
   asm sec;
   asm @divide:;
   asm sbc #15;
   asm bcs.same @divide;
   asm sta.a game_workspace + 3;
   asm sta RESP0,x;
   asm ldy.a game_workspace + 3;
   asm lda game_reposition_table + 16 - 256,y;
   asm sta HMP0,x;
   asm lda #0;
   asm sta HMP0;
   asm sta HMP1;
   asm sta HMBL;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #0;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm ldx.z game_object_x;
   asm lda.ax game_player_position_table,x;
   asm sta.z game_workspace + 3;
   asm ldx.z game_object_x + 1;
   asm lda.ax game_player_position_table,x;
   asm sta.z game_workspace + 4;
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
}

require inline void TEMPLATE_draw(void) {
   asm .callstackextra 2;
   asm ldy.z game_workspace + 4;
   asm sty HMP1;
   asm tya;
   asm and #$0f;
   asm tax;
   asm @p1_position:;
   asm dex;
   asm bne.same @p1_position;
   asm sta RESP1;
   asm sta WSYNC;
   asm ldy.z game_workspace + 3;
   asm sty HMP0;
   asm tya;
   asm and #$0f;
   asm tax;
   asm bit.z $00;
   asm @p0_position:;
   asm dex;
   asm bne.same @p0_position;
   asm sta RESP0;
   asm lda.z run_facing;
   asm and #8;
   asm sta REFP0;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #$20;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm lda #0;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta REFP1;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta CXCLR;
   asm sta.z game_fill;
   asm lda.a game_player1_colors + 4;
   asm sta COLUP1;
   asm ldy.z game_player0_y;
   asm cpy.z game_workspace + 5;
   asm bcc.same @prime_active;
   asm ldy #0;
   asm lda #0;
   asm beq.same @prime_ready;
   asm @prime_active:;
   asm lda.iy (game_player0_graphics),y;
   asm @prime_ready:;
   asm ldx #8;
   asm sta WSYNC;
   asm jsr @blank;
   asm lda #0;
   asm sta.z game_lamps;
   asm ldx #16;
   asm lda.z game_workspace;
   asm sta WSYNC;
   asm jsr @blank;
   asm lda.z game_workspace;
   asm ldx.z game_aux_index;
   asm sta WSYNC;
   TEMPLATE_upper_pair();
   TEMPLATE_upper_pair();
   asm ldx #14;
   asm jsr @blank;
   asm lda.z game_workspace;
   asm ldx.z game_aux_index;
   asm sta WSYNC;
   TEMPLATE_middle_pair();
   TEMPLATE_middle_pair();
   asm ldx #14;
   asm jsr @blank;
   asm lda.z game_workspace;
   asm ldx.z game_aux_index;
   asm sta WSYNC;
   TEMPLATE_lower_pair();
   TEMPLATE_lower_pair();
   asm ldx #14;
   asm jsr @blank;
   asm lda #$ff;
   asm sta.z game_fill;
   asm sta.z game_lamps;
   asm ldx #16;
   asm lda.z game_workspace;
   asm sta WSYNC;
   asm jsr @blank;
   asm sta WSYNC;
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta HMCLR;
   asm sta WSYNC;
   asm sta WSYNC;
   asm jmp @done;

   // Only gaps/road use this shared loop. Its RTS is before the final P1
   // boundary; the caller completes that scanline with WSYNC, preserving A/Y.
   asm @blank:;
   asm sta GRP0;
   asm lda.z game_fill;
   asm sta PF0;
   asm lda.z game_lamps;
   asm sta PF1;
   asm lda.z game_fill;
   asm sta PF2;
   asm lda.ay game_player0_colors,y;
   asm sta COLUP0;
   asm ldy.z game_player1_y;
   asm dey;
   asm sty.z game_player1_y;
   asm cpy.z game_workspace + 6;
   asm bcs.same @blank_p1_zero;
   asm lda.iy (game_player1_graphics),y;
   asm jmp @blank_p1_ready;
   asm @blank_p1_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @blank_p1_ready:;
   asm dec.z game_ball_y;
   asm sta WSYNC;
   asm sta GRP1;
   asm ldy.z game_ball_y;
   asm lda.ay game_missile_enable,y;
   asm ldy.z game_aux_index;
   asm sta.ay $1b,y;
   asm ldy.z game_player0_y;
   asm dey;
   asm sty.z game_player0_y;
   asm cpy.z game_workspace + 5;
   asm bcs.same @blank_p0_zero;
   asm lda.iy (game_player0_graphics),y;
   asm jmp @blank_p0_ready;
   asm @blank_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @blank_p0_ready:;
   asm dex;
   asm beq.same @blank_end;
   asm sta WSYNC;
   asm jmp @blank;
   asm @blank_end:;
   asm sta.z game_workspace;
   asm rts;
   asm @done:;
}
