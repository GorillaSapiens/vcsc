// 181-line full-width component: 3 setup + 176 terrain + 2 cleanup lines.
// Three independent six-byte ledges occupy 18 RAM bytes; road/gaps are implicit.
require inline void TEMPLATE_vblank(void) {
   asm .callstackextra 4;
   asm lda.z game_aux_index;
   asm eor #3;
   asm sta.z game_dot_skip;
   asm lda.z game_player0_y;
   asm sta.z game_workspace + 1;
   asm sec;
   asm sbc #10;
   asm sta.z game_player0_y;
   asm lda.z game_player1_y;
   asm sta.z game_workspace + 2;
   asm sec;
   asm sbc #10;
   asm sta.z game_player1_y;
   asm lda.z game_ball_y;
   asm sta.z game_workspace + 7;
   asm sec;
   asm sbc #8;
   asm sta.z game_ball_y;
   asm lda.z game_player0_height;
   asm clc;
   asm adc #1;
   asm sta.z game_workspace + 5;
   asm lda.a game_player1_height;
   asm clc;
   asm adc #1;
   asm sta.z game_workspace + 6;
   asm sta WSYNC;
   asm ldx.z game_aux_index;
   asm bit.z $00;
   asm lda.a game_object_x + 4;
   asm sec;
   asm @divide:;
   asm sbc #15;
   asm bcs.same @divide;
   asm sta.a game_workspace + 3;
   asm sta RESP0,x;
   // Normalize the negative remainder before indexing. A page-crossing
   // read through $D0xx would dummy-read the Superchip write port and corrupt
   // persistent RAM, even though the final table address is ordinary ROM.
   asm ldy.a game_workspace + 3;
   asm tya;
   asm and #$0f;
   asm tay;
   asm lda.ay game_reposition_table,y;
   asm sta HMP0,x;
   asm lda #0;
   asm sta HMP0;
   asm sta HMP1;
   asm sta HMBL;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #0;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta.a game_band;
   asm ldx.z game_object_x;
   asm lda.ax game_player_position_table,x;
   asm sta.z game_workspace + 3;
   asm ldx.z game_object_x + 1;
   asm lda.ax game_player_position_table,x;
   asm sta.z game_workspace + 4;
   asm lda #0;
   asm sta HMM0;
   asm sta HMM1;
}

require inline void TEMPLATE_draw(void) {
   asm .callstackextra 4;
   asm ldy.z game_workspace + 4;
   asm sty HMP1;
   asm tya;
   asm and #$0f;
   asm tax;
   asm @p1_position:;
   asm dex;
   asm bne.same @p1_position;
   asm sta RESP1;
   asm sta WSYNC;
   asm ldy.z game_workspace + 3;
   asm sty HMP0;
   asm tya;
   asm and #$0f;
   asm tax;
   asm bit.z $00;
   asm @p0_position:;
   asm dex;
   asm bne.same @p0_position;
   asm sta RESP0;
   asm lda.a run_facing;
   asm and #8;
   asm sta REFP0;
   asm sta WSYNC;
   asm sta HMOVE;
   asm lda #$20;
   asm sta NUSIZ0;
   asm sta NUSIZ1;
   asm lda #0;
   asm sta VDELP0;
   asm sta VDELP1;
   asm sta REFP1;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta CXCLR;
   asm sta HMCLR;
   asm sta.z game_fill;
   asm lda.a game_monster_color;
   asm sta COLUP1;
   asm ldy.z game_player0_y;
   asm cpy.z game_workspace + 5;
   asm bcc.same @prime_active;
   asm ldy #0;
   asm lda #0;
   asm beq.same @prime_ready;
   asm @prime_active:;
   asm lda.iy (game_player0_graphics),y;
   asm @prime_ready:;
   // Lamps only occupy these sixteen top lines. Clear the reflected half
   // independently; the terrain loop never has to carry a lamp timing path.
   asm ldx #16;
   asm @lamp_line:;
   asm sta WSYNC;
   asm lda.z game_lamps;
   asm sta PF1;
   asm ldy #6;
   asm @lamp_delay:;
   asm dey;
   asm bne.same @lamp_delay;
   asm lda #0;
   asm sta PF1;
   asm dex;
   asm bne.same @lamp_line;
   asm lda #0;
   asm sta.z game_lamps;
   asm ldx #16;
   asm lda #0;
   asm sta WSYNC;
   asm jsr @blank;
   asm ldx.z game_aux_index;
   asm sta WSYNC;
   TEMPLATE_upper_pair();
   TEMPLATE_upper_pair();
   asm jsr @reuse;
   asm ldx #10;
   asm sta WSYNC;
   asm jsr @blank;
   asm ldx.z game_aux_index;
   asm sta WSYNC;
   TEMPLATE_middle_pair();
   TEMPLATE_middle_pair();
   asm jsr @reuse;
   asm ldx #10;
   asm sta WSYNC;
   asm jsr @blank;
   asm ldx.z game_aux_index;
   asm sta WSYNC;
   TEMPLATE_lower_pair();
   TEMPLATE_lower_pair();
   asm jsr @reuse;
   asm ldx #10;
   asm sta WSYNC;
   asm jsr @blank;
   asm ldx #$ff;
   asm stx.z game_fill;
   asm ldx #16;
   asm sta WSYNC;
   asm jsr @blank;
   asm sta WSYNC;
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm sta GRP0;
   asm sta GRP1;
   asm sta ENAM0;
   asm sta ENAM1;
   asm sta ENABL;
   asm sta HMCLR;
   asm sta WSYNC;
   asm sta WSYNC;
   asm jmp @done;

   // Only gaps/road use this shared loop. Its RTS is before the final P1
   // boundary; the caller completes that scanline with WSYNC, preserving A/Y.
   // PF stays constant after @blank. Normal rows spend the freed cycles on
   // M1's two centered-dot shifts. X selects M0/M1; Y selects HMOVE/HMCLR.
   asm @blank_row:;
   // Cycle 8: normal HMOVE, never the left-only cycle-74 variant. Other
   // motion registers are zero; only M1 shifts, left one then right one.
   asm sta.ay HMOVE,y;
   asm sta GRP0;
   asm lda.z game_dot_width;
   asm eor #$30;
   asm sta NUSIZ1;
   asm @blank_colors:;
   asm ldy.z game_color_index;
   asm jmp @blank_palette;
   asm @blank:;
   // First gap line has no dot transition. Clear the ledge before x0.
   asm sta GRP0;
   asm lda.z game_fill;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm stx.z game_gap_pairs;
   asm ldx.z game_aux_index;
   asm @blank_palette:;
   asm lda.ay game_player0_colors,y;
   asm sta COLUP0;
   asm ldy.z game_player1_y;
   asm dey;
   asm sty.z game_player1_y;
   asm cpy #8;
   asm bcs.same @blank_p1_zero;
   asm lda.iy (game_player1_graphics),y;
   asm jmp @blank_p1_ready;
   asm @blank_p1_zero:;
   asm lda #0;
   asm tay;
   asm nop;
   asm @blank_p1_ready:;
   asm dec.z game_ball_y;
   asm sta WSYNC;
   asm sta GRP1;
   asm ldy.z game_ball_y;
   asm lda.ay game_missile_enable,y;
   asm sta.zx $1b,x;
   asm and #$30;
   asm sta NUSIZ1;
   asm sta.z game_dot_width;
   // Keep the final pair short enough for its caller's boundary WSYNC.
   asm dec.z game_gap_pairs;
   asm beq.same @blank_terminal;
   asm lda.ay game_dot_motion,y;
   asm sta HMM1;
   asm and #1;
   asm ora.z game_dot_skip;
   asm sta.z game_workspace;
   asm ldy.z game_player0_y;
   asm dey;
   asm sty.z game_player0_y;
   asm cpy.z game_workspace + 5;
   asm bcs.same @blank_p0_zero;
   asm lda.iy (game_player0_graphics),y;
   asm jmp @blank_p0_ready;
   asm @blank_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @blank_p0_ready:;
   asm sty.z game_color_index;
   asm ldy.z game_workspace;
   asm sta WSYNC;
   asm jmp @blank_row;
   asm @blank_terminal:;
   asm ldy.z game_player0_y;
   asm dey;
   asm sty.z game_player0_y;
   asm cpy.z game_workspace + 5;
   asm bcs.same @terminal_p0_zero;
   asm lda.iy (game_player0_graphics),y;
   asm jmp @terminal_p0_ready;
   asm @terminal_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @terminal_p0_ready:;
   asm sty.z game_color_index;
   asm rts;

   // Four pairs replace the first eight gap lines. P1 is blank here; P0
   // and the selected missile retain their usual two-line vertical cadence.
   asm @reuse:;
   asm sta GRP0;
   asm lda #0;
   asm sta PF0;
   asm sta PF1;
   asm sta PF2;
   asm lda.ay game_player0_colors,y;
   asm sta COLUP0;
   asm lda.a game_band;
   asm clc;
   asm adc #1;
   asm sta.a game_band;
   asm tax;
   asm lda.ax enemy_position,x;
   asm sta HMP1;
   asm and #$0f;
   asm sta.z game_workspace + 3;
   asm dec.z game_ball_y;
   asm lda #0;
   asm sta WSYNC;
   asm sta GRP1;
   asm ldx.z game_aux_index;
   asm ldy.z game_ball_y;
   asm lda.ay game_missile_enable,y;
   asm sta.zx $1b,x;
   asm and #$30;
   asm sta NUSIZ1;
   asm sta.z game_dot_width;
   asm lda #12;
   asm sec;
   asm sbc.z game_workspace + 3;
   asm sta.z game_workspace + 4;
   asm jsr @prepare_p0;
   asm sta WSYNC;
   asm sta GRP0;
   asm lda.ay game_player0_colors,y;
   asm sta COLUP0;
   asm ldy.a game_band;
   asm lda.ay enemy_color,y;
   asm sta COLUP1;
   asm lda.z game_player1_graphics;
   asm clc;
   asm adc #8;
   asm sta.z game_player1_graphics;
   asm nop;
   asm nop;
   // Cycle-74 HMOVE is left-only; $80 holds every other object still.
   asm lda #$80;
   asm sta HMP0;
   asm sta HMM0;
   asm sta HMM1;
   asm sta HMBL;
   asm dec.z game_ball_y;
   asm lda #0;
   asm sta WSYNC;
   asm sta GRP1;
   asm ldx.z game_aux_index;
   asm ldy.z game_ball_y;
   asm lda.ay game_missile_enable,y;
   asm sta.zx $1b,x;
   asm and #$30;
   asm sta NUSIZ1;
   asm sta.z game_dot_width;
   asm jsr @prepare_p0;
   asm sta WSYNC;
   asm sta GRP0;
   asm lda.ay game_player0_colors,y;
   asm sta COLUP0;
   asm ldx.z game_workspace + 3;
   asm nop;
   asm nop;
   asm @reuse_position:;
   asm dex;
   asm bne.same @reuse_position;
   asm sta RESP1;
   // Coarse/fine delays balance across the line boundary for every X.
   asm ldx.z game_workspace + 4;
   asm @reuse_balance:;
   asm dex;
   asm bne.same @reuse_balance;
   asm ldx.z game_aux_index;
   asm ldy.z game_ball_y;
   asm lda.ay game_missile_enable,y;
   asm sta.zx $1b,x;
   asm and #$30;
   asm sta NUSIZ1;
   asm sta.z game_dot_width;
   asm jsr @prepare_p0;
   asm dec.z game_ball_y;
   asm bit.z $00;
   asm sta HMOVE;
   asm nop;
   asm jmp @reuse_after_motion;
   asm @reuse_after_motion:;
   asm sta GRP0;
   asm lda.ay game_player0_colors,y;
   asm sta COLUP0;
   asm bit.z $00;
   asm nop;
   asm nop;
   asm nop;
   asm nop;
   asm sta HMCLR;
   asm lda #9;
   asm sta.z game_player1_y;
   asm dec.z game_ball_y;
   asm lda #0;
   asm sta WSYNC;
   asm sta GRP1;
   asm ldx.z game_aux_index;
   asm ldy.z game_ball_y;
   asm lda.ay game_missile_enable,y;
   asm sta.zx $1b,x;
   asm and #$30;
   asm sta NUSIZ1;
   asm sta.z game_dot_width;
   asm jsr @prepare_p0;
   asm rts;
   asm @prepare_p0:;
   asm ldy.z game_player0_y;
   asm dey;
   asm sty.z game_player0_y;
   asm cpy.z game_workspace + 5;
   asm bcs.same @reuse_p0_zero;
   asm lda.iy (game_player0_graphics),y;
   asm jmp @reuse_p0_ready;
   asm @reuse_p0_zero:;
   asm lda #0;
   asm tay;
   asm bit.z $00;
   asm @reuse_p0_ready:;
   asm sty.z game_color_index;
   asm rts;
   asm @done:;
}
