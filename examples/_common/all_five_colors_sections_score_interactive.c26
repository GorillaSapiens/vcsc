include "vcs.c26"
include "F8/mapper.c26"
include "frame_ntsc.c26"
include "playfield.c26"
include "fonts/default_decimal.c26"

page const uint8_t game_playfield[44] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0b.XX.X..X_.XX.X..X_..XXXX.._XX....XX),
   VCS_PLAYFIELD_ROW(0bX......X_........_........_X......X),
   VCS_PLAYFIELD_ROW(0b.XX.X..X_.XX.X..X_..XXXX.._XX....XX),
   VCS_PLAYFIELD_ROW(0bX......X_........_........_X......X),
   VCS_PLAYFIELD_ROW(0b.XX.X..X_.XX.X..X_..XXXX.._XX....XX),
   VCS_PLAYFIELD_ROW(0bX......X_........_........_X......X),
   VCS_PLAYFIELD_ROW(0b.XX.X..X_.XX.X..X_..XXXX.._XX....XX),
   VCS_PLAYFIELD_ROW(0bX......X_........_........_X......X),
   VCS_PLAYFIELD_ROW(0b.XX.X..X_.XX.X..X_..XXXX.._XX....XX),
   VCS_PLAYFIELD_ROW(0bX......X_........_........_X......X)
};
page const uint8_t game_player0_colors[8] := {
   0xae,0x9e,0x8e,0x7e,0x6e,0x5e,0x4e,0x3e
};
page const uint8_t game_player1_colors[8] := {
   0x5e,0x6e,0x7e,0x8e,0x9e,0xae,0xbe,0xce
};
// Positive even heights total176. Supported seams are2..26. This layout spans
// two rows; the earlier2,2,2,2,2,2,2,162 layout retains the smaller schedule.
instantiate "../../../_common/all_five_colors_sections_181_preview.c26" as game (
   section1_lines:=4, section2_lines:=12, section3_lines:=2, section4_lines:=2,
   section5_lines:=2, section6_lines:=2, section7_lines:=2, section8_lines:=150
)
instantiate "six_glyph_component.c26" as score (external_pointers:=1, mutable_color:=1, initial_color:=0)

// Four upright eight-row frames, stored together in one contained page.
page const uint8_t animations[64] := {
   game_SPRITE_GLYPH(0x42,0xa5,0xbd,0xff,0xdb,0x7e,0x3c,0x66),
   game_SPRITE_GLYPH(0x24,0x5a,0xbd,0xff,0xdb,0x7e,0x5a,0x99),
   game_SPRITE_GLYPH(0x42,0xa5,0xbd,0xff,0xdb,0x7e,0x5a,0x81),
   game_SPRITE_GLYPH(0x81,0x5a,0xbd,0xff,0xdb,0x7e,0x3c,0x24),
   game_SPRITE_GLYPH(0xa5,0x5a,0x24,0xff,0xdb,0xff,0x66,0x3c),
   game_SPRITE_GLYPH(0x54,0x3c,0x42,0xff,0xdb,0xff,0x66,0x3c),
   game_SPRITE_GLYPH(0x24,0x5a,0x81,0xff,0xdb,0xff,0x66,0x3c),
   game_SPRITE_GLYPH(0x2a,0x3c,0x42,0xff,0xdb,0xff,0x66,0x3c)
};

uint8_t selected_object;
uint8_t selected_digit;
uint8_t select_latched;
uint8_t score_latched;
bank1 const bcd24_t digit_weights[6] := {1,10,100,1000,10000,100000};
// All eight frames share one page. Keep both pointer high bytes unchanged
// while the frame selector replaces their low bytes.
bcd24_t score_score := 0;
inline void prepare_game(void) {
   game_set_initial_palette();
   asm lda.z game_object_x + 0;
   asm eor.z game_player0_y;
   asm and #3;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc.z score_offsets + 1;
   asm sta.z game_player0_graphics;
   asm lda.z game_object_x + 1;
   asm eor.z game_player1_y;
   asm and #3;
   asm asl;
   asm asl;
   asm asl;
   asm ora #32;
   asm clc;
   asm adc.z score_offsets + 1;
   asm sta.z game_player1_graphics;
   game_vblank();
}
inline void prepare_probe_score(void) {
   // Between score draws, pointer3's high byte holds the font's low byte.
   // All full pointers share pointer0's high byte because the font is contained.
   // Restore high bytes only after every low-byte calculation is complete.
   // Digits 1/2: only digit*8 is needed because score_font is page-contained.
   asm lda score_score+2;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm sta score_offsets;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm sta score_offsets+1;

   // Digits 3/4 retain complete pointers.
   asm lda score_score+1;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc score_pointers+7;
   asm sta score_pointers;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc score_pointers+7;
   asm sta score_pointers+2;

   // Digits 5/6 retain complete pointers.
   asm lda score_score;
   asm tax;
   asm and #$f0;
   asm lsr;
   asm clc;
   asm adc score_pointers+7;
   asm sta score_pointers+4;
   asm txa;
   asm and #$0f;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc score_pointers+7;
   asm sta score_pointers+6;
   asm lda.z score_pointers + 1;
   asm sta.z score_pointers + 3;
   asm sta.z score_pointers + 5;
   asm sta.z score_pointers + 7;
}


inline void initialize_probe_objects(void) {
    score_score := 123456;
    score_color := 0x0e;
   VBLANK := 2;
   COLUBK := 0x84;
   COLUPF := 0x2e;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_PLAYER0_X := 20;
   game_PLAYER1_X := 130;
   game_MISSILE0_X := 50;
   game_MISSILE1_X := 110;
    game_BALL_X := 80;
    game_player0_y := 18;
    game_player1_y := 78;
    game_missile0_y := 34;
    game_missile1_y := 62;
    game_ball_y := 48;
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 5;
   game_missile1_height := 7;
   game_ball_height := 3;
   game_init();

}
// Y fields are intentionally independent and not duplicated in an application
// array: this leaves the score, controls and bank-call stack in stock RIOT RAM.
alias MOVE_Y(y) if (!(SWCHA & 0x10)) { if (y) { y--; } } else { if (!(SWCHA & 0x20)) { if (y < 87) { y++; } } }
inline void update_controls(void) {
   if (!(SWCHB & 1)) { hard_reset(); }
   if (SWCHB & 2) { select_latched := 0; }
   else {
      if (!select_latched) {
         selected_object++;
         if (selected_object == 5) { selected_object := 0; }
         select_latched := 1;
      }
   }
   if (!(SWCHA & 0x40)) {
      if (game_object_x[selected_object]) { game_object_x[selected_object]--; }
   } else {
      if (!(SWCHA & 0x80)) {
         if (game_object_x[selected_object] < 159) { game_object_x[selected_object]++; }
      }
   }
   switch (selected_object) {
      case 0: MOVE_Y(game_player0_y) break;
      case 1: MOVE_Y(game_player1_y) break;
      case 2: MOVE_Y(game_missile0_y) break;
      case 3: MOVE_Y(game_missile1_y) break;
      case 4: MOVE_Y(game_ball_y) break;
   }
   if ((SWCHA & 15) == 15) { score_latched := 0; return; }
   if (score_latched) { return; }
   score_latched := 1;
   if (!(SWCHA & 4)) {
      selected_digit++;
      if (selected_digit == 6) { selected_digit := 0; }
      score_color += 0x10;
   } else {
      if (!(SWCHA & 8)) {
         if (selected_digit) { selected_digit--; } else { selected_digit := 5; }
         score_color += 0x10;
      }
   }
   if (!(SWCHA & 1)) { score_score += digit_weights[selected_digit]; }
   else { if (!(SWCHA & 2)) { score_score -= digit_weights[selected_digit]; } }
}
inline void finish_probe_gameplay(void) { game_overscan(); update_controls(); }
bank0 void initialize_tables(void) {
   asm lda #>score_font;
   asm sta.z score_pointers + 1;
   asm lda #<score_font;
   asm sta.z score_pointers + 7;
   game_player0_graphics := animations;
   game_player1_graphics := animations;
   asm lda #<animations;
   asm sta.z score_offsets + 1;
}
// Application-owned composition, not a renderer callback. Save S inside this
// banked call so gameplay restores the actual caller frame before returning.
bank0 void draw_components(void) {
   game_save_stack();
#if SCORE_BELOW
       // Store the score before gameplay in ROM, but execute it afterward.
       // The final JMP replaces the ordinary three-cycle BIT handoff exactly;
       // the two routing jumps outside visible drawing are timer-absorbed.
       asm jmp @gameplay_entry;
       asm @score_entry:;
       score_draw();
       vcs_ntsc_begin_overscan();
       asm jmp @visible_done;
       asm @gameplay_entry:;
       vcs_ntsc_end_vblank();
       game_draw();
       asm jmp @score_entry;
       asm @visible_done:;
#else
       vcs_ntsc_end_vblank();
       score_draw();
       vcs_ntsc_component_handoff();
       game_draw();
       vcs_ntsc_begin_overscan();
#endif
   // Both components have returned; these score pointers are dead until next
   // VBLANK. prepare_game consumes the animation base before score preparation.
   asm lda #<animations;
   asm sta.z score_offsets + 1;
   asm lda #<score_font;
   asm sta.z score_pointers + 7;
}
bank1 void run_game(void) {
    initialize_probe_objects();
   score_init();
   while (1) {
      vcs_ntsc_vsync();
       vcs_ntsc_begin_vblank();
        prepare_game();
       score_vblank();
       prepare_probe_score();
       draw_components();
      finish_probe_gameplay();
      score_overscan();
      vcs_ntsc_end_overscan();
   }
}
void main(void) { initialize_tables(); run_game(); }
