// Shared controls for the independently positioned two-plus-two score examples.
// The including source must instantiate the display as `score`.

uint8_t selected_score_field := 0;
uint8_t right_score_fire_ready := 1;
uint8_t right_joystick_ready := 0x0f;

inline void initialize_score_state(void) {
   score_left_score := 12;
   score_right_score := 34;
   // The selected field is bright; the other field is dimmed.
   score_left_color := VCS_NTSC_GRAY_92;
   score_right_color := 0x26;
   score_left_x := 16;
   score_right_x := 104;
   selected_score_field := 0;
   right_score_fire_ready := 1;
   right_joystick_ready := 0x0f;
}

inline void update_score_field_selection(void) {
   if (INPT5 & 0x80) {
      right_score_fire_ready := 1;
   }
   else {
      if (right_score_fire_ready) {
         selected_score_field ^= 1;
         if (selected_score_field) {
            score_left_color := 0x06;
            score_right_color := VCS_NTSC_GOLDENROD;
         }
         else {
            score_left_color := VCS_NTSC_GRAY_92;
            score_right_color := 0x26;
         }
         right_score_fire_ready := 0;
      }
   }
}

inline void update_score_controls(void) {
   update_score_field_selection();

   // 0x0f means armed; 0 means a press is latched. Reuse this byte for the
   // current low SWCHA nibble so edge detection needs no extra scratch RAM.
   if (right_joystick_ready) {
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         // Horizontal input moves only the selected field's private X origin.
         if (!(right_joystick_ready & 0x04)) {
            if (selected_score_field) {
               if (score_right_x > 32) { score_right_x--; }
            }
            else {
               if (score_left_x > 0) { score_left_x--; }
            }
         }
         else {
            if (!(right_joystick_ready & 0x08)) {
               if (selected_score_field) {
                  if (score_right_x < 144) { score_right_x++; }
               }
               else {
                  if (score_left_x < 64) { score_left_x++; }
               }
            }
         }

         // Vertical input changes only the selected packed-BCD two-digit value.
         if (!(right_joystick_ready & 0x01)) {
            if (selected_score_field) { score_right_score += 1; }
            else { score_left_score += 1; }
         }
         else {
            if (!(right_joystick_ready & 0x02)) {
               if (selected_score_field) { score_right_score -= 1; }
               else { score_left_score -= 1; }
            }
         }
         right_joystick_ready := 0;
      }
   }
   else {
      // Stay latched through a hold or direction roll; only full neutral re-arms.
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         right_joystick_ready := 0;
      }
   }
}
