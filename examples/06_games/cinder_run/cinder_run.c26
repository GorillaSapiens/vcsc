// The two intermediate object-array bytes hold collectible coordinates.
alias run_spark_x game_object_x[2]
alias run_spark_y game_object_x[3]
// Phase overlays: overscan has already restored coordinates from workspace;
// next VBLANK rewrites all eight bytes before rendering. Score preparation
// likewise rebuilds both compact offsets. No persistent physics lives here.
alias run_hit score_offsets[0]
alias run_collect score_offsets[1]
alias run_kill score_delayed
alias physics_old_feet game_workspace[0]
alias physics_solids game_workspace[1]
alias physics_column game_workspace[2]
alias physics_index game_workspace[3]
alias physics_mask game_workspace[4]
alias physics_top game_workspace[5]
alias physics_old_x game_workspace[6]
alias physics_probe game_workspace[7]

// Separate from the terrain generator: spawns must not change revisited ledges.
bank3 void next_enemy_random(void) {
   asm lda.a enemy_random;
   asm lsr;
   asm bcc.same @random_even;
   asm eor #$b8;
   asm @random_even:;
   asm sta.a enemy_random;
}

bank3 void retire_hazard(void) {
   asm .callstackextra 4;
   asm jsr next_enemy_random;
   asm and #63;
   asm clc;
   asm adc #48;
   asm ldx.a enemy_index;
   asm sta.ax enemy_delay,x;
   // Clear the cached artwork now, rather than waiting for its refresh slot.
   asm txa;
   asm asl;
   asm asl;
   asm asl;
   asm tax;
   asm ldy #8;
   asm lda #0;
   asm @retire_pixels:;
   asm sta.ax monster_pixels,x;
   asm inx;
   asm dey;
   asm bne.same @retire_pixels;
}

bank3 void new_hazard(void) {
   asm .callstackextra 4;
   asm lda.a enemy_random;
   asm lsr;
   asm bcc.same @spawn_random_even;
   asm eor #$b8;
   asm @spawn_random_even:;
   asm sta.a enemy_random;
   asm ldx.a enemy_index;
   asm lda #152;
   asm ldy #$ff;
   asm bcc.same @spawn;
   asm lda #4;
   asm ldy #1;
   asm @spawn:;
   asm sta.ax enemy_x,x;
   asm tya;
   asm sta.ax enemy_direction,x;
   asm lda.a run_wave;
   asm and #7;
   asm sta.ax enemy_kind,x;
   asm lda.a run_wave;
   asm clc;
   asm adc #1;
   asm sta.a run_wave;
}

bank2 void new_run(void) {
   asm ldx #17;
   asm @reset_landscape:;
   asm lda.ax landscape,x;
   asm sta.zx game_playfield,x;
   asm dex;
   asm bpl.same @reset_landscape;
   asm ldx #31;
   asm lda #0;
   asm @clear_treasure:;
   asm sta.ax treasure_taken,x;
   asm dex;
   asm bpl.same @clear_treasure;
   world_sector := 0;
   treasure_visible := 1;
   treasure_id := 0;
   run_moving := 0;
   monster_tick := 0;
   run_aim_wait := 0;
   enemy_art_cursor := 0;
   enemy_random := 0xa7;
   enemy_running := 0;
   run_mode := 0;
   run_frame := 0;
   run_jump := 0;
   run_fire_ready := 0;
   run_up_ready := 0;
   run_lives := 3;
   run_immunity := 0;
   world_seed[0] := 0xe1; world_seed[1] := 0xac;
   world_end[0] := 0xb1; world_end[1] := 0x30;
   world_phase := 0;
   world_substep := 0;
   world_camera := 0;
   world_request := 0;
   run_facing := 1;
   run_shot_active := 0;
   run_sound := 0;
   music_step := 0;
   music_clock := 0;
   music_note := 0;
   run_shot_x := 0;
   run_shot_y := 0;
   run_feet := 73;
   run_velocity := 0;
   run_grounded := 1;
   run_duck := 0;
   run_spark_x := 116;
   game_PLAYER0_X := 80;
   game_player0_y := 73;
   game_player0_height := 7;
   game_player1_height := 7;
   run_spark_y := 65;
   game_ball_y := run_spark_y;
   game_ball_height := 2;
          game_BALL_X := run_spark_x + 1;
   score_score := 0;
   score_color := 0x1e;
   run_wave := 4;
   asm ldx #3;
   asm @reset_enemies:;
   asm lda #0;
   asm sta.ax enemy_delay,x;
   asm txa;
   asm asl;
   asm sta.ax enemy_kind,x;
   asm txa;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm clc;
   asm adc #40;
   asm sta.ax enemy_x,x;
   asm lda #$ff;
   asm sta.ax enemy_direction,x;
   asm dex;
   asm bpl.same @reset_enemies;
   AUDV0 := 0;
   AUDV1 := 0;
}

bank2 void scroll_landscape(void) {
   if (world_request == 2) {
      if (!world_phase) {
         // The outgoing high bit is the old feedback bit: inverse of $B400.
         asm lda.z world_seed+1;
         asm asl;
         asm bcc.same @seed_even;
         asm lda.z world_seed+1;
         asm eor #$b4;
         asm sta.z world_seed+1;
         asm @seed_even:;
         asm rol.z world_seed;
         asm rol.z world_seed+1;
         asm lda.z world_end+1;
         asm asl;
         asm bcc.same @end_even;
         asm lda.z world_end+1;
         asm eor #$b4;
         asm sta.z world_end+1;
         asm @end_even:;
         asm rol.z world_end;
         asm rol.z world_end+1;
         world_phase := 4;
      }
      world_phase--;
      physics_solids := world_seed[0];
   }
   else { physics_solids := world_end[0]; }
   // Carry follows visual adjacency across the TIA's alternating bit orders.
   // PF0's unused low nibbles are explicitly cleared; no 40-bit C temporary.
   if (world_request == 1) {
      asm ldx #0;
      asm @left_row:;
      asm asl.zx game_playfield+5,x;
      asm ror.zx game_playfield+4,x;
      asm rol.zx game_playfield+3,x;
      asm ror.zx game_playfield+2,x;
      asm rol.zx game_playfield+1,x;
      asm ror.zx game_playfield,x;
      asm lda.zx game_playfield,x;
      asm and #$f0;
      asm sta.zx game_playfield,x;
      asm lsr.z game_workspace + 1;
      asm bcc.same @left_no_bit;
      asm lda.zx game_playfield+5,x;
      asm ora #$10;
      asm sta.zx game_playfield+5,x;
      asm @left_no_bit:;
      asm txa;
      asm clc;
      asm adc #6;
      asm tax;
      asm cpx #18;
      asm bne.same @left_row;
   }
   else {
      asm ldx #0;
      asm @right_row:;
      asm asl.zx game_playfield,x;
      asm ror.zx game_playfield+1,x;
      asm rol.zx game_playfield+2,x;
      asm ror.zx game_playfield+3,x;
      asm rol.zx game_playfield+4,x;
      asm ror.zx game_playfield+5,x;
      asm lda.zx game_playfield+5,x;
      asm and #$f0;
      asm sta.zx game_playfield+5,x;
      asm lsr.z game_workspace + 1;
      asm bcc.same @right_no_bit;
      asm lda.zx game_playfield,x;
      asm ora #$10;
      asm sta.zx game_playfield,x;
      asm @right_no_bit:;
      asm txa;
      asm clc;
      asm adc #6;
      asm tax;
      asm cpx #18;
      asm bne.same @right_row;
   }
   if (world_request == 1) {
      world_camera += 4;
      if (!world_camera) { world_sector++; }
      world_phase++;
      if (world_phase == 4) {
         world_phase := 0;
         asm lsr.z world_seed+1;
         asm ror.z world_seed;
         asm bcc.same @seed_forward_even;
         asm lda.z world_seed+1;
         asm eor #$b4;
         asm sta.z world_seed+1;
         asm @seed_forward_even:;
         asm lsr.z world_end+1;
         asm ror.z world_end;
         asm bcc.same @end_forward_even;
         asm lda.z world_end+1;
         asm eor #$b4;
         asm sta.z world_end+1;
         asm @end_forward_even:;
      }
      if (run_shot_active) {
         if (run_shot_x < 4) { run_shot_active := 0; }
         else { run_shot_x -= 4; }
      }
   }
   else {
      if (!world_camera) { world_sector--; }
      world_camera -= 4;
      if (run_shot_active) {
         if (run_shot_x > 151) { run_shot_active := 0; }
         else { run_shot_x += 4; }
      }
   }
}

inline void sample_column(void) {
   physics_mask := column_bit[physics_column];
   physics_index := column_byte[physics_column];
   if (game_playfield[physics_index] & physics_mask) { physics_solids |= 4; }
   physics_index += 6;
   if (game_playfield[physics_index] & physics_mask) { physics_solids |= 2; }
   physics_index += 6;
   if (game_playfield[physics_index] & physics_mask) { physics_solids |= 1; }
}

inline void sample_platforms(void) {
   physics_solids := 0;
   // Probe both sides of the six-pixel body against the actual displayed PF.
   physics_column := game_PLAYER0_X + 1;
   physics_column >>= 2;
   physics_probe := physics_column;
   sample_column();
   physics_column := game_PLAYER0_X + 6;
   physics_column >>= 2;
   if (physics_column != physics_probe) { sample_column(); }
}

inline void probe_body(void) {
   sample_platforms();
   physics_top := run_feet - 8;
   if (run_duck) { physics_top := run_feet - 4; }
   physics_probe := 0;
   if ((physics_solids & 4) && run_feet > 25 && physics_top < 27) { physics_probe := 1; }
   if ((physics_solids & 2) && run_feet > 41 && physics_top < 43) { physics_probe := 1; }
   if ((physics_solids & 1) && run_feet > 57 && physics_top < 59) { physics_probe := 1; }
}

inline void collide_ledge(void) {
   if (physics_solids & physics_probe) {
      if (run_velocity >= 0) {
         // Swept feet prevent tunneling even at maximum falling velocity.
         if (physics_old_feet <= physics_top && run_feet >= physics_top) {
            run_feet := physics_top;
            run_velocity := 0;
            run_grounded := 1;
         }
      }
      else {
         // Solid undersides: no jumping through the platforms from below.
          physics_top += 10;
         if (physics_old_feet >= physics_top && run_feet < physics_top) {
            run_feet := physics_top;
            run_velocity := 0;
         }
      }
   }
}

inline void update_physics(void) {
   run_moving := 0;
   run_duck := 0;
   physics_old_x := game_PLAYER0_X;
   if ((INPT4 & 0x80) && !run_aim_wait) {
      if (!(SWCHA & 0x20) && run_grounded) { run_duck := 1; }
      if (!(SWCHA & 0x40)) {
         run_moving := 1;
         run_facing := -1;
         if (game_PLAYER0_X > 64) { game_PLAYER0_X--; }
         else { world_substep--; }
      }
      if (!(SWCHA & 0x80)) {
         run_moving := 1;
         run_facing := 1;
         if (game_PLAYER0_X < 96) { game_PLAYER0_X++; }
         else { world_substep++; }
      }
      if (world_substep >= 4) { world_request := 1; world_substep := 0; }
      if (world_substep <= -4) { world_request := 2; world_substep := 0; }
   }
   probe_body();
   if (physics_probe) {
      game_PLAYER0_X := physics_old_x;
      // A scrolling wall pushes the courier instead of embedding its body.
      if (run_facing > 0 && game_PLAYER0_X > 44) { game_PLAYER0_X -= 4; }
      if (run_facing < 0 && game_PLAYER0_X < 108) { game_PLAYER0_X += 4; }
      world_request := 0;
      run_moving := 0;
      sample_platforms();
   }
   if (run_grounded && run_feet != 73) {
      if (!((run_feet == 25 && (physics_solids & 4)) ||
            (run_feet == 41 && (physics_solids & 2)) ||
            (run_feet == 57 && (physics_solids & 1)))) {
         run_grounded := 0;
         run_velocity := 0;
         run_jump := 0;
      }
   }
   if (SWCHA & 0x10) { run_up_ready := 1; }
   if (run_up_ready && !(SWCHA & 0x10) && (INPT4 & 0x80) && !run_aim_wait) {
      run_up_ready := 0;
      if (run_grounded && !run_duck) {
         run_grounded := 0;
         run_velocity := -3;
         run_jump := 0;
          run_sound := 0x1a;
      }
   }
   if (!run_grounded) {
      physics_old_feet := run_feet;
      run_feet := run_feet + (uint8_t) run_velocity;
      // Keep the entire courier below the sixteen-line lamp/UI strip.
      if (run_feet < 17) { run_feet := 17; run_velocity := 0; }
      physics_top := 25; physics_probe := 4; collide_ledge();
      physics_top := 41; physics_probe := 2; collide_ledge();
      physics_top := 57; physics_probe := 1; collide_ledge();
      if (run_feet >= 73) { run_feet := 73; run_velocity := 0; run_grounded := 1; }
      run_jump++;
      if (!(run_jump & 3) && run_velocity < 4) { run_velocity++; }
   }
   game_player0_y := run_feet;
   game_player0_height := 7;
   // Y is the renderer's feet anchor; reducing height lowers the head without
   // moving the feet through the platform.
   if (run_duck) { game_player0_height := 3; }
}

bank2 void update_audio(void) {
   AUDV0 := 0;
   // High nibble selects the effect, low nibble is its remaining duration.
   // Jump sweeps upward. Gunfire/kill use square pulses; treasure alone
   // gets a longer two-note rising chime in the distinct lead voice.
   if (run_sound & 15) {
      run_sound--;
      AUDV0 := 5;
      AUDC0 := MUSIC_CONTROL_SQUARE;
      physics_top := run_sound & 15;
      physics_top += 8;
      AUDF0 := physics_top;
      if (run_sound & 0x20) { AUDF0 := 3; }
      if (run_sound & 0x40) {
         AUDC0 := MUSIC_CONTROL_NOISE;
         AUDF0 := 18;
      }
      if (run_sound & 0x80) {
         AUDC0 := MUSIC_CONTROL_LEAD;
         AUDF0 := 11;
         if ((run_sound & 15) < 6) { AUDF0 := 8; }
         AUDV0 := 4;
      }
   }
}

bank3 void update_music(void) {
   // Channel 0 belongs exclusively to gameplay effects. This soft, hollow
   // channel-1 voice leaves them audible and ducks further during an effect.
   AUDV1 := 0;
   AUDC1 := MUSIC_CONTROL_LEAD;
   if (run_mode == 1) {
      if (!music_clock) {
         music_note := music_phrase[music_step];
         music_step++;
         if (music_step == 48) { music_step := 0; }
         music_clock := 25;
      }
      music_clock--;
      AUDF1 := music_note & 31;
      if (music_note) {
         AUDV1 := 2;
         if (music_clock > 20) {
            AUDV1 := 3;
            if (music_note & 0x80) { AUDV1 := 4; }
         }
         if (run_sound & 15) { AUDV1 := 1; }
         if (music_clock < 3 && !(music_note & 0x20)) { AUDV1 := 0; }
      }
   }
}

// Divide work across the two blanking deadlines: physics precedes the raster,
// while scoring, terrain scrolling and collision responses follow it.
bank2 void advance_physics(void) {
   if (run_mode == 1) { update_physics(); }
}

bank1 void update_run(void) {
   // Capture real TIA collisions before next frame's renderer clears them.
   run_hit := CXPPMM & 0x80;
   run_collect := CXM1P & 0x80;
   run_kill := CXM0P & 0x80;
   if (!(SWCHB & 1)) {
      new_run();
   }
   run_frame++;
   update_audio();
   update_music();
   if (INPT4 & 0x80) {
      run_fire_ready := 1;
   }
   if (run_mode != 1) {
      if (run_fire_ready && !(INPT4 & 0x80)) {
         new_run();
         run_mode := 1;
         run_fire_ready := 0;
      }
   }
   else {
      if (world_request) { scroll_landscape(); }
       monster_tick++;
      if (run_shot_active) {
         if (run_kill) {
            run_shot_active := 0;
            score_score += 100;
            run_sound := 0x26;
             enemy_index := 0;
             if (run_shot_y > 29) { enemy_index := 1; }
             if (run_shot_y > 45) { enemy_index := 2; }
             if (run_shot_y > 61) { enemy_index := 3; }
              retire_hazard();
         }
         else {
            if ((run_shot_dx < 0 && run_shot_x < 4) || (run_shot_dx > 0 && run_shot_x > 151) ||
                (run_shot_dy < 0 && run_shot_y < 5) || (run_shot_dy > 0 && run_shot_y > 78)) { run_shot_active := 0; }
            else {
               run_shot_x += (uint8_t) run_shot_dx;
               run_shot_y += (uint8_t) run_shot_dy;
            }
         }
      }
      if (run_fire_ready && !(INPT4 & 0x80)) {
         run_fire_ready := 0;
         run_aim_wait := 3;
      }
      // Sample aim for three frames after Fire: a near-simultaneous Up press
      // must not be lost just because the button arrived first.
      if (run_aim_wait) {
         run_aim_wait--;
         if (!run_aim_wait) {
             if (!run_shot_active) {
                run_shot_active := 1;
                run_shot_dx := 0;
                run_shot_dy := 0;
                if (!(SWCHA & 0x40)) { run_shot_dx := -4; run_facing := -1; }
                if (!(SWCHA & 0x80)) { run_shot_dx := 4; run_facing := 1; }
                if (!(SWCHA & 0x10)) { run_shot_dy := -2; }
                if (!(SWCHA & 0x20)) { run_shot_dy := 2; }
                if (!run_shot_dx && !run_shot_dy) {
                   run_shot_dx := 4;
                   if (run_facing < 0) { run_shot_dx := -4; }
                }
                run_shot_x := game_PLAYER0_X + 3;
                if (run_shot_dx > 0) { run_shot_x := game_PLAYER0_X + 8; }
                if (run_shot_dx < 0) { run_shot_x := game_PLAYER0_X - 4; }
                run_shot_y := run_feet - 4;
                if (run_duck) { run_shot_y := run_feet - 2; }
                run_sound := 0x24;
             }
         }
      }
      if (run_immunity) {
         run_immunity--;
      }
      else {
         if (run_hit) {
            run_lives--;
            run_immunity := 90;
            run_sound := 0x4e;
            if (!run_lives) {
               run_mode := 2;
               score_color := 0x46;
               run_fire_ready := 0;
            }
         }
      }
      if (run_collect && treasure_visible) {
          asm lda.a treasure_id;
          asm lsr;
          asm lsr;
          asm lsr;
          asm tax;
          asm lda.a treasure_id;
          asm and #7;
          asm tay;
          asm lda.ay treasure_bit,y;
          asm ora.ax treasure_taken,x;
          asm sta.ax treasure_taken,x;
         treasure_visible := 0;
          score_score += 50;
          run_sound := 0x8c;
      }
      if (!(run_frame & 15)) {
         score_score++;
      }
   }
}

bank2 void locate_treasure(void) {
   treasure_id := world_sector;
   run_spark_x := 128 - world_camera;
   if (world_camera > 128) { treasure_id++; }
   treasure_visible := 0;
   asm lda.a treasure_id;
   asm and #7;
   asm tay;
   asm lda.ay spark_bit,y;
   asm sta.z game_workspace;
   asm lda.a treasure_id;
   asm lsr;
   asm lsr;
   asm lsr;
   asm tay;
   asm lda.ay treasure_taken,y;
   asm and.z game_workspace;
   asm sta.z game_workspace + 4;
   if (run_spark_x < 156 && !physics_mask) {
       treasure_visible := 1;
   }
   run_spark_y := spark_lane[treasure_id & 3];
}

bank3 void prepare_monster(void) {
   asm ldx.a enemy_index;
   asm lda.ax enemy_delay,x;
   asm beq.same @active_art;
   asm rts;
   asm @active_art:;
   asm lda.ax enemy_kind,x;
   asm tax;
   asm lda.ax hazard_colors,x;
   asm ldy.a enemy_index;
   asm sta.ay enemy_color,y;
   asm txa;
   asm asl;
   asm asl;
   asm asl;
   asm asl;
   asm sta.z game_workspace;
   asm lda.a monster_tick;
   asm and #8;
   asm ora.z game_workspace;
   asm tax;
   asm lda.a enemy_index;
   asm asl;
   asm asl;
   asm asl;
   asm tay;
   asm lda.ax hazards,x;
   asm sta.ay monster_pixels,y;
   asm lda.ax hazards + 1,x;
   asm sta.ay monster_pixels + 1,y;
   asm lda.ax hazards + 2,x;
   asm sta.ay monster_pixels + 2,y;
   asm lda.ax hazards + 3,x;
   asm sta.ay monster_pixels + 3,y;
   asm lda.ax hazards + 4,x;
   asm sta.ay monster_pixels + 4,y;
   asm lda.ax hazards + 5,x;
   asm sta.ay monster_pixels + 5,y;
   asm lda.ax hazards + 6,x;
   asm sta.ay monster_pixels + 6,y;
   asm lda.ax hazards + 7,x;
   asm sta.ay monster_pixels + 7,y;
}

bank3 void prepare_enemies(void) {
   asm ldx #3;
   asm @position:;
   asm lda.ax enemy_x,x;
   asm tay;
   asm lda.ay enemy_position_table,y;
   asm sta.ax enemy_position,x;
   asm dex;
   asm bpl.same @position;
   game_PLAYER1_X := enemy_x[0];
   game_player1_y := 25;
   game_monster_color := enemy_color[0];
}

bank3 void advance_monsters(void) {
   asm .callstackextra 4;
   asm @move_slot:;
   asm ldx.a enemy_index;
   asm lda.ax enemy_delay,x;
   asm beq.same @move_active;
   asm sec;
   asm sbc #1;
   asm sta.ax enemy_delay,x;
   asm bne @next_slot;
   asm jsr new_hazard;
   asm jmp @next_slot;
   asm @move_active:;
   asm lda.ax enemy_kind,x;
   asm tay;
   asm lda.ay hazard_tick_mask,y;
   asm and.a run_frame;
   asm bne.same @next_slot;
   asm lda.ax enemy_direction,x;
   asm bpl.same @right;
   asm lda.ax enemy_x,x;
   asm cmp #2;
   asm bcc.same @respawn;
   asm sec;
   asm sbc #1;
   asm jmp @store_x;
   asm @right:;
   asm lda.ax enemy_x,x;
   asm cmp #152;
   asm bcs.same @respawn;
   asm clc;
   asm adc #1;
   asm @store_x:;
   asm sta.ax enemy_x,x;
   asm jmp @next_slot;
   asm @respawn:;
   asm jsr new_hazard;
   asm @next_slot:;
   asm lda.a enemy_index;
   asm clc;
   asm adc #1;
   asm sta.a enemy_index;
   asm cmp.a enemy_limit;
   asm bne.same @move_slot;
}

bank3 void scroll_monsters(void) {
   asm .callstackextra 4;
   asm ldx #3;
   asm lda.z world_request;
   asm cmp #2;
   asm beq.same @camera_right;
   asm @camera_left:;
   asm lda.ax enemy_x,x;
   asm cmp #5;
   asm bcc.same @camera_left_spawn;
   asm sec;
   asm sbc #4;
   asm sta.ax enemy_x,x;
   asm jmp @camera_left_next;
   asm @camera_left_spawn:;
   asm lda.ax enemy_delay,x;
   asm bne.same @camera_left_next;
   asm txa;
   asm sta.a enemy_index;
   asm jsr new_hazard;
   asm @camera_left_next:;
   asm dex;
   asm bpl.same @camera_left;
   asm jmp @camera_done;
   asm @camera_right:;
   asm lda.ax enemy_x,x;
   asm cmp #149;
   asm bcs.same @camera_right_spawn;
   asm clc;
   asm adc #4;
   asm sta.ax enemy_x,x;
   asm jmp @camera_right_next;
   asm @camera_right_spawn:;
   asm lda.ax enemy_delay,x;
   asm bne.same @camera_right_next;
   asm txa;
   asm sta.a enemy_index;
   asm jsr new_hazard;
   asm @camera_right_next:;
   asm dex;
   asm bpl.same @camera_right;
   asm @camera_done:;
}

// Prepare graphics before the renderer's VBLANK countdown setup.
bank0 void prepare_sprites(void) {
   game_player1_graphics := &<monster_pixels;
   physics_index := 48;
   if (run_moving) { physics_index := animation_frame[run_frame & 15]; }
   if (!run_grounded) { physics_index := 32; }
   if (run_duck) { physics_index := 40; }
   game_player0_graphics := courier;
   game_player0_graphics += physics_index;
   if (run_immunity & 4) {
      game_player0_graphics := invisible;
   }
}

bank1 void prepare_frame(void) {
   advance_physics();
   if (run_mode == 1 && enemy_running) {
      enemy_index := 2; enemy_limit := 4; advance_monsters();
   }
   prepare_enemies();
   prepare_sprites();
   game_lamps := 0;
   if (run_lives) { game_lamps := 0x80; }
   if (run_lives > 1) { game_lamps |= 0x20; }
   if (run_lives > 2) { game_lamps |= 0x08; }
   if (run_shot_active && !(run_frame & 1)) {
      game_BALL_X := run_shot_x;
      game_ball_y := run_shot_y;
      game_aux_index := 2;
   }
   else {
      game_BALL_X := run_spark_x;
      game_ball_y := run_spark_y;
      if (!treasure_visible || run_spark_x < 8) { game_ball_y := 255; }
      game_aux_index := 3;
   }
   game_vblank();
   COLUBK := 0x82;
   COLUPF := 0x26;
   CTRLPF := 0x21;
}

bank1 void finish_frame(void) {
   update_run();
   // Startup grace applies once, not again whenever the 8-bit frame wraps.
   if (!enemy_running && run_mode == 1 && run_frame > 1) { enemy_running := 1; }
   if (world_request) { scroll_monsters(); }
   if (run_mode == 1 && enemy_running) {
      enemy_index := 0; enemy_limit := 2; advance_monsters();
   }
   locate_treasure();
   if (run_frame > 1 && !world_request && !run_hit && !run_collect && !run_kill) {
      enemy_index := enemy_art_cursor;
      prepare_monster();
      enemy_art_cursor := (enemy_art_cursor + 1) & 3;
   }
   world_request := 0;
}

bank0 void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   VBLANK := 2;
   new_run();
   locate_treasure();
   enemy_index := 0;
   while (enemy_index < 4) { prepare_monster(); enemy_index++; }
   game_init();
   score_init();
   while (1) {
       vcs_ntsc_vsync();
       vcs_ntsc_begin_vblank();
       prepare_frame();
       score_vblank();
      vcs_ntsc_end_vblank();
      score_draw();
      vcs_ntsc_component_handoff();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      score_overscan();
       finish_frame();
       vcs_ntsc_end_overscan();
   }
}
