instantiate "../../_common/cinder_run_pair.c26" as game_middle (offset:=6)
instantiate "../../_common/cinder_run_pair.c26" as game_lower (offset:=12)
instantiate "../../_common/cinder_run_wide.c26" as game

// The kernel reads this application-owned RAM using fixed-time absolute loads.
uint8_t game_playfield[18];
// The first forty columns of the nonzero $ACE1 / $B400 reversible LFSR.
// Each state spans four columns. Bytes are L:PF0/PF1/PF2, R:PF2/PF1/PF0.
bank2 page const uint8_t landscape[18] := {
   0xf0,0x00,0x00,0xff,0x0f,0x00,
   0x00,0x00,0xf0,0xff,0x00,0xf0,
   0x00,0x00,0xff,0xf0,0xf0,0x00
};

// Eight stored rows, bottom-to-top at runtime; the helper accepts top-to-bottom.
bank0 page const uint8_t courier[56] := {
   game_SPRITE_GLYPH(0b...XXX..,0b...XXXX.,0b...XX...,0b..XXXX.X,0b.X.XXXX.,0b...XX...,0b..XX.XX.,0bXX....XX),
   game_SPRITE_GLYPH(0b...XXX..,0b...XXXX.,0b...XX...,0b..XXXXX.,0b..XXX.X.,0b...XX...,0b...XXX..,0b...XX...),
   game_SPRITE_GLYPH(0b...XXX..,0b...XXXX.,0b...XX...,0b.X.XXX..,0b..XXXX.X,0b...XX...,0b..XX.XX.,0b.XX...XX),
   game_SPRITE_GLYPH(0b...XXX..,0b...XXXX.,0b...XX...,0b..XXXX..,0b.X.XXX..,0b...XX...,0b..XXX...,0b....XX..),
   game_SPRITE_GLYPH(0b...XXX..,0b...XXXX.,0bX..XX..X,0b.XXXXXX.,0b...XX...,0b..XXXX..,0b.XX..XX.,0b.XX.....),
   game_SPRITE_GLYPH(0,0,0,0,0b....XXX.,0b..XXXXXX,0b.XXXXXX.,0bXX...XXX),
   game_SPRITE_GLYPH(0b...XXX..,0b...XXXX.,0b...XX...,0b..XXXX..,0b..XXXX..,0b..XXXX..,0b..X..X..,0b.XX..XX.)
};
