// Static bring-up cartridge for the normalized unbanked 4K NTSC standard
// kernel. Every display object is deliberately fixed so rendering and timing
// failures are reproducible.

include "vcs.c26"

// Immutable playfield exported by static_kernel_playfield.s.
extern const uint8_t vcs_standard_playfield[48];

include "kernels/standard_4k_ntsc/standard_4k_ntsc.c26"

const uint8_t paddle_graphics[8] := {
   VCS_STANDARD_SPRITE_GLYPH(
      0b........,
      0b........,
      0b........,
      0b.XXXXXX.,
      0bXXXXXXXX,
      0bXXXXXXXX,
      0b.XXXXXX.,
      0b........
   )
};

const uint8_t target_graphics[8] := {
   VCS_STANDARD_SPRITE_GLYPH(
      0b..XXXX..,
      0b.XXXXXX.,
      0bXX.XX.XX,
      0bXXXXXXXX,
      0b.X.XX.X.,
      0bX.X..X.X,
      0bX......X,
      0b.X....X.
   )
};

void initialize_static_scene(void) {
   COLUBK := 0x84;
   COLUPF := 0x2e;
   COLUP0 := 0x0e;
   COLUP1 := 0x4e;
   CTRLPF := 0x21;
   NUSIZ0 := 0x25;
   NUSIZ1 := 0x20;

   VCS_STANDARD_PLAYER0_X := 76;
   VCS_STANDARD_PLAYER1_X := 108;
   VCS_STANDARD_MISSILE0_X := 64;
   VCS_STANDARD_MISSILE1_X := 132;
   VCS_STANDARD_BALL_X := 84;

   vcs_standard_player0_y := 78;
   vcs_standard_player1_y := 42;
   vcs_standard_missile0_y := 30;
   vcs_standard_missile1_y := 60;
   vcs_standard_ball_y := 45;

   vcs_standard_player0_graphics := paddle_graphics;
   vcs_standard_player1_graphics := target_graphics;
   vcs_standard_player0_height := 7;
   vcs_standard_player1_height := 7;
   vcs_standard_missile0_height := 5;
   vcs_standard_missile1_height := 7;
   vcs_standard_ball_height := 3;

   vcs_standard_score := 123456;
   vcs_standard_score_color := 0x0e;
   vcs_standard_playfield_position := 8;

   VBLANK := 2;
   TIM64T := 0;
}

void main(void) {
   initialize_static_scene();
   while (1) {
      vcs_standard_kernel_drawscreen();
   }
}
