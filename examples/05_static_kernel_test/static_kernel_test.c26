// All-five 181-line static scene with the independent score above gameplay.
include "vcs.c26"
include "frame_ntsc.c26"
include "playfield.c26"
include "fonts/default_decimal.c26"

page const uint8_t game_playfield[44] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bX......X_........_..X....._X......X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bX......X_........_.....X.._X......X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bX......X_........_..X....._X......X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bX......X_........_.....X.._X......X),
   VCS_PLAYFIELD_ROW(0bX......X_...XX..._...XX..._X......X),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX)
};
template "kernels/all_five_181/all_five_181.c26" as game
template "six_glyph_component.c26" as score

page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(0x3c,0x66,0x66,0x7e,0x66,0x66,0x66,0x00)
};
page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(0x7c,0x66,0x66,0x7c,0x66,0x66,0x7c,0x00)
};

void configure_game_frame(void) {
   COLUPF := 0x2e;
   COLUP0 := 0x0e;
   COLUP1 := 0xc8;
   CTRLPF := 0x21;
   NUSIZ0 := 0x20;
   NUSIZ1 := 0x20;
}

void initialize_scene(void) {
   VBLANK := 2;
   COLUBK := 0x84;
   game_PLAYER0_X := 20;
   game_PLAYER1_X := 130;
   game_MISSILE0_X := 50;
   game_MISSILE1_X := 110;
   game_BALL_X := 80;
   game_player0_y := 18;
   game_player1_y := 78;
   game_missile0_y := 34;
   game_missile1_y := 62;
   game_ball_y := 48;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_missile0_height := 5;
   game_missile1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;
   score_score := 123456;
   game_init();
   score_init();
}

void main(void) {
   initialize_scene();
   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      score_vblank();
      vcs_ntsc_end_vblank();
      score_draw();
      configure_game_frame();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      score_overscan();
      vcs_ntsc_end_overscan();
   }
}
