// Full-height static P0/P1/Ball multicolor demonstration.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"

// Twelve 16-scanline rows fill the entire 192-line gameplay field.  The
// middle object row is deliberately empty except for the outer frame so the
// player glyphs and Ball cannot disappear into the playfield.
page const uint8_t game_playfield[48] := {
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX),
   VCS_PLAYFIELD_ROW(0bX...X..._........_........_...X...X),
   VCS_PLAYFIELD_ROW(0bX......._........_........_.......X),
   VCS_PLAYFIELD_ROW(0bX......._X......._.......X_.......X),
   VCS_PLAYFIELD_ROW(0bX......._........_........_.......X),
   VCS_PLAYFIELD_ROW(0bX......._........_........_.......X),
   VCS_PLAYFIELD_ROW(0bX......._........_........_.......X),
   VCS_PLAYFIELD_ROW(0bX......._....X..._...X...._.......X),
   VCS_PLAYFIELD_ROW(0bX......._........_........_.......X),
   VCS_PLAYFIELD_ROW(0bX...X..._........_........_...X...X),
   VCS_PLAYFIELD_ROW(0bX......._........_........_.......X),
   VCS_PLAYFIELD_ROW(0bXXXXXXXX_XXXXXXXX_XXXXXXXX_XXXXXXXX)
};

template "kernels/player_color_192/player_color_192.c26" as game

page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(
      0b..XXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXXX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b..XXXX..
   )
};

page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(
      0b.XXXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXX..,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XX..XX.,
      0b.XXXXX..
   )
};

page const uint8_t game_player0_colors[8] := {
   game_SPRITE_GLYPH(
      VCS_NTSC_SANDY_BROWN,
      VCS_NTSC_LIGHT_CORAL,
      VCS_NTSC_ORCHID,
      VCS_NTSC_VIOLET,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_SKY_BLUE
   )
};

page const uint8_t game_player1_colors[8] := {
   game_SPRITE_GLYPH(
      VCS_NTSC_PALE_GREEN,
      VCS_NTSC_AQUAMARINE,
      VCS_NTSC_SKY_BLUE,
      VCS_NTSC_SKY_BLUE_2,
      VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_VIOLET,
      VCS_NTSC_ORCHID
   )
};

void configure_game_frame(void) {
   COLUBK := VCS_NTSC_MEDIUM_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;
}

void initialize_scene(void) {
   VBLANK := 2;

   game_PLAYER0_X := 44;
   game_PLAYER1_X := 108;
   game_BALL_X := 78;

   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;

   game_player0_y := 48;
   game_player1_y := 48;
   game_ball_y := 50;

   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 3;

   game_playfield_position := 8;
   game_init();
}

void main(void) {
   initialize_scene();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      configure_game_frame();
      vcs_ntsc_end_vblank();
      game_draw();
      vcs_ntsc_begin_overscan();
      game_overscan();
      vcs_ntsc_end_overscan();
   }
}
