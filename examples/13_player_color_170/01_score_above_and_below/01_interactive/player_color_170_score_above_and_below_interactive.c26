// 170-line P0/P1/Ball gameplay between independent eleven-line scores.
include "vcs.c26"
include "frame_ntsc.c26"
include "color_ntsc.c26"
include "playfield.c26"
include "fonts/default_decimal.c26"

instantiate "renderers/player_color/player_color.c26" as game (lines:=170)
instantiate "six_glyph_component.c26" as top_score (mutable_color:=1)
instantiate "six_glyph_component.c26" as bottom_score (mutable_color:=1)

page const uint8_t game_playfield[40] := {
   VCS_PLAYFIELD_ROW(0bX.....X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.X.....X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0b..X....._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b...X...._.X.....X_.....X.._...X....),
   VCS_PLAYFIELD_ROW(0b....X..._..X....._X.....X._....X...),
   VCS_PLAYFIELD_ROW(0b.....X.._...X...._.X.....X_.....X..),
   VCS_PLAYFIELD_ROW(0b......X._....X..._..X....._X.....X.),
   VCS_PLAYFIELD_ROW(0b.......X_.....X.._...X...._.X.....X),
   VCS_PLAYFIELD_ROW(0bX......._X.....X._....X..._..X.....),
   VCS_PLAYFIELD_ROW(0b.X......_.X.....X_.....X.._...X....)
};

page const uint8_t p0_graphics[8] := {
   game_SPRITE_GLYPH(
      0b.X....X., 0bX.X..X.X, 0bX.XXXX.X, 0bXXXXXXXX,
      0bXX.XX.XX, 0b.XXXXXX., 0b..XXXX.., 0b.XX..XX.
   )
};

page const uint8_t p1_graphics[8] := {
   game_SPRITE_GLYPH(
      0bX.X..X.X, 0b.X.XX.X., 0b..X..X.., 0bXXXXXXXX,
      0bXX.XX.XX, 0bXXXXXXXX, 0b.XX..XX., 0b..XXXX..
   )
};

page const uint8_t game_player0_colors[8] := {
   game_SPRITE_GLYPH(
      VCS_NTSC_SKY_BLUE, VCS_NTSC_SKY_BLUE_2, VCS_NTSC_ROYAL_BLUE,
      VCS_NTSC_MEDIUM_PURPLE, VCS_NTSC_VIOLET, VCS_NTSC_ORCHID,
      VCS_NTSC_LIGHT_CORAL, VCS_NTSC_SANDY_BROWN
   )
};

page const uint8_t game_player1_colors[8] := {
   game_SPRITE_GLYPH(
      VCS_NTSC_ORCHID, VCS_NTSC_VIOLET, VCS_NTSC_MEDIUM_PURPLE,
      VCS_NTSC_ROYAL_BLUE, VCS_NTSC_SKY_BLUE_2, VCS_NTSC_SKY_BLUE,
      VCS_NTSC_AQUAMARINE, VCS_NTSC_PALE_GREEN
   )
};

alias OBJECT_MAX_Y 79
alias SELECTED_PLAYER0 0
alias SELECTED_PLAYER1 1
alias SELECTED_BALL    2
alias SELECTED_OBJECT_COUNT 3

uint8_t selected_object := SELECTED_PLAYER0;
uint8_t select_switch_ready := 1;
uint8_t selected_score_digit := 0;
uint8_t right_joystick_ready := 0x0f;
page const bcd24_t score_digit_weight[6] := { 1, 10, 100, 1000, 10000, 100000 };

inline void initialize_score_state(void) {
   top_score_score := 123456;
   bottom_score_score := 654321;
   top_score_color := VCS_NTSC_GRAY_92;
   bottom_score_color := VCS_NTSC_PALE_GREEN;
   selected_score_digit := 0;
   right_joystick_ready := 0x0f;
}

inline void update_score_controls(void) {
   // 0x0f means armed; 0 means a press is latched. Reuse this byte for the
   // current low SWCHA nibble so edge detection needs no extra scratch RAM.
   if (right_joystick_ready) {
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         if (!(right_joystick_ready & 0x04)) {
            selected_score_digit++;
            if (selected_score_digit >= 6) { selected_score_digit := 0; }
            top_score_color += 0x10;
         }
         else {
            if (!(right_joystick_ready & 0x08)) {
               if (selected_score_digit == 0) { selected_score_digit := 5; }
               else { selected_score_digit--; }
               top_score_color += 0x10;
            }
         }
         if (!(right_joystick_ready & 0x01)) {
            top_score_score += score_digit_weight[selected_score_digit];
         }
         else {
            if (!(right_joystick_ready & 0x02)) {
               top_score_score -= score_digit_weight[selected_score_digit];
            }
         }
         right_joystick_ready := 0;
      }
   }
   else {
      // Stay latched through a hold or direction roll; only full neutral re-arms.
      right_joystick_ready := SWCHA & 0x0f;
      if (right_joystick_ready != 0x0f) {
         right_joystick_ready := 0;
      }
   }
}

inline void initialize_scene(void) {
   VBLANK := 2;
   COLUBK := VCS_NTSC_DARK_BLUE;
   COLUPF := VCS_NTSC_GOLDENROD;
   CTRLPF := 0x21;

   game_PLAYER0_X := 44;
   game_PLAYER1_X := 108;
   game_BALL_X := 78;
   game_PLAYER0_NUSIZ := 0x20;
   game_PLAYER1_NUSIZ := 0x20;
   game_player0_y := 62;
   game_player1_y := 38;
   game_ball_y := 43;
   game_player0_graphics := p0_graphics;
   game_player1_graphics := p1_graphics;
   game_player0_height := 7;
   game_player1_height := 7;
   game_ball_height := 3;
   game_playfield_position := 8;

   selected_object := SELECTED_PLAYER0;
   select_switch_ready := 1;
   initialize_score_state();
   game_init();
   top_score_init();
   bottom_score_init();
   bottom_score_vblank();
}

inline void update_object_selection(void) {
   if (SWCHB & 0x02) {
      select_switch_ready := 1;
   }
   else {
      if (select_switch_ready) {
         selected_object++;
         if (selected_object >= SELECTED_OBJECT_COUNT) { selected_object := SELECTED_PLAYER0; }
         select_switch_ready := 0;
      }
   }
}

inline void move_selected_object(void) {
   if (!(SWCHA & 0x40)) {
      switch (selected_object) {
         case SELECTED_PLAYER0: if (game_PLAYER0_X > 0) { game_PLAYER0_X--; } break;
         case SELECTED_PLAYER1: if (game_PLAYER1_X > 0) { game_PLAYER1_X--; } break;
         default: if (game_BALL_X > 0) { game_BALL_X--; }
      }
   }
   else {
      if (!(SWCHA & 0x80)) {
         switch (selected_object) {
            case SELECTED_PLAYER0: if (game_PLAYER0_X < 159) { game_PLAYER0_X++; } break;
            case SELECTED_PLAYER1: if (game_PLAYER1_X < 159) { game_PLAYER1_X++; } break;
            default: if (game_BALL_X < 159) { game_BALL_X++; }
         }
      }
   }

   if (!(SWCHA & 0x10)) {
      switch (selected_object) {
         case SELECTED_PLAYER0: if (game_player0_y > 0) { game_player0_y--; } break;
         case SELECTED_PLAYER1: if (game_player1_y > 0) { game_player1_y--; } break;
         default: if (game_ball_y > 0) { game_ball_y--; }
      }
   }
   else {
      if (!(SWCHA & 0x20)) {
         switch (selected_object) {
            case SELECTED_PLAYER0: if (game_player0_y < OBJECT_MAX_Y) { game_player0_y++; } break;
            case SELECTED_PLAYER1: if (game_player1_y < OBJECT_MAX_Y) { game_player1_y++; } break;
            default: if (game_ball_y < OBJECT_MAX_Y) { game_ball_y++; }
         }
      }
   }
}

inline void update_controls(void) {
   if (!(SWCHB & 0x01)) {
      hard_reset();
   }
   update_object_selection();
   move_selected_object();
   update_score_controls();
}

void main(void) {
   SWACNT := 0;
   SWBCNT := 0;
   initialize_scene();

   while (1) {
      vcs_ntsc_vsync();
      vcs_ntsc_begin_vblank();
      game_vblank();
      top_score_vblank();
      vcs_ntsc_end_vblank();

      top_score_draw();
      vcs_ntsc_component_handoff();
      game_draw();
      vcs_ntsc_component_handoff();
      bottom_score_draw();

      vcs_ntsc_begin_overscan();
      game_overscan();
      top_score_overscan();
      bottom_score_overscan();
      update_controls();
      vcs_ntsc_end_overscan();
   }
}
