// Prototype: monotonic 0..11 heart meter using the proven 11inv reset schedule.
enum TEMPLATE_contract { TEMPLATE_VISIBLE_SCANLINES:=9,TEMPLATE_DRAW_ENTRY_CYCLE:=3,TEMPLATE_DRAW_RETURN_CYCLE:=0,TEMPLATE_DRAW_COMPLETE_SCANLINES:=9,TEMPLATE_DRAW_PARTIAL_ENTRY_CYCLES:=0,TEMPLATE_DRAW_PARTIAL_EXIT_CYCLES:=0,TEMPLATE_DRAW_TERMINAL_WSYNC:=1,TEMPLATE_DRAW_HMOVE_COUNT:=7,TEMPLATE_DRAW_SUCCESSOR_ON_RETURN_LINE:=1,TEMPLATE_VBLANK_MAX_CYCLES:=80,TEMPLATE_OVERSCAN_MAX_CYCLES:=0,TEMPLATE_MAX_HEARTS:=11,TEMPLATE_HEART_WIDTH:=8,TEMPLATE_HEART_PITCH:=12 };
recommend uint8_t TEMPLATE_score:=11;
recommend uint8_t TEMPLATE_half:=0;
recommend uint8_t TEMPLATE_color:=0x46;
uint8_t TEMPLATE_count;
uint16_t TEMPLATE_renderer;
uint8_t TEMPLATE_pad;
const uint8_t TEMPLATE_heart[7]:={0,0x18,0x3c,0x7e,0xff,0xff,0x66};
const uint8_t TEMPLATE_blank[7]:={0,0,0,0,0,0,0};

static void TEMPLATE_render_0(void) {
   asm @TEMPLATE_render_0_loop:;
   asm lda.ay TEMPLATE_heart,y;
   asm sta.z HMOVE;
   asm sta.z RESP0;
   asm sta.z RESP1;
   asm stx.z GRP0;
   asm stx.z GRP1;
   asm lda.ay TEMPLATE_blank,y;
   asm sta.z ENABL;
   asm txa;
   asm sta.z $2d;
   asm sta.zx $2d,x;
   asm lda.zx TEMPLATE_pad,x;
   asm lda.zx TEMPLATE_pad,x;
   asm lda.zx TEMPLATE_pad,x;
   asm lda.zx TEMPLATE_pad,x;
   asm lda.zx TEMPLATE_pad,x;
   asm lda.zx TEMPLATE_pad,x;
   asm lda.zx TEMPLATE_pad,x;
   asm lda.zx TEMPLATE_pad,x;
   asm lda.zx TEMPLATE_pad,x;
   asm dey;
   asm bne.same @TEMPLATE_render_0_loop;
   asm rts;
}

