static inline void TEMPLATE_select(void) {
   asm ldx.z TEMPLATE_score;
   asm cpx #11;
   asm bcc.flex @TEMPLATE_count_ok;
   asm ldx #11;
   asm @TEMPLATE_count_ok:;
   asm stx.z TEMPLATE_count;
   asm txa;
   asm asl;
   asm tax;
   asm lda.ax @TEMPLATE_table,x;
   asm sta.z TEMPLATE_renderer;
   asm inx;
   asm lda.ax @TEMPLATE_table,x;
   asm sta.z TEMPLATE_renderer + 1;
   asm jmp @TEMPLATE_table_done;
   asm @TEMPLATE_table:;
   asm .word TEMPLATE_render_0,TEMPLATE_render_1,TEMPLATE_render_2,TEMPLATE_render_3;
   asm .word TEMPLATE_render_4,TEMPLATE_render_5,TEMPLATE_render_6,TEMPLATE_render_7;
   asm .word TEMPLATE_render_8,TEMPLATE_render_9,TEMPLATE_render_10,TEMPLATE_render_11;
   asm @TEMPLATE_table_done:;
}
static void TEMPLATE_call(void) {
   asm jmp.i (TEMPLATE_renderer);
}
static inline void TEMPLATE_phase(void) {
   asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad;
   asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad;
   asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad; asm bit.a TEMPLATE_pad;
   asm bit.a TEMPLATE_pad; asm bit.z TEMPLATE_pad; asm nop;
}
require inline void TEMPLATE_init(void) { TEMPLATE_select(); }
require inline void TEMPLATE_vblank(void) { TEMPLATE_select(); }
require inline void TEMPLATE_draw(void) {
   asm lda #0;
   asm sta GRP0; asm sta GRP1; asm sta ENABL;
   asm sta VDELP0; asm sta VDELP1; asm sta REFP0; asm sta REFP1;
   asm sta HMM0; asm sta HMM1; asm sta HMBL;
   asm lda #$10; asm sta HMP0;
   asm lda #$e0; asm sta HMP1;
   asm lda #$81; asm sta NUSIZ0;
   asm lda #$01; asm sta NUSIZ1;
   asm sta WSYNC;
   TEMPLATE_phase();
   asm ldy #1;
   asm ldx #0;
   TEMPLATE_prime();
   asm lda #0; asm sta GRP0; asm sta GRP1;
   asm lda.z TEMPLATE_color; asm sta COLUP0; asm sta COLUP1;
   asm sta WSYNC;
   TEMPLATE_phase();
   asm ldy #6;
   asm ldx #0;
   TEMPLATE_call();
   asm lda #0; asm sta GRP0; asm sta GRP1; asm sta ENABL;
   asm sta WSYNC;
}
require inline void TEMPLATE_overscan(void) {}
