+void PNGLibrary::saveEmulatedFrame(const uInt8* pixels, uInt32 width,
+                                   uInt32 height, uInt32 frameNumber)
+{
+  // This method deliberately does not use the displayed framebuffer.
+  if(!myOSystem.hasConsole() || !pixels || !width || !height)
+    return;
+
+  if(myFrameSnapSession.empty())
+  {
+    const auto micros = std::chrono::duration_cast<std::chrono::microseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+    myFrameSnapSession = std::format("{}_{}", snapTimestamp(), micros);
+  }
+
+  const bool useIntName = myOSystem.settings().getString("snapname") == "int";
+  const string name = !useIntName
+    ? string{myOSystem.romFile().getBaseName()}
+    : string{myOSystem.console().properties().get(PropType::Cart_Name)};
+  const string filename = std::format("{}{}_framesnap_{}_{:08X}.png",
+    myOSystem.snapshotSaveDir().getPath(), name, myFrameSnapSession,
+    frameNumber);
+
+  png_structp png_ptr{nullptr};
+  png_infop info_ptr{nullptr};
+  const ScopeExit pngGuard{[&]() {
+    if(png_ptr)
+      png_destroy_write_struct(&png_ptr, &info_ptr);
+  }};
+  png_ptr = png_create_write_struct(PNG_LIBPNG_VER_STRING, nullptr,
+                                    png_user_error, png_user_warn);
+  if(!png_ptr)
+    throw std::runtime_error("Couldn't allocate frame PNG write struct");
+  info_ptr = png_create_info_struct(png_ptr);
+  if(!info_ptr)
+    throw std::runtime_error("Couldn't allocate frame PNG info struct");
+
+  auto out = FSNode(filename).openOFStream(std::ios_base::binary);
+  if(!out.is_open())
+    throw std::runtime_error("Couldn't create frame snapshot file: " + filename);
+  png_set_write_fn(png_ptr, &out, png_write_data, png_io_flush);
+
+  // Indexed PNG preserves every TIA palette index without phosphor/NTSC
+  // postprocessing. The palette is the current display palette's RGB values.
+  const FrameBuffer& fb = myOSystem.frameBuffer();
+  const TIASurface& surface = fb.tiaSurface();
+  const uInt32 rshift = std::countr_zero(fb.rMask());
+  const uInt32 gshift = std::countr_zero(fb.gMask());
+  const uInt32 bshift = std::countr_zero(fb.bMask());
+  png_color palette[256]{};
+  for(uInt32 i = 0; i < 256; ++i)
+  {
+    const uInt32 color = surface.mapIndexedPixel(static_cast<uInt8>(i));
+    palette[i].red   = static_cast<png_byte>((color & fb.rMask()) >> rshift);
+    palette[i].green = static_cast<png_byte>((color & fb.gMask()) >> gshift);
+    palette[i].blue  = static_cast<png_byte>((color & fb.bMask()) >> bshift);
+  }
+
+  png_set_IHDR(png_ptr, info_ptr, width * 2, height, 8,
+               PNG_COLOR_TYPE_PALETTE, PNG_INTERLACE_NONE,
+               PNG_COMPRESSION_TYPE_DEFAULT, PNG_FILTER_TYPE_DEFAULT);
+  png_set_PLTE(png_ptr, info_ptr, palette, 256);
+  png_write_info(png_ptr, info_ptr);
+
+  // 2600 color pixels are twice as wide for display. Every row here comes
+  // from this exact completed frame, without passing through FBSurface.
+  std::vector<png_byte> row(static_cast<size_t>(width) * 2);
+  for(uInt32 y = 0; y < height; ++y)
+  {
+    for(uInt32 x = 0; x < width; ++x)
+    {
+      const uInt8 value = pixels[static_cast<size_t>(y) * width + x];
+      row[2 * x] = row[2 * x + 1] = value;
+    }
+    png_write_row(png_ptr, row.data());
+  }
+  png_write_end(png_ptr, info_ptr);
+  if(!out.good())
+    throw std::runtime_error("Failed writing frame snapshot: " + filename);
+}
