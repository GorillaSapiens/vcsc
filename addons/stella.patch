 namespace {
+#ifdef IMAGE_SUPPORT
+  // Comma-separated frame numbers and inclusive ranges: 1,5-10,12.
+  bool inFrameRange(const std::string& rangeList, uInt32 frame)
+  {
+    std::istringstream input(rangeList);
+    std::string item;
+    while(std::getline(input, item, ','))
+    {
+      const size_t dash = item.find('-');
+      try
+      {
+        if(dash == std::string::npos)
+        {
+          if(std::stoul(item) == frame) return true;
+        }
+        else
+        {
+          const unsigned long low = std::stoul(item.substr(0, dash));
+          const unsigned long high = std::stoul(item.substr(dash + 1));
+          if(low <= frame && frame <= high) return true;
+        }
+      }
+      catch(const std::exception&) { /* Ignore malformed entries. */ }
+    }
+    return false;
+  }
+#endif
